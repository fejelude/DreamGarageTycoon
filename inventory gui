-- FIX #1 + FIX #4
-- addButtonEffects now RETURNS the connection list so callers
-- can store them for cleanup.  It also guards against being
-- called more than once on the same button via the attribute
-- "__HoverBound", preventing tween accumulation on pool reuse.
-- =========================================================
local function addButtonEffects(btn, getBaseBg)
	-- FIX #4: skip if already bound; connections are still alive from last use
	if btn:GetAttribute("__HoverBound") then
		return {}
	end
	btn:SetAttribute("__HoverBound", true)

	local baseZ = btn.ZIndex
	local isHovering = false
	local isPressed = false

	-- FIX #1: collect connections to return
	local connections = {}

	local uiScale = btn:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale       = Instance.new("UIScale")
		uiScale.Scale = 1.0
		uiScale.Parent = btn
	end

	local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local function updateScale()
		local target = 1.0
		if isPressed      then target = 0.95
		elseif isHovering then target = 1.05
		end
		TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
	end

	table.insert(connections, btn.MouseEnter:Connect(function()
		isHovering = true
		UIAudioConfig.PlayHover()
		btn.ZIndex = baseZ + 20
		updateScale()
	end))
	table.insert(connections, btn.MouseLeave:Connect(function()
		isHovering = false
		isPressed = false
		btn.ZIndex = baseZ

		updateScale()
	end))
	table.insert(connections, btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = true
			updateScale()
		end
	end))
	table.insert(connections, btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = false
			updateScale()
		end
	end))

	return connections
end

local function addOpenButtonHover(btn)
	if not btn:IsA("ImageButton") then return end

	local uiScale = btn:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale       = Instance.new("UIScale")
		uiScale.Scale = 1.0
		uiScale.Parent = btn
	end

	local isHovering = false
	local isPressed  = false
	local tweenInfo  = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local function updateScale()
		local target = 1.0
		if isPressed      then target = 0.95
		elseif isHovering then target = 1.05
		end
		TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
	end

	btn.MouseEnter:Connect(function()
		isHovering = true
		UIAudioConfig.PlayHover()
		updateScale()
	end)
	btn.MouseLeave:Connect(function()
		isHovering = false
		isPressed = false
		updateScale()
	end)
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = true
			updateScale()
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = false
			updateScale()
		end
	end)
end

