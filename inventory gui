-- ========= INVENTORY TRACKING =========
-- (Variables moved to top)

local function normalizeToolName(toolName)
	if not CarStats or not CarStats.Cars then return nil end
	if CarStats.Cars[toolName] then return toolName end
	if toolName:match(" Item$") then
		local n = toolName:gsub(" Item$", "")
		if CarStats.Cars[n] then return n end
	end
	if toolName:match("Item$") then
		local n = toolName:gsub("Item$", "")
		if CarStats.Cars[n] then return n end
	end
	return nil
end

local function adjustCount(tool, delta)
	if not tool or not tool:IsA("Tool") then return end
	if not CarStats or not CarStats.Cars then return end

	local clean = toolToCleanName[tool]
	if not clean then
		clean = normalizeToolName(tool.Name)
		if not clean then return end
		toolToCleanName[tool] = clean
	end

	local newVal = (counts[clean] or 0) + delta
	if newVal <= 0 then
		counts[clean]    = nil
		sampleTool[clean] = nil
	else
		counts[clean] = newVal
		if not sampleTool[clean] then
			sampleTool[clean] = tool
		end
	end
end

local function scanContainer(container)
	if not container then return end
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Tool") then
			adjustCount(child, 1)
		end
	end
end

-- ========= INVENTORY LIMIT INDICATOR =========
local LIMIT_INDICATOR_SAFE_COLOR = Color3.fromRGB(80, 220, 120)
local LIMIT_INDICATOR_NEAR_COLOR = Color3.fromRGB(255, 120, 120)
local LIMIT_INDICATOR_NEAR_RATIO = 0.8
local DEFAULT_STORAGE_LIMIT = 5
local function getStorageLimit()
	local limit = tonumber(player:GetAttribute("RankStorageLimit"))
	if limit and limit > 0 then return limit end
	if RankConfig and RankConfig.GetBenefitsForRank then
		local benefits = RankConfig.GetBenefitsForRank(player:GetAttribute("Rank") or RankConfig.DefaultRankName)
		limit = benefits and tonumber(benefits.StorageSlots)
		if limit and limit > 0 then return limit end
	end
	return DEFAULT_STORAGE_LIMIT
end

local function countInventoryTools()
	local total = 0
	local seen = {}
	local function scan(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Tool") and child:GetAttribute("ToolId") and not seen[child] then
				seen[child] = true
				total += 1
			end
		end
	end
	scan(player:FindFirstChild("Backpack"))
	if player.Character then scan(player.Character) end
	return total
end

local function updateLimitIndicator()
	if not limitIndicatorLabel or not limitIndicatorLabel:IsA("TextLabel") then return end

	local limit = getStorageLimit()
	local current = math.clamp(countInventoryTools(), 0, limit)
	limitIndicatorLabel.Text = tostring(current) .. "/" .. tostring(limit)
	limitIndicatorLabel.TextColor3 = (current / math.max(limit, 1)) >= LIMIT_INDICATOR_NEAR_RATIO
		and LIMIT_INDICATOR_NEAR_COLOR
		or LIMIT_INDICATOR_SAFE_COLOR
end


player:GetAttributeChangedSignal("RankStorageLimit"):Connect(updateLimitIndicator)
player:GetAttributeChangedSignal("Rank"):Connect(updateLimitIndicator)
updateLimitIndicator()

