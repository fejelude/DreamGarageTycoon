	for _, btn in ipairs(tierContainer:GetChildren()) do
		if btn:IsA("GuiButton") then
			if layout then
				btn.AnchorPoint = Vector2.new(0.5, 0.5)
				btn.Position = UDim2.new(0.5, 0, 0.5, 0)

				if not btn.Parent:IsA("Frame") or not btn.Parent.Name:match("_Wrapper$") then
					local wrapper = Instance.new("Frame")
					wrapper.Name = btn.Name .. "_Wrapper"
					wrapper.BackgroundTransparency = 1
					wrapper.Size = btn.Size
					wrapper.LayoutOrder = btn.LayoutOrder
