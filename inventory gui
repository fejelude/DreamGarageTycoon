local function isOnHotbarFrame(screenPos)
	if not hotbarFrame then return false end
	local p, s = hotbarFrame.AbsolutePosition, hotbarFrame.AbsoluteSize
	return screenPos.X >= p.X and screenPos.X <= p.X + s.X
		and screenPos.Y >= p.Y and screenPos.Y <= p.Y + s.Y
end

local function isOnInventoryFrame(screenPos)
	if not mainWindow or not mainWindow.Visible then return false end
	local frame = itemsContainer or mainWindow
	local p, s  = frame.AbsolutePosition, frame.AbsoluteSize
	return screenPos.X >= p.X and screenPos.X <= p.X + s.X
		and screenPos.Y >= p.Y and screenPos.Y <= p.Y + s.Y
end

-- Returns the first hotbar slot that is empty, skipping excludeIndex.
local function getFirstEmptyHotbarSlot(excludeIndex)
	for i = 1, SLOT_COUNT do
		if i ~= excludeIndex and not hotbarData[i] then
			return i
		end
	end
	return nil
end

-- =========================================================
-- FIX #11: endDrag(success)
--   success = true  → keep whatever state was applied by drop
--   success = false → restore source (show inventory btn / restore hotbar slot)
-- =========================================================
local function endDrag(success)
	if not success then
		if dragSourceType == "inventory" and dragSourceButton then
			-- Restore button visibility only if it hasn't been pooled away by
			-- a mid-drag renderCurrentTab call (FIX #18 also guards this).
			if dragSourceButton.Parent and dragSourceButton.Parent.Name ~= "__InventoryUIPool" then
				dragSourceButton.Visible = true
			end
		elseif dragSourceType == "hotbar" and dragSourceSlot then
			-- hotbarData[srcSlot] was cleared by the slot init drag code;
			-- restore it from draggingCar before we wipe that value.
			hotbarData[dragSourceSlot] = draggingCar
			saveHotbarToAttributes()
			refreshSlotVisual(dragSourceSlot)
		end
	end

	-- Clear inventory drop-zone highlight (FIX #16)
	if mainWindow then
		local invHl = mainWindow:FindFirstChild("__InvDragHighlight")
		if invHl then invHl.Visible = false end
	end

	-- Clear all slot drag-highlights
	if slotsFolder then
		for i = 1, SLOT_COUNT do
			local slot = slotsFolder:FindFirstChild("Slot" .. i)
			if slot then
				local hl = slot:FindFirstChild("__DragHighlight")
				if hl then hl.Visible = false end
			end
		end
	end

	hoveredSlot = nil
	if dragConn       then dragConn:Disconnect();       dragConn       = nil end
	if globalDropConn then globalDropConn:Disconnect(); globalDropConn = nil end
	if dragIcon       then dragIcon:Destroy();          dragIcon       = nil end

	draggingCar      = nil
	dragSourceType   = nil
	dragSourceSlot   = nil
	dragSourceButton = nil
	-- Re-enable scroll frame once drag ends (mobile fix)
	if hotbarScrollFrame then
		hotbarScrollFrame.ScrollingEnabled = true
	end

	-- FIX #33: cancelled drags should repaint immediately so mobile touch
	-- cancellations cannot leave a dimmed/hidden visual behind.
	if updateHotbarUI then updateHotbarUI() end
	if isOpen and renderCurrentTab then renderCurrentTab() end
end

local function getSlotAtPosition(screenPos)
	if not slotsFolder then return nil end
	for i = 1, SLOT_COUNT do
		local slot = slotsFolder:FindFirstChild("Slot" .. i)
		if slot then
			local absPos  = slot.AbsolutePosition
			local absSize = slot.AbsoluteSize
			if screenPos.X >= absPos.X and screenPos.X <= absPos.X + absSize.X and
				screenPos.Y >= absPos.Y and screenPos.Y <= absPos.Y + absSize.Y then
				return i
			end
		end
	end
	return nil
end

