-- ⌨️ KEYBOARD INPUT (1-6 slot selection)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end

	local keyMap = {
		[Enum.KeyCode.One]   = 1, [Enum.KeyCode.Two]   = 2, [Enum.KeyCode.Three] = 3,
		[Enum.KeyCode.Four]  = 4, [Enum.KeyCode.Five]  = 5, [Enum.KeyCode.Six]   = 6
	}
	local slotIndex = keyMap[input.KeyCode]
	if slotIndex then
		UIAudioConfig.PlayClick()
		activateSlot(slotIndex)
		snapToSlot(slotIndex)
		return
	end

	if input.UserInputType == Enum.UserInputType.Gamepad1 then
		if input.KeyCode == Enum.KeyCode.DPadRight then
			local next = (selectedSlot or 0) + 1
			if next > SLOT_COUNT then next = 1 end
			selectedSlot = next
			updateSlotSelection()
			UIAudioConfig.PlayHover()
		elseif input.KeyCode == Enum.KeyCode.DPadLeft then
			local prev = (selectedSlot or (SLOT_COUNT + 1)) - 1
			if prev < 1 then prev = SLOT_COUNT end
			selectedSlot = prev
			updateSlotSelection()
			UIAudioConfig.PlayHover()
		elseif input.KeyCode == Enum.KeyCode.ButtonA then
			if selectedSlot then
				UIAudioConfig.PlayClick()
				activateSlot(selectedSlot)
				snapToSlot(selectedSlot)
			end
		elseif input.KeyCode == Enum.KeyCode.ButtonX then
			if selectedSlot then clearSlot(selectedSlot) end
		end
	end
end)

-- =========================================================
-- 🏗️ INIT HOTBAR SLOTS
-- FIX #15: unified InputBegan handles drag threshold, long-press,
-- and right-click in a single block with a shared isDragging flag
-- to prevent conflicts between drag and long-press clear.
-- =========================================================
if slotsFolder then
	for i = 1, SLOT_COUNT do
		local slot = slotsFolder:FindFirstChild("Slot" .. i)
		if slot and slot:IsA("ImageButton") then
			hotbarSlots[i] = slot

			addButtonEffects(slot, function() return Color3.fromRGB(80, 80, 80) end)

			-- FIX #28: CarInfo tooltip — only visible on hover AND only when the
			-- slot actually has a car. Direct MouseEnter/Leave connections (same
			-- events UIButtonUtils.wireHoverEffects uses internally) guarantee the
			-- guard runs BEFORE Visible is ever set to true, so empty slots never
			-- flash the tooltip for even a single frame.
			local carInfoImg = slot:FindFirstChild("CarInfo")
			if carInfoImg then
				carInfoImg.Visible = false
				local slotIndex = i
				slot.MouseEnter:Connect(function()
					if hotbarData[slotIndex] then
						carInfoImg.Visible = true
					end
					-- slot is empty → carInfoImg stays false, nothing to do
				end)
				slot.MouseLeave:Connect(function()
					carInfoImg.Visible = false
				end)
			end

			-- Track drag state per slot to avoid long-press firing during a drag
			local isDragging = false
			local holdThread = nil

			-- Click: toggle equip (only fires if NOT a drag)
			slot.MouseButton1Click:Connect(function()
				if isDragging then return end
				UIAudioConfig.PlayClick()
				activateSlot(i)
				if selectedSlot == i then snapToSlot(i) end
			end)

			-- Right-click: clear slot (PC)
			slot.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton2 then
					clearSlot(i)
				end
			end)

			-- FIX #15: unified drag + long-press handler
			slot.InputBegan:Connect(function(input)
				local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
				local isTouch = input.UserInputType == Enum.UserInputType.Touch
				if not (isMouse or isTouch) then return end

				local startPos = input.Position
				isDragging     = false

				-- FIX #29: Mobile long-press must NEVER clear/remove a car.
				-- Keep a harmless hold timer only to absorb long-tap state; clearing
				-- remains available through PC right-click, gamepad ButtonX, or
				-- dragging a hotbar car back into the open inventory frame.
				if isTouch then
					holdThread = task.delay(0.65, function()
						holdThread = nil
						-- intentionally no clearSlot(i) here
					end)
				end

				local moveCon, upCon

				moveCon = UserInputService.InputChanged:Connect(function(moveInput)
					if moveInput.UserInputType ~= Enum.UserInputType.MouseMovement
						and moveInput.UserInputType ~= Enum.UserInputType.Touch then return end

					if (moveInput.Position - startPos).Magnitude > DRAG_THRESHOLD_PX then
						if moveCon    then moveCon:Disconnect();        moveCon    = nil end
						if upCon      then upCon:Disconnect();          upCon      = nil end
						if holdThread then task.cancel(holdThread);     holdThread = nil end

						-- Only begin hotbar drag while inventory is open.
						-- Guard BEFORE clearing hotbarData so data is never lost
						-- when the inventory is closed.
						if not isOpen then return end

						isDragging = true
						local carName = hotbarData[i]
						if carName and CarStats and CarStats.Cars and CarStats.Cars[carName] then
							local stats = CarStats.Cars[carName]
							-- FIX #32: do not clear hotbarData here. Only mutate data
							-- inside the drop handler after success is confirmed.
							startDrag(
								carName,
								stats.Image or CONFIG.Images.Default,
								moveInput.Position,
								1,
								"hotbar",   -- sourceType
								i,          -- sourceSlot
								nil         -- no button ref for hotbar source
							)
						end
					end
				end)

				upCon = UserInputService.InputEnded:Connect(function(endInput)
					if endInput.UserInputType ~= Enum.UserInputType.MouseButton1
						and endInput.UserInputType ~= Enum.UserInputType.Touch then return end

					isDragging = false
					if moveCon    then moveCon:Disconnect();    moveCon    = nil end
					if upCon      then upCon:Disconnect();      upCon      = nil end
					if holdThread then task.cancel(holdThread); holdThread = nil end
				end)
			end)
		end
	end
	updateHotbarUI()
end

