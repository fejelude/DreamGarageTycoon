-- =========================================================
-- FIX #28: CPS formatting + bonus helpers for CarInfoLabel
-- =========================================================
local function formatCPS(value)
	if value >= 1e12 then
		local t = value / 1e12
		if t == math.floor(t) then
			return string.format("+%dT$/s", t)
		else
			return string.format("+%.1fT$/s", t)
		end
	elseif value >= 1e9 then
		local b = value / 1e9
		if b == math.floor(b) then
			return string.format("+%dB$/s", b)
		else
			return string.format("+%.1fB$/s", b)
		end
	elseif value >= 1e6 then
		local m = value / 1e6
		if m == math.floor(m) then
			return string.format("+%dM$/s", m)
		else
			return string.format("+%.1fM$/s", m)
		end
	elseif value >= 1e3 then
		local k = value / 1e3
		if k == math.floor(k) then
			return string.format("+%dK$/s", k)
		else
			return string.format("+%.1fK$/s", k)
		end
	else
		return string.format("+%d$/s", value)
	end
end

local function updateCarInfoLabel(slot, carName)
	local carInfo = slot:FindFirstChild("CarInfo")
	if not carInfo then return end
	local infoLabel = carInfo:FindFirstChild("CarInfoLabel")
	if not infoLabel then return end

	if carName and CarStats and CarStats.Cars and CarStats.Cars[carName] then
		local baseCPS = CarStats.Cars[carName].CPS or 0
		infoLabel.Text = formatCPS(baseCPS)
	else
		infoLabel.Text = ""
	end
end

-- =========================================================
-- FIX #27: Animated gradient for hotbar name labels
-- Mirrors the inventory's setGlow() system for visual consistency.
-- =========================================================
local function setHotbarNameGlow(nameLabel, rarity)
	if not nameLabel then return end

	-- Ensure stroke exists
	local stroke = nameLabel:FindFirstChild("__NameStroke")
	if not stroke then
		stroke           = Instance.new("UIStroke")
		stroke.Name      = "__NameStroke"
		stroke.Thickness = 1.5
		stroke.Parent    = nameLabel
	end
	stroke.Color = Color3.fromRGB(0, 0, 0) -- default black

	-- Ensure gradient exists
	local grad = nameLabel:FindFirstChild("__NameGrad")
	if not grad then
		grad        = Instance.new("UIGradient")
		grad.Name   = "__NameGrad"
		grad.Parent = nameLabel
	end
	grad.Rotation = -20

	-- Apply rarity-specific colours (matching inventory setGlow exactly)
	if rarity == "Mythic" then
		grad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255, 0, 255)),
		})
	elseif rarity == "Legendary" then
		grad.Color   = ColorSequence.new(Color3.fromRGB(255, 180, 50), Color3.fromRGB(255, 240, 150))
		stroke.Color = Color3.fromRGB(100, 60, 0)
	elseif rarity == "Epic" then
		grad.Color   = ColorSequence.new(Color3.fromRGB(160, 50, 255), Color3.fromRGB(220, 100, 255))
		stroke.Color = Color3.fromRGB(60, 0, 100)
	elseif rarity == "Rare" then
		grad.Color = ColorSequence.new(Color3.fromRGB(0, 100, 255), Color3.fromRGB(100, 200, 255))
	elseif rarity == "Uncommon" then
		grad.Color = ColorSequence.new(Color3.fromRGB(0, 180, 0), Color3.fromRGB(100, 255, 100))
	else
		grad.Color = ColorSequence.new(Color3.fromRGB(150, 150, 150), Color3.fromRGB(220, 220, 220))
	end

	-- Animated shimmer: only create/restart tween when rarity changes
	local lastRarity = grad:GetAttribute("__HBGlowRarity")
	if lastRarity ~= rarity then
		grad:SetAttribute("__HBGlowRarity", rarity)
		if not _G.__GlowTweens then _G.__GlowTweens = setmetatable({}, { __mode = "k" }) end
		if _G.__GlowTweens[grad] then _G.__GlowTweens[grad]:Cancel() end
		grad.Offset = Vector2.new(-0.35, 0)
		local shimmerTween = TweenService:Create(
			grad,
			TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Offset = Vector2.new(0.35, 0) }
		)
		shimmerTween:Play()
		_G.__GlowTweens[grad] = shimmerTween
	end
end

local function refreshSlotVisual(slotIndex)
	if not slotsFolder then return end
	local slot = slotsFolder:FindFirstChild("Slot" .. slotIndex)
	if not slot then return end
	local carName = hotbarData[slotIndex]
	if carName and CarStats and CarStats.Cars and CarStats.Cars[carName] then
		local stats = CarStats.Cars[carName]
		slot.Image              = stats.Image or CONFIG.Images.Default
		slot.ImageTransparency  = 0
		slot.BackgroundColor3   = Color3.fromRGB(255, 255, 255)
		slot.BackgroundTransparency = 0
		-- FIX #21: show display name instead of internal key
		local nameLabel = slot:FindFirstChild("CarName") or slot:FindFirstChild("__SlotName")
		if nameLabel then
			nameLabel.Text    = getDisplayName(carName)
			nameLabel.Visible = true
			-- FIX #27: animated gradient matching inventory glow
			setHotbarNameGlow(nameLabel, stats.Rarity)
		end
		local countBadge = slot:FindFirstChild("__SlotCount")
		if countBadge then countBadge.Visible = false end
		-- FIX #28: update CPS info label
		updateCarInfoLabel(slot, carName)
	else
		slot.Image              = ""
		slot.ImageTransparency  = 1
		slot.BackgroundColor3   = Color3.fromRGB(128, 128, 128)
		slot.BackgroundTransparency = 0.5
		local nameLabel = slot:FindFirstChild("CarName") or slot:FindFirstChild("__SlotName")
		if nameLabel then
			nameLabel.Text    = ""
			nameLabel.Visible = false
		end
		-- FIX #28: clear CPS info label on empty slot
		updateCarInfoLabel(slot, nil)
	end
end

function updateHotbarUI()
	if not slotsFolder then return end

	-- Sanitize: remove hotbar assignments that exceed owned count
	local assignedCounts = {}
	local changed = false
	for i = 1, SLOT_COUNT do
		local carName = hotbarData[i]
		if carName then
			local count         = counts[carName] or 0
			local alreadyAssigned = assignedCounts[carName] or 0
			if count <= 0 or not CarStats or not CarStats.Cars or not CarStats.Cars[carName] or alreadyAssigned >= count then
				hotbarData[i] = nil
				changed = true
			else
				assignedCounts[carName] = alreadyAssigned + 1
			end
		end
	end
	if changed then saveHotbarToAttributes() end

	for i = 1, SLOT_COUNT do
		local slot = slotsFolder:FindFirstChild("Slot" .. i)
		if slot then
			local carName = hotbarData[i]

			-- Use pre-existing CarName label if present, fall back to creating __SlotName
			local nameLabel = slot:FindFirstChild("CarName") or slot:FindFirstChild("__SlotName")
			if not nameLabel then
				nameLabel                     = Instance.new("TextLabel")
				nameLabel.Name                = "__SlotName"
				nameLabel.Size                = UDim2.new(1.4, 0, 0.3, 0)
				nameLabel.Position            = UDim2.new(0.5, 0, 1.05, 0)
				nameLabel.AnchorPoint         = Vector2.new(0.5, 0)
				nameLabel.BackgroundTransparency = 1
				nameLabel.Font                = Enum.Font.FredokaOne
				nameLabel.TextScaled          = true
				nameLabel.TextColor3          = Color3.new(1, 1, 1)
				nameLabel.ZIndex              = slot.ZIndex + 2
				nameLabel.Parent              = slot
				local grad       = Instance.new("UIGradient")
				grad.Name        = "__NameGrad"
				grad.Parent      = nameLabel
				local stroke     = Instance.new("UIStroke")
				stroke.Name      = "__NameStroke"
				stroke.Thickness = 1.5
				stroke.Color     = Color3.fromRGB(0, 0, 0)
				stroke.Parent    = nameLabel
			end

			local countBadge = slot:FindFirstChild("__SlotCount")
			if not countBadge then
				countBadge                     = Instance.new("TextLabel")
				countBadge.Name                = "__SlotCount"
				countBadge.Size                = UDim2.new(0.45, 0, 0.3, 0)
				countBadge.Position            = UDim2.new(0.95, 0, 0.05, 0)
				countBadge.AnchorPoint         = Vector2.new(1, 0)
				countBadge.BackgroundColor3    = Color3.fromRGB(0, 0, 0)
				countBadge.BackgroundTransparency = 0.35
				countBadge.TextColor3          = Color3.new(1, 1, 1)
				countBadge.Font                = Enum.Font.FredokaOne
				countBadge.TextScaled          = true
				countBadge.ZIndex              = slot.ZIndex + 3
				countBadge.Parent              = slot
				Instance.new("UICorner", countBadge).CornerRadius = UDim.new(0, 6)
			end

			if carName and CarStats and CarStats.Cars[carName] then
				local stats = CarStats.Cars[carName]
				slot.Image              = stats.Image or CONFIG.Images.Default
				slot.ImageTransparency  = 0
				slot.BackgroundColor3   = Color3.fromRGB(255, 255, 255)
				slot.BackgroundTransparency = 0
				-- FIX #21 + #27: animated gradient name label
				nameLabel.Text    = getDisplayName(carName)
				nameLabel.Visible = true
				setHotbarNameGlow(nameLabel, stats.Rarity)
				countBadge.Visible = false
				-- FIX #28: update CPS info label
				updateCarInfoLabel(slot, carName)
			else
				slot.Image              = ""
				slot.ImageTransparency  = 1
				slot.BackgroundColor3   = Color3.fromRGB(128, 128, 128)
				slot.BackgroundTransparency = 0.5
				nameLabel.Text     = ""
				nameLabel.Visible  = false
				countBadge.Visible = false
				-- FIX #28: clear CPS info label on empty slot
				updateCarInfoLabel(slot, nil)
			end
		end
	end
	updateSlotSelection()
end

local function snapToSlot(slotIndex)
	local slot = slotsFolder and slotsFolder:FindFirstChild("Slot" .. slotIndex)
	if not slot then return end
	local uiScale = slot:FindFirstChildOfClass("UIScale")
	if uiScale then
		local snapInfo = TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		TweenService:Create(uiScale, snapInfo, { Scale = 1.15 }):Play()
		task.delay(0.12, function()
			TweenService:Create(uiScale, snapInfo, { Scale = 1.0 }):Play()
		end)
	end
end

-- FIX #8: activateSlot toggles equip/unequip
local function activateSlot(index)
	if selectedSlot == index then
		selectedSlot = nil
		updateSlotSelection()
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then hum:UnequipTools() end
		end
		if scheduleRender then scheduleRender() end
		return
	end

	selectedSlot = index
	updateSlotSelection()

	local carName = hotbarData[index]

	if not carName then
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then hum:UnequipTools() end
		end
		if scheduleRender then scheduleRender() end
		return
	end

	local char = player.Character
	if not char then return end
	local bp = player:FindFirstChild("Backpack")
	if not bp then return end

	local tool = bp:FindFirstChild(carName) or char:FindFirstChild(carName)
		or bp:FindFirstChild(carName .. " Item") or char:FindFirstChild(carName .. " Item")
	if not tool or not tool:IsA("Tool") then
		for _, child in ipairs(bp:GetChildren()) do
			if child:IsA("Tool") and child:GetAttribute("ToolId") then
				local id = child:GetAttribute("ToolId")
				local clean = id:gsub(" Item$", ""):gsub("Item$", "")
				if clean == carName or id == carName then tool = child; break end
			end
		end
		if not tool then
			for _, child in ipairs(char:GetChildren()) do
				if child:IsA("Tool") and child:GetAttribute("ToolId") then
					local id = child:GetAttribute("ToolId")
					local clean = id:gsub(" Item$", ""):gsub("Item$", "")
					if clean == carName or id == carName then tool = child; break end
				end
			end
		end
	end

	if tool and tool:IsA("Tool") then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum:UnequipTools()
			hum:EquipTool(tool)
		end
	end
end

local function clearSlot(index)
	hotbarData[index] = nil
	if selectedSlot == index then selectedSlot = nil end
	saveHotbarToAttributes()
	updateHotbarUI()
	UIAudioConfig.PlayClick()
	if scheduleRender then scheduleRender() end
end

-- =========================================================
-- FIX #9 + FIX #12/14: startDrag — full source-aware rewrite
-- =========================================================
local function startDrag(carName, iconImage, startPos, itemCount, sourceType, sourceSlot, sourceBtn)
	-- Cancel any in-flight drag (edge case protection)
	if draggingCar then endDrag(false) end

	draggingCar      = carName
	dragSourceType   = sourceType or "inventory"
	dragSourceSlot   = sourceSlot
	dragSourceButton = sourceBtn

	-- FIX #30: Never hide the inventory source button on mobile.
	-- A cancelled/touch-interrupted drag can otherwise leave the item looking
	-- like it disappeared. The drag icon already communicates movement.
	if dragSourceType == "inventory" and dragSourceButton then
		dragSourceButton.Visible = true
	elseif dragSourceType == "hotbar" and dragSourceSlot and slotsFolder then
		-- FIX #32: hotbarData is NOT cleared before a confirmed drop.
		-- Only dim the slot visually while dragging.
		local srcSlotBtn = slotsFolder:FindFirstChild("Slot" .. dragSourceSlot)
		if srcSlotBtn then
			srcSlotBtn.ImageTransparency = 0.35
			local nl = srcSlotBtn:FindFirstChild("CarName") or srcSlotBtn:FindFirstChild("__SlotName")
			if nl then nl.Visible = true end
		end
	end

	-- Disable scroll frame during drag (prevents mobile scroll interference)
	if hotbarScrollFrame then
		hotbarScrollFrame.ScrollingEnabled = false
	end

	-- FIX #9: icon size proportional to viewport
	local vp     = camera.ViewportSize
	local iconPx = math.min(vp.X, vp.Y) * 0.09

	dragIcon                    = Instance.new("ImageLabel")
	dragIcon.Name               = "DragIcon"
	dragIcon.Size               = UDim2.new(0, iconPx * 0.45, 0, iconPx * 0.45)
	dragIcon.AnchorPoint        = Vector2.new(0.5, 0.5)
	dragIcon.BackgroundTransparency = 1
	dragIcon.Image              = iconImage
	dragIcon.ZIndex             = 1000
	dragIcon.ImageTransparency  = DRAG_ICON_ALPHA
	dragIcon.Rotation           = -5
	dragIcon.Position           = UDim2.new(0, startPos.X, 0, startPos.Y)
	dragIcon.Parent             = inventoryScreenGui or playerGui

	Instance.new("UICorner", dragIcon).CornerRadius = UDim.new(0, 10)

	if itemCount and itemCount > 0 then
		local dc                     = Instance.new("TextLabel")
		dc.Name                      = "DragCount"
		dc.Size                      = UDim2.new(0.4, 0, 0.3, 0)
		dc.Position                  = UDim2.new(0.95, 0, 0.05, 0)
		dc.AnchorPoint               = Vector2.new(1, 0)
		dc.BackgroundColor3          = Color3.fromRGB(0, 0, 0)
		dc.BackgroundTransparency    = 0.35
		dc.TextColor3                = Color3.new(1, 1, 1)
		dc.Font                      = Enum.Font.FredokaOne
		dc.TextScaled                = true
		dc.Text                      = "x" .. tostring(itemCount)
		dc.ZIndex                    = 1001
		dc.Parent                    = dragIcon
		Instance.new("UICorner", dc).CornerRadius = UDim.new(0, 6)
	end

	TweenService:Create(dragIcon, DRAG_TWEEN_INFO, {
		Size     = UDim2.new(0, iconPx, 0, iconPx),
		Rotation = 0
	}):Play()

	-- ── Movement: follow cursor + highlight targets ───────────────
	dragConn = UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement
			and input.UserInputType ~= Enum.UserInputType.Touch then return end

		if dragIcon then
			dragIcon.Position = UDim2.new(0, input.Position.X, 0, input.Position.Y)
		end

		local overSlot    = getSlotAtPosition(input.Position)
		-- FIX #16: compute inventory highlight state
		local onInventory = (dragSourceType == "hotbar") and isOnInventoryFrame(input.Position)

		-- Update hotbar slot highlights
		if overSlot ~= hoveredSlot then
			if hoveredSlot and slotsFolder then
				local old = slotsFolder:FindFirstChild("Slot" .. hoveredSlot)
				if old then
					local hl = old:FindFirstChild("__DragHighlight")
					if hl then hl.Visible = false end
				end
			end
			if overSlot and slotsFolder then
				local isSrc = (dragSourceType == "hotbar" and dragSourceSlot == overSlot)
				if not isSrc then
					local newSlot = slotsFolder:FindFirstChild("Slot" .. overSlot)
					if newSlot then
						local hl = newSlot:FindFirstChild("__DragHighlight")
						if not hl then
							hl                       = Instance.new("Frame")
							hl.Name                  = "__DragHighlight"
							hl.Size                  = UDim2.new(1, 0, 1, 0)
							hl.BackgroundColor3      = SLOT_HIGHLIGHT_COLOR
							hl.BackgroundTransparency = 0.7
							hl.ZIndex                = newSlot.ZIndex + 1
							hl.Parent                = newSlot
							Instance.new("UICorner", hl).CornerRadius = UDim.new(0, 8)
						end
						hl.Visible = true
						UIAudioConfig.PlayHover()
					end
				end
			end
			hoveredSlot = overSlot
		end

		-- FIX #16: green overlay on inventory frame for hotbar→inventory drag
		if mainWindow then
			local invHl = mainWindow:FindFirstChild("__InvDragHighlight")
			if not invHl and dragSourceType == "hotbar" then
				invHl                     = Instance.new("Frame")
				invHl.Name                = "__InvDragHighlight"
				invHl.Size                = UDim2.new(1, 0, 1, 0)
				invHl.BackgroundColor3    = Color3.fromRGB(100, 255, 150)
				invHl.BackgroundTransparency = 0.82
				invHl.ZIndex              = (itemsContainer and itemsContainer.ZIndex or mainWindow.ZIndex) + 50
				invHl.Parent              = mainWindow
				Instance.new("UICorner", invHl).CornerRadius = UDim.new(0, 8)
			end
			if invHl then
				invHl.Visible = (dragSourceType == "hotbar") and onInventory and (overSlot == nil)
			end
		end
	end)

	-- ── FIX #14: Drop handler — all source→target combinations ───
	globalDropConn = UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then return end

		local dropPos   = input.Position
		local car       = draggingCar
		local srcType   = dragSourceType
		local srcSlot   = dragSourceSlot

		if not car then endDrag(false); return end

		local targetSlot  = getSlotAtPosition(dropPos)
		local onHotbar    = isOnHotbarFrame(dropPos)
		local onInventory = isOnInventoryFrame(dropPos)

		local success       = false
		local affectedSlots = {}

		if srcType == "inventory" then
			-- ── Inventory → specific hotbar slot ─────────────────
			if targetSlot then
				hotbarData[targetSlot] = car
				table.insert(affectedSlots, targetSlot)
				success = true

				-- ── Inventory → hotbar frame (first empty slot) ───────
			elseif onHotbar then
				local empty = getFirstEmptyHotbarSlot(nil)
				if empty then
					hotbarData[empty] = car
					table.insert(affectedSlots, empty)
					success = true
				end
				-- All slots full → cancel (button restores)
			end
			-- Drop anywhere else → cancel

		elseif srcType == "hotbar" then
			-- ── Hotbar → different hotbar slot (swap) ────────────
			if targetSlot and targetSlot ~= srcSlot then
				local displaced        = hotbarData[targetSlot]
				hotbarData[targetSlot] = car
				hotbarData[srcSlot]    = displaced  -- nil or swapped car
				table.insert(affectedSlots, targetSlot)
				table.insert(affectedSlots, srcSlot)
				success = true

				-- ── Hotbar → same slot → cancel ───────────────────────
			elseif targetSlot and targetSlot == srcSlot then
				success = false

				-- ── Hotbar → hotbar frame but not a slot ─────────────
			elseif onHotbar and not targetSlot then
				local empty = getFirstEmptyHotbarSlot(srcSlot)
				if empty then
					hotbarData[empty]  = car
					hotbarData[srcSlot] = nil
					table.insert(affectedSlots, empty)
					table.insert(affectedSlots, srcSlot)
					success = true
				end
				-- No empty slot → cancel

				-- ── Hotbar → inventory frame (eject from hotbar) ─────
			elseif onInventory then
				hotbarData[srcSlot] = nil
				table.insert(affectedSlots, srcSlot)
				success = true
			end
			-- Drop anywhere else → cancel (restores srcSlot via endDrag(false))
		end

		if success then
			endDrag(true)
			saveHotbarToAttributes()
			UIAudioConfig.PlayClick()
			for _, si in ipairs(affectedSlots) do
				refreshSlotVisual(si)
			end
			if affectedSlots[1] then snapToSlot(affectedSlots[1]) end

			-- FIX #26: Defer the final authoritative render by one frame.
			-- This ensures all pending deferred tasks (FIX #25 ChildRemoved
			-- sweep, ChildAdded scheduleRender, etc.) have settled before
			-- we paint the definitive UI state. Without this, a stale
			-- deferred render could overwrite the correct post-drop visuals.
			refreshQueued = true  -- block any pending scheduleRender
			task.defer(function()
				refreshQueued = false
				updateHotbarUI()
				if isOpen then renderCurrentTab() end
				updateHotbarUI()  -- second pass after render adjusts hotbar assignments
			end)
		else
			endDrag(false)  -- restores source visually
		end
	end)
end

