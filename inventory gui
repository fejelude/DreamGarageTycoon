	if cons then
		for _, c in ipairs(cons) do
			if c and c.Disconnect then c:Disconnect() end
		end
	end
	buttonCons[btn] = nil
	btn:SetAttribute("__HoverBound", nil)
end

-- =========================================================
-- FIX #3 + FIX #6
-- setGlow now tracks the last rarity applied on the gradient
-- via __GlowRarity attribute.  If the rarity differs from the
-- previous render, the old tween is cancelled and a new one
-- started.  This fixes the stale-tween bug on pool reuse and
-- avoids creating redundant tween objects when the rarity
-- has not changed.
-- =========================================================
local function setGlow(label, rarity)
	local stroke = label:FindFirstChild("__GlowStroke") or Instance.new("UIStroke")
	stroke.Name = "__GlowStroke"
	stroke.Thickness = 3
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label

	local grad = label:FindFirstChild("__GlowGrad") or Instance.new("UIGradient")
	grad.Name = "__GlowGrad"
	grad.Rotation = -20
	grad.Parent = label

	-- Always update gradient colours so reused buttons show the correct rarity
	if rarity == "Mythic" then
		grad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255, 0, 255)),
		})
	elseif rarity == "Legendary" then
		grad.Color = ColorSequence.new(Color3.fromRGB(255, 180, 50), Color3.fromRGB(255, 240, 150))
		stroke.Color = Color3.fromRGB(100, 60, 0)
	elseif rarity == "Epic" then
		grad.Color = ColorSequence.new(Color3.fromRGB(160, 50, 255), Color3.fromRGB(220, 100, 255))
		stroke.Color = Color3.fromRGB(60, 0, 100)
	elseif rarity == "Rare" then
		grad.Color = ColorSequence.new(Color3.fromRGB(0, 100, 255), Color3.fromRGB(100, 200, 255))
	elseif rarity == "Uncommon" then
		grad.Color = ColorSequence.new(Color3.fromRGB(0, 180, 0), Color3.fromRGB(100, 255, 100))
	else
		grad.Color = ColorSequence.new(Color3.fromRGB(150, 150, 150), Color3.fromRGB(220, 220, 220))
	end

	-- FIX #3 + FIX #6: only (re)start the tween when the rarity changed
	local lastRarity = grad:GetAttribute("__GlowRarity")
	if lastRarity ~= rarity then
		grad:SetAttribute("__GlowRarity", rarity)

		-- Cancel the previous tween stored on the gradient (if any)
		if not _G.__GlowTweens then _G.__GlowTweens = setmetatable({}, { __mode = "k" }) end
		if _G.__GlowTweens[grad] then
			_G.__GlowTweens[grad]:Cancel()
		end

		grad.Offset = Vector2.new(-0.35, 0)
		local newTween = TweenService:Create(
			grad,
			TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Offset = Vector2.new(0.35, 0) }
		)
		newTween:Play()
		_G.__GlowTweens[grad] = newTween  -- FIX #3/#6: track for future cancellation
	end
end

