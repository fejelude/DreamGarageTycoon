	counts          = {}
	sampleTool      = {}

	currentBackpack = player:WaitForChild("Backpack")

	for _, c in ipairs(bpConnections) do c:Disconnect() end
	bpConnections = bindContainer(currentBackpack)
	scanContainer(currentBackpack)

	task.defer(function()
		onCharacter(char)
		scheduleRender()
		updateLimitIndicator()
	end)
end)

