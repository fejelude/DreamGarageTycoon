-- LocalScript: StarterPlayerScripts > GlobalBoostNotificationClient
-- Purpose: Displays cross-server purchase notifications for global boost Developer Products.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local player = Players.LocalPlayer

local DISPLAY_TIME = 6
local BETWEEN_NOTIFICATIONS_DELAY = 0.2
local STATE_RECONCILE_INTERVAL = 15
local NOTIFICATION_REPLAY_WINDOW = 180
local TWEEN_IN = TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local TWEEN_OUT = TweenInfo.new(0.24, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local BOOST_SOURCES = {
	{
		State = ReplicatedStorage:WaitForChild("GlobalLuckRemotes"):WaitForChild("State"),
		GetState = ReplicatedStorage:WaitForChild("GlobalLuckRemotes"):WaitForChild("GetState"),
		StatusSuffix = "Luck",
	},
	{
		State = ReplicatedStorage:WaitForChild("GlobalMoneyFrenzyRemotes"):WaitForChild("State"),
		GetState = ReplicatedStorage:WaitForChild("GlobalMoneyFrenzyRemotes"):WaitForChild("GetState"),
		StatusSuffix = "Money",
	},
}

local notificationQueue = {}
local isDisplaying = false
local seenNotifications = {}
local originalTransparency = setmetatable({}, { __mode = "k" })
local originalPositions = setmetatable({}, { __mode = "k" })

local function getUI()
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then return nil end

	local notificationsGui = playerGui:FindFirstChild("Notifications")
	if not notificationsGui then return nil end

	notificationsGui.DisplayOrder = 999999
	notificationsGui.Enabled = true

	local frame = notificationsGui:FindFirstChild("GlobalBoostNotificationFrame")
	local label = frame and frame:FindFirstChild("GlobalBoostNotification")

	if frame then
		frame:SetAttribute("ExternallyManaged", true)
	end

	return notificationsGui, frame, label
end

local function bringNotificationToFront(frame, label)
	if not frame or not label then return end
	local topZIndex = 10000
	if frame:IsA("GuiObject") then
		frame.ZIndex = topZIndex
	end
	for _, inst in ipairs(frame:GetDescendants()) do
		if inst:IsA("GuiObject") then
			inst.ZIndex = topZIndex + 1
		end
	end
end

local function rememberTransparency(inst, property)
	originalTransparency[inst] = originalTransparency[inst] or {}
	if originalTransparency[inst][property] == nil then
		originalTransparency[inst][property] = inst[property]
	end
end

local function getOriginalTransparency(inst, property)
	local values = originalTransparency[inst]
	return values and values[property] or 0
end

local function setGroupTransparency(frame, label, value)
	value = math.clamp(value, 0, 1)
	if frame:IsA("GuiObject") then
		rememberTransparency(frame, "BackgroundTransparency")
		frame.BackgroundTransparency = value
	end
	if label:IsA("TextLabel") or label:IsA("TextButton") then
		rememberTransparency(label, "TextTransparency")
		label.TextTransparency = value
	end
	for _, inst in ipairs(frame:GetDescendants()) do
		if inst:IsA("TextLabel") or inst:IsA("TextButton") then
			rememberTransparency(inst, "TextTransparency")
			inst.TextTransparency = value
		elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			rememberTransparency(inst, "ImageTransparency")
			inst.ImageTransparency = value
		elseif inst:IsA("UIStroke") then
			rememberTransparency(inst, "Transparency")
			inst.Transparency = value
		end
	end
end

local function playBoostSound()
	UIAudioConfig.PlayNamed("GlobalBoostPurchase")
end

local function waitForTween(tween, timeoutSeconds)
	local finished = false
	local connection = tween.Completed:Connect(function()
		finished = true
	end)
	local startedAt = os.clock()
	while not finished and os.clock() - startedAt < timeoutSeconds do
		task.wait()
	end
	connection:Disconnect()
	if not finished then
		pcall(function() tween:Cancel() end)
	end
end

local function displayNotification(message)
	local _gui, frame, label = getUI()
	if not (frame and label) then return false end

	local originalPosition = originalPositions[frame] or frame.Position
	originalPositions[frame] = originalPosition
	local hiddenPosition = originalPosition - UDim2.fromOffset(0, 24)

	bringNotificationToFront(frame, label)
	label.Text = message
	label.Visible = true
	frame.Visible = true
	frame.Position = hiddenPosition
	setGroupTransparency(frame, label, 1)
	playBoostSound()

	TweenService:Create(frame, TWEEN_IN, { Position = originalPosition }):Play()
	TweenService:Create(label, TWEEN_IN, { TextTransparency = getOriginalTransparency(label, "TextTransparency") }):Play()
	pcall(function()
		TweenService:Create(frame, TWEEN_IN, { BackgroundTransparency = getOriginalTransparency(frame, "BackgroundTransparency") }):Play()
	end)
	for _, inst in ipairs(frame:GetDescendants()) do
		if inst:IsA("TextLabel") or inst:IsA("TextButton") then
			TweenService:Create(inst, TWEEN_IN, { TextTransparency = getOriginalTransparency(inst, "TextTransparency") }):Play()
		elseif inst:IsA("UIStroke") then
			TweenService:Create(inst, TWEEN_IN, { Transparency = getOriginalTransparency(inst, "Transparency") }):Play()
		elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			TweenService:Create(inst, TWEEN_IN, { ImageTransparency = getOriginalTransparency(inst, "ImageTransparency") }):Play()
		end
	end

	task.wait(DISPLAY_TIME)
	if not frame.Parent then return true end

	local outTween = TweenService:Create(frame, TWEEN_OUT, { Position = hiddenPosition })
	outTween:Play()
	TweenService:Create(frame, TWEEN_OUT, { BackgroundTransparency = 1 }):Play()
	for _, inst in ipairs(frame:GetDescendants()) do
		if inst:IsA("TextLabel") or inst:IsA("TextButton") then
			TweenService:Create(inst, TWEEN_OUT, { TextTransparency = 1 }):Play()
		elseif inst:IsA("UIStroke") then
			TweenService:Create(inst, TWEEN_OUT, { Transparency = 1 }):Play()
		elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			TweenService:Create(inst, TWEEN_OUT, { ImageTransparency = 1 }):Play()
		end
	end
	waitForTween(outTween, TWEEN_OUT.Time + 1)

	if frame.Parent then
		frame.Visible = false
		frame.Position = originalPosition
	end
	return true
end

local function processQueue()
	if isDisplaying or #notificationQueue == 0 then return end
	isDisplaying = true
	while #notificationQueue > 0 do
		local message = notificationQueue[1]
		local ok, displayed = pcall(displayNotification, message)
		if not ok then
			warn("[GlobalBoostNotificationClient] Notification display failed: " .. tostring(displayed))
			displayed = false
		end
		if displayed then
			table.remove(notificationQueue, 1)
			if #notificationQueue > 0 then
				-- Let the completed notification's visibility/transparency changes
				-- replicate for a frame before the next queued activation reuses it.
				task.wait(BETWEEN_NOTIFICATIONS_DELAY)
			end
		else
			task.wait(1) -- retain valid work and retry after transient UI failures
		end
	end
	isDisplaying = false
end

local function showNotification(message)
	if not message or message == "" then return end
	table.insert(notificationQueue, message)
	task.spawn(processQueue)
end

local function getNotificationId(state)
	local notification = type(state) == "table" and state.BoostPurchaseNotification
	if type(notification) ~= "table" then return "" end
	return tostring(notification.Id or "")
end

local function rememberNotification(state)
	local id = getNotificationId(state)
	if id ~= "" then
		seenNotifications[id] = tonumber(state.ServerTime) or os.time()
	end
end

-- Shared freshness test: is the notification embedded in this state actually
-- something that just happened, as opposed to something that was already
-- active before we started looking (e.g. before this client joined)?
-- Both the live-event path and the initial join-time snapshot path need to
-- agree on this, or a purchase that lands right around join time can be
-- classified differently depending on which network response wins the race.
local function isNotificationFresh(state)
	if type(state) ~= "table" then return false end
	local notification = state.BoostPurchaseNotification
	if type(notification) ~= "table" then return false end
	local serverTime = tonumber(state.ServerTime) or os.time()
	local activatedAt = tonumber(state.ActivatedAt) or serverTime
	return math.abs(serverTime - activatedAt) <= NOTIFICATION_REPLAY_WINDOW
end

local function handleLiveState(state)
	if type(state) ~= "table" then return end
	if not isNotificationFresh(state) then return end

	local notification = state.BoostPurchaseNotification
	local serverTime = tonumber(state.ServerTime) or os.time()
	for seenId, seenAt in pairs(seenNotifications) do
		if serverTime - seenAt > NOTIFICATION_REPLAY_WINDOW * 2 then seenNotifications[seenId] = nil end
	end

	local id = tostring(notification.Id or "")
	if id == "" or seenNotifications[id] then return end
	seenNotifications[id] = serverTime

	local username = tostring(notification.Username or "")
	local displayName = tostring(notification.DisplayName or username)
	local boostName = tostring(notification.BoostName or "")
	if username == "" or boostName == "" then return end

	boostName = boostName:gsub("^Global%s+", "")
	showNotification(string.format("%s (@%s) activated %s!", displayName, username, boostName))
end

-- Handles the state snapshot fetched via GetState:InvokeServer() at join time.
-- If the notification riding along with that snapshot is stale (the boost
-- was already active before we joined), we just remember it as a baseline
-- and optionally show the ambient "currently active" indicator. If it's
-- fresh (a purchase landed right as we were joining), we hand it to
-- handleLiveState instead so it gets the proper "@Username activated X!"
-- treatment and is correctly marked as seen for dedup purposes.
local function reconcileInitialState(source, state)
	if isNotificationFresh(state) then
		handleLiveState(state)
		return
	end

	rememberNotification(state)
	if state.Active == true then
		local multiplier = tostring(state.CurrentLuck or state.Multiplier or "2x")
		if not multiplier:find("x", 1, true) then multiplier ..= "x" end
		showNotification(string.format("%s %s is currently active!", multiplier, source.StatusSuffix))
	end
end

local function reconcileSource(source)
	local ok, state = pcall(function()
		return source.GetState:InvokeServer()
	end)
	if ok then
		handleLiveState(state)
	end
end

for _, source in ipairs(BOOST_SOURCES) do
	source.Initialized = false
	source.State.OnClientEvent:Connect(function(state)
		-- PlayerAdded can send the already-active state before the initial
		-- authoritative InvokeServer completes. That is join state, not a live sale.
		if source.Initialized then
			handleLiveState(state)
		else
			source.PendingState = state
		end
	end)
end

for _, source in ipairs(BOOST_SOURCES) do
	task.spawn(function()
		-- A failed initial request stays in join-state mode and retries. This avoids
		-- later reconciling an old activation as if it were a new live purchase.
		local initialState
		repeat
			local ok, state = pcall(function()
				return source.GetState:InvokeServer()
			end)
			if ok and type(state) == "table" then
				initialState = state
			else
				task.wait(2)
			end
		until initialState

		reconcileInitialState(source, initialState)
		source.Initialized = true

		-- Any broadcast that arrived while we were still initializing gets
		-- replayed through the exact same live-state path used everywhere
		-- else. handleLiveState's own freshness + dedup checks make this
		-- safe even if it turns out to be the same purchase we just
		-- processed above (seenNotifications will simply short-circuit it).
		local pendingState = source.PendingState
		source.PendingState = nil
		if pendingState then
			handleLiveState(pendingState)
		end

		while true do
			task.wait(STATE_RECONCILE_INTERVAL)
			reconcileSource(source)
		end
	end)
end
