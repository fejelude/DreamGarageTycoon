-- Purpose: Server-authoritative Rewards Corner claiming for the one-time free reward.
-- Runs on: Server
-- Location: ServerScriptService > FreeRewardsService
--
-- Client owns UI open/close and trigger-range behavior.
-- Server owns only:
--   * state lookup
--   * server-side group validation
--   * like acknowledgement storage for the current session
--   * one-time reward claim validation
--   * calling TycoonDataHandler through TycoonAdminAPI
--
-- Required Explorer setup:
--   ReplicatedStorage > FreeRewardsRemotes [Folder]
--     GetFreeRewardsState [RemoteFunction]
--     AcknowledgeFreeRewardLike [RemoteEvent]
--     ClaimFreeReward [RemoteFunction]
--     FreeRewardsStateChanged [RemoteEvent]
--   ServerStorage > TycoonAdminAPI [BindableFunction]
--   Workspace > RewardsCorner > TriggerPart [BasePart]
--   StarterGui > RewardsUi > MainFrame
--
-- Notes:
--   * This script intentionally does NOT open or close PlayerGui.
--   * TriggerPart proximity is handled by the LocalScript.
--   * Wallet Cash and Windsor grants happen only on the server.
--   * Roblox does not expose a reliable server-verifiable per-player "liked this experience" API.
--     The like step is therefore treated as a session acknowledgement from the client UI.
--   * The one-time claimed flag is persisted by TycoonDataHandler through FreeRewardsClaimed.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")
local MutationRateLimiter = require(ServerScriptService:WaitForChild("MutationRateLimiter"))

local REMOTES_FOLDER_NAME = "FreeRewardsRemotes"
local GET_STATE_NAME = "GetFreeRewardsState"
local ACKNOWLEDGE_LIKE_NAME = "AcknowledgeFreeRewardLike"
local CLAIM_NAME = "ClaimFreeReward"
local STATE_CHANGED_NAME = "FreeRewardsStateChanged"

local DATA_READY_ATTRIBUTE = "TycoonDataLoaded"
local CLAIMED_ATTRIBUTE = "FreeRewardsClaimed"
local LIKE_ACKNOWLEDGED_ATTRIBUTE = "FreeRewardsLikeAcknowledged"

local GROUP_ID = 35973937
local REWARD_CAR_NAME = "Windsor"
local REWARD_WALLET_CASH = 250000

local DATA_READY_TIMEOUT_SECONDS = 12
local CLAIM_COOLDOWN_SECONDS = 5
local LIKE_ACK_COOLDOWN_SECONDS = 1
local GROUP_STATE_CACHE_SECONDS = 60
local REQUIRED_WAIT_SECONDS = 8

local SUCCESS_MESSAGE = "Reward claimed! The Windsor Car has been added to your inventory, and 250,000 Wallet Cash has been added to your account."

local claimLocks = {}
local lastClaimAttemptAt = {}
local lastLikeAckAt = {}
local groupStateCache = {}

local function failSetup(message)
	error("[FreeRewards] " .. message, 0)
end

local function getRequiredChild(parent, childName, className, pathForMessage, waitSeconds)
	if not parent then
		failSetup("Missing parent while looking for " .. tostring(pathForMessage or childName) .. ".")
	end

	local child = parent:FindFirstChild(childName)
	if not child and waitSeconds and waitSeconds > 0 then
		child = parent:WaitForChild(childName, waitSeconds)
	end

	local fullPath = pathForMessage or (parent:GetFullName() .. " > " .. childName)
	if not child then
		failSetup("Missing required instance: " .. fullPath .. ". Create it manually in Explorer; this script will not create it automatically.")
	end

	if className and not child:IsA(className) then
		failSetup("Invalid required instance: " .. fullPath .. " must be a " .. className .. ", but found " .. child.ClassName .. ".")
	end

	return child
end

local remotesFolder = getRequiredChild(
	ReplicatedStorage,
	REMOTES_FOLDER_NAME,
	"Folder",
	"ReplicatedStorage > " .. REMOTES_FOLDER_NAME,
	REQUIRED_WAIT_SECONDS
)

local getStateFunction = getRequiredChild(
	remotesFolder,
	GET_STATE_NAME,
	"RemoteFunction",
	"ReplicatedStorage > " .. REMOTES_FOLDER_NAME .. " > " .. GET_STATE_NAME,
	REQUIRED_WAIT_SECONDS
)

local acknowledgeLikeEvent = getRequiredChild(
	remotesFolder,
	ACKNOWLEDGE_LIKE_NAME,
	"RemoteEvent",
	"ReplicatedStorage > " .. REMOTES_FOLDER_NAME .. " > " .. ACKNOWLEDGE_LIKE_NAME,
	REQUIRED_WAIT_SECONDS
)

local claimFunction = getRequiredChild(
	remotesFolder,
	CLAIM_NAME,
	"RemoteFunction",
	"ReplicatedStorage > " .. REMOTES_FOLDER_NAME .. " > " .. CLAIM_NAME,
	REQUIRED_WAIT_SECONDS
)

local stateChangedEvent = getRequiredChild(
	remotesFolder,
	STATE_CHANGED_NAME,
	"RemoteEvent",
	"ReplicatedStorage > " .. REMOTES_FOLDER_NAME .. " > " .. STATE_CHANGED_NAME,
	REQUIRED_WAIT_SECONDS
)

local adminApi = getRequiredChild(
	ServerStorage,
	"TycoonAdminAPI",
	"BindableFunction",
	"ServerStorage > TycoonAdminAPI",
	REQUIRED_WAIT_SECONDS
)

-- Validate the trigger exists, but do not bind Touched here.
local rewardsCorner = getRequiredChild(
	Workspace,
	"RewardsCorner",
	nil,
	"Workspace > RewardsCorner",
	REQUIRED_WAIT_SECONDS
)

getRequiredChild(
	rewardsCorner,
	"TriggerPart",
	"BasePart",
	"Workspace > RewardsCorner > TriggerPart",
	REQUIRED_WAIT_SECONDS
)

local function clearGroupCache(player)
	groupStateCache[player] = nil
end

local function ensureStateReady(player, timeoutSeconds)
	if player:GetAttribute(DATA_READY_ATTRIBUTE) == true then
		return true
	end

	local started = os.clock()
	while player.Parent and os.clock() - started < timeoutSeconds do
		if player:GetAttribute(DATA_READY_ATTRIBUTE) == true then
			return true
		end

		task.wait(0.1)
	end

	return player:GetAttribute(DATA_READY_ATTRIBUTE) == true
end

local function isInRewardsGroupFresh(player)
	local ok, result = pcall(function()
		return player:IsInGroup(GROUP_ID)
	end)

	if not ok then
		warn("⚠️ [FreeRewards] Group check failed for " .. player.Name .. ": " .. tostring(result))
		return nil
	end

	return result == true
end

local function isInRewardsGroupCached(player, forceRefresh)
	local cached = groupStateCache[player]
	local now = os.clock()

	if cached and not forceRefresh and now - cached.CheckedAt < GROUP_STATE_CACHE_SECONDS then
		return cached.Value == true
	end
	if forceRefresh and not MutationRateLimiter.Allow(player, "FreeRewards:GroupLookup", 1, 1 / 30) then
		return cached and cached.Value == true or false
	end
	if not MutationRateLimiter.AllowGlobal("FreeRewards:GroupLookup", 20, 2) then
		return cached and cached.Value == true or false
	end

	local value = isInRewardsGroupFresh(player)
	if value == nil then
		return cached and cached.Value == true or false
	end
	groupStateCache[player] = {
		CheckedAt = now,
		Value = value,
	}

	return value
end

local function hasAcknowledgedLike(player)
	return player:GetAttribute(LIKE_ACKNOWLEDGED_ATTRIBUTE) == true
end

local function hasClaimed(player)
	return player:GetAttribute(CLAIMED_ATTRIBUTE) == true
end

local function buildClientState(player, useFreshGroupCheck)
	local claimed = hasClaimed(player)
	local dataReady = player:GetAttribute(DATA_READY_ATTRIBUTE) == true

	local groupJoined
	if claimed then
		groupJoined = true
	elseif useFreshGroupCheck then
		groupJoined = isInRewardsGroupCached(player, true)
	else
		groupJoined = isInRewardsGroupCached(player)
	end

	local likeAcknowledged = claimed or hasAcknowledgedLike(player)

	return {
		Loading = not dataReady,
		GroupJoined = groupJoined,
		LikeCompleted = likeAcknowledged,
		Claimed = claimed,
		CanClaim = dataReady and groupJoined and likeAcknowledged and not claimed,
		RewardCarName = REWARD_CAR_NAME,
		RewardWalletCash = REWARD_WALLET_CASH,
		LikeIsAcknowledgement = true,
	}
end

local function fireState(player, useFreshGroupCheck)
	if player and player.Parent then
		stateChangedEvent:FireClient(player, buildClientState(player, useFreshGroupCheck == true))
	end
end

local function tryClaim(player)
	if not ensureStateReady(player, DATA_READY_TIMEOUT_SECONDS) then
		return false, "Reward system is loading. Please try again.", buildClientState(player, false)
	end

	local now = os.clock()
	if lastClaimAttemptAt[player] and now - lastClaimAttemptAt[player] < CLAIM_COOLDOWN_SECONDS then
		return false, "Please wait a moment before trying again.", buildClientState(player, false)
	end
	lastClaimAttemptAt[player] = now

	if claimLocks[player] then
		return false, "Please wait a moment before trying again.", buildClientState(player, false)
	end

	claimLocks[player] = true

	local ok, success, message = pcall(function()
		if hasClaimed(player) then
			return false, "You have already claimed this reward."
		end

		if not isInRewardsGroupCached(player, true) or not hasAcknowledgedLike(player) then
			return false, "Complete both quests before claiming your reward."
		end

		local claimOk, claimMessage = adminApi:Invoke("ClaimFreeReward", player, REWARD_CAR_NAME, REWARD_WALLET_CASH)
		if claimOk ~= true then
			return false, tostring(claimMessage or "Reward save failed. Please try again.")
		end

		return true, SUCCESS_MESSAGE
	end)

	claimLocks[player] = nil

	if not ok then
		warn("⚠️ [FreeRewards] Claim failed for " .. player.Name .. ": " .. tostring(success))
		return false, "Reward system is not ready yet.", buildClientState(player, true)
	end

	local updatedState = buildClientState(player, true)
	stateChangedEvent:FireClient(player, updatedState)

	return success, message, updatedState
end

getStateFunction.OnServerInvoke = function(player)
	if not MutationRateLimiter.Allow(player, "FreeRewards:GetState", 4, 0.5) then
		return buildClientState(player, false)
	end
	if player:GetAttribute(DATA_READY_ATTRIBUTE) ~= true then
		task.spawn(function()
			if ensureStateReady(player, DATA_READY_TIMEOUT_SECONDS) and player.Parent then
				fireState(player, true)
			end
		end)
	end

	return buildClientState(player, false)
end

acknowledgeLikeEvent.OnServerEvent:Connect(function(player)
	if not MutationRateLimiter.Allow(player, "FreeRewards:AcknowledgeLike", 2, 0.2) then return end
	if hasClaimed(player) then
		return
	end

	local now = os.clock()
	if lastLikeAckAt[player] and now - lastLikeAckAt[player] < LIKE_ACK_COOLDOWN_SECONDS then
		return
	end

	lastLikeAckAt[player] = now
	player:SetAttribute(LIKE_ACKNOWLEDGED_ATTRIBUTE, true)

	fireState(player, false)
end)

claimFunction.OnServerInvoke = function(player)
	if not MutationRateLimiter.Allow(player, "FreeRewards:Claim", 1, 0.2) then
		return false, "Please wait a moment before trying again.", buildClientState(player, false)
	end
	return tryClaim(player)
end

Players.PlayerRemoving:Connect(function(player)
	claimLocks[player] = nil
	lastClaimAttemptAt[player] = nil
	lastLikeAckAt[player] = nil
	groupStateCache[player] = nil
end)
