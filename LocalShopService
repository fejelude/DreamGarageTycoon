-- CONFIG
-- =========================
local CAR_WEIGHTS = {
	Clunker = 150,
	Rustix = 110,
	Breako = 80,
	Delta = 50,
	Diva = 35,
	Iva = 20,
	Atom = 15,
	Hiva = 12,
	Senator = 9,
	Windsor = 5,
	Riva = 1
}
local ALWAYS_STOCK = {} -- Disabled: nothing guaranteed, same as other shops

local RESTOCK_INTERVAL = 300
local PURCHASE_COOLDOWN = 0.5
local MAX_STOCK = 4 -- Per-car restock cap for this shop tier.
local MIN_FEATURED_CARS = 2
local FEATURED_COUNT_ROLLS = {
	{ Threshold = 0.90, Count = 4 },
	{ Threshold = 0.55, Count = 3 },
}
local STOCK_UPGRADE_CHANCES = { [2] = 0.75, [3] = 0.45, [4] = 0.22 }

