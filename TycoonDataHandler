		for _, entry in pairs(type(data.Layout) == "table" and data.Layout or {}) do
			if #sanitizedLayout >= MAX_LAYOUT_SIZE then error("Saved layout exceeds safety limit") end
			local toolName = type(entry) == "table" and entry.Tool or nil
			local padName = type(entry) == "table" and entry.Pad or nil
			if type(toolName) == "string" and type(padName) == "string"
				and safeFindCarTool(toolName, entry.IsRobuxExclusive == true) and not seenPads[padName]
			then
				seenPads[padName] = true
				local issuedId = entry.IssuedId or generateCarGUID(player)
				reserveIdentity(issuedId)
				table.insert(sanitizedLayout, {Tool=toolName, Pad=padName, IsRobuxExclusive=entry.IsRobuxExclusive == true, IssuedId=issuedId})
