local function sanitizeRobuxReceiptHistory(raw)
	local history = {}
	if type(raw) ~= "table" then
		return history
	end

	for receiptId, receiptData in pairs(raw) do
		if type(receiptId) == "string" and receiptId ~= "" then
			if type(receiptData) == "table" then
				history[receiptId] = {
					ToolId = type(receiptData.ToolId) == "string" and receiptData.ToolId or nil,
					ProductId = tonumber(receiptData.ProductId),
					GrantedAt = math.max(0, math.floor(tonumber(receiptData.GrantedAt) or 0)),
					Source = type(receiptData.Source) == "string" and receiptData.Source or nil,
				}
			elseif receiptData == true then
				history[receiptId] = { GrantedAt = 0 }
			end
		end
	end

	return history
end

local function compactRobuxReceiptHistory(raw)
	local history = sanitizeRobuxReceiptHistory(raw)
	local entries = {}

	for receiptId, receiptData in pairs(history) do
		table.insert(entries, {
			ReceiptId = receiptId,
			Data = receiptData,
			GrantedAt = tonumber(receiptData.GrantedAt) or 0,
		})
	end

	table.sort(entries, function(a, b)
		if a.GrantedAt == b.GrantedAt then
			return a.ReceiptId > b.ReceiptId
		end
		return a.GrantedAt > b.GrantedAt
	end)

	local compact = {}
	for index, entry in ipairs(entries) do
		if index > MAX_ROBUX_RECEIPT_HISTORY then
			break
		end
		compact[entry.ReceiptId] = entry.Data
	end

	return compact
end

