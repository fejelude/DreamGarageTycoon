local function redeemPromoCode(player, code, codeInfo)
	if not save then
		return false, "Unable to redeem the code. Please try again."
	end

	code = tostring(code or "")
	if code == "" or type(codeInfo) ~= "table" then
		return false, "Invalid code!"
	end
	if codeInfo.Enabled ~= true then
		return false, "Code is currently unavailable!"
	end
	if codeInfo.RewardType ~= "WalletCash" then
		return false, "Unable to redeem the code. Please try again."
	end

	local amount = math.max(0, math.floor(tonumber(codeInfo.RewardAmount) or 0))
	if amount <= 0 then
		return false, "Unable to redeem the code. Please try again."
	end

	local session = SessionData[player]
	if not session or not session.DataLoaded then
		return false, "Unable to redeem the code. Please try again."
	end

	session.PromoCodeRedemptionInProgress = session.PromoCodeRedemptionInProgress or {}
	if session.PromoCodeRedemptionInProgress[code] then
		return false, "Unable to redeem the code. Please try again."
	end
	session.PromoCodeRedemptionInProgress[code] = true

	local function finish(ok, message)
		session.PromoCodeRedemptionInProgress[code] = nil
		return ok, message
	end

	session.PromoCodesRedeemed = sanitizePromoCodeHistory(session.PromoCodesRedeemed)
	if codeInfo.OncePerPlayer ~= false and session.PromoCodesRedeemed[code] then
		return finish(false, "Code already claimed!")
	end

	local wallet = getWalletValue(player)
	if not wallet then
		return finish(false, "Unable to redeem the code. Please try again.")
	end

	wallet.Value += amount
	session.PromoCodesRedeemed[code] = { RedeemedAt = os.time(), RewardType = codeInfo.RewardType, RewardAmount = amount }
	player:SetAttribute(PROMO_CODE_REDEEMED_ATTRIBUTE, HttpService:JSONEncode(session.PromoCodesRedeemed))
	markDirty(player)

	-- Persist the wallet delta and redemption marker in the same lease-protected
	-- profile update. Reading the old stored wallet here used to resurrect cash
	-- the player had already spent since the previous autosave.
	if not save(player, false, true) then
		-- The reward and marker remain live. An uncertain write is not a reason
		-- to overwrite earnings or spending that happened while saving yielded.
		queueCriticalSave(player, 2)
		return finish(true, "Code redeemed. Your reward is saving.")
	end

	return finish(true, codeInfo.SuccessMessage or "Code successfully redeemed!")
end

local function grantWalletCashProduct(player, purchaseId, productId, walletCash)
	if not save then
		return false, "Save system unavailable"
	end

	purchaseId = tostring(purchaseId or "")
	productId = tonumber(productId)
	walletCash = math.max(0, math.floor(tonumber(walletCash) or 0))

	if purchaseId == "" then
		return false, "Missing purchase id"
	end
	if not productId or productId <= 0 or walletCash <= 0 then
		return false, "Invalid Cash Pack configuration"
	end

	local session = SessionData[player]
	if not session or not session.DataLoaded then
		return false, "Player data not loaded"
	end

	session.WalletCashProductGrantInProgress = session.WalletCashProductGrantInProgress or {}
	if session.WalletCashProductGrantInProgress[purchaseId] then
		return false, "Cash Pack grant already running"
	end
	session.WalletCashProductGrantInProgress[purchaseId] = true

	local function finish(ok, message)
		session.WalletCashProductGrantInProgress[purchaseId] = nil
		return ok, message
	end

	session.RobuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
	if not session.RobuxProductReceipts[purchaseId] then
		local wallet = getWalletValue(player)
		if not wallet then
			return finish(false, "Wallet not loaded")
		end

		wallet.Value += walletCash
		session.RobuxProductReceipts[purchaseId] = {
			ProductId = productId,
			GrantedAt = os.time(),
			Source = "CashPack",
		}
		markDirty(player)
	end

	local saveOk = save(player, false, true)
	if not saveOk then
		return finish(false, "Cash Pack save failed")
	end

	return finish(true)
end

local function grantFhiaTokensProduct(player, purchaseId, productId, tokenAmount)
	purchaseId = tostring(purchaseId or "")
	productId = math.floor(tonumber(productId) or 0)
	tokenAmount = math.floor(tonumber(tokenAmount) or 0)
	local session = SessionData[player]
	if purchaseId == "" or tokenAmount <= 0 or not session or not session.DataLoaded then
		return false, "Player data not loaded"
	end
	session.FhiaTokenGrantLocks = session.FhiaTokenGrantLocks or {}
	if session.FhiaTokenGrantLocks[purchaseId] then return false, "Token grant already running" end
	session.FhiaTokenGrantLocks[purchaseId] = true
	local function finish(ok, message)
		session.FhiaTokenGrantLocks[purchaseId] = nil
		return ok, message
	end
	session.RobuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
	if not session.RobuxProductReceipts[purchaseId] then
		session.FhiaTokens = math.max(0, math.floor(tonumber(session.FhiaTokens) or 0)) + tokenAmount
		session.RobuxProductReceipts[purchaseId] = { ProductId = productId, GrantedAt = os.time(), Source = "FhiaTokens" }
		player:SetAttribute("FhiaTokens", session.FhiaTokens)
		markDirty(player)
	end
	if not save(player, false, true) then return finish(false, "Token grant save failed") end
	return finish(true)
end

-- Atomically applies one Playtime Rewards grant to the live profile and forces
-- it durable before the session service is allowed to mark the slot claimed.
-- The service supplies a server-generated transaction; no client reward data
-- reaches this API. Cars bypass purchasable slots like Lucky Spin prizes, while
-- the absolute MAX_INVENTORY_SIZE corruption guard remains enforced.
local function commitPlaytimeReward(player, transaction)
	local session = SessionData[player]
	if not save or not session or not session.DataLoaded or type(transaction) ~= "table" then
		return false, "Player data not loaded"
	end
	if session.PlaytimeRewardCommitLock then return false, "Reward grant already running" end
	local rewardIndex = math.floor(tonumber(transaction.RewardIndex) or 0)
	local rewardType = transaction.Type
	local amount = math.floor(tonumber(transaction.Amount) or 0)
	local allowedWallet = ({ [1] = 100, [3] = 250, [5] = 500, [7] = 750, [9] = 1000, [11] = 1500 })[rewardIndex]
	local allowedTokens = ({ [4] = 1, [8] = 2, [12] = 3 })[rewardIndex]
	local carReward = rewardIndex == 2 or rewardIndex == 6 or rewardIndex == 10
	local wallet = getWalletValue(player)
	local carId = type(transaction.CarId) == "string" and CarStats.GetCarId(transaction.CarId) or nil
	if rewardType == "Wallet" and (allowedWallet ~= amount or not wallet) then return false, "Invalid wallet reward" end
	if rewardType == "FhiaTokens" and allowedTokens ~= amount then return false, "Invalid token reward" end
	if rewardType == "CarPool" and (not carReward or not carId) then return false, "Invalid car reward" end
	if rewardType ~= "Wallet" and rewardType ~= "FhiaTokens" and rewardType ~= "CarPool" then return false, "Invalid reward" end
	if carReward and getCurrentInventoryCount(player) >= MAX_INVENTORY_SIZE then return false, "Inventory safety limit reached" end

	session.PlaytimeRewardCommitLock = true
	local originalWallet = wallet and wallet.Value
	local originalTokens = math.max(0, math.floor(tonumber(session.FhiaTokens) or 0))
	local transactionId = HttpService:GenerateGUID(false)
	local grantOk, grantMessage = true, nil
	if rewardType == "Wallet" then
		wallet.Value += amount
	elseif rewardType == "FhiaTokens" then
		session.FhiaTokens = originalTokens + amount
		player:SetAttribute("FhiaTokens", session.FhiaTokens)
	else
		grantOk, grantMessage = giveTool(player, carId, {
			Source = "PlaytimeRewards", BypassStorageLimit = true,
			PlaytimeRewardTransactionId = transactionId,
			PlaytimeRewardIndex = rewardIndex,
		})
	end
	if not grantOk then session.PlaytimeRewardCommitLock = nil; return false, grantMessage or "Reward grant failed" end
	markDirty(player)
	if save(player, false, true) then
		session.PlaytimeRewardCommitLock = nil
		return true, nil, rewardType == "FhiaTokens" and session.FhiaTokens or nil
	end
	if rewardType == "Wallet" then wallet.Value = originalWallet
	elseif rewardType == "FhiaTokens" then session.FhiaTokens = originalTokens; player:SetAttribute("FhiaTokens", originalTokens)
	else removeToolsByAttribute(player, "PlaytimeRewardTransactionId", transactionId) end
	markDirty(player)
	session.PlaytimeRewardCommitLock = nil
	return false, "Reward save failed"
end

local function commitLuckySpin(player, result)
	local session = SessionData[player]
	if not session or not session.DataLoaded or session.Closing or type(result) ~= "table" then return false, "Player data not loaded" end
	if session.LuckySpinCommitLock then return false, "Spin already running" end
	local spinId = type(result.SpinId) == "string" and result.SpinId or ""
	if spinId == "" then return false, "Invalid spin" end
	session.LuckySpinHistory = sanitizeLuckySpinHistory(session.LuckySpinHistory)
	if session.LuckySpinHistory[spinId] then
		if save(player, false, true) then return true, nil, session.FhiaTokens end
		return false, "Spin save pending"
	end
	local tokens = math.max(0, math.floor(tonumber(session.FhiaTokens) or 0))
	if tokens < 1 then return false, "No tokens" end

	local wallet = getWalletValue(player)
	local rewardType = result.RewardType
	local walletAmount = math.floor(tonumber(result.Amount) or 0)
	local carId = type(result.CarId) == "string" and CarStats.GetCarId(result.CarId) or nil
	if rewardType == "Wallet" and (not wallet or (walletAmount ~= 500 and walletAmount ~= 5000)) then return false, "Invalid wallet reward" end
	if rewardType == "Car" and not carId then return false, "Invalid car reward" end
	if rewardType ~= "Wallet" and rewardType ~= "Car" then return false, "Invalid reward" end
	if result.InboxRecorded ~= true then return false, "Inbox delivery not recorded" end

	session.LuckySpinCommitLock = true
	local originalTokens = tokens
	session.FhiaTokens = tokens - 1
	player:SetAttribute("FhiaTokens", session.FhiaTokens)

	session.LuckySpinHistory[spinId] = { RewardId = tostring(result.RewardId or ""), GrantedAt = os.time() }
	session.LuckySpinHistory = sanitizeLuckySpinHistory(session.LuckySpinHistory)
	markDirty(player)
	if save(player, false, true) then
		session.LuckySpinCommitLock = nil
		return true, nil, session.FhiaTokens
	end

	-- The write result is uncertain. Keep the spend and its delivery identity
	-- together in memory and retry the complete snapshot.
	session.LuckySpinCommitLock = nil
	queueCriticalSave(player, 2)
	return false, "Your spin is saving. Check your Inbox before spinning again."
end

local function commitInboxClaim(player, entry)
	local session = SessionData[player]
	if not session or not session.DataLoaded or session.Closing or type(entry) ~= "table" then return false, "Player data is not ready" end
	local id = entry.Id
	if type(id) ~= "string" or #id == 0 or #id > 256 then return false, "Invalid Inbox entry" end
	session.InboxClaimLocks = session.InboxClaimLocks or {}
	if session.InboxClaimLocks[id] then return false, "Claim already in progress" end
	session.InboxClaimLocks[id] = true
	local function finish(ok, message) session.InboxClaimLocks[id] = nil; return ok, message end
	local receiptId = "Inbox:" .. id
	session.RobuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
	local carId = entry.RewardType == "Car" and type(entry.RewardId) == "string" and CarStats.GetCarId(entry.RewardId) or nil
	if not session.RobuxProductReceipts[receiptId] then
		if entry.Source == "Lucky Spin" then
			local spinId = id:match("^LuckySpin:(.+)$")
			if not spinId or not session.LuckySpinHistory[spinId] then return finish(false, "Spin commitment is not ready") end
		end
		local amount = tonumber(entry.Amount) or 0
		if amount ~= amount or amount == math.huge or amount < 0 then return finish(false, "Invalid reward amount") end
		amount = math.floor(amount)
		if entry.RewardType == "Wallet" then
			local wallet = getWalletValue(player)
			if not wallet or amount <= 0 then return finish(false, "Invalid Wallet reward") end
			wallet.Value += amount
		elseif entry.RewardType == "FhiaTokens" then
			if amount <= 0 then return finish(false, "Invalid token reward") end
			session.FhiaTokens = (session.FhiaTokens or 0) + amount
			player:SetAttribute("FhiaTokens", session.FhiaTokens)
		elseif carId then
			local granted, message = giveTool(player, carId, {Source=entry.Source or "Inbox", InboxEntryId=id,
				IssuedId=entry.IssuedId, IsRobuxExclusive=entry.IsRobuxExclusive == true})
			if not granted then return finish(false, message) end
		else return finish(false, "Unsupported reward") end
		session.RobuxProductReceipts[receiptId] = {ProductId=0, GrantedAt=os.time(), Source="Inbox", Action=entry.RewardType}
		markDirty(player)
	end
	if carId then
		local rank = ServerStorage:FindFirstChild("RankProgressAPI")
		local ok, recorded = pcall(function()
			return rank and rank:Invoke("InboxCarGranted", player, id, carId,
				(id:match("^LegendaryCraft:") or id:match("^MythicalCraft:")) and "Craft" or "Obtain", entry.SenderUserId)
		end)
		if not ok or recorded ~= true then queueCriticalSave(player, 2); return finish(false, "Reward progression is pending") end
	end
	-- Preserve the delta and its identity on ambiguous save errors.
	if not save(player, false, true) then queueCriticalSave(player, 2); return finish(false, "Reward save pending; please retry") end
	return finish(true, "Claimed")
end

local function hasReceiptGrant(player, purchaseId)
	purchaseId = tostring(purchaseId or "")
	local session = SessionData[player]
	if purchaseId == "" or not session or not session.DataLoaded then
		return nil, "Player data not loaded"
	end

	session.RobuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
	local receiptData = session.RobuxProductReceipts[purchaseId]
	if not receiptData then return false end
	if save(player, false, true) then return true, nil, receiptData end
	return nil, "Receipt grant is not durable yet"
end

local function commitReceiptGrant(player, purchaseId, productId, action, targetUserId, grantHash)
	purchaseId = tostring(purchaseId or "")
	productId = math.floor(tonumber(productId) or 0)
	if purchaseId == "" or productId <= 0 then return false, "Invalid receipt" end

	local session = SessionData[player]
	if not session or not session.DataLoaded then return false, "Player data not loaded" end
	session.RobuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
	local existing = session.RobuxProductReceipts[purchaseId]
	if type(existing) ~= "table" then
		session.RobuxProductReceipts[purchaseId] = {
			ProductId = productId,
			GrantedAt = os.time(),
			Source = "ReceiptRouter",
			Action = type(action) == "string" and string.sub(action, 1, 80) or nil,
			TargetUserId = math.max(0, math.floor(tonumber(targetUserId) or player.UserId)),
			GrantHash = type(grantHash) == "string" and string.sub(grantHash, 1, 200) or nil,
		}
	else
		existing.ProductId = existing.ProductId or productId
		existing.GrantedAt = math.max(tonumber(existing.GrantedAt) or 0, os.time())
	end

	markDirty(player)
	-- Keep the in-memory receipt on failure. The associated mutation is still
	-- live, so Roblox can retry and force-save both together without duplicating.
	if not save(player, false, true) then return false, "Receipt save failed" end
	return true
end

-- 🔄 ADMIN API (BindableFunction)
-- ----------------------------------------------------------------------------
local AdminAPI = getRequiredChild(ServerStorage, "TycoonAdminAPI", "BindableFunction", "ServerStorage > TycoonAdminAPI", REQUIRED_WAIT_SECONDS)

AdminAPI.OnInvoke = function(action, player, ...)
	local liveSession = player and SessionData[player]
	local readOrSave = action == "SaveNow" or action == "QueueSaveSoon" or action == "MarkDirty"
		or action == "HasReceiptGrant" or action == "HasStarterPackGrant" or action == "ForgetInboxClaim"
	if not readOrSave and (not liveSession or not liveSession.DataLoaded or liveSession.Closing
		or liveSession.LeaseLost or player:GetAttribute("TycoonDataClosing") == true) then
		return false, "Player data is not ready"
	end
	if action == "ForceWipe" and player and SessionData[player] then
		SessionData[player].ExplicitClear = true
		SessionData[player].StarterPackPurchased = false
		SessionData[player].StarterPackPurchaseId = nil
		SessionData[player].StarterPackReceipts = {}
		SessionData[player].StarterPackSaveConfirmed = false
		SessionData[player].StarterPackClearRequested = true
		SessionData[player].Tutorial = sanitizeTutorialData(nil)
		SessionData[player].IntentionalEmptyInventory = false
		applyTutorialAttributes(player, SessionData[player].Tutorial)
		player:SetAttribute("IndexDiscoveredJson", "[]")
		player:SetAttribute("IndexExclusiveDiscoveredJson", "[]")
		if player:FindFirstChild("StarterGear") then player.StarterGear:ClearAllChildren() end
		if player:FindFirstChild("Backpack") then player.Backpack:ClearAllChildren() end
		markDirty(player)
		print("⚠️ FORCE WIPE INITIATED FOR: " .. player.Name)
		return true

	elseif action == "UpdateTutorial" and player then
		local expectedStage, nextStage, fields = ...
		local session = SessionData[player]
		if not session or not session.DataLoaded or type(expectedStage) ~= "string" or not VALID_TUTORIAL_STAGES[nextStage] then
			return false, "Invalid tutorial update"
		end
		session.Tutorial = sanitizeTutorialData(session.Tutorial)
		if session.Tutorial.Stage ~= expectedStage then return false, "Tutorial stage changed" end
		fields = type(fields) == "table" and fields or {}
		for _, field in ipairs({ "Answered", "Skipped", "Active", "Completed", "InventoryOpened", "TransferComplete", "CarPlaced", "EarningsClaimed", "ATMWithdrawn", "LocalCarPurchased" }) do
			if type(fields[field]) == "boolean" then session.Tutorial[field] = fields[field] end
		end
		session.Tutorial.Stage = nextStage
		session.Tutorial.Revision += 1
		if nextStage == "Completed" then session.Tutorial.Completed = true; session.Tutorial.Active = false; session.Tutorial.Answered = true end
		if nextStage == "Skipped" then session.Tutorial.Skipped = true; session.Tutorial.Active = false; session.Tutorial.Answered = true end
		applyTutorialAttributes(player, session.Tutorial)
		markDirty(player)
		queueCriticalSave(player, 1)
		return true

	elseif action == "RestartTutorial" and player then
		local session = SessionData[player]
		if not session or not session.DataLoaded then
			return false, "Tutorial data is not loaded"
		end
		local previous = sanitizeTutorialData(session.Tutorial)
		local restarted = sanitizeTutorialData(nil)
		-- A manual restart is already an explicit opt-in, so begin at Part1 rather
		-- than presenting the NewComer opt-in a second time.
		restarted.Answered = true
		restarted.Active = true
		restarted.Stage = "Part1"
		restarted.Revision = previous.Revision + 1
		session.Tutorial = restarted
		applyTutorialAttributes(player, restarted)
		markDirty(player)
		queueCriticalSave(player, 1)
		return true

	elseif action == "GiveTool" and player then
		local toolName, customAttributes = ...
		return giveTool(player, toolName, customAttributes)

	elseif action == "TransferTool" and player then
		local receiver, tool = ...
		return transferToolBetweenPlayers(player, receiver, tool)

	elseif action == "ClaimFreeReward" and player then
		local carName, walletCash = ...
		return claimFreeReward(player, carName, walletCash)

	elseif action == "RedeemPromoCode" and player then
		local code, codeInfo = ...
		return redeemPromoCode(player, code, codeInfo)

	elseif action == "GrantWalletCashProduct" and player then
		local purchaseId, productId, walletCash = ...
		return grantWalletCashProduct(player, purchaseId, productId, walletCash)
	elseif action == "GrantFhiaTokensProduct" and player then
		local purchaseId, productId, tokenAmount = ...
		return grantFhiaTokensProduct(player, purchaseId, productId, tokenAmount)
	elseif action == "CommitLuckySpin" and player then
		return commitLuckySpin(player, ...)
	elseif action == "CommitPlaytimeReward" and player then
		return commitPlaytimeReward(player, ...)
	elseif action == "ForgetInboxClaim" and player then
		local id = ...
		local session = SessionData[player]
		if not session or not session.DataLoaded or type(id) ~= "string" then return false end
		session.RobuxProductReceipts["Inbox:" .. id] = nil
		local spinId = id:match("^LuckySpin:(.+)$")
		if spinId and session.LuckySpinHistory[spinId] then session.LuckySpinHistory[spinId].Claimed = true end
		local rank = ServerStorage:FindFirstChild("RankProgressAPI")
		if rank then pcall(function() rank:Invoke("ForgetInboxCarGrant", player, id) end) end
		markDirty(player)
		queueCriticalSave(player, 2)
		return true
	elseif action == "CommitInboxClaim" and player then
		return commitInboxClaim(player, ...)

	elseif action == "HasReceiptGrant" and player then
		local purchaseId = ...
		return hasReceiptGrant(player, purchaseId)

	elseif action == "CommitReceiptGrant" and player then
		local purchaseId, productId, receiptAction, targetUserId, grantHash = ...
		return commitReceiptGrant(player, purchaseId, productId, receiptAction, targetUserId, grantHash)

	elseif action == "GrantStarterPack" and player then
		if not save then
			return false, "Save system unavailable"
		end

		local purchaseId, carName, walletCash = ...
		purchaseId = tostring(purchaseId or "")
		carName = tostring(carName or STARTER_PACK_CAR_NAME)
		walletCash = math.max(0, math.floor(tonumber(walletCash) or STARTER_PACK_WALLET_CASH))

		if purchaseId == "" then
			return false, "Missing purchase id"
		end

		local session = SessionData[player]
		if not session or not session.DataLoaded then
			return false, "Player data not loaded"
		end

		if session.StarterPackGrantInProgress then
			return false, "Starter Pack grant already running"
		end

		session.StarterPackGrantInProgress = true

		local function finish(ok, message)
			session.StarterPackGrantInProgress = false
			return ok, message
		end

		session.StarterPackReceipts = session.StarterPackReceipts or {}

		-- This flag prevents CheckOwned from returning true until the main data
		-- save succeeds. If Roblox retries the same receipt, this function will
		-- force-save again without granting duplicate cash/tools.
		session.StarterPackSaveConfirmed = false

		if session.StarterPackPurchased == true then
			session.StarterPackReceipts[purchaseId] = true
			session.StarterPackPurchaseId = session.StarterPackPurchaseId or purchaseId
			markDirty(player)
		else
			session.StarterPackPurchased = true
			session.StarterPackPurchaseId = purchaseId
			session.StarterPackReceipts[purchaseId] = true
			markDirty(player)
		end

		local saveOk = save(player, false, true)
		if not saveOk then
			return finish(false, "Starter Pack save failed")
		end

		session.StarterPackSaveConfirmed = true
		return finish(true)

	elseif action == "HasStarterPackGrant" and player then
		local session = SessionData[player]
		if not session or not session.DataLoaded then
			return nil, "Player data not loaded"
		end

		if session.StarterPackPurchased ~= true then
			return false
		end

		-- Do not let the client show success until the purchase flag has been
		-- confirmed by a successful main data save.
		if session.StarterPackGrantInProgress or session.StarterPackSaveConfirmed ~= true then
			return nil, "Starter Pack grant is still saving"
		end

		return true

	elseif action == "ClearStarterPackGrant" and player then
		-- Testing/admin reset only. This clears the one-time Starter Pack flag from
		-- the same main player data record used by GrantStarterPack.
		if not save then
			return false, "Save system unavailable"
		end

		local session = SessionData[player]
		if not session or not session.DataLoaded then
			return false, "Player data not loaded"
		end

		session.StarterPackPurchased = false
		session.StarterPackPurchaseId = nil
		session.StarterPackReceipts = {}
		session.StarterPackSaveConfirmed = false
		session.StarterPackClearRequested = true
		markDirty(player)

		local saveOk = save(player, false, true)
		if not saveOk then
			return false, "Starter Pack clear save failed"
		end

		return true

	elseif action == "AddInventorySlots" and player then
		local amount, purchaseId, productId = ...
		amount = math.floor(tonumber(amount) or 0)
		purchaseId = tostring(purchaseId or "")
		local session = SessionData[player]
		if not session or not session.DataLoaded then return false, "Player data not loaded" end
		if amount < 1 or amount > 6 or purchaseId == "" then return false, "Invalid slot grant" end
		session.RobuxProductReceipts = type(session.RobuxProductReceipts) == "table" and session.RobuxProductReceipts or {}
		local existing = session.RobuxProductReceipts[purchaseId]
		if existing then
			if not save or save(player, false, true) ~= true then return false, "Slot save retry failed" end
			return true, "Already granted"
		end
		local newBonus = math.max(0, math.floor(tonumber(session.InventorySlotBonus) or tonumber(player:GetAttribute("InventorySlotBonus")) or 0)) + amount
		session.InventorySlotBonus = newBonus
		session.RobuxProductReceipts[purchaseId] = { ProductId = tonumber(productId), Action = "InventorySlots", GrantedAt = os.time() }
		player:SetAttribute("InventorySlotBonus", newBonus)
		local rankName = player:GetAttribute("Rank") or "Player"
		local rankBenefits = RankConfig.GetBenefitsForRank(rankName)
		player:SetAttribute("RankStorageLimit", rankBenefits.StorageSlots + newBonus)
		markDirty(player)
		if not save or save(player, false, true) ~= true then return false, "Slot save failed" end
		return true, newBonus

	elseif action == "RemoveTool" and player then
		local targetToolId, requestedAmount = ...
		if not targetToolId then return false end

		local removedCount = removeMatchingTools(player, targetToolId, requestedAmount)
		if removedCount < math.max(1, tonumber(requestedAmount) or 1) then
			return false, removedCount
		end

			local session = SessionData[player]
			if session then
				session.SacrificeOccurred = true
				session.IntentionalEmptyInventory = true
		end

		markDirty(player)
		return true, removedCount

	elseif action == "RemoveExactTool" and player then
		local tool = ...
		return removeExactOwnedTool(player, tool)

	elseif action == "MarkDirty" and player then
		markDirty(player)
		return true

	elseif action == "SaveNow" and player then
		markDirty(player)
		if not save then
			return false, "Save system unavailable"
		end
		return save(player, false, true)

	elseif action == "QueueSaveSoon" and player then
		local delaySeconds = ...
		return queueCriticalSave(player, delaySeconds)

	elseif action == "MarkInventoryCleared" and player then
			local session = SessionData[player]
			if session then
				session.SacrificeOccurred = true
				session.IntentionalEmptyInventory = true
		end
		markDirty(player)
		return true
	end

	return false
end

