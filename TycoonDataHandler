-- 🗡️ MYTHICAL CRAFTING INVENTORY API (BindableFunction)
-- ----------------------------------------------------------------------------
local MythicalCraftingInventoryAPI = ServerStorage:FindFirstChild("MythicalCraftingInventoryFunction")
if not MythicalCraftingInventoryAPI then
