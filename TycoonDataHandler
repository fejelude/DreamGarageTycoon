-- ============================================================================
-- 💾  SAVING
-- ============================================================================
local function save(player, isClosing)
	local session = SessionData[player]
	if not session or not session.DataLoaded then return end

	-- ── Wait for an in-progress save to finish ──────────────────────────────
	if session.IsSaving then
		if isClosing then
			local deadline = os.clock() + 4
			while session.IsSaving and os.clock() < deadline do
				task.wait(0.1)
			end
			if session.IsSaving then
				warn("⚠️ Save lock timed out for " .. player.Name .. ". Forcing release.")
				session.IsSaving = false
			end
		else
			return
		end
	end

	if not isClosing and (os.time() - session.LastSave < MIN_SAVE_INTERVAL) then return end
	if not isClosing and not session.IsDirty then return end

	session.IsSaving = true

	-- ── Pre-snapshot all live data synchronously ─────────────────────────────
	-- Everything that reads from the player is captured HERE, before any
	-- yielding, so the values are consistent and the UpdateAsync callback
	-- remains a pure data-transform with no side-effects.

	local snapBank       = MoneyManager.GetBalance(player, "Cash")
	local snapWallet     = MoneyManager.GetBalance(player, "Wallet")
	local snapATM        = MoneyManager.GetBalance(player, "ATMBalance")
	local snapPadLevel   = player:GetAttribute("HighestUnlockedPad") or 1
	local snapSkins      = HttpService:JSONDecode(player:GetAttribute("OwnedBaseSkins") or "[]")
	local snapEquipped   = player:GetAttribute("EquippedSkin") or "Default"
	local snapRank       = player:GetAttribute("Rank") or "Player"
	local snapPlotName   = player:GetAttribute("OccupiedPlot")
	local snapPending    = 0

	-- ── Inventory snapshot ───────────────────────────────────────────────────
	-- Scan Backpack first, then Character (equipped slot).
	--
	-- FIX (Held Tool Lost on Disconnect): player.Character may already be nil
	-- by the time PlayerRemoving fires. We capture it into a local reference
	-- RIGHT NOW (synchronously) before any task.wait(). If it is already nil
	-- here, we fall back to session.HeldToolId which was cached by the
	-- CharacterRemoving listener set up in InitializePlayer.

	local characterRef   = player.Character  -- snapshot reference; may be nil
	local heldToolFallback = (not characterRef) and session.HeldToolId or nil

	local inventory     = {}
	local invCount      = 0
	local seenInstances = {}

	local function scanContainer(container)
		if not container then return end
		for _, tool in ipairs(container:GetChildren()) do
			if validateTool(tool) and not seenInstances[tool] then
				seenInstances[tool] = true
				if invCount < MAX_INVENTORY_SIZE then
					local id = tool:GetAttribute("ToolId")
					if id then
						table.insert(inventory, id)
						invCount += 1
					end
				end
			end
		end
	end

	-- Backpack = primary storage (N copies per N owned tools).
	scanContainer(player:FindFirstChild("Backpack"))
	-- StarterGear intentionally excluded — within-session respawn mirror only.
	-- Character = equipped slot (tool moves from Backpack → Character on equip).
	scanContainer(characterRef)

	-- If the character was already gone, include the cached held tool.
	if heldToolFallback and safeFindCarTool(heldToolFallback) then
		local alreadySaved = false
		for _, savedId in ipairs(inventory) do
			if savedId == heldToolFallback then
				alreadySaved = true
				break
			end
		end
		if not alreadySaved and invCount < MAX_INVENTORY_SIZE then
			table.insert(inventory, heldToolFallback)
			invCount += 1
		end
	end

	-- ── Layout snapshot ──────────────────────────────────────────────────────
	local layout = {}
	if snapPlotName and TycoonFolder:FindFirstChild(snapPlotName) then
		local plot = TycoonFolder[snapPlotName]

		local pendingVal = plot:FindFirstChild("PendingEarnings")
		if pendingVal then snapPending = pendingVal.Value end

		local pads = plot:FindFirstChild("Pads")
		if pads then
			for _, padObject in ipairs(pads:GetChildren()) do
				local padPart = getMainPart(padObject)
				if padPart then
					local linked = padPart:FindFirstChild("LinkedCar")
					if linked and linked.Value then
						local car = linked.Value
						if car.Parent and car:IsDescendantOf(plot)
							and car:GetAttribute("OwnerUserId") == player.UserId
						then
							local tName = FindToolNameFromModel(car.Name)
							if tName then
								table.insert(layout, { Tool = tName, Pad = padObject.Name })
							end
						end
					end
				end
			end
		end
	end

	-- ── Shop state snapshot ──────────────────────────────────────────────────
	local function invokeShop(bindableName, playerRef)
		local b = ServerStorage:FindFirstChild(bindableName)
		if not b then return {} end
		local ok2, result = pcall(function() return b:Invoke("Get", playerRef) end)
		if not ok2 then
			warn("⚠️ Shop invoke error (" .. bindableName .. "): " .. tostring(result))
			return {}
		end
		return result or {}
	end

	local snapShopCommon    = invokeShop("ShopPersistenceFunction",          player)
	local snapShopUncommon  = invokeShop("UncommonShopPersistenceFunction",  player)
	local snapShopRare      = invokeShop("RareShopPersistenceFunction",      player)
	local snapShopEpic      = invokeShop("EpicShopPersistenceFunction",      player)
	local snapShopLegendary = invokeShop("LegendaryShopPersistenceFunction", player)
	local snapShopMythical  = invokeShop("MythicalShopPersistenceFunction",  player)

	-- ── Capture session flags for use inside the async callback ──────────────
	local sacrificeOccurred = session.SacrificeOccurred == true
	local explicitClear     = session.ExplicitClear     == true
	local restoredPending   = player:GetAttribute("RestoredPending") or 0

	-- ── Attempt the DataStore write ──────────────────────────────────────────
	local saveSucceeded = false

	local function executeSave()
		print("💾 Saving data for " .. player.Name .. "…")

		for attempt = 1, MAX_RETRIES do
			local updateOk, updateResult = pcall(function()
				return PlayerDataStore:UpdateAsync(
					"User_V27_" .. player.UserId,
					function(oldData)
						oldData = oldData or {}

						-- ── INVENTORY ANTI-WIPE ───────────────────────────
						-- If the new inventory is empty but the stored one was
						-- not, assume something went wrong — UNLESS a
						-- sacrifice or explicit wipe occurred this session.
						local finalInventory = inventory

						if #inventory == 0
							and (oldData.Inventory and #oldData.Inventory > 0)
							and not explicitClear
							and not sacrificeOccurred
						then
							warn("⚠️ Anti-Wipe (Inventory): Preserving for " .. player.Name)
							finalInventory = {}
							for _, oldId in ipairs(oldData.Inventory) do
								if safeFindCarTool(oldId) then
									table.insert(finalInventory, oldId)
								end
							end
						end

						-- ── LAYOUT ANTI-WIPE ──────────────────────────────
						local finalLayout           = layout
						local suspiciousLayoutWipe  = (#layout == 0)
							and (oldData.Layout and #oldData.Layout > 0)

						if suspiciousLayoutWipe and not explicitClear then
							local oldInvCount = oldData.Inventory and #oldData.Inventory or 0
							local newInvCount = #finalInventory

							if newInvCount > oldInvCount then
								-- Player picked up a car from a pad; the
								-- inventory growing confirms a legitimate wipe.
								print("✅ Valid pickup detected. Saving empty layout.")
								finalLayout = layout
							else
								warn("⚠️ Anti-Wipe (Layout): Preserving for " .. player.Name)
								finalLayout = {}
								local seenPads = {}
								for _, oldEntry in ipairs(oldData.Layout) do
									if FindModelNameFromTool(oldEntry.Tool)
										and not seenPads[oldEntry.Pad]
									then
										seenPads[oldEntry.Pad] = true
										table.insert(finalLayout, oldEntry)
									end
								end
							end
						end

						-- ── COMMIT ────────────────────────────────────────
						oldData.Bank       = snapBank
						oldData.Wallet     = snapWallet
						oldData.ATMBalance = snapATM

						oldData.Inventory       = finalInventory
						oldData.Layout          = finalLayout
						oldData.PendingEarnings = restoredPending + snapPending

						oldData.ShopPurchases         = snapShopCommon
						oldData.UncommonShopPurchases  = snapShopUncommon
						oldData.RareShopPurchases      = snapShopRare
						oldData.EpicShopPurchases      = snapShopEpic
						oldData.LegendaryShopPurchases = snapShopLegendary
						oldData.MythicalShopPurchases  = snapShopMythical

						oldData.OwnedBaseSkins     = snapSkins
						oldData.EquippedSkin       = snapEquipped
						oldData.HighestUnlockedPad = snapPadLevel
						oldData.Rank               = snapRank

						oldData.LastUpdated = os.time()
						oldData.DataVersion = "V39_Perfect"

						return oldData
					end
				)
			end)

			if updateOk and updateResult ~= nil then
				saveSucceeded = true
				return
			end

			task.wait(0.35 * attempt)
		end

		error("UpdateAsync failed after " .. MAX_RETRIES .. " retries")
	end

	local ok, saveErr = pcall(executeSave)
	if not ok then
		warn("❌ Save failed for " .. player.Name .. ": " .. tostring(saveErr))
	elseif isClosing then
		print("✅ Saved: " .. player.Name)
	end

	-- Only advance the save clock when the write actually succeeded.
	-- If every retry failed, IsDirty remains true so the next autosave
	-- cycle will try again rather than silently losing the changes.
	if saveSucceeded then
		session.IsDirty  = false
		session.LastSave = os.time()
	end

	-- ── Shop cleanup (closing only) ──────────────────────────────────────────
	-- Each call is individually pcall-protected so one failing shop cannot
	-- prevent the others from closing or block the IsSaving lock release.
	if isClosing then
		local function safeClose(bindableName)
			local b = ServerStorage:FindFirstChild(bindableName)
			if not b then return end
			local ok2, err2 = pcall(function() b:Invoke("Close", player) end)
			if not ok2 then
				warn("⚠️ Shop cleanup error (" .. bindableName .. "): " .. tostring(err2))
			end
		end

		safeClose("ShopPersistenceFunction")
		safeClose("UncommonShopPersistenceFunction")
		safeClose("RareShopPersistenceFunction")
		safeClose("EpicShopPersistenceFunction")
		safeClose("LegendaryShopPersistenceFunction")
		safeClose("MythicalShopPersistenceFunction")
	end

	-- Always release the lock, even on failure or error.
	session.IsSaving = false

	local syncEvent = ServerStorage:FindFirstChild("TycoonSaveCompleted")
	if syncEvent then syncEvent:Fire(player.Name) end

	player:SetAttribute("DataSaved", true)
end

-- ============================================================================
-- 🚪  PLAYER INITIALIZATION
-- ============================================================================
local function InitializePlayer(player)
	SessionData[player] = {
		LastSave          = os.time(),
		IsDirty           = false,
		DataLoaded        = false,
		ExplicitClear     = false,
		IsSaving          = false,
		SacrificeOccurred = false,
		-- HeldToolId: caches the ToolId of any tool the player was holding
		-- when their character was removed (CharacterRemoving). Used as a
		-- fallback in save() when player.Character is already nil.
		HeldToolId        = nil,
	}

	local session = SessionData[player]

	-- ── Leaderstats & HiddenStats ────────────────────────────────────────────
	local ls = Instance.new("Folder"); ls.Name = "leaderstats"; ls.Parent = player
	local hs = Instance.new("Folder"); hs.Name = "HiddenStats"; hs.Parent = player

	local cash   = Instance.new("IntValue"); cash.Name   = "Cash";       cash.Parent   = hs
	local wallet = Instance.new("IntValue"); wallet.Name = "Wallet";     wallet.Parent = ls
	local atm    = Instance.new("IntValue"); atm.Name    = "ATMBalance"; atm.Parent    = ls

	local function setDirty() markDirty(player) end
	cash.Changed:Connect(setDirty)
	wallet.Changed:Connect(setDirty)
	atm.Changed:Connect(setDirty)

	-- ── StarterGear dirty tracking ───────────────────────────────────────────
	local gear = player:WaitForChild("StarterGear", 10)
	if gear then
		gear.ChildAdded:Connect(setDirty)
		gear.ChildRemoved:Connect(setDirty)
	end

	-- ── Held-tool cache (FIX: Held Tool Lost on Disconnect) ──────────────────
	-- CharacterRemoving fires reliably before the instance is destroyed.
	-- We snapshot the equipped tool ID here so save() can use it as a
	-- fallback when player.Character is already nil during PlayerRemoving.
	player.CharacterRemoving:Connect(function(character)
		if not session then return end
		session.HeldToolId = nil -- clear first; re-set only if a tool is found
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") and validateTool(child) then
				local id = child:GetAttribute("ToolId")
				if id then
					session.HeldToolId = id
					break -- a player can only equip one tool at a time
				end
			end
		end
	end)

	-- Clear the held-tool cache when a fresh character spawns so a previous
	-- death's cached value never contaminates a new session snapshot.
	player.CharacterAdded:Connect(function()
		if session then
			session.HeldToolId = nil
		end
	end)

	-- ── Load data ────────────────────────────────────────────────────────────
	local key = "User_V27_" .. player.UserId
	local data
	local loadOk, loadErr = pcall(function()
		data = PlayerDataStore:GetAsync(key)
	end)

	if not loadOk then
		warn("❌ Data load failed for " .. player.Name .. ": " .. tostring(loadErr))
		player:Kick("Data Load Error. Please rejoin.")
		return
	end

	-- ── Default data ─────────────────────────────────────────────────────────
	data = data or {}
	data.Inventory             = data.Inventory             or {}
	data.Layout                = data.Layout                or {}
	data.PendingEarnings       = data.PendingEarnings       or 0
	data.HighestUnlockedPad    = data.HighestUnlockedPad    or 1
	data.ShopPurchases         = data.ShopPurchases         or {}
	data.UncommonShopPurchases = data.UncommonShopPurchases or {}
	data.RareShopPurchases     = data.RareShopPurchases     or {}
	data.EpicShopPurchases     = data.EpicShopPurchases     or {}
	data.LegendaryShopPurchases= data.LegendaryShopPurchases or {}
	data.MythicalShopPurchases = data.MythicalShopPurchases  or {}
	data.OwnedBaseSkins        = data.OwnedBaseSkins        or { "Default" }
	data.EquippedSkin          = data.EquippedSkin          or "Default"
	data.Rank                  = data.Rank                  or "Player"

	-- ── Apply currency ───────────────────────────────────────────────────────
	cash.Value   = data.Bank       or 0
	wallet.Value = data.Wallet     or 0
	atm.Value    = data.ATMBalance or 0

	-- ── Restore shop states ──────────────────────────────────────────────────
	local function invokeShopLoad(bindableName, payload)
		local b = ServerStorage:FindFirstChild(bindableName)
		if not b then return end
		local ok2, err2 = pcall(function() b:Invoke("Load", player, payload) end)
		if not ok2 then
			warn("⚠️ Shop load error (" .. bindableName .. "): " .. tostring(err2))
		end
	end

	invokeShopLoad("ShopPersistenceFunction",          data.ShopPurchases)
	invokeShopLoad("UncommonShopPersistenceFunction",  data.UncommonShopPurchases)
	invokeShopLoad("RareShopPersistenceFunction",      data.RareShopPurchases)
	invokeShopLoad("EpicShopPersistenceFunction",      data.EpicShopPurchases)
	invokeShopLoad("LegendaryShopPersistenceFunction", data.LegendaryShopPurchases)
	invokeShopLoad("MythicalShopPersistenceFunction",  data.MythicalShopPurchases)

	-- ── Apply player attributes ──────────────────────────────────────────────
	player:SetAttribute("HighestUnlockedPad", data.HighestUnlockedPad)
	player:SetAttribute("OwnedBaseSkins",     HttpService:JSONEncode(data.OwnedBaseSkins))
	player:SetAttribute("EquippedSkin",       data.EquippedSkin)
	player:SetAttribute("Rank",               data.Rank)

	player:GetAttributeChangedSignal("HighestUnlockedPad"):Connect(setDirty)
	player:GetAttributeChangedSignal("OwnedBaseSkins"):Connect(setDirty)
	player:GetAttributeChangedSignal("EquippedSkin"):Connect(setDirty)
	player:GetAttributeChangedSignal("Rank"):Connect(setDirty)

	-- ── Rank visuals ─────────────────────────────────────────────────────────
	local function ApplyRankVisual()
		local SetRankAPI = ServerStorage:FindFirstChild("SetRankAPI")
		if SetRankAPI then
			SetRankAPI:Invoke(player, player:GetAttribute("Rank") or "Player")
		else
			warn("⚠️ SetRankAPI missing in ServerStorage")
		end
	end

	if player.Character then task.spawn(ApplyRankVisual) end
	player.CharacterAdded:Connect(ApplyRankVisual)

	-- ── Restore inventory ────────────────────────────────────────────────────
	if player:FindFirstChild("Backpack")    then player.Backpack:ClearAllChildren()    end
	if player:FindFirstChild("StarterGear") then player.StarterGear:ClearAllChildren() end

	for _, toolName in ipairs(data.Inventory) do
		giveTool(player, toolName)
	end

	-- Give the starter car only to brand-new players (no inventory, no layout).
	if #data.Inventory == 0 and #data.Layout == 0 then
		giveTool(player, STARTER_CAR_NAME)
	end

	sanitizeInventory(player)

	-- ── Restore pending earnings ─────────────────────────────────────────────
	if data.PendingEarnings and data.PendingEarnings > 0 then
		player:SetAttribute("RestoredPending", data.PendingEarnings)
	end

	-- ── Restore tycoon layout ────────────────────────────────────────────────
	if #data.Layout > 0 then
		task.spawn(function()
			local plotName = player:GetAttribute("OccupiedPlot")
			if not plotName then
				player:GetAttributeChangedSignal("OccupiedPlot"):Wait()
				plotName = player:GetAttribute("OccupiedPlot")
			end
			if plotName then
				local plot = TycoonFolder:WaitForChild(plotName, 10)
				if plot then
					task.wait(1)
					RestoreLayout(player, plot, data.Layout)
				end
			end
		end)
	end

	-- ── Restore pending earnings to tycoon plot ──────────────────────────────
	local function CheckAndRestorePending()
		local plotName = player:GetAttribute("OccupiedPlot")
		local amount   = player:GetAttribute("RestoredPending")
		if not (plotName and amount and amount > 0) then return end

		player:SetAttribute("RestoredPending", 0)

		local plot       = TycoonFolder:FindFirstChild(plotName)
		local pendingVal = plot and plot:WaitForChild("PendingEarnings", 10)

		if pendingVal then
			pendingVal.Value += amount
			markDirty(player)
			print("✅ Restored pending earnings: $" .. amount .. " → " .. plotName)
		else
			warn("⚠️ Could not find PendingEarnings. Reverting attribute.")
			player:SetAttribute("RestoredPending", amount)
		end
	end

	player:GetAttributeChangedSignal("OccupiedPlot"):Connect(CheckAndRestorePending)
	CheckAndRestorePending()

	session.DataLoaded = true
end

-- ============================================================================
-- 🔌  PLAYER LIFECYCLE
-- ============================================================================
Players.PlayerAdded:Connect(InitializePlayer)

Players.PlayerRemoving:Connect(function(player)
	save(player, true)
	SessionData[player] = nil
end)

-- ============================================================================
-- ⏰  AUTOSAVE LOOP
-- ============================================================================
task.spawn(function()
	while true do
		task.wait(10)
		local now = os.time()
		for _, player in ipairs(Players:GetPlayers()) do
			local session = SessionData[player]
			if session
				and session.DataLoaded
				and session.IsDirty
				and (now - session.LastSave >= AUTOSAVE_INTERVAL)
			then
				task.spawn(function() save(player, false) end)
			end
		end
	end
end)

-- ============================================================================
-- 🛡️  PERIODIC SANITIZE LOOP
-- ============================================================================
task.spawn(function()
	while true do
		task.wait(25)
		for _, player in ipairs(Players:GetPlayers()) do
			sanitizeInventory(player)
		end
	end
end)

-- ============================================================================
-- 🔒  SERVER SHUTDOWN — FLUSH ALL SESSIONS
-- ============================================================================
game:BindToClose(function()
	local threads = 0
	for _, player in ipairs(Players:GetPlayers()) do
		threads += 1
		task.spawn(function()
			save(player, true)
			threads -= 1
		end)
	end
	local deadline = os.clock() + 25
	while threads > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)