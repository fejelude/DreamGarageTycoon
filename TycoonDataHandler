		markDirty(player)
		return true, removedCount

	elseif action == "GiveTool" then
		local toolName, customAttributes = ...
		return giveTool(player, toolName, customAttributes)

	elseif action == "MarkDirty" then
		markDirty(player)
		return true

	elseif action == "SaveNow" then
		markDirty(player)
		if not save then
			return false, "Save system unavailable"
		end
		return save(player, false, true)

	elseif action == "QueueSaveSoon" then
		local delaySeconds = ...
		return queueCriticalSave(player, delaySeconds)
	end

	return false
end

local function getDailyRewardsDayKey(timestamp)
	return math.floor((tonumber(timestamp) or os.time()) / DAILY_REWARDS_SECONDS_PER_DAY)
end

local function defaultDailyRewardsClaimedDays()
	local claimedDays = {}
	for day = 1, 7 do
		claimedDays[tostring(day)] = false
	end
	return claimedDays
end

local function sanitizeDailyRewardsData(value)
	local data = type(value) == "table" and value or {}

	local currentDay = math.floor(tonumber(data.CurrentDay) or 1)
	if currentDay < 1 or currentDay > 7 then
		currentDay = 1
	end

	local lastClaimAt = math.max(0, math.floor(tonumber(data.LastClaimAt) or 0))
	local lastClaimDayKey = math.max(0, math.floor(tonumber(data.LastClaimDayKey) or 0))
	local awaitingCycleReset = data.AwaitingCycleReset == true
	local claimedDays = defaultDailyRewardsClaimedDays()

	if type(data.ClaimedDays) == "table" then
		for day = 1, 7 do
			local key = tostring(day)
			claimedDays[key] = data.ClaimedDays[key] == true or data.ClaimedDays[day] == true
		end
	end

	local todayKey = getDailyRewardsDayKey(os.time())

	-- Protect against corrupted/future timestamps while avoiding an extra same-day claim.
	if lastClaimDayKey > todayKey then
		lastClaimDayKey = todayKey
		lastClaimAt = math.max(lastClaimAt, os.time())
	end

	-- If the player completed Day 7 previously and it is now a new UTC day,
	-- reset the visible cycle before the DailyRewardsService/client reads it.
	if awaitingCycleReset and lastClaimDayKey ~= todayKey then
		currentDay = 1
		awaitingCycleReset = false
		claimedDays = defaultDailyRewardsClaimedDays()
	end

	return {
		CurrentDay = currentDay,
		LastClaimAt = lastClaimAt,
		LastClaimDayKey = lastClaimDayKey,
		AwaitingCycleReset = awaitingCycleReset,
		ClaimedDays = claimedDays,
	}
end

local function decodeDailyRewardsAttribute(player)
	local raw = player:GetAttribute(DAILY_REWARDS_STATE_ATTRIBUTE)
	if type(raw) ~= "string" or raw == "" then
		return sanitizeDailyRewardsData(nil)
	end

	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)

	if ok and type(decoded) == "table" then
		return sanitizeDailyRewardsData(decoded)
	end

	return sanitizeDailyRewardsData(nil)
end


-- ----------------------------------------------------------------------------
-- 💾 SAVING
-- ----------------------------------------------------------------------------
save = function(player, isClosing, force)
	local session = SessionData[player]
	if not session or not session.DataLoaded then return false end

	if session.IsSaving then
		local waitLimit = isClosing and CLOSING_SAVE_LOCK_WAIT_SECONDS or SAVE_LOCK_WAIT_SECONDS
		local startedWaiting = os.clock()
		while session.IsSaving and (os.clock() - startedWaiting < waitLimit) do
			task.wait(0.05)
		end
		if session.IsSaving then
			warn("[Save] Save request could not get lock for " .. player.Name .. "; keeping session dirty for retry.")
			session.IsDirty = true
			return false, "Save already in progress"
		end
	end

	if not force and not isClosing and (os.time() - session.LastSave < MIN_SAVE_INTERVAL) then return true end
	if not force and not session.IsDirty and not isClosing then return true end

	session.IsSaving = true
	local saveDirtyVersion = session.DirtyVersion or 0

	local saveSucceeded = false

	local function safeShopGet(bindable, player)
		if not bindable then return {} end
		local result = {}
		local ok, data = pcall(function() return bindable:Invoke("Get", player) end)
		if ok and type(data) == "table" then result = data end
		return result
	end

	local function executeSave()
		print("💾 Saving data for " .. player.Name .. "...")

		local currentUnlockedPad = player:GetAttribute("HighestUnlockedPad") or 1
		local currentBaseLevel = player:GetAttribute("BaseLevel") or 1
		local currentOwnedRaw = player:GetAttribute("OwnedBaseSkins") or "[]"
		local currentOwnedSkins = decodeJsonOrDefault(currentOwnedRaw, { "Default" }, player.Name .. ".OwnedBaseSkins")
		if type(currentOwnedSkins) ~= "table" then
			currentOwnedSkins = { "Default" }
		end
		local currentEquippedSkin = player:GetAttribute("EquippedSkin") or "Default"
		local currentRank = player:GetAttribute("Rank") or "Player"
		local rankPersistenceBindable = ServerStorage:FindFirstChild("RankPersistenceFunction")
		local currentRankData = {}
		if rankPersistenceBindable then
			local ok, result = pcall(function() return rankPersistenceBindable:Invoke("Get", player) end)
			if ok and type(result) == "table" then currentRankData = result end
		end

		-- 🎮 HOTBAR: snapshot current slot assignments from client-set attributes
		local currentHotbar = {}
		for i = 1, 6 do
			local v = player:GetAttribute("HotbarSlot" .. i)
			currentHotbar[i] = (v and v ~= "") and v or ""
		end

		local currentSettings = getSessionSettings(player)

		local currentTransferUsed = math.max(0, math.floor(tonumber(player:GetAttribute("BankTransferLimitUsed")) or 0))
		local currentTransferResetAt = math.max(0, math.floor(tonumber(player:GetAttribute("BankTransferLimitResetAt")) or 0))
		local currentRebirth = math.max(0, math.floor(tonumber(player:GetAttribute("Rebirth")) or 0))
		local currentIndexDiscovered = {}
		local starterPackPurchased = session.StarterPackPurchased == true
		local starterPackPurchaseId = session.StarterPackPurchaseId
		local starterPackClearRequested = session.StarterPackClearRequested == true
		local starterPackReceipts = {}
		if type(session.StarterPackReceipts) == "table" then
			for receiptId, purchased in pairs(session.StarterPackReceipts) do
				if type(receiptId) == "string" and purchased == true then
					starterPackReceipts[receiptId] = true
				end
			end
		end
		local robuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
		do
			local raw = player:GetAttribute("IndexDiscoveredJson")
			if type(raw) == "string" and raw ~= "" then
				local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
				if ok and type(decoded) == "table" then
					local dedupe = {}
					for _, name in ipairs(decoded) do
						if type(name) == "string" then
							local normalized = name:gsub(" Item$", "")
							if CarStats and CarStats.Cars and CarStats.Cars[normalized] then
								dedupe[normalized] = true
							end
						end
					end
					for name in pairs(dedupe) do table.insert(currentIndexDiscovered, name) end
					table.sort(currentIndexDiscovered)
				end
			end
		end
		local currentDailyRewards = decodeDailyRewardsAttribute(player)
		local currentFreeRewardsClaimed = player:GetAttribute(FREE_REWARDS_CLAIMED_ATTRIBUTE) == true

		if currentTransferResetAt > 0 and os.time() >= currentTransferResetAt then
			currentTransferUsed = 0
			currentTransferResetAt = 0
		end

		local inventory = {}
		local invCount = 0
		local seenInstances = {}

		local function scanContainer(container)
			if not container then return end
			for _, tool in pairs(container:GetChildren()) do
				if validateTool(tool) and not seenInstances[tool] then
					seenInstances[tool] = true
					if invCount < MAX_INVENTORY_SIZE then
						local id = tool:GetAttribute("ToolId")
						if id then
							table.insert(inventory, id)
							invCount += 1
						end
					end
				end
			end
		end

		-- ✅ FIX (Held Tool Lost on Disconnect):
		-- Snapshot player.Character into a local now, before any yielding.
		-- If the character is already nil (destroyed before PlayerRemoving
		-- finished), fall back to session.HeldToolId which was cached by
		-- the CharacterRemoving listener set up in InitializePlayer.
		local characterRef = player.Character

		scanContainer(player:FindFirstChild("Backpack"))
		-- StarterGear intentionally excluded — within-session respawn mirror only.
		scanContainer(characterRef)

		if not characterRef and session.HeldToolId then
			local id = session.HeldToolId
			if safeFindCarTool(id) and invCount < MAX_INVENTORY_SIZE then
				local alreadySaved = false
				for _, savedId in ipairs(inventory) do
					if savedId == id then alreadySaved = true; break end
				end
				if not alreadySaved then
					table.insert(inventory, id)
					invCount += 1
				end
			end
		end

		local layout = {}
		local plotName = player:GetAttribute("OccupiedPlot")
		local currentPendingInTycoon = 0

		if plotName and TycoonFolder:FindFirstChild(plotName) then
			local plot = TycoonFolder[plotName]
			if plot:FindFirstChild("PendingEarnings") then
				currentPendingInTycoon = plot.PendingEarnings.Value
			end
			local function savePadsInFolder(padsFolder)
				if not padsFolder then return end
				for _, padObject in pairs(padsFolder:GetChildren()) do
					local padPart = getMainPart(padObject)
					if padPart then
						local linked = padPart:FindFirstChild("LinkedCar")
						if linked and linked.Value then
							local car = linked.Value
							if car.Parent and car:IsDescendantOf(plot) then
								local isOwned = (car:GetAttribute("OwnerUserId") == player.UserId)
								if isOwned then
									local tName = FindToolNameFromModel(car.Name)
									if tName then
										table.insert(layout, { Tool = tName, Pad = padObject.Name })
									end
								end
							end
						end
					end
				end
			end

			local playerBaseLevel = tonumber(player:GetAttribute("BaseLevel")) or 1
			local activeLevelFolder = nil

			if playerBaseLevel == 1 then
				activeLevelFolder = getLevelModel(plot, "Level1")
				if not activeLevelFolder then activeLevelFolder = plot:WaitForChild("Level1", 10) end
			elseif playerBaseLevel == 2 then
				activeLevelFolder = getLevelModel(plot, "Level2")
			end

			if activeLevelFolder then savePadsInFolder(activeLevelFolder:FindFirstChild("Pads")) end
		end

		-- [[ COMMON SHOP SYNC ]]
		local shopBindable = ServerStorage:FindFirstChild("ShopPersistenceFunction")
		local currentShopData = {}
		if shopBindable then currentShopData = safeShopGet(shopBindable, player) end

		-- [[ 🟢 UNCOMMON SHOP SYNC ]]
		local uncommonShopBindable = ServerStorage:FindFirstChild("UncommonShopPersistenceFunction")
		local currentUncommonShopData = {}
		if uncommonShopBindable then currentUncommonShopData = safeShopGet(uncommonShopBindable, player) end

		-- [[ 🟣 RARE SHOP SYNC ]]
		local rareShopBindable = ServerStorage:FindFirstChild("RareShopPersistenceFunction")
		local currentRareShopData = {}
		if rareShopBindable then currentRareShopData = safeShopGet(rareShopBindable, player) end

		-- [[ 🟠 EPIC SHOP SYNC ]]
		local epicShopBindable = ServerStorage:FindFirstChild("EpicShopPersistenceFunction")
		local currentEpicShopData = {}
		if epicShopBindable then currentEpicShopData = safeShopGet(epicShopBindable, player) end

		-- [[ 🟡 LEGENDARY SHOP SYNC ]]
		local legendaryShopBindable = ServerStorage:FindFirstChild("LegendaryShopPersistenceFunction")
		local currentLegendaryShopData = {}
		if legendaryShopBindable then
			currentLegendaryShopData = safeShopGet(legendaryShopBindable, player)
		end

		-- [[ 🔴 MYTHICAL SHOP SYNC ]]
		local mythicalShopBindable = ServerStorage:FindFirstChild("MythicalShopPersistenceFunction")
		local currentMythicalShopData = {}
		if mythicalShopBindable then
			currentMythicalShopData = safeShopGet(mythicalShopBindable, player)
		end

		local sacrificeOccurredThisSession = session.SacrificeOccurred == true

		for attempt = 1, MAX_RETRIES do
			local updateSuccess, updateResult = pcall(function()
				return PlayerDataStore:UpdateAsync("User_V27_" .. player.UserId, function(oldData)
					oldData = oldData or {}

					local finalInventory = inventory

					if #inventory == 0
						and (oldData.Inventory and #oldData.Inventory > 0)
						and not session.ExplicitClear
						and not sacrificeOccurredThisSession
					then
						warn("⚠️ Anti-Wipe (Inventory): Preserving for " .. player.Name)
						finalInventory = {}
						for _, oldId in pairs(oldData.Inventory) do
							if safeFindCarTool(oldId) then
								table.insert(finalInventory, oldId)
							end
						end
					end

					local finalLayout = layout
					local isSuspiciousLayoutWipe = (#layout == 0) and (oldData.Layout and #oldData.Layout > 0)

					-- Fix 5: SacrificeOccurred Does Not Gate the Layout Anti-Wipe
					if isSuspiciousLayoutWipe and not session.ExplicitClear then
						local oldInvCount = oldData.Inventory and #oldData.Inventory or 0
						local newInvCount = #finalInventory

						if newInvCount > oldInvCount then
							print("✅ Valid Pickup Detected. Saving empty layout.")
							finalLayout = layout
						else
							warn("⚠️ Anti-Wipe (Layout): Preserving for " .. player.Name)
							finalLayout = {}
							local seenPads = {}
							for _, oldEntry in pairs(oldData.Layout) do
								if FindModelNameFromTool(oldEntry.Tool) and not seenPads[oldEntry.Pad] then
									seenPads[oldEntry.Pad] = true
									table.insert(finalLayout, oldEntry)
								end
							end
						end
					else
						finalLayout = layout
					end

					local offlineTabletCarry = math.max(0, math.floor(tonumber(player:GetAttribute("OfflineTabletCarry")) or 0))
					local finalPending = offlineTabletCarry + currentPendingInTycoon

					oldData.Bank       = MoneyManager.GetBalance(player, "Cash")
					oldData.Wallet     = MoneyManager.GetBalance(player, "Wallet")
					oldData.ATMBalance = MoneyManager.GetBalance(player, "ATMBalance")
					oldData.Inventory = finalInventory
					oldData.Layout = finalLayout
					oldData.PendingEarnings = finalPending

					oldData.ShopPurchases          = currentShopData
					oldData.UncommonShopPurchases   = currentUncommonShopData
					oldData.RareShopPurchases       = currentRareShopData
					oldData.EpicShopPurchases       = currentEpicShopData
					oldData.LegendaryShopPurchases  = currentLegendaryShopData
					oldData.MythicalShopPurchases   = currentMythicalShopData

					oldData.OwnedBaseSkins    = currentOwnedSkins
					oldData.EquippedSkin      = currentEquippedSkin
					oldData.HighestUnlockedPad = currentUnlockedPad
					oldData.BaseLevel = currentBaseLevel
					oldData.Rank = currentRank
					oldData.RankData = currentRankData
					oldData.HotbarSlots = currentHotbar
					oldData.BankTransferLimitUsed = currentTransferUsed
					oldData.BankTransferLimitResetAt = currentTransferResetAt
					oldData.Rebirth = currentRebirth
					oldData.IndexDiscovered = currentIndexDiscovered
					oldData.DailyRewards = currentDailyRewards
					oldData.FreeRewardsClaimed = oldData.FreeRewardsClaimed == true or currentFreeRewardsClaimed
					if starterPackClearRequested then
						oldData.StarterPackPurchased = false
						oldData.StarterPackPurchaseId = nil
						oldData.StarterPackReceipts = {}
					else
						oldData.StarterPackPurchased = oldData.StarterPackPurchased == true or starterPackPurchased
						if type(oldData.StarterPackReceipts) ~= "table" then
							oldData.StarterPackReceipts = {}
						end
						for receiptId, purchased in pairs(starterPackReceipts) do
							if purchased == true then
								oldData.StarterPackReceipts[receiptId] = true
							end
						end
						if type(starterPackPurchaseId) == "string" and starterPackPurchaseId ~= "" then
							oldData.StarterPackPurchaseId = starterPackPurchaseId
						end
					end
					local mergedRobuxProductReceipts = sanitizeRobuxReceiptHistory(oldData.RobuxProductReceipts)
					for receiptId, receiptData in pairs(robuxProductReceipts) do
						mergedRobuxProductReceipts[receiptId] = receiptData
					end
					oldData.RobuxProductReceipts = compactRobuxReceiptHistory(mergedRobuxProductReceipts)
					oldData.Settings = currentSettings
					oldData.SettingsVersion = SETTINGS_SCHEMA_VERSION

					oldData.LastUpdated  = os.time()
					oldData.LastOfflineAt = os.time()
					oldData.DataVersion  = "V40_StarterPackReceiptHardened"

					return oldData
				end)
			end)

			if updateSuccess and updateResult ~= nil then
				saveSucceeded = true
				return true
			end
			task.wait(0.35 * attempt)
		end
		error("UpdateAsync failed after retries")
	end

	local ok, saveErr = pcall(executeSave)
	if not ok then
		warn("❌ Save Failed " .. player.Name .. ": " .. tostring(saveErr))
	elseif isClosing then
		print("✅ Saved: " .. player.Name)
	end

	if saveSucceeded then
		local hasNewerDirtyState = (session.DirtyVersion or 0) ~= saveDirtyVersion
		session.IsDirty = hasNewerDirtyState
		session.LastSave = hasNewerDirtyState and 0 or os.time()
		if not hasNewerDirtyState then
			session.SacrificeOccurred = false
			session.ExplicitClear = false
			if session.StarterPackClearRequested then
				session.StarterPackSaveConfirmed = false
			else
				session.StarterPackSaveConfirmed = session.StarterPackPurchased == true
			end
			session.StarterPackClearRequested = false
		end
	end

	if isClosing then
		local function safeClose(bindableName)
			local b = ServerStorage:FindFirstChild(bindableName)
			if not b then return end
			local ok2, err2 = pcall(function() b:Invoke("Close", player) end)
			if not ok2 then
				warn("⚠️ Shop cleanup error (" .. bindableName .. "): " .. tostring(err2))
			end
		end

		safeClose("ShopPersistenceFunction")
		safeClose("UncommonShopPersistenceFunction")
		safeClose("RareShopPersistenceFunction")
		safeClose("EpicShopPersistenceFunction")
		safeClose("LegendaryShopPersistenceFunction")
		safeClose("MythicalShopPersistenceFunction")
		safeClose("RankPersistenceFunction")
	end

	session.IsSaving = false

	local syncEvent = game.ServerStorage:FindFirstChild("TycoonSaveCompleted")
	if syncEvent then syncEvent:Fire(player.Name) end

	player:SetAttribute("DataSaved", saveSucceeded == true)
	return saveSucceeded
end
-- ----------------------------------------------------------------------------
-- 🚪 PLAYER INITIALIZATION
-- ----------------------------------------------------------------------------
local function InitializePlayer(player)
	SessionData[player] = {
		LastSave          = os.time(),
		IsDirty           = false,
		DirtyVersion      = 0,
		DataLoaded        = false,
		ExplicitClear     = false,
		IsSaving          = false,
		SacrificeOccurred = false,
		-- ✅ FIX (Held Tool Lost on Disconnect): caches the ToolId of the
		-- tool the player was holding when their character was removed.
		-- Used as a fallback in save() if player.Character is already nil.
		HeldToolId        = nil,
		SettingsState     = sanitizeSettings(nil),
		StarterPackPurchased = false,
		StarterPackPurchaseId = nil,
		StarterPackReceipts = {},
		RobuxProductReceipts = {},
		StarterPackGrantInProgress = false,
		StarterPackSaveConfirmed = false,
		StarterPackClearRequested = false,
	}

	-- Public ready flag used by DailyRewardsService so rewards cannot be claimed
	-- before this main data profile has finished loading.
	player:SetAttribute(DATA_READY_ATTRIBUTE, false)

	-- ✅ FIX (Held Tool Lost on Disconnect):
	-- CharacterRemoving fires reliably before the character instance is
	-- destroyed, so we can safely read children here and cache the held tool.
	player.CharacterRemoving:Connect(function(character)
		local session = SessionData[player]
		if not session then return end
		session.HeldToolId = nil
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") and validateTool(child) then
				local id = child:GetAttribute("ToolId")
				if id then
					session.HeldToolId = id
					break -- a player can only hold one tool at a time
				end
			end
		end
	end)

	-- Clear the cache when a fresh character spawns so a stale value from
	-- a previous death never contaminates the next save snapshot.
	player.CharacterAdded:Connect(function()
		local session = SessionData[player]
		if session then session.HeldToolId = nil end
	end)

	local ls = Instance.new("Folder"); ls.Name = "leaderstats"; ls.Parent = player
	local hs = Instance.new("Folder"); hs.Name = "HiddenStats"; hs.Parent = player
	local cash   = Instance.new("NumberValue"); cash.Name   = "Cash";       cash.Parent   = hs
	local wallet = Instance.new("NumberValue"); wallet.Name = "Wallet";     wallet.Parent = ls
	local atm    = Instance.new("NumberValue"); atm.Name    = "ATMBalance"; atm.Parent    = ls

	local function setDirty() markDirty(player) end
	cash.Changed:Connect(setDirty)
	wallet.Changed:Connect(setDirty)
	atm.Changed:Connect(setDirty)

	local key = "User_V27_" .. player.UserId
	local data
	local loadSuccess, loadErr = pcall(function() data = PlayerDataStore:GetAsync(key) end)

	if not loadSuccess then player:Kick("Data Load Error. Rejoin.") return end

	data = data or {
		Inventory = {}, Layout = {}, PendingEarnings = 0, HighestUnlockedPad = 1, BaseLevel = 1,
		ShopPurchases = {}, UncommonShopPurchases = {}, RareShopPurchases = {},
		EpicShopPurchases = {}, LegendaryShopPurchases = {}, MythicalShopPurchases = {},
		OwnedBaseSkins = { "Default" }, EquippedSkin = "Default", Rank = "Player", RankData = {},
		Settings = sanitizeSettings(nil), SettingsVersion = SETTINGS_SCHEMA_VERSION, Rebirth = 0, IndexDiscovered = {},
		StarterPackPurchased = false, StarterPackPurchaseId = nil, StarterPackReceipts = {},
		RobuxProductReceipts = {},
		DailyRewards = sanitizeDailyRewardsData(nil), FreeRewardsClaimed = false
	}

	data.Inventory              = data.Inventory              or {}
	data.Layout                 = data.Layout                 or {}
	data.ShopPurchases          = data.ShopPurchases          or {}
	data.UncommonShopPurchases  = data.UncommonShopPurchases  or {}
	data.RareShopPurchases      = data.RareShopPurchases      or {}
	data.EpicShopPurchases      = data.EpicShopPurchases      or {}
	data.LegendaryShopPurchases = data.LegendaryShopPurchases or {}
	data.MythicalShopPurchases  = data.MythicalShopPurchases  or {}
	data.OwnedBaseSkins         = data.OwnedBaseSkins         or { "Default" }
	data.EquippedSkin           = data.EquippedSkin           or "Default"
	data.BaseLevel              = data.BaseLevel              or 1
	data.Rank                   = data.Rank                   or "Player"
	data.RankData               = data.RankData               or {}
	data.BankTransferLimitUsed  = data.BankTransferLimitUsed  or 0
	data.BankTransferLimitResetAt = data.BankTransferLimitResetAt or 0
	data.Rebirth = math.max(0, math.floor(tonumber(data.Rebirth) or 0))
	data.IndexDiscovered = data.IndexDiscovered or {}
	data.SettingsVersion = math.max(0, math.floor(tonumber(data.SettingsVersion) or 0))
	data.Settings = sanitizeSettings(data.Settings)
	data.StarterPackPurchased = data.StarterPackPurchased == true
	data.StarterPackPurchaseId = type(data.StarterPackPurchaseId) == "string" and data.StarterPackPurchaseId or nil
	data.StarterPackReceipts = type(data.StarterPackReceipts) == "table" and data.StarterPackReceipts or {}
	data.RobuxProductReceipts = compactRobuxReceiptHistory(data.RobuxProductReceipts)
	data.DailyRewards = sanitizeDailyRewardsData(data.DailyRewards)
	data.FreeRewardsClaimed = data.FreeRewardsClaimed == true
	data.LastOfflineAt = math.max(0, math.floor(tonumber(data.LastOfflineAt) or 0))
	player:SetAttribute("LastOfflineAt", data.LastOfflineAt)

	-- Migration: older saves could carry CarAnimationEnabled=false as a historical default
	-- rather than an explicit player choice. On first settings schema upgrade, normalize
	-- the default to ON so users only have animation disabled when they explicitly choose it.
	if data.SettingsVersion < SETTINGS_SCHEMA_VERSION then
		data.Settings.CarAnimationEnabled = true
		data.SettingsVersion = SETTINGS_SCHEMA_VERSION
	end

	local function sanitizeMoney(value)
		value = tonumber(value) or 0
		if value ~= value or value == math.huge or value == -math.huge then return 0 end
		return math.max(0, math.floor(value))
	end

	cash.Value   = sanitizeMoney(data.Bank)
	wallet.Value = sanitizeMoney(data.Wallet)
	atm.Value    = sanitizeMoney(data.ATMBalance)

	SessionData[player].SettingsState = sanitizeSettings(data.Settings)
	SessionData[player].StarterPackPurchased = data.StarterPackPurchased
	SessionData[player].StarterPackPurchaseId = data.StarterPackPurchaseId
	SessionData[player].StarterPackSaveConfirmed = data.StarterPackPurchased == true
	SessionData[player].StarterPackReceipts = {}
	SessionData[player].RobuxProductReceipts = compactRobuxReceiptHistory(data.RobuxProductReceipts)
	for receiptId, purchased in pairs(data.StarterPackReceipts) do
		if type(receiptId) == "string" and purchased == true then
			SessionData[player].StarterPackReceipts[receiptId] = true
		end
	end
	if data.StarterPackPurchaseId then
		SessionData[player].StarterPackReceipts[data.StarterPackPurchaseId] = true
	end
	applySettingsAttributes(player, SessionData[player].SettingsState)

	local function safeShopLoad(bindableName, payload)
		local bindable = ServerStorage:FindFirstChild(bindableName)
		if not bindable then
			return
		end
		if not bindable:IsA("BindableFunction") then
			warn("⚠️ [TycoonDataHandler] " .. bindableName .. " exists but is not a BindableFunction. Skipping load.")
			return
		end
		local ok, err = pcall(function()
			bindable:Invoke("Load", player, payload)
		end)
		if not ok then
			warn("⚠️ [TycoonDataHandler] " .. bindableName .. " load failed for " .. player.Name .. ": " .. tostring(err))
		end
	end

	safeShopLoad("ShopPersistenceFunction", data.ShopPurchases)
	safeShopLoad("UncommonShopPersistenceFunction", data.UncommonShopPurchases)
	safeShopLoad("RareShopPersistenceFunction", data.RareShopPurchases)
	safeShopLoad("EpicShopPersistenceFunction", data.EpicShopPurchases)
	safeShopLoad("LegendaryShopPersistenceFunction", data.LegendaryShopPurchases)
	safeShopLoad("MythicalShopPersistenceFunction", data.MythicalShopPurchases)

	player:SetAttribute("HighestUnlockedPad", data.HighestUnlockedPad or 1)
	player:SetAttribute("BaseLevel", data.BaseLevel or 1)
	local ownedJson = HttpService:JSONEncode(data.OwnedBaseSkins)
	player:SetAttribute("OwnedBaseSkins", ownedJson)
	player:SetAttribute("EquippedSkin", data.EquippedSkin)
	player:SetAttribute("Rank", data.Rank)
	player:SetAttribute("Rebirth", data.Rebirth)
	player:SetAttribute("RebirthMultiplier", RebirthConfig.GetMultiplier(data.Rebirth))
	local discoveredSet = {}
	for _, toolName in ipairs(data.IndexDiscovered) do
		if type(toolName) == "string" then
			local normalized = toolName:gsub(" Item$", "")
			if CarStats and CarStats.Cars and CarStats.Cars[normalized] then
				discoveredSet[normalized] = true
			end
		end
	end
	for _, toolName in pairs(data.Inventory) do
		if type(toolName) == "string" then
			local normalized = toolName:gsub(" Item$", "")
			if CarStats and CarStats.Cars and CarStats.Cars[normalized] then
				discoveredSet[normalized] = true
			end
		end
	end
	local discoveredList = {}
	for name in pairs(discoveredSet) do table.insert(discoveredList, name) end
	table.sort(discoveredList)
	player:SetAttribute("IndexDiscoveredJson", HttpService:JSONEncode(discoveredList))
	player:SetAttribute(DAILY_REWARDS_STATE_ATTRIBUTE, HttpService:JSONEncode(data.DailyRewards))
	player:SetAttribute(FREE_REWARDS_CLAIMED_ATTRIBUTE, data.FreeRewardsClaimed == true)

	local transferUsed = math.max(0, math.floor(tonumber(data.BankTransferLimitUsed) or 0))
	local transferResetAt = math.max(0, math.floor(tonumber(data.BankTransferLimitResetAt) or 0))
	if transferResetAt > 0 and os.time() >= transferResetAt then
		transferUsed = 0
		transferResetAt = 0
	end
	player:SetAttribute("BankTransferLimitUsed", transferUsed)
	player:SetAttribute("BankTransferLimitResetAt", transferResetAt)

	local rankPersistenceBindable = ServerStorage:FindFirstChild("RankPersistenceFunction")
	if rankPersistenceBindable and rankPersistenceBindable:IsA("BindableFunction") then
		data.RankData.LegacyRank = data.Rank
		data.RankData.CurrentRank = data.RankData.CurrentRank or data.Rank
		local ok, rankErr = pcall(function()
			rankPersistenceBindable:Invoke("Load", player, data.RankData)
		end)
		if not ok then
			warn("⚠️ [TycoonDataHandler] RankPersistenceFunction load failed for " .. player.Name .. ": " .. tostring(rankErr))
		end
	elseif rankPersistenceBindable then
		warn("⚠️ [TycoonDataHandler] ServerStorage > RankPersistenceFunction exists but is not a BindableFunction.")
	end

	-- 🎮 HOTBAR: restore slot assignments so the client can read them
	local hotbarSlots = data.HotbarSlots or {}
	for i = 1, 6 do
		local v = hotbarSlots[i] or (hotbarSlots[tostring(i)] or "")
		player:SetAttribute("HotbarSlot" .. i, v)
	end

	player:GetAttributeChangedSignal("HighestUnlockedPad"):Connect(setDirty)
	player:GetAttributeChangedSignal("BaseLevel"):Connect(setDirty)
	player:GetAttributeChangedSignal("OwnedBaseSkins"):Connect(setDirty)
	player:GetAttributeChangedSignal("EquippedSkin"):Connect(setDirty)
	player:GetAttributeChangedSignal("Rank"):Connect(setDirty)
	player:GetAttributeChangedSignal("BankTransferLimitUsed"):Connect(setDirty)
	player:GetAttributeChangedSignal("BankTransferLimitResetAt"):Connect(setDirty)
	player:GetAttributeChangedSignal("Rebirth"):Connect(setDirty)
	player:GetAttributeChangedSignal("IndexDiscoveredJson"):Connect(setDirty)
	player:GetAttributeChangedSignal(DAILY_REWARDS_STATE_ATTRIBUTE):Connect(setDirty)
	for _, attributeName in pairs(PLAYER_SETTING_ATTRIBUTES) do
		player:GetAttributeChangedSignal(attributeName):Connect(function()
			local session = SessionData[player]
			if not session then return end
			for settingName, mappedAttribute in pairs(PLAYER_SETTING_ATTRIBUTES) do
				if mappedAttribute == attributeName then
					local value = player:GetAttribute(attributeName)
					if type(value) == "boolean" then
						session.SettingsState[settingName] = value
					end
					break
				end
			end
			setDirty()
		end)
	end
	for i = 1, 6 do
		player:GetAttributeChangedSignal("HotbarSlot" .. i):Connect(setDirty)
	end

	local function ApplyRankVisual()
		local SetRankAPI = ServerStorage:FindFirstChild("SetRankAPI")
		if SetRankAPI then
			SetRankAPI:Invoke(player, player:GetAttribute("Rank") or "Player")
		else
			warn("⚠️ SetRankAPI missing in ServerStorage")
		end
	end

	if player.Character then
		task.spawn(ApplyRankVisual)
	end
	player.CharacterAdded:Connect(ApplyRankVisual)

	if player:FindFirstChild("Backpack") then player.Backpack:ClearAllChildren() end
	if player:FindFirstChild("StarterGear") then player.StarterGear:ClearAllChildren() end

	if data.Inventory then
		for _, toolName in pairs(data.Inventory) do
			if type(toolName) == "string" then
				local restoreOk, restoreMessage = giveTool(player, toolName, {
					BypassStorageLimit = true,
					Source = "DataLoad",
					SuppressDirty = true,
					SuppressIndexMark = true,
				})
				if not restoreOk then
					warn("⚠️ [DATA] Failed to restore saved tool for " .. player.Name .. ": " .. tostring(toolName) .. " (" .. tostring(restoreMessage) .. ")")
				end
			end
		end
	end

	if #data.Inventory == 0 and (not data.Layout or #data.Layout == 0) then
		giveTool(player, STARTER_CAR_NAME)
	end

	sanitizeInventory(player)

	local loadedTabletCarry = math.max(0, math.floor(tonumber(data.PendingEarnings) or 0))
	player:SetAttribute("OfflineTabletCarry", loadedTabletCarry)

	if data.Layout and #data.Layout > 0 then
		task.spawn(function()
			local plotName = player:GetAttribute("OccupiedPlot")
			if not plotName then
				player:GetAttributeChangedSignal("OccupiedPlot"):Wait()
				plotName = player:GetAttribute("OccupiedPlot")
			end
			if plotName then
				local plot = TycoonFolder:FindFirstChild(plotName) or TycoonFolder:WaitForChild(plotName, 10)
				if plot then
					task.wait(1)
					RestoreLayout(player, plot, data.Layout)
				else
					warn("⚠️ [TycoonDataHandler] Missing expected plot " .. tostring(plotName) .. " under Workspace > Tycoons for " .. player.Name .. ". Layout restore skipped.")
				end
			end
		end)
	end

	local function CheckAndRestorePending()
		-- Offline tablet carry is now claimed via OfflineEarningsService instead of restoring to plot immediately.
		return
	end

	player:GetAttributeChangedSignal("OccupiedPlot"):Connect(CheckAndRestorePending)
	CheckAndRestorePending()

	player:SetAttribute(DATA_READY_ATTRIBUTE, true)
	SessionData[player].DataLoaded = true
end

Players.PlayerAdded:Connect(InitializePlayer)
Players.PlayerRemoving:Connect(function(player)
	local pendingSaveTask = PendingCriticalSaveTasks[player.UserId]
	if pendingSaveTask then
		task.cancel(pendingSaveTask)
		PendingCriticalSaveTasks[player.UserId] = nil
	end
	save(player, true)
	FreeRewardsClaimLocks[player] = nil
	SessionData[player] = nil
end)

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		save(player, true)
	end
end)

task.spawn(function()
	while true do
		task.wait(10)
		local now = os.time()
		for _, player in pairs(Players:GetPlayers()) do
			local session = SessionData[player]
			if session and session.DataLoaded and session.IsDirty
				and (now - session.LastSave >= AUTOSAVE_INTERVAL) then
				task.spawn(function() save(player, false) end)
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(25)
		for _, player in pairs(Players:GetPlayers()) do
			sanitizeInventory(player)
		end
	end
end)
