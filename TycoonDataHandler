local function logAdmin(message, severity)
	local prefix = severity and "[" .. severity .. "] " or "[INFO] "
	warn("🛡️ " .. prefix .. message)
	if AdminLogEvent then AdminLogEvent:FireAllClients(prefix .. message) end
