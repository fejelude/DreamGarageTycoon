local function markDirty(player)
	local session = SessionData[player]
	if session then
		session.IsDirty = true
		session.DirtyVersion = (session.DirtyVersion or 0) + 1
	end
end

local function queueCriticalSave(player, delaySeconds)
	if not player or not SessionData[player] then
		return false, "Player data not loaded"
	end
	if not save then
		return false, "Save system unavailable"
	end

	markDirty(player)

	if PendingCriticalSaveTasks[player] then
		return true
	end

	PendingCriticalSaveTasks[player] = task.delay(math.max(1, tonumber(delaySeconds) or 8), function()
		PendingCriticalSaveTasks[player] = nil
		local session = SessionData[player]
		if session and session.DataLoaded and session.IsDirty then
			save(player, false, true)
		end
	end)

	return true
end

local function cancelPendingSettingsDirty(player)
	local userId = player and player.UserId
	local pendingTask = userId and pendingSettingsDirtyByUserId[userId]
	if pendingTask then
		task.cancel(pendingTask)
		pendingSettingsDirtyByUserId[userId] = nil
	end
end

local function scheduleSettingsDirty(player)
	if not player or player.Parent ~= Players then return end
	if pendingSettingsDirtyByUserId[player.UserId] then return end

	pendingSettingsDirtyByUserId[player.UserId] = task.delay(SETTINGS_UPDATE_RATE_LIMIT_SECONDS, function()
		pendingSettingsDirtyByUserId[player.UserId] = nil
		if player.Parent == Players then
			markDirty(player)
		end
	end)
end

local function sanitizeSettings(rawSettings)
	local settings = {}
	if type(rawSettings) ~= "table" then
		rawSettings = {}
	end

	for settingName, defaultValue in pairs(DEFAULT_PLAYER_SETTINGS) do
		local rawValue = rawSettings[settingName]
		if type(rawValue) == "boolean" then
			settings[settingName] = rawValue
		else
			settings[settingName] = defaultValue
		end
	end

	return settings
end

local function applySettingsAttributes(player, settings)
	for settingName, attributeName in pairs(PLAYER_SETTING_ATTRIBUTES) do
		player:SetAttribute(attributeName, settings[settingName])
	end
end

local function getCurrentSettings(player)
	local settings = {}
	for settingName, defaultValue in pairs(DEFAULT_PLAYER_SETTINGS) do
		local attributeName = PLAYER_SETTING_ATTRIBUTES[settingName]
		local value = player:GetAttribute(attributeName)
		settings[settingName] = (type(value) == "boolean") and value or defaultValue
	end
	return settings
end

local function getSessionSettings(player)
	local session = SessionData[player]
	if session and type(session.SettingsState) == "table" then
		return sanitizeSettings(session.SettingsState)
	end
	return getCurrentSettings(player)
end

local function hasReceiveGiftsEnabled(player)
	if not player then return false end

	local attributeName = PLAYER_SETTING_ATTRIBUTES.ReceiveGiftsEnabled
	local attributeValue = player:GetAttribute(attributeName)
	if type(attributeValue) == "boolean" then
		return attributeValue == true
	end

	local session = SessionData[player]
	if session and type(session.SettingsState) == "table" then
		local savedValue = session.SettingsState.ReceiveGiftsEnabled
		if type(savedValue) == "boolean" then
			return savedValue == true
		end
	end

	return DEFAULT_PLAYER_SETTINGS.ReceiveGiftsEnabled == true
end

local function setPlayerSetting(player, settingName, value, shouldMarkDirty)
	local attributeName = PLAYER_SETTING_ATTRIBUTES[settingName]
	if not attributeName or type(value) ~= "boolean" then
		return false
	end

	local session = SessionData[player]
	if session then
		session.SettingsState = session.SettingsState or sanitizeSettings(nil)
		if session.SettingsState[settingName] == value and player:GetAttribute(attributeName) == value then
			return false
		end
		session.SettingsState[settingName] = value
	end

	player:SetAttribute(attributeName, value)

	if shouldMarkDirty ~= false then
		markDirty(player)
	end

	return true
end

SettingsPersistenceEvent.OnServerEvent:Connect(function(player, settingName, value)
	local attributeName = PLAYER_SETTING_ATTRIBUTES[settingName]
	if not attributeName or type(value) ~= "boolean" then
		return
	end

	local now = os.clock()
	local lastUpdate = lastSettingsUpdateByUserId[player.UserId] or 0
	if now - lastUpdate < SETTINGS_UPDATE_RATE_LIMIT_SECONDS then
		-- Keep authoritative attributes in sync for rapid legitimate toggles immediately.
		-- If the value changed, delay one dirty mark so the final rapid toggle still persists.
		local changed = setPlayerSetting(player, settingName, value, false)
		if changed then
			scheduleSettingsDirty(player)
		end
		return
	end

	lastSettingsUpdateByUserId[player.UserId] = now
	cancelPendingSettingsDirty(player)
	setPlayerSetting(player, settingName, value, true)
end)

Players.PlayerRemoving:Connect(function(player)
	lastSettingsUpdateByUserId[player.UserId] = nil
	cancelPendingSettingsDirty(player)
end)

