-- Purpose: Handles all DataStore operations, Security Validation, Session Management, and prevents item duplication.
-- Runs on: Server
-- Location: ServerScriptService > TycoonDataHandler
-- Dependencies: Players, ServerStorage, DataStoreService, Workspace, ReplicatedStorage, HttpService, CarStats, BaseSkinStats
-- Public API: TycoonAdminAPI (BindableFunction), LegendaryCraftingInventoryFunction (BindableFunction)
-- Public API: TycoonAdminAPI (BindableFunction), LegendaryCraftingInventoryFunction (BindableFunction), MythicalCraftingInventoryFunction (BindableFunction)
-- Networking: TycoonAdminLog (RemoteEvent), ShopRemotes (via Bindable)
-- Security: Server-authoritative tool validation, anti-wipe protection, fixed StarterGear duplication exploit.
-- Performance: Batched saving, lock-based pad restoration to prevent race conditions.
-- Notes: Updated to support UNCOMMON, RARE, EPIC, LEGENDARY, and MYTHICAL SHOP Persistence.
--
-- FIX (Legendary Sacrifice Dupe):
--   Added session.SacrificeOccurred flag. Set to true whenever
--   LegendaryCraftingInventoryAPI:RemoveTool succeeds. The anti-wipe inventory
--   check is gated behind this flag so a legitimate sacrifice-to-empty-inventory
--   is never mistakenly restored. Without this fix a player could sacrifice all
--   ingredient cars, disconnect, and rejoin with both the sacrifice progress AND
--   the cars restored in their inventory (free duplication).
--
-- FIX (Cash resets to 0 on rejoin):
--   MoneyManager.GetBalance now reads Cash from HiddenStats instead of leaderstats.
--   Previously every save wrote 0 for Bank because Cash was no longer in leaderstats,
--   causing the balance to be wiped on every rejoin.

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

-- ----------------------------------------------------------------------------
-- ⚙️ CONFIGURATION & CONSTANTS
-- ----------------------------------------------------------------------------
local DATA_KEY = "Testingv7"
local PlayerDataStore = DataStoreService:GetDataStore(DATA_KEY)

local AUTOSAVE_INTERVAL = 180
local MIN_SAVE_INTERVAL = 60
local MAX_RETRIES = 3

local MAX_INVENTORY_SIZE = 500
local MAX_LAYOUT_SIZE = 200
local STARTER_CAR_NAME = "Delta Item"

-- ----------------------------------------------------------------------------
-- 📂 ASSET REFERENCES
-- ----------------------------------------------------------------------------
local CarTools = ServerStorage:WaitForChild("CarTools")
local CarModels = ServerStorage:WaitForChild("CarModels")
local TycoonFolder = Workspace:WaitForChild("Tycoons")
local AdminLogEvent = ServerStorage:FindFirstChild("TycoonAdminLog")

-- 📚 MODULES
local CarStats
local success, err = pcall(function()
	CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))
end)
if not success then warn("⚠️ CarStats module not found.") end

-- ----------------------------------------------------------------------------
-- 🔒 STATE MANAGEMENT
-- ----------------------------------------------------------------------------
local SessionData = {}
local PadLocks = {}

-- ----------------------------------------------------------------------------
-- 🛡️ HELPER FUNCTIONS
-- ----------------------------------------------------------------------------
local function logAdmin(message, severity)
	local prefix = severity and "[" .. severity .. "] " or "[INFO] "
	warn("🛡️ " .. prefix .. message)
	if AdminLogEvent then AdminLogEvent:FireAllClients(prefix .. message) end
end

local function markDirty(player)
	local session = SessionData[player]
	if session and not session.IsDirty then
		session.IsDirty = true
	end
end

-- ----------------------------------------------------------------------------
-- 🛡️ IDENTITY & VALIDATION
-- ----------------------------------------------------------------------------
local function tagIssued(tool, originalName)
	if not tool then return end
	tool:SetAttribute("IssuedByServer", true)
	tool:SetAttribute("IssuedAt", os.time())
	tool:SetAttribute("IssuedId", HttpService:GenerateGUID(false))
	tool:SetAttribute("ToolId", originalName)
end

local function validateTool(tool)
	if not tool then return false end
	if not tool:GetAttribute("IssuedByServer") then return false end
	local id = tool:GetAttribute("ToolId")
	if not id then return false end
	if not CarTools:FindFirstChild(id, true) then return false end
	return true
end

local function sanitizeInventory(player)
	if not player then return end
	local containers = { player.Backpack, player:FindFirstChild("StarterGear") }

	for _, container in ipairs(containers) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") then
					if not tool:GetAttribute("ToolId") then
						logAdmin("Destroyed unauthorized tool (missing ToolId): " .. tool.Name, "WARN")
						tool:Destroy()
					elseif not validateTool(tool) then
						logAdmin("Destroyed unauthorized tool: " .. tool.Name, "WARN")
						tool:Destroy()
					else
						if tool.CanBeDropped then tool.CanBeDropped = false end
						local realId = tool:GetAttribute("ToolId")
						if realId and tool.Name ~= realId then
							tool.Name = realId
						end
					end
				end
			end
		end
	end
end

-- ----------------------------------------------------------------------------
-- 💰 MONEY MANAGER
-- ----------------------------------------------------------------------------
local MoneyManager = {}
function MoneyManager.GetBalance(player, currencyType)
	if not player then return 0 end

	-- ✅ FIX: Cash lives in HiddenStats, everything else in leaderstats
	if currencyType == "Cash" then
		local hs = player:FindFirstChild("HiddenStats")
		if not hs then return 0 end
		local val = hs:FindFirstChild("Cash")
		return val and val.Value or 0
	else
		local ls = player:FindFirstChild("leaderstats")
		if not ls then return 0 end
		local val = ls:FindFirstChild(currencyType)
		return val and val.Value or 0
	end
end

-- ----------------------------------------------------------------------------
-- 🛠️ ASSET LOOKUPS
-- ----------------------------------------------------------------------------
local function FindToolNameFromModel(modelName)
	if CarTools:FindFirstChild(modelName, true) then return modelName end
	if CarTools:FindFirstChild(modelName .. " Item", true) then return modelName .. " Item" end
	local clean = modelName:gsub(" Item", ""):gsub("Item", "")
	for _, t in pairs(CarTools:GetDescendants()) do
		if t.Name:gsub(" Item", "") == clean then return t.Name end
	end
	if CarStats and CarStats.Cars then
		for internalID, stats in pairs(CarStats.Cars) do
			if stats.Name == modelName then
				if CarTools:FindFirstChild(internalID .. " Item", true) then return internalID .. " Item"
				elseif CarTools:FindFirstChild(internalID, true) then return internalID end
			end
		end
	end
	return nil
end

local function FindModelNameFromTool(toolName)
	local clean = toolName:gsub(" Item", ""):gsub("Item", "")
	if CarModels:FindFirstChild(clean, true) then return clean end
	if CarStats and CarStats.Cars and CarStats.Cars[clean] then
		local stats = CarStats.Cars[clean]
		if CarModels:FindFirstChild(stats.Name, true) then return stats.Name end
	end
	return nil
end

local function getMainPart(obj)
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		if obj.PrimaryPart then return obj.PrimaryPart end
		for _, child in pairs(obj:GetChildren()) do
			if child:IsA("BasePart") and child.Name ~= "Border" then return child end
		end
		return obj:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

local function generateCarGUID(player)
	return player.UserId .. "_" .. HttpService:GenerateGUID(false)
end

-- ----------------------------------------------------------------------------
-- 🎁 GIVE TOOL
-- ----------------------------------------------------------------------------
local function giveTool(player, toolName, customAttributes)
	if not player or not player.Parent then return end
	local sourceTool = CarTools:FindFirstChild(toolName, true)
	if not sourceTool then
		local altName = toolName:gsub(" Item", "")
		sourceTool = CarTools:FindFirstChild(altName, true)
	end
	if not sourceTool then
		local rec = FindToolNameFromModel(toolName)
		if rec then sourceTool = CarTools:FindFirstChild(rec, true) end
	end

	if sourceTool then
		local backpackTool = sourceTool:Clone()
		local gearTool = sourceTool:Clone()
		tagIssued(backpackTool, sourceTool.Name)
		tagIssued(gearTool, sourceTool.Name)

		if type(customAttributes) == "table" then
			for k, v in pairs(customAttributes) do
				backpackTool:SetAttribute(k, v)
				gearTool:SetAttribute(k, v)
			end
		end

		if player:FindFirstChild("Backpack") then
			backpackTool.Parent = player.Backpack
		else
			warn("⚠️ Receiver dead/respawning. Item added to StarterGear only.")
			backpackTool:Destroy()
		end

		if player:FindFirstChild("StarterGear") then
			local exists = false
			for _, child in ipairs(player.StarterGear:GetChildren()) do
				if child:GetAttribute("ToolId") == sourceTool.Name then
					exists = true
					break
				end
			end
			if not exists then
				gearTool.Parent = player.StarterGear
			else
				gearTool:Destroy()
			end
		else
			gearTool:Destroy()
		end

		markDirty(player)
	else
		warn("⚠️ [DATA] Invalid tool requested: " .. tostring(toolName))
	end
end

-- ----------------------------------------------------------------------------
-- 🏗️ LAYOUT RESTORATION
-- ----------------------------------------------------------------------------
local function acquirePadLock(lockId)
	if PadLocks[lockId] then return false end
	PadLocks[lockId] = true
	return true
end

local function releasePadLock(lockId)
	PadLocks[lockId] = nil
end

local function RestoreLayout(player, plot, layoutData)
	if not layoutData or not plot then return end
	if #layoutData > MAX_LAYOUT_SIZE then return end

	local padsFolder = plot:WaitForChild("Pads", 10)
	if not padsFolder then return end
	local placedCarsFolder = plot:FindFirstChild("PlacedCars") or Instance.new("Folder", plot)
	placedCarsFolder.Name = "PlacedCars"

	local validPads = {}
	for _, p in ipairs(padsFolder:GetChildren()) do validPads[p.Name] = true end
	local processedPads = {}
	local restoredCount = 0

	for _, data in ipairs(layoutData) do
		local toolName = data.Tool
		local padName = data.Pad
		if not validPads[padName] then continue end
		if processedPads[padName] then continue end

		local padObject = padsFolder[padName]
		local lockId = padObject:GetFullName()

		if not acquirePadLock(lockId) then
			task.wait(0.1)
			if not acquirePadLock(lockId) then continue end
		end
		processedPads[padName] = true

		local padPart = getMainPart(padObject)
		if padPart then
			local isOccupied = padPart:FindFirstChild("IsOccupied")
			if isOccupied and not isOccupied.Value then
				local realModelName = FindModelNameFromTool(toolName)
				if realModelName then
					local carModel = CarModels:FindFirstChild(realModelName, true)
					if carModel then
						local newCar = carModel:Clone()
						newCar:SetAttribute("OwnerUserId", player.UserId)
						newCar:SetAttribute("CarGUID", generateCarGUID(player))
						for _, p in pairs(newCar:GetDescendants()) do
							if p:IsA("BasePart") then p.Anchored = true; p.CanCollide = true end
						end
						local padTop = padPart.CFrame * CFrame.new(0, (padPart.Size.Y / 2) + 5, 0)
						newCar:PivotTo(padTop)
						newCar.Parent = placedCarsFolder

						isOccupied.Value = true
						local linked = padPart:FindFirstChild("LinkedCar") or Instance.new("ObjectValue", padPart)
						linked.Name = "LinkedCar"
						linked.Value = newCar

						if padPart:FindFirstChild("PlacePrompt") then padPart.PlacePrompt.Enabled = false end
						if padPart:FindFirstChild("PickupPrompt") then padPart.PickupPrompt.Enabled = true end
						restoredCount += 1
					end
				end
			end
		end
		releasePadLock(lockId)
		if _ % 5 == 0 then task.wait() end
	end

	if restoredCount > 0 then
		markDirty(player)
		print("🏗️ Restored " .. restoredCount .. " cars for " .. player.Name)
	end
end

local function toolMatchesId(tool, targetToolId)
	return tool
		and tool:IsA("Tool")
		and (
			tool.Name == targetToolId
			or tool.Name == targetToolId .. " Item"
			or tool:GetAttribute("ToolId") == targetToolId
			or tool:GetAttribute("ToolId") == targetToolId .. " Item"
		)
end

local function countMatchingTools(player, targetToolId)
	if not player or not targetToolId then return 0 end

	local total = 0
	local function scan(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			if toolMatchesId(child, targetToolId) then
				total += 1
			end
		end
	end

	scan(player:FindFirstChild("Backpack"))
	scan(player:FindFirstChild("StarterGear"))
	if player.Character then scan(player.Character) end

	return total
end

local function removeMatchingTools(player, targetToolId, requestedAmount)
	if not player or not targetToolId then return 0 end

	requestedAmount = math.max(1, tonumber(requestedAmount) or 1)
	local removedCount = 0

	local function removeFromContainer(container)
		if not container or removedCount >= requestedAmount then return end
		for _, child in ipairs(container:GetChildren()) do
			if removedCount >= requestedAmount then break end
			if toolMatchesId(child, targetToolId) then
				child:Destroy()
				removedCount += 1
			end
		end
	end

	removeFromContainer(player:FindFirstChild("Backpack"))
	removeFromContainer(player:FindFirstChild("StarterGear"))
	if player.Character then removeFromContainer(player.Character) end

	return removedCount
end

-- ----------------------------------------------------------------------------
-- 🔄 ADMIN API (BindableFunction)
-- ----------------------------------------------------------------------------
local AdminAPI = ServerStorage:FindFirstChild("TycoonAdminAPI")
if not AdminAPI then
	AdminAPI = Instance.new("BindableFunction")
	AdminAPI.Name = "TycoonAdminAPI"
	AdminAPI.Parent = ServerStorage
end

AdminAPI.OnInvoke = function(action, player, ...)
	if action == "ForceWipe" and player and SessionData[player] then
		SessionData[player].ExplicitClear = true
		if player:FindFirstChild("StarterGear") then player.StarterGear:ClearAllChildren() end
		if player:FindFirstChild("Backpack") then player.Backpack:ClearAllChildren() end
		markDirty(player)
		print("⚠️ FORCE WIPE INITIATED FOR: " .. player.Name)
		return true
	elseif action == "GiveTool" and player then
		local toolName, customAttributes = ...
		giveTool(player, toolName, customAttributes)
		return true
	elseif action == "RemoveTool" and player then
		local targetToolId, requestedAmount = ...
		if not targetToolId then return false end
		local removedCount = removeMatchingTools(player, targetToolId, requestedAmount)
		if removedCount < math.max(1, tonumber(requestedAmount) or 1) then
			return false, removedCount
		end
		markDirty(player)
		return true, removedCount
	elseif action == "MarkDirty" and player then
		markDirty(player)
		return true
	end
	return false
end

-- ----------------------------------------------------------------------------
-- 🗡️ LEGENDARY CRAFTING INVENTORY API (BindableFunction)
--
-- FIX: When RemoveTool succeeds (a sacrifice was consumed), we set
-- session.SacrificeOccurred = true. The save() function reads this flag
-- inside the UpdateAsync callback to skip the inventory anti-wipe check,
-- preventing the sacrificed items from being incorrectly restored.
-- The flag is intentionally NEVER reset — it stays true for the entire
-- session, because the legendary shop's persisted CraftProgress is the
-- source of truth for any future saves in the same session.
-- ----------------------------------------------------------------------------
local LegendaryCraftingInventoryAPI = ServerStorage:FindFirstChild("LegendaryCraftingInventoryFunction")
if not LegendaryCraftingInventoryAPI then
	LegendaryCraftingInventoryAPI = Instance.new("BindableFunction")
	LegendaryCraftingInventoryAPI.Name = "LegendaryCraftingInventoryFunction"
	LegendaryCraftingInventoryAPI.Parent = ServerStorage
end

LegendaryCraftingInventoryAPI.OnInvoke = function(action, player, ...)
	if not player then return false end

	if action == "HasTool" then
		local targetToolId, requiredAmount = ...
		if not targetToolId then return false, 0 end
		requiredAmount = math.max(1, tonumber(requiredAmount) or 1)
		local ownedCount = countMatchingTools(player, targetToolId)
		return ownedCount >= requiredAmount, ownedCount

	elseif action == "RemoveTool" then
		local targetToolId, requestedAmount = ...
		if not targetToolId then return false, 0 end

		requestedAmount = math.max(1, tonumber(requestedAmount) or 1)
		local removedCount = removeMatchingTools(player, targetToolId, requestedAmount)

		if removedCount < requestedAmount then
			return false, removedCount
		end

		-- ✅ FIX: Mark that a legitimate inventory reduction occurred this
		-- session so the anti-wipe in save() does not restore sacrificed items.
		local session = SessionData[player]
		if session then
			session.SacrificeOccurred = true
		end

		markDirty(player)
		return true, removedCount

	elseif action == "GiveTool" then
		local toolName, customAttributes = ...
		giveTool(player, toolName, customAttributes)
		return true

	elseif action == "MarkDirty" then
		markDirty(player)
		return true
	end

	return false
end

