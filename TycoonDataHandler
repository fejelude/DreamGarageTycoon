local function runFinalSave(player)
	local existing = FinalSaveStates[player]
	if existing then
		local startedAt = os.clock()
		while not existing.Done and os.clock() - startedAt < CLOSING_SAVE_LOCK_WAIT_SECONDS do
			task.wait(0.05)
		end
		if not existing.Done then return false end
		return existing.Success == true
	end

	local state = { Done = false, Success = false }
	FinalSaveStates[player] = state
	local session = SessionData[player]
	if session then session.Closing = true end
	player:SetAttribute("TycoonDataClosing", true)
	for attempt = 1, FINAL_SAVE_ATTEMPTS do
		state.Success = save(player, true, true) == true
		if state.Success then break end
		if attempt < FINAL_SAVE_ATTEMPTS then
			warn(string.format("[TycoonDataHandler] Final save retry %d/%d for %s after: %s",
				attempt + 1, FINAL_SAVE_ATTEMPTS, player.Name,
				tostring(session and session.LastSaveError or "unknown error")))
			task.wait(attempt)
		end
	end
	-- Do not close rank/shop sessions between retries: their in-memory state is
	-- required to build the next complete snapshot. Close only after all attempts.
	closePersistenceSessions(player)
	if state.Success and session then
		-- Keep ownership until the complete snapshot is durable and every subsystem
		-- has closed. A fast rejoin cannot open a second rank/shop session early.
		releaseProfileLeaseWithoutSave(session)
	end
	state.Done = true
	player:SetAttribute("DataSaved", state.Success == true)
	player:SetAttribute("DataSaveFinished", true)
	local completed = ServerStorage:FindFirstChild("TycoonSaveCompleted")
	if completed then completed:Fire(player.UserId, state.Success == true) end
	task.delay(60, function()
		if FinalSaveStates[player] == state then FinalSaveStates[player] = nil end
	end)
	return state.Success
end

Players.PlayerRemoving:Connect(function(player)
	player:SetAttribute("TycoonDataClosing", true)
	local pendingSaveTask = PendingCriticalSaveTasks[player]
	if pendingSaveTask then
		task.cancel(pendingSaveTask)
		PendingCriticalSaveTasks[player] = nil
	end
	local session = SessionData[player]
	if session and session.CriticalTransferToken then
		-- TransferTool spans two profile keys. Let its grant or compensation writes
		-- finish before this leave handler snapshots and destroys either session.
		local waitStarted = os.clock()
		while session.CriticalTransferToken
			and os.clock() - waitStarted < CLOSING_SAVE_LOCK_WAIT_SECONDS
		do
			task.wait(0.05)
		end
	end
	if session and not session.DataLoaded then
		releaseProfileLeaseWithoutSave(session)
		player:SetAttribute("DataSaved", false)
		player:SetAttribute("DataSaveFinished", true)
		local syncEvent = game.ServerStorage:FindFirstChild("TycoonSaveCompleted")
		if syncEvent then syncEvent:Fire(player.UserId, false) end
	else
		if session then
			runFinalSave(player)
		else
			player:SetAttribute("DataSaved", false)
			player:SetAttribute("DataSaveFinished", true)
			local syncEvent = game.ServerStorage:FindFirstChild("TycoonSaveCompleted")
			if syncEvent then syncEvent:Fire(player.UserId, false) end
		end
	end
	FreeRewardsClaimLocks[player] = nil
	SessionData[player] = nil
end)

game:BindToClose(function()
	local pending = 0
	local targets = {}
	for _, player in ipairs(Players:GetPlayers()) do targets[player] = true end
	for player in pairs(SessionData) do targets[player] = true end
	for player, state in pairs(FinalSaveStates) do if not state.Done then targets[player] = true end end
	for player in pairs(targets) do
		player:SetAttribute("TycoonDataClosing", true)
		pending += 1
		task.spawn(function()
			local ok, err = pcall(runFinalSave, player)
			if not ok then warn("[Shutdown] Final save failed: " .. tostring(err)) end
			pending -= 1
		end)
	end

	local startedAt = os.clock()
	while pending > 0 and os.clock() - startedAt < CLOSING_SAVE_LOCK_WAIT_SECONDS do
		task.wait(0.05)
	end
end)

