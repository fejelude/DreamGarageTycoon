local function getDailyRewardsDayKey(timestamp)
	return math.floor((tonumber(timestamp) or os.time()) / DAILY_REWARDS_SECONDS_PER_DAY)
end

local function defaultDailyRewardsClaimedDays()
	local claimedDays = {}
	for day = 1, 7 do
		claimedDays[tostring(day)] = false
	end
	return claimedDays
end

local function sanitizeDailyRewardsData(value)
	local data = type(value) == "table" and value or {}

	local currentDay = math.floor(tonumber(data.CurrentDay) or 1)
	if currentDay < 1 or currentDay > 7 then
		currentDay = 1
	end

	local lastClaimAt = math.max(0, math.floor(tonumber(data.LastClaimAt) or 0))
	local lastClaimDayKey = math.max(0, math.floor(tonumber(data.LastClaimDayKey) or 0))
	local awaitingCycleReset = data.AwaitingCycleReset == true
	local claimedDays = defaultDailyRewardsClaimedDays()

	if type(data.ClaimedDays) == "table" then
		for day = 1, 7 do
			local key = tostring(day)
			claimedDays[key] = data.ClaimedDays[key] == true or data.ClaimedDays[day] == true
		end
	end

	local todayKey = getDailyRewardsDayKey(os.time())

	-- Protect against corrupted/future timestamps while avoiding an extra same-day claim.
	if lastClaimDayKey > todayKey then
		lastClaimDayKey = todayKey
		lastClaimAt = math.max(lastClaimAt, os.time())
	end

	-- If the player completed Day 7 previously and it is now a new UTC day,
	-- reset the visible cycle before the DailyRewardsService/client reads it.
	if awaitingCycleReset and lastClaimDayKey ~= todayKey then
		currentDay = 1
		awaitingCycleReset = false
		claimedDays = defaultDailyRewardsClaimedDays()
	end

	return {
		CurrentDay = currentDay,
		LastClaimAt = lastClaimAt,
		LastClaimDayKey = lastClaimDayKey,
		AwaitingCycleReset = awaitingCycleReset,
		ClaimedDays = claimedDays,
	}
end

local function decodeDailyRewardsAttribute(player)
	local raw = player:GetAttribute(DAILY_REWARDS_STATE_ATTRIBUTE)
	if type(raw) ~= "string" or raw == "" then
		return sanitizeDailyRewardsData(nil)
	end

	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)

	if ok and type(decoded) == "table" then
		return sanitizeDailyRewardsData(decoded)
	end

	return sanitizeDailyRewardsData(nil)
end


-- ----------------------------------------------------------------------------
-- 💾 SAVING
-- ----------------------------------------------------------------------------
save = function(player, isClosing, force)
	local session = SessionData[player]
	if not session or not session.DataLoaded then return false end

	if session.IsSaving then
		local waitLimit = isClosing and CLOSING_SAVE_LOCK_WAIT_SECONDS or SAVE_LOCK_WAIT_SECONDS
		local startedWaiting = os.clock()
		while session.IsSaving and (os.clock() - startedWaiting < waitLimit) do
			task.wait(0.05)
		end
		if session.IsSaving then
			warn("[Save] Save request could not get lock for " .. player.Name .. "; keeping session dirty for retry.")
			session.IsDirty = true
			return false, "Save already in progress"
		end
	end

	if not force and not isClosing and (os.time() - session.LastSave < MIN_SAVE_INTERVAL) then return true end
	if not force and not session.IsDirty and not isClosing then return true end

	session.IsSaving = true
	local saveDirtyVersion = session.DirtyVersion or 0

	local saveSucceeded = false

	local function safeShopGet(bindableName, bindable, player)
		if not bindable then
			warn("⚠️ [TycoonDataHandler] " .. bindableName .. " missing during save for " .. player.Name .. "; preserving previous persisted state.")
			return false, nil
		end
		if not bindable:IsA("BindableFunction") then
			warn("⚠️ [TycoonDataHandler] " .. bindableName .. " is not a BindableFunction during save for " .. player.Name .. "; preserving previous persisted state.")
			return false, nil
		end

		local ok, data = pcall(function() return bindable:Invoke("Get", player) end)
		if ok and type(data) == "table" then
			return true, data
		end

		warn("⚠️ [TycoonDataHandler] " .. bindableName .. " Get failed during save for " .. player.Name .. ": " .. tostring(data) .. "; preserving previous persisted state.")
		return false, nil
	end

	local function executeSave()
		print("💾 Saving data for " .. player.Name .. "...")

		local currentUnlockedPad = player:GetAttribute("HighestUnlockedPad") or 1
		local currentBaseLevel = normalizeBaseLevel(player:GetAttribute("BaseLevel"))
		local currentOwnedBaseLevel = math.max(normalizeBaseLevel(player:GetAttribute("OwnedBaseLevel")), currentBaseLevel)
		local currentOwnedRaw = player:GetAttribute("OwnedBaseSkins") or "[]"
		local currentOwnedSkins = decodeJsonOrDefault(currentOwnedRaw, { "Default" }, player.Name .. ".OwnedBaseSkins")
		if type(currentOwnedSkins) ~= "table" then
			currentOwnedSkins = { "Default" }
		end
		local currentEquippedSkin = player:GetAttribute("EquippedSkin") or "Default"
		local currentOwnedAppearanceSkins = sanitizeOwnedAppearanceSkins(decodeJsonOrDefault(player:GetAttribute("OwnedAppearanceSkins") or "{}", {}, player.Name .. ".OwnedAppearanceSkins"))
		local currentEquippedLevel1Skin = sanitizeEquippedAppearanceSkin(player:GetAttribute("EquippedLevel1Skin"), currentOwnedAppearanceSkins, 1)
		local currentEquippedLevel2Skin = sanitizeEquippedAppearanceSkin(player:GetAttribute("EquippedLevel2Skin"), currentOwnedAppearanceSkins, 2)
		local currentRank = player:GetAttribute("Rank") or "Player"
		local currentInventorySlotBonus = math.max(0, math.floor(tonumber(player:GetAttribute("InventorySlotBonus")) or 0))
		local rankPersistenceBindable = ServerStorage:FindFirstChild("RankPersistenceFunction")
		local currentRankData = nil
		local currentRankDataAvailable = false
		if rankPersistenceBindable and rankPersistenceBindable:IsA("BindableFunction") then
			local ok, result = pcall(function() return rankPersistenceBindable:Invoke("Get", player) end)
			if ok and type(result) == "table" then
				currentRankData = result
				currentRankDataAvailable = true
			else
				warn("⚠️ [TycoonDataHandler] RankPersistenceFunction Get failed during save for " .. player.Name .. ": " .. tostring(result) .. "; preserving previous persisted rank state.")
			end
		elseif rankPersistenceBindable then
			warn("⚠️ [TycoonDataHandler] RankPersistenceFunction is not a BindableFunction during save for " .. player.Name .. "; preserving previous persisted rank state.")
		end

		-- 🎮 HOTBAR: snapshot current slot assignments from client-set attributes
		local currentHotbar = {}
		for i = 1, 6 do
			local v = player:GetAttribute("HotbarSlot" .. i)
			currentHotbar[i] = (v and v ~= "") and v or ""
		end

		local currentSettings = getSessionSettings(player)

		local currentTransferUsed = math.max(0, math.floor(tonumber(player:GetAttribute("BankTransferLimitUsed")) or 0))
		local currentTransferResetAt = math.max(0, math.floor(tonumber(player:GetAttribute("BankTransferLimitResetAt")) or 0))
		local currentRebirth = math.max(0, math.floor(tonumber(player:GetAttribute("Rebirth")) or 0))
		local currentOfflinePremiumPendingAmount = math.max(0, math.floor(tonumber(player:GetAttribute("OfflinePremiumPendingAmount")) or 0))
		local currentTabletDoublePendingAmount = math.max(0, math.floor(tonumber(player:GetAttribute("TabletDoublePendingAmount")) or 0))
		local currentIndexDiscovered = {}
		local currentExclusiveIndexDiscovered = {}
		local starterPackPurchased = session.StarterPackPurchased == true
		local starterPackPurchaseId = session.StarterPackPurchaseId
		local starterPackClearRequested = session.StarterPackClearRequested == true
		local starterPackReceipts = {}
		if type(session.StarterPackReceipts) == "table" then
			for receiptId, purchased in pairs(session.StarterPackReceipts) do
				if type(receiptId) == "string" and purchased == true then
					starterPackReceipts[receiptId] = true
				end
			end
		end
		local robuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
		local promoCodesRedeemed = sanitizePromoCodeHistory(session.PromoCodesRedeemed)
		do
			local raw = player:GetAttribute("IndexDiscoveredJson")
			if type(raw) == "string" and raw ~= "" then
				local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
				if ok and type(decoded) == "table" then
					local dedupe = {}
					for key, value in pairs(decoded) do
						local name = type(value) == "string" and value or (value == true and type(key) == "string" and key or nil)
						if name then
							local normalized = name:gsub(" Item$", "")
							if CarStats and CarStats.Cars and CarStats.Cars[normalized] then
								dedupe[normalized] = true
							end
						end
					end
					for name in pairs(dedupe) do table.insert(currentIndexDiscovered, name) end
					table.sort(currentIndexDiscovered)
				end
			end
		end
		do
			local raw = player:GetAttribute("IndexExclusiveDiscoveredJson")
			if type(raw) == "string" and raw ~= "" then
				local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
				if ok and type(decoded) == "table" then
					local dedupe = {}
					for key, value in pairs(decoded) do
						local name = type(value) == "string" and value or (value == true and type(key) == "string" and key or nil)
						local baseId = name and IndexConfig.NormalizeBaseCarId(name)
						if baseId and IndexConfig.IsSupportedExclusive(baseId) then dedupe[IndexConfig.GetExclusiveId(baseId)] = true end
					end
					for name in pairs(dedupe) do table.insert(currentExclusiveIndexDiscovered, name) end
					table.sort(currentExclusiveIndexDiscovered)
				end
			end
		end
		local currentDailyRewards = decodeDailyRewardsAttribute(player)
		local currentFreeRewardsClaimed = player:GetAttribute(FREE_REWARDS_CLAIMED_ATTRIBUTE) == true
		local currentTutorial = sanitizeTutorialData(session.Tutorial)

		if currentTransferResetAt > 0 and os.time() >= currentTransferResetAt then
			currentTransferUsed = 0
			currentTransferResetAt = 0
		end

		local inventory = {}
		local invCount = 0
		local seenInstances = {}

		local function scanContainer(container)
			if not container then return end
			for _, tool in pairs(container:GetChildren()) do
				if validateTool(tool) and not seenInstances[tool] then
					seenInstances[tool] = true
					if invCount < MAX_INVENTORY_SIZE then
						local id = tool:GetAttribute("ToolId")
						if id then
							table.insert(inventory, { ToolId = id, IsRobuxExclusive = tool:GetAttribute("IsRobuxExclusive") == true })
							invCount += 1
						end
					end
				end
			end
		end

		-- ✅ FIX (Held Tool Lost on Disconnect):
		-- Snapshot player.Character into a local now, before any yielding.
		-- If the character is already nil (destroyed before PlayerRemoving
		-- finished), fall back to session.HeldToolId which was cached by
		-- the CharacterRemoving listener set up in InitializePlayer.
		local characterRef = player.Character

		scanContainer(player:FindFirstChild("Backpack"))
		-- StarterGear intentionally excluded — within-session respawn mirror only.
		scanContainer(characterRef)

		if not characterRef and session.HeldToolId then
			local id = session.HeldToolId
			if safeFindCarTool(id) and invCount < MAX_INVENTORY_SIZE then
				local backpackCopies = 0
				for _, savedId in ipairs(inventory) do
					if savedId == id then backpackCopies += 1 end
				end
				local mirrorCopies = 0
				local starterGear = player:FindFirstChild("StarterGear")
				if starterGear then
					for _, mirror in ipairs(starterGear:GetChildren()) do
						if validateTool(mirror) and mirror:GetAttribute("ToolId") == id then mirrorCopies += 1 end
					end
				end
				-- StarterGear is a one-for-one ownership mirror. Only add the cached
				-- equipped copy when it is not already back in the Backpack; comparing
				-- counts preserves multiple identical cars instead of deduplicating by id.
				if mirrorCopies > backpackCopies then
					table.insert(inventory, id)
					invCount += 1
				end
			end
		end

		local layout = {}
		local plotName = player:GetAttribute("OccupiedPlot")
		local currentPendingInTycoon = 0
		local currentGarageIncomeRate = 0

		if plotName and TycoonFolder:FindFirstChild(plotName) then
			local plot = TycoonFolder[plotName]
			if plot:FindFirstChild("PendingEarnings") then
				currentPendingInTycoon = plot.PendingEarnings.Value
			end

			-- Snapshot the exact income rate the garage was producing while the
			-- player was online. TycoonEconomy writes CurrentCPS after all normal
			-- earnings multipliers, so OfflineEarningsService must use this saved
			-- rate directly instead of rebuilding and multiplying again on next join.
			currentGarageIncomeRate = math.max(0, tonumber(plot:GetAttribute("CurrentCPS")) or 0)
			local function savePadsInFolder(padsFolder)
				if not padsFolder then return end
				for _, padObject in pairs(padsFolder:GetChildren()) do
					local padPart = getMainPart(padObject)
					if padPart then
						local linked = padPart:FindFirstChild("LinkedCar")
						if linked and linked.Value then
							local car = linked.Value
							if car.Parent and car:IsDescendantOf(plot) then
								local isOwned = (car:GetAttribute("OwnerUserId") == player.UserId)
								if isOwned then
									local tName = FindToolNameFromModel(car.Name)
									if tName then
										table.insert(layout, { Tool = car:GetAttribute("BaseCarId") or tName, Pad = padObject.Name, IsRobuxExclusive = car:GetAttribute("IsRobuxExclusive") == true })
									end
								end
							end
						end
					end
				end
			end

			local playerBaseLevel = tonumber(player:GetAttribute("BaseLevel")) or 1
			local activeLevelFolder = nil

			if playerBaseLevel == 1 then
				activeLevelFolder = getLevelModel(plot, "Level1")
				if not activeLevelFolder then activeLevelFolder = plot:WaitForChild("NormalLevel1", 10) end
			elseif playerBaseLevel == 2 then
				activeLevelFolder = getLevelModel(plot, "Level2")
			end

			if activeLevelFolder then savePadsInFolder(getPadsFolder(plot, playerBaseLevel, activeLevelFolder)) end
		end

		-- [[ COMMON SHOP SYNC ]]
		local shopBindable = ServerStorage:FindFirstChild("ShopPersistenceFunction")
		local currentShopDataAvailable, currentShopData = safeShopGet("ShopPersistenceFunction", shopBindable, player)

		-- [[ 🟢 UNCOMMON SHOP SYNC ]]
		local uncommonShopBindable = ServerStorage:FindFirstChild("UncommonShopPersistenceFunction")
		local currentUncommonShopDataAvailable, currentUncommonShopData = safeShopGet("UncommonShopPersistenceFunction", uncommonShopBindable, player)

		-- [[ 🟣 RARE SHOP SYNC ]]
		local rareShopBindable = ServerStorage:FindFirstChild("RareShopPersistenceFunction")
		local currentRareShopDataAvailable, currentRareShopData = safeShopGet("RareShopPersistenceFunction", rareShopBindable, player)

		-- [[ 🟠 EPIC SHOP SYNC ]]
		local epicShopBindable = ServerStorage:FindFirstChild("EpicShopPersistenceFunction")
		local currentEpicShopDataAvailable, currentEpicShopData = safeShopGet("EpicShopPersistenceFunction", epicShopBindable, player)

		-- [[ 🟡 LEGENDARY SHOP SYNC ]]
		local legendaryShopBindable = ServerStorage:FindFirstChild("LegendaryShopPersistenceFunction")
		local currentLegendaryShopDataAvailable, currentLegendaryShopData = safeShopGet("LegendaryShopPersistenceFunction", legendaryShopBindable, player)

		-- [[ 🔴 MYTHICAL SHOP SYNC ]]
		local mythicalShopBindable = ServerStorage:FindFirstChild("MythicalShopPersistenceFunction")
		local currentMythicalShopDataAvailable, currentMythicalShopData = safeShopGet("MythicalShopPersistenceFunction", mythicalShopBindable, player)

		local sacrificeOccurredThisSession = session.SacrificeOccurred == true
		local intentionalEmptyInventory = session.IntentionalEmptyInventory == true
		local explicitClear = session.ExplicitClear == true
		local snapshotBank = MoneyManager.GetBalance(player, "Cash")
		local snapshotWallet = MoneyManager.GetBalance(player, "Wallet")
		local snapshotATM = MoneyManager.GetBalance(player, "ATMBalance")
		local snapshotOfflineTabletCarry = math.max(0, math.floor(tonumber(player:GetAttribute("OfflineTabletCarry")) or 0))
		local profileKey = session.ProfileKey
		local leaseToken = session.LeaseToken
		local leaseVersion = session.LeaseVersion
		local leaseAcquiredAt = session.LeaseAcquiredAt
		local savedAt = os.time()
		local staleWriterRejected = false

		for attempt = 1, MAX_RETRIES do
			staleWriterRejected = false
			local updateSuccess, updateResult = pcall(function()
				return PlayerDataStore:UpdateAsync(profileKey, function(oldData)
					staleWriterRejected = false
					oldData = type(oldData) == "table" and oldData or {}
					local storedLease = type(oldData[PROFILE_LEASE_FIELD]) == "table" and oldData[PROFILE_LEASE_FIELD] or nil
					if not storedLease
						or storedLease.Token ~= leaseToken
						or math.floor(tonumber(storedLease.Version) or 0) ~= leaseVersion
						or math.floor(tonumber(oldData[PROFILE_LEASE_VERSION_FIELD]) or 0) ~= leaseVersion
					then
						staleWriterRejected = true
						return nil
					end

					local storedInventory = type(oldData.Inventory) == "table" and oldData.Inventory or {}
					local storedLayout = type(oldData.Layout) == "table" and oldData.Layout or {}
					local finalInventory = inventory

					if #inventory == 0
						and #storedInventory > 0
						and not explicitClear
						and not sacrificeOccurredThisSession
					then
						warn("⚠️ Anti-Wipe (Inventory): Preserving for " .. player.Name)
						finalInventory = {}
						for _, storedItem in pairs(storedInventory) do
							local oldId = normalizeStoredToolId(storedItem)
							if safeFindCarTool(oldId) then
								table.insert(finalInventory, oldId)
							end
						end
					end

					local finalLayout = layout
					local isSuspiciousLayoutWipe = (#layout == 0) and (#storedLayout > 0)

					-- Fix 5: SacrificeOccurred Does Not Gate the Layout Anti-Wipe
					if isSuspiciousLayoutWipe and not explicitClear then
						local oldInvCount = #storedInventory
						local newInvCount = #finalInventory

						if newInvCount > oldInvCount then
							print("✅ Valid Pickup Detected. Saving empty layout.")
							finalLayout = layout
						else
							warn("⚠️ Anti-Wipe (Layout): Preserving for " .. player.Name)
							finalLayout = {}
							local seenPads = {}
							for _, oldEntry in pairs(storedLayout) do
								if type(oldEntry) == "table"
									and type(oldEntry.Tool) == "string"
									and type(oldEntry.Pad) == "string"
									and FindModelNameFromTool(oldEntry.Tool)
									and not seenPads[oldEntry.Pad]
								then
									seenPads[oldEntry.Pad] = true
									table.insert(finalLayout, oldEntry)
								end
							end
						end
					else
						finalLayout = layout
					end

					local finalPending = snapshotOfflineTabletCarry + currentPendingInTycoon

					oldData.Bank       = snapshotBank
					oldData.Wallet     = snapshotWallet
					oldData.ATMBalance = snapshotATM
					oldData.Inventory = finalInventory
					oldData.IntentionalEmptyInventory = intentionalEmptyInventory
					oldData.Layout = finalLayout
					oldData.PendingEarnings = finalPending
					oldData.OfflineEarningsRate = currentGarageIncomeRate

					if currentShopDataAvailable then oldData.ShopPurchases = currentShopData end
					if currentUncommonShopDataAvailable then oldData.UncommonShopPurchases = currentUncommonShopData end
					if currentRareShopDataAvailable then oldData.RareShopPurchases = currentRareShopData end
					if currentEpicShopDataAvailable then oldData.EpicShopPurchases = currentEpicShopData end
					if currentLegendaryShopDataAvailable then oldData.LegendaryShopPurchases = currentLegendaryShopData end
					if currentMythicalShopDataAvailable then oldData.MythicalShopPurchases = currentMythicalShopData end

					oldData.OwnedBaseSkins    = currentOwnedSkins
					oldData.EquippedSkin      = currentEquippedSkin
					oldData.OwnedAppearanceSkins = currentOwnedAppearanceSkins
					oldData.EquippedLevel1Skin = currentEquippedLevel1Skin
					oldData.EquippedLevel2Skin = currentEquippedLevel2Skin
					oldData.HighestUnlockedPad = currentUnlockedPad
					oldData.BaseLevel = currentBaseLevel
					oldData.OwnedBaseLevel = currentOwnedBaseLevel
					oldData.Rank = currentRank
					oldData.InventorySlotBonus = currentInventorySlotBonus
					if currentRankDataAvailable then oldData.RankData = currentRankData end
					oldData.HotbarSlots = currentHotbar
					oldData.BankTransferLimitUsed = currentTransferUsed
					oldData.BankTransferLimitResetAt = currentTransferResetAt
					oldData.Rebirth = currentRebirth
					oldData.OfflinePremiumPendingAmount = currentOfflinePremiumPendingAmount
					oldData.TabletDoublePendingAmount = currentTabletDoublePendingAmount
					oldData.IndexDiscovered = currentIndexDiscovered
					oldData.IndexExclusiveDiscovered = currentExclusiveIndexDiscovered
					oldData.DailyRewards = currentDailyRewards
					oldData.FreeRewardsClaimed = oldData.FreeRewardsClaimed == true or currentFreeRewardsClaimed
					if starterPackClearRequested then
						oldData.StarterPackPurchased = false
						oldData.StarterPackPurchaseId = nil
						oldData.StarterPackReceipts = {}
					else
						oldData.StarterPackPurchased = oldData.StarterPackPurchased == true or starterPackPurchased
						if type(oldData.StarterPackReceipts) ~= "table" then
							oldData.StarterPackReceipts = {}
						end
						for receiptId, purchased in pairs(starterPackReceipts) do
							if purchased == true then
								oldData.StarterPackReceipts[receiptId] = true
							end
						end
						if type(starterPackPurchaseId) == "string" and starterPackPurchaseId ~= "" then
							oldData.StarterPackPurchaseId = starterPackPurchaseId
						end
					end
					local mergedRobuxProductReceipts = sanitizeRobuxReceiptHistory(oldData.RobuxProductReceipts)
					for receiptId, receiptData in pairs(robuxProductReceipts) do
						mergedRobuxProductReceipts[receiptId] = receiptData
					end
					oldData.RobuxProductReceipts = compactRobuxReceiptHistory(mergedRobuxProductReceipts)
					oldData.PromoCodesRedeemed = sanitizePromoCodeHistory(oldData.PromoCodesRedeemed)
					for promoCode, promoData in pairs(promoCodesRedeemed) do
						oldData.PromoCodesRedeemed[promoCode] = oldData.PromoCodesRedeemed[promoCode] or promoData
					end
					oldData.Settings = currentSettings
					oldData.SettingsVersion = SETTINGS_SCHEMA_VERSION
					oldData.Tutorial = currentTutorial

					oldData.LastUpdated  = savedAt
					oldData.LastOfflineAt = savedAt
					oldData.DataVersion  = "V41_SessionLocked"
					oldData[PROFILE_LEASE_VERSION_FIELD] = leaseVersion
					oldData[PROFILE_LEASE_FIELD] = {
						Token = leaseToken,
						JobId = game.JobId,
						PlaceId = game.PlaceId,
						AcquiredAt = leaseAcquiredAt,
						Version = leaseVersion,
						ExpiresAt = savedAt + PROFILE_LEASE_SECONDS,
						UpdatedAt = savedAt,
					}

					return oldData
				end)
			end)

			if staleWriterRejected then
				session.LeaseLost = true
				error("Profile session lease no longer belongs to this server")
			end
			if updateSuccess and updateResult ~= nil then
				saveSucceeded = true
				return true
			end
			task.wait(0.35 * attempt)
		end
		error("UpdateAsync failed after retries")
	end

	local ok, saveErr = pcall(executeSave)
	if not ok then
		warn("❌ Save Failed " .. player.Name .. ": " .. tostring(saveErr))
	elseif isClosing then
		print("✅ Saved: " .. player.Name)
	end

	if saveSucceeded then
		if not isClosing then
			session.LeaseExpiresAt = os.time() + PROFILE_LEASE_SECONDS
		end
		local hasNewerDirtyState = (session.DirtyVersion or 0) ~= saveDirtyVersion
		session.IsDirty = hasNewerDirtyState
		session.LastSave = hasNewerDirtyState and 0 or os.time()
		if not hasNewerDirtyState then
			session.SacrificeOccurred = false
			session.ExplicitClear = false
			if session.StarterPackClearRequested then
				session.StarterPackSaveConfirmed = false
			else
				session.StarterPackSaveConfirmed = session.StarterPackPurchased == true
			end
			session.StarterPackClearRequested = false
		end
	end

	if isClosing then
		-- The final attempt has finished, so release subsystem sessions even when
		-- DataStore was unavailable. Keeping them after the Player leaves leaks one
		-- full shop/rank state per failed save for the rest of the server's life.
		local function safeClose(bindableName)
			local b = ServerStorage:FindFirstChild(bindableName)
			if not b then return end
			local ok2, err2 = pcall(function() b:Invoke("Close", player) end)
			if not ok2 then
				warn("⚠️ Shop cleanup error (" .. bindableName .. "): " .. tostring(err2))
			end
		end

		safeClose("ShopPersistenceFunction")
		safeClose("UncommonShopPersistenceFunction")
		safeClose("RareShopPersistenceFunction")
		safeClose("EpicShopPersistenceFunction")
		safeClose("LegendaryShopPersistenceFunction")
		safeClose("MythicalShopPersistenceFunction")
		safeClose("RankPersistenceFunction")
	end
	if isClosing and saveSucceeded then
		-- Keep the lease through subsystem cleanup. Clearing it inside the profile
		-- write let a fast rejoin load new shop sessions while the old server was
		-- still closing those same user-id keyed sessions.
		releaseProfileLeaseWithoutSave(session)
	end

	session.IsSaving = false

	if isClosing then
		player:SetAttribute("DataSaved", saveSucceeded == true)
		player:SetAttribute("DataSaveFinished", true)
		local syncEvent = game.ServerStorage:FindFirstChild("TycoonSaveCompleted")
		if syncEvent then syncEvent:Fire(player.UserId, saveSucceeded == true) end
	end
	if session.LeaseLost and player.Parent == Players then
		player:Kick("Your data session could not be kept safe. Please rejoin.")
	end
	return saveSucceeded
end

local function startLeaseRenewal(player)
	task.spawn(function()
		while player.Parent == Players do
			task.wait(PROFILE_LEASE_RENEW_INTERVAL)
			local session = SessionData[player]
			if not session or session.Closing or session.LeaseLost then return end

			local now = os.time()
			local rejected = false
			local ok, result = pcall(function()
				return PlayerDataStore:UpdateAsync(session.ProfileKey, function(current)
					rejected = false
					current = type(current) == "table" and current or {}
					local lease = type(current[PROFILE_LEASE_FIELD]) == "table" and current[PROFILE_LEASE_FIELD] or nil
					if not lease
						or lease.Token ~= session.LeaseToken
						or math.floor(tonumber(lease.Version) or 0) ~= session.LeaseVersion
						or math.floor(tonumber(current[PROFILE_LEASE_VERSION_FIELD]) or 0) ~= session.LeaseVersion
					then
						rejected = true
						return nil
					end

					lease.ExpiresAt = now + PROFILE_LEASE_SECONDS
					lease.UpdatedAt = now
					current[PROFILE_LEASE_FIELD] = lease
					return current
				end)
			end)

			if rejected then
				session.LeaseLost = true
				player:Kick("Your data session could not be kept safe. Please rejoin.")
				return
			elseif ok and result ~= nil then
				session.LeaseExpiresAt = now + PROFILE_LEASE_SECONDS
			elseif now >= (tonumber(session.LeaseExpiresAt) or 0) then
				session.LeaseLost = true
				player:Kick("Your data session could not be kept safe. Please rejoin.")
				return
			end
		end
	end)
end

releaseProfileLeaseWithoutSave = function(session)
	if not session or type(session.ProfileKey) ~= "string" or type(session.LeaseToken) ~= "string" then return false end
	local expectedVersion = math.floor(tonumber(session.LeaseVersion) or 0)
	for attempt = 1, MAX_RETRIES do
		local releasedOrNotOwned = false
		local ok = pcall(function()
			PlayerDataStore:UpdateAsync(session.ProfileKey, function(current)
				releasedOrNotOwned = false
				if type(current) ~= "table" then
					releasedOrNotOwned = true
					return current
				end

				local lease = type(current[PROFILE_LEASE_FIELD]) == "table" and current[PROFILE_LEASE_FIELD] or nil
				local ownsLease = lease
					and lease.Token == session.LeaseToken
					and (expectedVersion <= 0
						or (math.floor(tonumber(lease.Version) or 0) == expectedVersion
							and math.floor(tonumber(current[PROFILE_LEASE_VERSION_FIELD]) or 0) == expectedVersion))

				if ownsLease then current[PROFILE_LEASE_FIELD] = nil end
				releasedOrNotOwned = true
				return current
			end)
		end)
		if ok and releasedOrNotOwned then return true end
		task.wait(0.2 * attempt)
	end
	warn("[TycoonDataHandler] Could not release profile lease for " .. tostring(session.ProfileKey) .. "; it will expire automatically.")
	return false
end
-- ----------------------------------------------------------------------------
-- 🚪 PLAYER INITIALIZATION
-- ----------------------------------------------------------------------------
local function InitializePlayer(player)
	SessionData[player] = {
		LastSave          = os.time(),
		IsDirty           = false,
		DirtyVersion      = 0,
		DataLoaded        = false,
		ExplicitClear     = false,
		IsSaving          = false,
		SacrificeOccurred = false,
		IntentionalEmptyInventory = false,
		-- A reconnect to the same live server must still be a distinct profile
		-- session. Reusing a server+user token let a fast rejoin bypass its old
		-- session's lease while PlayerRemoving was still saving.
		LeaseToken        = SERVER_SESSION_TOKEN .. ":" .. tostring(player.UserId) .. ":" .. HttpService:GenerateGUID(false),
		LeaseLost         = false,
		LeaseExpiresAt    = 0,
		LeaseVersion      = 0,
		LeaseAcquiredAt   = 0,
		ProfileKey        = "User_V27_" .. player.UserId,
		Closing           = false,
		CriticalTransferToken = nil,
		-- ✅ FIX (Held Tool Lost on Disconnect): caches the ToolId of the
		-- tool the player was holding when their character was removed.
		-- Used as a fallback in save() if player.Character is already nil.
		HeldToolId        = nil,
		SettingsState     = sanitizeSettings(nil),
		StarterPackPurchased = false,
		StarterPackPurchaseId = nil,
		StarterPackReceipts = {},
		RobuxProductReceipts = {},
		StarterPackGrantInProgress = false,
		StarterPackSaveConfirmed = false,
		StarterPackClearRequested = false,
		WalletCashProductGrantInProgress = {},
		PromoCodesRedeemed = {},
		PromoCodeRedemptionInProgress = {},
	}

	-- Public ready flag used by DailyRewardsService so rewards cannot be claimed
	-- before this main data profile has finished loading.
	player:SetAttribute(DATA_READY_ATTRIBUTE, false)
	player:SetAttribute("DataSaved", false)
	player:SetAttribute("DataSaveFinished", false)

	-- ✅ FIX (Held Tool Lost on Disconnect):
	-- CharacterRemoving fires reliably before the character instance is
	-- destroyed, so we can safely read children here and cache the held tool.
	player.CharacterRemoving:Connect(function(character)
		local session = SessionData[player]
		if not session then return end
		session.HeldToolId = nil
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") and validateTool(child) then
				local id = child:GetAttribute("ToolId")
				if id then
					session.HeldToolId = id
					break -- a player can only hold one tool at a time
				end
			end
		end
	end)

	-- Clear the cache when a fresh character spawns so a stale value from
	-- a previous death never contaminates the next save snapshot.
	player.CharacterAdded:Connect(function()
		local session = SessionData[player]
		if session then session.HeldToolId = nil end
	end)

	local ls = Instance.new("Folder"); ls.Name = "leaderstats"; ls.Parent = player
	local hs = Instance.new("Folder"); hs.Name = "HiddenStats"; hs.Parent = player
	local cash   = Instance.new("NumberValue"); cash.Name   = "Cash";       cash.Parent   = hs
	local wallet = Instance.new("NumberValue"); wallet.Name = "Wallet";     wallet.Parent = ls
	local atm    = Instance.new("NumberValue"); atm.Name    = "ATMBalance"; atm.Parent    = ls

	local function setDirty() markDirty(player) end
	cash.Changed:Connect(setDirty)
	wallet.Changed:Connect(setDirty)
	atm.Changed:Connect(setDirty)

	local session = SessionData[player]
	local key = session.ProfileKey
	local data
	local loadSuccess = false
	local loadErr = nil
	local leaseDenied = false
	local loadStartedAt = os.clock()
	local attempt = 0
	while player.Parent == Players and os.clock() - loadStartedAt < PROFILE_LEASE_LOAD_TIMEOUT_SECONDS do
		attempt += 1
		leaseDenied = false
		loadSuccess, loadErr = pcall(function()
			local now = os.time()
			data = PlayerDataStore:UpdateAsync(key, function(current)
				leaseDenied = false
				current = type(current) == "table" and current or {}
				local lease = type(current[PROFILE_LEASE_FIELD]) == "table" and current[PROFILE_LEASE_FIELD] or nil
				local heartbeatAt = lease and math.max(
					math.floor(tonumber(lease.UpdatedAt) or 0),
					math.floor(tonumber(lease.AcquiredAt) or 0)
				) or 0
				local leaseIsFresh = lease
					and (tonumber(lease.ExpiresAt) or 0) > now
					and (heartbeatAt <= 0 or now - heartbeatAt < PROFILE_LEASE_STALE_SECONDS)
				if lease and lease.Token ~= session.LeaseToken and leaseIsFresh then
					leaseDenied = true
					return nil
				end

				if lease and lease.Token ~= session.LeaseToken then
					warn("[TycoonDataHandler] Recovering stale profile lease for " .. player.Name
						.. " (previous job " .. tostring(lease.JobId) .. ")")
				end

				local sameLease = lease and lease.Token == session.LeaseToken
				local storedVersion = math.max(
					math.floor(tonumber(current[PROFILE_LEASE_VERSION_FIELD]) or 0),
					math.floor(tonumber(lease and lease.Version) or 0)
				)
				local leaseVersion = sameLease and math.max(1, storedVersion) or math.max(1, storedVersion + 1)
				local acquiredAt = sameLease and math.max(0, math.floor(tonumber(lease.AcquiredAt) or now)) or now
				current[PROFILE_LEASE_FIELD] = {
					Token = session.LeaseToken,
					JobId = game.JobId,
					PlaceId = game.PlaceId,
					AcquiredAt = acquiredAt,
					Version = leaseVersion,
					ExpiresAt = now + PROFILE_LEASE_SECONDS,
					UpdatedAt = now,
				}
				current[PROFILE_LEASE_VERSION_FIELD] = leaseVersion
				return current
			end)
		end)

		if loadSuccess and data ~= nil then
			break
		end

		if leaseDenied then
			-- A quick reconnect normally lands here while PlayerRemoving is still
			-- saving in the old server. Keep the player in the loading state rather
			-- than kicking them into a rejoin loop. A healthy owner refreshes its
			-- heartbeat, while an abandoned lease eventually becomes recoverable.
			player:SetAttribute("ProfileSessionRecovering", true)
		else
			warn("⚠️ [TycoonDataHandler] Data load attempt " .. tostring(attempt) .. " failed for " .. player.Name .. ": " .. tostring(loadErr))
		end
		task.wait(PROFILE_LEASE_RETRY_INTERVAL_SECONDS)
	end

	player:SetAttribute("ProfileSessionRecovering", false)
	if leaseDenied then
		SessionData[player] = nil
		-- Reaching the deadline while the heartbeat is still fresh means another
		-- server really is using the profile. Taking it over would permit two
		-- writers, so this remains the one necessary active-session kick path.
		if player.Parent == Players then
			player:Kick("Your account is currently active in another server. Please leave that server before joining again.")
		end
		return
	end
	if not loadSuccess or data == nil then
		releaseProfileLeaseWithoutSave(session)
		SessionData[player] = nil
		player:Kick("Data Load Error. Rejoin.")
		return
	end
	local acquiredLease = type(data[PROFILE_LEASE_FIELD]) == "table" and data[PROFILE_LEASE_FIELD] or {}
	session.LeaseExpiresAt = math.floor(tonumber(acquiredLease.ExpiresAt) or (os.time() + PROFILE_LEASE_SECONDS))
	session.LeaseVersion = math.max(1, math.floor(tonumber(acquiredLease.Version) or 1))
	session.LeaseAcquiredAt = math.max(0, math.floor(tonumber(acquiredLease.AcquiredAt) or os.time()))
	if player.Parent ~= Players then
		releaseProfileLeaseWithoutSave(session)
		SessionData[player] = nil
		return
	end

	data = data or {
		Inventory = {}, Layout = {}, PendingEarnings = 0, HighestUnlockedPad = 1, BaseLevel = 1, OwnedBaseLevel = 1,
		ShopPurchases = {}, UncommonShopPurchases = {}, RareShopPurchases = {},
		EpicShopPurchases = {}, LegendaryShopPurchases = {}, MythicalShopPurchases = {},
		OwnedBaseSkins = { "Default" }, EquippedSkin = "Default", OwnedAppearanceSkins = { ["1"] = {}, ["2"] = {} }, EquippedLevel1Skin = BaseAppearanceConfig.DEFAULT_SKIN, EquippedLevel2Skin = BaseAppearanceConfig.DEFAULT_SKIN, Rank = "Player", RankData = {},
		Settings = sanitizeSettings(nil), SettingsVersion = SETTINGS_SCHEMA_VERSION, Rebirth = 0, IndexDiscovered = {}, IndexExclusiveDiscovered = {},
		OfflinePremiumPendingAmount = 0, TabletDoublePendingAmount = 0, InventorySlotBonus = 0,
		StarterPackPurchased = false, StarterPackPurchaseId = nil, StarterPackReceipts = {},
		RobuxProductReceipts = {},
		PromoCodesRedeemed = {},
		DailyRewards = sanitizeDailyRewardsData(nil), FreeRewardsClaimed = false,
		Tutorial = sanitizeTutorialData(nil)
	}

	do
		local sanitizedInventory = {}
		for _, storedItem in pairs(type(data.Inventory) == "table" and data.Inventory or {}) do
			if #sanitizedInventory >= MAX_INVENTORY_SIZE then break end
			local toolName = normalizeStoredToolId(storedItem)
			local storedExclusive = type(storedItem) == "table" and storedItem.IsRobuxExclusive == true
			if toolName and safeFindCarTool(toolName, storedExclusive) then
				table.insert(sanitizedInventory, type(storedItem) == "table" and { ToolId = toolName, IsRobuxExclusive = storedItem.IsRobuxExclusive == true } or toolName)
			end
		end
		data.Inventory = sanitizedInventory

		local sanitizedLayout, seenPads = {}, {}
		for _, entry in pairs(type(data.Layout) == "table" and data.Layout or {}) do
			if #sanitizedLayout >= MAX_LAYOUT_SIZE then break end
			local toolName = type(entry) == "table" and entry.Tool or nil
			local padName = type(entry) == "table" and entry.Pad or nil
			if type(toolName) == "string" and type(padName) == "string"
				and safeFindCarTool(toolName, entry.IsRobuxExclusive == true) and not seenPads[padName]
			then
				seenPads[padName] = true
				table.insert(sanitizedLayout, { Tool = toolName, Pad = padName, IsRobuxExclusive = entry.IsRobuxExclusive == true })
			end
		end
		data.Layout = sanitizedLayout
	end
	data.ShopPurchases          = type(data.ShopPurchases) == "table" and data.ShopPurchases or {}
	data.UncommonShopPurchases  = type(data.UncommonShopPurchases) == "table" and data.UncommonShopPurchases or {}
	data.RareShopPurchases      = type(data.RareShopPurchases) == "table" and data.RareShopPurchases or {}
	data.EpicShopPurchases      = type(data.EpicShopPurchases) == "table" and data.EpicShopPurchases or {}
	data.LegendaryShopPurchases = type(data.LegendaryShopPurchases) == "table" and data.LegendaryShopPurchases or {}
	data.MythicalShopPurchases  = type(data.MythicalShopPurchases) == "table" and data.MythicalShopPurchases or {}
	data.OwnedBaseSkins         = type(data.OwnedBaseSkins) == "table" and data.OwnedBaseSkins or { "Default" }
	data.EquippedSkin           = type(data.EquippedSkin) == "string" and data.EquippedSkin or "Default"
	data.OwnedAppearanceSkins  = sanitizeOwnedAppearanceSkins(data.OwnedAppearanceSkins)
	data.EquippedLevel1Skin    = sanitizeEquippedAppearanceSkin(data.EquippedLevel1Skin, data.OwnedAppearanceSkins, 1)
	data.EquippedLevel2Skin    = sanitizeEquippedAppearanceSkin(data.EquippedLevel2Skin, data.OwnedAppearanceSkins, 2)
	data.BaseLevel              = normalizeBaseLevel(data.BaseLevel)
	data.OwnedBaseLevel         = math.max(normalizeBaseLevel(data.OwnedBaseLevel), data.BaseLevel)
	data.Rank                   = type(data.Rank) == "string" and data.Rank or "Player"
	data.InventorySlotBonus     = math.max(0, math.floor(tonumber(data.InventorySlotBonus) or 0))
	data.RankData               = type(data.RankData) == "table" and data.RankData or {}
	data.BankTransferLimitUsed  = data.BankTransferLimitUsed  or 0
	data.BankTransferLimitResetAt = data.BankTransferLimitResetAt or 0
	data.Rebirth = math.max(0, math.floor(tonumber(data.Rebirth) or 0))
	data.OfflinePremiumPendingAmount = math.max(0, math.floor(tonumber(data.OfflinePremiumPendingAmount) or 0))
	data.TabletDoublePendingAmount = math.max(0, math.floor(tonumber(data.TabletDoublePendingAmount) or 0))
	data.IndexDiscovered = type(data.IndexDiscovered) == "table" and data.IndexDiscovered or {}
	data.IndexExclusiveDiscovered = type(data.IndexExclusiveDiscovered) == "table" and data.IndexExclusiveDiscovered or {}
	data.SettingsVersion = math.max(0, math.floor(tonumber(data.SettingsVersion) or 0))
	data.Settings = sanitizeSettings(data.Settings)
	data.StarterPackPurchased = data.StarterPackPurchased == true
	data.StarterPackPurchaseId = type(data.StarterPackPurchaseId) == "string" and data.StarterPackPurchaseId or nil
	data.StarterPackReceipts = type(data.StarterPackReceipts) == "table" and data.StarterPackReceipts or {}
	data.RobuxProductReceipts = compactRobuxReceiptHistory(data.RobuxProductReceipts)
	data.PromoCodesRedeemed = sanitizePromoCodeHistory(data.PromoCodesRedeemed)
	data.IntentionalEmptyInventory = data.IntentionalEmptyInventory == true
	data.DailyRewards = sanitizeDailyRewardsData(data.DailyRewards)
	data.FreeRewardsClaimed = data.FreeRewardsClaimed == true
	data.Tutorial = sanitizeTutorialData(data.Tutorial)
	data.LastOfflineAt = math.max(0, math.floor(tonumber(data.LastOfflineAt) or 0))
	data.OfflineEarningsRate = math.max(0, tonumber(data.OfflineEarningsRate) or 0)
	player:SetAttribute("LastOfflineAt", data.LastOfflineAt)
	player:SetAttribute("OfflineEarningsRate", data.OfflineEarningsRate)
	player:SetAttribute("OfflinePremiumPendingAmount", data.OfflinePremiumPendingAmount)
	player:SetAttribute("TabletDoublePendingAmount", data.TabletDoublePendingAmount)

	-- Migration: older saves could carry CarAnimationEnabled=false as a historical default
	-- rather than an explicit player choice. On first settings schema upgrade, normalize
	-- the default to ON so users only have animation disabled when they explicitly choose it.
	if data.SettingsVersion < SETTINGS_SCHEMA_VERSION then
		data.Settings.CarAnimationEnabled = true
		data.SettingsVersion = SETTINGS_SCHEMA_VERSION
	end

	local function sanitizeMoney(value)
		value = tonumber(value) or 0
		if value ~= value or value == math.huge or value == -math.huge then return 0 end
		return math.max(0, math.floor(value))
	end

	cash.Value   = sanitizeMoney(data.Bank)
	wallet.Value = sanitizeMoney(data.Wallet)
	atm.Value    = sanitizeMoney(data.ATMBalance)

	SessionData[player].SettingsState = sanitizeSettings(data.Settings)
	SessionData[player].StarterPackPurchased = data.StarterPackPurchased
	SessionData[player].StarterPackPurchaseId = data.StarterPackPurchaseId
	SessionData[player].StarterPackSaveConfirmed = data.StarterPackPurchased == true
	SessionData[player].StarterPackReceipts = {}
	SessionData[player].RobuxProductReceipts = compactRobuxReceiptHistory(data.RobuxProductReceipts)
	SessionData[player].PromoCodesRedeemed = sanitizePromoCodeHistory(data.PromoCodesRedeemed)
	SessionData[player].IntentionalEmptyInventory = data.IntentionalEmptyInventory
	SessionData[player].InventorySlotBonus = data.InventorySlotBonus
	player:SetAttribute("InventorySlotBonus", data.InventorySlotBonus)
	SessionData[player].Tutorial = data.Tutorial
	applyTutorialAttributes(player, data.Tutorial)
	for receiptId, purchased in pairs(data.StarterPackReceipts) do
		if type(receiptId) == "string" and purchased == true then
			SessionData[player].StarterPackReceipts[receiptId] = true
		end
	end
	if data.StarterPackPurchaseId then
		SessionData[player].StarterPackReceipts[data.StarterPackPurchaseId] = true
	end
	applySettingsAttributes(player, SessionData[player].SettingsState)

	local function safeShopLoad(bindableName, payload)
		local bindable = ServerStorage:FindFirstChild(bindableName)
		if not bindable then
			return
		end
		if not bindable:IsA("BindableFunction") then
			warn("⚠️ [TycoonDataHandler] " .. bindableName .. " exists but is not a BindableFunction. Skipping load.")
			return
		end
		local ok, err = pcall(function()
			bindable:Invoke("Load", player, payload)
		end)
		if not ok then
			warn("⚠️ [TycoonDataHandler] " .. bindableName .. " load failed for " .. player.Name .. ": " .. tostring(err))
		end
	end

	safeShopLoad("ShopPersistenceFunction", data.ShopPurchases)
	safeShopLoad("UncommonShopPersistenceFunction", data.UncommonShopPurchases)
	safeShopLoad("RareShopPersistenceFunction", data.RareShopPurchases)
	safeShopLoad("EpicShopPersistenceFunction", data.EpicShopPurchases)
	safeShopLoad("LegendaryShopPersistenceFunction", data.LegendaryShopPurchases)
	safeShopLoad("MythicalShopPersistenceFunction", data.MythicalShopPurchases)

	player:SetAttribute("HighestUnlockedPad", data.HighestUnlockedPad or 1)
	player:SetAttribute("BaseLevel", data.BaseLevel or 1)
	player:SetAttribute("OwnedBaseLevel", data.OwnedBaseLevel or data.BaseLevel or 1)
	local ownedJson = HttpService:JSONEncode(data.OwnedBaseSkins)
	player:SetAttribute("OwnedBaseSkins", ownedJson)
	player:SetAttribute("EquippedSkin", data.EquippedSkin)
	player:SetAttribute("OwnedAppearanceSkins", HttpService:JSONEncode(data.OwnedAppearanceSkins))
	player:SetAttribute("EquippedLevel1Skin", data.EquippedLevel1Skin)
	player:SetAttribute("EquippedLevel2Skin", data.EquippedLevel2Skin)
	player:SetAttribute("Rank", data.Rank)
	player:SetAttribute("Rebirth", data.Rebirth)
	player:SetAttribute("RebirthMultiplier", RebirthConfig.GetMultiplier(data.Rebirth))
	local discoveredSet = {}
	for key, value in pairs(data.IndexDiscovered) do
		local toolName = type(value) == "string" and value or (value == true and type(key) == "string" and key or nil)
		if toolName then
			local normalized = toolName:gsub(" Item$", "")
			if CarStats and CarStats.Cars and CarStats.Cars[normalized] then
				discoveredSet[normalized] = true
			end
		end
	end
	for _, toolName in pairs(data.Inventory) do
		if type(toolName) == "string" then
			local normalized = toolName:gsub(" Item$", "")
			if CarStats and CarStats.Cars and CarStats.Cars[normalized] then
				discoveredSet[normalized] = true
			end
		end
	end
	for _, layoutEntry in pairs(data.Layout) do
		local toolName = type(layoutEntry) == "table" and layoutEntry.Tool or nil
		if type(toolName) == "string" then
			local normalized = toolName:gsub(" Item$", "")
			if CarStats and CarStats.Cars and CarStats.Cars[normalized] then discoveredSet[normalized] = true end
		end
	end
	local discoveredList = {}
	for name in pairs(discoveredSet) do table.insert(discoveredList, name) end
	table.sort(discoveredList)
	player:SetAttribute("IndexDiscoveredJson", HttpService:JSONEncode(discoveredList))
	local exclusiveDiscoveredSet = {}
	for key, value in pairs(data.IndexExclusiveDiscovered) do
		local name = type(value) == "string" and value or (value == true and type(key) == "string" and key or nil)
		local baseId = name and IndexConfig.NormalizeBaseCarId(name)
		if baseId and IndexConfig.IsSupportedExclusive(baseId) then
			exclusiveDiscoveredSet[IndexConfig.GetExclusiveId(baseId)] = true
		end
	end
	-- Repair historical profiles from authoritative exclusive inventory/layout records.
	for _, record in pairs(data.Inventory) do
		if type(record) == "table" and record.IsRobuxExclusive == true then
			local baseId = IndexConfig.NormalizeBaseCarId(record.ToolId)
			if baseId and IndexConfig.IsSupportedExclusive(baseId) then
				exclusiveDiscoveredSet[IndexConfig.GetExclusiveId(baseId)] = true
				discoveredSet[baseId] = true
			end
		end
	end
	for _, record in pairs(data.Layout) do
		if type(record) == "table" and record.IsRobuxExclusive == true then
			local baseId = IndexConfig.NormalizeBaseCarId(record.Tool)
			if baseId and IndexConfig.IsSupportedExclusive(baseId) then
				exclusiveDiscoveredSet[IndexConfig.GetExclusiveId(baseId)] = true
				discoveredSet[baseId] = true
			end
		end
	end
	-- Re-encode Base after the exclusive migration may have added its counterpart.
	discoveredList = {}
	for name in pairs(discoveredSet) do table.insert(discoveredList, name) end
	table.sort(discoveredList)
	player:SetAttribute("IndexDiscoveredJson", HttpService:JSONEncode(discoveredList))
	local exclusiveDiscoveredList = {}
	for name in pairs(exclusiveDiscoveredSet) do table.insert(exclusiveDiscoveredList, name) end
	table.sort(exclusiveDiscoveredList)
	player:SetAttribute("IndexExclusiveDiscoveredJson", HttpService:JSONEncode(exclusiveDiscoveredList))
	player:SetAttribute(DAILY_REWARDS_STATE_ATTRIBUTE, HttpService:JSONEncode(data.DailyRewards))
	player:SetAttribute(FREE_REWARDS_CLAIMED_ATTRIBUTE, data.FreeRewardsClaimed == true)
	player:SetAttribute(PROMO_CODE_REDEEMED_ATTRIBUTE, HttpService:JSONEncode(SessionData[player].PromoCodesRedeemed))

	local transferUsed = math.max(0, math.floor(tonumber(data.BankTransferLimitUsed) or 0))
	local transferResetAt = math.max(0, math.floor(tonumber(data.BankTransferLimitResetAt) or 0))
	if transferResetAt > 0 and os.time() >= transferResetAt then
		transferUsed = 0
		transferResetAt = 0
	end
	player:SetAttribute("BankTransferLimitUsed", transferUsed)
	player:SetAttribute("BankTransferLimitResetAt", transferResetAt)

	local rankPersistenceBindable = ServerStorage:FindFirstChild("RankPersistenceFunction")
	if rankPersistenceBindable and rankPersistenceBindable:IsA("BindableFunction") then
		data.RankData.LegacyRank = data.Rank
		data.RankData.CurrentRank = data.RankData.CurrentRank or data.Rank
		local ok, rankErr = pcall(function()
			rankPersistenceBindable:Invoke("Load", player, data.RankData)
		end)
		if not ok then
			warn("⚠️ [TycoonDataHandler] RankPersistenceFunction load failed for " .. player.Name .. ": " .. tostring(rankErr))
		end
	elseif rankPersistenceBindable then
		warn("⚠️ [TycoonDataHandler] ServerStorage > RankPersistenceFunction exists but is not a BindableFunction.")
	end

	-- 🎮 HOTBAR: restore slot assignments so the client can read them
	local hotbarSlots = data.HotbarSlots or {}
	for i = 1, 6 do
		local v = hotbarSlots[i] or (hotbarSlots[tostring(i)] or "")
		player:SetAttribute("HotbarSlot" .. i, v)
	end

	player:GetAttributeChangedSignal("HighestUnlockedPad"):Connect(setDirty)
	player:GetAttributeChangedSignal("BaseLevel"):Connect(setDirty)
	player:GetAttributeChangedSignal("OwnedAppearanceSkins"):Connect(setDirty)
	player:GetAttributeChangedSignal("EquippedLevel1Skin"):Connect(setDirty)
	player:GetAttributeChangedSignal("EquippedLevel2Skin"):Connect(setDirty)
	player:GetAttributeChangedSignal("OwnedBaseLevel"):Connect(setDirty)
	player:GetAttributeChangedSignal("OwnedBaseSkins"):Connect(setDirty)
	player:GetAttributeChangedSignal("EquippedSkin"):Connect(setDirty)
	player:GetAttributeChangedSignal("Rank"):Connect(setDirty)
	player:GetAttributeChangedSignal("BankTransferLimitUsed"):Connect(setDirty)
	player:GetAttributeChangedSignal("BankTransferLimitResetAt"):Connect(setDirty)
	player:GetAttributeChangedSignal("Rebirth"):Connect(setDirty)
	player:GetAttributeChangedSignal("OfflinePremiumPendingAmount"):Connect(setDirty)
	player:GetAttributeChangedSignal("TabletDoublePendingAmount"):Connect(setDirty)
	player:GetAttributeChangedSignal("IndexDiscoveredJson"):Connect(setDirty)
	player:GetAttributeChangedSignal("IndexExclusiveDiscoveredJson"):Connect(setDirty)
	player:GetAttributeChangedSignal(DAILY_REWARDS_STATE_ATTRIBUTE):Connect(setDirty)
	for _, attributeName in pairs(PLAYER_SETTING_ATTRIBUTES) do
		player:GetAttributeChangedSignal(attributeName):Connect(function()
			local session = SessionData[player]
			if not session then return end
			for settingName, mappedAttribute in pairs(PLAYER_SETTING_ATTRIBUTES) do
				if mappedAttribute == attributeName then
					local value = player:GetAttribute(attributeName)
					if type(value) == "boolean" then
						session.SettingsState[settingName] = value
					end
					break
				end
			end
			setDirty()
		end)
	end
	for i = 1, 6 do
		player:GetAttributeChangedSignal("HotbarSlot" .. i):Connect(setDirty)
	end

	local function ApplyRankVisual()
		local SetRankAPI = ServerStorage:FindFirstChild("SetRankAPI")
		if SetRankAPI then
			SetRankAPI:Invoke(player, player:GetAttribute("Rank") or "Player")
		else
			warn("⚠️ SetRankAPI missing in ServerStorage")
		end
	end

	if player.Character then
		task.spawn(ApplyRankVisual)
	end
	player.CharacterAdded:Connect(ApplyRankVisual)

	if player:FindFirstChild("Backpack") then player.Backpack:ClearAllChildren() end
	if player:FindFirstChild("StarterGear") then player.StarterGear:ClearAllChildren() end

	if data.Inventory then
		for _, storedItem in pairs(data.Inventory) do
			local record = normalizeStoredCarRecord(storedItem)
			local toolName = record and record.ToolId
			if toolName then
				local restoreOk, restoreMessage = giveTool(player, toolName, {
					BypassStorageLimit = true, IsRobuxExclusive = record.IsRobuxExclusive,
					ExclusiveDisplayName = record.IsRobuxExclusive and ("Exclusive (" .. toolName:gsub(" Item$", "") .. ")") or nil,
					Source = "DataLoad", SuppressDirty = true, SuppressIndexMark = true,
				})
				if not restoreOk then
					warn("⚠️ [DATA] Failed to restore saved tool for " .. player.Name .. ": " .. tostring(toolName) .. " (" .. tostring(restoreMessage) .. ")")
				end
			end
		end
	end

	if #data.Inventory == 0 and (not data.Layout or #data.Layout == 0) and not data.IntentionalEmptyInventory then
		giveTool(player, STARTER_CAR_NAME)
	end

	sanitizeInventory(player)

	local loadedTabletCarry = math.max(0, math.floor(tonumber(data.PendingEarnings) or 0))
	player:SetAttribute("OfflineTabletCarry", loadedTabletCarry)

	if data.Layout and #data.Layout > 0 then
		local deadline = os.clock() + 20
		local plotName = player:GetAttribute("OccupiedPlot")
		while player.Parent == Players and not plotName and os.clock() < deadline do
			task.wait(0.1)
			plotName = player:GetAttribute("OccupiedPlot")
		end
		local plot = plotName and TycoonFolder:FindFirstChild(plotName) or nil
		if not plot or RestoreLayout(player, plot, data.Layout) ~= true then
			warn("⚠️ [TycoonDataHandler] Saved layout could not be restored safely for " .. player.Name)
			releaseProfileLeaseWithoutSave(session)
			SessionData[player] = nil
			if player.Parent == Players then player:Kick("Your garage could not be loaded safely. Please rejoin.") end
			return
		end
	end

	local function CheckAndRestorePending()
		-- Offline tablet carry is now claimed via OfflineEarningsService instead of restoring to plot immediately.
		return
	end

	player:GetAttributeChangedSignal("OccupiedPlot"):Connect(CheckAndRestorePending)
	CheckAndRestorePending()

	SessionData[player].DataLoaded = true
	player:SetAttribute(DATA_READY_ATTRIBUTE, true)
	startLeaseRenewal(player)
end

Players.PlayerAdded:Connect(function(player)
	local ok, err = pcall(InitializePlayer, player)
	if ok then return end
	warn("❌ [TycoonDataHandler] Player initialization failed for " .. player.Name .. ": " .. tostring(err))
	local session = SessionData[player]
	if session then releaseProfileLeaseWithoutSave(session) end
	SessionData[player] = nil
	if player.Parent == Players then player:Kick("Your data could not be loaded safely. Please rejoin.") end
end)

local function runFinalSave(player)
	local existing = FinalSaveStates[player]
	if existing then
		local startedAt = os.clock()
		while not existing.Done and os.clock() - startedAt < CLOSING_SAVE_LOCK_WAIT_SECONDS do
			task.wait(0.05)
		end
		return existing.Done and existing.Success == true
	end

	local state = { Done = false, Success = false }
	FinalSaveStates[player] = state
	local session = SessionData[player]
	if session then session.Closing = true end
	state.Success = save(player, true, true) == true
	state.Done = true
	task.delay(60, function()
		if FinalSaveStates[player] == state then FinalSaveStates[player] = nil end
	end)
	return state.Success
end

Players.PlayerRemoving:Connect(function(player)
	local pendingSaveTask = PendingCriticalSaveTasks[player]
	if pendingSaveTask then
		task.cancel(pendingSaveTask)
		PendingCriticalSaveTasks[player] = nil
	end
	local session = SessionData[player]
	if session and session.CriticalTransferToken then
		-- TransferTool spans two profile keys. Let its grant or compensation writes
		-- finish before this leave handler snapshots and destroys either session.
		local waitStarted = os.clock()
		while session.CriticalTransferToken
			and os.clock() - waitStarted < CLOSING_SAVE_LOCK_WAIT_SECONDS
		do
			task.wait(0.05)
		end
	end
	if session and not session.DataLoaded then
		releaseProfileLeaseWithoutSave(session)
		player:SetAttribute("DataSaved", false)
		player:SetAttribute("DataSaveFinished", true)
		local syncEvent = game.ServerStorage:FindFirstChild("TycoonSaveCompleted")
		if syncEvent then syncEvent:Fire(player.UserId, false) end
	else
		if session then
			runFinalSave(player)
		else
			player:SetAttribute("DataSaved", false)
			player:SetAttribute("DataSaveFinished", true)
			local syncEvent = game.ServerStorage:FindFirstChild("TycoonSaveCompleted")
			if syncEvent then syncEvent:Fire(player.UserId, false) end
		end
	end
	FreeRewardsClaimLocks[player] = nil
	SessionData[player] = nil
end)

game:BindToClose(function()
	local pending = 0
	for _, player in ipairs(Players:GetPlayers()) do
		pending += 1
		task.spawn(function()
			runFinalSave(player)
			pending -= 1
		end)
	end

	local startedAt = os.clock()
	while pending > 0 and os.clock() - startedAt < CLOSING_SAVE_LOCK_WAIT_SECONDS do
		task.wait(0.05)
	end
end)

task.spawn(function()
	while true do
		task.wait(10)
		local now = os.time()
		for _, player in pairs(Players:GetPlayers()) do
			local session = SessionData[player]
			if session and session.DataLoaded and session.IsDirty and not session.IsSaving
				and (now - session.LastSave >= AUTOSAVE_INTERVAL) then
				task.spawn(function() save(player, false) end)
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(25)
		for _, player in pairs(Players:GetPlayers()) do
			sanitizeInventory(player)
		end
	end
end)
