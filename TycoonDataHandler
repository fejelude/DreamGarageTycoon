local LegendaryCraftingInventoryAPI = getRequiredChild(ServerStorage, "LegendaryCraftingInventoryFunction", "BindableFunction", "ServerStorage > LegendaryCraftingInventoryFunction", REQUIRED_WAIT_SECONDS)

