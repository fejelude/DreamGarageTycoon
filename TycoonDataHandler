local function normalizeBaseLevel(value)
	local level = math.floor(tonumber(value) or 1)
	if level < 1 then return 1 end
	if level > 2 then return 2 end
	return level
end

local function isValidAppearanceSkin(skinId)
	return type(skinId) == "string" and BaseAppearanceConfig.Skins[skinId] ~= nil
end

local function sanitizeOwnedAppearanceSkins(raw)
	local sanitized = {}
	for level = 1, 2 do
		local key = tostring(level)
		sanitized[key] = {}
		local seen = {}
		local source = type(raw) == "table" and raw[key] or nil
		if type(source) == "table" then
			for _, skinId in ipairs(source) do
				if isValidAppearanceSkin(skinId) and not seen[skinId] then
					seen[skinId] = true
					table.insert(sanitized[key], skinId)
				end
			end
		end
	end
	return sanitized
end

local function ownsAppearanceSkin(owned, level, skinId)
	if skinId == BaseAppearanceConfig.DEFAULT_SKIN then
		return true
	end

	local list = type(owned) == "table" and owned[tostring(level)] or nil
	return type(list) == "table" and table.find(list, skinId) ~= nil
end

local function sanitizeEquippedAppearanceSkin(rawSkinId, owned, level)
	if rawSkinId == nil or rawSkinId == "" or rawSkinId == "Default" then
		return BaseAppearanceConfig.DEFAULT_SKIN
	end

	if type(rawSkinId) == "string" and ownsAppearanceSkin(owned, level, rawSkinId) then
		return rawSkinId
	end

	return BaseAppearanceConfig.DEFAULT_SKIN
end

local function sanitizeRobuxReceiptHistory(raw)
	local history = {}
	if type(raw) ~= "table" then
		return history
	end

	for receiptId, receiptData in pairs(raw) do
		if type(receiptId) == "string" and receiptId ~= "" then
			if type(receiptData) == "table" then
				history[receiptId] = {
					ToolId = type(receiptData.ToolId) == "string" and receiptData.ToolId or nil,
					ProductId = tonumber(receiptData.ProductId),
					GrantedAt = math.max(0, math.floor(tonumber(receiptData.GrantedAt) or 0)),
					Source = type(receiptData.Source) == "string" and receiptData.Source or nil,
					Action = type(receiptData.Action) == "string" and receiptData.Action or nil,
					Status = receiptData.Status == "Granted" and "Granted" or nil,
					TargetUserId = math.max(0, math.floor(tonumber(receiptData.TargetUserId) or 0)),
					GrantHash = type(receiptData.GrantHash) == "string" and string.sub(receiptData.GrantHash, 1, 200) or nil,
				}
			elseif receiptData == true then
				history[receiptId] = { GrantedAt = 0 }
			end
		end
	end

	return history
end

local function compactRobuxReceiptHistory(raw)
	local history = sanitizeRobuxReceiptHistory(raw)
	local entries = {}

	for receiptId, receiptData in pairs(history) do
		table.insert(entries, {
			ReceiptId = receiptId,
			Data = receiptData,
			GrantedAt = tonumber(receiptData.GrantedAt) or 0,
		})
	end

	table.sort(entries, function(a, b)
		if a.GrantedAt == b.GrantedAt then
			return a.ReceiptId > b.ReceiptId
		end
		return a.GrantedAt > b.GrantedAt
	end)

	local compact = {}
	for index, entry in ipairs(entries) do
		if index > MAX_ROBUX_RECEIPT_HISTORY then
			break
		end
		compact[entry.ReceiptId] = entry.Data
	end

	return compact
end

local function sanitizeAdminAuditLog(raw)
	local sanitized = {}
	if type(raw) ~= "table" then return sanitized end
	local startIndex = math.max(1, #raw - MAX_ADMIN_AUDIT_HISTORY + 1)
	for index = startIndex, #raw do
		local entry = raw[index]
		if type(entry) == "table" then
			table.insert(sanitized, {
				At = math.max(0, math.floor(tonumber(entry.At) or 0)),
				ActorUserId = math.max(0, math.floor(tonumber(entry.ActorUserId) or 0)),
				OperationId = type(entry.OperationId) == "string" and string.sub(entry.OperationId, 1, 100) or "",
				Action = type(entry.Action) == "string" and string.sub(entry.Action, 1, 40) or "Unknown",
				Reason = type(entry.Reason) == "string" and string.sub(entry.Reason, 1, 160) or "",
				Item = type(entry.Item) == "string" and string.sub(entry.Item, 1, 100) or "",
				Amount = math.max(0, math.floor(tonumber(entry.Amount) or 0)),
				Result = type(entry.Result) == "string" and string.sub(entry.Result, 1, 40) or "Unknown",
			})
		end
	end
	return sanitized
end

local function sanitizeOutgoingCarTransfers(raw)
	local sanitized = {}
	if type(raw) ~= "table" then return sanitized end
	local count = 0
	for operationId, entry in pairs(raw) do
		if count >= MAX_PLAYER_CAR_TRANSFERS then break end
		if validPersistentId(operationId) and type(entry) == "table"
			and validPersistentId(entry.ItemId) and type(entry.ToolId) == "string"
			and math.floor(tonumber(entry.ReceiverUserId) or 0) > 0
		then
			sanitized[operationId] = {
				ItemId = entry.ItemId,
				ToolId = string.sub(entry.ToolId, 1, 100),
				ReceiverUserId = math.floor(tonumber(entry.ReceiverUserId)),
				CreatedAt = math.max(0, math.floor(tonumber(entry.CreatedAt) or 0)),
			}
			count += 1
		end
	end
	return sanitized
end

