local function FindToolNameFromModel(modelName)
	local tool = safeFindCarTool(modelName)
	if tool then return tool.Name end

	if CarStats and CarStats.Cars then
		for internalID, stats in pairs(CarStats.Cars) do
			if stats.Name == modelName then
				local fallbackTool = safeFindCarTool(internalID)
				if fallbackTool then return fallbackTool.Name end
			end
		end
	end
	return nil
end

local function FindModelNameFromTool(toolName)
	local model = safeFindCarModel(toolName)
	if model then return model.Name end

	local clean = toolName:gsub(" Item", ""):gsub("Item", "")
	if CarStats and CarStats.Cars and CarStats.Cars[clean] then
		local stats = CarStats.Cars[clean]
		local fallbackModel = safeFindCarModel(stats.Name)
		if fallbackModel then return fallbackModel.Name end
	end
	return nil
end

local function getMainPart(obj)
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		if obj.PrimaryPart then return obj.PrimaryPart end
		for _, child in pairs(obj:GetChildren()) do
			if child:IsA("BasePart") and child.Name ~= "Border" then return child end
		end
		return obj:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

local function generateCarGUID(player)
	return player.UserId .. "_" .. HttpService:GenerateGUID(false)
end

-- ----------------------------------------------------------------------------
-- 🎁 GIVE TOOL
-- ----------------------------------------------------------------------------
-- Paired with the inventory client's revisioned acknowledgement protocol.
local HotbarPersistenceEvent = ReplicatedStorage:FindFirstChild("HotbarPersistenceEvent")
if HotbarPersistenceEvent and not HotbarPersistenceEvent:IsA("RemoteEvent") then error("Invalid HotbarPersistenceEvent") end
if not HotbarPersistenceEvent then
	HotbarPersistenceEvent = Instance.new("RemoteEvent")
	HotbarPersistenceEvent.Name = "HotbarPersistenceEvent"
	HotbarPersistenceEvent.Parent = ReplicatedStorage
end
local pendingHotbars, hotbarTasks, hotbarLastApplied = {}, {}, {}
local function applyHotbar(player)
	hotbarTasks[player] = nil
	local request = pendingHotbars[player]
	pendingHotbars[player] = nil
	local session = SessionData[player]
	if not request or not session or not session.DataLoaded or session.Closing or player.Parent ~= Players then return end
	if session.RespawnPending or not player:FindFirstChild("Backpack") then
		local current = {}
		for i=1,6 do current[i] = player:GetAttribute("HotbarSlot" .. i) or "" end
		HotbarPersistenceEvent:FireClient(player, current, request.Id)
		return
	end
	local owned, selected, seen = {}, {}, {}
	local containers = {player:FindFirstChild("Backpack")}
	if player.Character then table.insert(containers, player.Character) end
	for _, container in ipairs(containers) do
		for _, tool in ipairs(container:GetChildren()) do
			local issuedId = tool:GetAttribute("IssuedId")
			if validateTool(tool) and type(issuedId) == "string" and issuedId ~= "" and not seen[issuedId] then
				seen[issuedId] = true
				local base = CarStats.GetCarId(tool:GetAttribute("ToolId"))
				if base then
					local key = tool:GetAttribute("IsRobuxExclusive") == true and ("Exclusive (" .. base .. ")") or base
					owned[key] = (owned[key] or 0) + 1
				end
			end
		end
	end
	local accepted = {}
	for i=1,6 do
		local key = request.Slots[i]
		if key ~= "" and (selected[key] or 0) < (owned[key] or 0) then
			accepted[i] = key
			selected[key] = (selected[key] or 0) + 1
		else accepted[i] = "" end
		player:SetAttribute("HotbarSlot" .. i, accepted[i])
	end
	hotbarLastApplied[player] = os.clock()
	markDirty(player)
	HotbarPersistenceEvent:FireClient(player, accepted, request.Id)
end
HotbarPersistenceEvent.OnServerEvent:Connect(function(player, slots, id)
	local session = SessionData[player]
	if not session or not session.DataLoaded or session.Closing or type(slots) ~= "table"
		or type(id) ~= "number" or id ~= id or id % 1 ~= 0 or id < 0 or id > 1000000000 then return end
	local clean, count = {}, 0
	for key,value in pairs(slots) do
		count += 1
		if count > 6 or type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > 6
			or type(value) ~= "string" or #value > 128 then return end
		clean[key] = value
	end
	if count ~= 6 then return end
	pendingHotbars[player] = {Slots=clean, Id=id}
	if not hotbarTasks[player] then
		hotbarTasks[player] = task.delay(math.max(0, 0.15 - (os.clock() - (hotbarLastApplied[player] or 0))), applyHotbar, player)
	end
end)
Players.PlayerRemoving:Connect(function(player)
	if hotbarTasks[player] then task.cancel(hotbarTasks[player]) end
	hotbarTasks[player], pendingHotbars[player], hotbarLastApplied[player] = nil, nil, nil
end)

local function getCurrentInventoryCount(player)
	local count = 0
	local seen = {}
	local function scan(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Tool") and child:GetAttribute("ToolId") and not seen[child] then
				seen[child] = true
				count += 1
			end
		end
	end
	scan(player:FindFirstChild("Backpack"))
	if player.Character then scan(player.Character) end

	return count
end

local function canAddCarToStorage(player, amount)
	local session = SessionData[player]
	if not session or session.Closing then return false end
	if session and not session.DataLoaded then return true end
	if getCurrentInventoryCount(player) + math.max(1, tonumber(amount) or 1) > MAX_INVENTORY_SIZE then return false end
	amount = math.max(1, tonumber(amount) or 1)
	local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
	if rankApi then
		local ok, allowed = pcall(function() return rankApi:Invoke("CanAddCar", player, amount) end)
		if ok then return allowed == true end
	end

	local limit = tonumber(player:GetAttribute("RankStorageLimit")) or DEFAULT_CAR_STORAGE_LIMIT
	return getCurrentInventoryCount(player) + amount <= limit
end

local function giveTool(player, toolName, customAttributes)
	if not player or not player.Parent then return false, "Player missing" end
	local backpack = player:FindFirstChild("Backpack") or player:WaitForChild("Backpack", 5)
	if not backpack or player.Parent ~= Players then return false, "Backpack not loaded" end
	local receiptId = nil
	local receiptProductId = nil
	local receiptSource = nil
	if type(customAttributes) == "table" then
		local rawReceiptId = customAttributes.ReceiptPurchaseId or customAttributes.PurchaseId
		if rawReceiptId ~= nil then
			receiptId = tostring(rawReceiptId)
			if receiptId == "" then receiptId = nil end
		end
		receiptProductId = tonumber(customAttributes.ReceiptProductId)
		receiptSource = type(customAttributes.Source) == "string" and customAttributes.Source or nil
	end

	local session = SessionData[player]
	if receiptId then
		if not session or not session.DataLoaded then
			return false, "Player data not loaded"
		end
		session.RobuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
		if session.RobuxProductReceipts[receiptId] then
			return true, "Already granted", nil, nil, true
		end
	end

	local bypassStorageLimit = type(customAttributes) == "table"
		and (customAttributes.BypassStorageLimit == true or customAttributes.Source == "RobuxGift")
	if session and session.Closing then return false, "Player data is closing" end
	if getCurrentInventoryCount(player) >= MAX_INVENTORY_SIZE then return false, "Inventory safety limit reached" end
	if not bypassStorageLimit and not canAddCarToStorage(player, 1) then
		return false, "Car storage full"
	end
	local isExclusive = type(customAttributes) == "table" and customAttributes.IsRobuxExclusive == true
	local sourceTool = safeFindCarTool(toolName, isExclusive)
	if not sourceTool then
		local rec = FindToolNameFromModel(toolName)
		if rec then sourceTool = safeFindCarTool(rec, isExclusive) end
	end

	if sourceTool then
		local backpackTool = sourceTool:Clone()
		local gearTool = sourceTool:Clone()
		tagIssued(backpackTool, toolName)
		tagIssued(gearTool, toolName)
		gearTool:SetAttribute("IssuedId", backpackTool:GetAttribute("IssuedId"))

		if type(customAttributes) == "table" then
			for k, v in pairs(customAttributes) do
				if k ~= "BypassStorageLimit" then
					backpackTool:SetAttribute(k, v)
					gearTool:SetAttribute(k, v)
				end
			end
		end
		if isExclusive then
			local displayName = backpackTool:GetAttribute("ExclusiveDisplayName") or ("Exclusive (" .. toolName:gsub(" Item$", "") .. ")")
			backpackTool.Name = displayName
			gearTool.Name = displayName
		end

		backpackTool.Parent = backpack

		if player:FindFirstChild("StarterGear") then
			-- StarterGear is a one-for-one respawn mirror, not a set of unique car
			-- types. Keep one mirror for every owned copy so duplicate cars survive
			-- death without ever being counted again by persistence.
			gearTool.Parent = player.StarterGear
		else
			gearTool:Destroy()
		end

		if not (type(customAttributes) == "table" and customAttributes.SuppressDirty == true) then
			markDirty(player)
		end
		if session then session.IntentionalEmptyInventory = false end
		if not (type(customAttributes) == "table" and customAttributes.SuppressIndexMark == true) then
			markIndexDiscovered(player, sourceTool.Name, isExclusive)
		end
		if receiptId and session then
			session.RobuxProductReceipts[receiptId] = {
				ToolId = sourceTool.Name,
				ProductId = receiptProductId,
				GrantedAt = os.time(),
				Source = receiptSource,
			}
			session.RobuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
			markDirty(player)
		end
		return true, nil, backpackTool, gearTool
	else
		warn("⚠️ [DATA] Invalid tool requested: " .. tostring(toolName))
		return false, "Invalid tool"
	end
end

