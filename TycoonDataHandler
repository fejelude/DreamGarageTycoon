local function sanitizeTutorialData(raw)
	raw = type(raw) == "table" and raw or {}
	local stage = VALID_TUTORIAL_STAGES[raw.Stage] and raw.Stage or DEFAULT_TUTORIAL_DATA.Stage
	local completed, skipped = raw.Completed == true, raw.Skipped == true
	if completed then stage = "Completed" elseif skipped then stage = "Skipped" end
	-- Banking tutorial screens no longer have a valid gameplay action. Existing
	-- saves parked on any of them resume at the purchase introduction instead of
	-- being soft-locked behind a retired transfer or ATM objective.
	if stage == "Part5" or stage == "Part6" or stage == "Withdraw" then
		stage = "Part7"
	end
	return {
		Answered = raw.Answered == true or completed or skipped,
		Skipped = skipped, Active = raw.Active == true and not completed and not skipped,
		Stage = stage, Completed = completed, InventoryOpened = raw.InventoryOpened == true,
		TransferComplete = raw.TransferComplete == true,
		CarPlaced = raw.CarPlaced == true, EarningsClaimed = raw.EarningsClaimed == true,
		ATMWithdrawn = raw.ATMWithdrawn == true, LocalCarPurchased = raw.LocalCarPurchased == true,
		Revision = math.max(0, math.floor(tonumber(raw.Revision) or 0)),
	}
end

