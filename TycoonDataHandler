local function normalizeBaseLevel(value)
	local level = math.floor(tonumber(value) or 1)
	if level < 1 then return 1 end
	if level > 2 then return 2 end
	return level
end

local function isValidAppearanceSkin(skinId)
	return type(skinId) == "string" and BaseAppearanceConfig.Skins[skinId] ~= nil
end

local function sanitizeOwnedAppearanceSkins(raw)
	local sanitized = {}
	for level = 1, 2 do
		local key = tostring(level)
		sanitized[key] = {}
		local seen = {}
		local source = type(raw) == "table" and raw[key] or nil
		if type(source) == "table" then
			for _, skinId in ipairs(source) do
				if isValidAppearanceSkin(skinId) and not seen[skinId] then
					seen[skinId] = true
					table.insert(sanitized[key], skinId)
				end
			end
		end
	end
	return sanitized
end

local function ownsAppearanceSkin(owned, level, skinId)
	if skinId == BaseAppearanceConfig.DEFAULT_SKIN then
		return true
	end

	local list = type(owned) == "table" and owned[tostring(level)] or nil
	return type(list) == "table" and table.find(list, skinId) ~= nil
end

local function sanitizeEquippedAppearanceSkin(rawSkinId, owned, level)
	if rawSkinId == nil or rawSkinId == "" or rawSkinId == "Default" then
		return BaseAppearanceConfig.DEFAULT_SKIN
	end

	if type(rawSkinId) == "string" and ownsAppearanceSkin(owned, level, rawSkinId) then
		return rawSkinId
	end

	return BaseAppearanceConfig.DEFAULT_SKIN
end

local function sanitizeRobuxReceiptHistory(raw)
	local history = {}
	if type(raw) ~= "table" then
		return history
	end

	for receiptId, receiptData in pairs(raw) do
		if type(receiptId) == "string" and receiptId ~= "" then
			if type(receiptData) == "table" then
				history[receiptId] = {
					ToolId = type(receiptData.ToolId) == "string" and receiptData.ToolId or nil,
					ProductId = tonumber(receiptData.ProductId),
					GrantedAt = math.max(0, math.floor(tonumber(receiptData.GrantedAt) or 0)),
					Source = type(receiptData.Source) == "string" and receiptData.Source or nil,
					Action = type(receiptData.Action) == "string" and string.sub(receiptData.Action, 1, 80) or nil,
					TargetUserId = math.max(0, math.floor(tonumber(receiptData.TargetUserId) or 0)),
					GrantHash = type(receiptData.GrantHash) == "string" and string.sub(receiptData.GrantHash, 1, 200) or nil,
				}
			elseif receiptData == true then
				history[receiptId] = { GrantedAt = 0 }
			end
		end
	end

	return history
end

local function deepCopy(value)
	if type(value) ~= "table" then return value end
	local copied = {}
	for key, child in pairs(value) do copied[key] = deepCopy(child) end
	return copied
end

local function compactRobuxReceiptHistory(raw)
	local history = sanitizeRobuxReceiptHistory(raw)
	local entries = {}

	for receiptId, receiptData in pairs(history) do
		if receiptId:match("^Inbox:") then continue end
		table.insert(entries, {
			ReceiptId = receiptId,
			Data = receiptData,
			GrantedAt = tonumber(receiptData.GrantedAt) or 0,
		})
	end

	table.sort(entries, function(a, b)
		if a.GrantedAt == b.GrantedAt then
			return a.ReceiptId > b.ReceiptId
		end
		return a.GrantedAt > b.GrantedAt
	end)

	local compact = {}
	-- Never evict a claim whose mailbox acknowledgement has not committed.
	for id, record in pairs(history) do
		if id:match("^Inbox:") then compact[id] = record end
	end
	for index, entry in ipairs(entries) do
		if index > MAX_ROBUX_RECEIPT_HISTORY then
			break
		end
		compact[entry.ReceiptId] = entry.Data
	end

	return compact
end

local function sanitizeLuckySpinHistory(raw)
	local pending, completed = {}, {}
	for id, record in pairs(type(raw) == "table" and raw or {}) do
		if type(id) == "string" and type(record) == "table" then
			local copy = {RewardId = record.RewardId, GrantedAt = math.max(0, tonumber(record.GrantedAt) or 0), Claimed = record.Claimed == true}
			if copy.Claimed then table.insert(completed, {Id=id, Record=copy}) else pending[id] = copy end
		end
	end
	table.sort(completed, function(a,b) return a.Record.GrantedAt > b.Record.GrantedAt end)
	for i, item in ipairs(completed) do
		if i > MAX_LUCKY_SPIN_HISTORY then break end
		pending[item.Id] = item.Record
	end
	return pending
end

local function failSetup(message)
	error("[TycoonDataHandler] " .. message, 0)
end

local function getRequiredChild(parent, childName, className, pathForMessage, waitSeconds)
	if not parent then
		failSetup("Missing parent while looking for " .. tostring(pathForMessage or childName) .. ".")
	end

	local child = parent:FindFirstChild(childName)
	if not child and waitSeconds and waitSeconds > 0 then
		child = parent:WaitForChild(childName, waitSeconds)
	end

	local fullPath = pathForMessage or (parent:GetFullName() .. " > " .. childName)
	if not child then
		failSetup("Missing required instance: " .. fullPath .. ". Create it manually in Explorer; this script will not create it automatically.")
	end

	if className and not child:IsA(className) then
		failSetup("Invalid required instance: " .. fullPath .. " must be a " .. className .. ", but found " .. child.ClassName .. ".")
	end

	return child
end

local function decodeJsonOrDefault(rawValue, defaultValue, context)
	if type(rawValue) ~= "string" or rawValue == "" then
		return defaultValue
	end

	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(rawValue)
	end)

	if ok then
		return decoded
	end

	warn("⚠️ [TycoonDataHandler] Failed to decode JSON for " .. tostring(context or "unknown value") .. ": " .. tostring(decoded))
	return defaultValue
end

