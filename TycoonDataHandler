local function getDailyRewardsDayKey(timestamp)
	return math.floor((tonumber(timestamp) or os.time()) / DAILY_REWARDS_SECONDS_PER_DAY)
end

local function defaultDailyRewardsClaimedDays()
	local claimedDays = {}
	for day = 1, 7 do
		claimedDays[tostring(day)] = false
	end
	return claimedDays
end

local function sanitizeDailyRewardsData(value)
	local data = type(value) == "table" and value or {}

	local currentDay = math.floor(tonumber(data.CurrentDay) or 1)
	if currentDay < 1 or currentDay > 7 then
		currentDay = 1
	end

	local lastClaimAt = math.max(0, math.floor(tonumber(data.LastClaimAt) or 0))
	local lastClaimDayKey = math.max(0, math.floor(tonumber(data.LastClaimDayKey) or 0))
	local awaitingCycleReset = data.AwaitingCycleReset == true
	local claimedDays = defaultDailyRewardsClaimedDays()

	if type(data.ClaimedDays) == "table" then
		for day = 1, 7 do
			local key = tostring(day)
			claimedDays[key] = data.ClaimedDays[key] == true or data.ClaimedDays[day] == true
		end
	end

	local todayKey = getDailyRewardsDayKey(os.time())

	-- Protect against corrupted/future timestamps while avoiding an extra same-day claim.
	if lastClaimDayKey > todayKey then
		lastClaimDayKey = todayKey
		lastClaimAt = math.max(lastClaimAt, os.time())
	end

	-- If the player completed Day 7 previously and it is now a new UTC day,
	-- reset the visible cycle before the DailyRewardsService/client reads it.
	if awaitingCycleReset and lastClaimDayKey ~= todayKey then
		currentDay = 1
		awaitingCycleReset = false
		claimedDays = defaultDailyRewardsClaimedDays()
	end

	return {
		CurrentDay = currentDay,
		LastClaimAt = lastClaimAt,
		LastClaimDayKey = lastClaimDayKey,
		AwaitingCycleReset = awaitingCycleReset,
		ClaimedDays = claimedDays,
	}
end

local function decodeDailyRewardsAttribute(player)
	local raw = player:GetAttribute(DAILY_REWARDS_STATE_ATTRIBUTE)
	if type(raw) ~= "string" or raw == "" then
		return sanitizeDailyRewardsData(nil)
	end

	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)

	if ok and type(decoded) == "table" then
		return sanitizeDailyRewardsData(decoded)
	end

	return sanitizeDailyRewardsData(nil)
end


-- ----------------------------------------------------------------------------
-- 💾 SAVING
-- ----------------------------------------------------------------------------
local function saveWithinTransaction(player, isClosing, force)
	local session = SessionData[player]
	if not session or not session.DataLoaded then return false end
	if session.LeaseLost then return false, "Profile lease lost" end

	local saveGeneration = session.SaveGeneration or 0
	if isClosing then
		session.SaveGeneration = saveGeneration + 1
		saveGeneration = session.SaveGeneration
		session.Closing = true
		player:SetAttribute(DATA_PHASE_ATTRIBUTE, "Saving")
		player:SetAttribute("DataSaved", false)
	end

	if session.IsSaving then
		local waitLimit = isClosing and CLOSING_SAVE_LOCK_WAIT_SECONDS or SAVE_LOCK_WAIT_SECONDS
		local startedWaiting = os.clock()
		while session.IsSaving and (os.clock() - startedWaiting < waitLimit) do
			task.wait(0.05)
		end
		if session.IsSaving then
			warn("[Save] Save request could not get lock for " .. player.Name .. "; keeping session dirty for retry.")
			session.IsDirty = true
			return false, "Save already in progress"
		end
	end

	if not force and not isClosing and (os.time() - session.LastSave < MIN_SAVE_INTERVAL) then return true end
	if not force and not session.IsDirty and not isClosing then return true end

	session.IsSaving = true
	local saveDirtyVersion = session.DirtyVersion or 0

	local saveSucceeded = false
	local savedReceiptIds = {}

	local function safeShopGet(bindableName, bindable, player)
		if not bindable then
			warn("⚠️ [TycoonDataHandler] " .. bindableName .. " missing during save for " .. player.Name .. "; preserving previous persisted state.")
			return false, nil
		end
		if not bindable:IsA("BindableFunction") then
			warn("⚠️ [TycoonDataHandler] " .. bindableName .. " is not a BindableFunction during save for " .. player.Name .. "; preserving previous persisted state.")
			return false, nil
		end

		local ok, data = pcall(function() return bindable:Invoke("Get", player) end)
		if ok and type(data) == "table" then
			return true, data
		end

		warn("⚠️ [TycoonDataHandler] " .. bindableName .. " Get failed during save for " .. player.Name .. ": " .. tostring(data) .. "; preserving previous persisted state.")
		return false, nil
	end

	local function executeSave()
		print("💾 Saving data for " .. player.Name .. "...")

		local currentUnlockedPad = player:GetAttribute("HighestUnlockedPad") or 1
		local currentBaseLevel = normalizeBaseLevel(player:GetAttribute("BaseLevel"))
		local currentOwnedBaseLevel = math.max(normalizeBaseLevel(player:GetAttribute("OwnedBaseLevel")), currentBaseLevel)
		local currentOwnedRaw = player:GetAttribute("OwnedBaseSkins") or "[]"
		local currentOwnedSkins = decodeJsonOrDefault(currentOwnedRaw, { "Default" }, player.Name .. ".OwnedBaseSkins")
		if type(currentOwnedSkins) ~= "table" then
			currentOwnedSkins = { "Default" }
		end
		local currentEquippedSkin = player:GetAttribute("EquippedSkin") or "Default"
		local currentOwnedAppearanceSkins = sanitizeOwnedAppearanceSkins(decodeJsonOrDefault(player:GetAttribute("OwnedAppearanceSkins") or "{}", {}, player.Name .. ".OwnedAppearanceSkins"))
		local currentEquippedLevel1Skin = sanitizeEquippedAppearanceSkin(player:GetAttribute("EquippedLevel1Skin"), currentOwnedAppearanceSkins, 1)
		local currentEquippedLevel2Skin = sanitizeEquippedAppearanceSkin(player:GetAttribute("EquippedLevel2Skin"), currentOwnedAppearanceSkins, 2)
		local currentRank = player:GetAttribute("Rank") or "Player"
		local rankPersistenceBindable = ServerStorage:FindFirstChild("RankPersistenceFunction")
		local currentRankData = nil
		local currentRankDataAvailable = false
		if rankPersistenceBindable and rankPersistenceBindable:IsA("BindableFunction") then
			local ok, result = pcall(function() return rankPersistenceBindable:Invoke("Get", player) end)
			if ok and type(result) == "table" then
				currentRankData = result
				currentRankDataAvailable = true
			else
				warn("⚠️ [TycoonDataHandler] RankPersistenceFunction Get failed during save for " .. player.Name .. ": " .. tostring(result) .. "; preserving previous persisted rank state.")
			end
		elseif rankPersistenceBindable then
			warn("⚠️ [TycoonDataHandler] RankPersistenceFunction is not a BindableFunction during save for " .. player.Name .. "; preserving previous persisted rank state.")
		end

		-- 🎮 HOTBAR: snapshot current slot assignments from client-set attributes
		local currentHotbar = {}
		for i = 1, 6 do
			local v = player:GetAttribute("HotbarSlot" .. i)
			currentHotbar[i] = (v and v ~= "") and v or ""
		end

		local currentSettings = getSessionSettings(player)

		local currentTransferUsed = math.max(0, math.floor(tonumber(player:GetAttribute("BankTransferLimitUsed")) or 0))
		local currentTransferResetAt = math.max(0, math.floor(tonumber(player:GetAttribute("BankTransferLimitResetAt")) or 0))
		local currentTransferSkipCredits = math.max(0, math.min(100, math.floor(tonumber(player:GetAttribute("BankTransferSkipCredits")) or 0)))
		local currentRebirth = math.max(0, math.floor(tonumber(player:GetAttribute("Rebirth")) or 0))
		local currentIndexDiscovered = {}
		local starterPackPurchased = session.StarterPackPurchased == true
		local starterPackPurchaseId = session.StarterPackPurchaseId
		local starterPackClearRequested = session.StarterPackClearRequested == true
		local starterPackReceipts = {}
		if type(session.StarterPackReceipts) == "table" then
			for receiptId, purchased in pairs(session.StarterPackReceipts) do
				if type(receiptId) == "string" and purchased == true then
					starterPackReceipts[receiptId] = true
				end
			end
		end
		local robuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
		for receiptId in pairs(robuxProductReceipts) do savedReceiptIds[receiptId] = true end
		local promoCodesRedeemed = sanitizePromoCodeHistory(session.PromoCodesRedeemed)
		local intentionalEmptyInventory = session.IntentionalEmptyInventory == true
		local adminAuditLog = sanitizeAdminAuditLog(session.AdminAuditLog)
		local outgoingCarTransfers = sanitizeOutgoingCarTransfers(session.OutgoingCarTransfers)
		do
			local raw = player:GetAttribute("IndexDiscoveredJson")
			if type(raw) == "string" and raw ~= "" then
				local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
				if ok and type(decoded) == "table" then
					local dedupe = {}
					for _, name in ipairs(decoded) do
						if type(name) == "string" then
							local normalized = name:gsub(" Item$", "")
							if CarStats and CarStats.Cars and CarStats.Cars[normalized] then
								dedupe[normalized] = true
							end
						end
					end
					for name in pairs(dedupe) do table.insert(currentIndexDiscovered, name) end
					table.sort(currentIndexDiscovered)
				end
			end
		end
		local currentDailyRewards = decodeDailyRewardsAttribute(player)
		local currentFreeRewardsClaimed = player:GetAttribute(FREE_REWARDS_CLAIMED_ATTRIBUTE) == true
		local currentTutorial = sanitizeTutorialData(session.Tutorial)

		if currentTransferResetAt > 0 and os.time() >= currentTransferResetAt then
			currentTransferUsed = 0
			currentTransferResetAt = 0
		end

		local inventory = {}
		local invCount = 0
		local seenInstances = {}
		local seenItemIds = {}

		local function scanContainer(container)
			if not container then return end
			for _, tool in pairs(container:GetChildren()) do
				if validateTool(tool) and not seenInstances[tool] then
					seenInstances[tool] = true
					if invCount < MAX_INVENTORY_SIZE then
						local id = tool:GetAttribute("ToolId")
						local itemId = tool:GetAttribute("ItemId")
						if id and validPersistentId(itemId) and not seenItemIds[itemId] then
							seenItemIds[itemId] = true
							table.insert(inventory, { ToolId = id, ItemId = itemId })
							invCount += 1
						end
					end
				end
			end
		end

		-- ✅ FIX (Held Tool Lost on Disconnect):
		-- Snapshot player.Character into a local now, before any yielding.
		-- If the character is already nil (destroyed before PlayerRemoving
		-- finished), fall back to session.HeldToolId which was cached by
		-- the CharacterRemoving listener set up in InitializePlayer.
		local characterRef = player.Character

		scanContainer(player:FindFirstChild("Backpack"))
		-- StarterGear intentionally excluded — within-session respawn mirror only.
		scanContainer(characterRef)

		if not characterRef and type(session.HeldToolRecord) == "table" then
			local id = session.HeldToolRecord.ToolId
			local itemId = session.HeldToolRecord.ItemId
			if safeFindCarTool(id) and validPersistentId(itemId) and not seenItemIds[itemId] and invCount < MAX_INVENTORY_SIZE then
				seenItemIds[itemId] = true
				table.insert(inventory, { ToolId = id, ItemId = itemId })
					invCount += 1
			end
		end

		local layout = {}
		local plotName = player:GetAttribute("OccupiedPlot")
		local currentPendingInTycoon = 0
		local currentGarageIncomeRate = 0

		if plotName and TycoonFolder:FindFirstChild(plotName) then
			local plot = TycoonFolder[plotName]
			if plot:FindFirstChild("PendingEarnings") then
				currentPendingInTycoon = plot.PendingEarnings.Value
			end

			-- Snapshot the exact income rate the garage was producing while the
			-- player was online. TycoonEconomy writes CurrentCPS after all normal
			-- earnings multipliers, so OfflineEarningsService must use this saved
			-- rate directly instead of rebuilding and multiplying again on next join.
			currentGarageIncomeRate = finiteNumber(plot:GetAttribute("PermanentCPS"), 0, 0)
			local function savePadsInFolder(padsFolder)
				if not padsFolder then return end
				for _, padObject in pairs(padsFolder:GetChildren()) do
					local padPart = getMainPart(padObject)
					if padPart then
						local linked = padPart:FindFirstChild("LinkedCar")
						if linked and linked.Value then
							local car = linked.Value
							if car.Parent and car:IsDescendantOf(plot) then
								local isOwned = (car:GetAttribute("OwnerUserId") == player.UserId)
								if isOwned then
								local persistedToolId = car:GetAttribute("ToolId")
								local tName = type(persistedToolId) == "string" and safeFindCarTool(persistedToolId) and persistedToolId
									or FindToolNameFromModel(car.Name)
									if tName then
										local itemId = car:GetAttribute("ItemId")
										if validPersistentId(itemId) and seenItemIds[itemId] then
											warn("[TycoonDataHandler] Ignored duplicate live ItemId during save: " .. itemId)
											continue
										end
										if not validPersistentId(itemId) then
											itemId = generateItemId(player.UserId)
											car:SetAttribute("ItemId", itemId)
											car:SetAttribute("CarGUID", itemId)
										end
										seenItemIds[itemId] = true
										table.insert(layout, { Tool = tName, Pad = padObject.Name, ItemId = itemId })
									end
								end
							end
						end
					end
				end
			end

			local playerBaseLevel = tonumber(player:GetAttribute("BaseLevel")) or 1
			local activeLevelFolder = nil

			if playerBaseLevel == 1 then
				activeLevelFolder = getLevelModel(plot, "Level1")
				if not activeLevelFolder then activeLevelFolder = plot:WaitForChild("NormalLevel1", 10) end
			elseif playerBaseLevel == 2 then
				activeLevelFolder = getLevelModel(plot, "Level2")
			end

			if activeLevelFolder then savePadsInFolder(getPadsFolder(plot, playerBaseLevel, activeLevelFolder)) end
		end

		-- [[ COMMON SHOP SYNC ]]
		local shopBindable = ServerStorage:FindFirstChild("ShopPersistenceFunction")
		local currentShopDataAvailable, currentShopData = safeShopGet("ShopPersistenceFunction", shopBindable, player)

		-- [[ 🟢 UNCOMMON SHOP SYNC ]]
		local uncommonShopBindable = ServerStorage:FindFirstChild("UncommonShopPersistenceFunction")
		local currentUncommonShopDataAvailable, currentUncommonShopData = safeShopGet("UncommonShopPersistenceFunction", uncommonShopBindable, player)

		-- [[ 🟣 RARE SHOP SYNC ]]
		local rareShopBindable = ServerStorage:FindFirstChild("RareShopPersistenceFunction")
		local currentRareShopDataAvailable, currentRareShopData = safeShopGet("RareShopPersistenceFunction", rareShopBindable, player)

		-- [[ 🟠 EPIC SHOP SYNC ]]
		local epicShopBindable = ServerStorage:FindFirstChild("EpicShopPersistenceFunction")
		local currentEpicShopDataAvailable, currentEpicShopData = safeShopGet("EpicShopPersistenceFunction", epicShopBindable, player)

		-- [[ 🟡 LEGENDARY SHOP SYNC ]]
		local legendaryShopBindable = ServerStorage:FindFirstChild("LegendaryShopPersistenceFunction")
		local currentLegendaryShopDataAvailable, currentLegendaryShopData = safeShopGet("LegendaryShopPersistenceFunction", legendaryShopBindable, player)

		-- [[ 🔴 MYTHICAL SHOP SYNC ]]
		local mythicalShopBindable = ServerStorage:FindFirstChild("MythicalShopPersistenceFunction")
		local currentMythicalShopDataAvailable, currentMythicalShopData = safeShopGet("MythicalShopPersistenceFunction", mythicalShopBindable, player)

		-- Everything below is an immutable snapshot. The UpdateAsync callback must
		-- never read live Roblox instances because it may be retried later.
		local snapshotBank = math.floor(finiteNumber(MoneyManager.GetBalance(player, "Cash"), 0, 0))
		local snapshotWallet = math.floor(finiteNumber(MoneyManager.GetBalance(player, "Wallet"), 0, 0))
		local snapshotATM = math.floor(finiteNumber(MoneyManager.GetBalance(player, "ATMBalance"), 0, 0))
		local snapshotOfflineCarry = math.floor(finiteNumber(player:GetAttribute("OfflineTabletCarry"), 0, 0))
		local finalPending = snapshotOfflineCarry + math.floor(finiteNumber(currentPendingInTycoon, 0, 0))
		local leaseToken = session.LeaseToken
		local leaseVersion = session.LeaseVersion
		local leaseAcquiredAt = session.LeaseAcquiredAt
		local staleWriterRejected = false
		local savedAt = os.time()

		for attempt = 1, MAX_RETRIES do
			local updateSuccess, updateResult = pcall(function()
				return PlayerDataStore:UpdateAsync(session.ProfileKey, function(oldData)
					oldData = type(oldData) == "table" and oldData or {}
					local storedLease = type(oldData[PROFILE_LEASE_FIELD]) == "table" and oldData[PROFILE_LEASE_FIELD] or nil
					if not storedLease or storedLease.Token ~= leaseToken
						or math.floor(finiteNumber(storedLease.Version, 0, 0)) ~= leaseVersion
						or math.floor(finiteNumber(oldData[PROFILE_LEASE_VERSION_FIELD], 0, 0)) ~= leaseVersion
					then
						staleWriterRejected = true
						return nil
					end

					oldData.Bank       = snapshotBank
					oldData.Wallet     = snapshotWallet
					oldData.ATMBalance = snapshotATM
					oldData.Inventory = inventory
					oldData.Layout = layout
					oldData.IntentionalEmptyInventory = intentionalEmptyInventory
					oldData.AdminAuditLog = adminAuditLog
					oldData.OutgoingCarTransfers = outgoingCarTransfers
					oldData.PendingEarnings = finalPending
					oldData.OfflineEarningsRate = currentGarageIncomeRate

					if currentShopDataAvailable then oldData.ShopPurchases = currentShopData end
					if currentUncommonShopDataAvailable then oldData.UncommonShopPurchases = currentUncommonShopData end
					if currentRareShopDataAvailable then oldData.RareShopPurchases = currentRareShopData end
					if currentEpicShopDataAvailable then oldData.EpicShopPurchases = currentEpicShopData end
					if currentLegendaryShopDataAvailable then oldData.LegendaryShopPurchases = currentLegendaryShopData end
					if currentMythicalShopDataAvailable then oldData.MythicalShopPurchases = currentMythicalShopData end

					oldData.OwnedBaseSkins    = currentOwnedSkins
					oldData.EquippedSkin      = currentEquippedSkin
					oldData.OwnedAppearanceSkins = currentOwnedAppearanceSkins
					oldData.EquippedLevel1Skin = currentEquippedLevel1Skin
					oldData.EquippedLevel2Skin = currentEquippedLevel2Skin
					oldData.HighestUnlockedPad = currentUnlockedPad
					oldData.BaseLevel = currentBaseLevel
					oldData.OwnedBaseLevel = currentOwnedBaseLevel
					oldData.Rank = currentRank
					if currentRankDataAvailable then oldData.RankData = currentRankData end
					oldData.HotbarSlots = currentHotbar
					oldData.BankTransferLimitUsed = currentTransferUsed
					oldData.BankTransferLimitResetAt = currentTransferResetAt
					oldData.BankTransferSkipCredits = currentTransferSkipCredits
					oldData.Rebirth = currentRebirth
					oldData.IndexDiscovered = currentIndexDiscovered
					oldData.DailyRewards = currentDailyRewards
					oldData.FreeRewardsClaimed = oldData.FreeRewardsClaimed == true or currentFreeRewardsClaimed
					if starterPackClearRequested then
						oldData.StarterPackPurchased = false
						oldData.StarterPackPurchaseId = nil
						oldData.StarterPackReceipts = {}
					else
						oldData.StarterPackPurchased = oldData.StarterPackPurchased == true or starterPackPurchased
						if type(oldData.StarterPackReceipts) ~= "table" then
							oldData.StarterPackReceipts = {}
						end
						for receiptId, purchased in pairs(starterPackReceipts) do
							if purchased == true then
								oldData.StarterPackReceipts[receiptId] = true
							end
						end
						if type(starterPackPurchaseId) == "string" and starterPackPurchaseId ~= "" then
							oldData.StarterPackPurchaseId = starterPackPurchaseId
						end
					end
					local mergedRobuxProductReceipts = sanitizeRobuxReceiptHistory(oldData.RobuxProductReceipts)
					for receiptId, receiptData in pairs(robuxProductReceipts) do
						mergedRobuxProductReceipts[receiptId] = receiptData
					end
					oldData.RobuxProductReceipts = compactRobuxReceiptHistory(mergedRobuxProductReceipts)
					oldData.PromoCodesRedeemed = sanitizePromoCodeHistory(oldData.PromoCodesRedeemed)
					for promoCode, promoData in pairs(promoCodesRedeemed) do
						oldData.PromoCodesRedeemed[promoCode] = oldData.PromoCodesRedeemed[promoCode] or promoData
					end
					oldData.Settings = currentSettings
					oldData.SettingsVersion = SETTINGS_SCHEMA_VERSION
					oldData.Tutorial = currentTutorial

					oldData.LastUpdated  = savedAt
					oldData.LastOfflineAt = savedAt
					oldData.DataVersion  = "V41_SessionLockedItemLedger"
					oldData[PROFILE_LEASE_VERSION_FIELD] = leaseVersion
					if isClosing then
						oldData[PROFILE_LEASE_FIELD] = nil
					else
						oldData[PROFILE_LEASE_FIELD] = {
							Token = leaseToken,
							JobId = game.JobId,
							PlaceId = game.PlaceId,
							AcquiredAt = leaseAcquiredAt,
							Version = leaseVersion,
							ExpiresAt = savedAt + PROFILE_LEASE_SECONDS,
							UpdatedAt = savedAt,
						}
					end

					return oldData
				end)
			end)

			if staleWriterRejected then
				session.LeaseLost = true
				error("Profile session lease no longer belongs to this server")
			end
			if updateSuccess and updateResult ~= nil then
				saveSucceeded = true
				return true
			end
			task.wait(0.35 * attempt)
		end
		error("UpdateAsync failed after retries")
	end

	local ok, saveErr = pcall(executeSave)
	if not ok then
		warn("❌ Save Failed " .. player.Name .. ": " .. tostring(saveErr))
	elseif isClosing then
		print("✅ Saved: " .. player.Name)
	end

	if saveSucceeded then
		for receiptId in pairs(savedReceiptIds) do
			if not session.DurableReceipts[receiptId] then
				session.DurableReceipts[receiptId] = true
				emitDurableReceiptFeedback(player, session, receiptId)
			end
		end
		if not isClosing then
			session.LeaseExpiresAt = os.time() + PROFILE_LEASE_SECONDS
		end
		local hasNewerDirtyState = (session.DirtyVersion or 0) ~= saveDirtyVersion
		session.IsDirty = hasNewerDirtyState
		session.LastSave = hasNewerDirtyState and 0 or os.time()
		if not hasNewerDirtyState then
			session.SacrificeOccurred = false
			session.ExplicitClear = false
			if session.StarterPackClearRequested then
				session.StarterPackSaveConfirmed = false
			else
				session.StarterPackSaveConfirmed = session.StarterPackPurchased == true
			end
			session.StarterPackClearRequested = false
		end
	end

	if isClosing and saveSucceeded then
		local function safeClose(bindableName)
			local b = ServerStorage:FindFirstChild(bindableName)
			if not b then return end
			local ok2, err2 = pcall(function() b:Invoke("Close", player) end)
			if not ok2 then
				warn("⚠️ Shop cleanup error (" .. bindableName .. "): " .. tostring(err2))
			end
		end

		safeClose("ShopPersistenceFunction")
		safeClose("UncommonShopPersistenceFunction")
		safeClose("RareShopPersistenceFunction")
		safeClose("EpicShopPersistenceFunction")
		safeClose("LegendaryShopPersistenceFunction")
		safeClose("MythicalShopPersistenceFunction")
		safeClose("RankPersistenceFunction")
	end

	session.IsSaving = false

	local syncEvent = game.ServerStorage:FindFirstChild("TycoonSaveCompleted")
	if syncEvent then
		syncEvent:Fire(player.UserId, saveGeneration, saveSucceeded == true)
	end

	player:SetAttribute("DataSaved", saveSucceeded == true)
	if saveSucceeded and isClosing then
		player:SetAttribute(DATA_PHASE_ATTRIBUTE, "Saved")
	elseif isClosing then
		player:SetAttribute(DATA_PHASE_ATTRIBUTE, "SaveFailed")
	end
	return saveSucceeded
end

save = function(player, isClosing, force)
	return PlayerTransactionCoordinator.Run(player, isClosing and "FinalProfileSave" or "ProfileSave", function()
		return saveWithinTransaction(player, isClosing, force)
	end, isClosing and CLOSING_SAVE_LOCK_WAIT_SECONDS or SAVE_LOCK_WAIT_SECONDS)
end

local function startLeaseRenewal(player)
	task.spawn(function()
		while player.Parent == Players do
			task.wait(PROFILE_LEASE_RENEW_INTERVAL)
			local session = SessionData[player]
			if not session or session.Closing or session.LeaseLost then return end

			local now = os.time()
			local rejected = false
			local rejectionDetail = nil
			local renewed = false
			local lastRenewError = "UpdateAsync returned no result"

			for attempt = 1, MAX_RETRIES do
				rejected = false
				rejectionDetail = nil

				local ok, result = pcall(function()
					return PlayerDataStore:UpdateAsync(session.ProfileKey, function(current)
						-- UpdateAsync may rerun this transform. These flags must describe
						-- only the latest invocation, not an abandoned callback attempt.
						rejected = false
						rejectionDetail = nil
						current = type(current) == "table" and current or {}
						local lease = type(current[PROFILE_LEASE_FIELD]) == "table" and current[PROFILE_LEASE_FIELD] or nil
						local leaseVersion = math.floor(finiteNumber(lease and lease.Version, 0, 0))
						local rootVersion = math.floor(finiteNumber(current[PROFILE_LEASE_VERSION_FIELD], 0, 0))
						if not lease or lease.Token ~= session.LeaseToken
							or leaseVersion ~= session.LeaseVersion
							or rootVersion ~= session.LeaseVersion
						then
							rejected = true
							rejectionDetail = string.format(
								"lease mismatch (expected version %d; stored lease version %d; root version %d; stored JobId %s)",
								session.LeaseVersion,
								leaseVersion,
								rootVersion,
								tostring(lease and lease.JobId or "missing")
							)
							return nil
						end
						lease.JobId = game.JobId
						lease.PlaceId = game.PlaceId
						lease.AcquiredAt = session.LeaseAcquiredAt
						lease.Version = session.LeaseVersion
						lease.ExpiresAt = now + PROFILE_LEASE_SECONDS
						lease.UpdatedAt = now
						current[PROFILE_LEASE_FIELD] = lease
						current[PROFILE_LEASE_VERSION_FIELD] = session.LeaseVersion
						return current
					end)
				end)

				if rejected then
					break
				end
				if ok and result ~= nil then
					renewed = true
					break
				end

				lastRenewError = ok and "UpdateAsync returned no result" or tostring(result)
				if attempt < MAX_RETRIES then
					task.wait(0.35 * attempt)
				end
			end

			if rejected then
				session.LeaseLost = true
				player:SetAttribute(DATA_PHASE_ATTRIBUTE, "LeaseLost")
				kickForDataSafety(
					player,
					"DGT-LEASE-LOST",
					"Your data session could not be kept safe. Please rejoin.",
					rejectionDetail
				)
				return
			elseif renewed then
				session.LeaseExpiresAt = now + PROFILE_LEASE_SECONDS
			elseif now >= finiteNumber(session.LeaseExpiresAt, 0, 0) then
				session.LeaseLost = true
				player:SetAttribute(DATA_PHASE_ATTRIBUTE, "LeaseLost")
				kickForDataSafety(
					player,
					"DGT-LEASE-EXPIRED",
					"Your data session could not be renewed safely. Please rejoin.",
					lastRenewError
				)
				return
			else
				warn(string.format(
					"⚠️ [TycoonDataHandler][DGT-LEASE-RETRY] Lease renewal deferred for %s (%d); expires in %d seconds: %s",
					player.Name,
					player.UserId,
					math.max(0, finiteNumber(session.LeaseExpiresAt, now, 0) - now),
					lastRenewError
				))
			end
		end
	end)
end

local function releaseProfileLeaseWithoutSave(session)
	if not session or type(session.ProfileKey) ~= "string" or type(session.LeaseToken) ~= "string" then return end
	pcall(function()
		PlayerDataStore:UpdateAsync(session.ProfileKey, function(current)
			if type(current) ~= "table" then return current end
			local lease = type(current[PROFILE_LEASE_FIELD]) == "table" and current[PROFILE_LEASE_FIELD] or nil
			if lease and lease.Token == session.LeaseToken
				and math.floor(finiteNumber(lease.Version, 0, 0)) == session.LeaseVersion
				and math.floor(finiteNumber(current[PROFILE_LEASE_VERSION_FIELD], 0, 0)) == session.LeaseVersion
			then current[PROFILE_LEASE_FIELD] = nil end
			return current
		end)
	end)
end
