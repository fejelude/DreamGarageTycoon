local function FindToolNameFromModel(modelName)
	local tool = safeFindCarTool(modelName)
	if tool then return tool.Name end

	if CarStats and CarStats.Cars then
		local _, internalID = CarStats.GetCarStats(modelName)
		local fallbackTool = internalID and safeFindCarTool(internalID)
		if fallbackTool then return fallbackTool.Name end
	end
	return nil
end

local function FindModelNameFromTool(toolName)
	local model = safeFindCarModel(toolName)
	if model then return model.Name end

	local clean = toolName:gsub(" Item", ""):gsub("Item", "")
	if CarStats and CarStats.Cars and CarStats.Cars[clean] then
		local stats = CarStats.Cars[clean]
		local fallbackModel = safeFindCarModel(stats.Name)
		if fallbackModel then return fallbackModel.Name end
	end
	return nil
end

local function getMainPart(obj)
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		if obj.PrimaryPart then return obj.PrimaryPart end
		for _, child in pairs(obj:GetChildren()) do
			if child:IsA("BasePart") and child.Name ~= "Border" then return child end
		end
		return obj:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

local function generateCarGUID(player)
	return player.UserId .. "_" .. HttpService:GenerateGUID(false)
end

local function generateItemId(userId)
	return tostring(userId or 0) .. ":" .. HttpService:GenerateGUID(false)
end

local function sanitizeInventoryRecords(rawInventory, userId)
	local records = {}
	local seenItemIds = {}
	if type(rawInventory) ~= "table" then
		return records
	end

	for _, rawEntry in ipairs(rawInventory) do
		if #records >= MAX_INVENTORY_SIZE then break end
		local toolId
		local itemId
		if type(rawEntry) == "string" then
			toolId = rawEntry
		elseif type(rawEntry) == "table" then
			toolId = type(rawEntry.ToolId) == "string" and rawEntry.ToolId
				or (type(rawEntry.Tool) == "string" and rawEntry.Tool or nil)
			itemId = rawEntry.ItemId
		end

		if toolId and safeFindCarTool(toolId) then
			if validPersistentId(itemId) and seenItemIds[itemId] then
				warn("[TycoonDataHandler] Dropped duplicate persisted inventory ItemId " .. itemId)
				continue
			end
			if not validPersistentId(itemId) then
				itemId = generateItemId(userId)
			end
			seenItemIds[itemId] = true
			table.insert(records, { ToolId = toolId, ItemId = itemId })
		end
	end

	return records
end

local function sanitizeLayoutRecords(rawLayout, userId, occupiedItemIds)
	local records = {}
	local seenPads = {}
	local seenItemIds = occupiedItemIds or {}
	if type(rawLayout) ~= "table" then
		return records
	end

	for _, rawEntry in ipairs(rawLayout) do
		if #records >= MAX_LAYOUT_SIZE then break end
		if type(rawEntry) == "table" then
			local toolId = type(rawEntry.Tool) == "string" and rawEntry.Tool
				or (type(rawEntry.ToolId) == "string" and rawEntry.ToolId or nil)
			local pad = type(rawEntry.Pad) == "string" and rawEntry.Pad or nil
			local itemId = rawEntry.ItemId
			if toolId and pad and #pad <= 80 and not seenPads[pad] and safeFindCarTool(toolId) then
				if validPersistentId(itemId) and seenItemIds[itemId] then
					warn("[TycoonDataHandler] Dropped duplicate persisted layout ItemId " .. itemId)
					continue
				end
				if not validPersistentId(itemId) then
					itemId = generateItemId(userId)
				end
				seenPads[pad] = true
				seenItemIds[itemId] = true
				table.insert(records, { Tool = toolId, Pad = pad, ItemId = itemId })
			end
		end
	end

	return records
end

