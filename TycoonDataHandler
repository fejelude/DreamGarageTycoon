local function tagIssued(tool, originalName)
	if not tool then return end
	tool:SetAttribute("IssuedByServer", true)
	tool:SetAttribute("IssuedAt", os.time())
	tool:SetAttribute("IssuedId", HttpService:GenerateGUID(false))
	tool:SetAttribute("ToolId", originalName)
end

local function safeFindCarTool(targetName)
	if not targetName then return nil end
	local cleanName = targetName:gsub(" Item", ""):gsub("Item", "")

	for _, folderName in ipairs({"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic"}) do
		local folder = CarTools:FindFirstChild(folderName)
		if folder then
			for _, tool in ipairs(folder:GetChildren()) do
				if tool.Name == targetName or tool.Name == cleanName .. " Item" or tool.Name == cleanName then
					return tool
				end
			end
		end
	end
	return nil
end

local function safeFindCarModel(targetName)
	if not targetName then return nil end
	local cleanName = targetName:gsub(" Item", ""):gsub("Item", "")

	for _, folderName in ipairs({"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic"}) do
		local folder = CarModels:FindFirstChild(folderName)
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				if model.Name == targetName or model.Name == cleanName then
					return model
				end
			end
		end
	end
	return nil
end

local function validateTool(tool)
	if not tool then return false end
	if not tool:GetAttribute("IssuedByServer") then return false end
	local id = tool:GetAttribute("ToolId")
	if not id then return false end

	if safeFindCarTool(id) then return true end

	return false
end

-- Note (Fix 12): `StarterGear` acts as a respawn mirror. `sanitizeInventory` validates it to ensure
-- malicious tools can't persist across lives, while `save()` correctly ignores it to prevent quantity inflation.
local function sanitizeInventory(player)
	if not player then return end
	local containers = { player.Backpack, player:FindFirstChild("StarterGear") }

	for _, container in ipairs(containers) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") then
					if not tool:GetAttribute("ToolId") then
						logAdmin("Destroyed unauthorized tool (missing ToolId): " .. tool.Name, "WARN")
						tool:Destroy()
					elseif not validateTool(tool) then
						logAdmin("Destroyed unauthorized tool: " .. tool.Name, "WARN")
						tool:Destroy()
					else
						if tool.CanBeDropped then tool.CanBeDropped = false end
						local realId = tool:GetAttribute("ToolId")
						if realId and tool.Name ~= realId then
							tool.Name = realId
						end
					end
				end
			end
		end
	end
end

