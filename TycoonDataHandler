local function redeemPromoCode(player, code, codeInfo)
	if not save then
		return false, "Unable to redeem the code. Please try again."
	end

	code = tostring(code or "")
	if code == "" or type(codeInfo) ~= "table" then
		return false, "Invalid code!"
	end
	if codeInfo.OncePerPlayer ~= false and codeInfo.Enabled ~= true then
		return false, "Code is currently unavailable!"
	end
	if codeInfo.RewardType ~= "WalletCash" then
		return false, "Unable to redeem the code. Please try again."
	end

	local amount = math.max(0, math.floor(tonumber(codeInfo.RewardAmount) or 0))
	if amount <= 0 then
		return false, "Unable to redeem the code. Please try again."
	end

	local session = SessionData[player]
	if not session or not session.DataLoaded then
		return false, "Unable to redeem the code. Please try again."
	end

	session.PromoCodeRedemptionInProgress = session.PromoCodeRedemptionInProgress or {}
	if session.PromoCodeRedemptionInProgress[code] then
		return false, "Unable to redeem the code. Please try again."
	end
	session.PromoCodeRedemptionInProgress[code] = true

	local function finish(ok, message)
		session.PromoCodeRedemptionInProgress[code] = nil
		return ok, message
	end

	session.PromoCodesRedeemed = sanitizePromoCodeHistory(session.PromoCodesRedeemed)
	if codeInfo.OncePerPlayer ~= false and session.PromoCodesRedeemed[code] then
		return finish(false, "Code already claimed!")
	end

	local wallet = getWalletValue(player)
	if not wallet then
		return finish(false, "Unable to redeem the code. Please try again.")
	end

	local originalWallet = wallet.Value
	local originalRecord = session.PromoCodesRedeemed[code]
	wallet.Value = math.floor(finiteNumber(wallet.Value, 0, 0)) + amount
	session.PromoCodesRedeemed[code] = { RedeemedAt = os.time(), RewardType = codeInfo.RewardType, RewardAmount = amount }
	player:SetAttribute(PROMO_CODE_REDEEMED_ATTRIBUTE, HttpService:JSONEncode(session.PromoCodesRedeemed))
	markDirty(player)
	if not save(player, false, true) then
		wallet.Value = originalWallet
		session.PromoCodesRedeemed[code] = originalRecord
		player:SetAttribute(PROMO_CODE_REDEEMED_ATTRIBUTE, HttpService:JSONEncode(session.PromoCodesRedeemed))
		markDirty(player)
		return finish(false, "Unable to save the redeemed code. Please try again.")
	end

	return finish(true, codeInfo.SuccessMessage or "Code successfully redeemed!")
end

local function emitDurableReceiptFeedback(player, session, purchaseId)
	session.ReceiptFeedbackSent = session.ReceiptFeedbackSent or {}
	local receipt = session.RobuxProductReceipts[purchaseId]
	if type(receipt) ~= "table" then return end

	-- UI is advisory, but only emit it after the matching value and receipt are
	-- known durable. The in-session set prevents receipt retries from replaying it.
	if receipt.Source == "CashPack" and not session.ReceiptFeedbackSent[purchaseId] then
		local walletCash = math.max(0, math.floor(tonumber(receipt.GrantHash) or 0))
		if walletCash > 0 then
			player:SetAttribute("CashPackLastWalletReward", walletCash)
			player:SetAttribute("CashPackReceiptSerial", (tonumber(player:GetAttribute("CashPackReceiptSerial")) or 0) + 1)
		end
		session.ReceiptFeedbackSent[purchaseId] = true
	elseif receipt.Source == "AdReward" and not session.ReceiptFeedbackSent[purchaseId] then
		player:SetAttribute("AdRewardReceiptSerial", (tonumber(player:GetAttribute("AdRewardReceiptSerial")) or 0) + 1)
		session.ReceiptFeedbackSent[purchaseId] = true
	elseif receipt.Source == "RobuxPurchase" and not session.ReceiptFeedbackSent[purchaseId] then
		player:SetAttribute("ShopReceiptFeedbackKind", "Car")
		player:SetAttribute("ShopReceiptFeedbackProductId", tonumber(receipt.ProductId) or 0)
		player:SetAttribute("ShopReceiptFeedbackDisplayName", receipt.ToolId or "Car")
		player:SetAttribute("ShopReceiptFeedbackSerial", (tonumber(player:GetAttribute("ShopReceiptFeedbackSerial")) or 0) + 1)
		session.ReceiptFeedbackSent[purchaseId] = true
	elseif receipt.Source == "LimitedCarsShop" and not session.ReceiptFeedbackSent[purchaseId] then
		player:SetAttribute("LimitedCarReceiptSerial", (tonumber(player:GetAttribute("LimitedCarReceiptSerial")) or 0) + 1)
		session.ReceiptFeedbackSent[purchaseId] = true
	elseif (receipt.Source == "RobuxBaseSkin" or receipt.Source == "RobuxBaseAppearance")
		and not session.ReceiptFeedbackSent[purchaseId]
	then
		player:SetAttribute("BasePurchaseFeedbackKind", receipt.Source == "RobuxBaseSkin" and "Legacy" or "Appearance")
		player:SetAttribute("BasePurchaseFeedbackDisplayName", receipt.GrantHash or "Base skin")
		player:SetAttribute("BasePurchaseFeedbackSerial", (tonumber(player:GetAttribute("BasePurchaseFeedbackSerial")) or 0) + 1)
		session.ReceiptFeedbackSent[purchaseId] = true
	elseif receipt.Action == "ShopReroll" and not session.ReceiptFeedbackSent[purchaseId] then
		player:SetAttribute("ShopReceiptFeedbackKind", "Reroll")
		player:SetAttribute("ShopReceiptFeedbackProductId", tonumber(receipt.ProductId) or 0)
		player:SetAttribute("ShopReceiptFeedbackDisplayName", "Restock")
		player:SetAttribute("ShopReceiptFeedbackSerial", (tonumber(player:GetAttribute("ShopReceiptFeedbackSerial")) or 0) + 1)
		session.ReceiptFeedbackSent[purchaseId] = true
	elseif receipt.Action == "GiftQueued" and not session.ReceiptFeedbackSent[purchaseId] then
		local _, receiverName = tostring(receipt.GrantHash or ""):match("^Gift:([^:]+):([^:]+):")
		player:SetAttribute("GiftPurchaseFeedbackProductId", tonumber(receipt.ProductId) or 0)
		player:SetAttribute("GiftPurchaseFeedbackReceiver", receiverName or "Player")
		player:SetAttribute("GiftPurchaseFeedbackMessage", "Gift delivery committed")
		player:SetAttribute("GiftPurchaseFeedbackSuccess", true)
		player:SetAttribute("GiftPurchaseFeedbackSerial", (tonumber(player:GetAttribute("GiftPurchaseFeedbackSerial")) or 0) + 1)
		session.ReceiptFeedbackSent[purchaseId] = true
	elseif receipt.Action == "BankTransferReset" and not session.ReceiptFeedbackSent[purchaseId] then
		local message = receipt.GrantHash == "credit"
			and "Reset credit saved for your next capped transfer"
			or "Timer Reset Successful"
		player:SetAttribute("BankResetFeedbackMessage", message)
		player:SetAttribute("BankResetFeedbackSerial", (tonumber(player:GetAttribute("BankResetFeedbackSerial")) or 0) + 1)
		session.ReceiptFeedbackSent[purchaseId] = true
	elseif receipt.Source == "StarterPack" then
		session.StarterPackSaveConfirmed = true
		session.ReceiptFeedbackSent[purchaseId] = true
	end
end

local function grantWalletCashProduct(player, purchaseId, productId, walletCash, source, _notifyCashPack)
	if not save then
		return false, "Save system unavailable"
	end

	purchaseId = tostring(purchaseId or "")
	productId = tonumber(productId)
	walletCash = math.max(0, math.floor(tonumber(walletCash) or 0))
	source = type(source) == "string" and string.sub(source, 1, 80) or "CashPack"

	if purchaseId == "" then
		return false, "Missing purchase id"
	end
	if not productId or productId <= 0 or walletCash <= 0 then
		return false, "Invalid Cash Pack configuration"
	end

	local session = SessionData[player]
	if not session or not session.DataLoaded then
		return false, "Player data not loaded"
	end

	session.WalletCashProductGrantInProgress = session.WalletCashProductGrantInProgress or {}
	if session.WalletCashProductGrantInProgress[purchaseId] then
		return false, "Cash Pack grant already running"
	end
	session.WalletCashProductGrantInProgress[purchaseId] = true
	local function finish(ok, message)
		session.WalletCashProductGrantInProgress[purchaseId] = nil
		return ok, message
	end

	session.RobuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
	if not session.RobuxProductReceipts[purchaseId] then
		local wallet = getWalletValue(player)
		if not wallet then
			return finish(false, "Wallet not loaded")
		end

		wallet.Value += walletCash
		session.RobuxProductReceipts[purchaseId] = {
			ProductId = productId,
			GrantedAt = os.time(),
			Source = source,
			GrantHash = tostring(walletCash),
		}
		markDirty(player)
	end

	local saveOk = save(player, false, true)
	if not saveOk then
		return finish(false, "Cash Pack save failed")
	end
	session.DurableReceipts[purchaseId] = true
	-- Source-specific feedback is emitted only after the value and receipt share
	-- a successful profile save. Sources without UI feedback are a no-op here.
	emitDurableReceiptFeedback(player, session, purchaseId)

	return finish(true)
end

local function hasDurableReceiptGrant(player, purchaseId)
	purchaseId = tostring(purchaseId or "")
	local session = SessionData[player]
	if purchaseId == "" or not session or not session.DataLoaded then
		return nil, "Player data not loaded"
	end

	session.RobuxProductReceipts = compactRobuxReceiptHistory(session.RobuxProductReceipts)
	if not session.RobuxProductReceipts[purchaseId] then
		return false
	end
	if session.DurableReceipts[purchaseId] then
		emitDurableReceiptFeedback(player, session, purchaseId)
		return true
	end

	local saveOk = save(player, false, true)
	if saveOk then
		session.DurableReceipts[purchaseId] = true
		emitDurableReceiptFeedback(player, session, purchaseId)
		return true
	end
	return nil, "Receipt grant is not durable yet"
end

local function commitReceiptGrant(player, purchaseId, productId, action, targetUserId, grantHash)
	purchaseId = tostring(purchaseId or "")
	productId = math.floor(tonumber(productId) or 0)
	if purchaseId == "" or productId <= 0 then
		return false, "Invalid receipt"
	end

	local session = SessionData[player]
	if not session or not session.DataLoaded then
		return false, "Player data not loaded"
	end

	local existing = session.RobuxProductReceipts[purchaseId]
	local previousReceipt = type(existing) == "table" and table.clone(existing) or nil
	if type(existing) ~= "table" then
		session.RobuxProductReceipts[purchaseId] = {
			ProductId = productId,
			GrantedAt = os.time(),
			Source = "ReceiptRouter",
			Action = type(action) == "string" and string.sub(action, 1, 80) or nil,
			Status = "Granted",
			TargetUserId = math.max(0, math.floor(tonumber(targetUserId) or player.UserId)),
			GrantHash = type(grantHash) == "string" and string.sub(grantHash, 1, 200) or nil,
		}
	else
		existing.Status = "Granted"
		existing.ProductId = existing.ProductId or productId
		existing.GrantedAt = math.max(tonumber(existing.GrantedAt) or 0, os.time())
	end

	markDirty(player)
	local saveOk = save(player, false, true)
	if not saveOk then
		-- Callers roll back their live mutation when this commit fails. Restore
		-- the matching in-memory receipt too, otherwise a retry could save only
		-- the receipt and acknowledge a value that was already rolled back.
		session.RobuxProductReceipts[purchaseId] = previousReceipt
		session.DurableReceipts[purchaseId] = nil
		markDirty(player)
		return false, "Receipt save failed"
	end
	session.DurableReceipts[purchaseId] = true
	emitDurableReceiptFeedback(player, session, purchaseId)
	return true
end

local function grantLegacyBaseSkinProduct(player, purchaseId, productId, skinName, source)
	purchaseId = tostring(purchaseId or "")
	productId = math.floor(tonumber(productId) or 0)
	skinName = tostring(skinName or "")
	local configured = BaseSkinStats[skinName]
	if purchaseId == "" or productId <= 0 or type(configured) ~= "table"
		or math.floor(tonumber(configured.ProductId) or 0) ~= productId
	then
		return false, "Invalid base skin receipt"
	end
	local session = SessionData[player]
	if not session or not session.DataLoaded then return false, "Player data not loaded" end
	local existing = session.RobuxProductReceipts[purchaseId]
	if existing then return hasDurableReceiptGrant(player, purchaseId) end

	local owned = decodeJsonOrDefault(player:GetAttribute("OwnedBaseSkins") or "[]", { "Default" }, "OwnedBaseSkins")
	if type(owned) ~= "table" then owned = { "Default" } end
	local wallet = getWalletValue(player)
	local oldWallet = wallet and wallet.Value or nil
	if table.find(owned, skinName) then
		local compensation = math.max(0, math.floor(tonumber(configured.PriceCash) or 0))
		if compensation <= 0 or not wallet then return false, "Repeat-purchase compensation unavailable" end
		wallet.Value += compensation
	else
		table.insert(owned, skinName)
	end
	local oldOwned = player:GetAttribute("OwnedBaseSkins")
	local oldEquipped = player:GetAttribute("EquippedSkin")
	player:SetAttribute("OwnedBaseSkins", HttpService:JSONEncode(owned))
	player:SetAttribute("EquippedSkin", skinName)
	session.RobuxProductReceipts[purchaseId] = {
		ProductId = productId,
		GrantedAt = os.time(),
		Source = source == "RobuxGiftBaseSkin" and source or "RobuxBaseSkin",
		Action = "GrantLegacyBaseSkin",
		Status = "Granted",
		TargetUserId = player.UserId,
		GrantHash = skinName,
	}
	markDirty(player)
	if not save(player, false, true) then
		player:SetAttribute("OwnedBaseSkins", oldOwned)
		player:SetAttribute("EquippedSkin", oldEquipped)
		if wallet and oldWallet ~= nil then wallet.Value = oldWallet end
		session.RobuxProductReceipts[purchaseId] = nil
		session.DurableReceipts[purchaseId] = nil
		markDirty(player)
		return false, "Base skin save failed"
	end
	session.DurableReceipts[purchaseId] = true
	return true
end

local function grantBaseAppearanceProduct(player, purchaseId, productId, level, skinId, source)
	purchaseId = tostring(purchaseId or "")
	productId = math.floor(tonumber(productId) or 0)
	level = math.floor(tonumber(level) or 0)
	skinId = tostring(skinId or "")
	local configured = BaseAppearanceConfig.Get(level, skinId)
	if purchaseId == "" or productId <= 0 or not configured
		or math.floor(tonumber(configured.ProductId) or 0) ~= productId
	then return false, "Invalid base appearance receipt" end
	local session = SessionData[player]
	if not session or not session.DataLoaded then return false, "Player data not loaded" end
	if session.RobuxProductReceipts[purchaseId] then return hasDurableReceiptGrant(player, purchaseId) end

	local oldOwnedRaw = player:GetAttribute("OwnedAppearanceSkins")
	local owned = sanitizeOwnedAppearanceSkins(decodeJsonOrDefault(oldOwnedRaw or "{}", {}, "OwnedAppearanceSkins"))
	local key = tostring(level)
	owned[key] = type(owned[key]) == "table" and owned[key] or {}
	local wallet = getWalletValue(player)
	local oldWallet = wallet and wallet.Value or nil
	if table.find(owned[key], skinId) then
		local compensation = math.max(0, math.floor(tonumber(configured.WalletPrice) or 0))
		if compensation <= 0 or not wallet then return false, "Repeat-purchase compensation unavailable" end
		wallet.Value += compensation
	else
		table.insert(owned[key], skinId)
	end
	player:SetAttribute("OwnedAppearanceSkins", HttpService:JSONEncode(owned))
	session.RobuxProductReceipts[purchaseId] = {
		ProductId = productId, GrantedAt = os.time(),
		Source = source == "RobuxGiftBaseAppearance" and source or "RobuxBaseAppearance",
		Action = "GrantBaseAppearance", Status = "Granted", TargetUserId = player.UserId,
		GrantHash = tostring(level) .. ":" .. skinId,
	}
	markDirty(player)
	if not save(player, false, true) then
		player:SetAttribute("OwnedAppearanceSkins", oldOwnedRaw)
		if wallet and oldWallet ~= nil then wallet.Value = oldWallet end
		session.RobuxProductReceipts[purchaseId] = nil
		session.DurableReceipts[purchaseId] = nil
		markDirty(player)
		return false, "Base appearance save failed"
	end
	session.DurableReceipts[purchaseId] = true
	return true
end

