		for _, player in pairs(Players:GetPlayers()) do
			local session = SessionData[player]
			if session and session.DataLoaded and not session.Closing and next(session.PendingCarTransfers or {}) then
				task.spawn(processTransferOutbox, player)
			end
			if session and session.DataLoaded and session.IsDirty and not session.IsSaving
				and (now - session.LastSave >= AUTOSAVE_INTERVAL) then
				task.spawn(function() save(player, false) end)
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(25)
		for _, player in pairs(Players:GetPlayers()) do
			sanitizeInventory(player)
		end
	end
end)
