local AdminAPI = getRequiredChild(ServerStorage, "TycoonAdminAPI", "BindableFunction", "ServerStorage > TycoonAdminAPI", REQUIRED_WAIT_SECONDS)

local function handleAdminInvoke(action, player, ...)
	if action == "ForceWipe" and player and SessionData[player] then
		SessionData[player].ExplicitClear = true
		SessionData[player].IntentionalEmptyInventory = false
		SessionData[player].StarterPackPurchased = false
		SessionData[player].StarterPackPurchaseId = nil
		SessionData[player].StarterPackReceipts = {}
		SessionData[player].StarterPackSaveConfirmed = false
		SessionData[player].StarterPackClearRequested = true
		SessionData[player].Tutorial = sanitizeTutorialData(nil)
		applyTutorialAttributes(player, SessionData[player].Tutorial)
		if player:FindFirstChild("StarterGear") then player.StarterGear:ClearAllChildren() end
		if player:FindFirstChild("Backpack") then player.Backpack:ClearAllChildren() end
		markDirty(player)
		print("⚠️ FORCE WIPE INITIATED FOR: " .. player.Name)
		return true

	elseif action == "UpdateTutorial" and player then
		local expectedStage, nextStage, fields = ...
		local session = SessionData[player]
		if not session or not session.DataLoaded or type(expectedStage) ~= "string" or not VALID_TUTORIAL_STAGES[nextStage] then
			return false, "Invalid tutorial update"
		end
		session.Tutorial = sanitizeTutorialData(session.Tutorial)
		if session.Tutorial.Stage ~= expectedStage then return false, "Tutorial stage changed" end
		fields = type(fields) == "table" and fields or {}
		for _, field in ipairs({ "Answered", "Skipped", "Active", "Completed", "InventoryOpened", "TransferComplete", "CarPlaced", "EarningsClaimed", "ATMWithdrawn", "LocalCarPurchased" }) do
			if type(fields[field]) == "boolean" then session.Tutorial[field] = fields[field] end
		end
		session.Tutorial.Stage = nextStage
		session.Tutorial.Revision += 1
		if nextStage == "Completed" then session.Tutorial.Completed = true; session.Tutorial.Active = false; session.Tutorial.Answered = true end
		if nextStage == "Skipped" then session.Tutorial.Skipped = true; session.Tutorial.Active = false; session.Tutorial.Answered = true end
		applyTutorialAttributes(player, session.Tutorial)
		markDirty(player)
		queueCriticalSave(player, 1)
		return true

	elseif action == "AdminGiveTools" and player then
		local toolNames, actorUserId, reason, operationId = ...
		return PlayerTransactionCoordinator.Run(player, "AdminGiveTools", function()
			return adminGiveTools(player, toolNames, actorUserId, reason, operationId)
		end)

	elseif action == "AdminRemoveTools" and player then
		local targetToolId, actorUserId, reason, operationId = ...
		return PlayerTransactionCoordinator.Run(player, "AdminRemoveTools", function()
			return adminRemoveTools(player, targetToolId, actorUserId, reason, operationId)
		end)

	elseif action == "AdminAdjustBalance" and player then
		local balanceName, amount, actorUserId, reason, operationId = ...
		return PlayerTransactionCoordinator.Run(player, "AdminAdjustBalance", function()
			return adminAdjustBalance(player, balanceName, amount, actorUserId, reason, operationId)
		end)

	elseif action == "GiveTool" and player then
		local toolName, customAttributes = ...
		return PlayerTransactionCoordinator.Run(player, "GiveTool", function()
			return giveTool(player, toolName, customAttributes)
		end)

	elseif action == "TransferTool" and player then
		local receiver, tool, operationId = ...
		return PlayerTransactionCoordinator.RunMany({ player, receiver }, "TransferTool", function()
			return transferToolBetweenPlayers(player, receiver, tool, operationId)
		end)

	elseif action == "DeliverPendingCarTransfers" and player then
		return PlayerTransactionCoordinator.Run(player, "DeliverPendingCarTransfers", function()
			return deliverPendingPlayerCarTransfers(player)
		end)

	elseif action == "ClaimFreeReward" and player then
		local carName, walletCash = ...
		return PlayerTransactionCoordinator.Run(player, "ClaimFreeReward", function()
			return claimFreeReward(player, carName, walletCash)
		end)

	elseif action == "RedeemPromoCode" and player then
		local code, codeInfo = ...
		return PlayerTransactionCoordinator.Run(player, "RedeemPromoCode", function()
			return redeemPromoCode(player, code, codeInfo)
		end)

	elseif action == "GrantWalletCashProduct" and player then
		local purchaseId, productId, walletCash, source, notifyCashPack = ...
		return PlayerTransactionCoordinator.Run(player, "GrantWalletCashProduct", function()
			return grantWalletCashProduct(player, purchaseId, productId, walletCash, source, notifyCashPack)
		end)

	elseif action == "HasReceiptGrant" and player then
		local purchaseId = ...
		return hasDurableReceiptGrant(player, purchaseId)

	elseif action == "CommitReceiptGrant" and player then
		local purchaseId, productId, receiptAction, targetUserId, grantHash = ...
		return PlayerTransactionCoordinator.Run(player, "CommitReceiptGrant", function()
			return commitReceiptGrant(player, purchaseId, productId, receiptAction, targetUserId, grantHash)
		end)

	elseif action == "GrantStarterPack" and player then
		local purchaseId, carName, walletCash = ...
		return PlayerTransactionCoordinator.Run(player, "GrantStarterPack", function()
		if not save then
			return false, "Save system unavailable"
		end

		purchaseId = tostring(purchaseId or "")
		carName = tostring(carName or STARTER_PACK_CAR_NAME)
		walletCash = math.max(0, math.floor(tonumber(walletCash) or STARTER_PACK_WALLET_CASH))

		if purchaseId == "" then
			return false, "Missing purchase id"
		end

		local session = SessionData[player]
		if not session or not session.DataLoaded then
			return false, "Player data not loaded"
		end

		if session.StarterPackGrantInProgress then
			return false, "Starter Pack grant already running"
		end

		session.StarterPackGrantInProgress = true

		local function finish(ok, message)
			session.StarterPackGrantInProgress = false
			return ok, message
		end

		session.StarterPackReceipts = session.StarterPackReceipts or {}

		-- This flag prevents CheckOwned from returning true until the main data
		-- save succeeds. If Roblox retries the same receipt, this function will
		-- force-save again without granting duplicate cash/tools.
		session.StarterPackSaveConfirmed = false

		if session.RobuxProductReceipts[purchaseId] then
			local durable, durableMessage = hasDurableReceiptGrant(player, purchaseId)
			return finish(durable == true, durableMessage)
		end

		local leaderstats = player:FindFirstChild("leaderstats")
		local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")
		if not wallet then return finish(false, "Wallet not loaded") end
		local grantOk, grantMsg = giveTool(player, carName, {
			BypassStorageLimit = true,
			Source = "StarterPack",
			ReceiptPurchaseId = purchaseId,
			ReceiptProductId = 3599481243,
		})
		if not grantOk then return finish(false, grantMsg or "Starter Pack car grant failed") end
		-- Developer Products are repeatable. A second distinct receipt receives
		-- the complete bundle again instead of being acknowledged with no value.
		wallet.Value += walletCash
		session.StarterPackPurchased = true
		session.StarterPackPurchaseId = session.StarterPackPurchaseId or purchaseId
		session.StarterPackReceipts[purchaseId] = true
		markDirty(player)

		local saveOk = save(player, false, true)
		if not saveOk then
			return finish(false, "Starter Pack save failed")
		end

		session.StarterPackSaveConfirmed = true
		return finish(true)
		end)

	elseif action == "HasStarterPackGrant" and player then
		local session = SessionData[player]
		if not session or not session.DataLoaded then
			return nil, "Player data not loaded"
		end

		if session.StarterPackPurchased ~= true then
			return false
		end

		-- Do not let the client show success until the purchase flag has been
		-- confirmed by a successful main data save.
		if session.StarterPackGrantInProgress or session.StarterPackSaveConfirmed ~= true then
			return nil, "Starter Pack grant is still saving"
		end

		return true

	elseif action == "ClearStarterPackGrant" and player then
		-- Testing/admin reset only. This clears the one-time Starter Pack flag from
		-- the same main player data record used by GrantStarterPack.
		if not save then
			return false, "Save system unavailable"
		end

		local session = SessionData[player]
		if not session or not session.DataLoaded then
			return false, "Player data not loaded"
		end

		session.StarterPackPurchased = false
		session.StarterPackPurchaseId = nil
		session.StarterPackReceipts = {}
		session.StarterPackSaveConfirmed = false
		session.StarterPackClearRequested = true
		markDirty(player)

		local saveOk = save(player, false, true)
		if not saveOk then
			return false, "Starter Pack clear save failed"
		end

		return true

	elseif action == "RemoveTool" and player then
		local targetToolId, requestedAmount = ...
		if not targetToolId then return false end

		local removedCount = removeMatchingTools(player, targetToolId, requestedAmount)
		if removedCount < math.max(1, tonumber(requestedAmount) or 1) then
			return false, removedCount
		end

		local session = SessionData[player]
		if session then
			session.SacrificeOccurred = true
		end

		markDirty(player)
		return true, removedCount

	elseif action == "RemoveToolInstance" and player then
		local itemId, allowEquipped = ...
		return PlayerTransactionCoordinator.Run(player, "RemoveToolInstance", function()
			return removeExactToolInstance(player, itemId, allowEquipped == true)
		end)

	elseif action == "UpdateHotbar" and player then
		local slot, itemId = ...
		return PlayerTransactionCoordinator.Run(player, "UpdateHotbar", function()
			slot = math.floor(tonumber(slot) or 0)
			if slot < 1 or slot > 6 or type(itemId) ~= "string" or #itemId > 160 then
				return false, "Invalid hotbar update"
			end
			if itemId ~= "" then
				local ownsItem = false
				for _, container in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
					if container then
						for _, child in ipairs(container:GetChildren()) do
							if child:IsA("Tool") and child:GetAttribute("ItemId") == itemId and validateTool(child) then
								ownsItem = true
								break
							end
						end
					end
					if ownsItem then break end
				end
				if not ownsItem then return false, "Car is not owned" end
				for otherSlot = 1, 6 do
					if otherSlot ~= slot and player:GetAttribute("HotbarSlot" .. otherSlot) == itemId then
						player:SetAttribute("HotbarSlot" .. otherSlot, "")
					end
				end
			end
			player:SetAttribute("HotbarSlot" .. slot, itemId)
			markDirty(player)
			return true
		end)

	elseif action == "GrantLegacyBaseSkinProduct" and player then
		local purchaseId, productId, skinName, source = ...
		return PlayerTransactionCoordinator.Run(player, "GrantLegacyBaseSkinProduct", function()
			return grantLegacyBaseSkinProduct(player, purchaseId, productId, skinName, source)
		end)

	elseif action == "GrantBaseAppearanceProduct" and player then
		local purchaseId, productId, level, skinId, source = ...
		return PlayerTransactionCoordinator.Run(player, "GrantBaseAppearanceProduct", function()
			return grantBaseAppearanceProduct(player, purchaseId, productId, level, skinId, source)
		end)

	elseif action == "CanAddCar" and player then
		local amount = ...
		return canAddCarToStorage(player, amount)

	elseif action == "MarkDirty" and player then
		markDirty(player)
		return true

	elseif action == "SaveNow" and player then
		markDirty(player)
		if not save then
			return false, "Save system unavailable"
		end
		return save(player, false, true)

	elseif action == "QueueSaveSoon" and player then
		local delaySeconds = ...
		return queueCriticalSave(player, delaySeconds)

	elseif action == "MarkInventoryCleared" and player then
		local session = SessionData[player]
		if session then
			session.SacrificeOccurred = true
			if getCurrentInventoryCount(player) == 0 then
				session.IntentionalEmptyInventory = true
			end
		end
		markDirty(player)
		return true
	end

	return false
end

