local AdminAPI = getRequiredChild(ServerStorage, "TycoonAdminAPI", "BindableFunction", "ServerStorage > TycoonAdminAPI", REQUIRED_WAIT_SECONDS)

AdminAPI.OnInvoke = function(action, player, ...)
	if action == "ForceWipe" and player and SessionData[player] then
		SessionData[player].ExplicitClear = true
		SessionData[player].StarterPackPurchased = false
		SessionData[player].StarterPackPurchaseId = nil
		SessionData[player].StarterPackReceipts = {}
		SessionData[player].StarterPackSaveConfirmed = false
		SessionData[player].StarterPackClearRequested = true
		if player:FindFirstChild("StarterGear") then player.StarterGear:ClearAllChildren() end
		if player:FindFirstChild("Backpack") then player.Backpack:ClearAllChildren() end
		markDirty(player)
		print("⚠️ FORCE WIPE INITIATED FOR: " .. player.Name)
		return true

	elseif action == "GiveTool" and player then
		local toolName, customAttributes = ...
		return giveTool(player, toolName, customAttributes)

	elseif action == "TransferTool" and player then
		local receiver, tool = ...
		return transferToolBetweenPlayers(player, receiver, tool)

	elseif action == "ClaimFreeReward" and player then
		local carName, walletCash = ...
		return claimFreeReward(player, carName, walletCash)

	elseif action == "GrantStarterPack" and player then
		if not save then
			return false, "Save system unavailable"
		end

		local purchaseId, carName, walletCash = ...
		purchaseId = tostring(purchaseId or "")
		carName = tostring(carName or STARTER_PACK_CAR_NAME)
		walletCash = math.max(0, math.floor(tonumber(walletCash) or STARTER_PACK_WALLET_CASH))

		if purchaseId == "" then
			return false, "Missing purchase id"
		end

		local session = SessionData[player]
		if not session or not session.DataLoaded then
			return false, "Player data not loaded"
		end

		if session.StarterPackGrantInProgress then
			return false, "Starter Pack grant already running"
		end

		session.StarterPackGrantInProgress = true

		local function finish(ok, message)
			session.StarterPackGrantInProgress = false
			return ok, message
		end

		session.StarterPackReceipts = session.StarterPackReceipts or {}

		-- This flag prevents CheckOwned from returning true until the main data
		-- save succeeds. If Roblox retries the same receipt, this function will
		-- force-save again without granting duplicate cash/tools.
		session.StarterPackSaveConfirmed = false

		if session.StarterPackPurchased == true then
			session.StarterPackReceipts[purchaseId] = true
			session.StarterPackPurchaseId = session.StarterPackPurchaseId or purchaseId
			markDirty(player)
		else
			local leaderstats = player:FindFirstChild("leaderstats")
			local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")
			if not wallet then
				return finish(false, "Wallet not loaded")
			end

			local grantOk, grantMsg = giveTool(player, carName, {
				BypassStorageLimit = true,
				Source = "StarterPack",
				PurchaseId = purchaseId,
			})

			if not grantOk then
				return finish(false, grantMsg or "Starter Pack car grant failed")
			end

			wallet.Value += walletCash
			session.StarterPackPurchased = true
			session.StarterPackPurchaseId = purchaseId
			session.StarterPackReceipts[purchaseId] = true
			markDirty(player)
		end

		local saveOk = save(player, false, true)
		if not saveOk then
			return finish(false, "Starter Pack save failed")
		end

		session.StarterPackSaveConfirmed = true
		return finish(true)

	elseif action == "HasStarterPackGrant" and player then
		local session = SessionData[player]
		if not session or not session.DataLoaded then
			return nil, "Player data not loaded"
		end

		if session.StarterPackPurchased ~= true then
			return false
		end

		-- Do not let the client show success until the purchase flag has been
		-- confirmed by a successful main data save.
		if session.StarterPackGrantInProgress or session.StarterPackSaveConfirmed ~= true then
			return nil, "Starter Pack grant is still saving"
		end

		return true

	elseif action == "ClearStarterPackGrant" and player then
		-- Testing/admin reset only. This clears the one-time Starter Pack flag from
		-- the same main player data record used by GrantStarterPack.
		if not save then
			return false, "Save system unavailable"
		end

		local session = SessionData[player]
		if not session or not session.DataLoaded then
			return false, "Player data not loaded"
		end

		session.StarterPackPurchased = false
		session.StarterPackPurchaseId = nil
		session.StarterPackReceipts = {}
		session.StarterPackSaveConfirmed = false
		session.StarterPackClearRequested = true
		markDirty(player)

		local saveOk = save(player, false, true)
		if not saveOk then
			return false, "Starter Pack clear save failed"
		end

		return true

	elseif action == "RemoveTool" and player then
		local targetToolId, requestedAmount = ...
		if not targetToolId then return false end

		local removedCount = removeMatchingTools(player, targetToolId, requestedAmount)
		if removedCount < math.max(1, tonumber(requestedAmount) or 1) then
			return false, removedCount
		end

		local session = SessionData[player]
		if session then
			session.SacrificeOccurred = true
		end

		markDirty(player)
		return true, removedCount

	elseif action == "MarkDirty" and player then
		markDirty(player)
		return true

	elseif action == "SaveNow" and player then
		markDirty(player)
		if not save then
			return false, "Save system unavailable"
		end
		return save(player, false, true)

	elseif action == "QueueSaveSoon" and player then
		local delaySeconds = ...
		return queueCriticalSave(player, delaySeconds)

	elseif action == "MarkInventoryCleared" and player then
		local session = SessionData[player]
		if session then
			session.SacrificeOccurred = true
		end
		markDirty(player)
		return true
	end

	return false
end

