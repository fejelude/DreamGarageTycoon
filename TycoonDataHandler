local function getIndexProgressionAPI(waitSeconds)
	local existing = ReplicatedStorage:FindFirstChild("IndexProgressionAPI")
	if existing then
		return existing
	end

	if waitSeconds and waitSeconds > 0 then
		local ok, found = pcall(function()
			return ReplicatedStorage:WaitForChild("IndexProgressionAPI", waitSeconds)
		end)
		if ok then
			return found
		end
	end

	return nil
end

local function markIndexDiscovered(player, toolName, isRobuxExclusive)
	if not player or type(toolName) ~= "string" or toolName == "" then
		return false
	end

	local api = getIndexProgressionAPI(2)
	if not api or not api:IsA("BindableFunction") then
		return false
	end

	local ok = pcall(function()
		api:Invoke("MarkDiscovered", player, { ToolId = toolName, IsRobuxExclusive = isRobuxExclusive == true })
	end)

	return ok
end

