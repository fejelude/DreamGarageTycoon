MythicalCraftingInventoryAPI.OnInvoke = function(action, player, ...)
	if not player then return false end

	if action == "HasTool" then
		local targetToolId, requiredAmount = ...
		if not targetToolId then return false, 0 end
		requiredAmount = math.max(1, tonumber(requiredAmount) or 1)
		local ownedCount = countMatchingTools(player, targetToolId)
		return ownedCount >= requiredAmount, ownedCount

	elseif action == "RemoveTool" then
		local targetToolId, requestedAmount = ...
		if not targetToolId then return false, 0 end

		requestedAmount = math.max(1, tonumber(requestedAmount) or 1)
		local removedCount = removeMatchingTools(player, targetToolId, requestedAmount)

