-- ============================================================================
-- TycoonDataHandler — Server Script
-- ============================================================================
-- Purpose:   Handles all DataStore operations, security validation, session
--            management, and prevents item duplication.
-- Runs on:   Server
-- Location:  ServerScriptService > TycoonDataHandler
-- Dependencies: Players, ServerStorage, DataStoreService, Workspace,
--               ReplicatedStorage, HttpService, CarStats, BaseSkinStats
-- Public API:   TycoonAdminAPI (BindableFunction)
--               LegendaryCraftingInventoryFunction (BindableFunction)
--               MythicalCraftingInventoryFunction (BindableFunction)
-- Networking:   TycoonAdminLog (RemoteEvent), ShopRemotes (via Bindable)
-- Security:     Server-authoritative tool validation, anti-wipe protection.
-- Performance:  Batched saving, lock-based pad restoration, throttled sanitize.
-- Notes:        Supports UNCOMMON, RARE, EPIC, LEGENDARY, and MYTHICAL shop
--               persistence.
--
-- ============================================================================
-- CHANGELOG
-- ============================================================================
--
-- FIX (Held Tool Lost on Disconnect — CRITICAL):
--   When a player equips a tool it moves from Backpack into Character. If the
--   character is already destroyed by the time PlayerRemoving fires (a race
--   Roblox does NOT guarantee against), scanning player.Character returns
--   nothing, and the equipped tool is silently dropped from the saved
--   inventory.
--
--   Two-layer defence:
--     1. save() pre-snapshots Character tool IDs synchronously *before* any
--        yielding occurs, so the scan happens on a still-valid reference.
--     2. CharacterRemoving caches the held tool ID in session.HeldToolId as a
--        fallback. If Character is nil when save() runs, this cache is used.
--   CharacterAdded clears the cache so stale data never bleeds across deaths.
--
-- FIX (HasTool Count Inflated by StarterGear Mirror — MEDIUM):
--   giveTool() places one clone in Backpack (N copies for N owned) and one
--   mirror clone in StarterGear (always exactly 1, deduped). Previous
--   countMatchingTools() scanned StarterGear too, meaning a player with
--   one real tool appeared to own two. A crafting system requiring 2
--   ingredients would pass with only 1 real item — a free crafting exploit.
--   StarterGear is now excluded from countMatchingTools; only Backpack +
--   Character (equipped slot) are counted.
--
-- FIX (StarterGear Mirror Orphaned After RemoveTool — MEDIUM):
--   When the last copy of a tool is removed via removeMatchingTools, the
--   StarterGear mirror persisted because earlier cleanup only targeted
--   Backpack and Character. On respawn, the orphaned mirror re-populated
--   the Backpack as though the player still owned the item.
--   removeMatchingTools now checks whether any copies survive in
--   Backpack + Character after the primary removal pass; if none do, the
--   StarterGear mirror is also destroyed.
--
-- FIX (Currency Read Inside UpdateAsync Callback — MEDIUM):
--   MoneyManager.GetBalance (and other per-player reads) were called inside
--   the UpdateAsync transform function. Roblox discourages side-effects and
--   external I/O inside that callback; doing so can produce stale snapshots
--   if the callback is retried. All currency and attribute values are now
--   captured synchronously before UpdateAsync is invoked.
--
-- FIX (Legendary Sacrifice Dupe):
--   session.SacrificeOccurred flag gates the inventory anti-wipe check so a
--   legitimate sacrifice-to-empty-inventory is never incorrectly restored.
--
-- FIX (Cash Resets to 0 on Rejoin):
--   MoneyManager.GetBalance reads Cash from HiddenStats, not leaderstats.
--
-- FIX (Inventory Doubles on Every Rejoin — CRITICAL):
--   StarterGear excluded from save() inventory scan. It is a within-session
--   respawn mirror only and must never contribute to the persisted count.
--
-- FIX (Failed Saves Silently Drop Data — HIGH):
--   IsDirty and LastSave are only updated when the save actually succeeded.
--
-- FIX (AdminAPI RemoveTool Bypasses SacrificeOccurred — MEDIUM):
--   All removal paths (AdminAPI, LegendaryCraftingAPI, MythicalCraftingAPI)
--   now set session.SacrificeOccurred = true.
--
-- FIX (Shop Cleanup Not pcall-Protected → IsSaving Deadlock — LOW):
--   Each shop cleanup Invoke is wrapped in its own pcall so a single error
--   cannot prevent session.IsSaving from being released.
--
-- FIX (Ambiguous loop variable `_` as modulus counter — LOW):
--   RestoreLayout uses a dedicated padIndex counter for the throttle.
-- ============================================================================

local Players          = game:GetService("Players")
local ServerStorage    = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")
local Workspace        = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService      = game:GetService("HttpService")

-- ============================================================================
-- ⚙️  CONFIGURATION & CONSTANTS
-- ============================================================================
local DATA_KEY            = "Testingv8"
local PlayerDataStore     = DataStoreService:GetDataStore(DATA_KEY)

local AUTOSAVE_INTERVAL   = 180   -- seconds between automatic saves
local MIN_SAVE_INTERVAL   = 60    -- minimum seconds between any two saves
local MAX_RETRIES         = 3     -- DataStore retry attempts

local MAX_INVENTORY_SIZE  = 500
local MAX_LAYOUT_SIZE     = 200
local STARTER_CAR_NAME    = "Delta Item"

-- ============================================================================
-- 📂  ASSET REFERENCES
-- ============================================================================
local CarTools      = ServerStorage:WaitForChild("CarTools")
local CarModels     = ServerStorage:WaitForChild("CarModels")
local TycoonFolder  = Workspace:WaitForChild("Tycoons")
local AdminLogEvent = ServerStorage:FindFirstChild("TycoonAdminLog")

-- 📚 MODULES
local CarStats
do
	local ok, err = pcall(function()
		CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))
	end)
	if not ok then warn("⚠️ CarStats module not found: " .. tostring(err)) end
end

-- ============================================================================
-- 🔒  STATE MANAGEMENT
-- ============================================================================
local SessionData = {}  -- [Player] = session table
local PadLocks    = {}  -- [lockId] = true (prevents concurrent pad restoration)

-- ============================================================================
-- 🛡️  HELPERS
-- ============================================================================
local function logAdmin(message, severity)
	local prefix = severity and ("[" .. severity .. "] ") or "[INFO] "
	warn("🛡️ " .. prefix .. message)
	if AdminLogEvent then
		AdminLogEvent:FireAllClients(prefix .. message)
	end
end

local function markDirty(player)
	local session = SessionData[player]
	if session and not session.IsDirty then
		session.IsDirty = true
	end
end

-- ============================================================================
-- 🛡️  IDENTITY & VALIDATION
-- ============================================================================
local function tagIssued(tool, originalName)
	if not tool then return end
	tool:SetAttribute("IssuedByServer", true)
	tool:SetAttribute("IssuedAt",       os.time())
	tool:SetAttribute("IssuedId",       HttpService:GenerateGUID(false))
	tool:SetAttribute("ToolId",         originalName)
end

local function safeFindCarTool(targetName)
	if not targetName then return nil end
	local cleanName = targetName:gsub(" Item", ""):gsub("Item", "")

	for _, folderName in ipairs({ "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }) do
		local folder = CarTools:FindFirstChild(folderName)
		if folder then
			for _, tool in ipairs(folder:GetChildren()) do
				if tool.Name == targetName
					or tool.Name == cleanName .. " Item"
					or tool.Name == cleanName
				then
					return tool
				end
			end
		end
	end
	return nil
end

local function safeFindCarModel(targetName)
	if not targetName then return nil end
	local cleanName = targetName:gsub(" Item", ""):gsub("Item", "")

	for _, folderName in ipairs({ "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" }) do
		local folder = CarModels:FindFirstChild(folderName)
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				if model.Name == targetName or model.Name == cleanName then
					return model
				end
			end
		end
	end
	return nil
end

local function validateTool(tool)
	if not tool then return false end
	if not tool:GetAttribute("IssuedByServer") then return false end
	local id = tool:GetAttribute("ToolId")
	if not id then return false end
	return safeFindCarTool(id) ~= nil
end

local function sanitizeInventory(player)
	if not player then return end
	local containers = { player.Backpack, player:FindFirstChild("StarterGear") }

	for _, container in ipairs(containers) do
		if container then
			for _, tool in ipairs(container:GetChildren()) do
				if tool:IsA("Tool") then
					if not tool:GetAttribute("ToolId") then
						logAdmin("Destroyed unauthorized tool (missing ToolId): " .. tool.Name, "WARN")
						tool:Destroy()
					elseif not validateTool(tool) then
						logAdmin("Destroyed unauthorized tool: " .. tool.Name, "WARN")
						tool:Destroy()
					else
						if tool.CanBeDropped then tool.CanBeDropped = false end
						local realId = tool:GetAttribute("ToolId")
						if realId and tool.Name ~= realId then
							tool.Name = realId
						end
					end
				end
			end
		end
	end
end

-- ============================================================================
-- 💰  MONEY MANAGER
-- ============================================================================
local MoneyManager = {}

function MoneyManager.GetBalance(player, currencyType)
	if not player then return 0 end

	-- Cash lives in HiddenStats; all other currencies live in leaderstats.
	if currencyType == "Cash" then
		local hs  = player:FindFirstChild("HiddenStats")
		if not hs then return 0 end
		local val = hs:FindFirstChild("Cash")
		return val and val.Value or 0
	else
		local ls  = player:FindFirstChild("leaderstats")
		if not ls then return 0 end
		local val = ls:FindFirstChild(currencyType)
		return val and val.Value or 0
	end
end

-- ============================================================================
-- 🛠️  ASSET LOOKUPS
-- ============================================================================
local function FindToolNameFromModel(modelName)
	local tool = safeFindCarTool(modelName)
	if tool then return tool.Name end

	if CarStats and CarStats.Cars then
		for internalID, stats in pairs(CarStats.Cars) do
			if stats.Name == modelName then
				local fallback = safeFindCarTool(internalID)
				if fallback then return fallback.Name end
			end
		end
	end
	return nil
end

local function FindModelNameFromTool(toolName)
	local model = safeFindCarModel(toolName)
	if model then return model.Name end

	local clean = toolName:gsub(" Item", ""):gsub("Item", "")
	if CarStats and CarStats.Cars and CarStats.Cars[clean] then
		local stats    = CarStats.Cars[clean]
		local fallback = safeFindCarModel(stats.Name)
		if fallback then return fallback.Name end
	end
	return nil
end

local function getMainPart(obj)
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		if obj.PrimaryPart then return obj.PrimaryPart end
		for _, child in ipairs(obj:GetChildren()) do
			if child:IsA("BasePart") and child.Name ~= "Border" then return child end
		end
		return obj:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

local function generateCarGUID(player)
	return player.UserId .. "_" .. HttpService:GenerateGUID(false)
end

-- ============================================================================
-- 🎁  GIVE TOOL
-- ============================================================================
local function giveTool(player, toolName, customAttributes)
	if not player or not player.Parent then return end

	local sourceTool = safeFindCarTool(toolName)
	if not sourceTool then
		local resolved = FindToolNameFromModel(toolName)
		if resolved then sourceTool = safeFindCarTool(resolved) end
	end

	if not sourceTool then
		warn("⚠️ [DATA] Invalid tool requested: " .. tostring(toolName))
		return
	end

	-- Clone once for Backpack (real inventory slot) and once for StarterGear
	-- (within-session respawn mirror, always exactly 1 copy per unique ToolId).
	local backpackTool = sourceTool:Clone()
	local gearTool     = sourceTool:Clone()
	tagIssued(backpackTool, sourceTool.Name)
	tagIssued(gearTool,     sourceTool.Name)

	if type(customAttributes) == "table" then
		for k, v in pairs(customAttributes) do
			backpackTool:SetAttribute(k, v)
			gearTool:SetAttribute(k, v)
		end
	end

	-- Backpack: real inventory (one slot per owned copy).
	if player:FindFirstChild("Backpack") then
		backpackTool.Parent = player.Backpack
	else
		warn("⚠️ Receiver dead/respawning. Item added to StarterGear only.")
		backpackTool:Destroy()
	end

	-- StarterGear: respawn mirror. Only one clone per unique ToolId allowed.
	local gear = player:FindFirstChild("StarterGear")
	if gear then
		local alreadyMirrored = false
		for _, child in ipairs(gear:GetChildren()) do
			if child:GetAttribute("ToolId") == sourceTool.Name then
				alreadyMirrored = true
				break
			end
		end
		if not alreadyMirrored then
			gearTool.Parent = gear
		else
			gearTool:Destroy()
		end
	else
		gearTool:Destroy()
	end

	markDirty(player)
end

-- ============================================================================
-- 🏗️  LAYOUT RESTORATION
-- ============================================================================
local function acquirePadLock(lockId)
	if PadLocks[lockId] then return false end
	PadLocks[lockId] = true
	return true
end

local function releasePadLock(lockId)
	PadLocks[lockId] = nil
end

local function RestoreLayout(player, plot, layoutData)
	if not layoutData or not plot then return end
	if #layoutData > MAX_LAYOUT_SIZE then return end

	local padsFolder = plot:WaitForChild("Pads", 10)
	if not padsFolder then return end

	local placedCarsFolder = plot:FindFirstChild("PlacedCars")
		or Instance.new("Folder", plot)
	placedCarsFolder.Name = "PlacedCars"

	local validPads     = {}
	for _, p in ipairs(padsFolder:GetChildren()) do
		validPads[p.Name] = true
	end

	local processedPads = {}
	local restoredCount = 0
	local padIndex      = 0

	for _, data in ipairs(layoutData) do
		local toolName = data.Tool
		local padName  = data.Pad
		if not validPads[padName]      then continue end
		if processedPads[padName]      then continue end

		local padObject = padsFolder[padName]
		local lockId    = padObject:GetFullName()

		if not acquirePadLock(lockId) then
			task.wait(0.1)
			if not acquirePadLock(lockId) then continue end
		end
		processedPads[padName] = true

		local padPart = getMainPart(padObject)
		if padPart then
			local isOccupied = padPart:FindFirstChild("IsOccupied")
			if isOccupied and not isOccupied.Value then
				local realModelName = FindModelNameFromTool(toolName)
				if realModelName then
					local carModel = safeFindCarModel(realModelName)
					if carModel then
						local newCar = carModel:Clone()
						newCar:SetAttribute("OwnerUserId", player.UserId)
						newCar:SetAttribute("CarGUID",     generateCarGUID(player))

						for _, p in ipairs(newCar:GetDescendants()) do
							if p:IsA("BasePart") then
								p.Anchored    = true
								p.CanCollide  = true
							end
						end

						local padTop = padPart.CFrame * CFrame.new(0, (padPart.Size.Y / 2) + 5, 0)
						newCar:PivotTo(padTop)
						newCar.Parent = placedCarsFolder

						isOccupied.Value = true

						local linked = padPart:FindFirstChild("LinkedCar")
							or Instance.new("ObjectValue", padPart)
						linked.Name  = "LinkedCar"
						linked.Value = newCar

						if padPart:FindFirstChild("PlacePrompt")  then padPart.PlacePrompt.Enabled  = false end
						if padPart:FindFirstChild("PickupPrompt") then padPart.PickupPrompt.Enabled = true  end

						restoredCount += 1
					end
				end
			end
		end

		releasePadLock(lockId)

		padIndex += 1
		if padIndex % 5 == 0 then task.wait() end
	end

	if restoredCount > 0 then
		markDirty(player)
		print("🏗️ Restored " .. restoredCount .. " cars for " .. player.Name)
	end
end

-- ============================================================================
-- 🔧  TOOL MATCHING UTILITIES
-- ============================================================================
local function toolMatchesId(tool, targetToolId)
	return tool
		and tool:IsA("Tool")
		and (
			tool.Name == targetToolId
			or tool.Name == targetToolId .. " Item"
			or tool:GetAttribute("ToolId") == targetToolId
			or tool:GetAttribute("ToolId") == targetToolId .. " Item"
		)
end

-- countMatchingTools: returns how many real copies of targetToolId a player
-- owns. Only Backpack and Character (equipped slot) are scanned.
--
-- StarterGear is intentionally excluded: giveTool() always places exactly one
-- mirror clone there regardless of how many real copies the player owns.
-- Including StarterGear would inflate the count by 1 whenever the player has
-- at least one copy, allowing crafting recipes to be satisfied with one fewer
-- real ingredient than required.
local function countMatchingTools(player, targetToolId)
	if not player or not targetToolId then return 0 end

	local total = 0
	local function scan(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			if toolMatchesId(child, targetToolId) then
				total += 1
			end
		end
	end

	scan(player:FindFirstChild("Backpack"))
	if player.Character then scan(player.Character) end
	-- StarterGear excluded — see above.

	return total
end

-- removeMatchingTools: removes up to requestedAmount copies from Backpack,
-- Character, and (as a final cleanup step) StarterGear.
--
-- StarterGear is cleaned up ONLY when no copies remain in Backpack or
-- Character after the primary removal pass. This keeps the respawn mirror
-- alive when the player still owns other copies, while preventing an
-- orphaned mirror from re-populating the Backpack on the next respawn.
local function removeMatchingTools(player, targetToolId, requestedAmount)
	if not player or not targetToolId then return 0 end

	requestedAmount = math.max(1, tonumber(requestedAmount) or 1)
	local removedCount = 0

	local function removeFromContainer(container)
		if not container or removedCount >= requestedAmount then return end
		for _, child in ipairs(container:GetChildren()) do
			if removedCount >= requestedAmount then break end
			if toolMatchesId(child, targetToolId) then
				child:Destroy()
				removedCount += 1
			end
		end
	end

	-- Primary removal: real inventory locations.
	removeFromContainer(player:FindFirstChild("Backpack"))
	if player.Character then removeFromContainer(player.Character) end

	-- StarterGear mirror cleanup: only destroy the mirror if no real copies
	-- remain, so the respawn mirror does not re-add a removed tool.
	local survivingCopies = countMatchingTools(player, targetToolId)
	if survivingCopies == 0 then
		local gear = player:FindFirstChild("StarterGear")
		if gear then
			for _, child in ipairs(gear:GetChildren()) do
				if toolMatchesId(child, targetToolId) then
					child:Destroy()
					break -- StarterGear holds at most one mirror per ToolId
				end
			end
		end
	end

	return removedCount
end

-- ============================================================================
-- 🔄  ADMIN API  (BindableFunction)
-- ============================================================================
local AdminAPI = ServerStorage:FindFirstChild("TycoonAdminAPI")
if not AdminAPI then
	AdminAPI        = Instance.new("BindableFunction")
	AdminAPI.Name   = "TycoonAdminAPI"
	AdminAPI.Parent = ServerStorage
end

AdminAPI.OnInvoke = function(action, player, ...)
	if action == "ForceWipe" and player and SessionData[player] then
		SessionData[player].ExplicitClear = true
		if player:FindFirstChild("StarterGear") then player.StarterGear:ClearAllChildren() end
		if player:FindFirstChild("Backpack")    then player.Backpack:ClearAllChildren()    end
		markDirty(player)
		print("⚠️ FORCE WIPE INITIATED FOR: " .. player.Name)
		return true

	elseif action == "GiveTool" and player then
		local toolName, customAttributes = ...
		giveTool(player, toolName, customAttributes)
		return true

	elseif action == "RemoveTool" and player then
		local targetToolId, requestedAmount = ...
		if not targetToolId then return false end

		local needed       = math.max(1, tonumber(requestedAmount) or 1)
		local removedCount = removeMatchingTools(player, targetToolId, needed)

		if removedCount < needed then
			return false, removedCount
		end

		-- Mark sacrifice so the inventory anti-wipe does not restore the
		-- admin-removed tools on the next save.
		local session = SessionData[player]
		if session then session.SacrificeOccurred = true end

		markDirty(player)
		return true, removedCount

	elseif action == "MarkDirty" and player then
		markDirty(player)
		return true
	end

	return false
end

-- ============================================================================
-- 🗡️  LEGENDARY CRAFTING INVENTORY API  (BindableFunction)
-- ============================================================================
local LegendaryCraftingInventoryAPI =
	ServerStorage:FindFirstChild("LegendaryCraftingInventoryFunction")
if not LegendaryCraftingInventoryAPI then
	LegendaryCraftingInventoryAPI        = Instance.new("BindableFunction")
	LegendaryCraftingInventoryAPI.Name   = "LegendaryCraftingInventoryFunction"
	LegendaryCraftingInventoryAPI.Parent = ServerStorage
end

LegendaryCraftingInventoryAPI.OnInvoke = function(action, player, ...)
	if not player then return false end

	if action == "HasTool" then
		local targetToolId, requiredAmount = ...
		if not targetToolId then return false, 0 end
		requiredAmount = math.max(1, tonumber(requiredAmount) or 1)
		local ownedCount = countMatchingTools(player, targetToolId)
		return ownedCount >= requiredAmount, ownedCount

	elseif action == "RemoveTool" then
		local targetToolId, requestedAmount = ...
		if not targetToolId then return false, 0 end

		requestedAmount = math.max(1, tonumber(requestedAmount) or 1)
		local removedCount = removeMatchingTools(player, targetToolId, requestedAmount)

		if removedCount < requestedAmount then
			return false, removedCount
		end

		local session = SessionData[player]
		if session then session.SacrificeOccurred = true end

		markDirty(player)
		return true, removedCount

	elseif action == "GiveTool" then
		local toolName, customAttributes = ...
		giveTool(player, toolName, customAttributes)
		return true

	elseif action == "MarkDirty" then
		markDirty(player)
		return true
	end

	return false
end

