-- 🏗️ LAYOUT RESTORATION
-- ----------------------------------------------------------------------------
local function getLevelModel(plot, levelName)
	local canonicalName = levelName == "Level1" and "NormalLevel1"
		or (levelName == "Level2" and "NormalLevel2" or levelName)
	local model = plot:FindFirstChild(canonicalName)
	if model then return model end

	local dedicatedFolder = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")
	if dedicatedFolder then
		local plotStorage = dedicatedFolder:FindFirstChild(plot.Name)
		if plotStorage then
			return plotStorage:FindFirstChild(canonicalName)
		end
	end
	return nil
end

local function getPadsFolder(plot, baseLevel, activeLevelFolder)
	local levelContainer = activeLevelFolder and activeLevelFolder.Parent
	return levelContainer and levelContainer:FindFirstChild("Pads")
end

local function acquirePadLock(lockId)
	if PadLocks[lockId] then return false end
	PadLocks[lockId] = true
	return true
end

local function releasePadLock(lockId)
	PadLocks[lockId] = nil
end

local function RestoreLayout(player, plot, layoutData)
	if not layoutData or not plot then return false end
	if #layoutData > MAX_LAYOUT_SIZE then return false end
	local expectedCount = #layoutData

	local placedCarsFolder = plot:FindFirstChild("PlacedCars")
	if not placedCarsFolder or not placedCarsFolder:IsA("Folder") then
		warn("⚠️ [TycoonDataHandler] Missing required Folder: " .. plot:GetFullName() .. " > PlacedCars. Layout restore skipped; this script will not create it automatically.")
		return false
	end

	local validPads = {}
	local playerBaseLevel = tonumber(player:GetAttribute("BaseLevel")) or 1
	local activeLevelFolder = nil
	if playerBaseLevel == 1 then
		activeLevelFolder = getLevelModel(plot, "Level1")
		if not activeLevelFolder then activeLevelFolder = plot:WaitForChild("NormalLevel1", 10) end
	elseif playerBaseLevel == 2 then
		activeLevelFolder = getLevelModel(plot, "Level2")
	end

	if not activeLevelFolder then return false end
	local padsFolder = getPadsFolder(plot, playerBaseLevel, activeLevelFolder)
	if not padsFolder then return false end
	for _, p in ipairs(padsFolder:GetChildren()) do validPads[p.Name] = true end

	local processedPads = {}
	local restoredCount = 0

	local padIndex = 0

	for _, data in ipairs(layoutData) do
		local toolName = data.Tool
		local padName = data.Pad
		local itemId = validPersistentId(data.ItemId) and data.ItemId or generateItemId(player.UserId)
		if not validPads[padName] then continue end
		if processedPads[padName] then continue end

		-- Fix 6: TycoonDataHandler Anti-wipe layout detection unreliable
		-- It should only restore on pads that exist in the active level folder.
		local padObject = nil
		local activePadsFolder = getPadsFolder(plot, playerBaseLevel, activeLevelFolder)
		if activePadsFolder and activePadsFolder:FindFirstChild(padName) then
			padObject = activePadsFolder[padName]
		end

		if not padObject then continue end

		local lockId = padObject:GetFullName()

		if not acquirePadLock(lockId) then
			task.wait(0.1)
			if not acquirePadLock(lockId) then continue end
		end
		processedPads[padName] = true

		local padPart = getMainPart(padObject)
		if padPart then
			local isOccupied = padPart:FindFirstChild("IsOccupied")
			if isOccupied and not isOccupied.Value then
				local realModelName = FindModelNameFromTool(toolName)
				if realModelName then
					local carModel = safeFindCarModel(realModelName)
					if carModel then
						local newCar = carModel:Clone()
						newCar:SetAttribute("OwnerUserId", player.UserId)
						newCar:SetAttribute("ItemId", itemId)
						newCar:SetAttribute("CarGUID", itemId)
						newCar:SetAttribute("ToolId", toolName)
						for _, p in pairs(newCar:GetDescendants()) do
							if p:IsA("BasePart") then p.Anchored = true; p.CanCollide = true end
						end
						local padTop = padPart.CFrame * CFrame.new(0, (padPart.Size.Y / 2) + CONSTANTS.VERTICAL_OFFSET, 0)
						newCar:PivotTo(padTop)
						newCar.Parent = placedCarsFolder

						local linked = padPart:FindFirstChild("LinkedCar")
						if not linked or not linked:IsA("ObjectValue") then
							warn("⚠️ [TycoonDataHandler] Missing required ObjectValue: " .. padPart:GetFullName() .. " > LinkedCar. Skipping restored car; this script will not create it automatically.")
							newCar:Destroy()
						else
							isOccupied.Value = true
							linked.Value = newCar

							if padPart:FindFirstChild("PlacePrompt") then padPart.PlacePrompt.Enabled = false end
							if padPart:FindFirstChild("PickupPrompt") then padPart.PickupPrompt.Enabled = true end
							restoredCount += 1
						end
					end
				end
			end
		end

		releasePadLock(lockId)

		padIndex += 1
		if padIndex % 5 == 0 then task.wait() end
	end

	if restoredCount > 0 then
		markDirty(player)
		print("🏗️ Restored " .. restoredCount .. " cars for " .. player.Name)
	end
	if restoredCount ~= expectedCount then
		warn(string.format(
			"[TycoonDataHandler] Layout restore incomplete for %s: restored %d of %d cars",
			player.Name, restoredCount, expectedCount
		))
		return false
	end
	return true
end

local function toolMatchesId(tool, targetToolId)
	return tool
		and tool:IsA("Tool")
		and (
			tool.Name == targetToolId
			or tool.Name == targetToolId .. " Item"
			or tool:GetAttribute("ToolId") == targetToolId
			or tool:GetAttribute("ToolId") == targetToolId .. " Item"
		)
end

local function toolIdMatchesTarget(toolId, targetToolId)
	if type(toolId) ~= "string" or type(targetToolId) ~= "string" then
		return false
	end

	local cleanToolId = toolId:gsub(" Item$", "")
	local cleanTargetId = targetToolId:gsub(" Item$", "")
	return cleanToolId == cleanTargetId
end

local function getHotbarReservations(player, targetToolId)
	local reservedItemIds = {}
	local legacyReservations = 0
	if not player or type(targetToolId) ~= "string" then
		return reservedItemIds, legacyReservations
	end

	for i = 1, 6 do
		local hotbarValue = player:GetAttribute("HotbarSlot" .. i)
		local exactMatch = false
		if type(hotbarValue) == "string" and hotbarValue ~= "" then
			for _, container in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
				if container then
					for _, child in ipairs(container:GetChildren()) do
						if child:IsA("Tool") and child:GetAttribute("ItemId") == hotbarValue
							and toolMatchesId(child, targetToolId)
						then
							reservedItemIds[hotbarValue] = true
							exactMatch = true
							break
						end
					end
				end
				if exactMatch then break end
			end

			-- Older saves stored a tool name in each slot. Preserve those players'
			-- reservations until the server migrates the slot to an exact ItemId.
			if not exactMatch and toolIdMatchesTarget(hotbarValue, targetToolId) then
				legacyReservations += 1
			end
		end
	end

	return reservedItemIds, legacyReservations
end

local function hasProtectedSacrificeAttribute(tool)
	if not tool then return true end

	for _, attributeName in ipairs({
		"Locked",
		"IsLocked",
		"Favorite",
		"Favorited",
		"IsFavorite",
		"Favourite",
		"Favourited",
		"IsFavourite",
	}) do
		if tool:GetAttribute(attributeName) == true then
			return true
		end
	end

	return false
end

local function isProtectedFromSacrifice(player, tool)
	if not tool or not tool:IsA("Tool") then return true end
	if hasProtectedSacrificeAttribute(tool) then return true end
	if player and player.Character and tool.Parent == player.Character then return true end
	return false
end

local function countMatchingTools(player, targetToolId)
	if not player or not targetToolId then return 0 end

	-- StarterGear is only a respawn mirror and must not count as another owned car.
	local total = 0
	local seenItemIds = {}
	local reservedItemIds, legacyReservations = getHotbarReservations(player, targetToolId)
	local function scan(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			local itemId = child:IsA("Tool") and child:GetAttribute("ItemId")
			if validPersistentId(itemId) and not seenItemIds[itemId]
				and not reservedItemIds[itemId] and toolMatchesId(child, targetToolId)
				and not isProtectedFromSacrifice(player, child)
			then
				seenItemIds[itemId] = true
				total += 1
			end
		end
	end

	scan(player:FindFirstChild("Backpack"))

	return math.max(0, total - legacyReservations)
end

local function removeMatchingTools(player, targetToolId, requestedAmount)
	if not player or not targetToolId then return 0 end

	requestedAmount = math.max(1, tonumber(requestedAmount) or 1)
	local removedOwnedCount = 0
	local removedItemIds = {}
	local seenItemIds = {}
	local reservedItemIds, legacyReservations = getHotbarReservations(player, targetToolId)

	local function removeFromOwnedContainer(container)
		if not container or removedOwnedCount >= requestedAmount then return end
		for _, child in ipairs(container:GetChildren()) do
			if removedOwnedCount >= requestedAmount then break end
			local itemId = child:IsA("Tool") and child:GetAttribute("ItemId")
			if validPersistentId(itemId) and not seenItemIds[itemId]
				and not reservedItemIds[itemId] and toolMatchesId(child, targetToolId)
				and not isProtectedFromSacrifice(player, child)
			then
				seenItemIds[itemId] = true
				if legacyReservations > 0 then
					legacyReservations -= 1
					continue
				end
				removedItemIds[itemId] = true
				removedOwnedCount += 1
			end
		end
	end

	-- Remove real owned copies first. StarterGear mirrors are cleaned after and
	-- do not contribute to the amount removed.
	removeFromOwnedContainer(player:FindFirstChild("Backpack"))

	if removedOwnedCount > 0 then
		for _, container in ipairs({ player:FindFirstChild("Backpack"), player.Character, player:FindFirstChild("StarterGear") }) do
			if container then
				for _, child in ipairs(container:GetChildren()) do
					if child:IsA("Tool") and removedItemIds[child:GetAttribute("ItemId")] then
						child:Destroy()
					end
				end
			end
		end
	end
	if removedOwnedCount > 0 and getCurrentInventoryCount(player) == 0 then
		local session = SessionData[player]
		if session then session.IntentionalEmptyInventory = true end
	end

	return removedOwnedCount
end

local function removeExactToolInstance(player, itemId, allowEquipped)
	if not player or not validPersistentId(itemId) then
		return false, "Invalid item identity"
	end

	local toolId
	local removed = false
	for _, container in ipairs({ player:FindFirstChild("Backpack"), allowEquipped and player.Character or nil }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and child:GetAttribute("ItemId") == itemId and validateTool(child) then
					toolId = toolId or child:GetAttribute("ToolId")
					child:Destroy()
					removed = true
				end
			end
		end
	end

	if not removed then
		return false, "Owned car instance not found"
	end

	local starterGear = player:FindFirstChild("StarterGear")
	if starterGear then
		for _, child in ipairs(starterGear:GetChildren()) do
			if child:IsA("Tool") and child:GetAttribute("ItemId") == itemId then
				child:Destroy()
			end
		end
	end
	local session = SessionData[player]
	if session and getCurrentInventoryCount(player) == 0 then
		session.IntentionalEmptyInventory = true
	end
	markDirty(player)
	return true, toolId
end

local function appendAdminAudit(player, actorUserId, operationId, action, reason, item, amount, result)
	local session = SessionData[player]
	if not session then return end
	session.AdminAuditLog = sanitizeAdminAuditLog(session.AdminAuditLog)
	table.insert(session.AdminAuditLog, {
		At = os.time(), ActorUserId = actorUserId, OperationId = operationId,
		Action = action, Reason = reason, Item = item, Amount = amount, Result = result,
	})
	while #session.AdminAuditLog > MAX_ADMIN_AUDIT_HISTORY do table.remove(session.AdminAuditLog, 1) end
	markDirty(player)
end

local function normalizeAdminMetadata(actorUserId, reason, operationId)
	actorUserId = math.max(0, math.floor(tonumber(actorUserId) or 0))
	reason = type(reason) == "string" and string.sub(reason, 1, 160) or "Admin command"
	operationId = type(operationId) == "string" and string.sub(operationId, 1, 100) or ""
	if operationId == "" then operationId = HttpService:GenerateGUID(false) end
	return actorUserId, reason, operationId
end

local function findAdminOperation(player, operationId)
	local session = SessionData[player]
	if not session or type(operationId) ~= "string" or operationId == "" then return nil end
	for index = #(session.AdminAuditLog or {}), 1, -1 do
		local entry = session.AdminAuditLog[index]
		if type(entry) == "table" and entry.OperationId == operationId then return entry end
	end
	return nil
end

local function adminGiveTools(player, toolNames, actorUserId, reason, operationId)
	if type(toolNames) ~= "table" or #toolNames < 1 or #toolNames > MAX_INVENTORY_SIZE then
		return false, "Invalid admin grant list"
	end
	actorUserId, reason, operationId = normalizeAdminMetadata(actorUserId, reason, operationId)
	local previous = findAdminOperation(player, operationId)
	if previous then
		return previous.Result == "Applied", previous.Amount or 0, operationId
	end
	local granted = {}
	for _, toolName in ipairs(toolNames) do
		if type(toolName) ~= "string" or not safeFindCarTool(toolName) then
			for _, itemId in ipairs(granted) do removeExactToolInstance(player, itemId, true) end
			appendAdminAudit(player, actorUserId, operationId, "Give", reason, tostring(toolName), #granted, "Rejected")
			return false, "Invalid car id"
		end
		local ok, message, tool = giveTool(player, toolName, {
			BypassStorageLimit = true,
			Source = "Admin",
			AdminActorUserId = actorUserId,
			AdminOperationId = operationId,
		})
		if not ok or not tool then
			for _, itemId in ipairs(granted) do removeExactToolInstance(player, itemId, true) end
			appendAdminAudit(player, actorUserId, operationId, "Give", reason, toolName, #granted, "Failed")
			return false, message or "Admin grant failed"
		end
		table.insert(granted, tool:GetAttribute("ItemId"))
	end

	appendAdminAudit(player, actorUserId, operationId, "Give", reason, toolNames[1], #granted, "Applied")
	if save(player, false, true) ~= true then
		for _, itemId in ipairs(granted) do removeExactToolInstance(player, itemId, true) end
		appendAdminAudit(player, actorUserId, operationId, "Give", reason, toolNames[1], #granted, "RolledBack")
		return false, "Admin grant save failed"
	end
	return true, #granted, operationId
end

local function collectAdminRemovalRecords(player, targetToolId)
	local removeAll = targetToolId == "*" or targetToolId == "all"
	local records, seenItemIds = {}, {}
	for _, container in ipairs({ player:FindFirstChild("Backpack"), player.Character }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				local itemId = child:IsA("Tool") and child:GetAttribute("ItemId")
				if validateTool(child) and validPersistentId(itemId) and not seenItemIds[itemId]
					and (removeAll or toolMatchesId(child, targetToolId))
				then
					seenItemIds[itemId] = true
					table.insert(records, { ToolId = child:GetAttribute("ToolId"), ItemId = itemId })
				end
			end
		end
	end
	return records, removeAll
end

local function adminRemoveTools(player, targetToolId, actorUserId, reason, operationId)
	if type(targetToolId) ~= "string" or #targetToolId > 100 then return false, "Invalid car id" end
	actorUserId, reason, operationId = normalizeAdminMetadata(actorUserId, reason, operationId)
	local previous = findAdminOperation(player, operationId)
	if previous then
		return previous.Result == "Applied", previous.Amount or 0, operationId
	end
	local records, removeAll = collectAdminRemovalRecords(player, targetToolId)
	if #records == 0 and not removeAll then
		appendAdminAudit(player, actorUserId, operationId, "Remove", reason, targetToolId, 0, "NotFound")
		return false, 0, operationId
	end

	local oldIntentionalEmpty = SessionData[player] and SessionData[player].IntentionalEmptyInventory
	local oldHotbar = {}
	for slot = 1, 6 do oldHotbar[slot] = player:GetAttribute("HotbarSlot" .. slot) end
	for _, record in ipairs(records) do removeExactToolInstance(player, record.ItemId, true) end
	if removeAll then
		for _, container in ipairs({ player:FindFirstChild("Backpack"), player.Character, player:FindFirstChild("StarterGear") }) do
			if container then
				for _, child in ipairs(container:GetChildren()) do if child:IsA("Tool") then child:Destroy() end end
			end
		end
	end
	local removedIds = {}
	for _, record in ipairs(records) do removedIds[record.ItemId] = true end
	for slot = 1, 6 do
		local value = player:GetAttribute("HotbarSlot" .. slot)
		if removeAll or removedIds[value] or (type(value) == "string" and toolIdMatchesTarget(value, targetToolId)) then
			player:SetAttribute("HotbarSlot" .. slot, "")
		end
	end
	local session = SessionData[player]
	if session then
		session.HeldToolRecord = nil
		local noOwnedTools = getCurrentInventoryCount(player) == 0
		if noOwnedTools then session.IntentionalEmptyInventory = true end
	end
	appendAdminAudit(player, actorUserId, operationId, removeAll and "ClearInventory" or "Remove", reason, targetToolId, #records, "Applied")
	if save(player, false, true) ~= true then
		for _, record in ipairs(records) do
			giveTool(player, record.ToolId, { ItemId = record.ItemId, BypassStorageLimit = true, Source = "AdminRollback" })
		end
		if session then session.IntentionalEmptyInventory = oldIntentionalEmpty == true end
		for slot = 1, 6 do player:SetAttribute("HotbarSlot" .. slot, oldHotbar[slot]) end
		appendAdminAudit(
			player, actorUserId, operationId, removeAll and "ClearInventory" or "Remove",
			reason, targetToolId, #records, "RolledBack"
		)
		return false, "Admin removal save failed", operationId
	end
	return true, #records, operationId
end

local function adminAdjustBalance(player, balanceName, amount, actorUserId, reason, operationId)
	amount = tonumber(amount)
	if not amount or amount ~= amount or amount == math.huge or amount == -math.huge or amount <= 0 then
		return false, "Invalid amount"
	end
	amount = math.min(1000000000000000, math.floor(amount))
	if balanceName ~= "Wallet" and balanceName ~= "Bank" then return false, "Invalid balance" end
	actorUserId, reason, operationId = normalizeAdminMetadata(actorUserId, reason, operationId)
	local previous = findAdminOperation(player, operationId)
	if previous then
		local priorContainer = balanceName == "Wallet" and player:FindFirstChild("leaderstats") or player:FindFirstChild("HiddenStats")
		local priorValue = priorContainer and priorContainer:FindFirstChild(balanceName == "Wallet" and "Wallet" or "Cash")
		return previous.Result == "Applied", priorValue and priorValue.Value or 0, operationId
	end
	local container = balanceName == "Wallet" and player:FindFirstChild("leaderstats") or player:FindFirstChild("HiddenStats")
	local value = container and container:FindFirstChild(balanceName == "Wallet" and "Wallet" or "Cash")
	if not value then return false, "Balance is not loaded" end
	local oldValue = value.Value
	value.Value = math.min(1000000000000000, math.max(0, finiteNumber(value.Value, 0, 0)) + amount)
	appendAdminAudit(player, actorUserId, operationId, "Adjust" .. balanceName, reason, balanceName, amount, "Applied")
	if save(player, false, true) ~= true then
		value.Value = oldValue
		appendAdminAudit(player, actorUserId, operationId, "Adjust" .. balanceName, reason, balanceName, amount, "RolledBack")
		return false, "Admin balance save failed", operationId
	end
	return true, value.Value, operationId
end


local function playerTransferKey(receiverUserId)
	return "Receiver_" .. tostring(math.floor(tonumber(receiverUserId) or 0))
end

local function sanitizePlayerTransferEntry(raw)
	if type(raw) ~= "table" then return nil end
	local operationId = type(raw.OperationId) == "string" and string.sub(raw.OperationId, 1, 160) or nil
	local itemId = type(raw.ItemId) == "string" and raw.ItemId or nil
	local toolId = type(raw.ToolId) == "string" and string.sub(raw.ToolId, 1, 100) or nil
	local giverUserId = math.floor(tonumber(raw.GiverUserId) or 0)
	local receiverUserId = math.floor(tonumber(raw.ReceiverUserId) or 0)
	if not validPersistentId(operationId) or not validPersistentId(itemId) or not toolId
		or not safeFindCarTool(toolId) or giverUserId <= 0 or receiverUserId <= 0
	then return nil end
	return {
		OperationId = operationId, ItemId = itemId, ToolId = toolId,
		GiverUserId = giverUserId, ReceiverUserId = receiverUserId,
		GiverName = type(raw.GiverName) == "string" and string.sub(raw.GiverName, 1, 80) or "Player",
		ReceiverName = type(raw.ReceiverName) == "string" and string.sub(raw.ReceiverName, 1, 80) or "Player",
		Status = raw.Status == "Delivered" and "Delivered"
			or (raw.Status == "SourceCommitted" and "SourceCommitted" or "Prepared"),
		CreatedAt = math.max(0, math.floor(tonumber(raw.CreatedAt) or os.time())),
		SourceCommittedAt = math.max(0, math.floor(tonumber(raw.SourceCommittedAt) or 0)),
		DeliveredAt = math.max(0, math.floor(tonumber(raw.DeliveredAt) or 0)),
	}
end

local function sanitizePlayerTransferLedger(raw)
	local ledger = { Entries = {}, UpdatedAt = os.time() }
	if type(raw) ~= "table" or type(raw.Entries) ~= "table" then return ledger end
	local active, completed = {}, {}
	for operationId, rawEntry in pairs(raw.Entries) do
		local entry = sanitizePlayerTransferEntry(rawEntry)
		if entry and operationId == entry.OperationId then
			if entry.Status == "Delivered" then table.insert(completed, entry)
			else table.insert(active, entry) end
		end
	end
	for _, entry in ipairs(active) do ledger.Entries[entry.OperationId] = entry end
	table.sort(completed, function(a, b) return a.DeliveredAt > b.DeliveredAt end)
	local capacity = math.max(0, MAX_PLAYER_CAR_TRANSFERS - #active)
	for index, entry in ipairs(completed) do
		if index > capacity then break end
		if entry.DeliveredAt >= os.time() - PLAYER_CAR_TRANSFER_RETENTION_SECONDS then
			ledger.Entries[entry.OperationId] = entry
		end
	end
	return ledger
end

local function queuePlayerCarTransfer(entry)
	entry = sanitizePlayerTransferEntry(entry)
	if not entry then return false, "Invalid transfer operation" end
	local ok, result = pcall(function()
		return PlayerCarTransferStore:UpdateAsync(playerTransferKey(entry.ReceiverUserId), function(old)
			local ledger = sanitizePlayerTransferLedger(old)
			local existing = ledger.Entries[entry.OperationId]
			if existing then
				if existing.ItemId ~= entry.ItemId or existing.GiverUserId ~= entry.GiverUserId
					or existing.ReceiverUserId ~= entry.ReceiverUserId
				then return nil end
				return ledger
			end
			local activeCount = 0
			for _, queued in pairs(ledger.Entries) do
				if queued.Status ~= "Delivered" then activeCount += 1 end
			end
			if activeCount >= MAX_PLAYER_CAR_TRANSFERS then return nil end
			ledger.Entries[entry.OperationId] = entry
			ledger.UpdatedAt = os.time()
			return ledger
		end)
	end)
	local saved = ok and type(result) == "table" and result.Entries and result.Entries[entry.OperationId]
	return saved ~= nil, saved or "Transfer queue unavailable"
end

local function markPlayerCarTransfer(receiverUserId, operationId, status)
	local changed = false
	local ok = pcall(function()
		PlayerCarTransferStore:UpdateAsync(playerTransferKey(receiverUserId), function(old)
			changed = false
			local ledger = sanitizePlayerTransferLedger(old)
			local entry = ledger.Entries[operationId]
			if not entry then return ledger end
			if status == "SourceCommitted" and entry.Status == "Prepared" then
				entry.Status = status
				entry.SourceCommittedAt = os.time()
				changed = true
			elseif status == "Delivered" and entry.Status == "SourceCommitted" then
				entry.Status = status
				entry.DeliveredAt = os.time()
				changed = true
			elseif entry.Status == status then
				changed = true
			end
			ledger.UpdatedAt = os.time()
			return ledger
		end)
	end)
	return ok and changed
end

local function outgoingMarkerMatches(raw, entry)
	local outgoing = sanitizeOutgoingCarTransfers(raw)
	local marker = outgoing[entry.OperationId]
	return marker ~= nil and marker.ItemId == entry.ItemId and marker.ToolId == entry.ToolId
		and marker.ReceiverUserId == entry.ReceiverUserId
end

local function verifyTransferSourceCommitted(entry)
	local giver = Players:GetPlayerByUserId(entry.GiverUserId)
	local localSession = giver and SessionData[giver]
	if localSession and localSession.DurableOutgoingCarTransfers
		and localSession.DurableOutgoingCarTransfers[entry.OperationId]
	then
		return outgoingMarkerMatches(localSession.OutgoingCarTransfers, entry)
	end
	local ok, profile = pcall(function()
		return PlayerDataStore:GetAsync("User_V27_" .. tostring(entry.GiverUserId))
	end)
	return ok and type(profile) == "table" and outgoingMarkerMatches(profile.OutgoingCarTransfers, entry)
end

local function deliverPendingPlayerCarTransfers(receiver)
	if not receiver or receiver.Parent ~= Players or receiver:GetAttribute(DATA_READY_ATTRIBUTE) ~= true then
		return false, 0, "Receiver profile is not ready"
	end
	local ok, raw = pcall(function()
		return PlayerCarTransferStore:GetAsync(playerTransferKey(receiver.UserId))
	end)
	if not ok then return false, 0, "Transfer queue unavailable" end
	local ledger = sanitizePlayerTransferLedger(raw)
	local entries = {}
	for _, entry in pairs(ledger.Entries) do
		if entry.Status ~= "Delivered" then table.insert(entries, entry) end
	end
	table.sort(entries, function(a, b) return a.CreatedAt < b.CreatedAt end)

	local deliveredCount = 0
	for _, entry in ipairs(entries) do
		if entry.ReceiverUserId ~= receiver.UserId then continue end
		if entry.Status == "Prepared" then
			if not verifyTransferSourceCommitted(entry) then continue end
			if not markPlayerCarTransfer(receiver.UserId, entry.OperationId, "SourceCommitted") then continue end
			entry.Status = "SourceCommitted"
		end
		local granted, grantMessage = giveTool(receiver, entry.ToolId, {
			ItemId = entry.ItemId,
			BypassStorageLimit = true,
			Source = "PlayerCarTransfer",
			TransferOperationId = entry.OperationId,
			GiftSenderUserId = entry.GiverUserId,
			GiftReceiverUserId = entry.ReceiverUserId,
		})
		if not granted then
			warn("[TycoonDataHandler] Pending player-car transfer grant failed: " .. tostring(grantMessage))
			continue
		end
		if save(receiver, false, true) ~= true then continue end
		local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
		if not rankApi or not rankApi:IsA("BindableFunction") then continue end
		local rankOk, rankRecorded = pcall(function()
			return rankApi:Invoke("CarGiftReceived", receiver, entry.GiverUserId, entry.ToolId, entry.OperationId)
		end)
		if not rankOk or rankRecorded ~= true then continue end
		if not markPlayerCarTransfer(receiver.UserId, entry.OperationId, "Delivered") then continue end
		deliveredCount += 1
	end
	return true, deliveredCount, #entries - deliveredCount
end

local function transferToolBetweenPlayers(giver, receiver, tool, operationId)
	if not giver or not receiver or not tool then
		return false, "Gift failed: Missing transfer data."
	end

	if giver == receiver then
		return false, "You cannot gift yourself."
	end

	if giver.Parent ~= Players or receiver.Parent ~= Players then
		return false, "Player has left the game."
	end

	local giverSession = SessionData[giver]
	if not giverSession or not giverSession.DataLoaded then
		return false, "Your data is still loading."
	end

	local receiverSession = SessionData[receiver]
	if not receiverSession or not receiverSession.DataLoaded then
		return false, "This player's data is still loading."
	end

	-- Final server-authoritative Receive Gifts guard. This protects against stale
	-- gift sessions, remote spoofing, and any direct AdminAPI TransferTool calls.
	if not hasReceiveGiftsEnabled(giver) then
		return false, RECEIVE_GIFTS_DISABLED_SELF_TEXT, nil
	end

	if not hasReceiveGiftsEnabled(receiver) then
		return false, receiver.DisplayName .. " has Receive Gifts disabled.", RECEIVE_GIFTS_DISABLED_RECEIVER_TEXT
	end

	if not validateTool(tool) then
		return false, "Gift failed: Invalid car tool."
	end

	local toolId = tool:GetAttribute("ToolId")
	local itemId = tool:GetAttribute("ItemId")
	operationId = validPersistentId(operationId) and operationId or HttpService:GenerateGUID(false)
	if tool.Parent ~= giver.Character and tool.Parent ~= giver:FindFirstChild("Backpack") then
		return false, "Gift failed: Car tool missing."
	end

	if not canAddCarToStorage(receiver, 1) then
		return false, receiver.DisplayName .. " has full car storage.", "Your car storage is full."
	end

	local giverSession = SessionData[giver]
	giverSession.OutgoingCarTransfers = sanitizeOutgoingCarTransfers(giverSession.OutgoingCarTransfers)
	local outgoingCount = 0
	for _ in pairs(giverSession.OutgoingCarTransfers) do outgoingCount += 1 end
	if not giverSession.OutgoingCarTransfers[operationId] and outgoingCount >= MAX_PLAYER_CAR_TRANSFERS then
		return false, "Gift failed: Too many transfers are awaiting reconciliation."
	end
	local queued, queueResult = queuePlayerCarTransfer({
		OperationId = operationId, ItemId = itemId, ToolId = toolId,
		GiverUserId = giver.UserId, ReceiverUserId = receiver.UserId,
		GiverName = giver.Name, ReceiverName = receiver.Name,
		Status = "Prepared", CreatedAt = os.time(),
	})
	if not queued then return false, tostring(queueResult), "Gift delivery queue unavailable." end

	local removed, removeMessage = removeExactToolInstance(giver, itemId, true)
	if not removed then return false, removeMessage or "Gift failed: Car could not be reserved." end
	giverSession.OutgoingCarTransfers[operationId] = {
		ItemId = itemId, ToolId = toolId, ReceiverUserId = receiver.UserId, CreatedAt = os.time(),
	}
	markDirty(giver)
	if save(giver, false, true) ~= true then
		-- The queue remains Prepared and cannot deliver until a later save proves
		-- the source removal and marker together. Do not guess whether a failed
		-- DataStore response committed.
		queueCriticalSave(giver, 2)
		return true, "Gift accepted; secure delivery is still saving.", "Gift delivery is processing.", "Queued"
	end
	giverSession.DurableOutgoingCarTransfers[operationId] = true
	local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
	if rankApi and rankApi:IsA("BindableFunction") then
		local rankOk, rankResult = pcall(function()
			return rankApi:Invoke("CarGiftQueued", giver, receiver.UserId, toolId, operationId)
		end)
		if not rankOk or rankResult ~= true then
			warn("[TycoonDataHandler] Sender gift rank progress could not be recorded for " .. operationId)
		end
	end
	if not markPlayerCarTransfer(receiver.UserId, operationId, "SourceCommitted") then
		return true, "Gift accepted; secure delivery is queued.", "Gift delivery is processing.", "Queued"
	end

	-- The receiver queue is now durable proof that ownership left the giver.
	-- The profile marker can be compacted on the next save.
	giverSession.OutgoingCarTransfers[operationId] = nil
	giverSession.DurableOutgoingCarTransfers[operationId] = nil
	queueCriticalSave(giver, 3)
	local deliveredOk, deliveredCount = deliverPendingPlayerCarTransfers(receiver)
	if deliveredOk and deliveredCount > 0 then
		return true, "Gift delivered.", "Car added to inventory!", "Delivered"
	end
	return true, "Gift accepted; secure delivery is queued.", "Gift delivery is processing.", "Queued"
end

local function removeToolsByAttribute(player, attributeName, attributeValue)
	if not player or type(attributeName) ~= "string" then return 0 end

	local removed = 0
	local function scan(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Tool") and child:GetAttribute(attributeName) == attributeValue then
				child:Destroy()
				removed += 1
			end
		end
	end

	scan(player:FindFirstChild("Backpack"))
	scan(player:FindFirstChild("StarterGear"))
	if player.Character then scan(player.Character) end

	return removed
end

local function getWalletValue(player)
	local leaderstats = player and player:FindFirstChild("leaderstats")
	return leaderstats and leaderstats:FindFirstChild("Wallet") or nil
end

local function sanitizePromoCodeHistory(value)
	local sanitized = {}
	if type(value) ~= "table" then
		return sanitized
	end

	for code, data in pairs(value) do
		if type(code) == "string" and code ~= "" then
			if type(data) == "table" then
				sanitized[code] = {
					RedeemedAt = math.max(0, math.floor(tonumber(data.RedeemedAt) or 0)),
					RewardType = type(data.RewardType) == "string" and data.RewardType or nil,
					RewardAmount = math.max(0, math.floor(tonumber(data.RewardAmount) or 0)),
				}
			elseif data == true then
				sanitized[code] = { RedeemedAt = 0 }
			end
		end
	end

	return sanitized
end

local function claimFreeReward(player, carName, walletCash)
	if not player or not player.Parent then
		return false, "Player missing"
	end
	if not save then
		return false, "Save system unavailable"
	end

	carName = tostring(carName or "")
	walletCash = math.max(0, math.floor(tonumber(walletCash) or 0))

	if carName == "" then
		return false, "Reward car is not configured."
	end

	local session = SessionData[player]
	if not session or not session.DataLoaded then
		return false, "Player data not loaded"
	end

	if player:GetAttribute(FREE_REWARDS_CLAIMED_ATTRIBUTE) == true then
		return false, "You have already claimed this reward."
	end

	if FreeRewardsClaimLocks[player] then
		return false, "Reward claim is already running."
	end

	FreeRewardsClaimLocks[player] = true

	local function finish(ok, message)
		FreeRewardsClaimLocks[player] = nil
		return ok, message
	end

	local wallet = getWalletValue(player)
	if not wallet then
		return finish(false, "Wallet not loaded")
	end

	local originalWallet = wallet.Value
	local claimToken = HttpService:GenerateGUID(false)

	local grantOk, grantMessage = giveTool(player, carName, {
		Source = "FreeRewards",
		BypassStorageLimit = true,
		FreeRewardClaimToken = claimToken,
	})
	if not grantOk then
		return finish(false, grantMessage or "Unable to add the reward car to your inventory.")
	end

	wallet.Value += walletCash
	player:SetAttribute(FREE_REWARDS_CLAIMED_ATTRIBUTE, true)
	markDirty(player)

	local saveOk = save(player, false, true)
	if saveOk then
		return finish(true)
	end

	-- Best-effort rollback. This protects against normal save failures. If the
	-- server process dies mid-claim, the next load still falls back to persisted data.
	wallet.Value = originalWallet
	removeToolsByAttribute(player, "FreeRewardClaimToken", claimToken)
	player:SetAttribute(FREE_REWARDS_CLAIMED_ATTRIBUTE, false)
	markDirty(player)

	return finish(false, "Reward save failed. Please try again.")
end

