-- Purpose: Lucky Spin world trigger, UI presentation, purchases, and cosmetic wheel animation.
-- Location: StarterPlayer > StarterPlayerScripts > LuckySpinClient (LocalScript)
-- Security: Requests contain no reward data; the server response is already granted and authoritative.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Config = require(ReplicatedStorage:WaitForChild("LuckySpinConfig"))
local UIButtonUtils = require(ReplicatedStorage:WaitForChild("UIButtonUtils"))
local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))
local requestSpin = ReplicatedStorage:WaitForChild("LuckySpinRemotes"):WaitForChild("RequestSpin")

local gui = playerGui:WaitForChild("LuckySpinUI")
local mainFrame = gui:WaitForChild("MainFrame")
local buttons = mainFrame:WaitForChild("Buttons")
local spinButton = buttons:WaitForChild("Spin")
local buyOneButton = buttons:WaitForChild("Buyx1")
local buyTenButton = buttons:WaitForChild("Buyx10")
local indicator = mainFrame:WaitForChild("FhiaTokenIndicator")
local tokenCounter = indicator:WaitForChild("TokenCounter")
local tokenButton = indicator:WaitForChild("Token")
local tokenInfo = tokenButton:WaitForChild("FhiaTokenInfo")
local wheel = mainFrame:WaitForChild("SpinWheelDecoration"):WaitForChild("Wheel")
local feedback = UIAudioConfig.CreateStateFeedback(mainFrame)

-- Lucky Spin car wins color only the car name with RichText. StateFeedback is
-- shared by interfaces that use plain text, so opt this interface's success
-- label in explicitly rather than changing every StateLabel in the game.
local stateLabels = mainFrame:FindFirstChild("StateLabels") or mainFrame:FindFirstChild("StateLabels", true)
local successStateLabel = (stateLabels and (stateLabels:FindFirstChild("Success") or stateLabels:FindFirstChild("Sucess")))
	or mainFrame:FindFirstChild("Success")
	or mainFrame:FindFirstChild("Sucess")
	or mainFrame:FindFirstChild("Indicator-purchase", true)
if successStateLabel and (successStateLabel:IsA("TextLabel") or successStateLabel:IsA("TextButton")) then
	successStateLabel.RichText = true
end

local spinBusy = false
local promptBusy = false
local pendingProductId = nil
local idleToken = 0
local triggerConnections = {}
local boundTrigger = nil
local touchingCharacterParts = {}
local manuallyClosedUntilExit = false
local occupancyMonitorToken = 0
local OCCUPANCY_POLL_INTERVAL = 0.1
local FULL_EXIT_GRACE = 0.2
local lastOccupiedAt = 0
local BALANCE_INDICATOR_GUI_NAME = "Balance Indicator"
local BLUR_SIZE = 18
local BLUR_TWEEN_INFO = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local hiddenGuis = {}
local presentationActive = false
local luckySpinBlur = nil
local blurTween = nil
local blurGeneration = 0

local function setButtonEnabled(button, enabled)
	button.Active = enabled
	button.Selectable = enabled
	pcall(function() button.Interactable = enabled end)
end

local function updateTokenCounter()
	tokenCounter.Text = tostring(math.max(0, math.floor(tonumber(player:GetAttribute("FhiaTokens")) or 0)))
end
player:GetAttributeChangedSignal("FhiaTokens"):Connect(updateTokenCounter)
updateTokenCounter()

local function restoreHiddenGuis()
	for hiddenGui in pairs(hiddenGuis) do
		if hiddenGui.Parent then hiddenGui.Enabled = true end
	end
	table.clear(hiddenGuis)
end

local function hideOtherGuis()
	table.clear(hiddenGuis)
	for _, otherGui in ipairs(playerGui:GetDescendants()) do
		if otherGui:IsA("ScreenGui")
			and otherGui ~= gui
			and otherGui.Name ~= BALANCE_INDICATOR_GUI_NAME
			and otherGui.Enabled then
			hiddenGuis[otherGui] = true
			otherGui.Enabled = false
		end
	end
end

local function setBlur(open)
	blurGeneration += 1
	local generation = blurGeneration
	if blurTween then
		blurTween:Cancel()
		blurTween = nil
	end

	if open then
		if not luckySpinBlur or not luckySpinBlur.Parent then
			luckySpinBlur = Instance.new("BlurEffect")
			luckySpinBlur.Name = "LuckySpinBlur"
			luckySpinBlur.Size = 0
			luckySpinBlur.Parent = Lighting
		end
		blurTween = TweenService:Create(luckySpinBlur, BLUR_TWEEN_INFO, { Size = BLUR_SIZE })
		blurTween:Play()
	elseif luckySpinBlur then
		local blurToRemove = luckySpinBlur
		blurTween = TweenService:Create(blurToRemove, BLUR_TWEEN_INFO, { Size = 0 })
		blurTween:Play()
		blurTween.Completed:Connect(function()
			if generation == blurGeneration and not presentationActive and luckySpinBlur == blurToRemove then
				blurToRemove:Destroy()
				luckySpinBlur = nil
				blurTween = nil
			end
		end)
	end
end

local function setPresentationActive(open)
	if presentationActive == open then return end
	presentationActive = open
	if open then
		hideOtherGuis()
	else
		restoreHiddenGuis()
	end
	setBlur(open)
end

local function setOpen(open)
	-- Do not let trigger exits or another UI controller hide the wheel while its
	-- result animation is running. The server has already committed the reward,
	-- so keeping the presentation visible prevents players from missing the win.
	if not open and spinBusy then return end
	-- UI isolation controllers can temporarily disable ScreenGuis. A real trigger
	-- entry must be able to restore this UI instead of only changing a hidden
	-- MainFrame's Visible property.
	if open and gui:IsA("ScreenGui") then gui.Enabled = true end
	mainFrame.Visible = open
	setPresentationActive(open)
	SoundService:SetAttribute("LuckySpinMusicActive", open)
	if not open then tokenInfo.Visible = false end
	idleToken += 1
	if open and not spinBusy then
		local token = idleToken
		task.spawn(function()
			while token == idleToken and mainFrame.Visible and not spinBusy do
				wheel.Rotation = (wheel.Rotation + 0.35) % 360
				task.wait(0.03)
			end
		end)
	end
end

local function isCharacterPart(instance)
	local character = player.Character
	return character ~= nil and instance:IsA("BasePart") and instance:IsDescendantOf(character)
end

local function isInsideTrigger()
	return next(touchingCharacterParts) ~= nil
end

local function closeManually()
	if spinBusy then return end
	-- Keep the UI suppressed until every body part has actually left. Lingering
	-- Touched events from another limb therefore cannot reopen it immediately.
	manuallyClosedUntilExit = isInsideTrigger()
	setOpen(false)
end

local closeButton = mainFrame:FindFirstChild("ExitButton", true)
	or mainFrame:FindFirstChild("Close", true)
	or mainFrame:FindFirstChild("Exit", true)
	or mainFrame:FindFirstChild("CloseButton", true)
if closeButton and closeButton:IsA("GuiButton") then
	UIButtonUtils.SetupButton(closeButton, closeManually)
else
	warn("[LuckySpinClient] LuckySpinUI MainFrame needs an ExitButton, Close, Exit, or CloseButton GuiButton")
end

UIButtonUtils.SetupHoverInfo(tokenButton, tokenInfo)
local function beginPurchase(productId)
	if promptBusy then return end
	promptBusy, pendingProductId = true, productId
	setButtonEnabled(buyOneButton, false)
	setButtonEnabled(buyTenButton, false)
	UIAudioConfig.PlayRobux()
	UIAudioConfig.ShowPurchaseLoading()
	local ok = pcall(function() MarketplaceService:PromptProductPurchase(player, productId) end)
	if not ok then
		promptBusy, pendingProductId = false, nil
		UIAudioConfig.HidePurchaseLoading()
		setButtonEnabled(buyOneButton, true)
		setButtonEnabled(buyTenButton, true)
		feedback:Failed("Purchase Failed")
		UIAudioConfig.PlayNamed("BuyFail")
	end
end

UIButtonUtils.SetupButton(buyOneButton, function() beginPurchase(Config.ProductIds.Buyx1) end, { SuppressClickSound = true })
UIButtonUtils.SetupButton(buyTenButton, function() beginPurchase(Config.ProductIds.Buyx10) end, { SuppressClickSound = true })

MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId)
	if userId ~= player.UserId or productId ~= pendingProductId then return end
	promptBusy, pendingProductId = false, nil
	UIAudioConfig.HidePurchaseLoading()
	setButtonEnabled(buyOneButton, true)
	setButtonEnabled(buyTenButton, true)
end)

local giftResult = ReplicatedStorage:WaitForChild("GiftRemotes"):WaitForChild("GiftPurchaseResult")
giftResult.OnClientEvent:Connect(function(payload)
	if type(payload) ~= "table" or not Config.ProductTokens[tonumber(payload.ProductId)] then return end
	promptBusy, pendingProductId = false, nil
	UIAudioConfig.HidePurchaseLoading()
	setButtonEnabled(buyOneButton, true)
	setButtonEnabled(buyTenButton, true)
	if payload.Success then
		feedback:Success(payload.Message or "Successfully purchased Fhia Tokens!")
		UIAudioConfig.PlayNamed("BuySuccess")
	else
		feedback:Failed(payload.Message or "Purchase Failed")
		UIAudioConfig.PlayNamed("BuyFail")
	end
end)

local function chooseLanding(segment, wrapped)
	local margin = 2
	local first, second = tonumber(segment[1]), tonumber(segment[2])
	if wrapped then
		local span = (second + 360) - first
		local angle = first + margin + math.random() * (span - margin * 2)
		return angle > 180 and angle - 360 or angle
	end
	local low, high = math.min(first, second), math.max(first, second)
	return low + margin + math.random() * ((high - low) - margin * 2)
end

local function rewardMessage(result)
	if result.RewardType == "Wallet" then return "Congratulations! You won " .. result.DisplayName .. "!" end
	local color = tostring(Config.RarityColors[result.Tier] or "#FFFFFF")
	if not color:match("^#%x%x%x%x%x%x$") then color = "#FFFFFF" end
	local displayName = tostring(result.DisplayName or "Car")
		:gsub("&", "&amp;")
		:gsub("<", "&lt;")
		:gsub(">", "&gt;")
		:gsub('"', "&quot;")
		:gsub("'", "&apos;")
	local destination = result.Delivery == "Inbox"
		and " Your inventory is full, so it has been saved in your reward inbox."
		or " It has been added to your inventory."
	return ('Congratulations! You won <font color="%s">%s</font>!%s')
		:format(color, displayName, destination)
end

local function animateResult(result)
	idleToken += 1
	local landing = chooseLanding(result.VisualSegment, result.WrappedSegment)
	local current = wheel.Rotation
	local normalizedCurrent = current % 360
	local normalizedLanding = landing % 360
	local forwardDelta = (normalizedLanding - normalizedCurrent) % 360
	local duration = math.clamp(tonumber(result.AnimationDuration) or 4, 3, 5)
	local turns = math.random(5, 8)
	local target = current + turns * 360 + forwardDelta
	local tween = TweenService:Create(wheel, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Rotation = target })
	tween:Play()
	tween.Completed:Wait()
	wheel.Rotation = landing
	task.wait(0.5)
	UIAudioConfig.PlayLuckySpinWin()
	feedback:Success(rewardMessage(result))
end

UIButtonUtils.SetupButton(spinButton, function()
	if spinBusy then feedback:Failed("A spin is already in progress!") return end
	spinBusy = true
	setButtonEnabled(spinButton, false)
	if closeButton and closeButton:IsA("GuiButton") then setButtonEnabled(closeButton, false) end
	idleToken += 1
	local ok, result = pcall(function() return requestSpin:InvokeServer() end)
	if ok and type(result) == "table" and result.Success then
		animateResult(result)
	else
		feedback:Failed(type(result) == "table" and result.Message or "Unable to process your spin. Please try again.")
	end
	spinBusy = false
	setButtonEnabled(spinButton, true)
	if closeButton and closeButton:IsA("GuiButton") then setButtonEnabled(closeButton, true) end
	if mainFrame.Visible then setOpen(isInsideTrigger()) end
end)

local function bindTrigger(trigger)
	if trigger == boundTrigger or not trigger:IsA("BasePart") then return end
	for _, connection in ipairs(triggerConnections) do connection:Disconnect() end
	table.clear(triggerConnections)
	table.clear(touchingCharacterParts)
	manuallyClosedUntilExit = false
	occupancyMonitorToken += 1
	lastOccupiedAt = os.clock()
	boundTrigger = trigger

	local function characterCanOpen()
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		return humanoid ~= nil and humanoid.Health > 0
	end

	local function reconcileTouchingParts()
		local current = {}
		local parts = nil
		local character = player.Character
		if character then
			local overlapParams = OverlapParams.new()
			overlapParams.FilterType = Enum.RaycastFilterType.Include
			overlapParams.FilterDescendantsInstances = { character }
			local ok, result = pcall(function()
				return Workspace:GetPartsInPart(trigger, overlapParams)
			end)
			if ok then parts = result end
		end
		if not parts then
			local ok, result = pcall(function() return trigger:GetTouchingParts() end)
			parts = ok and result or {}
		end

		for _, part in ipairs(parts) do
			if isCharacterPart(part) then current[part] = true end
		end
		touchingCharacterParts = current

		if isInsideTrigger() then
			lastOccupiedAt = os.clock()
			if not manuallyClosedUntilExit and not mainFrame.Visible and characterCanOpen() then
				setOpen(true)
			end
			return
		end

		-- One empty physics sample can occur while R6/R15 limbs exchange contact.
		-- Only a continuously empty trigger counts as a full exit and releases the
		-- manual-close latch.
		if os.clock() - lastOccupiedAt >= FULL_EXIT_GRACE then
			manuallyClosedUntilExit = false
			if mainFrame.Visible then setOpen(false) end
		end
	end

	table.insert(triggerConnections, trigger.Touched:Connect(function(hit)
		if isCharacterPart(hit) then task.defer(reconcileTouchingParts) end
	end))

	table.insert(triggerConnections, trigger.TouchEnded:Connect(function(hit)
		if not touchingCharacterParts[hit] then return end
		task.defer(reconcileTouchingParts)
	end))

	table.insert(triggerConnections, trigger.AncestryChanged:Connect(function()
		if boundTrigger == trigger and not trigger:IsDescendantOf(Workspace) then
			for _, connection in ipairs(triggerConnections) do connection:Disconnect() end
			table.clear(triggerConnections)
			table.clear(touchingCharacterParts)
			manuallyClosedUntilExit = false
			occupancyMonitorToken += 1
			boundTrigger = nil
			if mainFrame.Visible then setOpen(false) end
		end
	end))

	-- Touched is edge-triggered and can be missed when this LocalScript or a
	-- streamed TriggerPart arrives after the character is already overlapping it.
	-- Continuous reconciliation is the source of truth; touch signals only make
	-- it react before the next poll.
	local monitorToken = occupancyMonitorToken
	task.spawn(function()
		while monitorToken == occupancyMonitorToken and boundTrigger == trigger and trigger:IsDescendantOf(Workspace) do
			reconcileTouchingParts()
			task.wait(OCCUPANCY_POLL_INTERVAL)
		end
	end)
end

player.CharacterRemoving:Connect(function()
	table.clear(touchingCharacterParts)
	manuallyClosedUntilExit = false
	occupancyMonitorToken += 1
	if mainFrame.Visible then setOpen(false) end
end)

player.CharacterAdded:Connect(function()
	table.clear(touchingCharacterParts)
	manuallyClosedUntilExit = false
	lastOccupiedAt = os.clock()
end)

local function inspectWorldChild(instance)
	if instance.Name == "TriggerPart" and instance.Parent and instance.Parent.Name == "SpinWheel" then bindTrigger(instance) end
end
local existingWheel = Workspace:FindFirstChild("SpinWheel")
local existingTrigger = existingWheel and existingWheel:FindFirstChild("TriggerPart")
if existingTrigger then inspectWorldChild(existingTrigger) end
Workspace.DescendantAdded:Connect(inspectWorldChild)

mainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
	setPresentationActive(mainFrame.Visible)
	SoundService:SetAttribute("LuckySpinMusicActive", mainFrame.Visible)
	if not mainFrame.Visible then tokenInfo.Visible = false; idleToken += 1 end
end)
setOpen(false)
