-- ( LOCAL SCRIPT: HelpButton - PC HOVER SFX / MOBILE TAP SFX )
-- Features: PC hears sound on Hover (not click), Mobile hears sound on Tap.
-- Updated to use the centralized UIAudioConfig ModuleScript.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

-- Require the centralized audio module
local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local button = script.Parent
local helpLabel = button:WaitForChild("HelpLabel", 5)

-- ⚙️ CONFIGURATION
local DIM_COLOR = Color3.new(0.7, 0.7, 0.7) 
local ORIGINAL_COLOR = button.ImageColor3 

-- ⚡ ANIMATION SPEED
local PRESS_SPEED = 0.05 
local RELEASE_SPEED = 0.2

if not helpLabel then
	warn("⚠️ HelpLabel missing inside HelpButton!")
else
	helpLabel.Visible = false
	helpLabel.ZIndex = button.ZIndex + 1 
end

-- ============================================================================
-- 🛠️ EFFECTS FUNCTIONS
-- ============================================================================

local function dimButton()
	TweenService:Create(button, TweenInfo.new(PRESS_SPEED), {ImageColor3 = DIM_COLOR}):Play()
end

local function resetButton()
	TweenService:Create(button, TweenInfo.new(RELEASE_SPEED), {ImageColor3 = ORIGINAL_COLOR}):Play()
end

-- ============================================================================
-- 🖱️ DESKTOP INTERACTION (Hover SFX Only)
-- ============================================================================

-- 1. HOVER ENTER (PC Only)
button.MouseEnter:Connect(function()
	-- Ignore if on mobile (prevents weirdness)
	if UserInputService.TouchEnabled then return end 

	UIAudioConfig.PlayHover() -- ✅ Centralized Hover SFX for PC
	dimButton()
	if helpLabel then helpLabel.Visible = true end
end)

-- 2. HOVER LEAVE (PC Only)
button.MouseLeave:Connect(function()
	if UserInputService.TouchEnabled then return end

	resetButton()
	if helpLabel then helpLabel.Visible = false end
end)

-- 3. MOUSE DOWN (PC Click Visuals)
button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		-- No Sound Here for PC (Requested Fix)
		dimButton() 
	end
end)

-- 4. MOUSE UP (PC Click Visuals)
button.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		-- We keep it dimmed if they are still hovering, but reset if not?
		-- For simplicity, we usually let MouseLeave handle the reset, 
		-- but to ensure snappy visuals we can force reset or keep current state.
		-- If we reset here, it might flash while hovering. 
		-- Since MouseEnter handles the dim, we can leave this visual-only or empty.
	end
end)

-- ============================================================================
-- 📱 MOBILE INTERACTION (Tap SFX)
-- ============================================================================

button.MouseButton1Click:Connect(function()
	-- We use this specifically for Mobile Taps
	if UserInputService.TouchEnabled then
		UIAudioConfig.PlayClick() -- ✅ Centralized Click SFX for Mobile Taps
		if helpLabel then
			helpLabel.Visible = not helpLabel.Visible
		end
	end
end)
