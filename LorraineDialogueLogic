end)

-- ============================================================================
-- 🧠 CONFIRMATION UI
-- ============================================================================

local function clearConfirmationConnections()
	for _, c in ipairs(confirmConnections) do
		if c then
			c:Disconnect()
		end
	end

	confirmConnections = {}
end

local function addConfirmationConnection(conn)
	if conn then
		table.insert(confirmConnections, conn)
	end
end

local function resolveConfirmationUi()
	local cGui = playerGui:FindFirstChild("Confirmation") or playerGui:WaitForChild("Confirmation", 5)
	if not cGui then
		return nil, nil
	end

	local cMain = cGui:FindFirstChild("MainFrame") or cGui:WaitForChild("MainFrame", 5)

	return cGui, cMain
end

local function resolveGuiButton(target)
	if not target then
		return nil
	end

	if target:IsA("GuiButton") then
		return target
	end

	for _, d in ipairs(target:GetDescendants()) do
		if d:IsA("GuiButton") then
			return d
		end
	end

	return nil
end

local function resolveNamedConfirmationButton(root, exactName, aliases)
	if not root then
		return nil
	end

	local direct = resolveGuiButton(root:FindFirstChild(exactName, true))
	if direct then
		return direct
	end

	local lowered = { string.lower(exactName) }

	for _, a in ipairs(aliases or {}) do
		table.insert(lowered, string.lower(a))
	end

	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiButton") then
			local buttonName = string.lower(d.Name)

			for _, keyword in ipairs(lowered) do
				if buttonName == keyword or string.find(buttonName, keyword, 1, true) then
					return d
				end
			end
		end
	end

	return nil
end

local function playConfirmationOpenTween(cMain)
	if not cMain or not cMain:IsA("GuiObject") then
		return
	end

	if not cMain:GetAttribute("BasePosStored") then
		cMain:SetAttribute("BasePosStored", true)
		cMain:SetAttribute("BasePosXScale", cMain.Position.X.Scale)
		cMain:SetAttribute("BasePosXOffset", cMain.Position.X.Offset)
		cMain:SetAttribute("BasePosYScale", cMain.Position.Y.Scale)
		cMain:SetAttribute("BasePosYOffset", cMain.Position.Y.Offset)
	end

	local basePosition = UDim2.new(
		cMain:GetAttribute("BasePosXScale"),
		cMain:GetAttribute("BasePosXOffset"),
		cMain:GetAttribute("BasePosYScale"),
		cMain:GetAttribute("BasePosYOffset")
	)

	cMain.Position = UDim2.new(
		basePosition.X.Scale,
		basePosition.X.Offset,
		basePosition.Y.Scale,
		basePosition.Y.Offset + 18
	)

	TweenService:Create(
		cMain,
		TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = basePosition }
	):Play()
end

local function applyConfirmationButtonFeedback(button)
	if not button then
		return nil
	end

	local uiScale = getOrCreateUIScale(button)
	if not uiScale then
		return button
	end

	local isHovering = false
	local isPressed = false

	local function updateScale()
		local targetScale = NORMAL_SCALE

		if isPressed then
			targetScale = CLICK_SCALE
		elseif isHovering then
			targetScale = HOVER_SCALE
		end

		TweenService:Create(uiScale, BUTTON_TWEEN_INFO, {
			Scale = targetScale,
		}):Play()
	end

	addConfirmationConnection(button.MouseEnter:Connect(function()
		if not button.Active then
			return
		end

		isHovering = true
		UIAudioConfig.PlayHover()
		updateScale()
	end))

	addConfirmationConnection(button.MouseLeave:Connect(function()
		isHovering = false
		isPressed = false
		updateScale()
	end))

	addConfirmationConnection(button.InputBegan:Connect(function(input)
		if not button.Active then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			isPressed = true
			updateScale()
		end
	end))

	addConfirmationConnection(button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			isPressed = false

			if UserInputService.TouchEnabled then
				isHovering = false
			end

			updateScale()
		end
	end))

	return button
end

local function bindConfirmationButton(button, callback)
	if not button then
		return
	end

	button.Active = true
	button.AutoButtonColor = false

	pcall(function()
		button.Interactable = true
	end)

	applyConfirmationButtonFeedback(button)

	local fired = false

	addConfirmationConnection(button.Activated:Connect(function()
		if fired or not button.Active then
			return
		end

		fired = true

		UIAudioConfig.PlayClick()

		button.Active = false

		pcall(function()
			button.Interactable = false
		end)

		callback()
	end))
end

local function PromptConfirmation(text, callback)
	local cGui, cMain = resolveConfirmationUi()

	if not cGui or not cMain then
		callback(false)
		return
	end

	clearConfirmationConnections()

	local infoLabel = cMain:FindFirstChild("Information", true)
	local btnYes = resolveNamedConfirmationButton(cMain, "Yes", { "Confirm", "Accept", "Okay", "Ok" })
	local btnNo = resolveNamedConfirmationButton(cMain, "No", { "Cancel", "Decline", "Back", "Close" })

	if infoLabel then
		pcall(function()
			infoLabel.RichText = true
			infoLabel.TextWrapped = true
			infoLabel.Text = text
		end)
	end

	local _, container = getUIElements()

	if container then
		container.Visible = false
	end

	cGui.Enabled = true

	if cMain:IsA("GuiObject") then
		cMain.Visible = true
		cMain.Active = true
	end

	pcall(function()
		if cGui:IsA("ScreenGui") then
			cGui.DisplayOrder = math.max(cGui.DisplayOrder, 100)
		end
	end)

	playConfirmationOpenTween(cMain)

	local function finishChoice(confirmed)
		clearConfirmationConnections()

		if cMain:IsA("GuiObject") then
			cMain.Visible = false
		end

		cGui.Enabled = false

		if container and isInteracting then
			container.Visible = true
		end

		callback(confirmed)
	end

	bindConfirmationButton(btnYes, function()
		finishChoice(true)
	end)

	bindConfirmationButton(btnNo, function()
		finishChoice(false)
	end)
end

-- ============================================================================
-- 💰 SELL HELPERS
-- ============================================================================

local function FormatCommas(num)
	return tostring(num):reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", "")
end

local function getSellableInventoryValue()
	local totalValue = 0
	local totalCount = 0
	local seen = {}

	local function scan(container)
		if not container then
			return
		end

		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Tool")
				and child:GetAttribute("IssuedByServer") == true
				and not seen[child] then

				local toolId = child:GetAttribute("ToolId") or child.Name
				local details = CarSellPrices.GetDetails(toolId)

				if details and details.SellPrice and details.SellPrice > 0 then
					seen[child] = true
					totalValue += details.SellPrice
					totalCount += 1
				end
			end
		end
	end

	scan(player:FindFirstChild("Backpack"))

	if player.Character then
		scan(player.Character)
	end

	return totalValue, totalCount
end

-- ============================================================================
-- 🗣️ DIALOGUE ACTIONS
-- ============================================================================

local function handleSellEverything(dialogueLabel)
	if isProcessingSell then
		return
	end

	local totalValue, carCount = getSellableInventoryValue()

	if carCount <= 0 or totalValue <= 0 then
		typewrite(dialogueLabel, DIALOGUE.NoCars, function()
			task.wait(2)
			stopInteraction()
		end)

		return
	end

	isProcessingSell = true

	local carWord = carCount == 1 and "car" or "cars"

	local confirmText = string.format(
		"<font color='%s'>Are you sure you want to sell all </font><b>%d %s</b><font color='%s'> for </font><b><font color='%s'>$%s</font></b><font color='%s'>? This cannot be undone, sweetie.</font>",
		CONFIRMATION_COLORS.Accent,
		carCount,
		carWord,
		CONFIRMATION_COLORS.Accent,
		CONFIRMATION_COLORS.Sacrifice,
		FormatCommas(totalValue),
		CONFIRMATION_COLORS.Accent
	)

	PromptConfirmation(confirmText, function(confirmed)
		if not isInteracting then
			return
		end

		if not confirmed then
			typewrite(dialogueLabel, DIALOGUE.Cancel, function()
				isProcessingSell = false
				task.wait(1.5)
				stopInteraction()
			end)

			return
		end

		task.spawn(function()
			local success, msg, serverSellAmount, serverCarCount
			local invokeCompleted = false

			local invokeThread = task.spawn(function()
				success, msg, serverSellAmount, serverCarCount = SellFunction:InvokeServer("SellAllCars")
				invokeCompleted = true
			end)

			local elapsed = 0
			local timeoutLimit = 10

			while not invokeCompleted and elapsed < timeoutLimit do
				elapsed += task.wait()
			end

			if not invokeCompleted then
				pcall(task.cancel, invokeThread)
				warn("⚠️ LorraineSellFunction InvokeServer timed out.")

				success = false
				msg = "The server is taking too long to respond."
			end

			if not isInteracting then
				return
			end

			if success then
				UIAudioConfig.PlayClick()

				local soldCount = tonumber(serverCarCount) or carCount
				local soldAmount = tonumber(serverSellAmount) or totalValue
				local soldWord = soldCount == 1 and "car" or "cars"

				typewrite(dialogueLabel, string.format(DIALOGUE.Success, soldCount, soldWord, FormatCommas(soldAmount)), function()
					isProcessingSell = false
					task.wait(1.5)
					stopInteraction()
				end)
			else
				typewrite(dialogueLabel, DIALOGUE.ErrorPrefix .. (msg or "Please try again later."), function()
					isProcessingSell = false
					task.wait(2)
					stopInteraction()
				end)
			end
		end)
	end)
end

-- ============================================================================
-- 🟢 MAIN INTERACTION START
-- ============================================================================

local function startInteraction(npcModel)
	if isInteracting or isLeaving or promptDebounce then
		return
	end

	promptDebounce = true

	-- Hard cleanup from previous interaction.
	stopInteraction()

	isInteracting = true
	isLeaving = false
	isProcessingSell = false
	promptDebounce = true

	clearConnections()

	local camPart = npcModel:FindFirstChild(CAMERA_PART)

	if not camPart then
		warn("❌ [LorraineDebug] Error: Missing '" .. CAMERA_PART .. "'")
		stopInteraction()
		return
	end

	if controls then
		controls:Disable()
	end

	setFocusMode(true)

	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable

	TweenService:Create(camera, CAMERA_TWEEN_INFO, {
		CFrame = camPart.CFrame,
	}):Play()

	local myGui = playerGui:WaitForChild(GUI_ID, 5)

	if not myGui then
		warn("❌ [LorraineDebug] Missing GUI")
		stopInteraction()
		return
	end

	local _, container, dialogueLabel, buttonsFrame, sellVisual, sellButton, leaveVisual, leaveButton = getUIElements()

	if not container then
		warn("❌ [LorraineDebug] Missing Frame")
		stopInteraction()
		return
	end

	-- Critical:
	-- Hide buttons BEFORE enabling/showing the dialogue.
	-- This prevents Btn_SellEverything from appearing first.
	if buttonsFrame and buttonsFrame:IsA("GuiObject") then
		buttonsFrame.Visible = false
	end

	setButtonsState(false)

	myGui.Enabled = true
	container.Visible = true

	setButtonsState(false)

	if not dialogueLabel then
		warn("❌ [LorraineDebug] ERROR: Could not find TextLabel named '" .. TEXT_ID .. "' inside Container!")
		setButtonsState(true)
		return
	end

	if not sellButton then
		warn("⚠️ [LorraineDebug] Could not find real GuiButton inside '" .. BTN_SELL_EVERYTHING_ID .. "'.")
	end

	if not leaveButton then
		warn("⚠️ [LorraineDebug] Could not find real GuiButton inside '" .. BTN_LEAVE_ID .. "'.")
	end

	typewrite(dialogueLabel, DIALOGUE.Greeting, function()
		task.wait(DIALOGUE_PAUSE)
		setButtonsState(true)
	end)

	bindDialogueButton(leaveVisual, leaveButton, function()
		if isLeaving then
			return
		end

		isLeaving = true
		clearConnections()
		setButtonsState(false)

		typewrite(dialogueLabel, DIALOGUE.Goodbye, function()
			task.wait(LEAVE_DELAY)
			stopInteraction()
		end)
	end)

	bindDialogueButton(sellVisual, sellButton, function()
		handleSellEverything(dialogueLabel)
	end)
end

-- ============================================================================
-- 🔌 PROXIMITY PROMPT SETUP
-- ============================================================================

local function isTargetPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		return false
	end

	return string.lower(prompt.Name) == string.lower(PROMPT_NAME)
end

local function findTargetNPCFromPrompt(prompt)
	local current = prompt and prompt.Parent

	while current do
		if current:IsA("Model") and string.find(current.Name, TARGET_NPC) then
			return current
		end

		current = current.Parent
	end

	return nil
end

local function setupNPC()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, triggerPlayer)
		if triggerPlayer ~= player then
			return
		end

		if not isTargetPrompt(prompt) then
			return
		end

		local npc = findTargetNPCFromPrompt(prompt)

		if npc and string.find(npc.Name, TARGET_NPC) then
			startInteraction(npc)
		end
	end)
end

setupNPC()

player.CharacterAdded:Connect(function()
	stopInteraction()
end)
