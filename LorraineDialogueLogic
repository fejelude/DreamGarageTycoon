-- Purpose: Handles Client UI and NPC Dialogue for Lorraine (Car Sell System).
-- Runs on: Client
-- Location: StarterPlayerScripts.LorraineDialogueLogic
-- Dependencies: TweenService, Players, Workspace, SoundService, UserInputService, ReplicatedStorage
-- Public API: None
-- Networking: Invokes LorraineSellFunction (Client -> Server)
-- Security: Client visual and prompt only. Server authorizes all transaction details.

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))
local CarSellPrices = require(ReplicatedStorage:WaitForChild("CarSellPrices"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

print("🌸 [LorraineDebug] Script Initializing...")

-- ============================================================================
-- 🆔 UNIQUE IDENTIFIERS
-- ============================================================================

local GUI_ID = "UI_NPC_Lorraine"
local CONTAINER_ID = "UI_NPC_Lorraine_Frame_Container"
local TEXT_ID = "Text_Lorraine_Dialogue"
local BUTTONS_FRAME_ID = "Buttons"

local BTN_SELL_EVERYTHING_ID = "Btn_SellEverything"
local BTN_LEAVE_ID = "Btn_Leave"

local TARGET_NPC = "Lorraine"
local CAMERA_PART = "CameraAimPart"
local PROMPT_NAME = "TalkPrompt"

-- ============================================================================
-- ⚙️ SETTINGS
-- ============================================================================

local CAMERA_TWEEN_INFO = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TYPEWRITER_SPEED = 0.02
local DIALOGUE_PAUSE = 1
local LEAVE_DELAY = 1.5

local TYPING_SOUND_ID = "rbxassetid://4676738150"

-- Darrel-style button feedback.
local HOVER_SCALE = 1.05
local CLICK_SCALE = 0.95
local NORMAL_SCALE = 1
local BUTTON_TWEEN_INFO = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

local CONFIRMATION_COLORS = {
	Sacrifice = "#ff5757",
	Target = "#63b3ff",
	Accent = "#f4efe6",
}

local DIALOGUE = {
	Greeting = "Welcome, darling. I can buy every car in your inventory at once.",
	NoCars = "You do not have any cars available to sell right now, darling.",
	Cancel = "No problem, darling. Nothing has been sold.",
	Success = "All set, darling. I bought %d %s from your inventory for $%s.",
	ErrorPrefix = "Oh dear, I could not complete the sale. ",
	Goodbye = "Take care, darling. Come back whenever you are ready to sell.",
}

-- ============================================================================
-- 🛠️ STATE VARIABLES
-- ============================================================================

local isInteracting = false
local isLeaving = false
local isProcessingSell = false
local promptDebounce = false

local currentDialogueJob = nil
local buttonConnections = {}
local buttonHoverConnections = {}
local confirmConnections = {}
local hiddenGuis = {}
local hiddenObjects = {}

local controls = require(player.PlayerScripts:WaitForChild("PlayerModule")):GetControls()
local SellFunction = ReplicatedStorage:WaitForChild("LorraineSellFunction")

-- ============================================================================
-- 🔎 WRAPPER-SAFE UI HELPERS
-- ============================================================================

local function resolveButtonPair(root, objectName)
	if not root then
		return nil, nil
	end

	local visualObject = root:FindFirstChild(objectName, true)
	if not visualObject then
		return nil, nil
	end

	if visualObject:IsA("GuiButton") then
		return visualObject, visualObject
	end

	for _, descendant in ipairs(visualObject:GetDescendants()) do
		if descendant:IsA("GuiButton") then
			return visualObject, descendant
		end
	end

	return visualObject, nil
end

local function getUIElements()
	local myGui = playerGui:FindFirstChild(GUI_ID)
	if not myGui then
		return nil
	end

	local container = myGui:FindFirstChild(CONTAINER_ID, true)
	if not container then
		return myGui, nil
	end

	local dialogueLabel = container:FindFirstChild(TEXT_ID, true)
	local buttonsFrame = container:FindFirstChild(BUTTONS_FRAME_ID, true)

	local sellVisual, sellButton = resolveButtonPair(buttonsFrame, BTN_SELL_EVERYTHING_ID)
	local leaveVisual, leaveButton = resolveButtonPair(buttonsFrame, BTN_LEAVE_ID)

	return myGui, container, dialogueLabel, buttonsFrame, sellVisual, sellButton, leaveVisual, leaveButton
end

local function getOrCreateUIScale(guiObject)
	if not guiObject or not guiObject:IsA("GuiObject") then
		return nil
	end

	local uiScale = guiObject:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Scale = NORMAL_SCALE
		uiScale.Parent = guiObject
	end

	return uiScale
end

local function resetVisualScale(visualObject)
	local uiScale = getOrCreateUIScale(visualObject)
	if not uiScale then
		return
	end

	TweenService:Create(uiScale, TweenInfo.new(0.12, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
		Scale = NORMAL_SCALE,
	}):Play()
end

local function setButtonPairState(visualObject, realButton, isActive)
	if visualObject and visualObject:IsA("GuiObject") then
		visualObject.Visible = isActive

		if not isActive then
			resetVisualScale(visualObject)
		end
	end

	if realButton and realButton:IsA("GuiButton") then
		realButton.Active = isActive
		realButton.AutoButtonColor = false

		pcall(function()
			realButton.Interactable = isActive
		end)
	end
end

local function setButtonsState(isActive)
	local _, _, _, buttonsFrame, sellVisual, sellButton, leaveVisual, leaveButton = getUIElements()

	-- The whole holder is hidden first/last.
	-- This prevents Sell Everything from flashing before Leave.
	if buttonsFrame and buttonsFrame:IsA("GuiObject") then
		buttonsFrame.Visible = isActive
	end

	-- Apply both button states while holder is hidden/shown together.
	setButtonPairState(leaveVisual, leaveButton, isActive)
	setButtonPairState(sellVisual, sellButton, isActive)
end

local function clearConnections()
	for _, conn in pairs(buttonConnections) do
		if conn then
			conn:Disconnect()
		end
	end
	buttonConnections = {}

	for _, conn in pairs(buttonHoverConnections) do
		if conn then
			conn:Disconnect()
		end
	end
	buttonHoverConnections = {}

	local _, container = getUIElements()
	if container then
		for _, descendant in ipairs(container:GetDescendants()) do
			if descendant:IsA("GuiObject") then
				descendant:SetAttribute("HoverBound", nil)

				local uiScale = descendant:FindFirstChildOfClass("UIScale")
				if uiScale then
					uiScale.Scale = NORMAL_SCALE
				end
			end
		end
	end
end

-- ============================================================================
-- 🎧 DARREL-STYLE BUTTON HOVER / CLICK FEEDBACK
-- ============================================================================

local function animateButton(visualObject, realButton)
	if not visualObject or not realButton then
		return
	end

	if not visualObject:IsA("GuiObject") or not realButton:IsA("GuiButton") then
		return
	end

	if visualObject:GetAttribute("HoverBound") then
		return
	end

	visualObject:SetAttribute("HoverBound", true)

	local uiScale = getOrCreateUIScale(visualObject)
	if not uiScale then
		return
	end

	local isHovering = false
	local isPressed = false

	local function updateScale()
		local targetScale = NORMAL_SCALE

		if isPressed then
			targetScale = CLICK_SCALE
		elseif isHovering then
			targetScale = HOVER_SCALE
		end

		TweenService:Create(uiScale, BUTTON_TWEEN_INFO, {
			Scale = targetScale,
		}):Play()
	end

	table.insert(buttonHoverConnections, realButton.MouseEnter:Connect(function()
		if not realButton.Active then
			return
		end

		isHovering = true
		UIAudioConfig.PlayHover()
		updateScale()
	end))

	table.insert(buttonHoverConnections, realButton.MouseLeave:Connect(function()
		isHovering = false
		isPressed = false
		updateScale()
	end))

	table.insert(buttonHoverConnections, realButton.InputBegan:Connect(function(input)
		if not realButton.Active then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			isPressed = true
			updateScale()
		end
	end))

	table.insert(buttonHoverConnections, realButton.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			isPressed = false

			-- On mobile, MouseEnter/MouseLeave may not behave the same way.
			-- This gives touch users the clean press-and-release animation.
			if UserInputService.TouchEnabled then
				isHovering = false
			end

			updateScale()
		end
	end))
end

local function bindDialogueButton(visualObject, realButton, callback)
	if not visualObject or not realButton then
		return
	end

	if not realButton:IsA("GuiButton") then
		return
	end

	animateButton(visualObject, realButton)

	local fired = false

	local conn = realButton.Activated:Connect(function()
		if fired or not realButton.Active then
			return
		end

		fired = true

		UIAudioConfig.PlayClick()
		setButtonsState(false)

		callback()
	end)

	table.insert(buttonConnections, conn)
end

-- ============================================================================
-- 👁️ FOCUS MODE / HUD HIDING
-- ============================================================================

local function toggleNamedGuiObjects(shouldHide, objectName)
	if shouldHide then
		if #hiddenObjects > 0 then
			return
		end

		for _, obj in pairs(playerGui:GetDescendants()) do
			if obj:IsA("GuiObject") and obj.Name == objectName and obj.Visible then
				obj.Visible = false
				table.insert(hiddenObjects, obj)
			end
		end
	else
		for _, obj in pairs(hiddenObjects) do
			if obj and obj.Parent and obj:IsA("GuiObject") then
				obj.Visible = true
			end
		end

		hiddenObjects = {}
	end
end

local function toggleOtherGuis(shouldHide)
	if shouldHide then
		if #hiddenGuis > 0 then
			return
		end

		hiddenGuis = {}

		for _, otherGui in pairs(playerGui:GetDescendants()) do
			if otherGui:IsA("ScreenGui")
				and otherGui.Name ~= GUI_ID
				and otherGui.Name ~= "Confirmation"
				and otherGui.Enabled == true
				and otherGui.Name ~= "Balance Indicator"
				and not otherGui:GetAttribute("NPCReactionKeepEnabled") then

				otherGui.Enabled = false
				table.insert(hiddenGuis, otherGui)
			end
		end
	else
		for _, otherGui in pairs(hiddenGuis) do
			if otherGui and otherGui.Parent then
				otherGui.Enabled = true
			end
		end

		hiddenGuis = {}
	end
end

local function setFocusMode(active)
	toggleOtherGuis(active)
	toggleNamedGuiObjects(active, "FriendBoost")

	if player.Character then
		player:SetAttribute("MovementLock", active)
	end
end

-- ============================================================================
-- ⌨️ TYPEWRITER
-- ============================================================================

local function getCleanTextLength(str)
	local cleanStr = string.gsub(str, "<[^>]+>", "")
	return utf8.len(cleanStr) or #cleanStr
end

local function typewrite(label, text, onComplete)
	if not label then
		return
	end

	label.RichText = true

	if currentDialogueJob then
		pcall(task.cancel, currentDialogueJob)
		currentDialogueJob = nil
	end

	label.Text = text
	label.MaxVisibleGraphemes = 0

	local len = getCleanTextLength(text)

	currentDialogueJob = task.spawn(function()
		for i = 1, len do
			if not isInteracting and not isLeaving then
				break
			end

			label.MaxVisibleGraphemes = i

			if i % 3 == 0 then
				local s = Instance.new("Sound")
				s.SoundId = TYPING_SOUND_ID
				s.Volume = 0.1
				s.PlayOnRemove = true
				s.Parent = SoundService
				s:Destroy()
			end

			task.wait(TYPEWRITER_SPEED)
		end

		label.MaxVisibleGraphemes = -1
		currentDialogueJob = nil

		if onComplete and isInteracting then
			task.spawn(onComplete)
		end
	end)
end

-- ============================================================================
-- 🧹 STOP / CLEANUP
-- ============================================================================

local function stopInteraction()
	isInteracting = false
	isLeaving = false
	isProcessingSell = false
	promptDebounce = false

	if currentDialogueJob then
		pcall(task.cancel, currentDialogueJob)
		currentDialogueJob = nil
	end

	clearConnections()
	setButtonsState(false)
	setFocusMode(false)

	local camera = Workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
	end

	if controls then
		controls:Enable()
	end

	if player.Character then
		player:SetAttribute("MovementLock", false)
	end

	local myGui, container = getUIElements()

	if container then
		container.Visible = false
	end

	if myGui then
		myGui.Enabled = false
	end

	local cGui = playerGui:FindFirstChild("Confirmation")
	local cMain = cGui and cGui:FindFirstChild("MainFrame")

	if cGui then
		cGui.Enabled = false
	end

	if cMain and cMain:IsA("GuiObject") then
		cMain.Visible = false
	end
end

