-- ============================================================================
-- RobuxPurchaseState (LocalScript)
-- Location: StarterPlayerScripts
-- Purpose:  Single global listener that hides the PurchasingState > Loading
--           frame whenever a MarketplaceService purchase prompt closes —
--           regardless of which shop opened it, and regardless of outcome
--           (success, cancel, or fail).
--
--           Individual shop controllers call UIAudioConfig.ShowPurchaseLoading()
--           + UIAudioConfig.PlayRobux() when a Robux button is clicked.
--           This script is the only place HidePurchaseLoading() needs to live.
-- ============================================================================

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage  = game:GetService("ReplicatedStorage")
local UIAudioConfig      = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

-- ============================================================================
-- Ensure the Loading frame starts hidden
-- ============================================================================
local Players   = game:GetService("Players")
local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Wait briefly for StarterGui replication before hiding
task.defer(function()
	local screen = playerGui:FindFirstChild("PurchasingState")
	if screen then
		local loading = screen:FindFirstChild("Loading")
		if loading then
			loading.Visible = false
		end
	end
end)

-- ============================================================================
-- Global listeners — hide loader when any prompt closes
-- ============================================================================

-- Developer Products (PromptProductPurchase)
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, _productId, _wasPurchased)
	if userId ~= player.UserId then return end
	UIAudioConfig.HidePurchaseLoading()
end)

-- Game Passes (PromptGamePassPurchase) — covers any future gamepass buttons
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(gamepassPlayer, _gamePassId, _wasPurchased)
	if gamepassPlayer ~= player then return end
	UIAudioConfig.HidePurchaseLoading()
end)

-- Premium Purchase (safety net)
MarketplaceService.PromptPremiumPurchaseFinished:Connect(function()
	UIAudioConfig.HidePurchaseLoading()
end)

print("✅ [RobuxPurchaseState] Global loading state listener active.")
