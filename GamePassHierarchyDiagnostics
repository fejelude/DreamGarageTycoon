local function pathToString(root, pathParts)
	local parts = { root.Name }
	for _, name in ipairs(pathParts) do
		table.insert(parts, name)
	end
	return table.concat(parts, " > ")
end

local function warnProblem(kind, expectedPath, requiredClass, actualClass, feature)
	local message = string.format(
		"%s %s: %s | Required class: %s | Feature: %s",
		PREFIX,
		kind,
		expectedPath,
		requiredClass,
		feature
	)
	if actualClass then
		message ..= " | Actual class: " .. actualClass
	end
	warn(message)
end

local function scanRequiredObject(spec)
	local current = spec.Root
	local expectedPath = pathToString(spec.Root, spec.Path)

	for index, childName in ipairs(spec.Path) do
		local child = current:FindFirstChild(childName)
		if not child then
			warnProblem("MISSING", expectedPath, spec.ClassName, nil, spec.Feature)
			return 1
		end

		if child.Name ~= childName then
			warnProblem("INCORRECT NAME", expectedPath, spec.ClassName, child.ClassName, spec.Feature)
			return 1
		end

		if child.Parent ~= current then
			warnProblem("INCORRECT PARENT", expectedPath, spec.ClassName, child.ClassName, spec.Feature)
			return 1
		end

		if index == #spec.Path and not child:IsA(spec.ClassName) then
			warnProblem("INCORRECT CLASS", expectedPath, spec.ClassName, child.ClassName, spec.Feature)
			return 1
		end

		current = child
	end

	return 0
end

local function scanOwnershipAttributeNames()
	local problems = 0
	local config = ReplicatedStorage:FindFirstChild("GamePassConfig")
	if not config or not config:IsA("ModuleScript") then
		return problems
	end

	local ok, gamePassConfig = pcall(require, config)
	if not ok or type(gamePassConfig) ~= "table" then
		warn(string.format(
			"%s INCORRECT MODULE: ReplicatedStorage > GamePassConfig | Required class: ModuleScript | Feature: Ownership attribute consistency | Actual problem: %s",
			PREFIX,
			tostring(gamePassConfig)
		))
		return problems + 1
	end

	local expectedAttributes = {
		Exclusive = "OwnsExclusiveGamePass",
		DoubleMoney = "Owns2xMoneyGamePass",
	}

	for passKey, expectedAttribute in pairs(expectedAttributes) do
		local passInfo = gamePassConfig.Passes and gamePassConfig.Passes[passKey]
		local actualAttribute = passInfo and passInfo.Attribute
		if actualAttribute ~= expectedAttribute then
			warn(string.format(
				"%s ATTRIBUTE MISMATCH: ReplicatedStorage > GamePassConfig.Passes.%s.Attribute | Required value: %s | Actual value: %s | Feature: Ownership attribute consistency",
				PREFIX,
				passKey,
				expectedAttribute,
				tostring(actualAttribute)
			))
			problems += 1
		end
	end

	return problems
end

local problems = 0
for _, spec in ipairs(requiredObjects) do
	problems += scanRequiredObject(spec)
end
problems += scanOwnershipAttributeNames()

if problems == 0 then
	print(PREFIX .. " Scan complete. All required Game Pass hierarchy elements were found.")
else
	warn(string.format("%s Scan complete. %d hierarchy problems found.", PREFIX, problems))
end
