-- Purpose: Shop UI, Feedback, Sounds, EQUIP/UNEQUIP, and GIFTING connection.
-- Runs on: Client
-- Location: StarterPlayerScripts
-- Dependencies: ReplicatedStorage, TweenService, MarketplaceService, HttpService
-- Public API: None (Listens to ShopRemotes)
-- Networking: BaseUpgradeTransaction (Client -> Server)
-- Security: Strict client-side transaction locks prevent remote spam and race conditions.
-- Performance: Preloads sounds, caches UI states, reuses blur effects.
-- Notes: GiftButton routes through Kit.Tween. Whitelists Notifications GUI. Added dedicated Cash/Robux SFX.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local SoundService = game:GetService("SoundService") 

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")
local Remotes = ReplicatedStorage:WaitForChild("ShopRemotes")

-- 📡 NETWORKING
local OpenEvent = Remotes:WaitForChild("OpenBaseUpgrade")
local TransactionFunc = Remotes:WaitForChild("BaseUpgradeTransaction")

local function clearGiftIntent(productId)
	local giftRemotes = ReplicatedStorage:FindFirstChild("GiftRemotes")
	local cancelGiftIntent = giftRemotes and giftRemotes:FindFirstChild("CancelGiftIntent")
	if cancelGiftIntent then
		cancelGiftIntent:FireServer(productId)
	end
end

-- 📦 REQUIRE KIT
local Kit
pcall(function()
	Kit = require(ReplicatedStorage:WaitForChild("ShopFrontendKit", 5))
end)
local BaseSkinStats = require(ReplicatedStorage:WaitForChild("BaseSkinStats"))
local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

-- ⚙️ CONFIGURATION
local UI_NAME = "BaseUpgradeUI"
local FRAME_NAME = "MainFrame"
local SCROLLER_NAME = "UpgradeScroller" 
local CLOSE_BTN_NAME = "CloseButton"
local BLUR_SIZE = 24 

-- 🎵 SOUND PRE-LOADING (✅ FULLY SEPARATED IDs)
local Sounds = {}
local SFX_IDs = {
	CashSuccess  = "rbxassetid://14810387808", -- 🟢 Played on successful Cash buy
	RobuxSuccess = "rbxassetid://14810387808", -- 🟢 Played on successful Robux buy
	CashFail     = "rbxassetid://1569434825",  -- 🔴 Played when you don't have enough Cash
	RobuxFail    = "rbxassetid://1569434825",  -- 🔴 Played when you cancel/fail a Robux prompt
	Equip        = "rbxassetid://6895079853"   -- ⚪ Played when equipping a base
}

for name, id in pairs(SFX_IDs) do
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = id
	s.Volume = 2
	s.Parent = SoundService
	Sounds[name] = s
end

-- 🛡️ STATE TRACKING
local hiddenGuis = {} 
local hiddenObjects = {} 
local focusConnections = {}
local watchedFocusGuis = {}
local connectedCards = {}
local currentBlur = nil 
local isProcessingTransaction = false 
local lastBasePurchaseFeedbackSerial = 0

-- ============================================================================
-- 🔊 SOUND ENGINE
-- ============================================================================
local function PlaySound(name)
	local s = Sounds[name]
	if s then s:Play() end
end

-- ============================================================================
-- 🎨 STATE LABEL FEEDBACK SYSTEM
-- ============================================================================
local shopFeedback = nil

local function getShopFeedback()
	local gui = PlayerGui:FindFirstChild(UI_NAME)
	local frame = gui and gui:FindFirstChild(FRAME_NAME, true)
	if not frame then return nil end

	if not shopFeedback then
		shopFeedback = UIAudioConfig.CreateStateFeedback(frame)
	end

	return shopFeedback
end

local function ShowFeedback(message, statusType)
	local feedback = getShopFeedback()
	if not feedback then return end

	if statusType == "RobuxPending" then
		feedback:Success(message or "Purchase submitted. Grant is processing.", Color3.fromRGB(255, 220, 90))
	elseif statusType == "CashSuccess" or statusType == "RobuxSuccess" or statusType == "EquipSuccess" then
		PlaySound(statusType == "EquipSuccess" and "Equip" or statusType)
		feedback:Success(message or "Purchase successful.")
	else
		PlaySound(statusType or "CashFail")
		feedback:Failed(message or "Purchase failed.")
	end
end

-- ============================================================================
-- 💎 ROBUX PURCHASE LISTENER
-- ============================================================================
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, isPurchased)
	if userId ~= player.UserId then return end

	local isBaseSkin = false
	for _, skinData in pairs(BaseSkinStats) do
		if skinData.ProductId == productId then
			isBaseSkin = true
			break
		end
	end

	if isBaseSkin then
		if isPurchased then
			if player:GetAttribute("BasePurchaseFeedbackKind") == "Legacy"
				and (tonumber(player:GetAttribute("BasePurchaseFeedbackSerial")) or 0) <= lastBasePurchaseFeedbackSerial
			then return end
			ShowFeedback("Purchase submitted. Grant is processing.", "RobuxPending")
		else
			ShowFeedback("Purchase cancelled.", "RobuxFail") -- ✅ Triggers specific Robux fail sound
		end
	end
end)

local function replayBasePurchaseFeedback()
	local serial = math.max(0, math.floor(tonumber(player:GetAttribute("BasePurchaseFeedbackSerial")) or 0))
	if serial <= lastBasePurchaseFeedbackSerial then return end
	lastBasePurchaseFeedbackSerial = serial
	if player:GetAttribute("BasePurchaseFeedbackKind") ~= "Legacy" then return end
	UIAudioConfig.HidePurchaseLoading()
	ShowFeedback("Base skin purchase successful.", "RobuxSuccess")
end

player:GetAttributeChangedSignal("BasePurchaseFeedbackSerial"):Connect(replayBasePurchaseFeedback)
task.defer(replayBasePurchaseFeedback)

-- ============================================================================
-- 🛠️ HELPER FUNCTIONS
-- ============================================================================
local function setBlur(enable)
	if enable then
		if not currentBlur then
			currentBlur = Instance.new("BlurEffect")
			currentBlur.Size = 0
			currentBlur.Parent = Lighting
			currentBlur.Name = "UpgradeBlur"
		end
		TweenService:Create(currentBlur, TweenInfo.new(0.5), {Size = BLUR_SIZE}):Play()
	else
		if currentBlur then
			local t = TweenService:Create(currentBlur, TweenInfo.new(0.5), {Size = 0})
			t:Play()
			t.Completed:Connect(function()
				if currentBlur then currentBlur:Destroy() currentBlur = nil end
			end)
		end
	end
end

local function toggleNamedGuiObjects(shouldHide, objectName)
	if shouldHide then
		for _, obj in pairs(PlayerGui:GetDescendants()) do
			if obj:IsA("GuiObject") and obj.Name == objectName and obj.Visible then
				obj.Visible = false
				table.insert(hiddenObjects, obj)
			end
		end
	else
		for _, obj in pairs(hiddenObjects) do
			if obj and obj.Parent and obj:IsA("GuiObject") then
				obj.Visible = true
			end
		end
		hiddenObjects = {}
	end
end

local GUI_FOCUS_WHITELIST = {
	["Balance Indicator"] = true,
	TouchGui = true,
	Chat = true,
	Notifications = true,
	PurchasingState = true,
}

local function clearFocusConnections()
	for _, connection in ipairs(focusConnections) do
		if connection then connection:Disconnect() end
	end
	focusConnections = {}
	watchedFocusGuis = {}
end

local function shouldIgnoreFocusGui(gui, myGui)
	return not gui:IsA("ScreenGui")
		or gui == myGui
		or GUI_FOCUS_WHITELIST[gui.Name] == true
end

local function hideGuiForFocus(gui, myGui)
	if shouldIgnoreFocusGui(gui, myGui) then return end
	if gui.Enabled then
		hiddenGuis[gui] = true
		gui.Enabled = false
	end
end

local function watchFocusGui(gui, myGui)
	if shouldIgnoreFocusGui(gui, myGui) or watchedFocusGuis[gui] then return end
	watchedFocusGuis[gui] = true
	table.insert(focusConnections, gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if gui.Enabled then
			hideGuiForFocus(gui, myGui)
		end
	end))
end

local function toggleOtherGuis(shouldHide)
	local myGui = PlayerGui:FindFirstChild(UI_NAME)
	if shouldHide then
		clearFocusConnections()
		for _, otherGui in ipairs(PlayerGui:GetDescendants()) do
			watchFocusGui(otherGui, myGui)
			hideGuiForFocus(otherGui, myGui)
		end

		table.insert(focusConnections, PlayerGui.DescendantAdded:Connect(function(child)
			task.defer(function()
				if child and child.Parent then
					watchFocusGui(child, myGui)
					hideGuiForFocus(child, myGui)
				end
			end)
		end))
	else
		clearFocusConnections()
		for otherGui in pairs(hiddenGuis) do
			if otherGui and otherGui.Parent then
				otherGui.Enabled = true
			end
		end
		hiddenGuis = {}
	end
end

local function setMovement(active)
	player:SetAttribute("MovementLock", not active)
end


local function closeBaseUpgradeFocusForGift()
	local gui = PlayerGui:FindFirstChild(UI_NAME)
	local frame = gui and gui:FindFirstChild(FRAME_NAME, true)

	if frame then
		frame.Visible = false
	end
	if gui then
		gui.Enabled = false
	end

	setBlur(false)
	toggleOtherGuis(false)
	toggleNamedGuiObjects(false, "FriendBoost")
	setMovement(true)
end

-- ============================================================================
-- 🛍️ CARD LOGIC (BUY / EQUIP / UNEQUIP / GIFT)
-- ============================================================================

local function resolveGuiButton(target)
	if not target then return nil end
	if target:IsA("GuiButton") then return target end
	for _, descendant in ipairs(target:GetDescendants()) do
		if descendant:IsA("GuiButton") then
			return descendant
		end
	end
	return nil
end

local function UpdateCardVisuals(cardFrame, skinName)
	local buyFrame = cardFrame:FindFirstChild("BuyFrame", true)
	if not buyFrame then return end

	local btnCash = buyFrame:FindFirstChild("BuyForCash", true)
	local btnRobux = buyFrame:FindFirstChild("BuyForRobux", true)
	local obtainedIndicator = buyFrame:FindFirstChild("ObtainedIndicator", true)

	local btnEquip = buyFrame:FindFirstChild("Equip", true)
	local btnUnequip = buyFrame:FindFirstChild("Unequip", true)

	local ownedRaw = player:GetAttribute("OwnedBaseSkins") or "[]"
	local ownedTable = {}
	pcall(function() ownedTable = HttpService:JSONDecode(ownedRaw) end)

	local isOwned = table.find(ownedTable, skinName)
	local currentEquip = player:GetAttribute("EquippedSkin")

	if isOwned then
		if btnCash then btnCash.Visible = false end
		if btnRobux then btnRobux.Visible = false end
		if obtainedIndicator then obtainedIndicator.Visible = false end 

		if currentEquip == skinName then
			if btnEquip then btnEquip.Visible = false end
			if btnUnequip then btnUnequip.Visible = true end
		else
			if btnEquip then btnEquip.Visible = true end
			if btnUnequip then btnUnequip.Visible = false end
		end
	else
		if btnCash then btnCash.Visible = true end
		if btnRobux then btnRobux.Visible = true end
		if btnEquip then btnEquip.Visible = false end
		if btnUnequip then btnUnequip.Visible = false end
		if obtainedIndicator then obtainedIndicator.Visible = false end
	end
end

local function ConnectCard(cardFrame, skinName)
	UpdateCardVisuals(cardFrame, skinName)
	if connectedCards[cardFrame] then return end
	connectedCards[cardFrame] = true

	player:GetAttributeChangedSignal("OwnedBaseSkins"):Connect(function()
		UpdateCardVisuals(cardFrame, skinName)
	end)
	player:GetAttributeChangedSignal("EquippedSkin"):Connect(function()
		UpdateCardVisuals(cardFrame, skinName)
	end)

	local buyFrame = cardFrame:FindFirstChild("BuyFrame", true)
	if not buyFrame then 
		warn("❌ CRITICAL: BuyFrame not found inside " .. cardFrame.Name)
		return 
	end

	local btnCash = resolveGuiButton(buyFrame:FindFirstChild("BuyForCash", true))
	local btnRobux = resolveGuiButton(buyFrame:FindFirstChild("BuyForRobux", true))
	local btnEquip = resolveGuiButton(buyFrame:FindFirstChild("Equip", true))
	local btnUnequip = resolveGuiButton(buyFrame:FindFirstChild("Unequip", true))
	local giftNode = buyFrame:FindFirstChild("GiftButton", true)
	local btnGift = resolveGuiButton(giftNode)

	-- 1. BUY CASH
	if btnCash then
		local function onBuyCash()
			if isProcessingTransaction then return end 
			isProcessingTransaction = true

			local success, msg = TransactionFunc:InvokeServer(skinName, "Cash")

			if success then 
				ShowFeedback(msg or "Purchase successful.", "CashSuccess")
			else 
				ShowFeedback(msg or "Purchase failed.", "CashFail") -- ✅ Triggers specific Cash fail sound
			end

			task.wait(0.2) 
			isProcessingTransaction = false
		end

		if Kit and Kit.Tween then Kit.Tween:SetupButton(btnCash, onBuyCash)
		else btnCash.MouseButton1Click:Connect(onBuyCash) end
	end

	-- 2. BUY ROBUX
	if btnRobux then
		local function onBuyRobux()
			if isProcessingTransaction then return end
			isProcessingTransaction = true

			UIAudioConfig.PlayRobux()
			UIAudioConfig.ShowPurchaseLoading()
			local skinData = BaseSkinStats[skinName]
			if skinData and skinData.ProductId then
				clearGiftIntent(skinData.ProductId)
			end
			TransactionFunc:InvokeServer(skinName, "Robux")

			task.wait(1)
			isProcessingTransaction = false
		end

		if Kit and Kit.Tween then Kit.Tween:SetupButton(btnRobux, onBuyRobux)
		else btnRobux.MouseButton1Click:Connect(onBuyRobux) end
	end

	-- 3. EQUIP BUTTON
	if btnEquip then
		local function onEquip()
			if isProcessingTransaction then return end
			isProcessingTransaction = true

			TransactionFunc:InvokeServer(skinName, "Equip")
			PlaySound("Equip")

			task.wait(0.1)
			isProcessingTransaction = false
		end

		if Kit and Kit.Tween then Kit.Tween:SetupButton(btnEquip, onEquip)
		else btnEquip.MouseButton1Click:Connect(onEquip) end
	end

	-- 4. UNEQUIP BUTTON
	if btnUnequip then
		local function onUnequip()
			if isProcessingTransaction then return end
			isProcessingTransaction = true

			TransactionFunc:InvokeServer(skinName, "Unequip")
			PlaySound("Equip")

			task.wait(0.1)
			isProcessingTransaction = false
		end

		if Kit and Kit.Tween then Kit.Tween:SetupButton(btnUnequip, onUnequip)
		else btnUnequip.MouseButton1Click:Connect(onUnequip) end
	end

	-- 5. 🎁 GIFT BUTTON
	if btnGift then
		local function onGiftClicked()
			local skinData = BaseSkinStats[skinName]
			local productId = skinData and skinData.ProductId

			if not productId or productId <= 0 then
				warn("⚠️ Base gift product id is missing for " .. tostring(skinName))
				return
			end

			if not _G.OpenGiftMenu then
				warn("⚠️ _G.OpenGiftMenu is not ready yet!")
				return
			end

			closeBaseUpgradeFocusForGift()
			_G.OpenGiftMenu(productId)
		end

		if Kit and Kit.Tween then 
			Kit.Tween:SetupButton(btnGift, onGiftClicked)
		else 
			btnGift.MouseButton1Click:Connect(onGiftClicked) 
		end
	end
end


local function getOwnedBaseLevel()
	return math.max(1, tonumber(player:GetAttribute("OwnedBaseLevel")) or tonumber(player:GetAttribute("BaseLevel")) or 1)
end

local function getEquippedBaseLevel()
	return math.max(1, tonumber(player:GetAttribute("BaseLevel")) or 1)
end

local function UpdateBaseEquipVisuals(scroller)
	local selection = scroller and scroller:FindFirstChild("BaseCardSelection", true)
	if not selection then return end

	local ownedLevel = getOwnedBaseLevel()
	local equippedLevel = getEquippedBaseLevel()

	for level = 1, 2 do
		local buyFrame = selection:FindFirstChild("Level" .. tostring(level) .. "BuyFrame", true)
		if buyFrame then
			local btnEquip = buyFrame:FindFirstChild("Equip", true)
			local btnUnequip = buyFrame:FindFirstChild("Unequip", true)
			local isOwned = ownedLevel >= level
			local isEquipped = equippedLevel == level

			if btnEquip and btnEquip:IsA("GuiObject") then
				btnEquip.Visible = isOwned and not isEquipped
			end
			if btnUnequip and btnUnequip:IsA("GuiObject") then
				btnUnequip.Visible = isOwned and isEquipped
			end
		end
	end
end

local connectedBaseEquipButtons = {}

local function ConnectBaseEquipFrame(scroller, level)
	local selection = scroller and scroller:FindFirstChild("BaseCardSelection", true)
	local buyFrame = selection and selection:FindFirstChild("Level" .. tostring(level) .. "BuyFrame", true)
	if not buyFrame or connectedBaseEquipButtons[buyFrame] then return end
	connectedBaseEquipButtons[buyFrame] = true

	local btnEquip = resolveGuiButton(buyFrame:FindFirstChild("Equip", true))
	local btnUnequip = resolveGuiButton(buyFrame:FindFirstChild("Unequip", true))

	local function requestEquip()
		if isProcessingTransaction then return end
		isProcessingTransaction = true

		local success, msg = TransactionFunc:InvokeServer(level, "BaseEquip")
		if success then
			ShowFeedback(msg or ("Equipped Level " .. tostring(level) .. " Base."), "EquipSuccess")
		else
			ShowFeedback(msg or "Purchase failed.", "CashFail")
		end

		task.wait(0.2)
		isProcessingTransaction = false
	end

	if btnEquip then
		if Kit and Kit.Tween then Kit.Tween:SetupButton(btnEquip, requestEquip)
		else btnEquip.MouseButton1Click:Connect(requestEquip) end
	end

	if btnUnequip then
		local function requestUnequip()
			if isProcessingTransaction then return end
			isProcessingTransaction = true

			local success, msg = TransactionFunc:InvokeServer(level, "BaseUnequip")
			if success then
				ShowFeedback(msg or "Switched back to Level 1 Base.", "EquipSuccess")
			else
				ShowFeedback(msg or "You must always have an active base.", "CashFail")
			end

			task.wait(0.2)
			isProcessingTransaction = false
		end

		if Kit and Kit.Tween then Kit.Tween:SetupButton(btnUnequip, requestUnequip)
		else btnUnequip.MouseButton1Click:Connect(requestUnequip) end
	end
end

local function SetupShop()
	local gui = PlayerGui:WaitForChild(UI_NAME, 5)
	if not gui then return end
	local scroller = gui:FindFirstChild(SCROLLER_NAME, true) 
	if not scroller then return end 

	local cardSilver = scroller:FindFirstChild("Card0.1", true)
	if cardSilver then ConnectCard(cardSilver, "Silver") end

	local card1 = scroller:FindFirstChild("Card1", true)
	if card1 then ConnectCard(card1, "Gold") end

	local card2 = scroller:FindFirstChild("Card2", true)
	if card2 then ConnectCard(card2, "Diamond") end

	local card3 = scroller:FindFirstChild("Card3", true)
	if card3 then ConnectCard(card3, "Rainbow") end

	ConnectBaseEquipFrame(scroller, 1)
	ConnectBaseEquipFrame(scroller, 2)
	UpdateBaseEquipVisuals(scroller)
end

-- ============================================================================
-- 🔄 VISIBILITY & INIT
-- ============================================================================
local function setVisible(isOpen)
	local gui = PlayerGui:WaitForChild(UI_NAME, 5)
	if not gui then return end
	local frame = gui:FindFirstChild(FRAME_NAME, true)
	if not frame then return end

	if isOpen then
		toggleOtherGuis(true)
		toggleNamedGuiObjects(true, "FriendBoost") 
		setBlur(true)                               
		setMovement(false)                         
		SetupShop()
		gui.Enabled = true
		frame.Visible = true
		if Kit and Kit.Sound then Kit.Sound:Play("Open") end
	else
		gui.Enabled = false
		frame.Visible = false
		setBlur(false)
		toggleOtherGuis(false)
		toggleNamedGuiObjects(false, "FriendBoost")
		setMovement(true) 
	end
end

player:GetAttributeChangedSignal("BaseLevel"):Connect(function()
	local gui = PlayerGui:FindFirstChild(UI_NAME)
	local scroller = gui and gui:FindFirstChild(SCROLLER_NAME, true)
	UpdateBaseEquipVisuals(scroller)
end)

player:GetAttributeChangedSignal("OwnedBaseLevel"):Connect(function()
	local gui = PlayerGui:FindFirstChild(UI_NAME)
	local scroller = gui and gui:FindFirstChild(SCROLLER_NAME, true)
	UpdateBaseEquipVisuals(scroller)
end)

OpenEvent.OnClientEvent:Connect(function() setVisible(true) end)

task.spawn(function()
	local gui = PlayerGui:WaitForChild(UI_NAME, 10)
	if not gui then return end
	gui.Enabled = false 
	local frame = gui:WaitForChild(FRAME_NAME, 10)
	if frame then frame.Visible = false end

	local closeBtn = gui:FindFirstChild(CLOSE_BTN_NAME, true)
	if not closeBtn then return end

	if Kit and Kit.Tween and Kit.Tween.SetupButton then
		Kit.Tween:SetupButton(closeBtn, function() setVisible(false) end)
	else
		closeBtn.MouseButton1Click:Connect(function() setVisible(false) end)
	end
	SetupShop()
end)
