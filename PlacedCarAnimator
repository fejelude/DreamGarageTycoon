-- Purpose: Animates ALL placed cars on ALL pads with a gentle UP/DOWN float, rendered purely on the client to prevent server lag.
-- Runs on: Client
-- Location: StarterPlayerScripts
-- Dependencies: RunService, Workspace
-- Public API: None
-- Networking: None
-- Security: Client-sided visuals only. Prevents exploiters from weaponizing server movement.
-- Performance: Extremely fast. Eliminates O(N) physics replication per frame from the server.
-- Notes: Must be placed in StarterPlayerScripts as a LocalScript. Delete the old Server script.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local TycoonFolder = Workspace:WaitForChild("Tycoons", 30)
if not TycoonFolder then
	warn("[PlacedCarAnimator] Workspace.Tycoons did not load in time; car animation disabled for this session.")
	return
end

-- ⚙️ CONFIGURATION (Breathing Effect)
local DISPLACEMENT_SPREAD = 0.5   -- How high/low it goes (Studs)
local DISPLACEMENT_SPEED = 2      -- How fast it bobs up and down

-- ⚙️ PERFORMANCE CONFIGURATION (LOD)
local LOD_CULL_DISTANCE = 200    -- Distance beyond which a car is culled
local LOD_CHECK_INTERVAL = 0.5   -- How often (in seconds) we check LOD distance

-- 🛡️ STATE MANAGEMENT
-- We store the "Base Position" of every car so it doesn't drift away
local activeCars = {} -- [CarModel] = OriginalCFrame
local carParents = {} -- [CarModel] = OriginalParentInstance
local lastLODCheck = 0
local carsCulled = {} -- [CarModel] = true (Keeps track of cars that are currently hidden)
local carsAtBase = {} -- [CarModel] = true (Keeps track of cars that have been reset to base CFrame when animation is off)

-- 🛠️ REGISTER CAR
local function trackCar(car)
	if not car:IsA("Model") then return end
	if activeCars[car] then return end -- Already tracked

	-- Wait 0.2s for PadController (Server) to finish positioning the car
	-- This ensures we capture the CORRECT position on the pad
	task.wait(0.2)

	if car.Parent then
		activeCars[car] = car:GetPivot()
		carParents[car] = car.Parent
	end
end

-- ⚡ CULLING HELPER
-- Create a local cache folder in ReplicatedStorage for culling (maximum performance gain)
local carCacheFolder = Instance.new("Folder")
carCacheFolder.Name = "CarLODCache"
carCacheFolder.Parent = game:GetService("ReplicatedStorage")

local function setCarVisibility(car, isVisible)
	if carsCulled[car] == not isVisible then return end -- Already in correct state
	carsCulled[car] = not isVisible

	if not isVisible then
		-- Move to cache folder completely to stop rendering & physics processing
		car.Parent = carCacheFolder
	else
		-- Restore to its original PlacedCars folder
		if carParents[car] then
			car.Parent = carParents[car]
		end
	end
end

-- 🛠️ SCAN PLOT
local function monitorPlot(plot)
	-- Wait for the folder where PadController puts the cars
	local carFolder = plot:WaitForChild("PlacedCars", 10)
	if not carFolder then return end

	-- 1. Track existing cars
	for _, car in pairs(carFolder:GetChildren()) do
		task.spawn(trackCar, car)
	end

	-- 2. Listen for NEW cars (When a player buys/places one)
	carFolder.ChildAdded:Connect(trackCar)

	-- 3. Cleanup removed cars (When a player picks it up)
	carFolder.ChildRemoved:Connect(function(car)
		-- Only clear if it was actually destroyed/removed permanently
		-- Not if it was just moved to our carCacheFolder for LOD culling
		if car.Parent ~= carCacheFolder then
			activeCars[car] = nil
			carsCulled[car] = nil
			carsAtBase[car] = nil
			carParents[car] = nil
		end
	end)
end

-- 🚀 STARTUP: Find all existing Tycoons
for _, plot in pairs(TycoonFolder:GetChildren()) do
	task.spawn(monitorPlot, plot)
end

-- Listen for new Tycoons (just in case they load late)
TycoonFolder.ChildAdded:Connect(monitorPlot)

-- 🔄 ANIMATION LOOP (RenderStepped runs every frame on Client)
RunService.RenderStepped:Connect(function(dt)
	if playerGui:GetAttribute("LoadingScreenActive") == true then
		return
	end

	local t = time()

	local lodEnabled = Workspace:GetAttribute("CarLODEnabled") == true
	local animEnabled = Workspace:GetAttribute("CarAnimationEnabled") ~= false

	local currentCamera = Workspace.CurrentCamera
	local camPos = currentCamera and currentCamera.CFrame.Position or Vector3.new()

	-- ⚡ LOD DISTANCE CHECK (Throttled to save CPU)
	if t - lastLODCheck > LOD_CHECK_INTERVAL then
		lastLODCheck = t

		for car, baseCF in pairs(activeCars) do
			-- Need to check if it's still parented somewhere valid (not destroyed)
			if car.Parent then
				if lodEnabled then
					-- Distance check against baseCF (the car might be cached and its actual pos irrelevant)
					local dist = (camPos - baseCF.Position).Magnitude
					if dist > LOD_CULL_DISTANCE then
						setCarVisibility(car, false)
					else
						setCarVisibility(car, true)
					end
				else
					-- If LOD is turned off, make sure all cars are visible
					setCarVisibility(car, true)
				end
			else
				-- Car was deleted
				activeCars[car] = nil
				carsCulled[car] = nil
				carsAtBase[car] = nil
				carParents[car] = nil
			end
		end
	end

	-- ⚡ ANIMATION CALCULATION & APPLY
	local yDisplacement = 0
	if animEnabled then
		-- Calculate bobbing (Sine Wave)
		yDisplacement = math.sin(t * DISPLACEMENT_SPEED) * DISPLACEMENT_SPREAD
	end

	for car, baseCF in pairs(activeCars) do
		if car.Parent then
			-- Skip animating if culled to save CPU/GPU overhead
			if carsCulled[car] then continue end

			if animEnabled then
				-- Apply ONLY height change (No Rotation)
				car:PivotTo(baseCF * CFrame.new(0, yDisplacement, 0))
				carsAtBase[car] = false
			else
				-- If animation disabled, reset to base once and stop pivoting
				if not carsAtBase[car] then
					car:PivotTo(baseCF)
					carsAtBase[car] = true
				end
			end
		end
	end
end)
