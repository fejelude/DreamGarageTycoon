-- [[ SERVER SCRIPT: PadController (V3 - Visual Sync & Progression Aware) ]]
-- Purpose: Handles placing/picking up cars AND manages Prompt Visibility based on unlocks.
-- Runs on: Server
-- Key Upgrade: Checks 'HighestUnlockedPad' to hide prompts on locked pads.
-- SECURITY UPDATE: Now validates ToolId attribute instead of Tool.Name to prevent spoofing.

local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

-- ⚙️ CONFIGURATION
local CONSTANTS = {
	VERTICAL_OFFSET = 5,
	PROMPT_RANGE = 14,
	MAX_CHECK_DIST = 20,
	EJECT_HEIGHT = 5,
	EJECT_DISTANCE = 4,
	RETRY_DELAY = 0.2,
	HOLD_DURATION = 1.5 
}

-- 📂 ASSETS
local CarModels = ServerStorage:WaitForChild("CarModels")
local CarTools = ServerStorage:WaitForChild("CarTools")
local TycoonFolder = Workspace:WaitForChild("Tycoons")

-- 📚 MODULES
local CarStats
pcall(function() CarStats = require(ReplicatedStorage:WaitForChild("CarStats", 5)) end)
local CarCPSDisplayUtils = require(ReplicatedStorage:WaitForChild("CarCPSDisplayUtils"))
local PlayerTransactionCoordinator = require(ServerScriptService:WaitForChild("PlayerTransactionCoordinator"))
local TycoonAdminAPI = ServerStorage:WaitForChild("TycoonAdminAPI")

-- 🛡️ STATE MANAGEMENT
local processingTracks = {} 
local registeredPads = setmetatable({}, { __mode = "k" })

-- ============================================================================
-- 🛠️ HELPER FUNCTIONS
-- ============================================================================

-- ✅ Helper: Get Pad Number from Name (e.g. "Pad5" -> 5)
local function getPadNumber(padObject)
	local num = padObject.Name:match("Pad(%d+)")
	return tonumber(num)
end

local function safeFindCarTool(targetName)
	if not targetName then return nil end
	local cleanName = targetName:gsub(" Item", ""):gsub("Item", "")

	for _, folderName in ipairs({"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic"}) do
		local folder = CarTools:FindFirstChild(folderName)
		if folder then
			for _, tool in ipairs(folder:GetChildren()) do
				if tool.Name == targetName or tool.Name == cleanName .. " Item" or tool.Name == cleanName then
					return tool
				end
			end
		end
	end
	return nil
end

local function safeFindCarModel(targetName)
	if not targetName then return nil end
	local cleanName = targetName:gsub(" Item", ""):gsub("Item", "")

	for _, folderName in ipairs({"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic"}) do
		local folder = CarModels:FindFirstChild(folderName)
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				if model.Name == targetName or model.Name == cleanName then
					return model
				end
			end
		end
	end
	return nil
end

local function FindModelNameFromTool(toolName)
	if not toolName or typeof(toolName) ~= "string" then return nil end

	local model = safeFindCarModel(toolName)
	if model then return model.Name end

	local clean = toolName:gsub(" Item", ""):gsub("Item", "")
	if CarStats and CarStats.Cars and CarStats.Cars[clean] then
		local stats = CarStats.Cars[clean]
		local fallbackModel = safeFindCarModel(stats.Name)
		if fallbackModel then return fallbackModel.Name end
	end
	return nil
end

local function FindToolFromModelName(modelName)
	if not modelName or typeof(modelName) ~= "string" then return nil end

	local tool = safeFindCarTool(modelName)
	if tool then return tool end

	if CarStats and CarStats.Cars then
		local _, carId = CarStats.GetCarStats(modelName)
		local fallbackTool = carId and safeFindCarTool(carId)
		if fallbackTool then return fallbackTool end
	end
	return nil
end

local function getMainPart(obj)
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end


local function getPlotFolder(obj)
	-- Because plots might be moved to ReplicatedStorage.TycoonLevelStorage (via PadProgressionHandler)
	-- we must check if it's currently parented there as well!
	local current = obj
	while current and current.Parent do
		if current.Parent == TycoonFolder then return current end
		if current.Parent.Name == "TycoonLevelStorage" then return current end
		current = current.Parent
	end
	return nil
end

local function isCloseEnough(player, padPart)
	if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return false end
	local dist = (player.Character.HumanoidRootPart.Position - padPart.Position).Magnitude
	return dist <= CONSTANTS.MAX_CHECK_DIST
end

-- ============================================================================
-- 🧠 SMART VALIDATION (The Fix)
-- ============================================================================
local function validatePadState(padObject, occupiedVal, linkedCarVal, placePrompt, pickupPrompt)
	-- 1. Get Plot & Owner
	local plot = getPlotFolder(padObject)
	local ownerName = plot and plot:FindFirstChild("Owner") and plot.Owner.Value
	local ownerPlayer = Players:FindFirstChild(ownerName or "")

	-- 2. Check Progression (Is this pad unlocked?)
	local isUnlocked = false
	if ownerPlayer then
		local level = ownerPlayer:GetAttribute("HighestUnlockedPad") or 1
		local padNum = getPadNumber(padObject)
		if padNum and padNum <= level then isUnlocked = true end
	elseif not ownerName or ownerName == "" then
		-- No owner? Only unlock Pad 1 (or lock all to be safe)
		if getPadNumber(padObject) == 1 then isUnlocked = true end
	end

	-- 3. APPLY VISIBILITY LOGIC
	if not isUnlocked then
		-- 🔒 LOCKED: Disable prompts so players can't interact
		placePrompt.Enabled = false
		pickupPrompt.Enabled = false
		return
	end

	-- 🔓 UNLOCKED: Normal Logic
	local car = linkedCarVal.Value

	if occupiedVal.Value == true and (not car or not car.Parent) then
		-- Ghost Lock Detected (Fix it)
		occupiedVal.Value = false
		linkedCarVal.Value = nil
		placePrompt.Enabled = true
		pickupPrompt.Enabled = false

	elseif occupiedVal.Value == true then
		-- Car is placed
		CarCPSDisplayUtils.BindModelCPSDisplay(car, ownerPlayer)
		placePrompt.Enabled = false
		pickupPrompt.Enabled = true

	else
		-- Pad is empty
		placePrompt.Enabled = true
		pickupPrompt.Enabled = false
	end
end

-- ============================================================================
-- 📦 TRANSACTION FUNCTIONS
-- ============================================================================
local function removeToolFromPlayer(player, tool)
	if not tool or (tool.Parent ~= player.Character and tool.Parent ~= player:FindFirstChild("Backpack")) then
		return false
	end
	local itemId = tool:GetAttribute("ItemId")
	if type(itemId) ~= "string" or itemId == "" then return false end
	return TycoonAdminAPI:Invoke("RemoveToolInstance", player, itemId, true) == true
end

local function spawnCarOnPad(padPart, carModel, plot, player)
	local placedCar = carModel:Clone()
	local padTop = padPart.CFrame * CFrame.new(0, (padPart.Size.Y / 2) + CONSTANTS.VERTICAL_OFFSET + 1, 0)
	placedCar:PivotTo(padTop)

	local carFolder = plot:FindFirstChild("PlacedCars")
	if not carFolder then
		placedCar:Destroy()
		return nil, "Missing PlacedCars folder"
	end
	placedCar.Parent = carFolder

	for _, part in pairs(placedCar:GetDescendants()) do
		if part:IsA("BasePart") then 
			part.Anchored = true
			part.CanCollide = true 
		end
	end
	CarCPSDisplayUtils.BindModelCPSDisplay(placedCar, player)
	return placedCar
end

local function playSound(name, parent)
	local sFolder = game.ReplicatedStorage:FindFirstChild("GameSounds")
	if sFolder and sFolder:FindFirstChild(name) then
		local s = sFolder[name]:Clone()
		s.Parent = parent
		s:Play()
		Debris:AddItem(s, 2)
	end
end

-- ============================================================================
-- 🎮 INTERACTION LOGIC
-- ============================================================================

local function AttemptPlace(player, padObject, padPart, occupiedVal, linkedCarVal, placePrompt, pickupPrompt)
	if occupiedVal.Value then return end

	-- Double Check: Is it unlocked? (Security Layer)
	local padNum = getPadNumber(padObject)
	local level = player:GetAttribute("HighestUnlockedPad") or 1
	if not padNum or padNum > level then return end

	local thisPlot = getPlotFolder(padObject)
	local owner = thisPlot and thisPlot:FindFirstChild("Owner")
	if not thisPlot or not owner or owner.Value ~= player.Name or player:GetAttribute("OccupiedPlot") ~= thisPlot.Name then return end
	if not isCloseEnough(player, padPart) then return end

	local tool = player.Character and player.Character:FindFirstChildWhichIsA("Tool")
	if not tool then return end

	-- 🛡️ SECURITY FIX: PREVENT SPOOFING
	-- 1. Must be issued by server
	if not tool:GetAttribute("IssuedByServer") then return end

	-- 2. Get the Secure ID (Server Authority)
	local secureToolId = tool:GetAttribute("ToolId")
	local itemId = tool:GetAttribute("ItemId")
	if not secureToolId or type(itemId) ~= "string" or itemId == "" then
		warn("⚠️ Security: Tool missing ID attribute: " .. tool.Name)
		return 
	end

	-- Fix 8: PadController Spoofing Check Circularity
	-- Note: The check secureToolId ~= tool.Name was circular since a client can spoof both properties.
	-- The true security layer happens here, where safeFindCarModel strictly validates the given ID
	-- directly against the real, server-locked ServerStorage hierarchy folders.
	local realModelName = FindModelNameFromTool(secureToolId)
	local realCar = realModelName and safeFindCarModel(realModelName)

	if realCar then
		local success, result = pcall(function()
			return spawnCarOnPad(padPart, realCar, thisPlot, player)
		end)

		if success and result then
			result:SetAttribute("OwnerUserId", player.UserId)
			result:SetAttribute("ItemId", itemId)
			result:SetAttribute("CarGUID", itemId)
			result:SetAttribute("ToolId", secureToolId)

			if removeToolFromPlayer(player, tool) then
				occupiedVal.Value = true
				linkedCarVal.Value = result

				-- Update State immediately and refresh every placed car display because
				-- Mythical CPS can depend on the best non-Mythical car on the base.
				validatePadState(padObject, occupiedVal, linkedCarVal, placePrompt, pickupPrompt)
				CarCPSDisplayUtils.RefreshPlotCPSDisplays(thisPlot, player)

				if player.Character then
					local edgeOffset = (padPart.Size.Z / 2) + CONSTANTS.EJECT_DISTANCE
					local safeSpot = padPart.CFrame * CFrame.new(0, CONSTANTS.EJECT_HEIGHT, edgeOffset)
					local lookAtCar = CFrame.lookAt(safeSpot.Position, padPart.Position)
					player.Character:PivotTo(lookAtCar)
				end
				playSound("PlaceSound", padPart)
				pcall(function()
					TycoonAdminAPI:Invoke("MarkDirty", player)
					TycoonAdminAPI:Invoke("QueueSaveSoon", player, 3)
				end)

				-- Report only after the authoritative placement and pad state commit.
				if padObject.Name == "Pad1" then
					local tutorialAPI = game:GetService("ServerStorage"):FindFirstChild("TutorialProgressAPI")
					if tutorialAPI and tutorialAPI:IsA("BindableFunction") then
						task.spawn(function() tutorialAPI:Invoke("RecordObjective", player, "CarPlaced") end)
					end
				end
			else
				result:Destroy()
				warn("⚠️ Placement aborted because the exact owned tool was no longer available.")
			end
		else
			warn("⚠️ Spawn Failed for " .. player.Name .. ": " .. tostring(result))
		end
	else
		warn("⚠️ Security Alert: Player " .. player.Name .. " tried to use invalid ToolId: " .. tostring(secureToolId))
	end
end

local function AttemptPickup(player, padObject, padPart, occupiedVal, linkedCarVal, placePrompt, pickupPrompt)
	local thisPlot = getPlotFolder(padObject)
	local owner = thisPlot and thisPlot:FindFirstChild("Owner")
	if not thisPlot or not owner or owner.Value ~= player.Name or player:GetAttribute("OccupiedPlot") ~= thisPlot.Name then return end
	if not isCloseEnough(player, padPart) then return end

	local carToRemove = linkedCarVal.Value
	if not carToRemove then 
		validatePadState(padObject, occupiedVal, linkedCarVal, placePrompt, pickupPrompt) 
		return 
	end

	-- Fix 9: Missing Ownership Validation in AttemptPickup
	if carToRemove:GetAttribute("OwnerUserId") ~= player.UserId then
		warn("⚠️ Security: Player " .. player.Name .. " attempted to pick up a car they do not own!")
		return
	end

	local carName = carToRemove.Name
	local persistedToolId = carToRemove:GetAttribute("ToolId")
	local foundTool = type(persistedToolId) == "string" and safeFindCarTool(persistedToolId)
		or FindToolFromModelName(carName)

	if foundTool then
		local canAdd = TycoonAdminAPI:Invoke("CanAddCar", player, 1)
		if canAdd ~= true then return end
		local backpack = player:FindFirstChild("Backpack")
		local starterGear = player:FindFirstChild("StarterGear")
		if not backpack or not starterGear then return end
		local itemId = carToRemove:GetAttribute("ItemId")
		if type(itemId) ~= "string" or itemId == "" then
			itemId = tostring(player.UserId) .. ":" .. HttpService:GenerateGUID(false)
		end
		local backpackClone = foundTool:Clone()
		local gearClone = foundTool:Clone()
		for _, clone in ipairs({backpackClone, gearClone}) do
			clone:SetAttribute("IssuedByServer", true)
			clone:SetAttribute("IssuedAt", os.time())
			clone:SetAttribute("IssuedId", itemId)
			clone:SetAttribute("ItemId", itemId)
			clone:SetAttribute("ToolId", foundTool.Name)
			clone.CanBeDropped = false
		end
		backpackClone.Parent = backpack
		gearClone.Parent = starterGear

		carToRemove:Destroy()

		occupiedVal.Value = false
		linkedCarVal.Value = nil

		-- Update State immediately and refresh every placed car display because
		-- Mythical CPS can depend on the best non-Mythical car on the base.
		validatePadState(padObject, occupiedVal, linkedCarVal, placePrompt, pickupPrompt)
		CarCPSDisplayUtils.RefreshPlotCPSDisplays(thisPlot, player)
		pcall(function()
			TycoonAdminAPI:Invoke("MarkDirty", player)
			TycoonAdminAPI:Invoke("QueueSaveSoon", player, 3)
		end)

		playSound("EquipSound", padPart)
	else
		warn("❌ CRITICAL: Tool not found for " .. carName)
	end
end

-- ============================================================================
-- 🚀 SETUP
-- ============================================================================
local function setupPad(padObject)
	if registeredPads[padObject] then return end
	local padPart = getMainPart(padObject)
	if not padPart then return end

	for _, child in pairs(padPart:GetChildren()) do
		if child:IsA("ProximityPrompt") then child:Destroy() end
	end

	local occupiedVal = padPart:FindFirstChild("IsOccupied") or Instance.new("BoolValue", padPart)
	occupiedVal.Name = "IsOccupied"
	local linkedCarVal = padPart:FindFirstChild("LinkedCar") or Instance.new("ObjectValue", padPart)
	linkedCarVal.Name = "LinkedCar"

	local placePrompt = Instance.new("ProximityPrompt", padPart)
	placePrompt.Name = "PlacePrompt"; placePrompt.ActionText = "Place Car"; placePrompt.ObjectText = "Car Pad"
	placePrompt.MaxActivationDistance = CONSTANTS.PROMPT_RANGE; placePrompt.RequiresLineOfSight = false
	placePrompt.HoldDuration = CONSTANTS.HOLD_DURATION

	local pickupPrompt = Instance.new("ProximityPrompt", padPart)
	pickupPrompt.Name = "PickupPrompt"; pickupPrompt.ActionText = "Pick Up"; pickupPrompt.ObjectText = "Occupied Pad"
	pickupPrompt.MaxActivationDistance = CONSTANTS.PROMPT_RANGE; pickupPrompt.RequiresLineOfSight = false
	pickupPrompt.HoldDuration = CONSTANTS.HOLD_DURATION; pickupPrompt.Enabled = false

	local connections = {}
	local function refreshPad()
		if not padObject.Parent then return end
		local ok, refreshError = pcall(function()
			validatePadState(padObject, occupiedVal, linkedCarVal, placePrompt, pickupPrompt)
		end)
		if not ok then warn("[PadController] Pad refresh failed for " .. padObject.Name .. ": " .. tostring(refreshError)) end
	end
	registeredPads[padObject] = refreshPad

	-- Refresh immediately and on authoritative state changes. A slow safety pass
	-- below remains for malformed hierarchy changes, without scanning every plot.
	refreshPad()
	table.insert(connections, occupiedVal.Changed:Connect(refreshPad))
	table.insert(connections, linkedCarVal.Changed:Connect(refreshPad))
	local plot = getPlotFolder(padObject)
	local ownerValue = plot and plot:FindFirstChild("Owner")
	if ownerValue and ownerValue:IsA("ValueBase") then
		table.insert(connections, ownerValue.Changed:Connect(refreshPad))
	end
	table.insert(connections, padObject.Destroying:Connect(function()
		registeredPads[padObject] = nil
		for _, connection in ipairs(connections) do
			if connection.Connected then connection:Disconnect() end
		end
	end))

	-- Fix 3: PadController processingTracks deadlocks on error
	-- Use a pcall wrapper so state is always released regardless of internal errors.
	placePrompt.Triggered:Connect(function(player)
		local userId = player.UserId
		if processingTracks[userId] then return end
		processingTracks[userId] = true
		PlayerTransactionCoordinator.Run(player, "PadPlace", function()
			AttemptPlace(player, padObject, padPart, occupiedVal, linkedCarVal, placePrompt, pickupPrompt)
			return true
		end)
		task.wait(CONSTANTS.RETRY_DELAY)
		processingTracks[userId] = nil
	end)

	pickupPrompt.Triggered:Connect(function(player)
		local userId = player.UserId
		if processingTracks[userId] then return end
		processingTracks[userId] = true
		PlayerTransactionCoordinator.Run(player, "PadPickup", function()
			AttemptPickup(player, padObject, padPart, occupiedVal, linkedCarVal, placePrompt, pickupPrompt)
			return true
		end)
		task.wait(CONSTANTS.RETRY_DELAY)
		processingTracks[userId] = nil
	end)
end

-- Initialize Existing Tycoons
local function initPadsFolder(padsFolder)
	if padsFolder then
		if padsFolder:GetAttribute("PadControllerConnected") then return end
		padsFolder:SetAttribute("PadControllerConnected", true)
		for _, pad in pairs(padsFolder:GetChildren()) do setupPad(pad) end
		padsFolder.ChildAdded:Connect(setupPad)
	end
end

local function setupPlot(plot)
	initPadsFolder(plot:WaitForChild("Pads", 10))

	local dedicatedFolder = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")
	local storedPlot = dedicatedFolder and dedicatedFolder:FindFirstChild(plot.Name)
	if storedPlot then initPadsFolder(storedPlot:FindFirstChild("Pads")) end
end

local function setupStoredPlot(storedPlot)
	if not storedPlot then return end
	initPadsFolder(storedPlot:FindFirstChild("Pads"))
	storedPlot.ChildAdded:Connect(function(child)
		if child.Name == "Pads" then initPadsFolder(child) end
	end)
end

for _, plot in pairs(TycoonFolder:GetChildren()) do
	setupPlot(plot)
end

local function watchDedicatedStorage(folder)
	for _, storedPlot in ipairs(folder:GetChildren()) do setupStoredPlot(storedPlot) end
	folder.ChildAdded:Connect(setupStoredPlot)
end
local existingDedicatedStorage = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")
if existingDedicatedStorage then watchDedicatedStorage(existingDedicatedStorage) end
ReplicatedStorage.ChildAdded:Connect(function(child)
	if child.Name == "TycoonLevelStorage" then watchDedicatedStorage(child) end
end)

local function refreshPadsForPlayer(player)
	for padObject, refreshPad in pairs(registeredPads) do
		local plot = getPlotFolder(padObject)
		local owner = plot and plot:FindFirstChild("Owner")
		if plot and (player:GetAttribute("OccupiedPlot") == plot.Name or (owner and owner.Value == player.Name)) then
			refreshPad()
		end
	end
end

local function watchPlayerProgression(player)
	player:GetAttributeChangedSignal("HighestUnlockedPad"):Connect(function()
		refreshPadsForPlayer(player)
	end)
	player:GetAttributeChangedSignal("OccupiedPlot"):Connect(function()
		refreshPadsForPlayer(player)
	end)
end
for _, player in ipairs(Players:GetPlayers()) do watchPlayerProgression(player) end
Players.PlayerAdded:Connect(watchPlayerProgression)
Players.PlayerRemoving:Connect(function(player) processingTracks[player.UserId] = nil end)

-- 🔄 Low-frequency defensive validation for unexpected hierarchy edits.
task.spawn(function()
	while true do
		task.wait(60)
		for padObject, refreshPad in pairs(registeredPads) do
			if padObject.Parent then refreshPad() else registeredPads[padObject] = nil end
		end
	end
end)

-- Handle dynamically added plots or pads
TycoonFolder.ChildAdded:Connect(setupPlot)
