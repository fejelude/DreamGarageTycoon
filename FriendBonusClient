local Players = game:GetService("Players")
local SocialService = game:GetService("SocialService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIButtonUtils = require(ReplicatedStorage:WaitForChild("UIButtonUtils"))

local player = Players.LocalPlayer
local gui = script.Parent
local button = gui:WaitForChild("Button")
local information = button:WaitForChild("Information")
local addedBonusLabel = button:WaitForChild("AddedBonus") -- ✅ moved under button

UIButtonUtils.SetupStandardButton(button, information, function()
	local success, err = pcall(function()
		SocialService:PromptGameInvite(player)
	end)
	if not success then
		warn("Failed to prompt game invite: " .. tostring(err))
	end
end)

local function updateBonusText()
	local friendsCount = player:GetAttribute("ActiveFriends") or 0
	if friendsCount == 1 then
		addedBonusLabel.Text = "+10%"
	elseif friendsCount == 2 then
		addedBonusLabel.Text = "+25%"
	elseif friendsCount == 3 then
		addedBonusLabel.Text = "+50%"
	elseif friendsCount == 4 then
		addedBonusLabel.Text = "+75%"
	elseif friendsCount >= 5 then
		addedBonusLabel.Text = "+100%"
	else
		addedBonusLabel.Text = "+0%"
	end
end

player:GetAttributeChangedSignal("ActiveFriends"):Connect(updateBonusText)
updateBonusText()
