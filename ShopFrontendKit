-- ============================================================================
-- 🎨 TWEEN CONTROLLER
-- ============================================================================
local TweenCtrl = {}
local T_SHAKE = TweenInfo.new(0.05, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 4, true)
local T_RESET = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- ✅ WIGGLE EFFECT (Pure Rotation)
function TweenCtrl:SetupWiggle(guiObject)
	if not guiObject then return end

	local wiggleConnection = nil
	local isWiggling = false

	local SPEED = 12  
	local ANGLE = 4   

	local function startWiggle()
		if isWiggling then return end
		isWiggling = true

		local t = 0
		wiggleConnection = RunService.RenderStepped:Connect(function(dt)
			if not guiObject.Parent then 
				if wiggleConnection then wiggleConnection:Disconnect() end
				return 
			end
			t = t + dt * SPEED
			guiObject.Rotation = math.sin(t) * ANGLE
		end)
	end

	local function stopWiggle()
		if not isWiggling then return end
		isWiggling = false

		if wiggleConnection then 
			wiggleConnection:Disconnect() 
			wiggleConnection = nil
		end
		TweenService:Create(guiObject, T_RESET, {Rotation = 0}):Play()
	end

	guiObject.MouseEnter:Connect(startWiggle)
	guiObject.MouseLeave:Connect(stopWiggle)

	guiObject.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			startWiggle()
		end
	end)

	guiObject.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			stopWiggle()
		end
	end)
end

function TweenCtrl:SetupButton(btn, onClick)
	if not btn or not btn:IsA("GuiButton") then return end
	if btn:GetAttribute("KitBound") then return end
	btn:SetAttribute("KitBound", true)

	btn.AutoButtonColor = false
	btn.Active = true
	-- FIX: Ensure button is selectable and interactable for mobile/gamepad
	btn.Selectable = true
	pcall(function() btn.Interactable = true end)

	local uiScale = btn:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale       = Instance.new("UIScale")
		uiScale.Scale = 1.0
		uiScale.Parent = btn
	end


	local isHovering = false
	local isPressed  = false
	local tweenInfo  = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	local function updateScale()
		local target = 1.0
		if isPressed      then target = 0.95
		elseif isHovering then target = 1.05
		end
		TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
	end

	btn.MouseEnter:Connect(function()
		isHovering = true
		UIAudioConfig.PlayHover()
		updateScale()
	end)

	btn.MouseLeave:Connect(function()
		isHovering = false
		isPressed = false
		updateScale()
	end)

	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = true
			updateScale()
		end
	end)

	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = false
			updateScale()
		end
	end)

	-- FIX: Use Activated as the sole primary handler (covers Mouse, Touch, Gamepad).
	-- MouseButton1Click is kept as a PC-only fallback in case Activated is swallowed
	-- by a child element. TouchTap removed — it duplicates Activated on mobile.
	local clickFired = false
	local function handleClick()
		if clickFired then return end
		clickFired = true
		UIAudioConfig.PlayClick()
		if onClick then onClick() end
		task.delay(0.5, function() clickFired = false end)
	end

	btn.Activated:Connect(handleClick)
	btn.MouseButton1Click:Connect(function()
		-- Only fire if Activated didn't already handle it (PC safety net)
		if not clickFired then
			handleClick()
		end
	end)
end

function TweenCtrl:Shake(guiObject)
	local origPos = guiObject.Position
	local t = TweenService:Create(guiObject, T_SHAKE, {Position = origPos + UDim2.new(0,5,0,0)})
	t:Play()
	t.Completed:Connect(function() guiObject.Position = origPos end)
end
Kit.Tween = TweenCtrl

