-- Scans the manually created Base Skins hierarchy and reports missing or invalid instances.
-- Location: ServerScriptService > BaseSkinsHierarchyScanner
-- This script intentionally does not create or repair instances; fix reported issues in Studio.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local StarterPlayer = game:GetService("StarterPlayer")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local PREFIX = "[BaseSkins Scanner]"
local validCount = 0
local missingCount = 0
local incorrectCount = 0

local roots = {
	ReplicatedStorage = ReplicatedStorage,
	ServerStorage = ServerStorage,
	ServerScriptService = ServerScriptService,
	StarterPlayer = StarterPlayer,
	StarterGui = StarterGui,
	Workspace = Workspace,
	Lighting = Lighting,
}

local function splitPath(path)
	local parts = {}
	for part in string.gmatch(path, "[^%.]+") do
		table.insert(parts, part)
	end
	return parts
end

local function resolvePath(path)
	local parts = splitPath(path)
	local current = roots[parts[1]]
	if not current then
		return nil
	end
	for index = 2, #parts do
		current = current:FindFirstChild(parts[index])
		if not current then
			return nil
		end
	end
	return current
end

local function scanExpected(path, className)
	local parts = splitPath(path)
	local current = roots[parts[1]]

	if not current then
		missingCount += 1
		warn(string.format("%s MISSING: %s", PREFIX, path))
		return nil
	end

	for index = 2, #parts do
		local child = current:FindFirstChild(parts[index])
		if not child then
			missingCount += 1
			warn(string.format("%s MISSING: %s", PREFIX, table.concat(parts, ".", 1, index)))
			return nil
		end
		current = child
	end

	if not current:IsA(className) then
		incorrectCount += 1
		warn(string.format("%s WRONG CLASS: %s expected %s, found %s", PREFIX, path, className, current.ClassName))
		return current
	end

	local expectedName = parts[#parts]
	if current.Name ~= expectedName then
		incorrectCount += 1
		warn(string.format("%s WRONG NAME: %s expected name %s, found %s", PREFIX, path, expectedName, current.Name))
		return current
	end

	validCount += 1
	return current
end

local requiredInstances = {
	{ "ReplicatedStorage.BaseAppearanceConfig", "ModuleScript" },
	{ "ReplicatedStorage.BaseSkins", "Folder" },
	{ "ReplicatedStorage.ShopRemotes", "Folder" },
	{ "ReplicatedStorage.ShopRemotes.OpenBaseSkins", "RemoteEvent" },
	{ "ReplicatedStorage.ShopRemotes.BaseSkinsChanged", "RemoteEvent" },
	{ "ReplicatedStorage.ShopRemotes.BaseSkinsTransaction", "RemoteFunction" },
	{ "ServerStorage.BaseSkinsAPI", "BindableFunction" },
	{ "ServerScriptService.BaseSkinsService", "Script" },
	{ "ServerScriptService.BaseSkinsHierarchyScanner", "Script" },
	{ "StarterPlayer.StarterPlayerScripts", "StarterPlayerScripts" },
	{ "StarterPlayer.StarterPlayerScripts.BaseSkinsClient", "LocalScript" },
	{ "StarterGui.BaseSkinUI", "ScreenGui" },
	{ "StarterGui.BaseSkinUI.MainFrame", "Frame" },
	{ "StarterGui.BaseSkinUI.MainFrame.ExitButton", "ImageButton" },
	{ "StarterGui.BaseSkinUI.MainFrame.UpgradeScroller", "ScrollingFrame" },
	{ "StarterGui.BaseSkinUI.MainFrame.UpgradeScroller.Elements", "Frame" },
	{ "StarterGui.BaseSkinUI.MainFrame.UpgradeScroller.Elements.Level1Skins", "Frame" },
	{ "StarterGui.BaseSkinUI.MainFrame.UpgradeScroller.Elements.Level2Skins", "Frame" },
	{ "StarterGui.BaseSkinUI.MainFrame.StateLabels", "Frame" },
	{ "StarterGui.BaseSkinUI.MainFrame.StateLabels.Success", "TextLabel" },
	{ "StarterGui.BaseSkinUI.MainFrame.StateLabels.Failed", "TextLabel" },
	{ "Workspace.NPCS", "Folder" },
	{ "Workspace.NPCS.JakeSaron", "Model" },
	{ "Workspace.NPCS.JakeSaron.HumanoidRootPart", "BasePart" },
	{ "Workspace.NPCS.JakeSaron.HumanoidRootPart.TalkPrompt", "ProximityPrompt" },
	{ "Workspace.Tycoons", "Folder" },
	{ "Lighting.BaseSkinsBlur", "BlurEffect" },
}

local skinIds = { "Black", "Blue", "Pink", "Yellow" }
local uiSkinFolders = {
	Black = "BlackBase",
	Blue = "BlueBase",
	Pink = "PinkBase",
	Yellow = "YellowBase",
}
local skinButtons = { "BuyCash", "BuyForRobux", "GiftMe", "Equip", "Unequip" }

for tycoonNumber = 1, 6 do
	local tycoonPath = string.format("ReplicatedStorage.BaseSkins.Tycoon%d", tycoonNumber)
	table.insert(requiredInstances, { tycoonPath, "Folder" })
	for level = 1, 2 do
		local levelPath = string.format("%s.Level%d", tycoonPath, level)
		table.insert(requiredInstances, { levelPath, "Folder" })
		for _, skinId in ipairs(skinIds) do
			table.insert(requiredInstances, { string.format("%s.Level%dBase%s", levelPath, level, skinId), "Model" })
		end
	end
end

for level = 1, 2 do
	local levelUiPath = string.format("StarterGui.BaseSkinUI.MainFrame.UpgradeScroller.Elements.Level%dSkins", level)
	for _, skinId in ipairs(skinIds) do
		local skinUiPath = string.format("%s.%s", levelUiPath, uiSkinFolders[skinId])
		table.insert(requiredInstances, { skinUiPath, "Frame" })
		for _, buttonName in ipairs(skinButtons) do
			table.insert(requiredInstances, { string.format("%s.%s", skinUiPath, buttonName), "ImageButton" })
		end
	end
end

for _, expected in ipairs(requiredInstances) do
	scanExpected(expected[1], expected[2])
end

local expectedPromptParentPath = "Workspace.NPCS.JakeSaron.HumanoidRootPart"
local expectedPromptPath = expectedPromptParentPath .. ".TalkPrompt"
local expectedPromptParent = resolvePath(expectedPromptParentPath)
local exactPrompt = resolvePath(expectedPromptPath)
local jakeSaron = resolvePath("Workspace.NPCS.JakeSaron")

if not exactPrompt and expectedPromptParent and jakeSaron then
	for _, descendant in ipairs(jakeSaron:GetDescendants()) do
		if descendant.Name == "TalkPrompt" and descendant:IsA("ProximityPrompt") then
			incorrectCount += 1
			warn(string.format("%s WRONG PARENT: TalkPrompt must be inside %s", PREFIX, expectedPromptParentPath))
			break
		end
	end
end

print(string.format("%s Scan complete: %d valid, %d missing, %d incorrect.", PREFIX, validCount, missingCount, incorrectCount))
