-- Handles Shop teleport button interaction.
-- Hover/click uses UIScale (always scales from center, no AnchorPoint adjustment needed).

local Players          = game:GetService("Players")
local Workspace        = game:GetService("Workspace")
local TweenService     = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIAudioConfig    = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local player = Players.LocalPlayer
local button = script.Parent

-- ⚙️ CONFIG
local SHOP_PART_NAME = "ShopTeleportPoint"

-- ============================================================================
-- 🎨 HOVER ANIMATION (UIScale — always scales from center)
-- ============================================================================
local uiScale = button:FindFirstChildOfClass("UIScale")
if not uiScale then
	uiScale       = Instance.new("UIScale")
	uiScale.Scale = 1.0
	uiScale.Parent = button
end

local tweenInfo  = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
local isHovering = false
local isPressed  = false

local function updateScale()
	local target = 1.0
	if isPressed      then target = 0.95
	elseif isHovering then target = 1.05
	end
	TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
end

button.MouseEnter:Connect(function()
	isHovering = true
	UIAudioConfig.PlayHover()
	updateScale()
end)

button.MouseLeave:Connect(function()
	isHovering = false
	isPressed  = false
	updateScale()
end)

button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		isPressed = true
		updateScale()
	end
end)

button.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		isPressed = false
		updateScale()
	end
end)

-- ============================================================================
-- 🛒 TELEPORT LOGIC
-- ============================================================================
button.MouseButton1Click:Connect(function()
	UIAudioConfig.PlayClick()

	local shopPart = Workspace:FindFirstChild(SHOP_PART_NAME)
	if shopPart then
		local char = player.Character
		if char then
			char:PivotTo(shopPart.CFrame + Vector3.new(0, 3, 0))
		end
	else
		warn("❌ Teleport Target '" .. SHOP_PART_NAME .. "' not found in Workspace!")
	end
end)
