	stopInteraction()
end)

-- ============================================================================
-- 🛒 EthourahShopSpeak — NEW dedicated BindableEvent for all shop-driven dialogue.
--
-- ROOT CAUSE OF THE BUG:
--   After the player clicks "Craft" in the NPC menu, releaseInteractionForShop()
--   is called. That sets isInteracting = false.
--   The existing UpdateDialogueEvent handler checks:
--       if not isInteracting or isLeaving then ... return end
--   So every shop event (SacrificeSuccess, NotEnough, AlreadyCrafting, etc.)
--   immediately bailed and the callback fired without Ethourah ever speaking.
--
-- THE FIX:
--   A brand new BindableEvent that the shop controller fires instead of
--   updateDialogue for all post-shop-open events. It has its own typewriter
--   that does NOT check isInteracting at all. It:
--     1. Shows the NPC speech bubble
--     2. Types the dialogue with full animation
--     3. Hides the speech bubble
--     4. Fires the callback (which restores mainFrame in the shop controller)
-- ============================================================================
local EthourahShopSpeak = Instance.new("BindableEvent")
EthourahShopSpeak.Name = "EthourahShopSpeak"
EthourahShopSpeak.Parent = script

local activeShopTypeJob = nil

local function shopTypewrite(label, text, onComplete)
	if not label then
		if onComplete then task.spawn(onComplete) end
		return
	end

	if activeShopTypeJob then
		pcall(task.cancel, activeShopTypeJob)
		activeShopTypeJob = nil
	end

	label.RichText = true
	label.Text = text
	label.MaxVisibleGraphemes = 0

	local len = getCleanTextLength(text)

	activeShopTypeJob = task.spawn(function()
		for i = 1, len do
			label.MaxVisibleGraphemes = i
			if i % 3 == 0 then
				local s = Instance.new("Sound", SoundService)
				s.SoundId = TYPING_SOUND_ID
				s.Volume = 0.1
				s.PlayOnRemove = true
				s:Destroy()
			end
			task.wait(TYPEWRITER_SPEED)
		end
		label.MaxVisibleGraphemes = -1
		activeShopTypeJob = nil
		if onComplete then
			task.spawn(onComplete)
		end
	end)
end

EthourahShopSpeak.Event:Connect(function(actionType, extraInfo, callbackEvent)
	local myGui = playerGui:FindFirstChild(GUI_ID)
	if not myGui then
		if callbackEvent then callbackEvent:Fire() end
		return
	end
	local container = myGui:FindFirstChild(CONTAINER_ID, true)
	if not container then
		if callbackEvent then callbackEvent:Fire() end
		return
	end
	local dialogueLabel = container:FindFirstChild(TEXT_ID, true)
	if not dialogueLabel then
		if callbackEvent then callbackEvent:Fire() end
		return
	end

	-- Show the NPC speech bubble while Ethourah talks
	myGui.Enabled = true
	container.Visible = true

	local coloredName = "<font color='" .. USER_COLOR .. "'>@" .. player.Name .. "</font>"
	local msg = "..."

	if actionType == "MenuOpen" then
		local msgs = {CRAFT_OPEN_MESSAGE, "Take your pick. Both are engineering marvels.", "What do you have your eye on?"}
		msg = msgs[math.random(1, #msgs)]

	elseif actionType == "SelectCar" then
		local display = type(extraInfo) == "string" and extraInfo or (extraInfo and extraInfo.carName or "that car")
		local msgs = {
			"Ah, the <font color='#00E5FF'>" .. display .. "</font>. A beautiful choice.",
			"The <font color='#00E5FF'>" .. display .. "</font>? You have good taste.",
			"Excellent selection. Let's look at what is required."
		}
		msg = msgs[math.random(1, #msgs)]

	elseif actionType == "ConfirmSacrifice" then
		local msgs = {"Are you certain? There is no going back once given.", "Ready to let go of this piece?", "Confirm the sacrifice. It is necessary."}
		msg = msgs[math.random(1, #msgs)]

	elseif actionType == "CancelSacrifice" then
		local msgs = {"Cold feet? I understand.", "Take your time. This isn't a decision to be rushed.", "Perhaps later, then."}
		msg = msgs[math.random(1, #msgs)]

	elseif actionType == "AlreadyDone" then
		local msgs = {"We already have enough of that.", "That requirement is already fulfilled.", "Save it. We don't need any more of those."}
		msg = msgs[math.random(1, #msgs)]

		-- 🔴 Missing item / insufficient cash
	elseif actionType == "NotEnough" then
		local itemName = extraInfo and extraInfo.itemName or "that"
		local msgs = {
			"Don't waste my time. You don't have the <font color='#00E5FF'>" .. itemName .. "</font> in youf.",
			"Dude, you dont even have the <font color='#00E5FF'>" .. itemName .. "</font>. Come back when you actually have it.",
			"You are short on resources. I need the <font color='#00E5FF'>" .. itemName .. "</font> to proceed.",
			"I don't work for free. Bring me the <font color='#00E5FF'>" .. itemName .. "</font> first."
		}
		msg = msgs[math.random(1, #msgs)]

		-- 🟡 Sacrifice accepted, more still needed
	elseif actionType == "SacrificeSuccess" then
		local itemName  = extraInfo and extraInfo.itemName  or "that"
		local itemsLeft = extraInfo and extraInfo.itemsLeft or "?"
		local msgs = {
			"The <font color='#00E5FF'>" .. itemName .. "</font> has been stripped for parts. You still have <font color='#FFD700'>" .. itemsLeft .. "</font> more sacrifices to go.",
			"Sacrifice accepted. Bring me <font color='#FFD700'>" .. itemsLeft .. "</font> more requirements and we can begin.",
			"Alright " .. coloredName .. " thanks for the <font color='#00E5FF'>" .. itemName .. "</font>. We are getting closer, just <font color='#FFD700'>" .. itemsLeft .. "</font> more to go.",
			"Good. The chassis grows stronger. <font color='#FFD700'>" .. itemsLeft .. "</font> more pieces needed.",
			"Another piece of the puzzle. Just <font color='#FFD700'>" .. itemsLeft .. "</font> more to go before the forge is ready."
		}
		msg = msgs[math.random(1, #msgs)]

		-- 🟢 All sacrifices complete — ready to craft
	elseif actionType == "AllComplete" then
		local carName = extraInfo and extraInfo.carName or "the car"
		local msgs = {
			"That was the last one! The <font color='#50C878'>sacrifices are complete</font>. Ready to go?",
			"Every piece is finally in place. Click confirm, and I will begin the build.",
			"We have everything we need. Nice.",
			"All requirements met. The <font color='#00E5FF'>" .. carName .. "</font> is ready to be born. Tell me when to start crafting... when you're ready."
		}
		msg = msgs[math.random(1, #msgs)]

		-- 🔥 Craft just started
	elseif actionType == "CraftStarted" then
		local carName = extraInfo and extraInfo.carName or "your car"
		local timeStr = extraInfo and extraInfo.timeStr or "some time"
		local msgs = {
			"Alright im working on making your <font color='#B652FF'>" .. carName .. "</font>, be back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"Crafting underway homie. The <font color='#B652FF'>" .. carName .. "</font> will be ready in <font color='#FF4C4C'>" .. timeStr .. "</font>."
		}
		msg = msgs[math.random(1, #msgs)]

		-- ⏳ Craft already running — Craft button clicked while build is active
	elseif actionType == "AlreadyCrafting" then
		local carName = extraInfo and extraInfo.carName or "your car"
		local timeStr = extraInfo and extraInfo.timeStr or "some time"
		local msgs = {
			"Patience. you cant make another one dude. im already making the <font color='#B652FF'>" .. carName .. "</font> right now. It will be ready in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"i am making a car for you at this moment " .. coloredName .. " i am making <font color='#B652FF'>" .. carName .. "</font>. Check back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"You cant rush perfection " .. coloredName .. " The <font color='#B652FF'>" .. carName .. "</font> needs <font color='#FF4C4C'>" .. timeStr .. "</font> more time, come back later alright?",
			"I am working as fast as I can. Come back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"The metal is still hot. You must wait exactly <font color='#FF4C4C'>" .. timeStr .. "</font> before the build is complete."
		}
		msg = msgs[math.random(1, #msgs)]

		-- 🟣 Car already crafted and in inventory
	elseif actionType == "AlreadyCrafted" then
		local carName = extraInfo and extraInfo.carName or "your car"
		local msgs = {
			"It is finished. The <font color='#B652FF'>" .. carName .. "</font> is a true work of art. It should be in your inventory already.",
			"The <font color='#B652FF'>" .. carName .. "</font> its already there on your inventory, " .. coloredName .. ".",
			"Construction of the <font color='#B652FF'>" .. carName .. "</font> is done. A flawless execution. it's already there in your inventory."
		}
		msg = msgs[math.random(1, #msgs)]

		-- 🟣 Craft completed (pushed by server timer while player is online)
	elseif actionType == "CraftComplete" then
		local carName = (extraInfo and extraInfo.carName) or "your car"
		local msgs = {
			"It is finished. The <font color='#B652FF'>" .. carName .. "</font> is a true work of art. It should be in your inventory already.",
			"The <font color='#B652FF'>" .. carName .. "</font> its already there on your inventory, " .. coloredName .. ".",
			"Construction of the <font color='#B652FF'>" .. carName .. "</font> is done. A flawless execution. it's already there in your inventory."
		}
		msg = msgs[math.random(1, #msgs)]
	end

	-- Type the message, then hide the bubble and restore the shop frame
	shopTypewrite(dialogueLabel, msg, function()
		myGui.Enabled = false
		container.Visible = false
		if callbackEvent then
			callbackEvent:Fire()
		end
	end)
end)
