local function startInteraction(npcModel)
	if isInteracting or isLeaving then return end

	interactionGeneration += 1
	isInteracting = true
	isOpeningShop = false
	clearConnections()

	local camPart = npcModel:FindFirstChild(CAMERA_PART)
	if not camPart then
		warn("❌ [MythicalEthourahDebug] Error: Missing '" .. CAMERA_PART .. "'")
		isInteracting = false
		return
	end

	if controls then controls:Disable() end
	setFocusMode(true)

	if player.Character then
		local humanoid = player.Character:FindFirstChild("Humanoid")
		if humanoid then
			player:SetAttribute("MovementLock", true)
		end
	end

	camera.CameraType = Enum.CameraType.Scriptable
	TweenService:Create(camera, TWEEN_INFO, {CFrame = camPart.CFrame}):Play()

	local myGui = playerGui:WaitForChild(GUI_ID, 5)
	if not myGui then warn("❌ [MythicalEthourahDebug] Missing GUI") stopInteraction() return end

	myGui.Enabled = true
	local container = myGui:FindFirstChild(CONTAINER_ID, true)
	if not container then warn("❌ [MythicalEthourahDebug] Missing Frame") stopInteraction() return end

	container.Visible = true
	setButtonsState(false)

	local dialogueLabel = container:FindFirstChild(TEXT_ID, true)
	if dialogueLabel then
		local coloredName = "<font color='" .. USER_COLOR .. "'>" .. player.DisplayName .. "</font>"
		local randomGreeting = GREETING_DIALOGUES[math.random(1, #GREETING_DIALOGUES)]
		local greeting = randomGreeting .. coloredName .. "."

		typewrite(dialogueLabel, greeting, function()
			setButtonsState(true)
		end)

		local function connectBtn(btnName, func)
			local btn = myGui:FindFirstChild(btnName, true)
			if btn and btn:IsA("GuiButton") then
				animateButton(btn)
				local conn = btn.MouseButton1Click:Connect(function()
					UIAudioConfig.PlayClick()
					func()
				end)
				table.insert(buttonConnections, conn)
			else
				warn("⚠️ [MythicalEthourahDebug] Warning: Could not find button '" .. btnName .. "' in UI.")
			end
		end

		-- ✅ CHANGE 1: Leave button — delay runs alongside typewrite (matches Angelo behaviour)
		connectBtn(BTN_LEAVE_ID, function()
			if isLeaving then return end
			isLeaving = true
			clearConnections()
			setButtonsState(false)
			if dialogueLabel then
				local coloredRedName = "<font color='" .. ETHOURAH_COLOR .. "'>" .. player.DisplayName .. "</font>"
				local goodbyeMsg = "<font color='" .. GREEN_COLOR .. "'>Aight slide out then. Come back when you ready to get serious </font>" .. coloredRedName .. "."
				typewrite(dialogueLabel, goodbyeMsg)
			end
			task.wait(LEAVE_DELAY)
			stopInteraction()
		end)

		connectBtn(BTN_INQUIRY_ID, function()
			setButtonsState(false)
			if dialogueLabel then
				local inqMsgs = {
					"You wanna know how this works? Aight listen up. You bring me the rides and the cash I ask for, and I build you something nobody else got. No sacrifices, no car. Simple as that. I don't do handouts.",
					"It's basic math bro. You hand over the exact whips I need, I tear 'em apart, and I hand you back a Mythic. Don't overthink it.",
					"Look, I take what's good and make it perfect. Bring the tribute I ask for and you'll leave with a legend. No cap."
				}
				local loreText = inqMsgs[math.random(1, #inqMsgs)]
				typewrite(dialogueLabel, loreText, function()
					setButtonsState(true)
				end)
			end
		end)

		connectBtn(BTN_CRAFT_ID, function()
			if isOpeningShop then return end

			setButtonsState(false)

			if not hasRequiredRank("MVP++") then
				local msgs = {
					"Nah bro, you ain't ready for this heat. Hit <font color='#FF4444'><b>MVP++</b></font> or step off.",
					"Come back when you actually matter on god. <font color='#FF4444'><b>MVP++</b></font> is the baseline here.",
					"I only do business with the absolute highest rollers. Get your <font color='#FF4444'><b>MVP++</b></font> up and we'll talk.",
					"You think you can just walk up to me with that weak rank? Go get <font color='#FF4444'><b>MVP++</b></font> first."
				}
				local responseText = msgs[math.random(1, #msgs)]
				typewrite(dialogueLabel, responseText, function()
					task.wait(2.0)
					stopInteraction()
				end)
				return
			end

			-- ✅ CHANGE 2: Active craft pre-check (matches Angelo behaviour)
			local FuncGetState = MythicalRemotes:FindFirstChild("GetMythicalShopState")
			local currentState = FuncGetState and FuncGetState:InvokeServer() or {}

			local activeCar, endTime
			if currentState and currentState.ActiveCrafts then
				for c, e in pairs(currentState.ActiveCrafts) do
					activeCar = c
					endTime = e
					break
				end
			end

			if activeCar and endTime then
				-- NPC speaks about active craft, then opens the shop after a short pause.
				isOpeningShop = true
				local openGeneration = interactionGeneration

				local busyMsgs = {
					"Chill bro I'm already working on your car. Wait until the current one is done.",
					"You can't just stack orders on me like that. Come back when I finish what's on the forge.",
					"One at a time fam. I need to wrap up your current build first.",
					"The forge is occupied. Pull up again once I'm done with what you already ordered.",
					"Bro I only got two hands. Let me finish before you come asking for more.",
				}
				local responseText = busyMsgs[math.random(1, #busyMsgs)]

				typewrite(dialogueLabel, responseText, function()
					if not isInteracting or not isOpeningShop or interactionGeneration ~= openGeneration then return end

					if pendingShopOpenTask then
						pcall(task.cancel, pendingShopOpenTask)
					end

					pendingShopOpenTask = task.spawn(function()
						task.wait(1)
						if not isInteracting or not isOpeningShop or interactionGeneration ~= openGeneration then return end
						releaseInteractionForShop()
						RemoteOpen:FireServer()
					end)
				end)
				return
			end

			isOpeningShop = true
			local openGeneration = interactionGeneration

			local openMsgs = {
				CRAFT_OPEN_MESSAGE,
				"Aight let's see what you're working with. Pick a blueprint.",
				"Bet. Pull up the menu and choose what you wanna drop bags on.",
				"Let's get it. Choose a chassis and I'll tell you the cost."
			}
			local openMsg = openMsgs[math.random(1, #openMsgs)]

			typewrite(dialogueLabel, openMsg, function()
				if not isInteracting or not isOpeningShop or interactionGeneration ~= openGeneration then return end

				if pendingShopOpenTask then
					pcall(task.cancel, pendingShopOpenTask)
				end

				pendingShopOpenTask = task.spawn(function()
					task.wait(SHOP_OPEN_DELAY_SECONDS)
					if not isInteracting or not isOpeningShop or interactionGeneration ~= openGeneration then return end
					releaseInteractionForShop()
					RemoteOpen:FireServer()
				end)
			end)
		end)
	else
		warn("❌ [MythicalEthourahDebug] ERROR: Could not find TextLabel named '" .. TEXT_ID .. "' inside Container!")
		setButtonsState(true)
	end
end

