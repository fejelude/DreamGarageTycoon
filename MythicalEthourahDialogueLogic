local ProximityPromptService = game:GetService("ProximityPromptService")

local function isLegendaryPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then return false end
	return string.lower(prompt.Name) == string.lower(PROMPT_NAME)
end

local function findLegendaryNPCFromPrompt(prompt)
	local current = prompt and prompt.Parent
	while current do
		if current:IsA("Model") and current.Name == TARGET_NPC then return current end
		current = current.Parent
	end
	return nil
end

local function setupNPC()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, triggerPlayer)
		if triggerPlayer == player and isLegendaryPrompt(prompt) then
			local npc = findLegendaryNPCFromPrompt(prompt)
			if npc and npc.Name == TARGET_NPC then
				startInteraction(npc)
			end
		end
	end)
end

setupNPC()

