-- 🛒 EthourahShopSpeak — dedicated BindableEvent for all shop-driven dialogue.
-- ============================================================================
local EthourahShopSpeak = Instance.new("BindableEvent")
EthourahShopSpeak.Name = "EthourahShopSpeak"
EthourahShopSpeak.Parent = script

local activeShopTypeJob = nil

local function shopTypewrite(label, text, onComplete)
	if not label then
		if onComplete then task.spawn(onComplete) end
		return
	end

	if activeShopTypeJob then
		pcall(task.cancel, activeShopTypeJob)
		activeShopTypeJob = nil
	end

	label.RichText = true
	label.Text = text
	label.MaxVisibleGraphemes = 0

	local len = getCleanTextLength(text)

	activeShopTypeJob = task.spawn(function()
		for i = 1, len do
			label.MaxVisibleGraphemes = i
			if i % 3 == 0 then
				local s = Instance.new("Sound", SoundService)
				s.SoundId = TYPING_SOUND_ID
				s.Volume = 0.1
				s.PlayOnRemove = true
				s:Destroy()
			end
			task.wait(TYPEWRITER_SPEED)
		end
		label.MaxVisibleGraphemes = -1
		activeShopTypeJob = nil
		if onComplete then
			task.spawn(onComplete)
		end
	end)
end

