-- =========================
FuncAcknowledge.OnServerInvoke = function(player, carName)
	if typeof(carName) ~= "string" then return false end
	local session = getSession(player)
	if session.CompletedCrafts[carName] then
		local completedAt = session.CompletedCrafts[carName]
		session.CompletedCrafts[carName] = nil
		pushUpdate(player, session, "Acknowledge")
		local saveOk = savePlayerNow(player)
		if not saveOk then
			session.CompletedCrafts[carName] = completedAt
			pushUpdate(player, session, "Complete")
			return false
		end
		return true
	end
	return false
end

-- =========================
-- SKIP CRAFTING BINDABLE (FROM RECEIPT ROUTER)
-- =========================
SkipCraftFunc.OnInvoke = function(player)
	if not player then return false, "No player provided" end
	if not player.Parent then return false, "Player left before craft skip could be granted" end

	local uid = player.UserId
	if InteractionLocks[uid] then
		-- ProcessReceipt will return NotProcessedYet, letting Roblox retry after the
		-- in-flight craft/sacrifice/save operation finishes instead of racing it.
		return false, "Craft transaction in progress"
	end

	InteractionLocks[uid] = true

	local pOk, logicOk, msg = pcall(function()
		local session = getSession(player)

		if session.PendingPremiumCraft
			and session.CompletedCrafts[session.PendingPremiumCraft]
			and not session.ActiveCrafts[session.PendingPremiumCraft]
		then
			session.PendingPremiumCraft = nil
			local saveOk, saveMessage = savePlayerNow(player)
			if saveOk then
				return true, "Already granted"
			end
			return false, saveMessage or "System error saving completed craft"
		end

		local activeCars = {}
		if session.PendingPremiumCraft then
			table.insert(activeCars, {
				CarName = session.PendingPremiumCraft,
				WasPendingPremium = true,
				OriginalEndTime = nil,
			})
			session.PendingPremiumCraft = nil
		else
			for carName, endTime in pairs(session.ActiveCrafts) do
				table.insert(activeCars, {
					CarName = carName,
					WasPendingPremium = false,
					OriginalEndTime = endTime,
				})
			end
		end

		local foundActive = false
		local grantFailureMessage = nil
		for _, craftInfo in ipairs(activeCars) do
			local carName = craftInfo.CarName
			local recipe = RECIPES[carName]
			if not recipe then
				grantFailureMessage = "Invalid craft recipe"
				continue
			end

			session.ActiveCrafts[carName] = nil
			session.CompletedCrafts[carName] = os.time()
			session.CraftProgress[carName] = {}
			local realToolName = recipe.TargetCar
			local alreadyAwarded = session.AwardedCrafts[carName] ~= nil
			session.AwardedCrafts[carName] = session.AwardedCrafts[carName] or os.time()
			local invokeOk, giveResult, giveMessage = grantCraftReward(player, carName, realToolName, "MythicalCraftSkip")

			if invokeOk and giveResult ~= false then
				if not alreadyAwarded then
					recordRankCraft(player, realToolName)
				end
				local saveOk, saveMessage = savePlayerNow(player)
				if not saveOk then
					warn("[MythicalShop] Failed to save skipped " .. realToolName .. " for " .. player.Name .. ": " .. tostring(saveMessage))
					return false, saveMessage or "System error saving item"
				end
				pushUpdate(player, session, "Skipped")
				foundActive = true
			else
				warn("⚠️ [MythicalShop] Failed to grant skipped " .. realToolName .. " to " .. player.Name)
				grantFailureMessage = giveMessage or giveResult or "System error granting item"
				if craftInfo.WasPendingPremium then
					session.PendingPremiumCraft = carName
				else
					session.ActiveCrafts[carName] = craftInfo.OriginalEndTime
				end
				session.CompletedCrafts[carName] = nil
				if not alreadyAwarded then
					session.AwardedCrafts[carName] = nil
				end
			end
		end

		if not foundActive then
			for completedCar in pairs(session.CompletedCrafts) do
				if RECIPES[completedCar] then
					if session.PendingPremiumCraft == completedCar then
						session.PendingPremiumCraft = nil
					end
					local saveOk, saveMessage = savePlayerNow(player)
					if saveOk then
						return true, "Already granted"
					end
					return false, saveMessage or "System error saving completed craft"
				end
			end

			return false, grantFailureMessage or "No active crafts to skip"
		end

		return true, "Success"
	end)

	InteractionLocks[uid] = nil

	if not pOk then
		warn("Mythical Shop Skip Error:", logicOk)
		return false, "Internal System Error"
	end

	return logicOk, msg
end

