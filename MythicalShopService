FuncGetState.OnServerInvoke = function(player)
	local session = getSession(player)
	return buildStatePayload(session)
end

RemoteRequestOpen.OnServerEvent:Connect(function(player)
	local now        = os.clock()
	local lastOpenAt = LastOpenRequestAt[player.UserId]
	if lastOpenAt and (now - lastOpenAt) < OPEN_REQUEST_COOLDOWN_SECONDS then return end

	local char = player.Character
	if not char or not char.PrimaryPart then return end

	local npcs    = workspace:FindFirstChild("NPCS")
	local ethourah  = npcs and npcs:FindFirstChild("ethourah")
	if not ethourah then return end

	local ethourahRoot = ethourah:FindFirstChild("HumanoidRootPart")
	if not ethourahRoot then return end

	local distance = (char.PrimaryPart.Position - ethourahRoot.Position).Magnitude
	if distance <= MAX_INTERACTION_DISTANCE then
		if not hasRequiredRank(player) then return end
		LastOpenRequestAt[player.UserId] = now
		local session = getSession(player)
		pushUpdate(player, session, "Open")
		RemoteOpen:FireClient(player)
	else
		warn(string.format(
			"🛡️ [Security] %s attempted to open Mythical Shop from %d studs away.",
			player.Name, math.floor(distance)
			))
	end
end)

FuncPrepareSacrifice.OnServerInvoke = function(player, carName, ingredient)
	if typeof(carName) ~= "string" or typeof(ingredient) ~= "string" then
		return false, "Invalid Request"
	end
	if not player or not player.Parent then return false, "Player missing" end
































	local recipe = RECIPES[carName]
	if not recipe              then return false, "Invalid Mythical Car" end
	if not recipe[ingredient]  then return false, "Invalid Ingredient"    end

	if not hasRequiredRank(player) then return false, "Rank requirement not met" end

	local session = getSession(player)
	local progress = session.CraftProgress[carName] or {}
	local requiredAmount = recipe[ingredient]
	local currentAmount = progress[ingredient] or 0
	if currentAmount >= requiredAmount then return false, "Ingredient already complete!" end
	if next(session.ActiveCrafts) then return false, "Craft already in progress!" end
	if session.PendingPremiumCraft then return false, "Premium craft purchase already pending!" end

	if ingredient ~= "Cash" then
		local hasOk, owns = invokeInventory("HasTool", player, ingredient, 1)
		if not hasOk then return false, "System error checking inventory." end
		if not owns then return false, getMissingIngredientMessage(ingredient) end
	end

	return true, issueSacrificeConfirmation(player, carName, ingredient)
end

FuncSacrifice.OnServerInvoke = function(player, carName, ingredient, confirmationToken)
	if typeof(carName) ~= "string" or typeof(ingredient) ~= "string" then
		return false, "Invalid Request"
	end
	if not player or not player.Parent then return false, "Player missing" end

	local recipe = RECIPES[carName]
	if not recipe              then return false, "Invalid Mythical Car" end
	if not recipe[ingredient]  then return false, "Invalid Ingredient"    end

	if not hasRequiredRank(player) then return false, "Rank requirement not met" end

	local uid = player.UserId
	if InteractionLocks[uid] then return false, "Transaction in progress" end

	InteractionLocks[uid] = true

	local pOk, logicOk, msg = pcall(function()
		if not consumeSacrificeConfirmation(player, carName, ingredient, confirmationToken) then
			return false, "Sacrifice confirmation required."
		end

		local session        = getSession(player)
		if not session.CraftProgress[carName] then session.CraftProgress[carName] = {} end
		local progress       = session.CraftProgress[carName]
		local requiredAmount = recipe[ingredient]
		local currentAmount  = progress[ingredient] or 0

		if currentAmount >= requiredAmount   then return false, "Ingredient already complete!" end
		if next(session.ActiveCrafts)         then return false, "Craft already in progress!"  end
		if session.PendingPremiumCraft        then return false, "Premium craft purchase already pending!" end

		if ingredient == "Cash" then
			local cost   = requiredAmount - currentAmount
			local ls     = player:FindFirstChild("leaderstats")
			local wallet = ls and ls:FindFirstChild("Wallet")
			if not wallet               then return false, "Wallet Not Found" end
			if wallet.Value < cost      then return false, "Insufficient Cash (Withdraw from ATM)" end

			local originalWallet = wallet.Value
			wallet.Value -= cost
			session.CraftProgress[carName][ingredient] = requiredAmount

			local saveOk, saveMessage = queuePlayerSaveSoon(player)
			if not saveOk then
				wallet.Value = originalWallet
				session.CraftProgress[carName][ingredient] = currentAmount
				savePlayerNow(player)
				return false, saveMessage or "Save failed. Sacrifice was not consumed."
			end
		else
			local hasOk, owns = invokeInventory("HasTool", player, ingredient, 1)
			if not hasOk  then return false, "System error checking inventory." end
			if not owns   then return false, getMissingIngredientMessage(ingredient) end

			local removeOk, removedOk, removedCount =
				invokeInventory("RemoveTool", player, ingredient, 1)
			if not removeOk               then return false, "System error removing car."          end
			if not removedOk or (removedCount or 0) < 1 then
				return false, getMissingIngredientMessage(ingredient)
			end

			session.CraftProgress[carName][ingredient] = currentAmount + 1

			local saveOk, saveMessage = queuePlayerSaveSoon(player)
			if not saveOk then
				session.CraftProgress[carName][ingredient] = currentAmount
				invokeInventory("GiveTool", player, ingredient, {
					BypassStorageLimit = true,
					Source = "SacrificeRollback",
				})
				savePlayerNow(player)
				return false, saveMessage or "Save failed. Sacrifice was not consumed."
			end
		end

		pushUpdate(player, session, "Sacrifice")

		return true, "Success"
	end)

	InteractionLocks[uid] = nil

	if not pOk then
		warn("Mythical Shop Sacrifice Error:", logicOk)
		return false, "Internal System Error"
	end

	return logicOk, msg
end

-- =========================
-- PREPARE PREMIUM SKIP
--
-- Called immediately before any Robux skip prompt (including the Active Craft
-- frame). This makes every client entry point use the same persisted backend
-- state that ProcessReceipt consumes. If the receipt callback is delayed until
-- a later server or after rejoin, PendingPremiumCraft still identifies the
-- exact craft to complete.
-- =========================
FuncRequestSkip.OnServerInvoke = function(player, carName)
	if typeof(carName) ~= "string" then return false, "Invalid Request" end
	if not player or not player.Parent then return false, "Player missing" end

	local recipe = RECIPES[carName]
	if not recipe then return false, "Invalid Mythical Car" end

	if not hasRequiredRank(player) then return false, "Rank requirement not met" end

	local uid = player.UserId
	if InteractionLocks[uid] then return false, "Transaction in progress" end

	InteractionLocks[uid] = true

	local pOk, logicOk, msg = pcall(function()
		local session = getSession(player)

		if session.CompletedCrafts[carName] then
			return false, "Craft already completed"
		end

		if session.PendingPremiumCraft then
			if session.PendingPremiumCraft ~= carName then
				return false, "Another premium craft purchase is already pending"
			end
			pushUpdate(player, session, "PendingPremium")
			return true, "PendingPremium"
		end

		if not session.ActiveCrafts[carName] then
			return false, "No active craft to skip"
		end

		session.PendingPremiumCraft = carName
		local saveOk, saveMessage = savePlayerNow(player)
		if not saveOk then
			session.PendingPremiumCraft = nil
			return false, saveMessage or "Save failed. Premium skip was not prepared."
		end

		pushUpdate(player, session, "PendingPremium")
		return true, "PendingPremium"
	end)

	InteractionLocks[uid] = nil

	if not pOk then
		warn("Mythical Shop Prepare Skip Error:", logicOk)
		return false, "Internal System Error"
	end

	return logicOk, msg
end

FuncCraftCar.OnServerInvoke = function(player, carName, isPremiumRequest)
	if typeof(carName) ~= "string" then return false, "Invalid Request" end
	if not player or not player.Parent then return false, "Player missing" end

































	local recipe = RECIPES[carName]
	if not recipe then return false, "Invalid Mythical Car" end

	if not hasRequiredRank(player) then return false, "Rank requirement not met" end

	local uid = player.UserId
	if InteractionLocks[uid] then return false, "Transaction in progress" end

	InteractionLocks[uid] = true

	local pOk, logicOk, msg = pcall(function()
		local session = getSession(player)

		if next(session.ActiveCrafts) then return false, "Crafting already in progress!" end

		if session.CompletedCrafts[carName] then return false, "You already crafted this!"    end

		if session.PendingPremiumCraft then
			if session.PendingPremiumCraft ~= carName then
				return false, "Premium craft purchase already pending!"
			end
			if isPremiumRequest then
				return true, "PendingPremium"
			end
			session.PendingPremiumCraft = nil
		end

		local progress = session.CraftProgress[carName] or {}

		for ingredient, requiredAmount in pairs(recipe) do
			if ingredient == "TargetCar" or ingredient == "CraftTime" then continue end
			local currentAmount = progress[ingredient] or 0
			if currentAmount < requiredAmount then
				return false, "Missing requirements!"
			end
		end

		if isPremiumRequest then
			session.PendingPremiumCraft = carName
			local saveOk, saveMessage = savePlayerNow(player)
			if not saveOk then
				session.PendingPremiumCraft = nil
				return false, saveMessage or "Save failed. Premium craft was not started."
			end
			pushUpdate(player, session, "PendingPremium")
			return true, "PendingPremium"
		end

		session.ActiveCrafts[carName] = os.time() + recipe.CraftTime

		local saveOk, saveMessage = savePlayerNow(player)
		if not saveOk then
			session.ActiveCrafts[carName] = nil
			return false, saveMessage or "Save failed. Craft was not started."
		end

		pushUpdate(player, session, "Craft")

		return true, "Success"
	end)

	InteractionLocks[uid] = nil

	if not pOk then
		warn("Mythical Shop Craft Error:", logicOk)
		return false, "Internal System Error"
	end

	return logicOk, msg
end

-- =========================
