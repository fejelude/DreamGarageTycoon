-- =========================
-- HELPERS
-- =========================
local function getIngredientDisplayName(ingredient)
	return tostring(ingredient)
end

local function getMissingIngredientMessage(ingredient)
	return "You don't own the required car (" .. getIngredientDisplayName(ingredient) .. ")!"
end

local function invokeInventory(action, ...)
	local args = table.pack(...)
	local ok, result1, result2, result3 = pcall(function()
		return MythicalInventoryBindable:Invoke(action, table.unpack(args, 1, args.n))
	end)
	if not ok then
		return false, result1
	end
	return true, result1, result2, result3
end

local function savePlayerNow(player)
	local invokeOk, saveOk, saveMessage = invokeInventory("SaveNow", player)
	if not invokeOk then
		return false, tostring(saveOk or "Save system error")
	end
	if saveOk ~= true then
		return false, tostring(saveMessage or saveOk or "Save failed")
	end
	return true
end

local function queuePlayerSaveSoon(player)
	local invokeOk, saveOk, saveMessage = invokeInventory("QueueSaveSoon", player, 8)
	if not invokeOk then
		return false, tostring(saveOk or "Save system error")
	end
	if saveOk ~= true then
		return false, tostring(saveMessage or saveOk or "Save queue failed")
	end
	return true
end

local function grantCraftReward(player, recipeCarName, realToolName, source)
	return invokeInventory("GiveTool", player, realToolName, {
		BypassStorageLimit = true,
		Source = source,
		CraftRecipe = recipeCarName,
	})
end

-- =========================
-- SESSION
-- =========================
local function getSession(player)
	local uid = player.UserId
	if not PlayerSessions[uid] then
		PlayerSessions[uid] = {
			CraftProgress  = {
				["Centurion"] = {},
				["Grotti-Ferocious"] = {},
				["Solitaire"] = {},
				["Hyperspace"] = {}
			},
			ActiveCrafts   = {},
			CompletedCrafts = {},
			AwardedCrafts = {},
			PendingPremiumCraft = nil,
		}
	end
	return PlayerSessions[uid]
end

local function buildStatePayload(session)
	return {
		CraftProgress   = session.CraftProgress,
		ActiveCrafts    = session.ActiveCrafts,
		CompletedCrafts = session.CompletedCrafts,
		AwardedCrafts   = session.AwardedCrafts,
		PendingPremiumCraft = session.PendingPremiumCraft,
	}
end

local function pushUpdate(player, session, reason)
	local payload = buildStatePayload(session)
	payload.Reason = reason
	RemoteUpdate:FireClient(player, payload)
end

-- =========================
-- DATA HANDLER INTEGRATION
--
-- "Close" is the ONLY place sessions are cleaned up. The data handler calls
-- "Get" then "Close" in that order, so session data is always available when
-- "Get" runs. Do NOT nil out PlayerSessions anywhere else on player leave.
-- =========================
PersistenceBindable.OnInvoke = function(action, player, data)
	if not player then return end
	local uid = player.UserId

	if action == "Load" then
		local session = getSession(player)

		if type(data) == "table" then
			if type(data.CraftProgress) == "table" then
				session.CraftProgress = data.CraftProgress
			end
			if type(data.ActiveCrafts) == "table" then
				session.ActiveCrafts = data.ActiveCrafts
			end
			if type(data.CompletedCrafts) == "table" then
				session.CompletedCrafts = data.CompletedCrafts
			end
			if type(data.AwardedCrafts) == "table" then
				session.AwardedCrafts = data.AwardedCrafts
			end
			if type(data.PendingPremiumCraft) == "string" and RECIPES[data.PendingPremiumCraft] then
				session.PendingPremiumCraft = data.PendingPremiumCraft
			else
				session.PendingPremiumCraft = nil
			end

			-- Ensure per-car sub-tables always exist
			session.CraftProgress["Centurion"] = session.CraftProgress["Centurion"] or {}
			session.CraftProgress["Grotti-Ferocious"] = session.CraftProgress["Grotti-Ferocious"] or {}
			session.CraftProgress["Solitaire"] = session.CraftProgress["Solitaire"] or {}
			session.CraftProgress["Hyperspace"] = session.CraftProgress["Hyperspace"] or {}

			print("✅ [MythicalShop] Loaded progress for " .. player.Name)
		end

	elseif action == "Get" then
		-- Called by the data handler BEFORE "Close" — session must still be alive here.
		local session = getSession(player)
		return {
			CraftProgress   = session.CraftProgress,
			ActiveCrafts    = session.ActiveCrafts,
			CompletedCrafts = session.CompletedCrafts,
			AwardedCrafts   = session.AwardedCrafts,
			PendingPremiumCraft = session.PendingPremiumCraft,
		}

	elseif action == "Close" then
		-- Called by the data handler AFTER saving. Safe to clean up now.
		PlayerSessions[uid]    = nil
		InteractionLocks[uid]  = nil
		LastOpenRequestAt[uid] = nil
		PendingSacrificeConfirmations[uid] = nil
	end
end

local function recordRankCraft(player, carName)
	local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
	if rankApi then
		return pcall(function() rankApi:Invoke("CarObtained", player, carName, "Craft", nil) end)
	end
	return false
end

local function clearExpiredSacrificeConfirmations(uid)
	local confirmations = PendingSacrificeConfirmations[uid]
	if not confirmations then return end

	local now = os.clock()
	for token, confirmation in pairs(confirmations) do
		if type(confirmation) ~= "table" or (confirmation.ExpiresAt or 0) <= now then
			confirmations[token] = nil
		end
	end
end

local function issueSacrificeConfirmation(player, carName, ingredient)
	local uid = player.UserId
	clearExpiredSacrificeConfirmations(uid)

	local token = HttpService:GenerateGUID(false)
	PendingSacrificeConfirmations[uid] = PendingSacrificeConfirmations[uid] or {}
	PendingSacrificeConfirmations[uid][token] = {
		CarName = carName,
		Ingredient = ingredient,
		ExpiresAt = os.clock() + CONFIRMATION_TOKEN_TTL_SECONDS,
	}

	return token
end

local function consumeSacrificeConfirmation(player, carName, ingredient, token)
	if type(token) ~= "string" or token == "" then
		return false
	end

	local uid = player.UserId
	clearExpiredSacrificeConfirmations(uid)

	local confirmations = PendingSacrificeConfirmations[uid]
	local confirmation = confirmations and confirmations[token]
	if type(confirmation) ~= "table" then
		return false
	end

	confirmations[token] = nil
	return confirmation.CarName == carName and confirmation.Ingredient == ingredient
end

