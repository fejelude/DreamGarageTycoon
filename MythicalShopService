local function isReady(player)
	return player and player.Parent and player:GetAttribute("TycoonDataLoaded") == true
		and player:GetAttribute("TycoonDataClosing") ~= true
end

local function ensureCraftJobId(player, session, carName)
	local existing = session.CraftJobIds[carName]
	if type(existing) == "string" and existing ~= "" then return existing end
	local endTime = session.ActiveCrafts[carName]
	if not endTime and session.PendingPremiumCraft ~= carName then return nil end
	-- Legacy migration uses saved data, so a crashed migration produces the same ID.
	local suffix = endTime and tostring(endTime) or "premium"
	local jobId = CRAFT_TIER .. "Craft:" .. tostring(player.UserId) .. ":" .. carName .. ":legacy:" .. suffix
	session.CraftJobIds[carName] = jobId
	return jobId
end

local function getIngredientDisplayName(ingredient)
	return tostring(ingredient)
end

local function getMissingIngredientMessage(ingredient)
	return "You don't own the required car (" .. getIngredientDisplayName(ingredient) .. ")!"
end

local function invokeInventory(action, ...)
	local args = table.pack(...)
	local ok, result1, result2, result3 = pcall(function()
		return MythicalInventoryBindable:Invoke(action, table.unpack(args, 1, args.n))
	end)
	if not ok then
		return false, result1
	end
	return true, result1, result2, result3
end

local function savePlayerNow(player)
	local invokeOk, saveOk, saveMessage = invokeInventory("SaveNow", player)
	if not invokeOk then
		return false, tostring(saveOk or "Save system error")
	end
	if saveOk ~= true then
		return false, tostring(saveMessage or saveOk or "Save failed")
	end
	return true
end

local function queuePlayerSaveSoon(player)
	local invokeOk, saveOk, saveMessage = invokeInventory("QueueSaveSoon", player, 8)
	if not invokeOk then
		return false, tostring(saveOk or "Save system error")
	end
	if saveOk ~= true then
		return false, tostring(saveMessage or saveOk or "Save queue failed")
	end
	return true
end

-- =========================
-- SESSION
-- =========================
local function getSession(player)
	local uid = player.UserId
	if not PlayerSessions[uid] then
		PlayerSessions[uid] = {
			CraftProgress  = {
				["Centurion"] = {},
				["Grotti-Ferocious"] = {},
				["Solitaire"] = {},
				["Hyperspace"] = {}
			},
			ActiveCrafts   = {},
			CompletedCrafts = {},
			AwardedCrafts = {},
			PendingPremiumCraft = nil,
			CraftJobIds = {},
			PremiumReceipts = {},
			PremiumPromptAccepted = false,
		}
	end
	return PlayerSessions[uid]
end

local function buildStatePayload(session)
	return {
		CraftProgress   = session.CraftProgress,
		ActiveCrafts    = session.ActiveCrafts,
		CompletedCrafts = session.CompletedCrafts,
		AwardedCrafts   = session.AwardedCrafts,
		PendingPremiumCraft = session.PendingPremiumCraft,
	}
end

local function pushUpdate(player, session, reason)
	local payload = buildStatePayload(session)
	payload.Reason = reason
	RemoteUpdate:FireClient(player, payload)
end

-- =========================
-- DATA HANDLER INTEGRATION
--
-- "Close" is the ONLY place sessions are cleaned up. The data handler calls
-- "Get" then "Close" in that order, so session data is always available when
-- "Get" runs. Do NOT nil out PlayerSessions anywhere else on player leave.
-- =========================
PersistenceBindable.OnInvoke = function(action, player, data)
	if not player then return end
	local uid = player.UserId

	if action == "Load" then
		local session = getSession(player)

		if type(data) == "table" then
			if type(data.CraftProgress) == "table" then
				session.CraftProgress = data.CraftProgress
			end
			if type(data.ActiveCrafts) == "table" then
				session.ActiveCrafts = data.ActiveCrafts
			end
			if type(data.CompletedCrafts) == "table" then
				session.CompletedCrafts = data.CompletedCrafts
			end
			if type(data.AwardedCrafts) == "table" then
				session.AwardedCrafts = data.AwardedCrafts
			end
			if type(data.PendingPremiumCraft) == "string" and RECIPES[data.PendingPremiumCraft] then
				session.PendingPremiumCraft = data.PendingPremiumCraft
			else
				session.PendingPremiumCraft = nil
			end

			-- Ensure per-car sub-tables always exist
			session.CraftProgress["Centurion"] = session.CraftProgress["Centurion"] or {}
			session.CraftProgress["Grotti-Ferocious"] = session.CraftProgress["Grotti-Ferocious"] or {}
			session.CraftProgress["Solitaire"] = session.CraftProgress["Solitaire"] or {}
			session.CraftProgress["Hyperspace"] = session.CraftProgress["Hyperspace"] or {}

			print("✅ [MythicalShop] Loaded progress for " .. player.Name)
		end

		if type(data) == "table" then
			if data.CraftJobIds ~= nil then
				assert(type(data.CraftJobIds) == "table", "Invalid craft job identities")
				for carName, jobId in pairs(data.CraftJobIds) do
					assert(RECIPES[carName] and type(jobId) == "string" and #jobId > 0 and #jobId <= 256,
						"Invalid craft job identity")
				end
				session.CraftJobIds = data.CraftJobIds
			end
			if data.PremiumReceipts ~= nil then
				assert(type(data.PremiumReceipts) == "table", "Invalid craft receipt journal")
				for purchaseId, receipt in pairs(data.PremiumReceipts) do
					assert(type(purchaseId) == "string" and #purchaseId > 0 and #purchaseId <= 128
						and type(receipt) == "table" and RECIPES[receipt.CarName]
						and type(receipt.JobId) == "string" and #receipt.JobId > 0 and #receipt.JobId <= 256
						and type(receipt.Completed) == "boolean", "Invalid craft receipt binding")
				end
				session.PremiumReceipts = data.PremiumReceipts
			end
			session.PremiumPromptAccepted = data.PremiumPromptAccepted == true
		end
		for carName, endTime in pairs(session.ActiveCrafts) do
			assert(RECIPES[carName] and type(endTime) == "number" and endTime == endTime
				and endTime > 0 and endTime < math.huge, "Invalid active craft")
			ensureCraftJobId(player, session, carName)
		end
		if session.PendingPremiumCraft then
			ensureCraftJobId(player, session, session.PendingPremiumCraft)
		end
		return true

	elseif action == "Get" then
		-- Called by the data handler BEFORE "Close" — session must still be alive here.
		local session = getSession(player)
		return {
			CraftProgress   = session.CraftProgress,
			ActiveCrafts    = session.ActiveCrafts,
			CompletedCrafts = session.CompletedCrafts,
			AwardedCrafts   = session.AwardedCrafts,
			PendingPremiumCraft = session.PendingPremiumCraft,
			CraftJobIds = session.CraftJobIds,
			PremiumReceipts = session.PremiumReceipts,
			PremiumPromptAccepted = session.PremiumPromptAccepted,
		}

	elseif action == "MarkPremiumPurchased" then
		if not isReady(player) then return false end
		local session = getSession(player)
		if not session.PendingPremiumCraft then return true end
		session.PremiumPromptAccepted = true
		queuePlayerSaveSoon(player)
		return true

	elseif action == "CancelPremium" then
		if not isReady(player) or InteractionLocks[uid] then return false end
		local session = getSession(player)
		local carName = session.PendingPremiumCraft
		if not carName or session.PremiumPromptAccepted then return false end
		local jobId = session.CraftJobIds[carName]
		for _, receipt in pairs(session.PremiumReceipts) do
			if receipt.JobId == jobId then return false end
		end
		InteractionLocks[uid] = true
		session.PendingPremiumCraft = nil
		local ok, saved = pcall(savePlayerNow, player)
		if not ok or not saved then queuePlayerSaveSoon(player) end
		InteractionLocks[uid] = nil
		pushUpdate(player, session, "PremiumCancelled")
		return true

	elseif action == "Close" then
		-- Called by the data handler AFTER saving. Safe to clean up now.
		PlayerSessions[uid]    = nil
		InteractionLocks[uid]  = nil
		LastOpenRequestAt[uid] = nil
		PendingSacrificeConfirmations[uid] = nil
	end
end

-- Publish readiness only after the persistence callback has been installed.
PersistenceBindable:SetAttribute("PersistenceReady", true)

local function finishCraftDelivery(player, session, carName, receiptRecord)
	local recipe = RECIPES[carName]
	if not recipe then return false, "Invalid craft recipe" end
	local jobId = ensureCraftJobId(player, session, carName)
	if not jobId then return false, "Craft identity is missing" end
	-- Persist the delivery identity before writing a different DataStore key.
	local saved, saveMessage = savePlayerNow(player)
	if not saved then
		queuePlayerSaveSoon(player)
		return false, saveMessage or "Craft delivery is waiting for a save."
	end
	if not isReady(player) then return false, "Player data is closing" end
	local delivered, deliveryMessage = InboxService.Enqueue(player.UserId, jobId, {
		RewardType = "Car", RewardId = recipe.TargetCar, DisplayName = recipe.TargetCar,
		SourceType = "Dealer", Source = DEALER_NAME, Rarity = CRAFT_TIER,
		IssuedId = jobId,
	})
	if not delivered then return false, deliveryMessage or "Inbox delivery is pending" end
	if not isReady(player) then return false, "Player data is closing" end
	session.ActiveCrafts[carName] = nil
	session.CompletedCrafts[carName] = os.time()
	session.CraftProgress[carName] = {}
	session.AwardedCrafts[carName] = session.AwardedCrafts[carName] or os.time()
	if session.PendingPremiumCraft == carName then
		session.PendingPremiumCraft = nil
		session.PremiumPromptAccepted = false
	end
	if receiptRecord then receiptRecord.Completed = true end
	-- The Inbox write has succeeded. Retain completion on an uncertain profile save.
	local completionSaved, completionMessage = savePlayerNow(player)
	if not completionSaved then
		queuePlayerSaveSoon(player)
		pushUpdate(player, session, "Complete")
		return false, completionMessage or "Craft completed; its save is pending."
	end
	pushUpdate(player, session, receiptRecord and "Skipped" or "Complete")
	return true, "Success"
end

local function clearExpiredSacrificeConfirmations(uid)
	local confirmations = PendingSacrificeConfirmations[uid]
	if not confirmations then return end

	local now = os.clock()
	for token, confirmation in pairs(confirmations) do
		if type(confirmation) ~= "table" or (confirmation.ExpiresAt or 0) <= now then
			confirmations[token] = nil
		end
	end
end

local function issueSacrificeConfirmation(player, carName, ingredient, selection)
	local uid = player.UserId
	clearExpiredSacrificeConfirmations(uid)

	local token = HttpService:GenerateGUID(false)
	PendingSacrificeConfirmations[uid] = PendingSacrificeConfirmations[uid] or {}
	PendingSacrificeConfirmations[uid][token] = {
		CarName = carName,
		Ingredient = ingredient,
		Selection = selection,
		ExpiresAt = os.clock() + CONFIRMATION_TOKEN_TTL_SECONDS,
	}

	return token
end

local function consumeSacrificeConfirmation(player, carName, ingredient, token)
	if type(token) ~= "string" or token == "" then
		return false
	end

	local uid = player.UserId
	clearExpiredSacrificeConfirmations(uid)

	local confirmations = PendingSacrificeConfirmations[uid]
	local confirmation = confirmations and confirmations[token]
	if type(confirmation) ~= "table" then
		return false
	end

	confirmations[token] = nil
	if confirmation.CarName ~= carName or confirmation.Ingredient ~= ingredient then return nil end
	return confirmation
end

