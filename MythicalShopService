-- OFFLINE COMPLETION / TIMER LOOP
-- =========================
task.spawn(function()
	while true do
		task.wait(5)
		local now = os.time()

		for uid, session in pairs(PlayerSessions) do
			local player = Players:GetPlayerByUserId(uid)
			if not player then continue end
			if InteractionLocks[uid] then continue end

			InteractionLocks[uid] = true
			local pOk, err = pcall(function()
				local dirty = false

				for carName, endTime in pairs(session.ActiveCrafts) do
				if now >= endTime then
					session.ActiveCrafts[carName]   = nil
					if session.PendingPremiumCraft == carName then
						session.PendingPremiumCraft = nil
					end
					session.CompletedCrafts[carName] = now -- save timestamp for dialogue
					session.CraftProgress[carName] = {}

					local realToolName           = RECIPES[carName].TargetCar
					local alreadyAwarded = session.AwardedCrafts[carName] ~= nil
					session.AwardedCrafts[carName] = session.AwardedCrafts[carName] or now
					local invokeOk, giveResult, giveMessage =
						grantCraftReward(player, carName, realToolName, "MythicalCraftComplete")

					if invokeOk and giveResult ~= false then
						if not alreadyAwarded then
							recordRankCraft(player, realToolName)
						end
						savePlayerNow(player)
						print("✅ [MythicalShop] Granted " .. realToolName .. " to " .. player.Name)
						dirty = true
					else
						warn("⚠️ [MythicalShop] Failed to grant " .. realToolName .. " to " .. player.Name)
						-- Revert so the loop retries on the next tick
						session.ActiveCrafts[carName] = endTime
						session.CompletedCrafts[carName] = nil
						if not alreadyAwarded then
							session.AwardedCrafts[carName] = nil
						end
					end
				end
			end

				if dirty then
					pushUpdate(player, session, "Complete")
					savePlayerNow(player)
				end
			end)

			InteractionLocks[uid] = nil
			if not pOk then
				warn("Mythical Shop Completion Error:", err)
			end
		end
	end
end)

