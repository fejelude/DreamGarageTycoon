-- SKIP CRAFTING BINDABLE (FROM RECEIPT ROUTER)
-- =========================
SkipCraftFunc.OnInvoke = function(player, purchaseId)
	if not isReady(player) then return false, "Player data is not ready" end
	if type(purchaseId) ~= "string" or purchaseId == "" or #purchaseId > 128 then
		return false, "Receipt identity is missing"
	end
	local uid = player.UserId
	if InteractionLocks[uid] then return false, "Craft transaction in progress" end
	InteractionLocks[uid] = true
	local ok, success, message = pcall(function()
		local session = getSession(player)
		local receipt = session.PremiumReceipts[purchaseId]
		if receipt then
			if receipt.Completed then
				local saved, saveMessage = savePlayerNow(player)
				if not saved then queuePlayerSaveSoon(player) end
				return saved, saved and "Already granted" or saveMessage
			end
			if session.CraftJobIds[receipt.CarName] ~= receipt.JobId then
				return false, "Receipt craft identity does not match"
			end
		else
			local carName = session.PendingPremiumCraft
			if not carName or not RECIPES[carName] then
				return false, "No premium craft preparation for this receipt"
			end
			local jobId = ensureCraftJobId(player, session, carName)
			if not jobId then return false, "Craft identity is missing" end
			receipt = { CarName = carName, JobId = jobId, Completed = false }
			session.PremiumReceipts[purchaseId] = receipt
			session.PremiumPromptAccepted = true
			local saved, saveMessage = savePlayerNow(player)
			if not saved then
				queuePlayerSaveSoon(player)
				return false, saveMessage or "Receipt binding is waiting for a save."
			end
		end
		return finishCraftDelivery(player, session, receipt.CarName, receipt)
	end)
	InteractionLocks[uid] = nil
	if not ok then
		warn("Craft Skip Error:", success)
		return false, "Internal System Error"
	end
	return success, message
end

-- =========================
-- OFFLINE COMPLETION / TIMER LOOP
-- =========================
task.spawn(function()
	while true do
		task.wait(5)
		local now = os.time()
		for uid, session in pairs(PlayerSessions) do
			local player = Players:GetPlayerByUserId(uid)
			if not isReady(player) or InteractionLocks[uid] then continue end
			InteractionLocks[uid] = true
			local ok, err = pcall(function()
				for carName, endTime in pairs(session.ActiveCrafts) do
					-- A paid receipt keeps its prepared job until grant or trusted cancellation.
					if type(endTime) == "number" and now >= endTime
						and session.PendingPremiumCraft ~= carName then
						local completed, message = finishCraftDelivery(player, session, carName)
						if not completed then warn("[CraftShop] Delivery pending:", carName, tostring(message)) end
					end
				end
			end)
			InteractionLocks[uid] = nil
			if not ok then warn("Craft Completion Error:", err) end
		end
	end
end)

-- Purchase prompt results never grant rewards. Only ProcessReceipt does that.
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, purchased)
	if productId ~= SKIP_PRODUCT_ID then return end
	local player = Players:GetPlayerByUserId(userId)
	if not isReady(player) then return end
	if purchased then
		PersistenceBindable:Invoke("MarkPremiumPurchased", player)
	else
		task.spawn(function()
			for _ = 1, 20 do
				if not isReady(player) then return end
				if not InteractionLocks[userId] then
					PersistenceBindable:Invoke("CancelPremium", player)
					return
				end
				task.wait(0.25)
			end
		end)
	end
end)
