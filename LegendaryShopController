-- DIALOGUE EVENT
local DialogueEvent
task.spawn(function()
	local playerScripts = player:WaitForChild("PlayerScripts")
	local dialogueLogicScript = playerScripts:FindFirstChild("LegendaryAngeloDialogueLogic", true)
	if not dialogueLogicScript then
		-- Fallback to waiting a bit in case it hasn't loaded
		task.wait(2)
		dialogueLogicScript = playerScripts:FindFirstChild("LegendaryAngeloDialogueLogic", true)
	end
	if dialogueLogicScript then
		DialogueEvent = dialogueLogicScript:WaitForChild("UpdateLegendaryAngeloDialogue", 10)
	end
end)

local function updateDialogue(action, info)
	if DialogueEvent then
		DialogueEvent:Fire(action, info)
	end
end

local function forceCloseDialogue()
	if not DialogueEvent then
		local playerScripts = player:FindFirstChild("PlayerScripts")
		local dialogueLogicScript = playerScripts and playerScripts:FindFirstChild("LegendaryAngeloDialogueLogic", true)
		if dialogueLogicScript then
			DialogueEvent = dialogueLogicScript:FindFirstChild("UpdateLegendaryAngeloDialogue")
		end
	end

	if DialogueEvent then
		DialogueEvent:Fire("ForceClose")
	else
		local dialogueUI = PlayerGui:FindFirstChild("UI_NPC_Monk3yDAngelo-Cars")
		if dialogueUI then
			dialogueUI.Enabled = false
		end
	end
end

