-- ============================================================================
-- 👁️ FOCUS MODE (BLUR + HIDE UI)
-- ============================================================================
local function setBlur(enable)
	if enable then
		if not currentBlur then
			currentBlur = Instance.new("BlurEffect")
			currentBlur.Size = 0
			currentBlur.Parent = Lighting
			currentBlur.Name = "LegendaryShopBlur"
		end
		TweenService:Create(currentBlur, TweenInfo.new(0.5), {Size = BLUR_SIZE}):Play()
	else
		if currentBlur then
			local t = TweenService:Create(currentBlur, TweenInfo.new(0.5), {Size = 0})
			t:Play()
			t.Completed:Connect(function()
				if currentBlur then currentBlur:Destroy(); currentBlur = nil end
			end)
		end
	end
end

local function toggleNamedGuiObjects(shouldHide, objectName)
	if shouldHide then
		if #hiddenObjects > 0 then return end
		for _, obj in pairs(PlayerGui:GetDescendants()) do
			if obj:IsA("GuiObject") and obj.Name == objectName and obj.Visible then
				obj.Visible = false
				table.insert(hiddenObjects, obj)
			end
		end
	else
		for _, obj in pairs(hiddenObjects) do
			if obj and obj.Parent and obj:IsA("GuiObject") then
				obj.Visible = true
			end
		end
		hiddenObjects = {}
	end
end

local function toggleOtherGuis(shouldHide)
	local confirmationGui = resolveConfirmationUi()
	if shouldHide then
		if #hiddenGuis > 0 then return end
		hiddenGuis = {}
		for _, otherGui in pairs(PlayerGui:GetChildren()) do
			if otherGui:IsA("ScreenGui") 
				and otherGui ~= gui 
				and otherGui ~= confirmationGui
				and otherGui.Name ~= "UI_NPC_Monk3yDAngelo-Cars"
				and otherGui.Enabled == true 
				and otherGui.Name ~= "Balance Indicator" then

				otherGui.Enabled = false
				table.insert(hiddenGuis, otherGui)
			end
		end
	else
		for _, otherGui in pairs(hiddenGuis) do
			if otherGui and otherGui.Parent then
				otherGui.Enabled = true
			end
		end
		hiddenGuis = {}
	end
end

local function setFocusMode(active)
	setBlur(active)
	toggleOtherGuis(active)
	toggleNamedGuiObjects(active, "FriendBoost")

	local char = player.Character
	if char and char:FindFirstChild("Humanoid") then
		char.Humanoid.WalkSpeed = active and 0 or 16
		char.Humanoid.JumpPower = active and 0 or 50
	end
end

local confirmConnections = {}

local function closeShopUI(forceDialogueClose)
	isShopOpen = false
	isProcessingPurchase = false
	activeCarFocus = nil

	-- Forcefully clean up any active confirmation dialog connections
	for _, conn in ipairs(confirmConnections) do
		if conn then conn:Disconnect() end
	end
	confirmConnections = {}

	local confirmationGui = resolveConfirmationUi()
	if confirmationGui then
		confirmationGui.Enabled = false
	end

	mainFrame.Visible = true
	gui.Enabled = false

	for _, carName in ipairs(SHOP_CARS) do
		local craftGui = gui:FindFirstChild(carName .. "Crafting")
		if craftGui then
			craftGui.Visible = false
		end
	end

	setFocusMode(false)

	if forceDialogueClose then
		forceCloseDialogue()
	end
end

local function FormatCommas(num)
	return tostring(num):reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", "")
end

local function escapeRichText(text)
	text = tostring(text)
	text = text:gsub("&", "&amp;")
	text = text:gsub("<", "&lt;")
	text = text:gsub(">", "&gt;")
	text = text:gsub("\"", "&quot;")
	return text
end

local CONFIRMATION_COLORS = {
	Sacrifice = "#ff5757",
	Target = "#63b3ff",
	Accent = "#f4efe6"
}

local function buildSacrificeConfirmationText(sacrificeText, targetCarName)
	local safeSacrifice = escapeRichText(sacrificeText)
	local safeTarget = escapeRichText(targetCarName)
	return string.format(
		"<font color='%s'>Do you want to sacrifice </font><b><font color='%s'>%s</font></b><font color='%s'> for </font><b><font color='%s'>%s</font></b><font color='%s'>?</font>",
		CONFIRMATION_COLORS.Accent,
		CONFIRMATION_COLORS.Sacrifice,
		safeSacrifice,
		CONFIRMATION_COLORS.Accent,
		CONFIRMATION_COLORS.Target,
		safeTarget,
		CONFIRMATION_COLORS.Accent
	)
end

local function buildCraftConfirmationText(targetCarName, hoursText)
	local safeTarget = escapeRichText(targetCarName)
	local safeHours = escapeRichText(hoursText)
	return string.format(
		"<font color='%s'>Begin forging </font><b><font color='%s'>%s</font></b><font color='%s'>? Once the ritual starts, it will take </font><b><font color='%s'>%s hours</font></b><font color='%s'> to complete.</font>",
		CONFIRMATION_COLORS.Accent,
		CONFIRMATION_COLORS.Target,
		safeTarget,
		CONFIRMATION_COLORS.Accent,
		CONFIRMATION_COLORS.Sacrifice,
		safeHours,
		CONFIRMATION_COLORS.Accent
	)
end

-- ============================================================================
-- 🧠 CONFIRMATION LOGIC
-- ============================================================================
local function PromptConfirmation(text, callback)
	local confirmGui, confirmMain = resolveConfirmationUi()
	if not confirmGui or not confirmMain then
		callback(true)
		return
	end

	for _, conn in ipairs(confirmConnections) do
		if conn then conn:Disconnect() end
	end
	confirmConnections = {}

	local infoLabel = confirmMain:FindFirstChild("Information", true)
	local btnYes = resolveGuiButton(confirmMain:FindFirstChild("Yes", true))
	local btnNo = resolveGuiButton(confirmMain:FindFirstChild("No", true))

	if infoLabel then
		infoLabel.RichText = true
		infoLabel.TextWrapped = true
		infoLabel.Text = text
	end

	confirmGui.Enabled = true
	if confirmMain:IsA("GuiObject") then
		confirmMain.Visible = true
	end

	local function closeConfirm()
		confirmGui.Enabled = false
		for _, conn in ipairs(confirmConnections) do
			if conn then conn:Disconnect() end
		end
		confirmConnections = {}
	end

	if btnYes then
		table.insert(confirmConnections, btnYes.MouseButton1Click:Connect(function()
			closeConfirm()
			callback(true)
		end))
	end

	if btnNo then
		table.insert(confirmConnections, btnNo.MouseButton1Click:Connect(function()
			closeConfirm()
			callback(false)
		end))
	end
end

-- ============================================================================
-- 🧠 RENDER LOGIC
-- ============================================================================
local function UpdateCraftingUI(carName)
	local craftingUIName = carName .. "Crafting"
	local craftGui = gui:FindFirstChild(craftingUIName)
	if not craftGui then return end

	local carFrame = craftGui:FindFirstChild(carName)
	if not carFrame then return end

	local sacrificeItems = carFrame:FindFirstChild("SacrificeItems")
	if not sacrificeItems then return end

	local recipe = RECIPES[carName]
	if not recipe then return end

	local progress = currentState.CraftProgress[carName] or {}
	local isCrafting = currentState.ActiveCrafts[carName] ~= nil

	local allComplete = true

	for ingredient, requiredAmount in pairs(recipe) do
		if ingredient == "TargetCar" then continue end

		local reqFrame = sacrificeItems:FindFirstChild(ingredient)
		if reqFrame then
			local details = reqFrame:FindFirstChild("Details")
			local infoLabel = details and details:FindFirstChild("Information")
			local sacBtn = reqFrame:FindFirstChild("SacrificeButton")
			local doneBtn = reqFrame:FindFirstChild("SacrificeDoneButton")

			if not doneBtn then
				for _, child in pairs(reqFrame.Parent:GetChildren()) do
					if child.Name == "SacrificeDoneButton" and child:GetAttribute("Ingredient") == ingredient then
						doneBtn = child
					end
				end
			end

			local currentAmount = progress[ingredient] or 0
			local isDone = currentAmount >= requiredAmount

			if infoLabel then
				if ingredient == "Cash" then
					infoLabel.Text = isDone and "Complete" or ("$" .. FormatCommas(currentAmount) .. " / $" .. FormatCommas(requiredAmount))
				else
					infoLabel.Text = isDone and "Complete" or (currentAmount .. " / " .. requiredAmount)
				end
			end

			if isDone then
				if sacBtn then sacBtn.Visible = false end
				if doneBtn then doneBtn.Visible = true end
			else
				if sacBtn then sacBtn.Visible = true end
				if doneBtn then doneBtn.Visible = false end
				allComplete = false
			end
		end
	end

	-- UPDATED: Explicitly target SacrificeItems > Confirmation > Craft
	local mainCraftBtn = nil
	local confirmFrame = sacrificeItems:FindFirstChild("Confirmation")
	if confirmFrame then
		mainCraftBtn = confirmFrame:FindFirstChild("Craft") or confirmFrame:FindFirstChild("CraftButton")
	end

	-- Fallback if not found inside Confirmation
	if not mainCraftBtn then
		mainCraftBtn = carFrame:FindFirstChild("CraftButton", true) or carFrame:FindFirstChild("Craft", true)
	end

	if mainCraftBtn then
		if isCrafting then
			mainCraftBtn.Visible = false
		else
			mainCraftBtn.Visible = allComplete
		end
	end
end

local function UpdateDisplay()
	if not currentState then return end

	local scrollFrame = mainFrame:FindFirstChild("ScrollingFrame")
	if scrollFrame then
		for _, carName in ipairs(SHOP_CARS) do
			local card = scrollFrame:FindFirstChild(carName)
			if card then
				local buttonsFrame = card:FindFirstChild("Buttons")
				local craftBtn = buttonsFrame and buttonsFrame:FindFirstChild("Craft")
			end
		end
	end

	if activeCarFocus then
		UpdateCraftingUI(activeCarFocus)
	end
end

-- ============================================================================
-- 🛒 SACRIFICE / CRAFT LOGIC
-- ============================================================================
local function AttemptSacrifice(carName, ingredient)
	if isProcessingPurchase then return end
	if not currentState or not currentState.CraftProgress then return end

	local recipe = RECIPES[carName]
	if not recipe then return end
	local requiredAmount = recipe[ingredient]
	local progress = currentState.CraftProgress[carName] or {}
	local currentAmount = progress[ingredient] or 0

	if currentAmount >= requiredAmount then 
		updateDialogue("AlreadyDone")
		return 
	end

	local amountToSacrifice = 1
	local sacrificeText = ""
	local displayCarName = recipe.TargetCar or carName
	if ingredient == "Cash" then
		amountToSacrifice = requiredAmount - currentAmount
		sacrificeText = "$" .. FormatCommas(amountToSacrifice)
	else
		sacrificeText = amountToSacrifice .. " " .. ingredient
	end

	updateDialogue("ConfirmSacrifice")

	PromptConfirmation(buildSacrificeConfirmationText(sacrificeText, displayCarName), function(confirmed)
		if not confirmed then 
			updateDialogue("CancelSacrifice")
			return 
		end

		if isProcessingPurchase then return end
		isProcessingPurchase = true

		Kit.Sound:Play("Click")

		task.spawn(function()
			local success, msg = FuncSacrifice:InvokeServer(carName, ingredient)
			isProcessingPurchase = false

			if success then
				Kit.Sound:Play("BuySuccess")
				showFeedback("Sacrifice Successful", FEEDBACK_COLORS.Success)
				updateDialogue("SacrificeSuccess")
			else
				Kit.Sound:Play("BuyFail")
				showFeedback(msg, FEEDBACK_COLORS.FailCash)
				if msg == "Insufficient Cash (Withdraw from ATM)" or msg == "You don't own the required car (" .. ingredient .. ")!" then
					updateDialogue("NotEnough")
				end
			end

			currentState = FuncGetState:InvokeServer()
			UpdateDisplay()

			local allComplete = true
			for ing, req in pairs(recipe) do
				if ing ~= "TargetCar" and ing ~= "CraftTime" then
					local p = currentState.CraftProgress[carName] and currentState.CraftProgress[carName][ing] or 0
					if p < req then allComplete = false break end
				end
			end
			if allComplete and success then
				updateDialogue("AllComplete")
			end
		end)
	end)
end

local function AttemptCraft(carName)
	if isProcessingPurchase then return end

	if currentState.CompletedCrafts[carName] then
		updateDialogue("AlreadyCrafted")
		return
	end

	local recipe = RECIPES[carName]
	local displayCarName = recipe and recipe.TargetCar or carName
	local craftHours = (carName == "Yamura" and "12" or "48")

	PromptConfirmation(buildCraftConfirmationText(displayCarName, craftHours), function(confirmed)
		if not confirmed then return end

		if isProcessingPurchase then return end
		isProcessingPurchase = true

		Kit.Sound:Play("Click")

		task.spawn(function()
			local success, msg = FuncCraftCar:InvokeServer(carName)
			isProcessingPurchase = false

			if success then
				Kit.Sound:Play("BuySuccess")
				showFeedback("Crafting Started!", FEEDBACK_COLORS.Success)
				updateDialogue("CraftStarted")
			else
				Kit.Sound:Play("BuyFail")
				showFeedback(msg, FEEDBACK_COLORS.FailCash)
			end

			currentState = FuncGetState:InvokeServer()
			UpdateDisplay()
		end)
	end)
end

local function OpenCraftingMenu(carName)
	activeCarFocus = carName
	mainFrame.Visible = false

	local craftingUIName = carName .. "Crafting"
	local craftGui = gui:FindFirstChild(craftingUIName)

	updateDialogue("SelectCar", carName)

	if craftGui then
		craftGui.Visible = true
		UpdateCraftingUI(carName)

		local carFrame = craftGui:FindFirstChild(carName)
		if carFrame then
			local exitBtn = carFrame:FindFirstChild("ExitButton") or carFrame:FindFirstChild("CloseButton")
			if exitBtn then
				if not exitBtn:GetAttribute("Connected") then
					exitBtn:SetAttribute("Connected", true)

					Kit.Tween:SetupButton(exitBtn, function()
						activeCarFocus = nil
						craftGui.Visible = false
						mainFrame.Visible = true

						-- Cleanup confirmation if player backs out of a car's specific menu
						for _, conn in ipairs(confirmConnections) do
							if conn then conn:Disconnect() end
						end
						confirmConnections = {}
						local confirmationGui = resolveConfirmationUi()
						if confirmationGui then
							confirmationGui.Enabled = false
						end

						updateDialogue("MenuOpen")
					end)
				end
			end

			local sacrificeItems = carFrame:FindFirstChild("SacrificeItems")

			-- UPDATED: Explicitly target SacrificeItems > Confirmation > Craft
			local mainCraftBtn = nil
			if sacrificeItems then
				local confirmFrame = sacrificeItems:FindFirstChild("Confirmation")
				if confirmFrame then
					mainCraftBtn = confirmFrame:FindFirstChild("Craft") or confirmFrame:FindFirstChild("CraftButton")
				end
			end

			-- Fallback if not found inside Confirmation
			if not mainCraftBtn then
				mainCraftBtn = carFrame:FindFirstChild("CraftButton", true) or carFrame:FindFirstChild("Craft", true)
			end

			if mainCraftBtn then
				if not mainCraftBtn:GetAttribute("Connected") then
					mainCraftBtn:SetAttribute("Connected", true)
					Kit.Tween:SetupButton(mainCraftBtn, function()
						if mainCraftBtn.Visible and mainCraftBtn.Active then AttemptCraft(carName) end
					end)
				end
			end

			if sacrificeItems then
				for ingredient, _ in pairs(RECIPES[carName]) do
					if ingredient == "TargetCar" then continue end
					local reqFrame = sacrificeItems:FindFirstChild(ingredient)
					if reqFrame then
						local sacBtn = reqFrame:FindFirstChild("SacrificeButton")
						if sacBtn then
							if not sacBtn:GetAttribute("Connected") then
								sacBtn:SetAttribute("Connected", true)
								Kit.Tween:SetupButton(sacBtn, function()
									if sacBtn.Visible and sacBtn.Active then AttemptSacrifice(carName, ingredient) end
								end)
							end
						end
					end
				end
			end
		end
	else
		warn("⚠️ Crafting UI not found for " .. carName)
	end
end

-- ============================================================================
-- 🚀 INIT & EVENTS
-- ============================================================================
local function init()
	local gui, mainFrame, scrollFrame, closeBtn = getUI()

	gui.Enabled = false 

	Kit.Tween:SetupButton(closeBtn, function() 
		closeShopUI(true)
	end)

	if scrollFrame then
		for _, carName in ipairs(SHOP_CARS) do
			local card = scrollFrame:WaitForChild(carName, 5)
			if card then
				local buttonsFrame = card:FindFirstChild("Buttons")
				local craftBtn = buttonsFrame and buttonsFrame:FindFirstChild("Craft")

				if craftBtn then
					Kit.Tween:SetupButton(craftBtn, function()
						OpenCraftingMenu(carName)
					end)
				end
			end
		end
	end

	RemoteOpen.OnClientEvent:Connect(function()
		if isShopOpen or gui.Enabled then
			return
		end

		isShopOpen = true
		setFocusMode(true) 
		Kit.Sound:Play("Open")
		gui.Enabled = true 
		mainFrame.Visible = true
		activeCarFocus = nil

		for _, carName in ipairs(SHOP_CARS) do
			local craftGui = gui:FindFirstChild(carName .. "Crafting")
			if craftGui then craftGui.Visible = false end
		end

		currentState = {CraftProgress = {}, ActiveCrafts = {}, CompletedCrafts = {}}
		UpdateDisplay()

		local realState = FuncGetState:InvokeServer()
		currentState = realState
		UpdateDisplay()
	end)

	RemoteUpdate.OnClientEvent:Connect(function(newState)
		if newState.Reason == "Complete" then
			updateDialogue("CraftComplete")
		end
		currentState = newState
		UpdateDisplay()
	end)
end

player.CharacterAdded:Connect(function()
	closeShopUI(true)
end)

if player.Character then init() else player.CharacterAdded:Wait(); init() end
