-- ============================================================================
-- 🖥️ CRAFTING UI RENDER
-- ============================================================================
local function UpdateCraftingUI(carName)
	local craftGui = gui:FindFirstChild(carName.."Crafting")
	if not craftGui then return end
	local carFrame = craftGui:FindFirstChild(carName)
	if not carFrame then return end
	local sacrificeItems = carFrame:FindFirstChild("SacrificeItems")
	if not sacrificeItems then return end
	local recipe = RECIPES[carName]
	if not recipe then return end

	local progress    = currentState.CraftProgress[carName] or {}
	local isCrafting  = currentState.ActiveCrafts[carName] ~= nil
	local allComplete = true

	for ingredient, requiredAmount in pairs(recipe) do
		if ingredient == "TargetCar" then continue end
		local reqFrame = sacrificeItems:FindFirstChild(ingredient)
		if reqFrame then
			local details    = reqFrame:FindFirstChild("Details")
			local infoLabel  = details and details:FindFirstChild("Information")
			local sacBtn     = reqFrame:FindFirstChild("SacrificeButton")
			local doneBtn    = reqFrame:FindFirstChild("SacrificeDoneButton")
			if not doneBtn then
				for _, child in pairs(reqFrame.Parent:GetChildren()) do
					if child.Name == "SacrificeDoneButton" and child:GetAttribute("Ingredient") == ingredient then
						doneBtn = child
					end
				end
			end
			local current = progress[ingredient] or 0
			local isDone  = current >= requiredAmount
			if infoLabel then
				infoLabel.RichText = true
				if ingredient == "Cash" then
					infoLabel.Text = isDone
						and ("<font color='#50C878'>$"..FormatCommas(requiredAmount).." / $"..FormatCommas(requiredAmount).."</font>")
						or  ("$"..FormatCommas(current).." / $"..FormatCommas(requiredAmount))
				else
					infoLabel.Text = isDone
						and ("<font color='#50C878'>"..requiredAmount.." / "..requiredAmount.."</font>")
						or  (current.." / "..requiredAmount)
				end
			end
			if isDone then
				if sacBtn  then sacBtn.Visible  = false end
				if doneBtn then doneBtn.Visible = true  end
			else
				if sacBtn  then sacBtn.Visible  = true  end
				if doneBtn then doneBtn.Visible = false end
				allComplete = false
			end
		end
	end

	local mainCraftBtn
	local confirmFrame = sacrificeItems:FindFirstChild("Confirmation")
	if confirmFrame then
		mainCraftBtn = confirmFrame:FindFirstChild("Craft") or confirmFrame:FindFirstChild("CraftButton")
	end
	if not mainCraftBtn then
		mainCraftBtn = carFrame:FindFirstChild("CraftButton", true) or carFrame:FindFirstChild("Craft", true)
	end
	if mainCraftBtn then
		-- Always visible: crafting = show timer msg, complete = show craft btn
		mainCraftBtn.Visible = isCrafting and true or allComplete
	end
end

local function UpdateDisplay()
	if not currentState then return end
	if activeCarFocus then UpdateCraftingUI(activeCarFocus) end
end

-- ============================================================================
-- 🛒 SACRIFICE
-- ============================================================================
local function AttemptSacrifice(carName, ingredient)
	if isProcessingPurchase then return end
	if not currentState or not currentState.CraftProgress then return end
	if not isShopOpen or activeCarFocus ~= carName then return end

	local recipe = RECIPES[carName]
	if not recipe then return end

	local requiredAmount = recipe[ingredient]
	local progress       = currentState.CraftProgress[carName] or {}
	local currentAmount  = progress[ingredient] or 0
	local displayName    = getDisplayCarName(carName)
	local coloredName    = "<font color='"..USER_COLOR.."'>@"..player.Name.."</font>"

	-- Already satisfied
	if currentAmount >= requiredAmount then
		angeloSpeak(pickRandom({
			"We already have enough of that.",
			"That requirement is already fulfilled.",
			"Save it. We don't need any more of those."
		}))
		return
	end

	-- ── No item: skip confirmation, Angelo speaks immediately ─────────────
	if not playerHasIngredient(ingredient, requiredAmount, currentAmount) then
		local itemLabel = ingredient == "Cash"
			and ("$"..FormatCommas(requiredAmount - currentAmount).." cash")
			or ingredient
		angeloSpeak(pickRandom({
			"Don't waste my time. You don't have the <font color='#00E5FF'>"..itemLabel.."</font> in your garage.",
			"Dude, you dont even have the <font color='#00E5FF'>"..itemLabel.."</font>. Come back when you actually have it.",
			"You are short on resources. I need the <font color='#00E5FF'>"..itemLabel.."</font> to proceed.",
			"I don't work for free. Bring me the <font color='#00E5FF'>"..itemLabel.."</font> first."
		}))
		return
	end

	-- ── Has item: confirm then sacrifice ─────────────────────────────────
	local sacrificeText = ingredient == "Cash"
		and ("$"..FormatCommas(requiredAmount - currentAmount))
		or  ("1 "..ingredient)

	local CONF_COLORS = {Sacrifice="#ff5757", Target="#63b3ff", Accent="#f4efe6"}
	local confirmText = string.format(
		"<font color='%s'>Do you want to sacrifice </font><b><font color='%s'>%s</font></b><font color='%s'> for </font><b><font color='%s'>%s</font></b><font color='%s'>?</font>",
		CONF_COLORS.Accent, CONF_COLORS.Sacrifice, escapeRichText(sacrificeText),
		CONF_COLORS.Accent, CONF_COLORS.Target, escapeRichText(displayName), CONF_COLORS.Accent
	)

	local requestSessionId   = shopSessionId
	local requestViewVersion = shopViewVersion

	PromptConfirmation(requestSessionId, confirmText, function(confirmed)
		if not confirmed then return end
		if not isActiveShopSession(requestSessionId) or requestViewVersion ~= shopViewVersion then return end
		if isProcessingPurchase then return end
		isProcessingPurchase = true

		Kit.Sound:Play("Click")

		task.spawn(function()
			local success, msg = FuncSacrifice:InvokeServer(carName, ingredient)
			if requestSessionId == shopSessionId then isProcessingPurchase = false end
			if not isActiveShopSession(requestSessionId) then mainFrame.Visible = true; return end

			currentState = FuncGetState:InvokeServer()
			UpdateDisplay()

			-- Recalculate remaining
			local allComplete = true
			local itemsLeft   = 0
			for ing, req in pairs(recipe) do
				if ing ~= "TargetCar" and ing ~= "CraftTime" then
					local p = (currentState.CraftProgress[carName] and currentState.CraftProgress[carName][ing]) or 0
					if p < req then
						allComplete = false
						itemsLeft   = itemsLeft + (req - p)
					end
				end
			end

			if success then
				Kit.Sound:Play("BuySuccess")
				showFeedback("Sacrifice Successful", FEEDBACK_COLORS.Success)
				if requestViewVersion == shopViewVersion and activeCarFocus == carName then
					if allComplete then
						-- After Angelo speaks, show crafting frame (not mainFrame)
						local craftGui = gui:FindFirstChild(carName.."Crafting")
						angeloSpeak(pickRandom({
							"That was the last one! The <font color='#50C878'>sacrifices are complete</font>. Ready to go?",
							"Every piece is finally in place. Click confirm, and I will begin the build.",
							"We have everything we need. Nice.",
							"All requirements met. The <font color='#00E5FF'>"..displayName.."</font> is ready to be born. Tell me when to start crafting... when you're ready."
						}), function()
							if activeCarFocus == carName and isShopOpen and craftGui then
								craftGui.Visible  = true
								mainFrame.Visible = false
							else
								mainFrame.Visible = true
							end
						end)
					else
						local craftGui = gui:FindFirstChild(carName.."Crafting")
						angeloSpeak(pickRandom({
							"The <font color='#00E5FF'>"..ingredient.."</font> has been stripped for parts. You still have <font color='#FFD700'>"..itemsLeft.."</font> more sacrifices to go.",
							"Sacrifice accepted. Bring me <font color='#FFD700'>"..itemsLeft.."</font> more requirements and we can begin.",
							"Alright "..coloredName.." thanks for the <font color='#00E5FF'>"..ingredient.."</font>. We are getting closer, just <font color='#FFD700'>"..itemsLeft.."</font> more to go.",
							"Good. The chassis grows stronger. <font color='#FFD700'>"..itemsLeft.."</font> more pieces needed.",
							"Another piece of the puzzle. Just <font color='#FFD700'>"..itemsLeft.."</font> more to go before the forge is ready."
						}), function()
							if activeCarFocus == carName and isShopOpen and craftGui then
								craftGui.Visible  = true
								mainFrame.Visible = false
							else
								mainFrame.Visible = true
							end
						end)
					end
				else
					mainFrame.Visible = true
				end
			else
				Kit.Sound:Play("BuyFail")
				showFeedback(msg, FEEDBACK_COLORS.FailCash)
				-- Server rejected (shouldn't normally happen after client check)
				-- but handle gracefully: show crafting frame again
				local craftGui = gui:FindFirstChild(carName.."Crafting")
				if craftGui and activeCarFocus == carName and isShopOpen then
					craftGui.Visible  = true
					mainFrame.Visible = false
				else
					mainFrame.Visible = true
				end
			end
		end)
	end)
end

-- ============================================================================
-- 🔨 CRAFT
-- ============================================================================
local function AttemptCraft(carName)
	if isProcessingPurchase then return end
	if not isShopOpen or activeCarFocus ~= carName then return end
	if not currentState or not currentState.CompletedCrafts then return end

	local recipe      = RECIPES[carName]
	local displayName = getDisplayCarName(carName)
	local coloredName = "<font color='"..USER_COLOR.."'>@"..player.Name.."</font>"
	local craftGui    = gui:FindFirstChild(carName.."Crafting")

	local function restoreCraftingFrame()
		if activeCarFocus == carName and isShopOpen and craftGui then
			craftGui.Visible  = true
			mainFrame.Visible = false
		else
			mainFrame.Visible = true
		end
	end

	-- Already crafting
	if currentState.ActiveCrafts and currentState.ActiveCrafts[carName] then
		local delta   = math.max(0, currentState.ActiveCrafts[carName] - os.time())
		local timeStr = string.format("%02d:%02d:%02d",
			math.floor(delta/3600), math.floor((delta%3600)/60), math.floor(delta%60))
		angeloSpeak(pickRandom({
			"Patience. you cant make another one dude. im already making the <font color='#B652FF'>"..displayName.."</font> right now. It will be ready in <font color='#FF4C4C'>"..timeStr.."</font>.",
			"i am making a car for you at this moment "..coloredName.." i am making <font color='#B652FF'>"..displayName.."</font>. Check back in <font color='#FF4C4C'>"..timeStr.."</font>.",
			"You cant rush perfection "..coloredName.." The <font color='#B652FF'>"..displayName.."</font> needs <font color='#FF4C4C'>"..timeStr.."</font> more time, come back later alright?",
			"I am working as fast as I can. Come back in <font color='#FF4C4C'>"..timeStr.."</font>.",
			"The metal is still hot. You must wait exactly <font color='#FF4C4C'>"..timeStr.."</font> before the build is complete."
		}), restoreCraftingFrame)
		return
	end

	-- Already completed
	if currentState.CompletedCrafts[carName] then
		angeloSpeak(pickRandom({
			"It is finished. The <font color='#B652FF'>"..displayName.."</font> is a true work of art. It should be in your inventory already.",
			"The <font color='#B652FF'>"..displayName.."</font> is already there in your inventory, "..coloredName..".",
			"Construction of the <font color='#B652FF'>"..displayName.."</font> is done. A flawless execution. It's already there in your inventory."
		}), restoreCraftingFrame)
		return
	end

	-- Start craft
	local craftHours = (carName == "Yamura" and "12" or "48")
	local CONF_COLORS = {Sacrifice="#ff5757", Target="#63b3ff", Accent="#f4efe6"}
	local confirmText = string.format(
		"<font color='%s'>Begin forging </font><b><font color='%s'>%s</font></b><font color='%s'>? Once the ritual starts, it will take </font><b><font color='%s'>%s hours</font></b><font color='%s'> to complete.</font>",
		CONF_COLORS.Accent, CONF_COLORS.Target, escapeRichText(displayName),
		CONF_COLORS.Accent, CONF_COLORS.Sacrifice, escapeRichText(craftHours), CONF_COLORS.Accent
	)

	local requestSessionId   = shopSessionId
	local requestViewVersion = shopViewVersion

	PromptConfirmation(requestSessionId, confirmText, function(confirmed)
		if not confirmed then return end
		if not isActiveShopSession(requestSessionId) or requestViewVersion ~= shopViewVersion then return end
		if isProcessingPurchase then return end
		isProcessingPurchase = true

		Kit.Sound:Play("Click")

		task.spawn(function()
			local success, msg = FuncCraftCar:InvokeServer(carName)
			if requestSessionId == shopSessionId then isProcessingPurchase = false end
			if not isActiveShopSession(requestSessionId) then mainFrame.Visible = true; return end

			currentState = FuncGetState:InvokeServer()
			UpdateDisplay()

			if success then
				Kit.Sound:Play("BuySuccess")
				showFeedback("Crafting Started!", FEEDBACK_COLORS.Success)
				if requestViewVersion == shopViewVersion and activeCarFocus == carName then
					local timeStr = "..."
					if currentState.ActiveCrafts and currentState.ActiveCrafts[carName] then
						local delta = math.max(0, currentState.ActiveCrafts[carName] - os.time())
						timeStr = string.format("%02d:%02d:%02d",
							math.floor(delta/3600), math.floor((delta%3600)/60), math.floor(delta%60))
					end
					-- After Angelo speaks craft started, show crafting frame again
					angeloSpeak(pickRandom({
						"Alright im working on making your <font color='#B652FF'>"..displayName.."</font>, be back in <font color='#FF4C4C'>"..timeStr.."</font>.",
						"Crafting underway homie. The <font color='#B652FF'>"..displayName.."</font> will be ready in <font color='#FF4C4C'>"..timeStr.."</font>."
					}), restoreCraftingFrame)
				else
					mainFrame.Visible = true
				end
			else
				Kit.Sound:Play("BuyFail")
				showFeedback(msg, FEEDBACK_COLORS.FailCash)
				restoreCraftingFrame()
			end
		end)
	end)
end

-- ============================================================================
-- 🏠 MENU NAVIGATION
-- ============================================================================
local function showMainMenu()
	if not isShopOpen then return end
	shopViewVersion      += 1
	isProcessingPurchase  = false
	activeCarFocus        = nil
	dismissConfirmation()
	hideAllCraftingMenus()
	mainFrame.Visible = true
	UpdateDisplay()
end

local function OpenCraftingMenu(carName)
	if not isShopOpen then return end
	shopViewVersion      += 1
	isProcessingPurchase  = false
	activeCarFocus        = carName

	local craftGui = gui:FindFirstChild(carName.."Crafting")
	dismissConfirmation()
	hideAllCraftingMenus()
	mainFrame.Visible = false

	-- Wire up buttons (no UI changes yet, Angelo speaks first)
	if craftGui then
		UpdateCraftingUI(carName)
		local carFrame = craftGui:FindFirstChild(carName)
		if carFrame then
			local exitBtn = carFrame:FindFirstChild("ExitButton") or carFrame:FindFirstChild("CloseButton")
			if exitBtn and not exitBtn:GetAttribute("Connected") then
				exitBtn:SetAttribute("Connected", true)
				Kit.Tween:SetupButton(exitBtn, function()
					if activeCarFocus == carName and isShopOpen then showMainMenu() end
				end)
			end

			local sacrificeItems = carFrame:FindFirstChild("SacrificeItems")
			local mainCraftBtn
			if sacrificeItems then
				local cf = sacrificeItems:FindFirstChild("Confirmation")
				if cf then mainCraftBtn = cf:FindFirstChild("Craft") or cf:FindFirstChild("CraftButton") end
			end
			if not mainCraftBtn then
				mainCraftBtn = carFrame:FindFirstChild("CraftButton", true) or carFrame:FindFirstChild("Craft", true)
			end
			if mainCraftBtn and not mainCraftBtn:GetAttribute("Connected") then
				mainCraftBtn:SetAttribute("Connected", true)
				Kit.Tween:SetupButton(mainCraftBtn, function()
					if mainCraftBtn.Visible and mainCraftBtn.Active and activeCarFocus == carName and isShopOpen then
						AttemptCraft(carName)
					end
				end)
			end

			if sacrificeItems then
				for ingredient, _ in pairs(RECIPES[carName]) do
					if ingredient == "TargetCar" then continue end
					local reqFrame = sacrificeItems:FindFirstChild(ingredient)
					if reqFrame then
						local sacBtn = reqFrame:FindFirstChild("SacrificeButton")
						if sacBtn and not sacBtn:GetAttribute("Connected") then
							sacBtn:SetAttribute("Connected", true)
							Kit.Tween:SetupButton(sacBtn, function()
								if sacBtn.Visible and sacBtn.Active and activeCarFocus == carName and isShopOpen then
									AttemptSacrifice(carName, ingredient)
								end
							end)
						end
					end
				end
			end
		end
	end

	-- Angelo speaks the car selection, then crafting menu appears
	local displayName = getDisplayCarName(carName)
	angeloSpeak(pickRandom({
		"Ah, the <font color='#00E5FF'>"..displayName.."</font>. A beautiful choice.",
		"The <font color='#00E5FF'>"..displayName.."</font>? You have good taste.",
		"Excellent selection. Let's look at what is required."
	}), function()
		-- After Angelo finishes, show the crafting frame
		if activeCarFocus == carName and isShopOpen and craftGui then
			craftGui.Visible  = true
			mainFrame.Visible = false
		else
			mainFrame.Visible = true
		end
	end)
end

-- ============================================================================
-- 🚀 INIT & EVENTS
-- ============================================================================
local function init()
	local _gui, _mainFrame, scrollFrame, closeBtn = gui, mainFrame,
	mainFrame:WaitForChild("ScrollingFrame"), mainFrame:WaitForChild("ExitButton")
	gui.Enabled = false

	Kit.Tween:SetupButton(closeBtn, function()
		closeShopUI(true)
	end)

	if scrollFrame then
		for _, carName in ipairs(SHOP_CARS) do
			local card = scrollFrame:WaitForChild(carName, 5)
			if card then
				local buttonsFrame = card:FindFirstChild("Buttons")
				local craftBtn = buttonsFrame and buttonsFrame:FindFirstChild("Craft")
				if craftBtn then
					Kit.Tween:SetupButton(craftBtn, function()
						OpenCraftingMenu(carName)
					end)
				end
			end
		end
	end

	RemoteOpen.OnClientEvent:Connect(function()
		if isShopOpen or gui.Enabled then return end
		local sessionId      = beginShopSession()
		isShopOpen           = true
		setFocusMode(true)
		Kit.Sound:Play("Open")
		gui.Enabled          = true
		mainFrame.Visible    = true
		activeCarFocus       = nil
		isProcessingPurchase = false
		confirmationRestoreState = nil
		hideAllCraftingMenus()
		currentState = {CraftProgress={}, ActiveCrafts={}, CompletedCrafts={}}
		UpdateDisplay()
		local realState = FuncGetState:InvokeServer()
		if not isActiveShopSession(sessionId) then return end
		currentState = realState
		UpdateDisplay()
	end)

	RemoteUpdate.OnClientEvent:Connect(function(newState)
		if newState.Reason == "Complete" then
			local coloredName = "<font color='"..USER_COLOR.."'>@"..player.Name.."</font>"
			local carName
			if currentState and currentState.CompletedCrafts and newState.CompletedCrafts then
				for n, _ in pairs(newState.CompletedCrafts) do
					if not currentState.CompletedCrafts[n] then carName = n; break end
				end
			end
			local dName = carName and getDisplayCarName(carName) or "your car"
			angeloSpeak(pickRandom({
				"It is finished. The <font color='#B652FF'>"..dName.."</font> is a true work of art. It should be in your inventory already.",
				"The <font color='#B652FF'>"..dName.."</font> is already there in your inventory, "..coloredName..".",
				"Construction of the <font color='#B652FF'>"..dName.."</font> is done. A flawless execution. It's already there in your inventory."
			}))
		end
		currentState = newState
		UpdateDisplay()
	end)
end

player.CharacterAdded:Connect(function()
	closeShopUI(true)
end)

if player.Character then
	init()
else
	player.CharacterAdded:Wait()
	init()
end
