-- ============================================================================
local function UpdateCraftingUI(carName)
	local craftGui = gui:FindFirstChild(carName .. "Crafting")
	if not craftGui then return end
	local carFrame = craftGui:FindFirstChild(carName)
	if not carFrame then return end
	local sacrificeItems = carFrame:FindFirstChild("SacrificeItems")
	if not sacrificeItems then return end
	local recipe = RECIPES[carName]
	if not recipe then return end

	local progress = currentState.CraftProgress[carName] or {}

	for ingredient, requiredAmount in pairs(recipe) do
		if ingredient == "TargetCar" or ingredient == "CraftTime" then continue end
		local reqFrame = sacrificeItems:FindFirstChild(ingredient)
		if reqFrame then
			local details   = reqFrame:FindFirstChild("Details")
			local infoLabel = details and details:FindFirstChild("Information")
			local sacBtn    = reqFrame:FindFirstChild("SacrificeButton")
			local doneBtn   = reqFrame:FindFirstChild("SacrificeDoneButton")
			if not doneBtn then
				for _, child in pairs(reqFrame.Parent:GetChildren()) do
					if child.Name == "SacrificeDoneButton"
						and child:GetAttribute("Ingredient") == ingredient then
						doneBtn = child
					end
				end
			end
			local current = progress[ingredient] or 0
			local isDone  = current >= requiredAmount
			if infoLabel then
				infoLabel.RichText = true
				if ingredient == "Cash" then
					infoLabel.Text = isDone
						and ("<font color='#50C878'>Sacrificed " .. FormatAbbreviated(requiredAmount) .. " / " .. FormatAbbreviated(requiredAmount) .. "</font>")
						or  ("Sacrificed " .. FormatAbbreviated(current) .. " / " .. FormatAbbreviated(requiredAmount))
				else
					local remaining = requiredAmount - current
					infoLabel.Text = isDone
						and ("<font color='#50C878'>Sacrifice complete</font>")
						or  ("Sacrifice " .. remaining .. " more to continue")
				end
			end
			if isDone then
				if sacBtn  then sacBtn.Visible  = false end
				if doneBtn then doneBtn.Visible = true  end
			else
				if sacBtn  then sacBtn.Visible  = true  end
				if doneBtn then doneBtn.Visible = false end
			end
		end
	end

	local mainCraftBtn
	local confirmFrame = sacrificeItems:FindFirstChild("Confirmation")
	if confirmFrame then
		mainCraftBtn = confirmFrame:FindFirstChild("Craft") or confirmFrame:FindFirstChild("CraftButton")
	end
	if not mainCraftBtn then
		mainCraftBtn = carFrame:FindFirstChild("CraftButton", true) or carFrame:FindFirstChild("Craft", true)
	end
	if mainCraftBtn then
		mainCraftBtn.Visible = true
	end
end

local function promptPreparedCraftSkip(carName)
	if typeof(carName) ~= "string" or carName == "" then return false end
	if isProcessingPurchase then return false end

	isProcessingPurchase = true
	local invokeOk, success, msg = pcall(function()
		return FuncRequestSkip:InvokeServer(carName)
	end)
	isProcessingPurchase = false

	if invokeOk and success then
		UIAudioConfig.PlayRobux()
		UIAudioConfig.ShowPurchaseLoading()
		MarketplaceService:PromptProductPurchase(player, LEGENDARY_SKIP_PRODUCT_ID)
		return true
	end

	local message = invokeOk and tostring(msg or "Skip unavailable") or "Skip unavailable"
	showFeedback(message, FEEDBACK_COLORS.FailRobux)
	warn("⚠️ [LegendaryShop] Premium skip prompt blocked: " .. message)
	return false
end

-- ============================================================================
-- 📊  ACTIVE CRAFT PANEL
--
-- UpdateActiveCraftPanel — refreshes timer text and wires buttons.
--   Does NOT set panel.Visible = true. Hides the panel only when there is no
--   active craft (so a completed craft automatically clears the panel).
--
-- ShowActiveCraftPanel — the ONLY function that shows the panel.
--   Called explicitly: on shop open (if craft in progress) and after the
--   "already crafting" NPC dialogue completes.
-- ============================================================================
local function UpdateActiveCraftPanel()
	local panel = gui:FindFirstChild("ActiveCraftPanel")
	if not panel then return end

	local activeCar, endTime = nil, nil
	if currentState and currentState.ActiveCrafts then
		for c, e in pairs(currentState.ActiveCrafts) do
			activeCar, endTime = c, e
			break
		end
	end

	if activeCar and endTime then
		local delta = math.max(0, endTime - os.time())
		local h = math.floor(delta / 3600)
		local m = math.floor((delta % 3600) / 60)
		local s = math.floor(delta % 60)

		-- Only update label content when the panel is already visible.
		-- Visibility is owned by ShowActiveCraftPanel(); we never set it true here.
		if panel.Visible then
			local nameLabel = panel:FindFirstChild("CarNameLabel")
			if nameLabel then nameLabel.Text = getDisplayCarName(activeCar) end

			local label = panel:FindFirstChild("TimeRemainingLabel")
			if label then label.Text = string.format("%02d:%02d:%02d", h, m, s) end
		end

		-- Wire the Skip button (once).
		local skipBtn = panel:FindFirstChild("SkipButton")
		if skipBtn and not skipBtn:GetAttribute("Connected") then
			skipBtn:SetAttribute("Connected", true)
			Kit.Tween:SetupButton(skipBtn, function()
				if skipBtn.Visible and skipBtn.Active and isShopOpen then
					local latestActiveCar = nil
					if currentState and currentState.ActiveCrafts then
						for c in pairs(currentState.ActiveCrafts) do
							latestActiveCar = c
							break
						end
					end
					if latestActiveCar then
						promptPreparedCraftSkip(latestActiveCar)
					end
				end
			end)
		end

		-- Wire the Exit button (once).
		-- FIX: Closes the Active Craft frame and returns to the main shop menu
		-- cleanly instead of closing the entire shop.
		local exitBtn = panel:FindFirstChild("ExitButton", true) or panel:FindFirstChild("CloseButton", true)
		if exitBtn and not exitBtn:GetAttribute("Connected") then
			exitBtn:SetAttribute("Connected", true)
			Kit.Tween:SetupButton(exitBtn, function()
				if isShopOpen then
					panel.Visible        = false
					shopViewVersion     += 1
					isProcessingPurchase = false
					activeCarFocus       = nil
					dismissConfirmation()
					hideAllCraftingMenus()
					mainFrame.Visible    = true
				end
			end)
		end
	else
		-- No active craft — always hide the panel.
		panel.Visible = false
	end
end

-- FIX: Sole gatekeeper for showing the Active Craft panel.
local function ShowActiveCraftPanel()
	local panel = gui:FindFirstChild("ActiveCraftPanel")
	if not panel then return end
	if currentState and currentState.ActiveCrafts and next(currentState.ActiveCrafts) then
		panel.Visible = true
		UpdateActiveCraftPanel()
	end
end

local function UpdateDisplay()
	if not currentState then return end
	if activeCarFocus then UpdateCraftingUI(activeCarFocus) end
	UpdateActiveCraftPanel()   -- refresh timer / hide if needed; does NOT auto-show
end

