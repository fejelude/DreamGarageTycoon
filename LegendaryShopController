local function showMainMenu()
	if not isShopOpen then return end
	shopViewVersion      += 1
	isProcessingPurchase  = false
	activeCarFocus        = nil
	dismissConfirmation()
	hideAllCraftingMenus()
	mainFrame.Visible = true
	UpdateDisplay()
end

local function OpenCraftingMenu(carName)
	if not isShopOpen then return end
	shopViewVersion      += 1
	isProcessingPurchase  = false
	activeCarFocus        = carName

	-- ALREADY CRAFTING INTERCEPT
	if currentState and currentState.ActiveCrafts and next(currentState.ActiveCrafts) then
		local activeCar, endTime
		for c, e in pairs(currentState.ActiveCrafts) do
			activeCar, endTime = c, e
			break
		end

		local displayName = getDisplayCarName(activeCar)
		local coloredName = "<font color='" .. USER_COLOR .. "'>@" .. player.Name .. "</font>"
		local delta   = math.max(0, endTime - os.time())
		local timeStr = string.format("%02d:%02d:%02d", math.floor(delta / 3600), math.floor((delta % 3600) / 60), math.floor(delta % 60))

		angeloSpeak(pickRandom({
			"Patience. you cant make another one dude. im already making the <font color='#B652FF'>" .. displayName .. "</font> right now. It will be ready in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"i am making a car for you at this moment " .. coloredName .. " i am making <font color='#B652FF'>" .. displayName .. "</font>. Check back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"You cant rush perfection " .. coloredName .. " The <font color='#B652FF'>" .. displayName .. "</font> needs <font color='#FF4C4C'>" .. timeStr .. "</font> more time, come back later alright?",
			"I am working as fast as I can. Come back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"The metal is still hot. You must wait exactly <font color='#FF4C4C'>" .. timeStr .. "</font> before the build is complete.",
		}), function()
			-- FIX: Standardized 1.5s wait, then show Active Craft panel.
			-- ShowActiveCraftPanel hides mainFrame/crafting menus internally.
			task.wait(1.5)
			ShowActiveCraftPanel()
		end)
		return
	end

	-- ALREADY COMPLETED INTERCEPT
	-- Acknowledges the craft so ingredients can be reset for another build.
	if currentState and currentState.CompletedCrafts and currentState.CompletedCrafts[carName] then
		local displayName = getDisplayCarName(carName)
		local coloredName = "<font color='" .. USER_COLOR .. "'>@" .. player.Name .. "</font>"
		angeloSpeak(pickRandom({
			"It is finished. The <font color='#B652FF'>" .. displayName .. "</font> is a true work of art. It should be in your Inventory already.",
			"The <font color='#B652FF'>" .. displayName .. "</font> is already there in your Inventory, " .. coloredName .. ".",
			"Construction of the <font color='#B652FF'>" .. displayName .. "</font> is done. A flawless execution. It's already there in your Inventory.",
		}), function()
			local FuncAcknowledge = LegendaryRemotes:FindFirstChild("AcknowledgeLegendaryCraft")
			if FuncAcknowledge then FuncAcknowledge:InvokeServer(carName) end
			currentState = FuncGetState:InvokeServer()
			local craftGui = gui:FindFirstChild(carName .. "Crafting")
			if craftGui then
				UpdateCraftingUI(carName)
				mainFrame.Visible = false
				craftGui.Visible = true
			end
		end)
		return
	end

	local craftGui = gui:FindFirstChild(carName .. "Crafting")
	dismissConfirmation()
	hideAllCraftingMenus()
	mainFrame.Visible = false

	if craftGui then
		UpdateCraftingUI(carName)
		local carFrame = craftGui:FindFirstChild(carName)
		if carFrame then
			local exitBtn = carFrame:FindFirstChild("ExitButton") or carFrame:FindFirstChild("CloseButton")
			if exitBtn and not exitBtn:GetAttribute("Connected") then
				exitBtn:SetAttribute("Connected", true)
				Kit.Tween:SetupButton(exitBtn, function()
					if activeCarFocus == carName and isShopOpen then showMainMenu() end
				end)
			end

			local sacrificeItems = carFrame:FindFirstChild("SacrificeItems")
			local mainCraftBtn
			if sacrificeItems then
				local cf = sacrificeItems:FindFirstChild("Confirmation")
				if cf then mainCraftBtn = cf:FindFirstChild("Craft") or cf:FindFirstChild("CraftButton") end
			end
			if not mainCraftBtn then
				mainCraftBtn = carFrame:FindFirstChild("CraftButton", true) or carFrame:FindFirstChild("Craft", true)
			end
			local premiumCraftBtn
			if mainCraftBtn then
				premiumCraftBtn = mainCraftBtn.Parent:FindFirstChild("PremiumCraft")
			end

			if mainCraftBtn and not mainCraftBtn:GetAttribute("Connected") then
				mainCraftBtn:SetAttribute("Connected", true)
				Kit.Tween:SetupButton(mainCraftBtn, function()
					if mainCraftBtn.Visible and mainCraftBtn.Active
						and activeCarFocus == carName and isShopOpen then
						AttemptCraft(carName)
					end
				end)
			end

			if premiumCraftBtn and not premiumCraftBtn:GetAttribute("Connected") then
				premiumCraftBtn:SetAttribute("Connected", true)
				Kit.Tween:SetupButton(premiumCraftBtn, function()
					if premiumCraftBtn.Visible and premiumCraftBtn.Active
						and activeCarFocus == carName and isShopOpen then
						AttemptCraft(carName, true)
					end
				end)
			end

			if sacrificeItems then
				for ingredient, _ in pairs(RECIPES[carName]) do
					if ingredient == "TargetCar" or ingredient == "CraftTime" then continue end
					local reqFrame = sacrificeItems:FindFirstChild(ingredient)
					if reqFrame then
						local sacBtn = reqFrame:FindFirstChild("SacrificeButton")
						if sacBtn and not sacBtn:GetAttribute("Connected") then
							sacBtn:SetAttribute("Connected", true)
							Kit.Tween:SetupButton(sacBtn, function()
								if sacBtn.Visible and sacBtn.Active
									and activeCarFocus == carName and isShopOpen then
									AttemptSacrifice(carName, ingredient)
								end
							end)
						end
					end
				end
			end
		end
	end

	local displayName = getDisplayCarName(carName)
	angeloSpeak(pickRandom({
		"Ah, the <font color='#00E5FF'>" .. displayName .. "</font>. A beautiful choice.",
		"The <font color='#00E5FF'>" .. displayName .. "</font>? You have good taste.",
		"Excellent selection. Let's look at what is required.",
	}), function()
		if activeCarFocus == carName and isShopOpen and craftGui then
			craftGui.Visible  = true
			mainFrame.Visible = false
		else
			mainFrame.Visible = true
		end
	end)
end

-- ============================================================================
-- 🚀  INIT & EVENTS
-- ============================================================================
local function init()
	gui.Enabled = false

	local scrollFrame = mainFrame:WaitForChild("ScrollingFrame")
	local closeBtn    = mainFrame:WaitForChild("ExitButton")

	Kit.Tween:SetupButton(closeBtn, function()
		closeShopUI(true)
	end)

	if scrollFrame then
		for _, carName in ipairs(SHOP_CARS) do
			local card = scrollFrame:WaitForChild(carName, 5)
			if card then
				local buttonsFrame = card:FindFirstChild("Buttons")
				local craftBtn     = buttonsFrame and buttonsFrame:FindFirstChild("Craft")
				if craftBtn then
					Kit.Tween:SetupButton(craftBtn, function()
						OpenCraftingMenu(carName)
					end)
				end
			end
		end
	end

	RemoteOpen.OnClientEvent:Connect(function()
		if isShopOpen or gui.Enabled then return end
		local sessionId      = beginShopSession()
		isShopOpen           = true
		setFocusMode(true)
		Kit.Sound:Play("Open")
		gui.Enabled          = true
		shopFeedback:Clear()
		mainFrame.Visible    = false
		activeCarFocus       = nil
		isProcessingPurchase = false
		confirmationRestoreState = nil
		hideAllCraftingMenus()

		currentState = { CraftProgress = {}, ActiveCrafts = {}, CompletedCrafts = {} }
		local realState = FuncGetState:InvokeServer()
		if not isActiveShopSession(sessionId) then return end
		currentState = realState
		UpdateDisplay()

		-- Check for unacknowledged completed crafts
		local recentCompletedCar = nil
		local completedTime = nil
		for c, t in pairs(currentState.CompletedCrafts or {}) do
			if not acknowledgedCrafts[c] then
				recentCompletedCar = c
				completedTime = t
				acknowledgedCrafts[c] = true
				break
			end
		end

		if recentCompletedCar then
			local dName = getDisplayCarName(recentCompletedCar)
			local timeAgo = formatTimeAgo(completedTime)
			angeloSpeak(pickRandom({
				"Your <font color='#B652FF'>" .. dName .. "</font> has been crafted and delivered to your Inventory <font color='#FFD700'>" .. timeAgo .. "</font>!",
				"The <font color='#B652FF'>" .. dName .. "</font> was completed <font color='#FFD700'>" .. timeAgo .. "</font>. It's sitting in your Inventory now."
			}), function()
				if isActiveShopSession(sessionId) then mainFrame.Visible = true end
			end)
			return
		end

		-- FIX: Default open — show main menu only. Players can browse freely.
		-- The Active Craft panel only appears when they attempt to start another craft.
		-- (Matches Mythical controller behavior — no ShowActiveCraftPanel on open.)
		mainFrame.Visible = true
	end)

	RemoteUpdate.OnClientEvent:Connect(function(newState)
		local coloredName = "<font color='" .. USER_COLOR .. "'>@" .. player.Name .. "</font>"
		local carName
		if currentState and currentState.CompletedCrafts and newState.CompletedCrafts then
			for n, _ in pairs(newState.CompletedCrafts) do
				if not currentState.CompletedCrafts[n] then carName = n; break end
			end
		end

		if not carName then
			if currentState and currentState.ActiveCrafts then
				for n, _ in pairs(currentState.ActiveCrafts) do
					if not newState.ActiveCrafts or not newState.ActiveCrafts[n] then
						carName = n
						break
					end
				end
			end
		end

		if newState.Reason == "Complete" then
			local dName = carName and getDisplayCarName(carName) or "your car"
			if carName then acknowledgedCrafts[carName] = true end
			angeloSpeak(pickRandom({
				"It is finished. The <font color='#B652FF'>" .. dName .. "</font> is a true work of art. It should be in your Inventory already.",
				"The <font color='#B652FF'>" .. dName .. "</font> is already there in your Inventory, " .. coloredName .. ".",
				"Construction of the <font color='#B652FF'>" .. dName .. "</font> is done. A flawless execution. It's already there in your Inventory.",
			}))
		elseif newState.Reason == "Skipped" then
			local dName = carName and getDisplayCarName(carName) or "your car"
			if carName then acknowledgedCrafts[carName] = true end
			angeloSpeak(
				"<font color='#B652FF'>I used magic to do this immediately</font>, it drains my energy, so I need payment to do it. The <font color='#B652FF'>" .. dName .. "</font> should be in your Inventory.",
				function()
					if isShopOpen then mainFrame.Visible = true end
				end
			)
		end
		currentState = newState
		UpdateDisplay()
	end)
end

-- Fast loop: only refreshes the timer text; never shows the panel.
task.spawn(function()
	while true do
		task.wait(1)
		if isShopOpen and gui.Enabled then
			UpdateActiveCraftPanel()
		end
	end
end)

player.CharacterAdded:Connect(function()
	closeShopUI(true)
end)

if player.Character then
	init()
else
	player.CharacterAdded:Wait()
	init()
end
