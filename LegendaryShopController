local function setBlur(enable)
	if enable then
		if not currentBlur then
			currentBlur = Instance.new("BlurEffect")
			currentBlur.Size=0; currentBlur.Parent=Lighting; currentBlur.Name="LegendaryShopBlur"
		end
		TweenService:Create(currentBlur, TweenInfo.new(0.5), {Size=BLUR_SIZE}):Play()
	else
		if currentBlur then
			local t = TweenService:Create(currentBlur, TweenInfo.new(0.5), {Size=0})
			t:Play()
			t.Completed:Connect(function() if currentBlur then currentBlur:Destroy(); currentBlur=nil end end)
		end
	end
end

local function toggleNamedGuiObjects(shouldHide, objectName)
	if shouldHide then
		if #hiddenObjects > 0 then return end
		for _, obj in pairs(PlayerGui:GetDescendants()) do
			if obj:IsA("GuiObject") and obj.Name == objectName and obj.Visible then
				obj.Visible = false; table.insert(hiddenObjects, obj)
			end
		end
	else
		for _, obj in pairs(hiddenObjects) do
			if obj and obj.Parent and obj:IsA("GuiObject") then obj.Visible = true end
		end
		hiddenObjects = {}
	end
end

local function toggleOtherGuis(shouldHide)
	local cGui = resolveConfirmationUi()
	if shouldHide then
		if #hiddenGuis > 0 then return end
		hiddenGuis = {}
		for _, g2 in pairs(PlayerGui:GetChildren()) do
			if g2:IsA("ScreenGui") and g2 ~= gui and g2 ~= cGui
				and g2.Name ~= NPC_GUI_ID and g2.Enabled == true
				and g2.Name ~= "Balance Indicator" then
				g2.Enabled = false; table.insert(hiddenGuis, g2)
			end
		end
	else
		for _, g2 in pairs(hiddenGuis) do
			if g2 and g2.Parent then g2.Enabled = true end
		end
		hiddenGuis = {}
	end
end

local function setFocusMode(active)
	setBlur(active)
	toggleOtherGuis(active)
	toggleNamedGuiObjects(active, "FriendBoost")
	local char = player.Character
	if char and char:FindFirstChild("Humanoid") then
		char.Humanoid.WalkSpeed = active and 0 or 16
		char.Humanoid.JumpPower = active and 0 or 50
	end
end

local function closeShopUI(forceDialogueClose)
	beginShopSession()
	isShopOpen            = false
	isProcessingPurchase  = false
	activeCarFocus        = nil
	confirmationRestoreState = nil
	cancelAngeloSpeak()
	dismissConfirmation()
	mainFrame.Visible = true
	gui.Enabled       = false
	hideAllCraftingMenus()
	setFocusMode(false)
	if forceDialogueClose then forceCloseDialogue() end
end

