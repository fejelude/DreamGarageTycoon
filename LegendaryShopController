local function captureShopViewState()
	local s = { mainFrameVisible = mainFrame.Visible, craftingVisible = {} }
	for _, n in ipairs(SHOP_CARS) do
		local c = gui:FindFirstChild(n .. "Crafting")
		s.craftingVisible[n] = c and c.Visible or false
	end
	return s
end

local function restoreShopViewState(state)
	hideAllCraftingMenus()
	if not state then
		if activeCarFocus then
			mainFrame.Visible = false
			local c = gui:FindFirstChild(activeCarFocus .. "Crafting")
			if c then c.Visible = true else mainFrame.Visible = true end
		else
			mainFrame.Visible = true
		end
		return
	end
	mainFrame.Visible = state.mainFrameVisible == true
	for n, v in pairs(state.craftingVisible) do
		local c = gui:FindFirstChild(n .. "Crafting")
		if c then c.Visible = v == true end
	end
end

local function isActiveShopSession(sessionId)
	return sessionId ~= nil and sessionId == shopSessionId and isShopOpen and gui.Enabled
end

local function beginShopSession()
	shopSessionId       += 1
	shopViewVersion     += 1
	confirmationVersion += 1
	return shopSessionId
end

local dismissConfirmation

local function beginConfirmationView()
	if not confirmationRestoreState then
		confirmationRestoreState = captureShopViewState()
	end
	mainFrame.Visible = false
	hideAllCraftingMenus()
end

local function endConfirmationView()
	restoreShopViewState(confirmationRestoreState)
	confirmationRestoreState = nil
end

local function bindConfirmationButton(button, callback)
	button = applyConfirmationButtonFeedback(button)
	if not button then return end
	local fired = false
	local function hp()
		if fired then return end
		fired = true
		UIAudioConfig.PlayClick()
		callback()
	end
	addConfirmationConnection(button.Activated:Connect(hp))
	addConfirmationConnection(button.MouseButton1Click:Connect(hp))
	addConfirmationConnection(button.TouchTap:Connect(hp))
end

dismissConfirmation = function()
	confirmationVersion += 1
	clearConfirmationConnections()
	local cGui, cMain = resolveConfirmationUi()
	if cMain and cMain:IsA("GuiObject") then cMain.Visible = false end
	if cGui then cGui.Enabled = false end
	endConfirmationView()
end

local function PromptConfirmation(sessionId, text, callback)
	local cGui, cMain = resolveConfirmationUi()
	if not cGui or not cMain then
		warn("⚠️ Confirmation UI not found!")
		if isActiveShopSession(sessionId) then callback(false) end
		return
	end
	confirmationVersion += 1
	local myVersion = confirmationVersion
	clearConfirmationConnections()
	local infoLabel = cMain:FindFirstChild("Information", true)
	local btnYes    = resolveNamedConfirmationButton(cMain, "Yes",  { "Confirm", "Accept", "Okay", "Ok" })
	local btnNo     = resolveNamedConfirmationButton(cMain, "No",   { "Cancel", "Decline", "Back", "Close" })
	if not btnYes or not btnNo then
		warn("⚠️ Confirmation UI buttons missing (Yes/No). Blocking action for safety.")
		if isActiveShopSession(sessionId) then callback(false) end
		return
	end
	if infoLabel then
		pcall(function() infoLabel.RichText = true; infoLabel.TextWrapped = true; infoLabel.Text = text end)
	end
	beginConfirmationView()
	cGui.Enabled = true
	if cMain:IsA("GuiObject") then cMain.Visible = true; cMain.Active = true end
	pcall(function()
		if cGui:IsA("ScreenGui") then
			cGui.DisplayOrder = math.max(cGui.DisplayOrder, gui.DisplayOrder + 10)
		end
	end)
	playConfirmationOpenTween(cMain)
	local function finishChoice(confirmed)
		if myVersion ~= confirmationVersion then return end
		clearConfirmationConnections()
		if cMain:IsA("GuiObject") then cMain.Visible = false end
		cGui.Enabled = false
		endConfirmationView()
		if isActiveShopSession(sessionId) then callback(confirmed) end
	end
	bindConfirmationButton(btnYes, function() finishChoice(true)  end)
	bindConfirmationButton(btnNo,  function() finishChoice(false) end)
end

