-- 🛒  SACRIFICE
-- ============================================================================
local function AttemptSacrifice(carName, ingredient)
	if isProcessingPurchase then return end
	if not currentState or not currentState.CraftProgress then return end
	if not isShopOpen or activeCarFocus ~= carName then return end

	local recipe = RECIPES[carName]
	if not recipe then return end

	local requiredAmount = recipe[ingredient]
	local progress       = currentState.CraftProgress[carName] or {}
	local currentAmount  = progress[ingredient] or 0
	local displayName    = getDisplayCarName(carName)
	local coloredName    = "<font color='" .. USER_COLOR .. "'>@" .. player.Name .. "</font>"

	if currentAmount >= requiredAmount then
		angeloSpeak(pickRandom({
			"We already have enough of that.",
			"That requirement is already fulfilled.",
			"Save it. We don't need any more of those.",
		}))
		return
	end

	if not playerHasIngredient(ingredient, requiredAmount, currentAmount) then
		local itemLabel = ingredient == "Cash"
			and ("$" .. FormatCommas(requiredAmount - currentAmount) .. " cash")
			or ingredient
		-- FIX: "garage" replaced with "Inventory"
		angeloSpeak(pickRandom({
			"Don't waste my time. You don't have the <font color='#00E5FF'>" .. itemLabel .. "</font> in your Inventory.",
			"Dude, you dont even have the <font color='#00E5FF'>" .. itemLabel .. "</font>. Come back when you actually have it.",
			"You are short on resources. I need the <font color='#00E5FF'>" .. itemLabel .. "</font> to proceed.",
			"I don't work for free. Bring me the <font color='#00E5FF'>" .. itemLabel .. "</font> first.",
		}))
		return
	end

	local sacrificeText = ingredient == "Cash"
		and ("$" .. FormatCommas(requiredAmount - currentAmount))
		or  ("1 " .. ingredient)

	local prepareOk, prepareSuccess, confirmationTokenOrMessage = pcall(function()
		return FuncPrepareSacrifice:InvokeServer(carName, ingredient)
	end)
	if not prepareOk or not prepareSuccess then
		Kit.Sound:Play("BuyFail")
		showFeedback(tostring(confirmationTokenOrMessage or "Sacrifice unavailable"), FEEDBACK_COLORS.FailCash)
		return
	end
	local confirmationToken = confirmationTokenOrMessage

	local confirmText = string.format(
		"<font color='%s'>Are you sure you want to sacrifice </font><b><font color='%s'>%s</font></b><font color='%s'> for </font><b><font color='%s'>%s</font></b><font color='%s'>?</font>",
		CONFIRMATION_COLORS.Accent,    CONFIRMATION_COLORS.Sacrifice, escapeRichText(sacrificeText),
		CONFIRMATION_COLORS.Accent,    CONFIRMATION_COLORS.Target,    escapeRichText(displayName),
		CONFIRMATION_COLORS.Accent
	)

	local requestSessionId   = shopSessionId
	local requestViewVersion = shopViewVersion

	PromptConfirmation(requestSessionId, confirmText, function(confirmed)
		if not confirmed then return end
		if not isActiveShopSession(requestSessionId) or requestViewVersion ~= shopViewVersion then return end
		if isProcessingPurchase then return end
		isProcessingPurchase = true

		Kit.Sound:Play("Click")

		task.spawn(function()
			local success, msg = FuncSacrifice:InvokeServer(carName, ingredient, confirmationToken)
			if requestSessionId == shopSessionId then isProcessingPurchase = false end
			if not isActiveShopSession(requestSessionId) then mainFrame.Visible = true; return end

			currentState = FuncGetState:InvokeServer()
			UpdateDisplay()

			local itemsLeft = 0
			for ing, req in pairs(recipe) do
				if ing ~= "TargetCar" and ing ~= "CraftTime" then
					local p = (currentState.CraftProgress[carName]
						and currentState.CraftProgress[carName][ing]) or 0
					if p < req then
						if ing == "Cash" then
							itemsLeft = itemsLeft + 1
						else
							itemsLeft = itemsLeft + (req - p)
						end
					end
				end
			end
			local allComplete = (itemsLeft == 0)

			local craftGui = gui:FindFirstChild(carName .. "Crafting")
			local function restoreToCraftingFrame()
				if activeCarFocus == carName and isShopOpen and craftGui then
					craftGui.Visible  = true
					mainFrame.Visible = false
				else
					mainFrame.Visible = true
				end
			end

			if success then
				Kit.Sound:Play("BuySuccess")
				showFeedback("Sacrifice Successful", FEEDBACK_COLORS.Success)
				if requestViewVersion == shopViewVersion and activeCarFocus == carName then
					if allComplete then
						angeloSpeak(pickRandom({
							"That was the last one! The <font color='#50C878'>sacrifices are complete</font>. Ready to go?",
							"Every piece is finally in place. Click confirm, and I will begin the build.",
							"We have everything we need. Nice.",
							"All requirements met. The <font color='#00E5FF'>" .. displayName .. "</font> is ready to be born. Tell me when to start crafting... when you're ready.",
						}), restoreToCraftingFrame)
					else
						angeloSpeak(pickRandom({
							"The <font color='#00E5FF'>" .. ingredient .. "</font> has been stripped for parts. You still have <font color='#FFD700'>" .. itemsLeft .. "</font> more sacrifices to go.",
							"Sacrifice accepted. Bring me <font color='#FFD700'>" .. itemsLeft .. "</font> more requirements and we can begin.",
							"Alright " .. coloredName .. " thanks for the <font color='#00E5FF'>" .. ingredient .. "</font>. We are getting closer, just <font color='#FFD700'>" .. itemsLeft .. "</font> more to go.",
							"Good. The chassis grows stronger. <font color='#FFD700'>" .. itemsLeft .. "</font> more pieces needed.",
							"Another piece of the puzzle. Just <font color='#FFD700'>" .. itemsLeft .. "</font> more to go before the forge is ready.",
						}), restoreToCraftingFrame)
					end
				else
					mainFrame.Visible = true
				end
			else
				Kit.Sound:Play("BuyFail")
				showFeedback(msg, FEEDBACK_COLORS.FailCash)
				restoreToCraftingFrame()
			end
		end)
	end)
end

-- ============================================================================
-- 🔨  CRAFT
-- ============================================================================
local function AttemptCraft(carName, isPremium)
	if isProcessingPurchase then return end
	if not isShopOpen or activeCarFocus ~= carName then return end
	if not currentState or not currentState.CompletedCrafts then return end

	local recipe      = RECIPES[carName]
	local displayName = getDisplayCarName(carName)
	local coloredName = "<font color='" .. USER_COLOR .. "'>@" .. player.Name .. "</font>"
	local craftGui    = gui:FindFirstChild(carName .. "Crafting")

	local function restoreToCraftingFrame()
		if activeCarFocus == carName and isShopOpen and craftGui then
			craftGui.Visible  = true
			mainFrame.Visible = false
		else
			mainFrame.Visible = true
		end
	end

	-- ── Already crafting (ANY car, not just this one) ──────────────────────
	if currentState.ActiveCrafts and next(currentState.ActiveCrafts) then
		-- Find the active car to display info
		local activeCar, activeEndTime
		for c, e in pairs(currentState.ActiveCrafts) do
			activeCar, activeEndTime = c, e
			break
		end

		if isPremium and currentState.ActiveCrafts[carName] then
			-- Premium skip on the specific car being crafted. Prepare the same
			-- server-side pending skip state used by receipt processing before
			-- opening the Robux prompt.
			promptPreparedCraftSkip(carName)
			return
		end

		local activeDisplayName = getDisplayCarName(activeCar)
		local delta   = math.max(0, activeEndTime - os.time())
		local timeStr = string.format("%02d:%02d:%02d",
			math.floor(delta / 3600), math.floor((delta % 3600) / 60), math.floor(delta % 60))
		angeloSpeak(pickRandom({
			"Patience. you cant make another one dude. im already making the <font color='#B652FF'>" .. activeDisplayName .. "</font> right now. It will be ready in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"i am making a car for you at this moment " .. coloredName .. " i am making <font color='#B652FF'>" .. activeDisplayName .. "</font>. Check back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"You cant rush perfection " .. coloredName .. " The <font color='#B652FF'>" .. activeDisplayName .. "</font> needs <font color='#FF4C4C'>" .. timeStr .. "</font> more time, come back later alright?",
			"I am working as fast as I can. Come back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"The metal is still hot. You must wait exactly <font color='#FF4C4C'>" .. timeStr .. "</font> before the build is complete.",
		}), function()
			-- FIX: Standardized 1.5s wait, then show Active Craft panel.
			-- Do NOT call restoreToCraftingFrame — panel's Exit button handles return.
			task.wait(1.5)
			ShowActiveCraftPanel()
		end)
		return
	end

	-- ── Already completed ────────────────────────────────────────────────────
	if currentState.CompletedCrafts[carName] then
		angeloSpeak(pickRandom({
			"It is finished. The <font color='#B652FF'>" .. displayName .. "</font> is a true work of art. It should be in your Inventory already.",
			"The <font color='#B652FF'>" .. displayName .. "</font> is already there in your Inventory, " .. coloredName .. ".",
			"Construction of the <font color='#B652FF'>" .. displayName .. "</font> is done. A flawless execution. It's already there in your Inventory.",
		}), function()
			local FuncAcknowledge = LegendaryRemotes:FindFirstChild("AcknowledgeLegendaryCraft")
			if FuncAcknowledge then FuncAcknowledge:InvokeServer(carName) end
			currentState = FuncGetState:InvokeServer()
			UpdateDisplay()
			restoreToCraftingFrame()
		end)
		return
	end

	-- ── Requirements check ───────────────────────────────────────────────────
	local missingItems  = {}
	local totalMissing  = 0
	local progress      = currentState.CraftProgress[carName] or {}

	for ingredient, requiredAmount in pairs(recipe) do
		if ingredient == "TargetCar" or ingredient == "CraftTime" then continue end
		local current = progress[ingredient] or 0
		local left    = requiredAmount - current
		if left > 0 then
			if ingredient == "Cash" then
				table.insert(missingItems,
					"<font color='#FFD700'>$" .. FormatCommas(left) .. "</font> Cash")
			else
				table.insert(missingItems,
					"<font color='#FF6B6B'>" .. left .. "x</font> <font color='#00E5FF'>"
						.. ingredient .. "</font>")
			end
			totalMissing += left
		end
	end

	if #missingItems > 0 then
		local listStr = table.concat(missingItems, "<font color='#AAAAAA'>, </font>")
		angeloSpeak(pickRandom({
			"<font color='#FF4C4C'>Not yet.</font> You are still missing: "
				.. listStr
				.. "<font color='#f4efe6'>. Come back when the tribute is complete.</font>",
			"<font color='#FFD700'>Seriously?</font> The forge cannot be lit. You still owe me "
				.. listStr
				.. "<font color='#f4efe6'>. Don't waste my time until you have it all.</font>",
			"<font color='#00E5FF'>Incomplete.</font> The ritual requires "
				.. listStr
				.. "<font color='#f4efe6'>. Every piece matters — bring them all before you dare press that button again.</font>",
			"The <font color='#B652FF'>" .. displayName .. "</font>"
				.. "<font color='#f4efe6'> is a legend. Legends demand sacrifice. You are short </font>"
				.. listStr
				.. "<font color='#f4efe6'>. Return when the debt is paid.</font>",
			coloredName
				.. "<font color='#f4efe6'> you are </font><font color='#FF4C4C'>"
				.. totalMissing .. " sacrifice" .. (totalMissing == 1 and "" or "s")
				.. "</font><font color='#f4efe6'> short. Still need: </font>"
				.. listStr
				.. "<font color='#f4efe6'>.</font>",
		}), restoreToCraftingFrame)
		return
	end

	-- ── Start craft ───────────────────────────────────────────────────────────
	-- FIX: executeCraft is called directly for premium (no PromptConfirmation).
	--      For regular craft, PromptConfirmation is shown as before.
	local requestSessionId   = shopSessionId
	local requestViewVersion = shopViewVersion

	local function executeCraft()
		if not isActiveShopSession(requestSessionId) or requestViewVersion ~= shopViewVersion then return end
		if isProcessingPurchase then return end
		isProcessingPurchase = true

		Kit.Sound:Play("Click")

		task.spawn(function()
			local success, msg = FuncCraftCar:InvokeServer(carName, isPremium)
			if requestSessionId == shopSessionId then isProcessingPurchase = false end
			if not isActiveShopSession(requestSessionId) then mainFrame.Visible = true; return end

			currentState = FuncGetState:InvokeServer()
			UpdateDisplay()

			if success then
				if isPremium then
					-- Show the custom Robux loading state as soon as the premium
					-- purchase prompt opens; RobuxPurchaseState hides it when the
					-- prompt finishes, succeeds, fails, or is cancelled.
					UIAudioConfig.PlayRobux()
					UIAudioConfig.ShowPurchaseLoading()
					MarketplaceService:PromptProductPurchase(player, LEGENDARY_SKIP_PRODUCT_ID)
					restoreToCraftingFrame()
				else
					Kit.Sound:Play("BuySuccess")
					showFeedback("Crafting Started!", FEEDBACK_COLORS.Success)
					if requestViewVersion == shopViewVersion and activeCarFocus == carName then
						local timeStr = "..."
						if currentState.ActiveCrafts and currentState.ActiveCrafts[carName] then
							local delta = math.max(0, currentState.ActiveCrafts[carName] - os.time())
							timeStr = string.format("%02d:%02d:%02d",
								math.floor(delta / 3600), math.floor((delta % 3600) / 60), math.floor(delta % 60))
						end
						angeloSpeak(pickRandom({
							"Alright im working on making your <font color='#B652FF'>" .. displayName .. "</font>, be back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
							"Crafting underway homie. The <font color='#B652FF'>" .. displayName .. "</font> will be ready in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
						}), restoreToCraftingFrame)
					else
						mainFrame.Visible = true
					end
				end
			else
				Kit.Sound:Play("BuyFail")
				showFeedback(msg, FEEDBACK_COLORS.FailCash)
				restoreToCraftingFrame()
			end
		end)
	end

	if isPremium then
		local confirmText = string.format(
			"<font color='%s'>Are you sure you want to skip the waiting time?</font>",
			CONFIRMATION_COLORS.Accent
		)
		PromptConfirmation(requestSessionId, confirmText, function(confirmed)
			if confirmed then executeCraft() end
		end)
	else
		local craftHours = tostring(math.floor((recipe.CraftTime or 0) / 3600))
		local timeDisplay = craftHours .. " hours"
		if recipe.CraftTime and recipe.CraftTime < 3600 then
			timeDisplay = tostring(math.floor(recipe.CraftTime / 60)) .. " minutes"
		end


		local confirmText = string.format(
			"<font color='%s'>Are you sure you want to craft this car? It will take </font><b><font color='%s'>%s</font></b><font color='%s'> to complete.</font>",
			CONFIRMATION_COLORS.Accent, CONFIRMATION_COLORS.Sacrifice, timeDisplay,
			CONFIRMATION_COLORS.Accent
		)
		PromptConfirmation(requestSessionId, confirmText, function(confirmed)
			if confirmed then executeCraft() end
		end)
	end
end

