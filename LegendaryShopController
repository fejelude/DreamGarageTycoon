-- Purpose: Controls the UI, display, and client-side interactions for the Legendary Car Shop.
-- Runs on: Client
-- Location: StarterPlayerScripts.LegendaryShopController
-- Dependencies: ReplicatedStorage.CarStats, ReplicatedStorage.ShopFrontendKit
-- Public API: None (Event-driven)
-- Networking: Listens to ShopRemotes.LegendaryShop.OpenShopUI and LegendaryShopUpdate. Invokes GetLegendaryShopState, CraftLegendaryCar, SacrificeLegendaryIngredient.
-- Security: UI debounces to prevent spam. Server acts as absolute authority for stock, funds, and car ownership.
-- Performance: Direct pathing to nested Craft buttons for O(1) lookups; zero per-frame loops. Recursive FindFirstChild used cautiously.
-- Notes: Updated to explicitly target SacrificeItems > Confirmation > Craft. Recursive search fixes dialogue BindableEvent discovery. Race conditions prevented in toggleOtherGuis.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

-- 🛑 IMMEDIATE HIDE
local gui = PlayerGui:WaitForChild("LegendaryCarsAngeloUi")
local mainFrame = gui:WaitForChild("Mainframe")
mainFrame.Visible = true 
gui.Enabled = false 

-- Confirmation UI
local function resolveGuiButton(target)
	if not target then return nil end
	if target:IsA("GuiButton") then return target end
	for _, descendant in ipairs(target:GetDescendants()) do
		if descendant:IsA("GuiButton") then
			return descendant
		end
	end
	return nil
end

local function resolveConfirmationUi()
	local confirmationGui = PlayerGui:FindFirstChild("Confirmation")
	if not confirmationGui then
		confirmationGui = PlayerGui:WaitForChild("Confirmation", 5)
	end

	if not confirmationGui then
		return nil, nil
	end

	local confirmationMain = confirmationGui:FindFirstChild("MainFrame")
	if not confirmationMain then
		confirmationMain = confirmationGui:WaitForChild("MainFrame", 5)
	end

	return confirmationGui, confirmationMain
end

