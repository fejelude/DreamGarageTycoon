local function formatTimeAgo(timestamp)
	if type(timestamp) ~= "number" then return "recently" end
	local delta = os.time() - timestamp
	if delta < 60 then
		return "just now"
	elseif delta < 3600 then
		local mins = math.floor(delta / 60)
		return mins .. " minute" .. (mins == 1 and "" or "s") .. " ago"
	elseif delta < 86400 then
		local hours = math.floor(delta / 3600)
		return hours .. " hour" .. (hours == 1 and "" or "s") .. " ago"
	elseif delta < 604800 then
		local days = math.floor(delta / 86400)
		return days .. " day" .. (days == 1 and "" or "s") .. " ago"
	elseif delta < 2592000 then
		local weeks = math.floor(delta / 604800)
		return weeks .. " week" .. (weeks == 1 and "" or "s") .. " ago"
	elseif delta < 31536000 then
		local months = math.floor(delta / 2592000)
		return months .. " month" .. (months == 1 and "" or "s") .. " ago"
	else
		local years = math.floor(delta / 31536000)
		return years .. " year" .. (years == 1 and "" or "s") .. " ago"
	end
end

local function pickRandom(t)
