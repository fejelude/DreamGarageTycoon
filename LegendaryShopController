local function FormatCommas(num)
	return tostring(num):reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", "")
end

local function escapeRichText(text)
	text = tostring(text)
	return text:gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;"):gsub("\"","&quot;")
end

-- ============================================================================
-- 💬 ANGELO SPEAK  ← THE FIX
--
-- Self-contained typewriter in the controller.
-- Does NOT check isInteracting — it works whenever the shop is open.
--
-- Flow:
--   1. Hide mainFrame (shop UI)
--   2. Show NPC speech bubble
--   3. Typewrite the message
--   4. Hide NPC speech bubble
--   5. If onDone provided  → call it (caller restores whatever UI it needs)
--      If no onDone        → restore mainFrame automatically
-- ============================================================================
local NPC_GUI_ID       = "UI_NPC_Monk3yDAngelo-Cars"
local NPC_CONTAINER_ID = "Frame_Angelo_Container"
local NPC_TEXT_ID      = "Text_Angelo_Dialogue"
local TYPING_SOUND_ID  = "rbxassetid://4676738150"
local TYPEWRITER_SPEED = 0.02

local activeAngeloJob  = nil

local function cleanTextLength(str)
	local clean = str:gsub("<[^>]+>", "")
	return utf8.len(clean) or #clean
end

local function angeloSpeak(msg, onDone)
	-- Cancel any running typewriter
	if activeAngeloJob then
		pcall(task.cancel, activeAngeloJob)
		activeAngeloJob = nil
	end

	local npcGui    = PlayerGui:FindFirstChild(NPC_GUI_ID)
	local container = npcGui and npcGui:FindFirstChild(NPC_CONTAINER_ID, true)
	local label     = container and container:FindFirstChild(NPC_TEXT_ID, true)

	if not label then
		-- NPC GUI missing: just restore or call onDone
		if onDone then task.spawn(onDone) else mainFrame.Visible = true end
		return
	end

	-- Hide shop, show speech bubble
	mainFrame.Visible         = false
	npcGui.Enabled            = true
	container.Visible         = true
	label.RichText            = true
	label.Text                = msg
	label.MaxVisibleGraphemes = 0

	local len = cleanTextLength(msg)

	activeAngeloJob = task.spawn(function()
		for i = 1, len do
			label.MaxVisibleGraphemes = i
			if i % 3 == 0 then
				local s = Instance.new("Sound", SoundService)
				s.SoundId = TYPING_SOUND_ID; s.Volume = 0.1
				s.PlayOnRemove = true; s:Destroy()
			end
			task.wait(TYPEWRITER_SPEED)
		end
		label.MaxVisibleGraphemes = -1
		activeAngeloJob = nil

		-- Hide speech bubble
		npcGui.Enabled    = false
		container.Visible = false

		-- Restore UI: caller decides, or mainFrame by default
		if onDone then
			task.spawn(onDone)
		else
			mainFrame.Visible = true
		end
	end)
end

local function cancelAngeloSpeak()
	if activeAngeloJob then
		pcall(task.cancel, activeAngeloJob)
		activeAngeloJob = nil
	end
	local npcGui    = PlayerGui:FindFirstChild(NPC_GUI_ID)
	local container = npcGui and npcGui:FindFirstChild(NPC_CONTAINER_ID, true)
	if npcGui    then npcGui.Enabled    = false end
	if container then container.Visible = false end
end

-- ============================================================================
-- 🔎 CLIENT-SIDE ITEM CHECK
-- Lets us skip the confirmation popup if the player clearly doesn't have
-- the ingredient — Angelo tells them immediately instead.
-- ============================================================================
local function playerHasIngredient(ingredient, requiredAmount, currentAmount)
	if ingredient == "Cash" then
		local ls     = player:FindFirstChild("leaderstats")
		local wallet = ls and ls:FindFirstChild("Wallet")
		return wallet and wallet.Value >= (requiredAmount - currentAmount)
	else
		local function scanContainer(c)
			if not c then return false end
			for _, tool in ipairs(c:GetChildren()) do
				if tool:IsA("Tool") then
					local id = tool:GetAttribute("ToolId") or tool.Name
					if id == ingredient or id == ingredient.." Item"
						or tool.Name == ingredient or tool.Name == ingredient.." Item" then
						return true
					end
				end
			end
			return false
		end
		return scanContainer(player:FindFirstChild("Backpack"))
			or scanContainer(player:FindFirstChild("StarterGear"))
	end
end

