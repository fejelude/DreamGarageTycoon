local function hideAllShopFrames()
	mainFrame.Visible = false
	for _, n in ipairs(SHOP_CARS) do
		local c = gui:FindFirstChild(n .. "Crafting")
		if c then c.Visible = false end
	end
end

local function cleanTextLength(str)
	local clean = str:gsub("<[^>]+>", "")
	return utf8.len(clean) or #clean
end

local function angeloSpeak(msg, onDone)
	angeloJobId += 1
	local myJobId = angeloJobId

	if activeAngeloJob then
		pcall(task.cancel, activeAngeloJob)
		activeAngeloJob = nil
	end

	local npcGui, container, label = getNpcUI()

	if not label then
		hideNpcUI()
		if onDone then task.spawn(onDone) else mainFrame.Visible = true end
		return
	end

	hideAllShopFrames()

	npcGui.Enabled            = true
	container.Visible         = true
	label.RichText            = true
	label.Text                = msg
	label.MaxVisibleGraphemes = 0

	local len = cleanTextLength(msg)

	activeAngeloJob = task.spawn(function()
		for i = 1, len do
			if angeloJobId ~= myJobId then return end
			label.MaxVisibleGraphemes = i
			if i % 3 == 0 then typingSound:Play() end
			task.wait(TYPEWRITER_SPEED)
		end

		if angeloJobId ~= myJobId then return end
		label.MaxVisibleGraphemes = -1
		activeAngeloJob = nil

		if POST_SPEAK_DELAY > 0 then task.wait(POST_SPEAK_DELAY) end
		if angeloJobId ~= myJobId then return end

		hideNpcUI()

		if onDone then
			task.spawn(onDone)
		else
			mainFrame.Visible = true
		end
	end)
end

local function cancelAngeloSpeak()
	angeloJobId += 1
	if activeAngeloJob then
		pcall(task.cancel, activeAngeloJob)
		activeAngeloJob = nil
	end
	hideNpcUI()
end

