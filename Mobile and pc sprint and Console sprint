-- Purpose: Handles Mobile Button + PC Shift + Console Y + Custom Running Animation.
-- Runs on: Client
-- Location: StarterGui (Assumed child of an ImageButton)
-- Dependencies: UserInputService, Players, RunService

local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local button = script.Parent -- The ImageButton

-- === CONFIGURATION ===
local WALK_SPEED = 30
local SPRINT_SPEED = 50
local ANIMATION_ID = "rbxassetid://103489308479400"
local PC_BIND = Enum.KeyCode.LeftShift
local CONSOLE_BIND = Enum.KeyCode.ButtonY

-- === STATE ===
local isSprinting = false
local runTrack = nil

-- Helper: true while the loading screen or a UI/Dialogue lock is active
local function isMovementLocked()
	if playerGui:GetAttribute("LoadingScreenActive") == true then return true end
	if player:GetAttribute("MovementLock") == true then return true end
	return false
end

-- 1. VISIBILITY SETUP (Mobile Check)
button.Visible = UserInputService.TouchEnabled

-- 🛠️ ANIMATION HANDLER
local function updateAnimation(humanoid)
	if not runTrack then return end

	if isSprinting and humanoid.MoveDirection.Magnitude > 0 and not isMovementLocked() then
		if not runTrack.IsPlaying then
			runTrack:Play()
		end
	else
		if runTrack.IsPlaying then
			runTrack:Stop()
		end
	end
end

-- 🛠️ SPEED HANDLER (Authority)
local function updateSpeed()
	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid then return end

	-- 1. Check for Movement Lock (Dialogue/UI)
	if isMovementLocked() then
		humanoid.WalkSpeed = 0
		if runTrack and runTrack.IsPlaying then runTrack:Stop() end
		return
	end

	-- 2. SAFETY CHECK: If holding a tool, NEVER sprint
	if character:FindFirstChildWhichIsA("Tool") then
		isSprinting = false
		humanoid.WalkSpeed = WALK_SPEED
		if runTrack and runTrack.IsPlaying then runTrack:Stop() end
		button.ImageTransparency = 0
		if UserInputService.TouchEnabled then button.Visible = false end
		return
	end

	-- 3. Normal Speed Application
	humanoid.WalkSpeed = isSprinting and SPRINT_SPEED or WALK_SPEED
	button.ImageTransparency = isSprinting and 0.5 or 0
	
	if UserInputService.TouchEnabled then button.Visible = true end
	
	updateAnimation(humanoid)
end

-- 🛡️ CHARACTER SETUP
local function setupCharacter(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local animator = humanoid and humanoid:WaitForChild("Animator", 10)
	if not humanoid or not animator then return end

	-- 1. LOAD ANIMATION
	local newAnim = Instance.new("Animation")
	newAnim.AnimationId = ANIMATION_ID
	runTrack = animator:LoadAnimation(newAnim)
	runTrack.Priority = Enum.AnimationPriority.Action
	runTrack.Looped = true

	-- 2. TOOL MONITORING
	local function checkTools()
		updateSpeed()
	end

	character.ChildAdded:Connect(checkTools)
	character.ChildRemoved:Connect(checkTools)

	-- 3. MOVEMENT MONITORING
	humanoid:GetPropertyChangedSignal("MoveDirection"):Connect(function()
		updateAnimation(humanoid)
	end)

	-- 4. STATE WATCHER (Listen for lock changes)
	playerGui:GetAttributeChangedSignal("LoadingScreenActive"):Connect(updateSpeed)
	player:GetAttributeChangedSignal("MovementLock"):Connect(updateSpeed)

	-- 5. INITIALIZATION
	updateSpeed()
end

-- ============================================================================
-- 💻 PC & 🎮 CONSOLE LOGIC (Tap to Toggle)
-- ============================================================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if isMovementLocked() then return end

	if input.KeyCode == PC_BIND or input.KeyCode == CONSOLE_BIND then
		local char = player.Character
		if char and char:FindFirstChildWhichIsA("Tool") then return end

		isSprinting = not isSprinting
		updateSpeed()
	end
end)

-- ============================================================================
-- 📱 MOBILE LOGIC (Tap Button to Toggle)
-- ============================================================================
button.MouseButton1Click:Connect(function()
	if isMovementLocked() then return end

	local char = player.Character
	if char and char:FindFirstChildWhichIsA("Tool") then return end

	isSprinting = not isSprinting
	updateSpeed()
end)

-- 🛡️ RESET ON RESPAWN
player.CharacterAdded:Connect(function(char)
	isSprinting = false
	if runTrack then
		runTrack:Destroy()
		runTrack = nil
	end

	button.Visible = UserInputService.TouchEnabled
	setupCharacter(char)
end)

-- Initial Setup
if player.Character then setupCharacter(player.Character) end

