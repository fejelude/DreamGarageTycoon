local function splitPath(path)
	local names = {}
	for name in string.gmatch(path, "([^>]+)") do
		local trimmedName = string.gsub(name, "^%s*(.-)%s*$", "%1")
		table.insert(names, trimmedName)
	end
	return names
end

local function resolvePath(path)
	local names = splitPath(path)
	local root = serviceRoots[names[1]]
	if not root then
		return nil, names[1]
	end

	local current = root
	for index = 2, #names do
		local child = current:FindFirstChild(names[index])
		if not child then
			return nil, table.concat(names, " > ", 1, index)
		end
		current = child
	end

	return current, nil
end

local function matchesClass(instance, expectedClassName)
	if expectedClassName == "GuiObject" then
		return instance:IsA("GuiObject")
	end
	return instance:IsA(expectedClassName)
end

local function warnRequirement(requirement, reason, foundClassName)
	local foundText = foundClassName and ("\n  Found Instance Type: " .. foundClassName) or ""
	warn(string.format(
		"%s %s\n  Exact Name: %s\n  Expected Path: %s\n  Expected Instance Type: %s%s\n  Required By: %s",
		PREFIX,
		reason,
		requirement.Name,
		requirement.Path,
		requirement.ClassName,
		foundText,
		requirement.RequiredBy
	))
end

local function scan()
	local missingCount = 0
	local wrongTypeCount = 0

	for _, requirement in ipairs(requirements) do
		local instance, missingPath = resolvePath(requirement.Path)
		if not instance then
			missingCount += 1
			warnRequirement(requirement, "Missing required object. Missing at or before: " .. tostring(missingPath))
		elseif not matchesClass(instance, requirement.ClassName) then
			wrongTypeCount += 1
			warnRequirement(requirement, "Required object has the wrong instance type.", instance.ClassName)
		end
	end

	if missingCount == 0 and wrongTypeCount == 0 then
		print(PREFIX .. " Scan complete: all Global Money Frenzy hierarchy requirements are present with valid instance types.")
	else
		warn(string.format(
			"%s Scan complete: %d missing object(s), %d wrong type object(s). Please fix these manually in Roblox Studio; no instances were created or modified.",
			PREFIX,
			missingCount,
			wrongTypeCount
		))
	end
end

scan()
