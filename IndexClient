-- Purpose: Client controller for Index UI open/close + card rendering.
-- Location: StarterGui > Index > IndexClient

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")

local UIButtonUtils = require(ReplicatedStorage:WaitForChild("UIButtonUtils"))
local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))
local CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local indexGui = playerGui:WaitForChild("Index")
local mainFrame = indexGui:WaitForChild("MainFrame")
local exitButton = mainFrame:WaitForChild("ExitButton")
local container = mainFrame:WaitForChild("IndexContainer")
local template = container:WaitForChild("CarTemplate")
local indexCountLabel = mainFrame:WaitForChild("TextLabels"):WaitForChild("Important"):WaitForChild("IndexCount")

local mainButtonsGui = playerGui:WaitForChild("MainButtons")
local buttonsContainer = mainButtonsGui:FindFirstChild("Buttons") or mainButtonsGui
local openButton = buttonsContainer:WaitForChild("Index")

local remotes = ReplicatedStorage:WaitForChild("IndexRemotes")
local refreshEvent = remotes:WaitForChild("RefreshIndexUI")

local EXPECTED_INDEX_TOTAL = 47
local isOpen = false
local hiddenGuis = {}
local savedFOV = 70
local OPEN_FOV = 50
local FOV_TWEEN = TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
local indexScreenGui = indexGui:IsA("ScreenGui") and indexGui or indexGui:FindFirstAncestorWhichIsA("ScreenGui")
local gradientTweens = setmetatable({}, {__mode = "k"})

if indexScreenGui then
	indexScreenGui.ResetOnSpawn = false
end

local CARD_HOVER_SCALE = 1.05
local CARD_HOVER_TWEEN = TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

local function getOrCreateCardScale(card)
	local uiScale = card:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Scale = 1
		uiScale.Parent = card
	end
	return uiScale
end

local function wireCardHoverEffects(card)
	if card:GetAttribute("IndexHoverBound") then return end
	card:SetAttribute("IndexHoverBound", true)
	card.Active = true

	local uiScale = getOrCreateCardScale(card)
	local isHovering = false

	local function tweenTo(scale)
		TweenService:Create(uiScale, CARD_HOVER_TWEEN, {Scale = scale}):Play()
	end

	card.MouseEnter:Connect(function()
		if isHovering then return end
		isHovering = true
		UIAudioConfig.PlayHover()
		tweenTo(CARD_HOVER_SCALE)
	end)

	card.MouseLeave:Connect(function()
		isHovering = false
		tweenTo(1)
	end)

	card.AncestryChanged:Connect(function(_, parent)
		if not parent then
			isHovering = false
		end
	end)
end

local RARITY_ORDER = {Common = 1, Uncommon = 2, Rare = 3, Epic = 4, Legendary = 5, Mythic = 6}
local function rarityGradient(rarity)
	if rarity == "Mythic" then
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0.0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(1.0, Color3.fromRGB(255, 0, 255)),
		})
	elseif rarity == "Legendary" then
		return ColorSequence.new(Color3.fromRGB(255, 180, 50), Color3.fromRGB(255, 240, 150))
	elseif rarity == "Epic" then
		return ColorSequence.new(Color3.fromRGB(160, 50, 255), Color3.fromRGB(220, 100, 255))
	elseif rarity == "Rare" then
		return ColorSequence.new(Color3.fromRGB(0, 100, 255), Color3.fromRGB(100, 200, 255))
	elseif rarity == "Uncommon" then
		return ColorSequence.new(Color3.fromRGB(0, 180, 0), Color3.fromRGB(100, 255, 100))
	end
	return ColorSequence.new(Color3.fromRGB(150, 150, 150), Color3.fromRGB(220, 220, 220))
end

local function getCamera(waitSeconds)
	local cam = Workspace.CurrentCamera
	if cam then return cam end
	if waitSeconds and waitSeconds > 0 then
		local started = os.clock()
		repeat
			task.wait()
			cam = Workspace.CurrentCamera
		until cam or (os.clock() - started) >= waitSeconds
	end
	return cam
end

local sortedCars = {}
for key, car in pairs(CarStats.Cars or {}) do
	table.insert(sortedCars, {Key = key, Data = car})
end
if #sortedCars ~= EXPECTED_INDEX_TOTAL then
	warn(string.format("⚠️ [INDEX] Expected %d cars but CarStats.Cars has %d entries.", EXPECTED_INDEX_TOTAL, #sortedCars))
end

table.sort(sortedCars, function(a, b)
	local ar, br = RARITY_ORDER[a.Data.Rarity] or 99, RARITY_ORDER[b.Data.Rarity] or 99
	if ar ~= br then return ar < br end
	local ap, bp = tonumber(a.Data.Price) or 0, tonumber(b.Data.Price) or 0
	if ap ~= bp then return ap < bp end
	return a.Key < b.Key
end)

local cardMap = {}
local function decodeDiscovered()
	local raw = player:GetAttribute("IndexDiscoveredJson") or "[]"
	local ok, result = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok or type(result) ~= "table" then return {} end
	local set = {}
	for _, name in ipairs(result) do
		if type(name) == "string" then set[name] = true end
	end
	return set
end

local function setMainFrameVisible(visible)
	isOpen = visible
	mainFrame.Visible = visible
	openButton.Visible = not visible
end

local function restoreHiddenGuis()
	for _, gui in ipairs(hiddenGuis) do if gui and gui.Parent then gui.Enabled = true end end
	hiddenGuis = {}
end

local function hideOtherGuis()
	hiddenGuis = {}
	for _, gui in ipairs(playerGui:GetDescendants()) do
		if gui:IsA("ScreenGui") and gui ~= indexScreenGui and gui.Enabled == true then
			gui.Enabled = false
			table.insert(hiddenGuis, gui)
		end
	end
end

local function closeIndex()
	if not isOpen then return end
	restoreHiddenGuis()
	setMainFrameVisible(false)
	local camera = getCamera(0.5)
	if camera then
		TweenService:Create(camera, FOV_TWEEN, {FieldOfView = savedFOV}):Play()
	end
end

local function applyGradientAnimation(gradient, rarity)
	gradient.Color = rarityGradient(rarity)
	gradient.Rotation = -20
	local tag = gradient:GetAttribute("__IndexGlowRarity")
	if tag ~= rarity then
		gradient:SetAttribute("__IndexGlowRarity", rarity)
		if gradientTweens[gradient] then gradientTweens[gradient]:Cancel() end
		gradient.Offset = Vector2.new(-0.35, 0)
		local tween = TweenService:Create(gradient, TweenInfo.new(2.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Offset = Vector2.new(0.35, 0)})
		tween:Play()
		gradientTweens[gradient] = tween
	end
end

local function renderIndex()
	local discovered = decodeDiscovered()
	local count = 0
	for _, car in ipairs(sortedCars) do
		local card = cardMap[car.Key]
		if card then
			local discoveredState = discovered[car.Key] == true
			if discoveredState then count += 1 end
			local nameLabel = card:WaitForChild("TextLabels"):WaitForChild("CarName")
			local imageLabel = card:WaitForChild("CarImage")
			nameLabel.Text = discoveredState and (car.Data.Name or car.Key) or "???"
			imageLabel.Image = car.Data.Image or ""
			imageLabel.ImageColor3 = discoveredState and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(0, 0, 0)
		end
	end
	indexCountLabel.Text = string.format("(%d/%d)", math.clamp(count, 0, EXPECTED_INDEX_TOTAL), EXPECTED_INDEX_TOTAL)
end

local function setupCards()
	template.Visible = false
	for _, child in ipairs(container:GetChildren()) do
		if child:IsA("Frame") and child ~= template then child:Destroy() end
	end
	for i = 1, math.min(EXPECTED_INDEX_TOTAL, #sortedCars) do
		local car = sortedCars[i]
		local card = template:Clone()
		card.Name = "IndexCard_" .. tostring(i)
		card.Visible = true
		card.Parent = container
		cardMap[car.Key] = card
		wireCardHoverEffects(card)
		local gradient = card:WaitForChild("Background"):FindFirstChildOfClass("UIGradient")
		if gradient then applyGradientAnimation(gradient, car.Data.Rarity) end
	end
end

setMainFrameVisible(false)
setupCards()
renderIndex()

UIButtonUtils.SetupButton(openButton, function()
	UIAudioConfig.PlayClick()
	local camera = getCamera(2)
	if camera then
		savedFOV = camera.FieldOfView
	end
	hideOtherGuis()
	setMainFrameVisible(true)
	if camera then
		TweenService:Create(camera, FOV_TWEEN, {FieldOfView = OPEN_FOV}):Play()
	end
	renderIndex()
end)

UIButtonUtils.SetupButton(exitButton, function()
	UIAudioConfig.PlayClick()
	closeIndex()
end)

if indexScreenGui then
	indexScreenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if isOpen and not indexScreenGui.Enabled then
			closeIndex()
		end
	end)
end

refreshEvent.OnClientEvent:Connect(renderIndex)
player:GetAttributeChangedSignal("IndexDiscoveredJson"):Connect(renderIndex)
