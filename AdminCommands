local RESTOCK_TOPIC = "AdminShopRestock"

task.spawn(function()
	pcall(function()
		MessagingService:SubscribeAsync(RESTOCK_TOPIC, function(message)
			local data = message.Data
			if type(data) == "string" then
				print("🌐 [Admin] Cross-server Restock Received:", data)
				AdminRestockEvent:Fire(data)
				RestockNotificationEvent:FireAllClients(data)
			end
		end)
	end)
end)

-- ============================================================================
-- 🎯 TARGET SELECTORS
-- ============================================================================
local function getTargets(speaker, selector)
	if not selector then return {} end
	selector = selector:lower()

	local allPlrs = Players:GetPlayers()

	if selector == "@s" or selector == "me" then 
		return {speaker} 
	elseif selector == "@a" or selector == "all" then 
		return allPlrs 
	elseif selector == "@r" or selector == "random" then
		return #allPlrs > 0 and {allPlrs[math.random(1, #allPlrs)]} or {}
	elseif selector == "@others" then
		local others = {}
		for _, p in pairs(allPlrs) do
			if p ~= speaker then table.insert(others, p) end
		end
		return others
	end

	-- Partial Name Match
	for _, p in pairs(allPlrs) do 
		if p.Name:lower() == selector or p.DisplayName:lower() == selector then return {p} end
	end
	for _, p in pairs(allPlrs) do 
		if p.Name:lower():sub(1, #selector) == selector then return {p} end
	end

	return {}
end

-- ============================================================================
-- ⚡ COMMAND ACTIONS
-- ============================================================================

local function Action_Give(player, tool, force)
	local backpack = player:WaitForChild("Backpack", 5)
	if not backpack then return false, "No Backpack" end
	local cleanID = getCleanID(tool.Name)
	local owned = getOwnedSet(player)

	-- If they already have it, warn the admin (unless forced)
	if owned[cleanID] and not force then 
		return false, "Already Owns Item" 
	end

	-- Give to Backpack
	local bpTool = tool:Clone()
	tagIssued(bpTool, tool.Name) 
	bpTool.Parent = backpack

	-- Give to StarterGear (Persistence)
	local sg = player:FindFirstChild("StarterGear")
	if sg then
		local sgTool = tool:Clone()
		tagIssued(sgTool, tool.Name)
		sgTool.Parent = sg
	end

	return true, "Given"
end

local function Action_Remove(player, toolName)
	local targetID = getCleanID(toolName)
	local count = 0

	local function scanAndDestroy(container)
		if not container then return end
		for _, t in pairs(container:GetChildren()) do
			if t:IsA("Tool") then
				local id = getCleanID(t:GetAttribute("ToolId") or t.Name)
				if id == targetID or (targetID == "all" or targetID == "*") then
					t:Destroy()
					count = count + 1
				end
			end
		end
	end

	scanAndDestroy(player:FindFirstChild("Backpack"))
	scanAndDestroy(player:FindFirstChild("StarterGear"))
	if player.Character then scanAndDestroy(player.Character) end

	return count > 0, count
end

local function Action_SetFlight(player, shouldFly)
	if not player.Character then return end
	local old = player.Character:FindFirstChild("FlyClient")

	if old then
		player.Character:SetAttribute("ForceStopFly", true)
		task.wait(0.1)
		old:Destroy()
		player.Character:SetAttribute("ForceStopFly", nil)
	end

	if shouldFly and FlyScriptTemplate then
		local scriptClone = FlyScriptTemplate:Clone()
		scriptClone.Name = "FlyClient"
		scriptClone.Parent = player.Character
		scriptClone.Disabled = false
	end
end

-- ============================================================================
-- 💬 CHAT HANDLER
-- ============================================================================

Players.PlayerAdded:Connect(function(player)
	player.Chatted:Connect(function(message)
		if not (IS_STUDIO or ADMIN_USER_IDS[player.UserId]) then return end

		-- Debounce
		local lastCmd = AdminDebounces[player.UserId] or 0
		if (os.clock() - lastCmd) < CMD_DEBOUNCE then return end
		AdminDebounces[player.UserId] = os.clock()

		if message:sub(1,1) ~= "/" then return end

		local args = message:split(" ")
		local command = args[1]:lower()

		-- 🟢 /give [player] [item] [amount]
		if command == "/give" then
			local selector = args[2]
			local itemName = table.concat(args, " ", 3)
			if not selector or itemName == "" then return end

			local targets = getTargets(player, selector)

			-- Parse optional trailing amount (e.g. "/give @s Maverick 10" or "/give @s all 5")
			local amount = 1
			local trailingNumber = itemName:match("%s(%d+)$")
			if trailingNumber then
				amount = tonumber(trailingNumber) or 1
				if amount < 1 then amount = 1 end
				-- Strip the trailing number from itemName
				itemName = itemName:sub(1, -(#trailingNumber + 2)) -- remove " <number>"
			end

			-- ✅ SPECIAL LOGIC: /give [player] all [amount]
			if itemName:lower() == "all" then
				local allTools = getAllTools()
				for _, t in pairs(targets) do
					local count = 0
					for _, tool in pairs(allTools) do
						for i = 1, amount do
							local success, _ = Action_Give(t, tool, true)
							if success then count = count + 1 end
						end
					end
					print(string.format("🎁 [Admin] Given %d items (x%d each) to %s", count, amount, t.Name))
				end
				return
			end

			-- Normal Single Item Logic
			local tool = matchTool(itemName)

			if not tool then
				print("❌ [Admin] Unknown Item: " .. itemName)
				return 
			end

			for _, t in pairs(targets) do
				local givenCount = 0
				for i = 1, amount do
					local success, reason = Action_Give(t, tool, true)
					if success then
						givenCount = givenCount + 1
					else
						print(string.format("⚠️ Failed to give [%s] to %s: %s", tool.Name, t.Name, reason))
					end
				end
				if givenCount > 0 then
					print(string.format("✅ Given [%s] x%d to %s", tool.Name, givenCount, t.Name))
				end
			end

			-- 🔴 /remove [player] [item]
		elseif command == "/remove" or command == "/take" then
			local selector = args[2]
			local itemName = table.concat(args, " ", 3)
			if not selector or itemName == "" then return end

			local targets = getTargets(player, selector)

			for _, t in pairs(targets) do
				local success, count = Action_Remove(t, itemName)
				if success then
					print(string.format("🗑️ Removed %d instance(s) of '%s' from %s", count, itemName, t.Name))
				else
					print(string.format("⚠️ %s does not have item: %s", t.Name, itemName))
				end
			end

			-- 🟢 /clearinventory [player]
		elseif command == "/clearinventory" or command == "/ci" then
			local selector = args[2]
			local targets = getTargets(player, selector)
			for _, t in pairs(targets) do
				Action_Remove(t, "all")
				print("🗑️ Cleared inventory of " .. t.Name)
			end

			-- ✈️ /fly & /unfly
		elseif command == "/fly" then
			local targets = getTargets(player, args[2])
			for _, t in pairs(targets) do Action_SetFlight(t, true) end
			print("✈️ Flight Enabled")

		elseif command == "/unfly" then
			local targets = getTargets(player, args[2])
			for _, t in pairs(targets) do Action_SetFlight(t, false) end
			print("✈️ Flight Disabled")

			-- 💰 /wallet [player] [amount]  →  adds to Wallet (in leaderstats)
			-- 💰 /bank   [player] [amount]  →  adds to Cash   (in HiddenStats)
		elseif command == "/wallet" or command == "/bank" then
			local selector = args[2]
			local amount = tonumber(args[3])
			if not selector or not amount then return end

			local targets = getTargets(player, selector)

			for _, t in pairs(targets) do
				if command == "/bank" then
					-- ✅ FIX: Cash lives in HiddenStats, not leaderstats
					local hs = t:FindFirstChild("HiddenStats")
					local stat = hs and hs:FindFirstChild("Cash")
					if stat then
						stat.Value = stat.Value + amount
						print(string.format("💰 Added $%d to %s's Bank (HiddenStats.Cash)", amount, t.Name))
					else
						warn("⚠️ HiddenStats.Cash not found for " .. t.Name)
					end
				else
					-- Wallet stays in leaderstats, no change needed
					local ls = t:FindFirstChild("leaderstats")
					local stat = ls and ls:FindFirstChild("Wallet")
					if stat then
						stat.Value = stat.Value + amount
						print(string.format("💰 Added $%d to %s's Wallet", amount, t.Name))
					else
						warn("⚠️ leaderstats.Wallet not found for " .. t.Name)
					end
				end
			end

			-- 👑 /rank [player] [RankFolderName]
		elseif command == "/rank" then
			local selector = args[2]
			local rankName = args[3] 

			if not selector or not rankName then 
				print("⚠️ Syntax: /rank [selector] [RankName] (e.g. /rank @s VIP+)")
				return 
			end

			local targets = getTargets(player, selector)

			for _, t in pairs(targets) do
				if SetRankAPI then
					local success, reason = SetRankAPI:Invoke(t, rankName)
					if success then
						print(string.format("👑 Set rank visual of %s to %s", t.Name, rankName))
					else
						print(string.format("⚠️ Failed to set rank for %s: %s", t.Name, reason))
					end
				else
					warn("❌ SetRankAPI missing in ServerStorage")
				end
			end

			-- 💣 /clear [player] (FULL WIPE)
		elseif command == "/clear" or command == "/wipe" then
			local selector = args[2]
			if not selector then return end
			local targets = getTargets(player, selector)

			if TycoonAdminAPI then
				for _, t in pairs(targets) do
					TycoonAdminAPI:Invoke("ForceWipe", t)
					print("💀 FULL WIPE EXECUTED: " .. t.Name)
				end
			else
				warn("❌ TycoonAdminAPI missing")
			end

			-- 📋 /list
		elseif command == "/list" then
			print("🚗 Available Cars:")
			for _, t in pairs(getAllTools()) do
				print(" - " .. getCleanID(t.Name))
			end

			-- 🔄 /restock [item] or "all"
		elseif command == "/restock" then
			local itemName = table.concat(args, " ", 2)
			if not itemName or itemName == "" then
				print("⚠️ Syntax: /restock [item] OR /restock all")
				return
			end

			local targetItem = itemName:lower()
			if targetItem == "all" then
				task.spawn(function()
					pcall(function()
						MessagingService:PublishAsync(RESTOCK_TOPIC, "all")
					end)
				end)
				print("🔄 [Admin] Published global restock command for ALL cars.")
			else
				-- Match car name safely
				local tool = matchTool(itemName)
				if not tool then
					print("❌ [Admin] Unknown Car: " .. itemName)
					return
				end

				-- Convert the tool name back to the base CarStats key (e.g. "Riva Item" -> "Riva")
				local realCarName = tool.Name
				if realCarName:lower():sub(-5) == " item" then
					realCarName = realCarName:sub(1, -6)
				end

				local carData = CarStats.Cars and CarStats.Cars[realCarName]
				if carData then
					if carData.Rarity == "Legendary" or carData.Rarity == "Mythic" then
						print("❌ [Admin] Cannot restock crafted items (Legendary/Mythic).")
						return
					end
				end

				task.spawn(function()
					pcall(function()
						MessagingService:PublishAsync(RESTOCK_TOPIC, realCarName)
					end)
				end)
				print("🔄 [Admin] Published global restock command for:", realCarName)
			end
		end
	end)
end)