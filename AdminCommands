-- Purpose: Advanced Minecraft-Style Admin Commands
-- Runs on: Server (ServerScriptService)
-- Public API: /give, /remove, /clear, /fly, /tp, /wallet, /bank, /rank
-- Security: Strict ID Whitelist, Anti-Duplicate logic, Secure Data Wiping
-- FIX: /rank command now pulls securely from ServerStorage.RankTags instead of Workspace.

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local MessagingService = game:GetService("MessagingService")

-- ⚙️ CONFIGURATION
local CarTools = ServerStorage:WaitForChild("CarTools") 
local FlyScriptTemplate = ServerStorage:WaitForChild("FlyClient", 5) 

local AdminRestockEvent = ServerStorage:FindFirstChild("AdminRestockEvent")
if not AdminRestockEvent then
	AdminRestockEvent = Instance.new("BindableEvent")
	AdminRestockEvent.Name = "AdminRestockEvent"
	AdminRestockEvent.Parent = ServerStorage
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RestockNotificationEvent = ReplicatedStorage:FindFirstChild("RestockNotificationEvent")
if not RestockNotificationEvent then
	RestockNotificationEvent = Instance.new("RemoteEvent")
	RestockNotificationEvent.Name = "RestockNotificationEvent"
	RestockNotificationEvent.Parent = ReplicatedStorage
end

local CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))

-- ⚠️ SECURITY: Add your UserID here
local ADMIN_USER_IDS = {
	[5512860740] = true, -- Your ID
}

local IS_STUDIO = RunService:IsStudio()
local CMD_DEBOUNCE = 0.3

-- 🛡️ STATE
local AdminDebounces = {}
local ToolCache = nil
math.randomseed(os.time()) 

-- 🔗 API CONNECTION
local TycoonAdminAPI = ServerStorage:WaitForChild("TycoonAdminAPI", 10)
local SetRankAPI = ServerStorage:WaitForChild("SetRankAPI", 10)

-- ============================================================================
-- 🧠 INTELLIGENT PARSING (Minecraft Style)
-- ============================================================================

local function getCleanID(rawName)
	if not rawName then return "" end
	local lower = rawName:lower()
	if lower:sub(-5) == " item" then return lower:sub(1, -6) end
	return lower
end

local function getAllTools()
	if ToolCache then return ToolCache end
	local tools = {}
	-- FIX: Iterate through exact rarity folders instead of deep descendants to avoid mesh parts
	for _, folderName in ipairs({"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic"}) do
		local folder = CarTools:FindFirstChild(folderName)
		if folder then
			for _, t in ipairs(folder:GetChildren()) do
				if t:IsA("Tool") then table.insert(tools, t) end
			end
		end
	end
	ToolCache = tools
	return tools
end

-- Using ChildAdded on rarity folders to invalidate cache
for _, folderName in ipairs({"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic"}) do
	local folder = CarTools:FindFirstChild(folderName)
	if folder then
		folder.ChildAdded:Connect(function() ToolCache = nil end)
		folder.ChildRemoved:Connect(function() ToolCache = nil end)
	end
end

-- Finds a tool by partial name (e.g. "civ" finds "Honda Civic")
local function matchTool(query)
	local target = getCleanID(query)
	local bestMatch = nil

	for _, tool in pairs(getAllTools()) do
		local id = getCleanID(tool.Name)

		-- 1. Exact Match (Highest Priority)
		if id == target then 
			return tool 
		end

		-- 2. Partial Match
		if id:find(target, 1, true) then
			bestMatch = tool
		end
	end
	return bestMatch
end

local function getOwnedSet(player)
	local set = {}
	local function scan(container)
		if not container then return end
		for _, t in pairs(container:GetChildren()) do
			if t:IsA("Tool") then 
				local id = t:GetAttribute("ToolId") or t.Name
				set[getCleanID(id)] = true 
			end
		end
	end
	scan(player:FindFirstChild("Backpack"))
	scan(player:FindFirstChild("StarterGear"))
	if player.Character then scan(player.Character) end
	return set
end

local function tagIssued(tool, realID)
	if not tool then return end
	tool:SetAttribute("IssuedByServer", true)
	tool:SetAttribute("IssuedAt", os.time())
	tool:SetAttribute("IssuedId", HttpService:GenerateGUID(false)) 
	tool:SetAttribute("ToolId", realID) 
	tool.CanBeDropped = false
end

