-- Purpose: Computes and grants Offline Earnings with one-time claim enforcement and premium 10x support.
-- Runs on: Server
-- Location: ServerScriptService > OfflineEarningsService
-- Required hierarchy:
-- ReplicatedStorage
-- └── OfflineEarningsRemotes
--     ├── RequestOfflineEarnings          RemoteFunction
--     ├── ClaimOfflineEarnings            RemoteFunction
--     ├── BeginPremiumOfflineClaim        RemoteFunction
--     └── OfflinePremiumClaimResult       RemoteEvent

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Workspace = game:GetService("Workspace")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))
local PlayerTransactionCoordinator = require(ServerScriptService:WaitForChild("PlayerTransactionCoordinator"))
local PaidActionIntentStore = require(ServerScriptService:WaitForChild("PaidActionIntentStore"))

local OFFLINE_RATE = 0.30
local MAX_OFFLINE_SECONDS = 8 * 60 * 60
local PREMIUM_PRODUCT_ID = 3598967453
local PREMIUM_RECEIPT_SERIAL_ATTRIBUTE = "OfflinePremiumReceiptSerial"

local function requireChild(parent, childName, expectedClass)
	local child = parent:FindFirstChild(childName)

	if not child then
		error(
			string.format(
				"[OfflineEarningsService] Missing required object: %s.%s | Expected type: %s",
				parent:GetFullName(),
				childName,
				expectedClass
			)
		)
	end

	if not child:IsA(expectedClass) then
		error(
			string.format(
				"[OfflineEarningsService] Wrong type for %s | Expected: %s | Found: %s",
				child:GetFullName(),
				expectedClass,
				child.ClassName
			)
		)
	end

	return child
end

local remotesFolder = requireChild(
	ReplicatedStorage,
	"OfflineEarningsRemotes",
	"Folder"
)

local requestData = requireChild(
	remotesFolder,
	"RequestOfflineEarnings",
	"RemoteFunction"
)

local claimNormal = requireChild(
	remotesFolder,
	"ClaimOfflineEarnings",
	"RemoteFunction"
)

local beginPremium = requireChild(
	remotesFolder,
	"BeginPremiumOfflineClaim",
	"RemoteFunction"
)

local premiumResult = requireChild(
	remotesFolder,
	"OfflinePremiumClaimResult",
	"RemoteEvent"
)

print("✅ [OfflineEarningsService] All remotes found. Service started successfully.")

local sessions = {}

local tycoonAdminApi = requireChild(ServerStorage, "TycoonAdminAPI", "BindableFunction")

local function invokeAdmin(action, player, ...)
	local args = table.pack(...)
	local result = table.pack(pcall(function()
		return PlayerTransactionCoordinator.InvokeBindable(
			player,
			tycoonAdminApi,
			action,
			player,
			table.unpack(args, 1, args.n)
		)
	end))
	if not result[1] then
		return false, tostring(result[2])
	end
	return table.unpack(result, 2, result.n)
end

local function getTabletCarry(player)
	return math.max(0, math.floor(tonumber(player:GetAttribute("OfflineTabletCarry")) or 0))
end

local function clearTabletCarry(player)
	player:SetAttribute("OfflineTabletCarry", 0)
	invokeAdmin("MarkDirty", player)
end

local function getPlayerPlot(player)
	local plotName = player:GetAttribute("OccupiedPlot")

	if not plotName then
		return nil
	end

	local tycoons = Workspace:FindFirstChild("Tycoons")

	if not tycoons then
		return nil
	end

	return tycoons:FindFirstChild(plotName)
end

local function rebuildBaseCPS(plot)
	local placedCarsFolder = plot:FindFirstChild("PlacedCars")
	if not placedCarsFolder then
		return 0
	end

	local placedCars = {}
	local bestPlacedBaseCPS = 0

	for _, car in ipairs(placedCarsFolder:GetChildren()) do
		local carId = car:GetAttribute("ToolId") or car.Name
		local stats = CarStats.GetCarStats and CarStats.GetCarStats(carId)
		if stats then
			table.insert(placedCars, stats)
			if not CarStats.IsMythicalCar(stats) then
				bestPlacedBaseCPS = math.max(bestPlacedBaseCPS, tonumber(stats.CPS) or 0)
			end
		end
	end

	local rebuiltCPS = 0
	for _, stats in ipairs(placedCars) do
		rebuiltCPS += CarStats.CalculateEffectiveBaseCPS(stats, bestPlacedBaseCPS)
	end

	return rebuiltCPS
end

local function resolveOfflineIncomeRate(player, plot)
	local savedRate = tonumber(player:GetAttribute("OfflineEarningsRate"))
	if savedRate and savedRate > 0 then
		return savedRate
	end

	-- CurrentCPS is maintained by TycoonEconomy after normal earnings
	-- multipliers are already applied. Use it directly; multiplying it again
	-- by ActualEarningsMultiplier is what caused inflated offline payouts.
	local currentRate = tonumber(plot:GetAttribute("CurrentCPS"))
	if currentRate and currentRate > 0 then
		return currentRate
	end

	-- Legacy fallback for old saves without a stored leave-time rate. Rebuild
	-- base CPS from placed cars, then apply the current normal multiplier once.
	local multiplier = tonumber(player:GetAttribute("ActualEarningsMultiplier")) or 1
	return rebuildBaseCPS(plot) * multiplier
end

local function computeBaseOffline(player)
	local hiddenStats = player:FindFirstChild("HiddenStats")
	local bank = hiddenStats and hiddenStats:FindFirstChild("Cash")
	local plot = getPlayerPlot(player)

	if not plot or not bank then
		return false, 0
	end

	local normalRate = resolveOfflineIncomeRate(player, plot)

	local nowTimestamp = os.time()
	local lastOfflineAt = tonumber(player:GetAttribute("LastOfflineAt")) or 0

	if lastOfflineAt <= 0 or nowTimestamp <= lastOfflineAt then
		return true, 0
	end

	if normalRate <= 0 then
		return true, 0
	end

	local elapsed = math.min(MAX_OFFLINE_SECONDS, nowTimestamp - lastOfflineAt)

	if elapsed <= 0 then
		return true, 0
	end

	local amount = math.max(0, math.floor(normalRate * OFFLINE_RATE * elapsed))
	local tabletCarry = getTabletCarry(player)

	return true, amount + tabletCarry
end

local function ensureSession(player)
	local session = sessions[player]

	if not session then
		session = {
			baseAmount = 0,
			prepared = false,
			claimed = false,
			premiumPending = false,
			premiumIntentId = nil,
			lastPremiumReceiptSerial = 0,
		}
		sessions[player] = session
	end

	local receiptSerial = math.max(0, math.floor(
		tonumber(player:GetAttribute(PREMIUM_RECEIPT_SERIAL_ATTRIBUTE)) or 0
	))
	if receiptSerial > session.lastPremiumReceiptSerial then
		session.lastPremiumReceiptSerial = receiptSerial
		session.baseAmount = 0
		session.prepared = true
		session.claimed = true
		session.premiumPending = false
		session.premiumIntentId = nil
	end

	return session
end

local function grant(player, amount)
	if amount <= 0 then
		return false, "No earnings available."
	end

	local hiddenStats = player:FindFirstChild("HiddenStats")
	local bank = hiddenStats and hiddenStats:FindFirstChild("Cash")

	if not bank then
		return false, "Bank account not found."
	end

	bank.Value += amount

	return true, "Granted"
end

requestData.OnServerInvoke = function(player)
	local session = ensureSession(player)

	if not session.prepared then
		local ready, amount = computeBaseOffline(player)

		if not ready then
			return {
				ready = false,
				amount = 0,
				canClaim = false,
				productId = PREMIUM_PRODUCT_ID,
			}
		end

		session.baseAmount = amount
		session.prepared = true
	end

	return {
		ready = true,
		amount = session.baseAmount,
		canClaim = session.baseAmount > 0 and not session.claimed and not session.premiumPending,
		productId = PREMIUM_PRODUCT_ID,
	}
end

local function prepareSession(player, session)
	if session.prepared then
		return true
	end

	local ready, amount = computeBaseOffline(player)

	if not ready then
		return false
	end

	session.baseAmount = amount
	session.prepared = true

	return true
end

local function claimPreparedSession(player, session)
	-- PlayerTransactionCoordinator already serializes this entire function.
	-- Keeping a second manual claim flag created a permanent in-memory deadlock
	-- whenever an unexpected error occurred before that flag was cleared.
	local bank = nil
	local originalBank = nil
	local originalCarry = nil
	local mutationApplied = false
	local saveCommitted = false

	local result = table.pack(xpcall(function()
		local unresolvedIntent, intentError = PaidActionIntentStore.GetPending(
			player.UserId, PREMIUM_PRODUCT_ID, "Offline10x"
		)
		if unresolvedIntent == nil then
			return false, intentError or "Premium purchase state is unavailable.", 0
		elseif unresolvedIntent then
			session.premiumPending = true
			session.premiumIntentId = unresolvedIntent.IntentId
			return false, "Premium purchase is currently processing.", 0
		elseif session.claimed then
			return false, "You have already claimed your offline earnings.", 0
		elseif session.premiumPending then
			return false, "Premium purchase is currently processing.", 0
		elseif session.baseAmount <= 0 then
			return false, "No offline earnings available.", 0
		end

		local amount = session.baseAmount
		originalCarry = getTabletCarry(player)
		local hiddenStats = player:FindFirstChild("HiddenStats")
		bank = hiddenStats and hiddenStats:FindFirstChild("Cash")
		originalBank = bank and bank.Value or nil

		local granted, grantMessage = grant(player, amount)
		if not granted then
			return false, grantMessage, 0
		end

		mutationApplied = true
		session.claimed = true
		clearTabletCarry(player)

		if invokeAdmin("SaveNow", player) == true then
			saveCommitted = true
			return true, "Claimed", amount
		end

		if bank and originalBank ~= nil then bank.Value = originalBank end
		player:SetAttribute("OfflineTabletCarry", originalCarry)
		session.claimed = false
		mutationApplied = false
		return false, "Offline earnings could not be saved. Please try again.", 0
	end, debug.traceback))

	if not result[1] then
		-- Roll back only an uncommitted live mutation. A committed save must never
		-- be reversed in memory merely because later presentation work failed.
		if mutationApplied and not saveCommitted then
			pcall(function()
				if bank and originalBank ~= nil then bank.Value = originalBank end
				player:SetAttribute("OfflineTabletCarry", originalCarry)
			end)
			session.claimed = false
		end
		warn("[OfflineEarningsService] Claim recovered after an unexpected error: " .. tostring(result[2]))
		return false, "Claim failed safely. Please try again.", 0
	end

	return table.unpack(result, 2, result.n)
end

local function claimOfflineEarnings(player)
	return PlayerTransactionCoordinator.Run(player, "OfflineEarningsClaim", function()
		local session = ensureSession(player)
		if not prepareSession(player, session) then
			return false, "Offline earnings still loading. Please try again.", 0
		end
		return claimPreparedSession(player, session)
	end)
end

claimNormal.OnServerInvoke = function(player)
	return claimOfflineEarnings(player)
end

beginPremium.OnServerInvoke = function(player, requestAction, requestIntentId)
	if requestAction == "Cancel" then
		return PlayerTransactionCoordinator.Run(player, "CancelOffline10x", function()
			local session = ensureSession(player)
			if type(requestIntentId) ~= "string" or requestIntentId == ""
				or session.premiumIntentId ~= requestIntentId
			then
				return false, "Premium purchase state changed."
			end

			local cancelRequested = false
			for attempt = 1, 3 do
				cancelRequested = PaidActionIntentStore.Cancel(
					player, PREMIUM_PRODUCT_ID, requestIntentId
				)
				if cancelRequested then break end
				if attempt < 3 then task.wait(0.2 * attempt) end
			end

			if not cancelRequested then
				return false, "Premium purchase cancellation is still processing."
			end

			local remaining, pendingError = PaidActionIntentStore.GetPending(
				player.UserId, PREMIUM_PRODUCT_ID, "Offline10x"
			)
			if remaining == nil then
				return false, pendingError or "Premium purchase state is unavailable."
			end
			if remaining then
				return false, "Premium purchase is already processing."
			end

			session.premiumPending = false
			session.premiumIntentId = nil
			return true, "Cancelled"
		end)
	elseif requestAction ~= nil then
		return false, "Invalid premium claim request."
	end

	return PlayerTransactionCoordinator.Run(player, "PrepareOffline10x", function()
		local session = ensureSession(player)
		if not prepareSession(player, session) then
			return false, "Offline earnings still loading. Please wait."
		end
		if session.claimed then return false, "You have already claimed your offline earnings." end

		local unresolvedIntent, intentError = PaidActionIntentStore.GetPending(
			player.UserId, PREMIUM_PRODUCT_ID, "Offline10x"
		)
		if unresolvedIntent == nil then return false, intentError or "Purchase state unavailable." end
		if unresolvedIntent then
			session.premiumPending = true
			session.premiumIntentId = unresolvedIntent.IntentId
			return false, "Premium purchase already in progress."
		end
		if session.premiumPending then return false, "Premium purchase already in progress." end
		if session.baseAmount <= 0 then return false, "No offline earnings available." end

		local intentOk, intentId = PaidActionIntentStore.Create(player, PREMIUM_PRODUCT_ID, "Offline10x", {
			Amount = session.baseAmount * 10,
			BaseAmount = session.baseAmount,
			OfflineTabletCarry = getTabletCarry(player),
		})
		if not intentOk then
			return false, intentId or "Unable to prepare purchase."
		end
		session.premiumPending = true
		session.premiumIntentId = intentId
		return true, "Prompt", intentId
	end)
end

MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
	if productId ~= PREMIUM_PRODUCT_ID then
		return
	end

	local player = Players:GetPlayerByUserId(userId)

	if not player then
		return
	end

	local session = sessions[player]

	if not session then
		return
	end

	if not wasPurchased then
		if session.premiumIntentId then
			PaidActionIntentStore.Cancel(player, PREMIUM_PRODUCT_ID, session.premiumIntentId)
		end
		session.premiumPending = false
		session.premiumIntentId = nil

		premiumResult:FireClient(player, false, "Purchase failed or cancelled.", 0)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	sessions[player] = nil
end)
