-- Purpose: Computes and grants Offline Earnings with one-time claim enforcement and premium 10x support.
-- Runs on: Server
-- Location: ServerScriptService > OfflineEarningsService
-- Required hierarchy:
-- ReplicatedStorage
-- └── OfflineEarningsRemotes
--     ├── RequestOfflineEarnings          RemoteFunction
--     ├── ClaimOfflineEarnings            RemoteFunction
--     ├── BeginPremiumOfflineClaim        RemoteFunction
--     └── OfflinePremiumClaimResult       RemoteEvent

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Workspace = game:GetService("Workspace")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))
local GlobalMoneyFrenzyConfig = require(ReplicatedStorage:WaitForChild("GlobalMoneyFrenzyConfig"))
local GlobalMoneyFrenzyService = require(ServerScriptService:WaitForChild("GlobalMoneyFrenzyService"))

local OFFLINE_RATE = 0.30
local MAX_OFFLINE_SECONDS = 60 * 60
local OFFLINE_RATE_VERSION = 2
local PREMIUM_PRODUCT_ID = 3598967453
local PREMIUM_PROMPT_COOLDOWN_SECONDS = 3

local function requireChild(parent, childName, expectedClass)
	local child = parent:FindFirstChild(childName)

	if not child then
		error(
			string.format(
				"[OfflineEarningsService] Missing required object: %s.%s | Expected type: %s",
				parent:GetFullName(),
				childName,
				expectedClass
			)
		)
	end

	if not child:IsA(expectedClass) then
		error(
			string.format(
				"[OfflineEarningsService] Wrong type for %s | Expected: %s | Found: %s",
				child:GetFullName(),
				expectedClass,
				child.ClassName
			)
		)
	end

	return child
end

local remotesFolder = requireChild(
	ReplicatedStorage,
	"OfflineEarningsRemotes",
	"Folder"
)

local requestData = requireChild(
	remotesFolder,
	"RequestOfflineEarnings",
	"RemoteFunction"
)

local claimNormal = requireChild(
	remotesFolder,
	"ClaimOfflineEarnings",
	"RemoteFunction"
)

local beginPremium = requireChild(
	remotesFolder,
	"BeginPremiumOfflineClaim",
	"RemoteFunction"
)

local premiumResult = requireChild(
	remotesFolder,
	"OfflinePremiumClaimResult",
	"RemoteEvent"
)

print("✅ [OfflineEarningsService] All remotes found. Service started successfully.")

_G.OfflineEarningsService = _G.OfflineEarningsService or {}

local sessions = {}

local tycoonAdminApi = ServerStorage:FindFirstChild("TycoonAdminAPI")

local function getAdminApi()
	if tycoonAdminApi and tycoonAdminApi.Parent and tycoonAdminApi:IsA("BindableFunction") then
		return tycoonAdminApi
	end
	tycoonAdminApi = ServerStorage:FindFirstChild("TycoonAdminAPI")
	return tycoonAdminApi
end

local function forceSave(player)
	local admin = getAdminApi()
	if not admin or not admin:IsA("BindableFunction") then return false end
	local ok, saved = pcall(function() return admin:Invoke("SaveNow", player) end)
	return ok and saved == true
end

local function getTabletCarry(player)
	return math.max(0, math.floor(tonumber(player:GetAttribute("OfflineTabletCarry")) or 0))
end

local function clearTabletCarry(player)
	player:SetAttribute("OfflineTabletCarry", 0)
	local admin = getAdminApi()
	if admin and admin:IsA("BindableFunction") then
		pcall(function() admin:Invoke("MarkDirty", player) end)
	end
end

local function getPlayerPlot(player)
	local plotName = player:GetAttribute("OccupiedPlot")

	if not plotName then
		return nil
	end

	local tycoons = Workspace:FindFirstChild("Tycoons")

	if not tycoons then
		return nil
	end

	return tycoons:FindFirstChild(plotName)
end

local function rebuildBaseCPS(plot)
	local placedCarsFolder = plot:FindFirstChild("PlacedCars")
	if not placedCarsFolder then
		return 0
	end

	local placedCars = {}
	local bestPlacedBaseCPS = 0

	for _, car in ipairs(placedCarsFolder:GetChildren()) do
		local stats = CarStats.GetCarStats and CarStats.GetCarStats(car.Name)
		if stats then
			table.insert(placedCars, stats)
			if not CarStats.IsMythicalCar(stats) then
				bestPlacedBaseCPS = math.max(bestPlacedBaseCPS, tonumber(stats.CPS) or 0)
			end
		end
	end

	local rebuiltCPS = 0
	for _, stats in ipairs(placedCars) do
		rebuiltCPS += CarStats.CalculateEffectiveBaseCPS(stats, bestPlacedBaseCPS)
	end

	return rebuiltCPS
end

local function resolveOfflineIncomeRate(player, plot)
	local savedRate = tonumber(player:GetAttribute("OfflineEarningsRate"))
	local savedRateVersion = math.floor(tonumber(player:GetAttribute("OfflineEarningsRateVersion")) or 0)
	if savedRateVersion >= OFFLINE_RATE_VERSION and savedRate and savedRate > 0 then
		return savedRate
	end

	-- A versioned plot rate excludes Global Money Frenzy. Prefer it when an old
	-- profile has a legacy saved CurrentCPS snapshot that may include Frenzy.
	local currentRate = tonumber(plot:GetAttribute("OfflineEarningsCPS"))
	if currentRate and currentRate > 0 then
		return currentRate
	end

	-- Legacy migration fallback: rebuild the garage and apply permanent bonuses
	-- only. Dividing by the live Frenzy removes it from older multiplier state.
	local multiplier = tonumber(player:GetAttribute("PermanentEarningsMultiplier"))
	if not multiplier or multiplier <= 0 then
		local actualMultiplier = tonumber(player:GetAttribute("ActualEarningsMultiplier")) or 1
		multiplier = actualMultiplier / math.max(1, GlobalMoneyFrenzyService.GetMultiplier())
	end
	return rebuildBaseCPS(plot) * multiplier
end

local function computeBaseOffline(player)
	local leaderstats = player:FindFirstChild("leaderstats")
	local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")
	local plot = getPlayerPlot(player)

	if not plot or not wallet then
		return false, 0
	end

	local normalRate = resolveOfflineIncomeRate(player, plot)

	local nowTimestamp = os.time()
	local lastOfflineAt = tonumber(player:GetAttribute("LastOfflineAt")) or 0

	if lastOfflineAt <= 0 or nowTimestamp <= lastOfflineAt then
		return true, 0
	end

	if normalRate <= 0 then
		return true, 0
	end

	local elapsed = math.min(MAX_OFFLINE_SECONDS, nowTimestamp - lastOfflineAt)

	if elapsed <= 0 then
		return true, 0
	end

	local maxFrenzyMultiplier = GlobalMoneyFrenzyConfig.StackConfig.MaxMultiplier or 5
	local frenzyMultiplier = math.clamp(tonumber(player:GetAttribute("OfflineFrenzyMultiplier")) or 1, 1, maxFrenzyMultiplier)
	local frenzyExpiresAt = math.max(0, math.floor(tonumber(player:GetAttribute("OfflineFrenzyExpiresAt")) or 0))
	local frenzySeconds = math.clamp(frenzyExpiresAt - lastOfflineAt, 0, elapsed)
	local normalSeconds = elapsed - frenzySeconds
	local effectiveSeconds = normalSeconds + (frenzySeconds * frenzyMultiplier)
	local amount = math.max(0, math.floor(normalRate * OFFLINE_RATE * effectiveSeconds))
	local tabletCarry = getTabletCarry(player)

	return true, amount + tabletCarry
end

local function ensureSession(player)
	local session = sessions[player]

	if session then
		return session
	end

	local persistedPremiumAmount = math.max(0, math.floor(tonumber(player:GetAttribute("OfflinePremiumPendingAmount")) or 0))
	session = {
		baseAmount = persistedPremiumAmount,
		prepared = persistedPremiumAmount > 0,
		claimed = false,
		premiumPending = persistedPremiumAmount > 0,
		premiumPurchaseId = nil,
		lastPremiumGrantedPurchaseId = nil,
		claimInProgress = false,
		lastPremiumPromptAt = 0,
		premiumPurchaseSubmitted = false,
	}

	sessions[player] = session

	return session
end

local function grant(player, amount)
	if amount <= 0 then
		return false, "No earnings available."
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")

	if not wallet then
		return false, "Wallet not found."
	end

	wallet.Value += amount

	return true, "Granted"
end

requestData.OnServerInvoke = function(player)
	local session = ensureSession(player)

	if not session.prepared then
		local ready, amount = computeBaseOffline(player)

		if not ready then
			return {
				ready = false,
				amount = 0,
				canClaim = false,
				productId = PREMIUM_PRODUCT_ID,
			}
		end

		session.baseAmount = amount
		session.prepared = true
	end

	return {
		ready = true,
		amount = session.baseAmount,
		canClaim = session.baseAmount > 0 and not session.claimed and not session.premiumPending,
		productId = PREMIUM_PRODUCT_ID,
	}
end

local function prepareSession(player, session)
	if session.prepared then
		return true
	end

	local ready, amount = computeBaseOffline(player)

	if not ready then
		return false
	end

	session.baseAmount = amount
	session.prepared = true

	return true
end

local function claimPreparedSession(player, session)
	if session.claimInProgress then
		return false, "Claim already in progress.", 0
	end

	session.claimInProgress = true

	local success, message, amount = false, "Claim failed. Please try again.", 0

	if session.claimed then
		message = "You have already claimed your offline earnings."
	elseif session.premiumPending then
		message = "Premium purchase is currently processing."
	elseif session.baseAmount <= 0 then
		message = "No offline earnings available."
	else
		amount = session.baseAmount
		success, message = grant(player, amount)

		if success then
			local leaderstats = player:FindFirstChild("leaderstats")
			local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")
			local originalWallet = wallet and (wallet.Value - amount) or nil
			local originalCarry = getTabletCarry(player)
			session.claimed = true
			clearTabletCarry(player)
			if forceSave(player) then
				message = "Claimed"
			else
				if wallet and originalWallet ~= nil then wallet.Value = originalWallet end
				player:SetAttribute("OfflineTabletCarry", originalCarry)
				session.claimed = false
				success = false
				amount = 0
				message = "Could not save your claim. Please try again."
			end
		else
			amount = 0
		end
	end

	session.claimInProgress = false

	return success, message, amount
end

local function claimOfflineEarnings(player)
	local session = ensureSession(player)

	if not prepareSession(player, session) then
		return false, "Offline earnings still loading. Please try again.", 0
	end

	return claimPreparedSession(player, session)
end

claimNormal.OnServerInvoke = function(player)
	return claimOfflineEarnings(player)
end

function _G.OfflineEarningsService.TryClaim(player)
	return claimOfflineEarnings(player)
end

beginPremium.OnServerInvoke = function(player)
	local session = ensureSession(player)
	local promptNow = os.clock()

	if session.claimInProgress then
		return false, "Claim already in progress."
	end

	if session.premiumPurchaseSubmitted then
		return false, "Premium purchase is currently processing."
	end

	if promptNow - (session.lastPremiumPromptAt or 0) < PREMIUM_PROMPT_COOLDOWN_SECONDS then
		return false, "Please wait before trying again."
	end

	if not prepareSession(player, session) then
		return false, "Offline earnings still loading. Please wait."
	end

	if session.claimed then
		return false, "You have already claimed your offline earnings."
	end

	if session.premiumPending then
		session.lastPremiumPromptAt = promptNow
		return true, "Prompt"
	end

	if session.baseAmount <= 0 then
		return false, "No offline earnings available."
	end

	session.claimInProgress = true
	local originalCarry = getTabletCarry(player)
	player:SetAttribute("OfflinePremiumPendingAmount", session.baseAmount)
	clearTabletCarry(player)
	session.premiumPending = true
	session.premiumPurchaseId = nil
	if not forceSave(player) then
		player:SetAttribute("OfflinePremiumPendingAmount", 0)
		player:SetAttribute("OfflineTabletCarry", originalCarry)
		session.premiumPending = false
		session.claimInProgress = false
		return false, "Could not reserve your earnings. Please try again."
	end

	session.claimInProgress = false
	session.lastPremiumPromptAt = promptNow
	return true, "Prompt"
end

function _G.OfflineEarningsService.TryGrantPremium(player, purchaseId)
	local session = ensureSession(player)

	if purchaseId and session.lastPremiumGrantedPurchaseId == purchaseId then
		return true, session.baseAmount * 10, "Claimed"
	end

	local reservedAmount = math.max(0, math.floor(tonumber(player:GetAttribute("OfflinePremiumPendingAmount")) or 0))
	if not session.premiumPending or session.claimed or reservedAmount <= 0 then
		return false, 0, "No reserved offline earnings were found."
	end

	if purchaseId and session.premiumPurchaseId and session.premiumPurchaseId ~= purchaseId then
		return false, 0, "Purchase mismatch."
	end

	local payout = reservedAmount * 10
	local success, message = grant(player, payout)

	if not success then
		return false, 0, message
	end

	session.claimed = true
	clearTabletCarry(player)
	player:SetAttribute("OfflinePremiumPendingAmount", 0)
	session.premiumPending = false
	session.premiumPurchaseId = purchaseId
	session.lastPremiumGrantedPurchaseId = purchaseId
	session.premiumPurchaseSubmitted = false

	return true, payout, "Claimed"
end

MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
	if productId ~= PREMIUM_PRODUCT_ID then
		return
	end

	local player = Players:GetPlayerByUserId(userId)

	if not player then
		return
	end

	local session = sessions[player]

	if not session then
		return
	end

	if wasPurchased then
		session.premiumPurchaseSubmitted = true
		return
	end

	session.claimInProgress = true
	local reservedAmount = math.max(0, math.floor(tonumber(player:GetAttribute("OfflinePremiumPendingAmount")) or 0))
	if reservedAmount > 0 then
		player:SetAttribute("OfflineTabletCarry", getTabletCarry(player) + reservedAmount)
		player:SetAttribute("OfflinePremiumPendingAmount", 0)
		forceSave(player)
	end
	session.premiumPending = false
	session.premiumPurchaseId = nil
	session.premiumPurchaseSubmitted = false
	session.lastPremiumPromptAt = 0
	session.claimInProgress = false

	premiumResult:FireClient(player, false, "Purchase failed or cancelled.", 0)
end)

Players.PlayerRemoving:Connect(function(player)
	sessions[player] = nil
end)
