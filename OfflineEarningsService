print("✅ [OfflineEarningsService] All remotes found. Service started successfully.")

_G.OfflineEarningsService = _G.OfflineEarningsService or {}

local sessions = {}
local arrivedAt = {}

local tycoonAdminApi = ServerStorage:FindFirstChild("TycoonAdminAPI")

local function getAdminApi()
	if tycoonAdminApi and tycoonAdminApi.Parent and tycoonAdminApi:IsA("BindableFunction") then
		return tycoonAdminApi
	end
	tycoonAdminApi = ServerStorage:FindFirstChild("TycoonAdminAPI")
	return tycoonAdminApi
end

local function forceSave(player)
	local admin = getAdminApi()
	if not admin or not admin:IsA("BindableFunction") then return false end
	local ok, saved = pcall(function() return admin:Invoke("SaveNow", player) end)
	return ok and saved == true
end

local function getTabletCarry(player)
	return math.max(0, math.floor(tonumber(player:GetAttribute("OfflineTabletCarry")) or 0))
end

local function clearTabletCarry(player)
	player:SetAttribute("OfflineTabletCarry", 0)
	local admin = getAdminApi()
	if admin and admin:IsA("BindableFunction") then
		pcall(function() admin:Invoke("MarkDirty", player) end)
	end
end

local function getPlayerPlot(player)
	local plotName = player:GetAttribute("OccupiedPlot")

	if not plotName then
		return nil
	end

	local tycoons = Workspace:FindFirstChild("Tycoons")

	if not tycoons then
		return nil
	end

	return tycoons:FindFirstChild(plotName)
end

local function rebuildBaseCPS(plot)
	local placedCarsFolder = plot:FindFirstChild("PlacedCars")
	if not placedCarsFolder then
		return 0
	end

	local placedCars = {}
	local bestPlacedBaseCPS = 0

	for _, car in ipairs(placedCarsFolder:GetChildren()) do
		local stats = CarStats.GetCarStats and CarStats.GetCarStats(car:GetAttribute("BaseCarId") or car.Name)
		if stats then
			table.insert(placedCars, stats)
			if not CarStats.IsMythicalCar(stats) then
				bestPlacedBaseCPS = math.max(bestPlacedBaseCPS, tonumber(stats.CPS) or 0)
			end
		end
	end

	local rebuiltCPS = 0
	for _, stats in ipairs(placedCars) do
		rebuiltCPS += CarStats.CalculateEffectiveBaseCPS(stats, bestPlacedBaseCPS)
	end

	return rebuiltCPS
end

local function resolveOfflineIncomeRate(player, plot)
	local savedRate = tonumber(player:GetAttribute("OfflineEarningsRate"))
	local savedRateVersion = math.floor(tonumber(player:GetAttribute("OfflineEarningsRateVersion")) or 0)
	if savedRateVersion >= OFFLINE_RATE_VERSION and savedRate and savedRate > 0 then
		return savedRate
	end

	-- A versioned plot rate excludes Global Money Frenzy. Prefer it when an old
	-- profile has a legacy saved CurrentCPS snapshot that may include Frenzy.
	local currentRate = tonumber(plot:GetAttribute("OfflineEarningsCPS"))
	if currentRate and currentRate > 0 then
		return currentRate
	end

	-- Legacy migration fallback: rebuild the garage and apply permanent bonuses
	-- only. Dividing by the live Frenzy removes it from older multiplier state.
	local multiplier = tonumber(player:GetAttribute("PermanentEarningsMultiplier"))
	if not multiplier or multiplier <= 0 then
		local actualMultiplier = tonumber(player:GetAttribute("ActualEarningsMultiplier")) or 1
		multiplier = actualMultiplier / math.max(1, GlobalMoneyFrenzyService.GetMultiplier())
	end
	return rebuildBaseCPS(plot) * multiplier
end

local function computeBaseOffline(player)
	-- Never freeze a session amount before authoritative Marketplace/gift ownership
	-- has loaded; RequestOfflineEarnings will report not-ready and may be retried.
	if player:GetAttribute("GamePassOwnershipReady") ~= true then
		return false, 0
	end
	local leaderstats = player:FindFirstChild("leaderstats")
	local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")
	local plot = getPlayerPlot(player)

	if not plot or not wallet then
		return false, 0
	end

	local normalRate = resolveOfflineIncomeRate(player, plot)

	local nowTimestamp = arrivedAt[player] or os.time()
	local lastOfflineAt = tonumber(player:GetAttribute("LastOfflineAt")) or 0

	if lastOfflineAt <= 0 or nowTimestamp <= lastOfflineAt then
		return true, 0
	end

	if normalRate <= 0 then
		return true, 0
	end

	local elapsed = math.min(MAX_OFFLINE_SECONDS, nowTimestamp - lastOfflineAt)

	if elapsed <= 0 then
		return true, 0
	end

	local maxFrenzyMultiplier = GlobalMoneyFrenzyConfig.StackConfig.MaxMultiplier or 5
	local frenzyMultiplier = math.clamp(tonumber(player:GetAttribute("OfflineFrenzyMultiplier")) or 1, 1, maxFrenzyMultiplier)
	local frenzyExpiresAt = math.max(0, math.floor(tonumber(player:GetAttribute("OfflineFrenzyExpiresAt")) or 0))
	local frenzySeconds = math.clamp(frenzyExpiresAt - lastOfflineAt, 0, elapsed)
	local normalSeconds = elapsed - frenzySeconds
	local effectiveSeconds = normalSeconds + (frenzySeconds * frenzyMultiplier)
	-- The cap and frenzy split are resolved first; the server-published entitlement
	-- is then applied once to the final normal award (never to tablet carry).
	local amount = math.max(0, math.floor(normalRate * OFFLINE_RATE * effectiveSeconds))
	amount = math.floor(amount * GamePassConfig.GetOfflineEarningsMultiplier(player))
	local tabletCarry = getTabletCarry(player)

	return true, amount + tabletCarry
end

local function isReady(player)
	return player and player.Parent == Players
		and player:GetAttribute("TycoonDataLoaded") == true
		and player:GetAttribute("TycoonDataClosing") ~= true
end

local function syncSession(player, session)
	player:SetAttribute("OfflineClaimId", session.id or "")
	player:SetAttribute("OfflineClaimAmount", session.baseAmount or 0)
	player:SetAttribute("OfflineClaimState", session.state or "")
	player:SetAttribute("OfflineClaimPurchaseId", session.premiumPurchaseId or "")
	player:SetAttribute("OfflinePremiumPendingAmount", session.state == "Premium" and session.baseAmount or 0)
	local admin = getAdminApi()
	if admin and admin:IsA("BindableFunction") then
		pcall(function() admin:Invoke("MarkDirty", player) end)
	end
end

local function ensureSession(player)
	local session = sessions[player]
	if session then return session end
	local state = player:GetAttribute("OfflineClaimState")
	local id = player:GetAttribute("OfflineClaimId")
	local validPending = (state == "Pending" or state == "Premium")
		and type(id) == "string" and id ~= "" and #id <= 200
	local legacyPremium = math.max(0, math.floor(tonumber(player:GetAttribute("OfflinePremiumPendingAmount")) or 0))
	local purchaseId = player:GetAttribute("OfflineClaimPurchaseId")
	session = {
		id = validPending and id or nil,
		baseAmount = validPending and math.max(0, math.floor(tonumber(player:GetAttribute("OfflineClaimAmount")) or 0)) or legacyPremium,
		state = validPending and state or (legacyPremium > 0 and "Premium" or nil),
		prepared = validPending or legacyPremium > 0,
		freezeSaved = validPending,
		recoveryChecked = false,
		claimed = false,
		premiumPurchaseId = validPending and type(purchaseId) == "string" and purchaseId ~= "" and purchaseId or nil,
		claimInProgress = false,
		lastPremiumPromptAt = -math.huge,
		lastClaimAttemptAt = -math.huge,
		premiumPurchaseSubmitted = validPending and type(purchaseId) == "string" and purchaseId ~= "" or false,
	}
	sessions[player] = session
	return session
end

local function deliverToInbox(player, transactionId, amount, source)
	return InboxService.Enqueue(player.UserId, transactionId, {
		RewardType = "Wallet", RewardId = "Wallet", Amount = amount,
		DisplayName = ("$%d Wallet Cash"):format(amount),
		SourceType = "System", Source = source or "Offline Earnings",
	})
end

local function markConsumed(player, session)
	session.state = "Consumed"
	session.claimed = true
	session.premiumPurchaseSubmitted = false
	syncSession(player, session)
	-- Inbox delivery is durable. Keep consumed state on an uncertain save.
	if not forceSave(player) then
		local admin = getAdminApi()
		if admin then pcall(function() admin:Invoke("QueueSaveSoon", player, 2) end) end
	end
end

local function prepareSession(player, session)
	if not isReady(player) then return false, "Your data is still loading." end
	if session.claimed then return true end
	if not session.prepared then
		-- Keep recovery evidence until ReceiptRouter saves its profile marker.
		local previousPurchaseId = player:GetAttribute("OfflineClaimPurchaseId")
		if player:GetAttribute("OfflineClaimState") == "Consumed"
			and type(previousPurchaseId) == "string" and previousPurchaseId ~= "" then
			local admin = getAdminApi()
			local ok, settled = pcall(function()
				return admin and admin:Invoke("HasReceiptGrant", player, previousPurchaseId)
			end)
			if not ok or settled ~= true then return false, "Your purchase is still processing." end
		end
		local ready, amount = computeBaseOffline(player)
		if not ready then return false, "Offline earnings are still loading." end
		session.baseAmount = amount
		session.state = "Pending"
		session.prepared = true
		if amount <= 0 then
			session.state = "Consumed"
			session.claimed = true
			session.freezeSaved = true
			session.premiumPurchaseId = nil
			syncSession(player, session)
			return true
		end
	end
	if not session.id then
		session.id = "Offline:" .. tostring(player.UserId) .. ":" .. HttpService:GenerateGUID(false)
		-- Frozen amount and carry removal commit before any Inbox delivery.
		if session.state == "Pending" then clearTabletCarry(player) end
		syncSession(player, session)
	end
	if not session.freezeSaved then
		if not forceSave(player) then return false, "Could not save your earnings. Please try again." end
		session.freezeSaved = true
	end
	if not isReady(player) then return false, "Your session is closing." end
	if not session.recoveryChecked then
		local issued, err = InboxService.HasIssued(player.UserId, session.id)
		if issued == nil then return false, err or "Inbox is temporarily unavailable." end
		session.recoveryChecked = true
		if issued then markConsumed(player, session) end
	end
	return true
end

local function readState(player)
	if not isReady(player) then
		return {ready=false, amount=0, canClaim=false, productId=PREMIUM_PRODUCT_ID}
	end
	local session = ensureSession(player)
	if session.claimInProgress then
		return {ready=session.freezeSaved, amount=session.baseAmount, canClaim=false, productId=PREMIUM_PRODUCT_ID}
	end
	session.claimInProgress = true
	local ready = prepareSession(player, session)
	session.claimInProgress = false
	return {
		ready = ready == true,
		amount = ready and session.baseAmount or 0,
		canClaim = ready and session.baseAmount > 0 and not session.claimed and session.state == "Pending",
		productId = PREMIUM_PRODUCT_ID,
	}
end

requestData.OnServerInvoke = readState

local function claimOfflineEarnings(player)
	if not isReady(player) then return false, "Your data is still loading.", 0 end
	local session = ensureSession(player)
	if session.claimInProgress then return false, "Claim already in progress.", 0 end
	if os.clock() - session.lastClaimAttemptAt < 1 then return false, "Please wait before trying again.", 0 end
	session.lastClaimAttemptAt = os.clock()
	session.claimInProgress = true
	local ready, message = prepareSession(player, session)
	if not ready then session.claimInProgress=false; return false, message, 0 end
	if session.claimed or session.state ~= "Pending" or session.baseAmount <= 0 then
		session.claimInProgress = false
		return false, session.state == "Premium" and "Premium purchase is processing." or "No offline earnings available.", 0
	end
	local amount = session.baseAmount
	local success, deliveryMessage = deliverToInbox(player, session.id, amount, "Offline Earnings")
	if success then markConsumed(player, session) end
	session.claimInProgress = false
	return success, success and "Claimed" or deliveryMessage, success and amount or 0
end

claimNormal.OnServerInvoke = claimOfflineEarnings
_G.OfflineEarningsService.TryClaim = claimOfflineEarnings

beginPremium.OnServerInvoke = function(player)
	if not isReady(player) then return false, "Your data is still loading." end
	local session = ensureSession(player)
	if session.claimInProgress then return false, "Claim already in progress." end
	if session.premiumPromptActive or session.premiumPurchaseSubmitted or session.premiumPurchaseId then return false, "Premium purchase is processing." end
	local promptNow = os.clock()
	if promptNow - session.lastPremiumPromptAt < PREMIUM_PROMPT_COOLDOWN_SECONDS then return false, "Please wait before trying again." end
	session.claimInProgress = true
	local ready, message = prepareSession(player, session)
	if not ready or session.claimed or session.baseAmount <= 0 then
		session.claimInProgress=false; return false, message or "No offline earnings available."
	end
	local issued, err = InboxService.HasIssued(player.UserId, session.id)
	if issued == nil then session.claimInProgress=false; return false, err or "Inbox is temporarily unavailable." end
	if issued then
		markConsumed(player, session)
		session.claimInProgress=false
		return false, "Your offline earnings are already in your Inbox."
	end
	session.state = "Premium"
	session.freezeSaved = false
	syncSession(player, session)
	if not forceSave(player) then
		session.claimInProgress=false
		return false, "Could not save your reservation. Please try again."
	end
	session.freezeSaved = true
	if not isReady(player) then session.claimInProgress=false; return false, "Your session is closing." end
	session.lastPremiumPromptAt = promptNow
	session.premiumPromptActive = true
	session.claimInProgress = false
	return true, "Prompt"
end

function _G.OfflineEarningsService.TryGrantPremium(player, purchaseId)
	if not isReady(player) then return false, 0, "Your data is still loading." end
	purchaseId = tostring(purchaseId or "")
	if purchaseId == "" or #purchaseId > 200 then return false, 0, "Invalid purchase." end
	if player:GetAttribute("OfflineClaimState") == "Consumed"
		and player:GetAttribute("OfflineClaimPurchaseId") == purchaseId then
		return true, math.max(0, tonumber(player:GetAttribute("OfflineClaimAmount")) or 0)*10, "Claimed"
	end
	local session = ensureSession(player)
	if session.claimInProgress then return false, 0, "Claim already in progress." end
	if session.state ~= "Premium" or session.baseAmount <= 0 then return false, 0, "No reserved offline earnings were found." end
	if session.premiumPurchaseId and session.premiumPurchaseId ~= purchaseId then return false, 0, "Purchase mismatch." end
	session.claimInProgress = true
	if not session.id then session.id="Offline:" .. tostring(player.UserId) .. ":" .. HttpService:GenerateGUID(false) end
	session.premiumPurchaseId = purchaseId
	session.premiumPurchaseSubmitted = true
	syncSession(player, session)
	if not forceSave(player) then session.claimInProgress=false; return false, 0, "Your purchase is still saving." end
	session.freezeSaved = true
	if not isReady(player) then session.claimInProgress=false; return false, 0, "Your session is closing." end
	local payout = session.baseAmount*10
	-- Recover delivery from the previous receipt-based premium implementation.
	local legacyIssued, lookupError = InboxService.HasIssued(player.UserId, "Receipt:" .. purchaseId .. ":OfflinePremium")
	if legacyIssued == nil then session.claimInProgress=false; return false, 0, lookupError end
	if legacyIssued then
		markConsumed(player, session)
		session.claimInProgress=false
		return true, payout, "Claimed"
	end
	local success, message = deliverToInbox(player, session.id, payout, "10x Offline Earnings")
	if success then markConsumed(player, session) end
	session.claimInProgress = false
	return success, success and payout or 0, success and "Claimed" or message
end

MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
	if productId ~= PREMIUM_PRODUCT_ID then return end
	local player = Players:GetPlayerByUserId(userId)
	local session = player and sessions[player]
	if not session or not isReady(player) then return end
	if wasPurchased then
		if session.state == "Premium" then session.premiumPurchaseSubmitted=true end
		return
	end
	if not session.premiumPromptActive or session.premiumPurchaseSubmitted
		or session.premiumPurchaseId or session.state ~= "Premium" then return end
	session.premiumPromptActive = false
	if session.claimInProgress then return end
	session.claimInProgress = true
	session.state = "Pending"
	session.freezeSaved = false
	session.lastPremiumPromptAt = 0
	syncSession(player, session)
	-- Release to the same frozen award, without adding it to carry again.
	session.freezeSaved = forceSave(player)
	session.claimInProgress = false
	premiumResult:FireClient(player, false, "Purchase failed or cancelled.", 0)
end)

local function warmPlayer(player)
	arrivedAt[player] = arrivedAt[player] or os.time()
	task.spawn(function()
		while player.Parent == Players and player:GetAttribute("TycoonDataClosing") ~= true do
			if isReady(player) then
				local state = readState(player)
				if state.ready then return end
			end
			task.wait(3)
		end
	end)
end
Players.PlayerAdded:Connect(warmPlayer)
for _, player in ipairs(Players:GetPlayers()) do warmPlayer(player) end
Players.PlayerRemoving:Connect(function(player)
	sessions[player] = nil
	arrivedAt[player] = nil
end)
