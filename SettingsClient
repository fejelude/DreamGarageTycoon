		persistSetting("CarAnimationEnabled", isEnabled)
	end
end

-- ─────────────────────────────────────────────────────────────
-- REAL-TIME SHADOWS TOGGLE
-- ─────────────────────────────────────────────────────────────
local shadowsEverDisabled = false
local shadowsTaskToken = 0

local function enforcePartShadowState(part, shadowsEnabled)
	if part:GetAttribute(ORIGINAL_SHADOW_ATTR) == nil then
		part:SetAttribute(ORIGINAL_SHADOW_ATTR, part.CastShadow)
	end

	if shadowsEnabled then
		local original = part:GetAttribute(ORIGINAL_SHADOW_ATTR)
		if type(original) == "boolean" then
			part.CastShadow = original
		end
	else
		part.CastShadow = false
	end
end

local function applyRealTimeShadowsProgressive(isEnabled, token)
	if isEnabled and not shadowsEverDisabled then return end

	shadowsEverDisabled = true

	local descendants = workspace:GetDescendants()

	for i, descendant in ipairs(descendants) do
		if shadowsTaskToken ~= token then return end

		if descendant:IsA("BasePart") then
			enforcePartShadowState(descendant, isEnabled)
		end

		if i % 50 == 0 then
			task.wait()
		end
	end
end

workspace.DescendantAdded:Connect(function(descendant)
	if not descendant:IsA("BasePart") then return end

	if workspace:GetAttribute("RealTimeShadowsEnabled") == false then
		enforcePartShadowState(descendant, false)
	end
end)

local function setRealTimeShadowsEnabled(isEnabled, shouldPersist)
	setCurrentStateButtonVisibility(btnRealTimeShadowsOn, btnRealTimeShadowsOff, isEnabled)

	workspace:SetAttribute("RealTimeShadowsEnabled", isEnabled)

	if shouldPersist ~= false then
		persistSetting("RealTimeShadowsEnabled", isEnabled)
	end

	shadowsTaskToken += 1
	local token = shadowsTaskToken

	task.spawn(applyRealTimeShadowsProgressive, isEnabled, token)
end

-- ─────────────────────────────────────────────────────────────
-- POTATO MODE TOGGLE
--
-- Potato Mode ON:
--   Hide objects inside Workspace.PotatoModeRemoval.
--
-- Potato Mode OFF:
--   Restore objects back into Workspace.PotatoModeRemoval.
--   Do not hide anything.
-- ─────────────────────────────────────────────────────────────
local potatoTaskToken = 0

local function progressiveMoveChildren(source, target, token)
	if not source or not target then return end

	local children = source:GetChildren()

	for i, child in ipairs(children) do
		if potatoTaskToken ~= token then return end

		child.Parent = target

		if i % 10 == 0 then
			task.wait()
		end
	end
end

local function setPotatoModeEnabled(isEnabled, shouldPersist)
	isEnabled = isEnabled == true

	setCurrentStateButtonVisibility(btnPotatoModeOn, btnPotatoModeOff, isEnabled)

	workspace:SetAttribute("PotatoModeEnabled", isEnabled)

	if shouldPersist ~= false then
		persistSetting("PotatoModeEnabled", isEnabled)
	end

	potatoTaskToken += 1
	local token = potatoTaskToken

	local removalFolder = workspace:FindFirstChild("PotatoModeRemoval")
	if not removalFolder then
		warn("[Settings] Workspace.PotatoModeRemoval is missing — Potato Mode cannot move anything.")
		return
	end

	if isEnabled then
		-- Potato Mode ON = hide objects.
		progressiveMoveChildren(removalFolder, potatoHidden, token)
	else
		-- Potato Mode OFF = restore objects / do not hide objects.
		progressiveMoveChildren(potatoHidden, removalFolder, token)
	end
end

