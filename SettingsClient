-- Purpose: Settings UI + Music Toggle + SFX Toggle + Center Pop Open / Instant Close
-- Runs on: Client
-- Location: StarterGui/SettingsGui
-- Dependencies: SoundService, TweenService, Debris, UserInputService
-- Public API: None (Internal Logic)
-- Networking: None (Client-side UI logic only)
-- Security: Client-side visuals only; no server validation needed.
-- Performance: Tweens used for open animation only.
-- Notes: SFX visual toggle implemented. Actual SFX volume control to be added later.

local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- 🛠️ REFERENCES
local screenGui = script.Parent
local openButton = screenGui:WaitForChild("OpenButton")
local window = screenGui:WaitForChild("SettingsWindow")
local closeButton = window:WaitForChild("CloseButton")

-- 🎵 MUSIC BUTTONS
local btnMusicOn = window:WaitForChild("MusicOnButton")
local btnMusicOff = window:WaitForChild("MusicOffButton")

-- 🔊 SFX BUTTONS
local btnSFXOn = window:WaitForChild("SFXOnButton")
local btnSFXOff = window:WaitForChild("SFXOffButton")

-- ⚡ PERFORMANCE BUTTONS (LOD & ANIMATION)
local performanceFrame = window:WaitForChild("Performance")
local optionsFrame = performanceFrame:WaitForChild("Options")

local option1Frame = optionsFrame:WaitForChild("Option 1")
local btnLODOn = option1Frame:WaitForChild("Option1On")
local btnLODOff = option1Frame:WaitForChild("Option1Off")

local option2Frame = optionsFrame:WaitForChild("Option 2")
local btnAnimOn = option2Frame:WaitForChild("Option2On")
local btnAnimOff = option2Frame:WaitForChild("Option2Off")

-- 🔊 MUSIC TARGET
local gameTheme = SoundService:WaitForChild("GameTheme", 5)

-- ⚙️ CONFIG
local CONFIG = {
	Colors = {
		Hover = Color3.fromRGB(210, 210, 210),
		Normal = Color3.fromRGB(255, 255, 255)
	},
	DefaultVolume = 0.5,
	Anim = {
		OpenTime = 1.0,
		StartScale = 0.0,
		EasingStyle = Enum.EasingStyle.Exponential,
	},
}



-- ✅ ENSURE UISCALE EXISTS
local uiScale = window:FindFirstChildOfClass("UIScale")
if not uiScale then
	uiScale = Instance.new("UIScale")
	uiScale.Parent = window
end

-- ✅ FORCE CENTER ANCHORING
window.AnchorPoint = Vector2.new(0.5, 0.5)
window.Position = UDim2.new(0.5, 0, 0.5, 0)

-- 🟢 HIDE/RESTORE OTHER GUIS
local function setOtherGuisEnabled(enabled)
	for _, gui in ipairs(playerGui:GetDescendants()) do
		if gui:IsA("ScreenGui") and gui ~= screenGui and gui.Name ~= "TouchGui" then
			if enabled == false then
				if gui.Enabled == true then
					gui:SetAttribute("WasEnabled", true)
					gui.Enabled = false
				end
			else
				local wasEnabled = gui:GetAttribute("WasEnabled")
				if wasEnabled ~= nil then
					gui.Enabled = wasEnabled
					gui:SetAttribute("WasEnabled", nil)
				end
			end
		end
	end
end

-- ✅ SYNC BUTTON VISUALS FROM LIVE ATTRIBUTE VALUES
local function syncButtonStates()
	local lodEnabled = workspace:GetAttribute("CarLODEnabled")
	btnLODOn.Visible = lodEnabled ~= true
	btnLODOff.Visible = lodEnabled == true

	local animEnabled = workspace:GetAttribute("CarAnimationEnabled")
	btnAnimOn.Visible = animEnabled == true
	btnAnimOff.Visible = animEnabled ~= true

	local musicMuted = SoundService:GetAttribute("MusicMuted")
	btnMusicOn.Visible = not (musicMuted == true)
	btnMusicOff.Visible = musicMuted == true

	local sfxMuted = SoundService:GetAttribute("SFXMuted")
	btnSFXOn.Visible = not (sfxMuted == true)
	btnSFXOff.Visible = sfxMuted == true
end

-- 🟢 WINDOW VISIBILITY (Centered Pop Open / Instant Close)
local currentTween = nil

local function setWindowVisible(isOpen)
	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	local A = CONFIG.Anim

	if isOpen then
		syncButtonStates()
		window.Visible = true
		openButton.Visible = false
		uiScale.Scale = A.StartScale
		UIAudioConfig.PlayClick()
		setOtherGuisEnabled(false)

		local info = TweenInfo.new(A.OpenTime, A.EasingStyle, Enum.EasingDirection.Out)
		currentTween = TweenService:Create(uiScale, info, { Scale = 1 })
		currentTween:Play()
	else
		UIAudioConfig.PlayClick()

		window.Visible = false
		openButton.Visible = true
		uiScale.Scale = 1

		setOtherGuisEnabled(true)
	end
end

-- 🎵 MUSIC TOGGLE LOGIC
local function setMusicMuted(shouldBeMuted)
	btnMusicOn.Visible = not shouldBeMuted
	btnMusicOff.Visible = shouldBeMuted

	SoundService:SetAttribute("MusicMuted", shouldBeMuted)

	local vol = shouldBeMuted and 0 or CONFIG.DefaultVolume
	if gameTheme then gameTheme.Volume = vol end

	local shopMusic = SoundService:FindFirstChild("ShopMusic_Internal")
	if shopMusic then shopMusic.Volume = vol end

	if window.Visible then
		UIAudioConfig.PlayClick()
	end
end

-- ⚡ LOD TOGGLE LOGIC
local function setLODEnabled(isEnabled)
	btnLODOn.Visible = not isEnabled
	btnLODOff.Visible = isEnabled

	workspace:SetAttribute("CarLODEnabled", isEnabled)

	if window.Visible then
		UIAudioConfig.PlayClick()
	end
end

-- ⚡ ANIMATION TOGGLE LOGIC
local function setAnimationEnabled(isEnabled)
	btnAnimOn.Visible = isEnabled
	btnAnimOff.Visible = not isEnabled

	workspace:SetAttribute("CarAnimationEnabled", isEnabled)

	if window.Visible then
		UIAudioConfig.PlayClick()
	end
end

-- 🔊 SFX TOGGLE LOGIC
local function setSFXMuted(shouldBeMuted)
	btnSFXOn.Visible = not shouldBeMuted
	btnSFXOff.Visible = shouldBeMuted

	SoundService:SetAttribute("SFXMuted", shouldBeMuted)

	if window.Visible and not shouldBeMuted then
		UIAudioConfig.PlayClick()
	end
end

local function setupButton(btn, onClick)
	if not btn or not btn:IsA("GuiButton") then return end

	local uiScale = btn:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale       = Instance.new("UIScale")
		uiScale.Scale = 1.0
		uiScale.Parent = btn
	end

	local UIAudioConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("UIAudioConfig"))

	local isHovering = false
	local isPressed  = false
	local tweenInfo  = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local function updateScale()
		local target = 1.0
		if isPressed      then target = 0.95
		elseif isHovering then target = 1.05
		end
		TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
	end

	btn.MouseEnter:Connect(function()
		isHovering = true
		UIAudioConfig.PlayHover()
		updateScale()
	end)
	btn.MouseLeave:Connect(function()
		isHovering = false
		isPressed = false
		updateScale()
	end)
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = true
			updateScale()
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = false
			updateScale()
		end
	end)

	btn.MouseButton1Click:Connect(function()
		UIAudioConfig.PlayClick()
		if onClick then onClick() end
	end)
end

-- 🚀 INITIALIZATION
setupButton(openButton, function() setWindowVisible(true) end)
setupButton(closeButton, function() setWindowVisible(false) end)

-- Connect Music Buttons
setupButton(btnMusicOn, function() setMusicMuted(true) end)
setupButton(btnMusicOff, function() setMusicMuted(false) end)

-- Connect SFX Buttons
setupButton(btnSFXOn, function() setSFXMuted(true) end)
setupButton(btnSFXOff, function() setSFXMuted(false) end)

-- Connect Performance Buttons
setupButton(btnLODOn, function() setLODEnabled(true) end)
setupButton(btnLODOff, function() setLODEnabled(false) end)

setupButton(btnAnimOn, function() setAnimationEnabled(false) end)
setupButton(btnAnimOff, function() setAnimationEnabled(true) end)

-- ✅ FIX: All four settings are now nil-guarded.
-- Defaults only apply on the very first run of the session.
-- Any subsequent LocalScript reset (e.g. respawn) will read the
-- existing attribute and leave the player's chosen setting intact.
if workspace:GetAttribute("CarLODEnabled") == nil then
	setLODEnabled(false)       -- Default: LOD OFF
end

if workspace:GetAttribute("CarAnimationEnabled") == nil then
	setAnimationEnabled(true) -- Default: Animation ON
end

if SoundService:GetAttribute("MusicMuted") == nil then
	setMusicMuted(false)       -- Default: Music ON
end

if SoundService:GetAttribute("SFXMuted") == nil then
	setSFXMuted(false)         -- Default: SFX ON
end

-- Default window state
window.Visible = false
openButton.Visible = true

