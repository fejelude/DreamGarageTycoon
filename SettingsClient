-- Purpose: Settings UI + Music Toggle + SFX Toggle + Center Pop Open / Instant Close
-- Runs on: Client
-- Location: StarterGui/SettingsGui
-- Dependencies: SoundService, TweenService, Debris, UserInputService
-- Public API: None (Internal Logic)
-- Networking: None (Client-side UI logic only)
-- Security: Client-side visuals only; no server validation needed.
-- Performance: Tweens used for open animation only.
-- Notes: SFX visual toggle implemented. Actual SFX volume control to be added later.

local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))
local SettingsPersistenceEvent = ReplicatedStorage:WaitForChild("SettingsPersistenceEvent", 10)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- 🛠️ REFERENCES
local screenGui = script.Parent
local window = screenGui:WaitForChild("SettingsWindow")
local closeButton = window:WaitForChild("CloseButton")

-- OpenButton (Settings) now lives under MainButtons > Buttons > Settings
local mainButtonsGui = playerGui:WaitForChild("MainButtons")
local buttonsFolder  = mainButtonsGui:WaitForChild("Buttons")
local openButton     = buttonsFolder:WaitForChild("Settings")

local settingsButtons = window
	:WaitForChild("SettingScrollingFrame")
	:WaitForChild("Buttons")

-- 🎵 MUSIC BUTTONS
local soundsFolder = settingsButtons:WaitForChild("Sounds")
local musicFolder = soundsFolder:WaitForChild("Music")
local btnMusicOn = musicFolder:WaitForChild("MusicOnButton")
local btnMusicOff = musicFolder:WaitForChild("MusicOffButton")

-- 🔊 SFX BUTTONS
local sfxFolder = soundsFolder:WaitForChild("SFX")
local btnSFXOn = sfxFolder:WaitForChild("SFXOnButton")
local btnSFXOff = sfxFolder:WaitForChild("SFXOffButton")

-- ⚡ PERFORMANCE BUTTONS (LOD & ANIMATION)
local performanceFolder = settingsButtons:WaitForChild("Performance")
local highLODFolder = performanceFolder:WaitForChild("HighLOD")
local btnLODOn = highLODFolder:WaitForChild("HighLodOn")
local btnLODOff = highLODFolder:WaitForChild("HighLodOff")

local carAnimationsFolder = performanceFolder:WaitForChild("CarAnimations")
local btnAnimOn = carAnimationsFolder:WaitForChild("CarAnimationOn")
local btnAnimOff = carAnimationsFolder:WaitForChild("CarAnimationOff")

local realTimeShadowsFolder = performanceFolder:WaitForChild("RealTimeShadows")
local btnRealTimeShadowsOn = realTimeShadowsFolder:WaitForChild("RealTimeShadowsOn")
local btnRealTimeShadowsOff = realTimeShadowsFolder:WaitForChild("RealTimeShadowsOff")

local potatoModeFolder = performanceFolder:WaitForChild("PotatoMode")
local btnPotatoModeOn = potatoModeFolder:WaitForChild("PotatoModeOn")
local btnPotatoModeOff = potatoModeFolder:WaitForChild("PotatoModeOff")

-- 🔊 MUSIC TARGET
local gameTheme = SoundService:WaitForChild("GameTheme", 5)

-- ⚙️ CONFIG
local SETTINGS_ATTRIBUTES = {
	MusicMuted = "Setting_MusicMuted",
	SFXMuted = "Setting_SFXMuted",
	CarLODEnabled = "Setting_CarLODEnabled",
	CarAnimationEnabled = "Setting_CarAnimationEnabled",
	RealTimeShadowsEnabled = "Setting_RealTimeShadowsEnabled",
	PotatoModeEnabled = "Setting_PotatoModeEnabled",
}

local CONFIG = {
	Colors = {
		Hover = Color3.fromRGB(210, 210, 210),
		Normal = Color3.fromRGB(255, 255, 255)
	},
	DefaultVolume = 0.5,
	Anim = {
		OpenTime = 1.0,
		StartScale = 0.0,
		EasingStyle = Enum.EasingStyle.Exponential,
	},
}

local function persistSetting(settingName, value)
	if SettingsPersistenceEvent then
		SettingsPersistenceEvent:FireServer(settingName, value)
	end
end

local function getSavedSetting(settingName)
	return player:GetAttribute(SETTINGS_ATTRIBUTES[settingName])
end


-- ✅ ENSURE UISCALE EXISTS
local uiScale = window:FindFirstChildOfClass("UIScale")
if not uiScale then
	uiScale = Instance.new("UIScale")
	uiScale.Parent = window
end

-- ✅ FORCE CENTER ANCHORING
window.AnchorPoint = Vector2.new(0.5, 0.5)
window.Position = UDim2.new(0.5, 0, 0.5, 0)

-- 🟢 HIDE/RESTORE OTHER GUIS
local function setOtherGuisEnabled(enabled)
	for _, gui in ipairs(playerGui:GetDescendants()) do
		if gui:IsA("ScreenGui") and gui ~= screenGui and gui.Name ~= "TouchGui" then
			if enabled == false then
				if gui.Enabled == true then
					gui:SetAttribute("WasEnabled", true)
					gui.Enabled = false
				end
			else
				local wasEnabled = gui:GetAttribute("WasEnabled")
				if wasEnabled ~= nil then
					gui.Enabled = wasEnabled
					gui:SetAttribute("WasEnabled", nil)
				end
			end
		end
	end
end

-- ✅ SYNC BUTTON VISUALS FROM LIVE ATTRIBUTE VALUES
local function syncButtonStates()
	local lodEnabled = workspace:GetAttribute("CarLODEnabled")
	btnLODOn.Visible = lodEnabled ~= true
	btnLODOff.Visible = lodEnabled == true

	local animEnabled = workspace:GetAttribute("CarAnimationEnabled")
	btnAnimOn.Visible = animEnabled == true
	btnAnimOff.Visible = animEnabled ~= true

	local musicMuted = SoundService:GetAttribute("MusicMuted")
	btnMusicOn.Visible = not (musicMuted == true)
	btnMusicOff.Visible = musicMuted == true

	local sfxMuted = SoundService:GetAttribute("SFXMuted")
	btnSFXOn.Visible = not (sfxMuted == true)
	btnSFXOff.Visible = sfxMuted == true

	local realTimeShadowsEnabled = workspace:GetAttribute("RealTimeShadowsEnabled")
	btnRealTimeShadowsOn.Visible = realTimeShadowsEnabled == true
	btnRealTimeShadowsOff.Visible = realTimeShadowsEnabled ~= true

	local potatoModeEnabled = workspace:GetAttribute("PotatoModeEnabled")
	btnPotatoModeOn.Visible = potatoModeEnabled ~= true
	btnPotatoModeOff.Visible = potatoModeEnabled == true
end

-- 🟢 WINDOW VISIBILITY (Centered Pop Open / Instant Close)
local currentTween = nil

local function setWindowVisible(isOpen)
	if currentTween then
		currentTween:Cancel()
		currentTween = nil
	end

	local A = CONFIG.Anim

	if isOpen then
		syncButtonStates()
		window.Visible = true
		openButton.Visible = false
		uiScale.Scale = A.StartScale
		UIAudioConfig.PlayClick()
		setOtherGuisEnabled(false)

		local info = TweenInfo.new(A.OpenTime, A.EasingStyle, Enum.EasingDirection.Out)
		currentTween = TweenService:Create(uiScale, info, { Scale = 1 })
		currentTween:Play()
	else
		UIAudioConfig.PlayClick()

		window.Visible = false
		openButton.Visible = true
		uiScale.Scale = 1

		setOtherGuisEnabled(true)
	end
end

-- 🎵 MUSIC TOGGLE LOGIC
local function setMusicMuted(shouldBeMuted, shouldPersist)
	btnMusicOn.Visible = not shouldBeMuted
	btnMusicOff.Visible = shouldBeMuted

	SoundService:SetAttribute("MusicMuted", shouldBeMuted)
	if shouldPersist ~= false then
		persistSetting("MusicMuted", shouldBeMuted)
	end

	local vol = shouldBeMuted and 0 or CONFIG.DefaultVolume
	if gameTheme then gameTheme.Volume = vol end

	local shopMusic = SoundService:FindFirstChild("ShopMusic_Internal")
	if shopMusic then shopMusic.Volume = vol end

	if window.Visible then
		UIAudioConfig.PlayClick()
	end
end

