-- ─────────────────────────────────────────────────────────────
-- REAL-TIME SHADOWS TOGGLE
-- ─────────────────────────────────────────────────────────────
local shadowsEverDisabled = false
local shadowsTaskToken = 0

local function enforcePartShadowState(part, shadowsEnabled)
	if part:GetAttribute(ORIGINAL_SHADOW_ATTR) == nil then
		part:SetAttribute(ORIGINAL_SHADOW_ATTR, part.CastShadow)
	end
	if shadowsEnabled then
		local original = part:GetAttribute(ORIGINAL_SHADOW_ATTR)
		if type(original) == "boolean" then
			part.CastShadow = original
		end
	else
		part.CastShadow = false
	end
end

local function applyRealTimeShadowsProgressive(isEnabled, token)
	if isEnabled and not shadowsEverDisabled then return end
	shadowsEverDisabled = true

	local descendants = workspace:GetDescendants()
	for i, descendant in ipairs(descendants) do
		if shadowsTaskToken ~= token then return end
		if descendant:IsA("BasePart") then
			enforcePartShadowState(descendant, isEnabled)
		end
		if i % 50 == 0 then task.wait() end
	end
end

workspace.DescendantAdded:Connect(function(descendant)
	if not descendant:IsA("BasePart") then return end
	if workspace:GetAttribute("RealTimeShadowsEnabled") == false then
		enforcePartShadowState(descendant, false)
	end
end)

local function setRealTimeShadowsEnabled(isEnabled, shouldPersist)
	if workspace:GetAttribute("RealTimeShadowsEnabled") == isEnabled then
		btnRealTimeShadowsOn.Visible  = isEnabled
		btnRealTimeShadowsOff.Visible = not isEnabled
		return
	end

	btnRealTimeShadowsOn.Visible  = isEnabled
	btnRealTimeShadowsOff.Visible = not isEnabled

	workspace:SetAttribute("RealTimeShadowsEnabled", isEnabled)
	if shouldPersist ~= false then persistSetting("RealTimeShadowsEnabled", isEnabled) end

	shadowsTaskToken += 1
	local token = shadowsTaskToken
	task.spawn(applyRealTimeShadowsProgressive, isEnabled, token)
end

-- ─────────────────────────────────────────────────────────────
-- POTATO MODE TOGGLE
-- ─────────────────────────────────────────────────────────────
local potatoTaskToken = 0

local function progressiveMoveChildren(source, target, token)
	for i, child in ipairs(source:GetChildren()) do
		if potatoTaskToken ~= token then return end
		child.Parent = target
		if i % 10 == 0 then task.wait() end
	end
end

local function setPotatoModeEnabled(isEnabled, shouldPersist)
	if workspace:GetAttribute("PotatoModeEnabled") == isEnabled then
		btnPotatoModeOn.Visible  = not isEnabled
		btnPotatoModeOff.Visible = isEnabled
		return
	end

	btnPotatoModeOn.Visible  = not isEnabled
	btnPotatoModeOff.Visible = isEnabled

	workspace:SetAttribute("PotatoModeEnabled", isEnabled)
	if shouldPersist ~= false then persistSetting("PotatoModeEnabled", isEnabled) end

	local removalFolder = workspace:FindFirstChild("PotatoModeRemoval")
	if not removalFolder then
		warn("[Settings] Workspace.PotatoModeRemoval is missing — Potato Mode cannot function.")
		return
	end

	potatoTaskToken += 1
	local token = potatoTaskToken

	if isEnabled then
		task.spawn(progressiveMoveChildren, removalFolder, potatoHidden,  token)
	else
		task.spawn(progressiveMoveChildren, potatoHidden,  removalFolder, token)
	end
end

-- ─────────────────────────────────────────────────────────────
-- BUTTON SETUP
-- Uses the same shared hover/click feedback module as TeleportFunctionClient.
-- ─────────────────────────────────────────────────────────────
-- ─────────────────────────────────────────────────────────────
-- WIRE UP ALL BUTTONS
-- ─────────────────────────────────────────────────────────────
UIButtonUtils.SetupButton(openButton,  function() setWindowVisible(true)  end)
UIButtonUtils.SetupButton(closeButton, function() setWindowVisible(false) end)

UIButtonUtils.SetupButton(btnMusicOn,  function() setMusicMuted(true)  end)
UIButtonUtils.SetupButton(btnMusicOff, function() setMusicMuted(false) end)

UIButtonUtils.SetupButton(btnSFXOn,  function() setSFXMuted(true)  end)
UIButtonUtils.SetupButton(btnSFXOff, function() setSFXMuted(false) end)

UIButtonUtils.SetupButton(btnLODOn,  function() setLODEnabled(true)  end)
UIButtonUtils.SetupButton(btnLODOff, function() setLODEnabled(false) end)

UIButtonUtils.SetupButton(btnAnimOn,  function() setAnimationEnabled(false) end)
UIButtonUtils.SetupButton(btnAnimOff, function() setAnimationEnabled(true)  end)

UIButtonUtils.SetupButton(btnRealTimeShadowsOn,  function() setRealTimeShadowsEnabled(false) end)
UIButtonUtils.SetupButton(btnRealTimeShadowsOff, function() setRealTimeShadowsEnabled(true)  end)

UIButtonUtils.SetupButton(btnPotatoModeOn,  function() setPotatoModeEnabled(true)  end)
UIButtonUtils.SetupButton(btnPotatoModeOff, function() setPotatoModeEnabled(false) end)

-- ─────────────────────────────────────────────────────────────
-- SAVED SETTINGS LOADER
-- ─────────────────────────────────────────────────────────────
local function applySettingFromSavedValue(settingName)
	local value = getSavedSetting(settingName)
	if value == nil then return false end

	local v = value == true
	if     settingName == "MusicMuted"             then setMusicMuted(v, false)
	elseif settingName == "SFXMuted"               then setSFXMuted(v, false)
	elseif settingName == "CarLODEnabled"          then setLODEnabled(v, false)
	elseif settingName == "CarAnimationEnabled"    then setAnimationEnabled(v, false)
	elseif settingName == "RealTimeShadowsEnabled" then setRealTimeShadowsEnabled(v, false)
	elseif settingName == "PotatoModeEnabled"      then setPotatoModeEnabled(v, false)
	end

	return true
end

for settingName, attributeName in pairs(SETTINGS_ATTRIBUTES) do
	player:GetAttributeChangedSignal(attributeName):Connect(function()
		applySettingFromSavedValue(settingName)
	end)
end

-- ─────────────────────────────────────────────────────────────
-- INITIALISE — all features default ON; saved value wins if present
-- ─────────────────────────────────────────────────────────────
window.Visible     = false
openButton.Visible = true

if not applySettingFromSavedValue("MusicMuted")             then setMusicMuted(false, false)            end -- Music ON
if not applySettingFromSavedValue("SFXMuted")               then setSFXMuted(false, false)              end -- SFX ON
if not applySettingFromSavedValue("CarLODEnabled")          then setLODEnabled(true, false)             end -- LOD ON
if not applySettingFromSavedValue("CarAnimationEnabled")    then setAnimationEnabled(true, false)       end -- Animations ON
if not applySettingFromSavedValue("RealTimeShadowsEnabled") then setRealTimeShadowsEnabled(true, false) end -- Shadows ON
if not applySettingFromSavedValue("PotatoModeEnabled")      then setPotatoModeEnabled(false, false)     end -- Potato Mode OFF
