local potatoStorage = screenGui:WaitForChild("PotatoModeStorage")
local potatoHidden  = potatoStorage:WaitForChild("Hidden")

-- ─────────────────────────────────────────────────────────────
-- CONFIG
-- ─────────────────────────────────────────────────────────────
local DEFAULT_VOLUME = 0.5

local OPEN_TWEEN_INFO = TweenInfo.new(1.0, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)

local SETTINGS_ATTRIBUTES = {
	MusicMuted             = "Setting_MusicMuted",
	SFXMuted               = "Setting_SFXMuted",
	CarLODEnabled          = "Setting_CarLODEnabled",
	CarAnimationEnabled    = "Setting_CarAnimationEnabled",
	RealTimeShadowsEnabled = "Setting_RealTimeShadowsEnabled",
	PotatoModeEnabled      = "Setting_PotatoModeEnabled",
}

-- Important:
-- CarLODEnabled is the internal LOD optimization value.
-- High LOD button is the opposite of CarLODEnabled.
--
-- CarLODEnabled = true  → LOD optimization active → High LOD OFF
-- CarLODEnabled = false → High LOD active         → High LOD ON
local DEFAULT_SETTINGS = {
	MusicMuted             = false, -- Music ON
	SFXMuted               = false, -- SFX ON
	CarLODEnabled          = false, -- High LOD ON by default
	CarAnimationEnabled    = true,  -- Car Animations ON
	RealTimeShadowsEnabled = true,  -- Real-Time Shadows ON
	PotatoModeEnabled      = false, -- Potato Mode OFF
}

local ORIGINAL_SHADOW_ATTR = "OriginalCastShadow"

-- ─────────────────────────────────────────────────────────────
-- FORCE WINDOW CENTERING
-- ─────────────────────────────────────────────────────────────
window.AnchorPoint = Vector2.new(0.5, 0.5)
window.Position    = UDim2.new(0.5, 0, 0.5, 0)

-- ─────────────────────────────────────────────────────────────
-- PERSISTENCE HELPERS
-- ─────────────────────────────────────────────────────────────
local function persistSetting(settingName, value)
	SettingsPersistenceEvent:FireServer(settingName, value)
end

local function getSavedSetting(settingName)
	return player:GetAttribute(SETTINGS_ATTRIBUTES[settingName])
end

-- ─────────────────────────────────────────────────────────────
-- BUTTON VISUAL HELPERS
-- ─────────────────────────────────────────────────────────────
local function setCurrentStateButtonVisibility(onButton, offButton, isCurrentlyEnabled)
	onButton.Visible  = isCurrentlyEnabled
	offButton.Visible = not isCurrentlyEnabled
end

-- ─────────────────────────────────────────────────────────────
-- HIDE / RESTORE OTHER GUIS WHILE SETTINGS IS OPEN
-- ─────────────────────────────────────────────────────────────
local function setOtherGuisEnabled(enabled)
	for _, gui in ipairs(playerGui:GetDescendants()) do
		if gui:IsA("ScreenGui") and gui ~= screenGui and gui.Name ~= "TouchGui" then
			if not enabled then
				if gui.Enabled then
					gui:SetAttribute("WasEnabled", true)
					gui.Enabled = false
				end
			else
				local wasEnabled = gui:GetAttribute("WasEnabled")
				if wasEnabled ~= nil then
					gui.Enabled = wasEnabled
					gui:SetAttribute("WasEnabled", nil)
				end
			end
		end
	end
end

-- ─────────────────────────────────────────────────────────────
-- SYNC ALL BUTTON VISUALS FROM CURRENT ATTRIBUTE VALUES
-- ─────────────────────────────────────────────────────────────
local function syncButtonStates()
	local musicEnabled = SoundService:GetAttribute("MusicMuted") ~= true
	setCurrentStateButtonVisibility(btnMusicOn, btnMusicOff, musicEnabled)

	local sfxEnabled = SoundService:GetAttribute("SFXMuted") ~= true
	setCurrentStateButtonVisibility(btnSFXOn, btnSFXOff, sfxEnabled)

	local carLODEnabled = workspace:GetAttribute("CarLODEnabled")
	if carLODEnabled == nil then
		carLODEnabled = DEFAULT_SETTINGS.CarLODEnabled
	end

	-- High LOD is the opposite of CarLODEnabled.
	local highLODEnabled = not (carLODEnabled == true)
	setCurrentStateButtonVisibility(btnLODOn, btnLODOff, highLODEnabled)

	local animEnabled = workspace:GetAttribute("CarAnimationEnabled")
	if animEnabled == nil then
		animEnabled = DEFAULT_SETTINGS.CarAnimationEnabled
	end
	setCurrentStateButtonVisibility(btnAnimOn, btnAnimOff, animEnabled == true)

	local shadowsEnabled = workspace:GetAttribute("RealTimeShadowsEnabled")
	if shadowsEnabled == nil then
		shadowsEnabled = DEFAULT_SETTINGS.RealTimeShadowsEnabled
	end
	setCurrentStateButtonVisibility(btnRealTimeShadowsOn, btnRealTimeShadowsOff, shadowsEnabled == true)

	local potatoEnabled = workspace:GetAttribute("PotatoModeEnabled")
	if potatoEnabled == nil then
		potatoEnabled = DEFAULT_SETTINGS.PotatoModeEnabled
	end
	setCurrentStateButtonVisibility(btnPotatoModeOn, btnPotatoModeOff, potatoEnabled == true)
end

-- ─────────────────────────────────────────────────────────────
-- WINDOW OPEN / CLOSE
-- ─────────────────────────────────────────────────────────────
local currentOpenTween = nil

local function setWindowVisible(isOpen)
	if currentOpenTween then
		currentOpenTween:Cancel()
		currentOpenTween = nil
	end

	if isOpen then
		syncButtonStates()

		window.Visible     = true
		openButton.Visible = false
		setOtherGuisEnabled(false)

		if windowUIScale then
			windowUIScale.Scale = 0
			currentOpenTween = TweenService:Create(windowUIScale, OPEN_TWEEN_INFO, { Scale = 1 })
			currentOpenTween:Play()
		end
	else
		window.Visible     = false
		openButton.Visible = true

		if windowUIScale then
			windowUIScale.Scale = 1
		end

		setOtherGuisEnabled(true)
	end
end

-- ─────────────────────────────────────────────────────────────
-- MUSIC TOGGLE
-- ─────────────────────────────────────────────────────────────
local function setMusicEnabled(isEnabled, shouldPersist)
	local shouldBeMuted = not isEnabled

	setCurrentStateButtonVisibility(btnMusicOn, btnMusicOff, isEnabled)

	SoundService:SetAttribute("MusicMuted", shouldBeMuted)

	if shouldPersist ~= false then
		persistSetting("MusicMuted", shouldBeMuted)
	end

	local volume = isEnabled and DEFAULT_VOLUME or 0

	if gameTheme then
		gameTheme.Volume = volume
	end

	local shopMusic = SoundService:FindFirstChild("ShopMusic_Internal")
	if shopMusic then
		shopMusic.Volume = volume
	end
end

-- ─────────────────────────────────────────────────────────────
-- SFX TOGGLE
-- ─────────────────────────────────────────────────────────────
local function setSFXEnabled(isEnabled, shouldPersist)
	local shouldBeMuted = not isEnabled

	setCurrentStateButtonVisibility(btnSFXOn, btnSFXOff, isEnabled)

	SoundService:SetAttribute("SFXMuted", shouldBeMuted)

	if shouldPersist ~= false then
		persistSetting("SFXMuted", shouldBeMuted)
	end
end

-- ─────────────────────────────────────────────────────────────
-- HIGH LOD TOGGLE
--
-- IMPORTANT:
-- This UI is called High LOD, but the saved setting is CarLODEnabled.
--
-- High LOD ON:
--   CarLODEnabled = false
--
-- High LOD OFF:
--   CarLODEnabled = true
--
-- So clicking HighLodOn turns High LOD OFF and activates CarLODEnabled.
-- Clicking HighLodOff turns High LOD ON and disables CarLODEnabled.
-- ─────────────────────────────────────────────────────────────
local function setHighLODEnabled(isHighLODEnabled, shouldPersist)
	isHighLODEnabled = isHighLODEnabled == true

	local carLODEnabled = not isHighLODEnabled

	setCurrentStateButtonVisibility(btnLODOn, btnLODOff, isHighLODEnabled)

	workspace:SetAttribute("CarLODEnabled", carLODEnabled)

	if shouldPersist ~= false then
		persistSetting("CarLODEnabled", carLODEnabled)
	end
end

