-- ─────────────────────────────────────────────────────────────
-- SAVED SETTINGS LOADER
-- ─────────────────────────────────────────────────────────────
local function applySettingValue(settingName, value, shouldPersist)
	local v = value == true

	if settingName == "MusicMuted" then
		setMusicEnabled(not v, shouldPersist)
	elseif settingName == "SFXMuted" then
		setSFXEnabled(not v, shouldPersist)
	elseif settingName == "CarLODEnabled" then
		-- Saved value is CarLODEnabled.
		-- UI value is High LOD, which is the opposite.
		setHighLODEnabled(not v, shouldPersist)
	elseif settingName == "CarAnimationEnabled" then
		setAnimationEnabled(v, shouldPersist)
	elseif settingName == "RealTimeShadowsEnabled" then
		setRealTimeShadowsEnabled(v, shouldPersist)
	elseif settingName == "PotatoModeEnabled" then
		setPotatoModeEnabled(v, shouldPersist)
	end
end

local function applySettingFromSavedValue(settingName)
	local value = getSavedSetting(settingName)
	if value == nil then return false end

	applySettingValue(settingName, value, false)

	return true
end

local function applySettingFromDefaultValue(settingName)
	local value = DEFAULT_SETTINGS[settingName]
	if value == nil then return end

	applySettingValue(settingName, value, false)
end

for settingName, attributeName in pairs(SETTINGS_ATTRIBUTES) do
	player:GetAttributeChangedSignal(attributeName):Connect(function()
		applySettingFromSavedValue(settingName)
	end)
end

-- ─────────────────────────────────────────────────────────────
-- INITIALISE
--
-- Saved value wins if present.
--
-- First-time defaults:
--   Music ON
--   SFX ON
--   High LOD ON
--   Car Animations ON
--   Real-Time Shadows ON
--   Potato Mode OFF
-- ─────────────────────────────────────────────────────────────
window.Visible     = false
openButton.Visible = true

for settingName in pairs(SETTINGS_ATTRIBUTES) do
	if not applySettingFromSavedValue(settingName) then
		applySettingFromDefaultValue(settingName)
	end
end

syncButtonStates()
