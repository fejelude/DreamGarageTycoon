-- Purpose:    Settings UI — Music, SFX, LOD, Animation, Real-Time Shadows, Potato Mode
-- Runs on:    Client (LocalScript)
-- Location:   StarterGui/SettingsGui
-- Dependencies: ReplicatedStorage.UIButtonUtils, ReplicatedStorage.SettingsPersistenceEvent

