-- 🔊 SFX TOGGLE LOGIC
local SHADOWS_TRACKED_ATTRIBUTE = "OriginalCastShadow"
local potatoModeArchive = nil
local potatoModeTaskToken = 0

local function applyRealTimeShadowsState(isEnabled)
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("BasePart") then
			if descendant:GetAttribute(SHADOWS_TRACKED_ATTRIBUTE) == nil then
				descendant:SetAttribute(SHADOWS_TRACKED_ATTRIBUTE, descendant.CastShadow)
			end
			if isEnabled then
				local originalCastShadow = descendant:GetAttribute(SHADOWS_TRACKED_ATTRIBUTE)
				if type(originalCastShadow) == "boolean" then
					descendant.CastShadow = originalCastShadow
				end
			else
				descendant.CastShadow = false
			end
		end
	end
end

local function setRealTimeShadowsEnabled(isEnabled, shouldPersist)
	btnRealTimeShadowsOn.Visible = isEnabled
	btnRealTimeShadowsOff.Visible = not isEnabled

	workspace:SetAttribute("RealTimeShadowsEnabled", isEnabled)
	if shouldPersist ~= false then
		persistSetting("RealTimeShadowsEnabled", isEnabled)
	end

	applyRealTimeShadowsState(isEnabled)

	if window.Visible then
		UIAudioConfig.PlayClick()
	end
end

local function progressivelyClearPotatoModeFolder(folder, taskToken)
	local children = folder:GetChildren()
	for i = 1, #children do
		if potatoModeTaskToken ~= taskToken then
			return
		end
		children[i]:Destroy()
		if i % 10 == 0 then
			task.wait()
		end
	end
end

local function setPotatoModeEnabled(isEnabled, shouldPersist)
	btnPotatoModeOn.Visible = not isEnabled
	btnPotatoModeOff.Visible = isEnabled

	workspace:SetAttribute("PotatoModeEnabled", isEnabled)
	if shouldPersist ~= false then
		persistSetting("PotatoModeEnabled", isEnabled)
	end

	potatoModeTaskToken += 1
	local currentToken = potatoModeTaskToken
	local removalFolder = workspace:FindFirstChild("PotatoModeRemoval")
	if removalFolder and removalFolder:IsA("Folder") then
		if isEnabled then
			if not potatoModeArchive then
				potatoModeArchive = removalFolder:Clone()
				potatoModeArchive.Name = "PotatoModeArchive"
			end
			task.spawn(progressivelyClearPotatoModeFolder, removalFolder, currentToken)
		elseif potatoModeArchive then
			for _, child in ipairs(removalFolder:GetChildren()) do
				child:Destroy()
			end
			for _, child in ipairs(potatoModeArchive:GetChildren()) do
				child:Clone().Parent = removalFolder
			end
		end
	end

	if window.Visible then
		UIAudioConfig.PlayClick()
	end
end

local function setSFXMuted(shouldBeMuted, shouldPersist)
	btnSFXOn.Visible = not shouldBeMuted
	btnSFXOff.Visible = shouldBeMuted

	SoundService:SetAttribute("SFXMuted", shouldBeMuted)
	if shouldPersist ~= false then
		persistSetting("SFXMuted", shouldBeMuted)
	end

	if window.Visible and not shouldBeMuted then
		UIAudioConfig.PlayClick()
	end
end

local function setupButton(btn, onClick)
	if not btn or not btn:IsA("GuiButton") then return end

	local uiScale = btn:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale       = Instance.new("UIScale")
		uiScale.Scale = 1.0
		uiScale.Parent = btn
	end

	local UIAudioConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("UIAudioConfig"))

	local isHovering = false
	local isPressed  = false
	local tweenInfo  = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local function updateScale()
		local target = 1.0
		if isPressed      then target = 0.95
		elseif isHovering then target = 1.05
		end
		TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
	end

	btn.MouseEnter:Connect(function()
		isHovering = true
		UIAudioConfig.PlayHover()
		updateScale()
	end)
	btn.MouseLeave:Connect(function()
		isHovering = false
		isPressed = false
		updateScale()
	end)
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = true
			updateScale()
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = false
			updateScale()
		end
	end)

	btn.MouseButton1Click:Connect(function()
		UIAudioConfig.PlayClick()
		if onClick then onClick() end
	end)
end

-- 🚀 INITIALIZATION
setupButton(openButton, function() setWindowVisible(true) end)
setupButton(closeButton, function() setWindowVisible(false) end)

-- Connect Music Buttons
setupButton(btnMusicOn, function() setMusicMuted(true) end)
setupButton(btnMusicOff, function() setMusicMuted(false) end)

-- Connect SFX Buttons
setupButton(btnSFXOn, function() setSFXMuted(true) end)
setupButton(btnSFXOff, function() setSFXMuted(false) end)

-- Connect Performance Buttons
setupButton(btnLODOn, function() setLODEnabled(true) end)
setupButton(btnLODOff, function() setLODEnabled(false) end)

setupButton(btnAnimOn, function() setAnimationEnabled(false) end)
setupButton(btnAnimOff, function() setAnimationEnabled(true) end)
setupButton(btnRealTimeShadowsOn, function() setRealTimeShadowsEnabled(true) end)
setupButton(btnRealTimeShadowsOff, function() setRealTimeShadowsEnabled(false) end)
setupButton(btnPotatoModeOn, function() setPotatoModeEnabled(true) end)
setupButton(btnPotatoModeOff, function() setPotatoModeEnabled(false) end)

local function applySettingFromSavedValue(settingName)
	local savedValue = getSavedSetting(settingName)
	if savedValue == nil then return false end

	if settingName == "CarLODEnabled" then
		setLODEnabled(savedValue == true, false)
	elseif settingName == "CarAnimationEnabled" then
		setAnimationEnabled(savedValue == true, false)
	elseif settingName == "MusicMuted" then
		setMusicMuted(savedValue == true, false)
	elseif settingName == "SFXMuted" then
		setSFXMuted(savedValue == true, false)
	elseif settingName == "RealTimeShadowsEnabled" then
		setRealTimeShadowsEnabled(savedValue == true, false)
	elseif settingName == "PotatoModeEnabled" then
		setPotatoModeEnabled(savedValue == true, false)
	end

	return true
end

for settingName, attributeName in pairs(SETTINGS_ATTRIBUTES) do
	player:GetAttributeChangedSignal(attributeName):Connect(function()
		applySettingFromSavedValue(settingName)
	end)
end

if not applySettingFromSavedValue("CarLODEnabled") and workspace:GetAttribute("CarLODEnabled") == nil then
	setLODEnabled(false, false)       -- Default: LOD OFF
end

if not applySettingFromSavedValue("CarAnimationEnabled") and workspace:GetAttribute("CarAnimationEnabled") == nil then
	setAnimationEnabled(true, false) -- Default: Animation ON
end

if not applySettingFromSavedValue("MusicMuted") and SoundService:GetAttribute("MusicMuted") == nil then
	setMusicMuted(false, false)       -- Default: Music ON
end

if not applySettingFromSavedValue("SFXMuted") and SoundService:GetAttribute("SFXMuted") == nil then
	setSFXMuted(false, false)         -- Default: SFX ON
end

-- Default window state
window.Visible = false
openButton.Visible = true

if not applySettingFromSavedValue("RealTimeShadowsEnabled") and workspace:GetAttribute("RealTimeShadowsEnabled") == nil then
	setRealTimeShadowsEnabled(true, false) -- Default: Shadows ON
end

if not applySettingFromSavedValue("PotatoModeEnabled") and workspace:GetAttribute("PotatoModeEnabled") == nil then
	setPotatoModeEnabled(false, false) -- Default: Potato Mode OFF
end
