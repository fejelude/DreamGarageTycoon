-- Compatibility cleanup for the retired Banking App. This may be deleted after
-- BankGui and MainButtons.Buttons.BankingApp are removed from the place.
local Players = game:GetService("Players")
local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

local function disableBankUI(instance)
	if instance:IsA("ScreenGui") and instance.Name == "BankGui" then
		instance.Enabled = false
	elseif instance:IsA("GuiObject") and instance.Name == "BankingApp" then
		instance.Visible = false
		instance.Active = false
	end
end
for _, instance in ipairs(playerGui:GetDescendants()) do disableBankUI(instance) end
playerGui.DescendantAdded:Connect(disableBankUI)
