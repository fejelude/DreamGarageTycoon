-- Purpose: Handles server-side validation and execution for selling cars to Sofhia.
-- Runs on: Server
-- Location: ServerScriptService > SofhiaSellService
-- Dependencies: ReplicatedStorage, ServerStorage, Players
-- Public API: None
-- Networking: Listens to SofhiaSellFunction (RemoteFunction)
-- Security: Server-authoritative inventory checks, debounces, distance checks, and economy limits.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")

local CarSellPrices = require(ReplicatedStorage:WaitForChild("CarSellPrices"))
local SellFunction = ReplicatedStorage:WaitForChild("SofhiaSellFunction")
local TycoonAdminAPI = ServerStorage:WaitForChild("TycoonAdminAPI")
local PlayerTransactionCoordinator = require(ServerScriptService:WaitForChild("PlayerTransactionCoordinator"))

local MAX_DISTANCE = 30 -- Max interaction distance
local SELL_ALL_ACTION = "SellAllCars"

local activeTransactions = {}

-- Retrieve player's equipped car strictly on the server
local function getServerEquippedCar(player)
	if not player.Character then return nil, nil end
	for _, child in ipairs(player.Character:GetChildren()) do
		if child:IsA("Tool") then
			local id = child:GetAttribute("ToolId") or child.Name
			return id, child
		end
	end
	return nil, nil
end

local function validatePlayerNearSofhia(player)
	local character = player.Character
	if not character then
		return false, "Character not found."
	end

	local pRoot = character:FindFirstChild("HumanoidRootPart")
	local npcFolder = workspace:FindFirstChild("NPCS")
	if not npcFolder then
		warn("⚠️ NPCS folder not found in workspace!")
		return false, "Security Check Failed: Distance could not be verified."
	end

	local sofhiaNpc = npcFolder:FindFirstChild("Sofhia")
	if not pRoot or not sofhiaNpc then
		if not sofhiaNpc then
			warn("⚠️ Sofhia NPC not found in NPCS folder!")
		end
		return false, "Security Check Failed: Distance could not be verified."
	end

	local npcRoot = sofhiaNpc:FindFirstChild("HumanoidRootPart") or sofhiaNpc.PrimaryPart
	if not npcRoot then
		return false, "NPC not found."
	end

	if (pRoot.Position - npcRoot.Position).Magnitude > MAX_DISTANCE then
		return false, "You are too far away!"
	end

	return true
end

local function getSellableToolDetails(tool)
	if not tool or not tool:IsA("Tool") then return nil end
	if tool:GetAttribute("IssuedByServer") ~= true then return nil end
	if type(tool:GetAttribute("ItemId")) ~= "string" then return nil end

	local rawId = tool:GetAttribute("ToolId") or tool.Name
	local cleanId = CarSellPrices.CleanId(rawId)
	local details = CarSellPrices.GetDetails(cleanId)
	if not details or not details.SellPrice or details.SellPrice <= 0 then return nil end

	return cleanId, details
end

local function collectSellableInventoryTools(player)
	local sellableTools = {}
	local seenItemIds = {}

	local function scan(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			local cleanId, details = getSellableToolDetails(child)
			local itemId = child:IsA("Tool") and child:GetAttribute("ItemId")
			if cleanId and type(itemId) == "string" and not seenItemIds[itemId] then
				seenItemIds[itemId] = true
				table.insert(sellableTools, {
					Tool = child,
					ToolId = child:GetAttribute("ToolId") or child.Name,
					ItemId = child:GetAttribute("ItemId"),
					CleanId = cleanId,
					SellPrice = details.SellPrice,
				})
			end
		end
	end

	scan(player:FindFirstChild("Backpack"))
	if player.Character then scan(player.Character) end

	return sellableTools
end

local function sellAllInventoryCars(player)
	local toolsToSell = collectSellableInventoryTools(player)
	if #toolsToSell == 0 then
		return false, "You do not have any cars in your inventory to sell."
	end

	local sellAmount = 0
	for _, entry in ipairs(toolsToSell) do
		sellAmount += entry.SellPrice
	end

	if sellAmount <= 0 then
		return false, "Invalid sell amount."
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")
	if not wallet then
		return false, "Could not locate wallet."
	end

	local removed = {}
	for _, entry in ipairs(toolsToSell) do
		local removeOk = TycoonAdminAPI:Invoke("RemoveToolInstance", player, entry.ItemId, true)
		if not removeOk then
			for _, rollback in ipairs(removed) do
				TycoonAdminAPI:Invoke("GiveTool", player, rollback.ToolId, {
					ItemId = rollback.ItemId,
					BypassStorageLimit = true,
					Source = "SellRollback",
				})
			end
			return false, "Inventory changed during the sale. Please try again."
		end
		table.insert(removed, entry)
	end
	local originalWallet = wallet.Value
	wallet.Value += sellAmount
	if TycoonAdminAPI:Invoke("SaveNow", player) ~= true then
		wallet.Value = originalWallet
		for _, rollback in ipairs(removed) do
			TycoonAdminAPI:Invoke("GiveTool", player, rollback.ToolId, {
				ItemId = rollback.ItemId,
				BypassStorageLimit = true,
				Source = "SellRollback",
			})
		end
		return false, "Sale could not be saved. Your cars were restored."
	end

	print("💰 Sofhia Sell All: " .. player.Name .. " sold " .. tostring(#toolsToSell) .. " inventory cars for $" .. tostring(sellAmount))
	return true, "Success", sellAmount, #toolsToSell
end

local function sellEquippedCar(player, requestedCarId)
	-- Validation: Check equipped tool strictly on server
	local actualCarId, actualTool = getServerEquippedCar(player)
	if not actualCarId or not actualTool then
		return false, "You are not holding a car."
	end

	-- Sanitize ID mapping (matching `safeFindCarTool` pattern in `TycoonDataHandler`)
	local cleanRequestedId = CarSellPrices.CleanId(requestedCarId)
	local cleanActualId = CarSellPrices.CleanId(actualCarId)

	if cleanRequestedId ~= cleanActualId then
		warn("⚠️ Sell Exploit Attempt: " .. player.Name .. " requested to sell " .. cleanRequestedId .. " but is holding " .. cleanActualId)
		return false, "Item mismatch detected."
	end

	-- Validation: Get Sell Price and Check limits
	local details = CarSellPrices.GetDetails(cleanActualId)
	if not details or not details.SellPrice then
		return false, "This item cannot be sold."
	end

	local sellAmount = details.SellPrice
	if sellAmount <= 0 then
		return false, "Invalid sell amount."
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")

	if not wallet then
		return false, "Could not locate wallet."
	end

	local itemId = actualTool:GetAttribute("ItemId")
	if type(itemId) ~= "string" or itemId == "" then
		return false, "This car is missing its ownership identity. Rejoin and try again."
	end
	local removeSuccess = TycoonAdminAPI:Invoke("RemoveToolInstance", player, itemId, true)
	if not removeSuccess then
		return false, "Failed to remove the exact car. Transaction aborted."
	end

	local originalWallet = wallet.Value
	wallet.Value += sellAmount
	if TycoonAdminAPI:Invoke("SaveNow", player) ~= true then
		wallet.Value = originalWallet
		TycoonAdminAPI:Invoke("GiveTool", player, actualCarId, {
			ItemId = itemId,
			BypassStorageLimit = true,
			Source = "SellRollback",
		})
		return false, "Sale could not be saved. Your car was restored."
	end
	print("💰 Sofhia Sell: " .. player.Name .. " sold " .. cleanActualId .. " for $" .. sellAmount)

	return true, "Success"
end

SellFunction.OnServerInvoke = function(player, requestedCarId)
	-- 1. Argument validation
	if type(requestedCarId) ~= "string" then
		return false, "Invalid request format."
	end
	if #requestedCarId > 100 then return false, "Invalid request format." end

	-- 2. Transaction Lock (Prevents Spam/Race Conditions)
	if activeTransactions[player.UserId] then
		return false, "Transaction in progress. Please wait."
	end
	activeTransactions[player.UserId] = true

	local success, result, msg, sellAmount, soldCount = pcall(function()
		return PlayerTransactionCoordinator.Run(player, "SellCars", function()
			local isNear, distanceMessage = validatePlayerNearSofhia(player)
			if not isNear then return false, distanceMessage end
			if requestedCarId == SELL_ALL_ACTION then
				return sellAllInventoryCars(player)
			end
			return sellEquippedCar(player, requestedCarId)
		end)
	end)

	-- FIX (Transaction Lock): Release immediately after completion with a brief
	-- anti-spam cooldown. The old 5-second fixed delay conflicted with the
	-- immediate release in the error path, and blocked legitimate retries too long.
	if not success then
		warn("⚠️ Sofhia Transaction Error for " .. player.Name .. ": " .. tostring(result))
		activeTransactions[player.UserId] = nil
		return false, "System Error"
	end

	task.delay(1, function()
		activeTransactions[player.UserId] = nil
	end)

	return result, msg, sellAmount, soldCount
end

-- Cleanup locks on leave
Players.PlayerRemoving:Connect(function(player)
	activeTransactions[player.UserId] = nil
end)
