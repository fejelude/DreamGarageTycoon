-- Purpose: Handles server-side validation and execution for selling cars to Sofhia.
-- Runs on: Server
-- Location: ServerScriptService > SofhiaSellService
-- Dependencies: ReplicatedStorage, ServerStorage, Players
-- Public API: None
-- Networking: Listens to SofhiaSellFunction (RemoteFunction)
-- Security: Server-authoritative inventory checks, debounces, distance checks, and economy limits.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local CarSellPrices = require(ReplicatedStorage:WaitForChild("CarSellPrices"))
local SellFunction = ReplicatedStorage:WaitForChild("SofhiaSellFunction")
local TycoonAdminAPI = ServerStorage:WaitForChild("TycoonAdminAPI")

local MAX_DISTANCE = 30 -- Max interaction distance
local SELL_ALL_ACTION = "SellAllCars"

local activeTransactions = {}
local sellAllQuotes = {}
local lastQuoteAt = {}
local QUOTE_TTL = 30
local QUOTE_COOLDOWN = 0.5
local function canMutate(player)
	return player and player.Parent == Players and player:GetAttribute("TycoonDataLoaded") == true
		and player:GetAttribute("DataLoadState") == "Ready" and player:GetAttribute("TycoonDataClosing") ~= true
end

-- Retrieve player's equipped car strictly on the server
local function getServerEquippedCar(player)
	if not player.Character then return nil, nil end
	for _, child in ipairs(player.Character:GetChildren()) do
		if child:IsA("Tool") then
			local id = child:GetAttribute("ToolId") or child.Name
			return id, child
		end
	end
	return nil, nil
end

local function validatePlayerNearSofhia(player)
	local character = player.Character
	if not character then
		return false, "Character not found."
	end

	local pRoot = character:FindFirstChild("HumanoidRootPart")
	local npcFolder = workspace:FindFirstChild("NPCS")
	if not npcFolder then
		warn("⚠️ NPCS folder not found in workspace!")
		return false, "Security Check Failed: Distance could not be verified."
	end

	local sofhiaNpc = npcFolder:FindFirstChild("Sofhia")
	if not pRoot or not sofhiaNpc then
		if not sofhiaNpc then
			warn("⚠️ Sofhia NPC not found in NPCS folder!")
		end
		return false, "Security Check Failed: Distance could not be verified."
	end

	local npcRoot = sofhiaNpc:FindFirstChild("HumanoidRootPart") or sofhiaNpc.PrimaryPart
	if not npcRoot then
		return false, "NPC not found."
	end

	if (pRoot.Position - npcRoot.Position).Magnitude > MAX_DISTANCE then
		return false, "You are too far away!"
	end

	return true
end

local function getSellableToolDetails(tool)
	if not tool or not tool:IsA("Tool") then return nil end
	if tool:GetAttribute("IssuedByServer") ~= true then return nil end

	local rawId = tool:GetAttribute("ToolId") or tool.Name
	local cleanId = CarSellPrices.CleanId(rawId)
	local details = CarSellPrices.GetDetails(cleanId)
	if not details or not details.SellPrice or details.SellPrice <= 0 then return nil end

	return cleanId, details
end

local function collectSellableInventoryTools(player)
	local sellableTools = {}
	local seen = {}

	local function scan(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			local cleanId, details = getSellableToolDetails(child)
			if cleanId and not seen[child] then
				seen[child] = true
				table.insert(sellableTools, {
					Tool = child,
					CleanId = cleanId,
					SellPrice = details.SellPrice,
					IssuedId = child:GetAttribute("IssuedId"),
					IsRobuxExclusive = child:GetAttribute("IsRobuxExclusive") == true,
				})
			end
		end
	end

	scan(player:FindFirstChild("Backpack"))
	if player.Character then scan(player.Character) end

	return sellableTools
end

local function quoteSellAll(player)
	local now = os.clock()
	if now - (lastQuoteAt[player] or -math.huge) < QUOTE_COOLDOWN then
		return false, "Please wait before requesting another quote."
	end
	lastQuoteAt[player] = now
	local near, message = validatePlayerNearSofhia(player)
	if not near then return false, message end
	local entries = collectSellableInventoryTools(player)
	if #entries == 0 then return false, "You do not have any cars in your inventory to sell." end
	local amount = 0
	for _, entry in ipairs(entries) do amount += entry.SellPrice end
	local quote = {
		Id = HttpService:GenerateGUID(false), ExpiresAt = now + QUOTE_TTL,
		Entries = entries, Amount = amount, Count = #entries,
	}
	sellAllQuotes[player] = quote
	return true, "", { Id = quote.Id, Amount = amount, Count = #entries }
end

local function matchesQuote(quote, current)
	if #current ~= quote.Count then return false end
	local expected = {}
	for _, entry in ipairs(quote.Entries) do expected[entry.Tool] = entry end
	for _, entry in ipairs(current) do
		local original = expected[entry.Tool]
		if not original or original.CleanId ~= entry.CleanId
			or original.IssuedId ~= entry.IssuedId
			or original.IsRobuxExclusive ~= entry.IsRobuxExclusive
			or original.SellPrice ~= entry.SellPrice then
			return false
		end
		expected[entry.Tool] = nil
	end
	return next(expected) == nil
end

local function cleanupStarterGearMirrors(player, toolsToSell)
	local gear = player:FindFirstChild("StarterGear")
	if not gear then return end
	local removed = {}
	for _, entry in ipairs(toolsToSell) do
		local issuedId = entry.Tool:GetAttribute("IssuedId")
		local exclusive = entry.Tool:GetAttribute("IsRobuxExclusive") == true
		local exact, legacy
		for _, mirror in ipairs(gear:GetChildren()) do
			if mirror:IsA("Tool") and not removed[mirror]
				and CarSellPrices.CleanId(mirror:GetAttribute("ToolId") or mirror.Name) == entry.CleanId
				and (mirror:GetAttribute("IsRobuxExclusive") == true) == exclusive then
				if type(issuedId) == "string" and mirror:GetAttribute("IssuedId") == issuedId then
					exact = mirror
					break
				end
				legacy = legacy or mirror
			end
		end
		local mirror = exact or legacy
		if mirror then removed[mirror] = true; mirror:Destroy() end
	end
end

local function sellAllInventoryCars(player, quoteId)
	local quote = sellAllQuotes[player]
	if type(quoteId) ~= "string" or #quoteId > 100 or not quote or quote.Id ~= quoteId
		or os.clock() > quote.ExpiresAt then
		return false, "Inventory changed. Please review a new quote."
	end
	local toolsToSell = collectSellableInventoryTools(player)
	if not matchesQuote(quote, toolsToSell) then
		sellAllQuotes[player] = nil
		return false, "Inventory changed. Please review a new quote."
	end
	if #toolsToSell == 0 then
		return false, "You do not have any cars in your inventory to sell."
	end

	local sellAmount = 0
	for _, entry in ipairs(toolsToSell) do
		sellAmount += entry.SellPrice
	end

	if sellAmount <= 0 then
		return false, "Invalid sell amount."
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")
	if not wallet then
		return false, "Could not locate wallet."
	end

	-- Call the data API before consuming anything. An unavailable API must not
	-- turn an already completed sale into a reported failure and unsafe retry.
	local marked = TycoonAdminAPI:Invoke("MarkInventoryCleared", player)
	if marked ~= true then return false, "Inventory system is unavailable." end
	sellAllQuotes[player] = nil
	cleanupStarterGearMirrors(player, toolsToSell)
	for _, entry in ipairs(toolsToSell) do
		entry.Tool:Destroy()
	end
	wallet.Value += sellAmount

	print("💰 Sofhia Sell All: " .. player.Name .. " sold " .. tostring(#toolsToSell) .. " inventory cars for $" .. tostring(sellAmount))
	return true, "Success", sellAmount, #toolsToSell
end

local function sellEquippedCar(player, requestedCarId)
	-- Validation: Check equipped tool strictly on server
	local actualCarId, actualTool = getServerEquippedCar(player)
	if not actualCarId or not actualTool or actualTool:GetAttribute("IssuedByServer") ~= true then
		return false, "You are not holding a car."
	end

	-- Sanitize ID mapping (matching `safeFindCarTool` pattern in `TycoonDataHandler`)
	local cleanRequestedId = CarSellPrices.CleanId(requestedCarId)
	local cleanActualId = CarSellPrices.CleanId(actualCarId)

	if cleanRequestedId ~= cleanActualId then
		warn("⚠️ Sell Exploit Attempt: " .. player.Name .. " requested to sell " .. cleanRequestedId .. " but is holding " .. cleanActualId)
		return false, "Item mismatch detected."
	end

	-- Validation: Get Sell Price and Check limits
	local details = CarSellPrices.GetDetails(cleanActualId)
	if not details or not details.SellPrice then
		return false, "This item cannot be sold."
	end

	local sellAmount = details.SellPrice
	if sellAmount <= 0 then
		return false, "Invalid sell amount."
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")
	if not wallet then
		return false, "Could not locate wallet."
	end

	-- Remove the exact server-owned instance the player is holding. Removing by
	-- car type can delete a second identical Backpack copy and then destroy the
	-- equipped copy too, paying once for two cars.
	local removeSuccess = TycoonAdminAPI:Invoke("RemoveExactTool", player, actualTool)

	if not removeSuccess then
		return false, "Failed to remove the car from your inventory. Transaction aborted."
	end

	wallet.Value += sellAmount
	print("💰 Sofhia Sell: " .. player.Name .. " sold " .. cleanActualId .. " for $" .. sellAmount)

	return true, "Success"
end

SellFunction.OnServerInvoke = function(player, requestedCarId, quoteId)
	if not canMutate(player) then return false, "Player data is unavailable." end
	-- 1. Argument validation
	if type(requestedCarId) ~= "string" or #requestedCarId > 100 then
		return false, "Invalid request format."
	end

	if requestedCarId == "QuoteSellAllCars" then
		if activeTransactions[player.UserId] then return false, "Transaction in progress. Please wait." end
		local ok, result, message, quote = pcall(quoteSellAll, player)
		if not ok then warn("[SofhiaSellService] Quote failed: " .. tostring(result)); return false, "Could not prepare a quote." end
		return result, message, quote
	end

	-- 2. Transaction Lock (Prevents Spam/Race Conditions)
	if activeTransactions[player.UserId] then
		return false, "Transaction in progress. Please wait."
	end
	activeTransactions[player.UserId] = player

	local success, result, msg, sellAmount, soldCount = pcall(function()
		-- 3. Validation: Verify character and distance to Sofhia
		local isNear, distanceMessage = validatePlayerNearSofhia(player)
		if not isNear then
			return false, distanceMessage
		end

		if requestedCarId == SELL_ALL_ACTION then
			return sellAllInventoryCars(player, quoteId)
		end

		return sellEquippedCar(player, requestedCarId)
	end)

	-- FIX (Transaction Lock): Release immediately after completion with a brief
	-- anti-spam cooldown. The old 5-second fixed delay conflicted with the
	-- immediate release in the error path, and blocked legitimate retries too long.
	if not success then
		warn("⚠️ Sofhia Transaction Error for " .. player.Name .. ": " .. tostring(result))
		if activeTransactions[player.UserId] == player then activeTransactions[player.UserId] = nil end
		return false, "System Error"
	end

	task.delay(1, function()
		if activeTransactions[player.UserId] == player then activeTransactions[player.UserId] = nil end
	end)

	return result, msg, sellAmount, soldCount
end

-- Cleanup locks on leave
Players.PlayerRemoving:Connect(function(player)
	sellAllQuotes[player] = nil
	lastQuoteAt[player] = nil
	if activeTransactions[player.UserId] == player then activeTransactions[player.UserId] = nil end
end)
