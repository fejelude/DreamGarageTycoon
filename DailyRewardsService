-- Purpose: Server-authoritative 7-day Daily Rewards claiming, wallet grants, and car grants.
-- Runs on: Server
-- Location: ServerScriptService > DailyRewardsService
-- Required existing instances:
-- ReplicatedStorage > DailyRewardsRemotes > GetDailyRewardsState
-- ReplicatedStorage > DailyRewardsRemotes > ClaimDailyReward
-- ReplicatedStorage > DailyRewardsRemotes > DailyRewardsStateChanged
-- ServerStorage > TycoonAdminAPI

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local MutationRateLimiter = require(ServerScriptService:WaitForChild("MutationRateLimiter"))
local HttpService = game:GetService("HttpService")
local PlayerTransactionCoordinator = require(ServerScriptService:WaitForChild("PlayerTransactionCoordinator"))

local REMOTES_FOLDER_NAME = "DailyRewardsRemotes"
local STATE_ATTRIBUTE = "DailyRewardsStateJson"
local DATA_READY_ATTRIBUTE = "TycoonDataLoaded"

local SECONDS_PER_DAY = 24 * 60 * 60
local DATA_READY_TIMEOUT_SECONDS = 12

local REWARDS = {
	[1] = { Type = "Cash", Amount = 1000 },
	[2] = { Type = "Car", ToolName = "Diva" },
	[3] = { Type = "Cash", Amount = 100000 },
	[4] = { Type = "Car", ToolName = "Hiva" },
	[5] = { Type = "Cash", Amount = 350000 },
	[6] = { Type = "Car", ToolName = "Windsor" },
	[7] = { Type = "Car", ToolName = "Raiju", Rarity = "Uncommon" },
}

local remotesFolder = ReplicatedStorage:WaitForChild(REMOTES_FOLDER_NAME)

if not remotesFolder:IsA("Folder") then
	error("[DailyRewards] ReplicatedStorage > DailyRewardsRemotes must be a Folder.")
end

local getStateFunction = remotesFolder:WaitForChild("GetDailyRewardsState")
local claimFunction = remotesFolder:WaitForChild("ClaimDailyReward")
local stateChangedEvent = remotesFolder:WaitForChild("DailyRewardsStateChanged")

if not getStateFunction:IsA("RemoteFunction") then
	error("[DailyRewards] GetDailyRewardsState must be a RemoteFunction.")
end

if not claimFunction:IsA("RemoteFunction") then
	error("[DailyRewards] ClaimDailyReward must be a RemoteFunction.")
end

if not stateChangedEvent:IsA("RemoteEvent") then
	error("[DailyRewards] DailyRewardsStateChanged must be a RemoteEvent.")
end

local adminApi = ServerStorage:WaitForChild("TycoonAdminAPI")

if not adminApi:IsA("BindableFunction") then
	error("[DailyRewards] ServerStorage > TycoonAdminAPI must be a BindableFunction.")
end

local claimLocks = {}

local function getDayKey(timestamp)
	return math.floor((tonumber(timestamp) or os.time()) / SECONDS_PER_DAY)
end

local function defaultClaimedDays()
	local claimedDays = {}

	for day = 1, 7 do
		claimedDays[tostring(day)] = false
	end

	return claimedDays
end

local function sanitizeState(value)
	local data = type(value) == "table" and value or {}

	local currentDay = math.floor(tonumber(data.CurrentDay) or 1)

	if currentDay < 1 or currentDay > 7 then
		currentDay = 1
	end

	local claimedDays = defaultClaimedDays()

	if type(data.ClaimedDays) == "table" then
		for day = 1, 7 do
			local key = tostring(day)
			claimedDays[key] = data.ClaimedDays[key] == true or data.ClaimedDays[day] == true
		end
	end

	return {
		CurrentDay = currentDay,
		LastClaimAt = math.max(0, math.floor(tonumber(data.LastClaimAt) or 0)),
		LastClaimDayKey = math.max(0, math.floor(tonumber(data.LastClaimDayKey) or 0)),
		AwaitingCycleReset = data.AwaitingCycleReset == true,
		ClaimedDays = claimedDays,
	}
end

local function decodeState(player)
	local raw = player:GetAttribute(STATE_ATTRIBUTE)

	if type(raw) ~= "string" or raw == "" then
		return sanitizeState(nil)
	end

	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(raw)
	end)

	if ok and type(decoded) == "table" then
		return sanitizeState(decoded)
	end

	return sanitizeState(nil)
end

local function normalizeCycle(state, now)
	local todayKey = getDayKey(now)

	if state.LastClaimDayKey > todayKey then
		state.LastClaimDayKey = todayKey
		state.LastClaimAt = math.max(state.LastClaimAt, now)
	end

	if state.AwaitingCycleReset and state.LastClaimDayKey ~= todayKey then
		state.CurrentDay = 1
		state.AwaitingCycleReset = false
		state.ClaimedDays = defaultClaimedDays()
	end

	return state
end

local function encodeState(player, state)
	local encoded = HttpService:JSONEncode(sanitizeState(state))

	if player:GetAttribute(STATE_ATTRIBUTE) ~= encoded then
		player:SetAttribute(STATE_ATTRIBUTE, encoded)
	end
end

local function isStateAttributeReady(player)
	local raw = player:GetAttribute(STATE_ATTRIBUTE)

	if type(raw) ~= "string" or raw == "" then
		return false
	end

	local dataReady = player:GetAttribute(DATA_READY_ATTRIBUTE)

	if dataReady == false then
		return false
	end

	return dataReady == true or dataReady == nil
end

local function ensureStateReady(player, timeoutSeconds)
	if not player or not player.Parent then
		return false
	end

	timeoutSeconds = math.max(0, tonumber(timeoutSeconds) or 0)

	local started = os.clock()

	repeat
		if isStateAttributeReady(player) then
			return true
		end

		if player:GetAttribute(DATA_READY_ATTRIBUTE) == true then
			encodeState(player, sanitizeState(nil))
			return true
		end

		if os.clock() - started >= timeoutSeconds then
			break
		end

		task.wait(0.05)
	until not player.Parent

	return false
end

local function buildUnavailableClientState()
	local dayStates = {}

	for day = 1, 7 do
		dayStates[day] = {
			Day = day,
			Claimed = false,
			Ready = false,
		}
	end

	return {
		IsLoaded = false,
		CurrentDay = 1,
		CanClaimToday = false,
		AwaitingCycleReset = false,
		LastClaimAt = 0,
		LastClaimDayKey = 0,
		ServerTime = os.time(),
		DayStates = dayStates,
	}
end

local function buildClientState(player)
	local now = os.time()
	local state = normalizeCycle(decodeState(player), now)

	encodeState(player, state)

	local todayKey = getDayKey(now)
	local canClaimToday = state.LastClaimDayKey < todayKey and not state.AwaitingCycleReset

	local dayStates = {}

	for day = 1, 7 do
		local claimed = state.ClaimedDays[tostring(day)] == true

		dayStates[day] = {
			Day = day,
			Claimed = claimed,
			Ready = canClaimToday and state.CurrentDay == day and not claimed,
		}
	end

	return {
		IsLoaded = true,
		CurrentDay = state.CurrentDay,
		CanClaimToday = canClaimToday,
		AwaitingCycleReset = state.AwaitingCycleReset,
		LastClaimAt = state.LastClaimAt,
		LastClaimDayKey = state.LastClaimDayKey,
		ServerTime = now,
		DayStates = dayStates,
	}
end

local function markDirty(player)
	pcall(function()
		PlayerTransactionCoordinator.InvokeBindable(player, adminApi, "MarkDirty", player)
	end)
end

local function getWallet(player)
	local leaderstats = player:FindFirstChild("leaderstats") or player:WaitForChild("leaderstats", 5)

	if not leaderstats then
		return nil
	end

	return leaderstats:FindFirstChild("Wallet") or leaderstats:WaitForChild("Wallet", 5)
end

local function grantCar(player, day, toolName, reward, claimId)
	local attributes = {
		Source = "DailyRewards",
		DailyRewardDay = day,
		DailyRewardClaimId = claimId,
	}

	if reward.Rarity then
		attributes.Rarity = reward.Rarity
	end

	local ok, grantOk, grantMessage, grantedTool = pcall(function()
		return PlayerTransactionCoordinator.InvokeBindable(
			player,
			adminApi,
			"GiveTool",
			player,
			toolName,
			attributes
		)
	end)

	if not ok then
		warn("⚠️ [DailyRewards] Failed to grant " .. tostring(toolName) .. " to " .. player.Name .. ": " .. tostring(grantOk))
		return false, "Reward system is not ready yet."
	end

	if not grantOk then
		if grantMessage == "Car storage full" then
			return false, "Car storage is full!"
		end

		return false, tostring(grantMessage or "Unable to grant reward.")
	end

	return true, nil, {
		Kind = "Car",
		ItemId = grantedTool and grantedTool:GetAttribute("ItemId") or nil,
	}
end

local function grantReward(player, day, claimId)
	local reward = REWARDS[day]

	if not reward then
		return false, "Invalid daily reward."
	end

	if reward.Type == "Cash" then
		local wallet = getWallet(player)

		if not wallet then
			return false, "Wallet is not ready yet."
		end

		wallet.Value += reward.Amount
		return true, nil, { Kind = "Cash", Wallet = wallet, OriginalValue = wallet.Value - reward.Amount }
	end

	if reward.Type == "Car" then
		return grantCar(player, day, reward.ToolName, reward, claimId)
	end

	return false, "Invalid daily reward."
end

local function rollbackReward(player, rollback)
	if type(rollback) ~= "table" then return end
	if rollback.Kind == "Cash" and rollback.Wallet and rollback.Wallet.Parent then
		rollback.Wallet.Value = rollback.OriginalValue
	elseif rollback.Kind == "Car" and type(rollback.ItemId) == "string" then
		pcall(function()
			PlayerTransactionCoordinator.InvokeBindable(
				player,
				adminApi,
				"RemoveToolInstance",
				player,
				rollback.ItemId,
				true
			)
		end)
	end
end

local function tryClaim(player, requestedDay)
	requestedDay = math.floor(tonumber(requestedDay) or 0)

	if requestedDay < 1 or requestedDay > 7 then
		return false, "You're not ready for this yet!", buildUnavailableClientState()
	end

	if not ensureStateReady(player, DATA_READY_TIMEOUT_SECONDS) then
		return false, "Reward system is loading. Please try again.", buildUnavailableClientState()
	end

	if claimLocks[player] then
		return false, "You're not ready for this yet!", buildClientState(player)
	end

	claimLocks[player] = true

	local success, message, clientState = PlayerTransactionCoordinator.Run(player, "DailyRewardClaim", function()
		local now = os.time()
		local todayKey = getDayKey(now)
		local state = normalizeCycle(decodeState(player), now)
		local originalStateJson = player:GetAttribute(STATE_ATTRIBUTE)

		encodeState(player, state)

		if state.ClaimedDays[tostring(requestedDay)] == true then
			return false, "You already claimed this reward!", buildClientState(player)
		end

		if state.LastClaimDayKey >= todayKey or state.AwaitingCycleReset or requestedDay ~= state.CurrentDay then
			return false, "You're not ready for this yet!", buildClientState(player)
		end

		local claimId = tostring(player.UserId) .. ":" .. tostring(todayKey) .. ":" .. tostring(requestedDay)
		local grantOk, grantMessage, rollback = grantReward(player, requestedDay, claimId)

		if not grantOk then
			return false, grantMessage or "Unable to grant reward.", buildClientState(player)
		end

		state.LastClaimAt = now
		state.LastClaimDayKey = todayKey
		state.ClaimedDays[tostring(requestedDay)] = true

		if requestedDay >= 7 then
			state.CurrentDay = 1
			state.AwaitingCycleReset = true
		else
			state.CurrentDay = requestedDay + 1
			state.AwaitingCycleReset = false
		end

		encodeState(player, state)
		markDirty(player)

		local saveOk = PlayerTransactionCoordinator.InvokeBindable(
			player,
			adminApi,
			"SaveNow",
			player
		)
		if saveOk ~= true then
			rollbackReward(player, rollback)
			if type(originalStateJson) == "string" then
				player:SetAttribute(STATE_ATTRIBUTE, originalStateJson)
			else
				encodeState(player, sanitizeState(nil))
			end
			markDirty(player)
			return false, "Reward could not be saved. Please try again.", buildClientState(player)
		end

		local updatedState = buildClientState(player)
		stateChangedEvent:FireClient(player, updatedState)

		return true, "Reward has been claimed successfully!", updatedState
	end)

	claimLocks[player] = nil

	return success, message, clientState
end

getStateFunction.OnServerInvoke = function(player)
	if not MutationRateLimiter.Allow(player, "DailyRewards:GetState", 4, 1) then
		return buildClientState(player)
	end
	if not ensureStateReady(player, DATA_READY_TIMEOUT_SECONDS) then
		return buildUnavailableClientState()
	end

	return buildClientState(player)
end

claimFunction.OnServerInvoke = function(player, requestedDay)
	if not MutationRateLimiter.Allow(player, "DailyRewards:Claim", 1, 0.2) then
		return false, "Please wait before trying again.", buildClientState(player)
	end
	return tryClaim(player, requestedDay)
end

local function preparePlayer(player)
	task.defer(function()
		if ensureStateReady(player, DATA_READY_TIMEOUT_SECONDS) and player.Parent then
			stateChangedEvent:FireClient(player, buildClientState(player))
		end
	end)
end

Players.PlayerAdded:Connect(preparePlayer)

for _, player in ipairs(Players:GetPlayers()) do
	preparePlayer(player)
end

Players.PlayerRemoving:Connect(function(player)
	claimLocks[player] = nil
end)
