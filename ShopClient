-- Purpose: Client controller for Shop UI open/close behavior.
-- Runs on: Client (LocalScript)
-- Location: StarterGui > ShopUI > ShopClient
--
-- Hierarchy:
--   StarterGui > MainButtons > Shop             (opens the shop)
--   StarterGui > ShopUI > MainFrame             (shop UI)
--   StarterGui > ShopUI > MainFrame > CloseButton (closes the shop)
--   ReplicatedStorage > ShopCodeRedemptionFunction (RemoteFunction; pre-created in Studio)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local UIButtonUtils = require(ReplicatedStorage:WaitForChild("UIButtonUtils"))
local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))
local GiftProductRegistry = require(ReplicatedStorage:WaitForChild("GiftProductRegistry"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local shopGui = playerGui:WaitForChild("ShopUI")
local shopScreenGui = shopGui:IsA("ScreenGui")
	and shopGui
	or shopGui:FindFirstAncestorWhichIsA("ScreenGui")

local mainFrame = shopGui:WaitForChild("MainFrame")
local closeButton = mainFrame:WaitForChild("CloseButton")
local featuredButton = mainFrame:WaitForChild("Featured")
local shopScrolling = mainFrame:WaitForChild("ShopUIScrolling")
local shopElements = shopScrolling:WaitForChild("ShopElements")
local codeBox = shopElements:WaitForChild("Codes"):WaitForChild("Elements"):WaitForChild("CodeBox")
local verifyButton = codeBox:WaitForChild("Verify")
local carsHitRegister = shopElements:WaitForChild("Cars"):WaitForChild("HitRegister")
local redeemCodeFunction = ReplicatedStorage:WaitForChild("ShopCodeRedemptionFunction")
if not redeemCodeFunction:IsA("RemoteFunction") then
	error("[ShopClient] ReplicatedStorage > ShopCodeRedemptionFunction must be a RemoteFunction, got " .. redeemCodeFunction.ClassName, 0)
end
local shopFeedback = UIAudioConfig.CreateStateFeedback(mainFrame)
local giftRemotes = ReplicatedStorage:WaitForChild("GiftRemotes")
local purchaseResultEvent = giftRemotes:WaitForChild("GiftPurchaseResult")
local shownPurchaseIds = {}

local function showAuthoritativePurchaseResult(result)
	if type(result) ~= "table" then return end

	local purchaseId = result.PurchaseId and tostring(result.PurchaseId) or nil
	if purchaseId and shownPurchaseIds[purchaseId] then return end
	if purchaseId then
		shownPurchaseIds[purchaseId] = true
		task.delay(120, function() shownPurchaseIds[purchaseId] = nil end)
	end

	if result.Success ~= true then
		if result.Message then
			shopFeedback:Failed(tostring(result.Message))
			UIAudioConfig.PlayNamed("BuyFail")
		end
		return
	end

	local displayName = tostring(result.DisplayName or GiftProductRegistry.GetDisplayName(result.ProductId))
	local message
	if result.IsGift == true then
		-- ReceiverName comes from the receipt's server-bound target, never from the
		-- currently selected player in UniversalGiftUI.
		message = ("Successfully gifted %s to %s!"):format(displayName, tostring(result.ReceiverName or "the recipient"))
	else
		message = ("Successfully purchased %s!"):format(displayName)
	end
	shopFeedback:Success(message)
	UIAudioConfig.PlayNamed("BuySuccess")
end

purchaseResultEvent.OnClientEvent:Connect(showAuthoritativePurchaseResult)

local mainButtonsGui = playerGui:WaitForChild("MainButtons")
local buttonsContainer = mainButtonsGui:FindFirstChild("Buttons") or mainButtonsGui
local openButton = buttonsContainer:WaitForChild("Shop")

local OPEN_FOV = 50
local FOV_TWEEN = TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
local NAVIGATION_TWEEN = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local isOpen = false
local hiddenGuis = {}
local savedFOV = 70
local navigationTween = nil
local redeemBusy = false

local BALANCE_INDICATOR_GUI_NAME = "Balance Indicator"

if shopScreenGui then
	shopScreenGui.ResetOnSpawn = false
end

local function getCamera(waitSeconds)
	local camera = Workspace.CurrentCamera
	if camera then
		return camera
	end

	if waitSeconds and waitSeconds > 0 then
		local started = os.clock()
		repeat
			task.wait()
			camera = Workspace.CurrentCamera
		until camera or (os.clock() - started) >= waitSeconds
	end

	return camera
end

local function restoreHiddenGuis()
	for _, gui in ipairs(hiddenGuis) do
		if gui and gui.Parent then
			gui.Enabled = true
		end
	end

	hiddenGuis = {}
end

local function hideOtherGuis()
	hiddenGuis = {}

	for _, gui in ipairs(playerGui:GetDescendants()) do
		if gui:IsA("ScreenGui")
			and gui ~= shopScreenGui
			and gui.Name ~= BALANCE_INDICATOR_GUI_NAME
			and gui.Enabled == true then
			gui.Enabled = false
			table.insert(hiddenGuis, gui)
		end
	end
end

local function setMainFrameVisible(visible)
	isOpen = visible
	mainFrame.Visible = visible
	openButton.Visible = not visible
end

local function openShop()
	if isOpen then
		return
	end

	local camera = getCamera(2)

	if camera then
		savedFOV = camera.FieldOfView
	end

	if shopScreenGui then
		shopScreenGui.Enabled = true
	end

	hideOtherGuis()
	setMainFrameVisible(true)
	UIAudioConfig.PlayShopOpen()

	if camera then
		TweenService:Create(camera, FOV_TWEEN, {
			FieldOfView = OPEN_FOV,
		}):Play()
	end
end

local function closeShop()
	if not isOpen then
		return
	end

	restoreHiddenGuis()
	setMainFrameVisible(false)

	local camera = getCamera(0.5)

	if camera then
		TweenService:Create(camera, FOV_TWEEN, {
			FieldOfView = savedFOV,
		}):Play()
	end
end

setMainFrameVisible(false)

local function getCanvasMaxY()
	local canvasHeight = shopScrolling.AbsoluteCanvasSize.Y
	if canvasHeight <= 0 then
		canvasHeight = shopScrolling.CanvasSize.Y.Offset + (shopScrolling.CanvasSize.Y.Scale * shopScrolling.AbsoluteSize.Y)
	end
	return math.max(0, canvasHeight - shopScrolling.AbsoluteSize.Y)
end

local function scrollToSection(section)
	if navigationTween then
		navigationTween:Cancel()
		navigationTween = nil
	end

	local relativeY = section.AbsolutePosition.Y - shopScrolling.AbsolutePosition.Y
	local targetY = shopScrolling.CanvasPosition.Y + relativeY
	local padding = 0
	local listLayout = shopElements:FindFirstChildOfClass("UIListLayout")
	if listLayout then
		padding = listLayout.Padding.Offset
	end
	targetY = math.clamp(targetY - padding, 0, getCanvasMaxY())

	local tween = TweenService:Create(shopScrolling, NAVIGATION_TWEEN, {
		CanvasPosition = Vector2.new(shopScrolling.CanvasPosition.X, targetY),
	})
	navigationTween = tween
	tween.Completed:Connect(function()
		-- A cancelled tween may complete after a newer navigation has started.
		if navigationTween == tween then
			navigationTween = nil
		end
	end)
	tween:Play()
end

local function scrollToFeaturedCars()
	scrollToSection(carsHitRegister)
end

local function setVerifyLocked(locked)
	verifyButton.Active = not locked
	verifyButton.Selectable = not locked
	pcall(function() verifyButton.Interactable = not locked end)
end

local function submitCode()
	if redeemBusy then return end
	local normalizedInput = tostring(codeBox.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if normalizedInput == "" then
		shopFeedback:Failed("Please enter a code!")
		UIAudioConfig.PlayNamed("BuyFail")
		return
	end

	redeemBusy = true
	setVerifyLocked(true)

	local ok, result = pcall(function()
		return redeemCodeFunction:InvokeServer(normalizedInput)
	end)

	redeemBusy = false
	setVerifyLocked(false)

	if ok and type(result) == "table" then
		local message = tostring(result.Message or "Unable to redeem the code. Please try again.")
		if result.Success == true then
			codeBox.Text = ""
			shopFeedback:Success(message)
			UIAudioConfig.PlayNamed("BuySuccess")
		else
			shopFeedback:Failed(message)
			UIAudioConfig.PlayNamed("BuyFail")
		end
	else
		shopFeedback:Failed("Unable to redeem the code. Please try again.")
		UIAudioConfig.PlayNamed("BuyFail")
	end
end

UIButtonUtils.SetupButton(openButton, openShop)
UIButtonUtils.SetupButton(closeButton, closeShop)
UIButtonUtils.SetupButton(featuredButton, scrollToFeaturedCars)
UIButtonUtils.SetupButton(verifyButton, submitCode)

codeBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		submitCode()
	end
end)

if shopScreenGui then
	shopScreenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if isOpen and not shopScreenGui.Enabled then
			closeShop()
		end
	end)
end
