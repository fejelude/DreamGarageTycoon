-- Purpose: Server authority for permanent garage-income Game Pass ownership attributes.
-- Location: ServerScriptService > GamePassOwnershipService

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local REQUIRED_WAIT_SECONDS = 15
local gamePassConfigModule = ReplicatedStorage:WaitForChild("GamePassConfig", REQUIRED_WAIT_SECONDS)
if not gamePassConfigModule or not gamePassConfigModule:IsA("ModuleScript") then
	error("[GamePassOwnershipService] Missing required ModuleScript: ReplicatedStorage > GamePassConfig", 0)
end

local GamePassConfig = require(gamePassConfigModule)
local GiftEntitlementService = require(script.Parent:WaitForChild("GiftEntitlementService"))

local GamePassOwnershipService = {}
local ownershipCache = {}
local OWNERSHIP_READY_ATTRIBUTE = "GamePassOwnershipReady"
local OWNERSHIP_RETRY_DELAYS = { 0, 1, 3 }

local function getCacheForPlayer(player)
	local userId = player.UserId
	ownershipCache[userId] = ownershipCache[userId] or {}
	return ownershipCache[userId]
end

function GamePassOwnershipService.SetOwned(player, passKey, owned)
	local passInfo = GamePassConfig.Passes[passKey]
	if not player or not passInfo then return end
	getCacheForPlayer(player)[passKey] = owned == true
	player:SetAttribute(passInfo.Attribute, owned == true)
end

function GamePassOwnershipService.RefreshPass(player, passKey)
	local passInfo = GamePassConfig.Passes[passKey]
	if not player or not passInfo then return false end

	local ownsOk, owns = false, nil
	for attempt, delaySeconds in ipairs(OWNERSHIP_RETRY_DELAYS) do
		if delaySeconds > 0 then task.wait(delaySeconds) end
		ownsOk, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passInfo.Id)
		end)
		if ownsOk then break end
		warn(string.format(
			"[GamePassOwnershipService] UserOwnsGamePassAsync failed for %d/%s (attempt %d/%d): %s",
			player.UserId,
			passKey,
			attempt,
			#OWNERSHIP_RETRY_DELAYS,
			tostring(owns)
		))
	end

	local gifted, giftErr = nil, nil
	for _, delaySeconds in ipairs(OWNERSHIP_RETRY_DELAYS) do
		if delaySeconds > 0 then task.wait(delaySeconds) end
		gifted, giftErr = GiftEntitlementService.GetOwned(player.UserId, passKey)
		if gifted ~= nil then break end
	end

	-- A failed ownership service call is not proof that a paid perk is unowned.
	-- Preserve an already-authoritative true value rather than temporarily revoking
	-- income multipliers when Roblox services have a transient outage.
	if not ownsOk then
		owns = player:GetAttribute(passInfo.Attribute) == true
	end
	if gifted == nil then
		warn("[GamePassOwnershipService] Gift entitlement lookup failed for", player.UserId, passKey, giftErr)
		-- Do not erase a previously loaded true value during a transient outage.
		gifted = player:GetAttribute("Gifted" .. passKey) == true
	end
	player:SetAttribute("Gifted" .. passKey, gifted == true)
	GamePassOwnershipService.SetOwned(player, passKey, owns == true or gifted == true)
	return owns == true or gifted == true
end

function GamePassOwnershipService.RefreshPlayer(player)
	if not player then return end
	player:SetAttribute(OWNERSHIP_READY_ATTRIBUTE, false)
	for passKey in pairs(GamePassConfig.Passes) do
		GamePassOwnershipService.RefreshPass(player, passKey)
	end
	player:SetAttribute(OWNERSHIP_READY_ATTRIBUTE, true)
end

function GamePassOwnershipService.GetGarageIncomeMultiplier(player)
	return GamePassConfig.GetGarageIncomeMultiplier(player)
end

Players.PlayerAdded:Connect(function(player)
	player:SetAttribute(OWNERSHIP_READY_ATTRIBUTE, false)
	task.spawn(GamePassOwnershipService.RefreshPlayer, player)
end)

Players.PlayerRemoving:Connect(function(player)
	ownershipCache[player.UserId] = nil
end)

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
	local passKey = GamePassConfig.GetPassById(gamePassId)
	if not passKey or not player then return end

	if wasPurchased then
		GamePassOwnershipService.SetOwned(player, passKey, true)
	else
		-- Re-check because Roblox can report false if the player already owned it or the prompt state was stale.
		task.spawn(GamePassOwnershipService.RefreshPass, player, passKey)
	end
end)

for _, player in ipairs(Players:GetPlayers()) do
	player:SetAttribute(OWNERSHIP_READY_ATTRIBUTE, false)
	task.spawn(GamePassOwnershipService.RefreshPlayer, player)
end

return GamePassOwnershipService
