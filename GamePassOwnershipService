-- Purpose: Server authority for permanent garage-income Game Pass ownership.
-- Location: ServerScriptService > GamePassOwnershipService
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local gamePassConfigModule = ReplicatedStorage:WaitForChild("GamePassConfig", 15)
if not gamePassConfigModule or not gamePassConfigModule:IsA("ModuleScript") then
	error("[GamePassOwnershipService] Missing required ModuleScript: ReplicatedStorage > GamePassConfig", 0)
end
local GamePassConfig = require(gamePassConfigModule)
local GiftEntitlementService = require(script.Parent:WaitForChild("GiftEntitlementService"))
local Service = {}
local contexts = {}
local READY_ATTRIBUTE = "GamePassOwnershipReady"
local RETRY_DELAYS = { 0, 1, 3 }

local function contextFor(player)
	if not player or player.Parent ~= Players then return nil end
	local context = contexts[player]
	if not context then
		context = { Owned = {}, Resolved = {}, Running = {}, Worker = false }
		contexts[player] = context
	end
	return context
end
local function current(player, context)
	return player.Parent == Players and contexts[player] == context
end
local function updateReady(player, context)
	if not current(player, context) then return end
	local ready = true
	for passKey in pairs(GamePassConfig.Passes) do
		if context.Resolved[passKey] ~= true then ready = false; break end
	end
	player:SetAttribute(READY_ATTRIBUTE, ready)
end

function Service.SetOwned(player, passKey, owned)
	local passInfo = GamePassConfig.Passes[passKey]
	local context = contextFor(player)
	if not context or not passInfo then return end
	-- Confirmed permanent ownership cannot be revoked by an older false lookup.
	local confirmed = owned == true or context.Owned[passKey] == true or player:GetAttribute(passInfo.Attribute) == true
	context.Owned[passKey] = confirmed
	if confirmed then context.Resolved[passKey] = true end
	player:SetAttribute(passInfo.Attribute, confirmed)
	player:SetAttribute(passInfo.Attribute .. "Resolved", context.Resolved[passKey] == true)
	updateReady(player, context)
end

function Service.RefreshPass(player, passKey)
	local passInfo = GamePassConfig.Passes[passKey]
	local context = contextFor(player)
	if not context or not passInfo then return false, false end
	if context.Running[passKey] then return context.Owned[passKey] == true, context.Resolved[passKey] == true end
	context.Running[passKey] = true
	local ownsOk, owns = false, nil
	for _, delaySeconds in ipairs(RETRY_DELAYS) do
		if delaySeconds > 0 then task.wait(delaySeconds) end
		if not current(player, context) then return false, false end
		ownsOk, owns = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passInfo.Id)
		end)
		if ownsOk then break end
	end
	local gifted, giftErr = nil, nil
	for _, delaySeconds in ipairs(RETRY_DELAYS) do
		if delaySeconds > 0 then task.wait(delaySeconds) end
		if not current(player, context) then return false, false end
		gifted, giftErr = GiftEntitlementService.GetOwned(player.UserId, passKey)
		if gifted ~= nil then break end
	end
	if not current(player, context) then return false, false end
	context.Running[passKey] = nil
	local giftedConfirmed = gifted == true or player:GetAttribute("Gifted" .. passKey) == true
	if gifted ~= nil or giftedConfirmed then
		player:SetAttribute("Gifted" .. passKey, giftedConfirmed)
	end
	local confirmed = owns == true and ownsOk or giftedConfirmed or context.Owned[passKey] == true
		or player:GetAttribute(passInfo.Attribute) == true
	context.Resolved[passKey] = confirmed or (ownsOk and gifted ~= nil)
	if not context.Resolved[passKey] then
		warn("[GamePassOwnershipService] Ownership unresolved; retrying in background:", player.UserId, passKey, tostring(owns), tostring(giftErr))
	end
	Service.SetOwned(player, passKey, confirmed)
	return context.Owned[passKey] == true, context.Resolved[passKey] == true
end

function Service.RefreshPlayer(player)
	local context = contextFor(player)
	if not context or context.Worker then return end
	context.Worker = true
	local delaySeconds = 5
	while current(player, context) do
		for passKey in pairs(GamePassConfig.Passes) do
			if context.Resolved[passKey] ~= true then Service.RefreshPass(player, passKey) end
		end
		if not current(player, context) then break end
		updateReady(player, context)
		if player:GetAttribute(READY_ATTRIBUTE) == true then break end
		task.wait(delaySeconds)
		delaySeconds = math.min(60, delaySeconds * 2)
	end
	context.Worker = false
end

function Service.GetGarageIncomeMultiplier(player)
	return GamePassConfig.GetGarageIncomeMultiplier(player)
end
local function start(player)
	player:SetAttribute(READY_ATTRIBUTE, false)
	task.spawn(Service.RefreshPlayer, player)
end
Players.PlayerAdded:Connect(start)
Players.PlayerRemoving:Connect(function(player) contexts[player] = nil end)
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
	local passKey = GamePassConfig.GetPassById(gamePassId)
	if not passKey or not player then return end
	if wasPurchased then
		Service.SetOwned(player, passKey, true)
	else
		task.spawn(function()
			local _, resolved = Service.RefreshPass(player, passKey)
			if not resolved then Service.RefreshPlayer(player) end
		end)
	end
end)
for _, player in ipairs(Players:GetPlayers()) do start(player) end
return Service
