-- Purpose: Client controller for the Rewards Corner trigger zone, progress bars, claim button,
--          UI transitions, ExitButton behavior, and feedback labels.
-- Runs on: Client
-- Location: StarterGui > RewardsUi > FreeRewardsClient
--
-- Expected setup:
--   Workspace > RewardsCorner > TriggerPart
--   StarterGui > RewardsUi > MainFrame
--     ExitButton
--     ProgressBar
--       ForGroup > Bar > Indicator
--       ForLike > Bar > Indicator
--     ClaimButton
--     StateLabels
--       Success
--       Failed
--
-- IMPORTANT:
-- The client owns UI open/close.
-- The server owns reward validation and reward granting.

local AvatarEditorService = game:GetService("AvatarEditorService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local REQUIRED_WAIT_SECONDS = 8

local function failSetup(message)
	error("[FreeRewardsClient] " .. message, 0)
end

local function getRequiredChild(parent, childName, className, pathForMessage, waitSeconds)
	if not parent then
		failSetup("Missing parent while looking for " .. tostring(pathForMessage or childName) .. ".")
	end

	local child = parent:FindFirstChild(childName)

	if not child and waitSeconds and waitSeconds > 0 then
		child = parent:WaitForChild(childName, waitSeconds)
	end

	local fullPath = pathForMessage or (parent:GetFullName() .. " > " .. childName)

	if not child then
		failSetup("Missing required instance: " .. fullPath .. ". Create it manually in Explorer; this script will not create it automatically.")
	end

	if className and not child:IsA(className) then
		failSetup("Invalid required instance: " .. fullPath .. " must be a " .. className .. ", but found " .. child.ClassName .. ".")
	end

	return child
end

local function safeRequireModule(parent, childName)
	local moduleScript = getRequiredChild(parent, childName, "ModuleScript", parent:GetFullName() .. " > " .. childName, REQUIRED_WAIT_SECONDS)

	local ok, result = pcall(function()
		return require(moduleScript)
	end)

	if not ok then
		failSetup("Failed to require " .. moduleScript:GetFullName() .. ": " .. tostring(result))
	end

	return result
end

local UIButtonUtils = safeRequireModule(ReplicatedStorage, "UIButtonUtils")
local UIAudioConfig = safeRequireModule(ReplicatedStorage, "UIAudioConfig")

local player = Players.LocalPlayer
local playerGui = getRequiredChild(player, "PlayerGui", "PlayerGui", player.Name .. " > PlayerGui", REQUIRED_WAIT_SECONDS)

local rewardsGui = getRequiredChild(playerGui, "RewardsUi", nil, "PlayerGui > RewardsUi", REQUIRED_WAIT_SECONDS)
local rewardsScreenGui = rewardsGui:IsA("ScreenGui") and rewardsGui or rewardsGui:FindFirstAncestorWhichIsA("ScreenGui")

local mainFrame = getRequiredChild(rewardsGui, "MainFrame", "GuiObject", "PlayerGui > RewardsUi > MainFrame", REQUIRED_WAIT_SECONDS)
local exitButton = getRequiredChild(mainFrame, "ExitButton", "GuiButton", "RewardsUi > MainFrame > ExitButton", REQUIRED_WAIT_SECONDS)
local claimButton = getRequiredChild(mainFrame, "ClaimButton", "GuiButton", "RewardsUi > MainFrame > ClaimButton", REQUIRED_WAIT_SECONDS)

local progressBar = getRequiredChild(mainFrame, "ProgressBar", nil, "RewardsUi > MainFrame > ProgressBar", REQUIRED_WAIT_SECONDS)
local forGroup = getRequiredChild(progressBar, "ForGroup", nil, "RewardsUi > MainFrame > ProgressBar > ForGroup", REQUIRED_WAIT_SECONDS)
local forLike = getRequiredChild(progressBar, "ForLike", nil, "RewardsUi > MainFrame > ProgressBar > ForLike", REQUIRED_WAIT_SECONDS)

local stateLabels = getRequiredChild(mainFrame, "StateLabels", nil, "RewardsUi > MainFrame > StateLabels", REQUIRED_WAIT_SECONDS)
local failedLabel = getRequiredChild(stateLabels, "Failed", "TextLabel", "RewardsUi > MainFrame > StateLabels > Failed", REQUIRED_WAIT_SECONDS)
local successLabel = getRequiredChild(stateLabels, "Success", "TextLabel", "RewardsUi > MainFrame > StateLabels > Success", REQUIRED_WAIT_SECONDS)

local remotes = getRequiredChild(ReplicatedStorage, "FreeRewardsRemotes", "Folder", "ReplicatedStorage > FreeRewardsRemotes", REQUIRED_WAIT_SECONDS)
local getStateFunction = getRequiredChild(remotes, "GetFreeRewardsState", "RemoteFunction", "ReplicatedStorage > FreeRewardsRemotes > GetFreeRewardsState", REQUIRED_WAIT_SECONDS)
local acknowledgeLikeEvent = getRequiredChild(remotes, "AcknowledgeFreeRewardLike", "RemoteEvent", "ReplicatedStorage > FreeRewardsRemotes > AcknowledgeFreeRewardLike", REQUIRED_WAIT_SECONDS)
local claimFunction = getRequiredChild(remotes, "ClaimFreeReward", "RemoteFunction", "ReplicatedStorage > FreeRewardsRemotes > ClaimFreeReward", REQUIRED_WAIT_SECONDS)
local stateChangedEvent = getRequiredChild(remotes, "FreeRewardsStateChanged", "RemoteEvent", "ReplicatedStorage > FreeRewardsRemotes > FreeRewardsStateChanged", REQUIRED_WAIT_SECONDS)

local rewardsCorner = getRequiredChild(Workspace, "RewardsCorner", nil, "Workspace > RewardsCorner", REQUIRED_WAIT_SECONDS)
local triggerPart = getRequiredChild(rewardsCorner, "TriggerPart", "BasePart", "Workspace > RewardsCorner > TriggerPart", REQUIRED_WAIT_SECONDS)

if rewardsScreenGui then
	rewardsScreenGui.ResetOnSpawn = false
	rewardsScreenGui.Enabled = true
end

local OPEN_FOV = 50
local FOV_TWEEN = TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out)
local PROGRESS_TWEEN = TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
local LABEL_SHOW_SECONDS = 3
local LABEL_FADE_OUT_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local CLAIM_CLIENT_COOLDOWN_SECONDS = 0.15
local TRIGGER_PADDING_STUDS = 1.5
local TRIGGER_SCAN_INTERVAL = 0.1
local ATTRIBUTE_REFRESH_DEBOUNCE_SECONDS = 0.1
local LIKE_ACK_COOLDOWN_SECONDS = 1

local isOpen = false
local isClaiming = false
local hiddenGuis = {}
local savedFOV = 70

local latestClientState = nil
local refreshToken = 0
local refreshQueued = false

local lastTriggerScanAt = 0
local wasInsideTrigger = false
local dismissedUntilTriggerExit = false

local likePromptPending = false
local promptedForLikeThisOpen = false
local lastLikeAckAt = 0

local labelHideToken = {}
local labelTweens = {}
local messageState = {}

local function safePlayNamed(name)
	if UIAudioConfig and type(UIAudioConfig.PlayNamed) == "function" then
		UIAudioConfig.PlayNamed(name)
	end
end

local function getCamera(waitSeconds)
	local camera = Workspace.CurrentCamera

	if camera then
		return camera
	end

	local started = os.clock()

	while waitSeconds and os.clock() - started < waitSeconds do
		task.wait()

		camera = Workspace.CurrentCamera
		if camera then
			return camera
		end
	end

	return nil
end

local function setupButton(button, callback)
	if not button then
		return
	end

	if UIButtonUtils and type(UIButtonUtils.SetupButton) == "function" then
		local ok, err = pcall(function()
			UIButtonUtils.SetupButton(button, callback)
		end)

		if ok then
			return
		end

		warn("⚠️ [FreeRewardsClient] UIButtonUtils.SetupButton failed for " .. button:GetFullName() .. ": " .. tostring(err))
	end

	button.Activated:Connect(function()
		safePlayNamed("Click")
		callback()
	end)

	button.MouseEnter:Connect(function()
		safePlayNamed("Hover")
	end)
end

local function getLabelUIStroke(label)
	return label and (label:FindFirstChildOfClass("UIStroke") or label:FindFirstChild("UIStroke"))
end

local labelDefaults = {
	[successLabel] = {
		TextTransparency = successLabel.TextTransparency,
		TextStrokeTransparency = successLabel.TextStrokeTransparency,
		UIStrokeTransparency = getLabelUIStroke(successLabel) and getLabelUIStroke(successLabel).Transparency or nil,
	},

	[failedLabel] = {
		TextTransparency = failedLabel.TextTransparency,
		TextStrokeTransparency = failedLabel.TextStrokeTransparency,
		UIStrokeTransparency = getLabelUIStroke(failedLabel) and getLabelUIStroke(failedLabel).Transparency or nil,
	},
}

local function resetMessageState(label)
	local state = messageState[label]

	if state then
		state.count = 0
		state.baseText = nil
	end
end

local function cancelLabelTween(label)
	local tweens = labelTweens[label]

	if not tweens then
		return
	end

	for _, tween in pairs(tweens) do
		if tween then
			tween:Cancel()
		end
	end

	labelTweens[label] = nil
end

local function resetLabelTransparency(label)
	local defaults = labelDefaults[label]

	if not defaults then
		return
	end

	label.TextTransparency = defaults.TextTransparency
	label.TextStrokeTransparency = defaults.TextStrokeTransparency

	local uiStroke = getLabelUIStroke(label)

	if uiStroke and defaults.UIStrokeTransparency ~= nil then
		uiStroke.Transparency = defaults.UIStrokeTransparency
	end
end

local function hideStateLabel(label)
	if not label then
		return
	end

	cancelLabelTween(label)

	labelHideToken[label] = (labelHideToken[label] or 0) + 1
	label.Visible = false

	resetLabelTransparency(label)
	resetMessageState(label)
end

local function fadeOutStateLabel(label)
	if not label or not label.Visible then
		return
	end

	cancelLabelTween(label)

	local uiStroke = getLabelUIStroke(label)

	local textTween = TweenService:Create(label, LABEL_FADE_OUT_INFO, {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})

	local strokeTween = nil

	if uiStroke then
		strokeTween = TweenService:Create(uiStroke, LABEL_FADE_OUT_INFO, {
			Transparency = 1,
		})
	end

	local activeTweens = {
		Text = textTween,
		UIStroke = strokeTween,
	}

	labelTweens[label] = activeTweens

	local connection
	connection = textTween.Completed:Connect(function()
		if connection then
			connection:Disconnect()
		end

		if labelTweens[label] ~= activeTweens then
			return
		end

		labelTweens[label] = nil
		label.Visible = false

		resetLabelTransparency(label)
		resetMessageState(label)
	end)

	textTween:Play()

	if strokeTween then
		strokeTween:Play()
	end
end

local function getOppositeStateLabel(label)
	if label == successLabel then
		return failedLabel
	elseif label == failedLabel then
		return successLabel
	end

	return nil
end

local function formatRepeatedMessage(baseText, count)
	if count and count >= 2 then
		return tostring(baseText) .. " (x" .. tostring(count) .. ")"
	end

	return tostring(baseText)
end

local function showStateLabel(label, baseText)
	if not label then
		return
	end

	baseText = tostring(baseText or "")

	if baseText == "" then
		return
	end

	hideStateLabel(getOppositeStateLabel(label))
	cancelLabelTween(label)
	resetLabelTransparency(label)

	local state = messageState[label]

	if not state then
		state = {
			count = 0,
			baseText = nil,
		}

		messageState[label] = state
	end

	if state.baseText == baseText and label.Visible then
		state.count += 1
	else
		state.count = 1
		state.baseText = baseText
	end

	label.Text = formatRepeatedMessage(baseText, state.count)
	label.Visible = true

	labelHideToken[label] = (labelHideToken[label] or 0) + 1
	local thisToken = labelHideToken[label]

	task.delay(LABEL_SHOW_SECONDS, function()
		if labelHideToken[label] == thisToken and label.Visible then
			fadeOutStateLabel(label)
		end
	end)
end

local function clearStateLabels()
	hideStateLabel(successLabel)
	hideStateLabel(failedLabel)
end

local function createProgressController(container, pathName)
	local bar = getRequiredChild(container, "Bar", "GuiObject", pathName .. " > Bar", REQUIRED_WAIT_SECONDS)
	local indicator = getRequiredChild(bar, "Indicator", "TextLabel", pathName .. " > Bar > Indicator", REQUIRED_WAIT_SECONDS)

	local fullSize = bar.Size
	local activeTween = nil
	local lastCompleted = nil

	local function getTargetSize(completed)
		local alpha = completed and 1 or 0

		return UDim2.new(
			fullSize.X.Scale * alpha,
			fullSize.X.Offset * alpha,
			fullSize.Y.Scale,
			fullSize.Y.Offset
		)
	end

	local function setProgress(completed, instant)
		completed = completed == true

		-- Do not change any TextLabel properties. Only update Text.
		indicator.Text = completed and "1/1" or "0/1"

		if lastCompleted == completed and not instant then
			return
		end

		lastCompleted = completed

		if activeTween then
			activeTween:Cancel()
			activeTween = nil
		end

		local targetSize = getTargetSize(completed)

		if instant then
			bar.Size = targetSize
			return
		end

		activeTween = TweenService:Create(bar, PROGRESS_TWEEN, {
			Size = targetSize,
		})

		activeTween:Play()
	end

	setProgress(false, true)

	return setProgress
end

local setGroupProgress = createProgressController(forGroup, "RewardsUi > MainFrame > ProgressBar > ForGroup")
local setLikeProgress = createProgressController(forLike, "RewardsUi > MainFrame > ProgressBar > ForLike")

local function applyState(clientState, instant)
	latestClientState = clientState

	if type(clientState) ~= "table" then
		setGroupProgress(false, instant)
		setLikeProgress(false, instant)
		return false
	end

	setGroupProgress(clientState.GroupJoined == true, instant)
	setLikeProgress(clientState.LikeCompleted == true, instant)

	return true
end

local function refreshState()
	refreshToken += 1
	local thisToken = refreshToken

	local ok, clientState = pcall(function()
		return getStateFunction:InvokeServer()
	end)

	if thisToken ~= refreshToken then
		return
	end

	if ok then
		applyState(clientState, false)
	else
		warn("⚠️ [FreeRewardsClient] Failed to refresh state: " .. tostring(clientState))
	end
end

local function queueRefreshState()
	if refreshQueued then
		return
	end

	refreshQueued = true

	task.delay(ATTRIBUTE_REFRESH_DEBOUNCE_SECONDS, function()
		refreshQueued = false
		refreshState()
	end)
end

local function restoreHiddenGuis()
	for _, gui in ipairs(hiddenGuis) do
		if gui and gui.Parent then
			gui.Enabled = true
		end
	end

	hiddenGuis = {}
end

local function hideOtherGuis()
	hiddenGuis = {}

	for _, gui in ipairs(playerGui:GetDescendants()) do
		if gui:IsA("ScreenGui") and gui ~= rewardsScreenGui and gui.Enabled == true then
			gui.Enabled = false
			table.insert(hiddenGuis, gui)
		end
	end
end

local function setMainFrameVisible(visible)
	isOpen = visible
	mainFrame.Visible = visible
end

local function pointIsInsidePart(part, point)
	local localPoint = part.CFrame:PointToObjectSpace(point)
	local halfSize = part.Size * 0.5
	local padding = TRIGGER_PADDING_STUDS

	return math.abs(localPoint.X) <= halfSize.X + padding
		and math.abs(localPoint.Y) <= halfSize.Y + padding
		and math.abs(localPoint.Z) <= halfSize.Z + padding
end

local function characterIsInTrigger()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if not root or not triggerPart or not triggerPart.Parent then
		return false
	end

	return pointIsInsidePart(triggerPart, root.Position)
end

local function openRewards()
	if dismissedUntilTriggerExit then
		return
	end

	if isOpen then
		return
	end

	local camera = getCamera(2)

	if camera then
		savedFOV = camera.FieldOfView
	end

	if rewardsScreenGui then
		rewardsScreenGui.Enabled = true
	end

	hideOtherGuis()
	clearStateLabels()

	setMainFrameVisible(true)

	promptedForLikeThisOpen = false
	safePlayNamed("Open")

	if camera then
		TweenService:Create(camera, FOV_TWEEN, {
			FieldOfView = OPEN_FOV,
		}):Play()
	end

	task.spawn(refreshState)
end

local function closeRewards(manualClose)
	if manualClose and characterIsInTrigger() then
		dismissedUntilTriggerExit = true
	end

	-- Handles both normal client-opened state and bad/external forced visibility.
	if not isOpen and mainFrame.Visible == false then
		restoreHiddenGuis()
		return
	end

	restoreHiddenGuis()

	isOpen = false
	mainFrame.Visible = false

	clearStateLabels()

	if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(mainFrame) then
		GuiService.SelectedObject = nil
	end

	local camera = getCamera(0.5)

	if camera then
		TweenService:Create(camera, FOV_TWEEN, {
			FieldOfView = savedFOV,
		}):Play()
	end
end

local function acknowledgeLikeQuest()
	local now = os.clock()

	if latestClientState and latestClientState.LikeCompleted == true then
		return
	end

	if now - lastLikeAckAt < LIKE_ACK_COOLDOWN_SECONDS then
		return
	end

	lastLikeAckAt = now
	acknowledgeLikeEvent:FireServer()
end

local function promptLikeQuest()
	if likePromptPending then
		return
	end

	likePromptPending = true
	promptedForLikeThisOpen = true

	local promptStarted = pcall(function()
		AvatarEditorService:PromptSetFavorite(game.PlaceId, Enum.AvatarItemType.Asset, true)
	end)

	if not promptStarted then
		showStateLabel(failedLabel, "Open the game page, like the experience, then click claim again.")
		acknowledgeLikeQuest()
		likePromptPending = false
		return
	end

	showStateLabel(failedLabel, "Like the experience in the prompt, then click claim again.")

	-- Roblox does not provide secure server-side like verification.
	-- This only completes the UI quest gate. The actual reward remains server-validated.
	task.delay(1.5, function()
		acknowledgeLikeQuest()
		likePromptPending = false
	end)
end

local function attemptClaim()
	if isClaiming then
		showStateLabel(failedLabel, "Please wait a moment before trying again.")
		return
	end

	if latestClientState and latestClientState.LikeCompleted ~= true and not promptedForLikeThisOpen then
		promptLikeQuest()
		return
	end

	isClaiming = true

	local ok, success, message, clientState = pcall(function()
		return claimFunction:InvokeServer()
	end)

	if ok then
		if type(clientState) == "table" then
			applyState(clientState, false)
		else
			task.spawn(refreshState)
		end

		if success then
			showStateLabel(successLabel, message or "Reward claimed! The Windsor Car has been added to your inventory, and 250,000 Wallet Cash has been added to your account.")
			safePlayNamed("BuySuccess")
		else
			showStateLabel(failedLabel, message or "Complete both quests before claiming your reward.")
			safePlayNamed("BuyFail")
		end
	else
		warn("⚠️ [FreeRewardsClient] Claim request failed: " .. tostring(success))
		showStateLabel(failedLabel, "Reward system is loading. Please try again.")
		task.spawn(refreshState)
	end

	task.delay(CLAIM_CLIENT_COOLDOWN_SECONDS, function()
		isClaiming = false
	end)
end

local function updateTriggerState()
	local insideNow = characterIsInTrigger()

	if insideNow then
		if not wasInsideTrigger then
			wasInsideTrigger = true
		end

		openRewards()
	else
		if wasInsideTrigger then
			wasInsideTrigger = false
			dismissedUntilTriggerExit = false
		end

		closeRewards(false)
	end
end

setMainFrameVisible(false)
clearStateLabels()
applyState(nil, true)

setupButton(exitButton, function()
	closeRewards(true)
end)

setupButton(claimButton, attemptClaim)

RunService.Heartbeat:Connect(function()
	local now = os.clock()

	if now - lastTriggerScanAt < TRIGGER_SCAN_INTERVAL then
		return
	end

	lastTriggerScanAt = now
	updateTriggerState()
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not isOpen then
		return
	end

	if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
		closeRewards(true)
	end
end)

if rewardsScreenGui then
	rewardsScreenGui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if isOpen and not rewardsScreenGui.Enabled then
			closeRewards(false)
		end
	end)
end

stateChangedEvent.OnClientEvent:Connect(function(clientState)
	refreshToken += 1
	applyState(clientState, false)
end)

player:GetAttributeChangedSignal("FreeRewardsClaimed"):Connect(queueRefreshState)
player:GetAttributeChangedSignal("FreeRewardsLikeAcknowledged"):Connect(queueRefreshState)
player:GetAttributeChangedSignal("TycoonDataLoaded"):Connect(queueRefreshState)

player.CharacterAdded:Connect(function()
	wasInsideTrigger = false
	dismissedUntilTriggerExit = false
	queueRefreshState()
end)

player.CharacterRemoving:Connect(function()
	wasInsideTrigger = false
	dismissedUntilTriggerExit = false
	closeRewards(false)
end)

task.spawn(refreshState)
