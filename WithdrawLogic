-- Purpose: Handles UI verification, state labels, and remote communication for bank transfers.
-- Runs on: Client
-- Location: PlayerGui -> BankGui -> TransferFrame -> WithdrawalFunction -> WithdrawButton
-- Dependencies: ReplicatedStorage, Players
-- Public API: None
-- Networking: Invokes "WithdrawFunction" RemoteFunction.
-- Security: Client-side validation is only UX; server remains authoritative.
-- Performance: Reuses one Success label and one Failed label so repeated messages stack instead of overlapping.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local player = Players.LocalPlayer
local withdrawBtn = script.Parent
local mainWindow = withdrawBtn.Parent
local transferFrame = mainWindow and mainWindow.Parent
local stateLabels = transferFrame and transferFrame:WaitForChild("StateLabels", 5)

local withdrawFunc = ReplicatedStorage:WaitForChild("WithdrawFunction")

local amountInput = mainWindow:WaitForChild("AmountInput", 5)
local verifyLabel = mainWindow:FindFirstChild("VerifyLabel")

local function findStateLabel(labelName)
	stateLabels = stateLabels or (transferFrame and transferFrame:FindFirstChild("StateLabels"))
	return stateLabels and stateLabels:FindFirstChild(labelName)
end

local successLabel = findStateLabel("Success")
local failedLabel = findStateLabel("Failed")

local TRANSFER_USED_ATTR = "BankTransferLimitUsed"
local TRANSFER_RESET_AT_ATTR = "BankTransferLimitResetAt"

-- Fallback only. The server remains authoritative.
local DEFAULT_TRANSFER_LIMIT = 1000000000000

local isCoolingDown = false
local messageState = {}

local MULTIPLIERS = {
	k = 1000,
	m = 1000000,
	b = 1000000000,
	t = 1000000000000,
	qa = 1000000000000000,
	qi = 1000000000000000000,
	sx = 1000000000000000000000,
	sp = 1000000000000000000000000,
	oc = 1000000000000000000000000000,
	no = 1000000000000000000000000000000,
	dc = 1000000000000000000000000000000000,
}

local function parseAmount(text)
	if not text then
		return 0
	end

	text = tostring(text):lower():gsub(",", "")
	local numberPart, suffix = text:match("^%s*([%d%.]+)%s*(%a*)%s*$")

	if not numberPart then
		return 0
	end

	local numberValue = tonumber(numberPart)
	if not numberValue then
		return 0
	end

	local multiplier = 1
	if suffix ~= "" then
		multiplier = MULTIPLIERS[suffix]
		if not multiplier then
			return 0
		end
	end

	return math.floor(numberValue * multiplier)
end

local function getTransferLimit()
	return tonumber(player:GetAttribute("MaxBankWithdrawal")) or DEFAULT_TRANSFER_LIMIT
end

local function getTransferUsed()
	local used = tonumber(player:GetAttribute(TRANSFER_USED_ATTR)) or 0
	local resetAt = tonumber(player:GetAttribute(TRANSFER_RESET_AT_ATTR)) or 0

	if resetAt > 0 and os.time() >= resetAt then
		return 0
	end

	return math.max(0, math.floor(used))
end

local function getRemainingTransferLimit()
	return math.max(0, getTransferLimit() - getTransferUsed())
end

local function showStateLabel(label, baseText)
	if not label then
		warn("⚠️ Bank transfer state label missing for message: " .. tostring(baseText))
		return
	end

	local state = messageState[label]
	if not state then
		state = {
			count = 0,
			baseText = baseText,
		}
		messageState[label] = state
	end

	if state.baseText == baseText and label.Visible then
		state.count += 1
	else
		state.count = 1
		state.baseText = baseText
	end

	label.Text = state.count > 1 and (baseText .. " x" .. state.count) or baseText
	label.Visible = true
end

local function startVerifying()
	if verifyLabel then
		verifyLabel.Visible = true
	end
end

local function stopVerifying()
	if verifyLabel then
		verifyLabel.Visible = false
	end
end

local function showFailure(reason)
	failedLabel = failedLabel or findStateLabel("Failed")

	if reason == "Transfer Limit Reached" then
		showStateLabel(failedLabel, "Transfer Limit Reached")
	else
		showStateLabel(failedLabel, "Transfer Unsuccessful")
	end
end

local function releaseButtonSoon()
	task.delay(0.15, function()
		if withdrawBtn and withdrawBtn.Parent then
			withdrawBtn.Active = true
		end
		isCoolingDown = false
	end)
end

withdrawBtn.MouseButton1Click:Connect(function()
	if isCoolingDown then
		return
	end

	isCoolingDown = true
	withdrawBtn.Active = false

	UIAudioConfig.PlayClick()
	startVerifying()

	local amount = parseAmount(amountInput and amountInput.Text or "")
	local hiddenStats = player:FindFirstChild("HiddenStats") or player:WaitForChild("HiddenStats", 5)
	local cashValue = hiddenStats and hiddenStats:FindFirstChild("Cash")
	local currentBank = cashValue and cashValue.Value or 0
	local remainingLimit = getRemainingTransferLimit()

	if amount <= 0 or amount > currentBank then
		stopVerifying()
		showFailure("Transfer Unsuccessful")
		releaseButtonSoon()
		return
	end

	if amount > remainingLimit then
		stopVerifying()
		showFailure("Transfer Limit Reached")
		releaseButtonSoon()
		return
	end

	-- Call the server immediately so a successful transfer starts the reset timer right away.
	local invokeOk, success, message = pcall(function()
		return withdrawFunc:InvokeServer(amount, "Transfer")
	end)

	stopVerifying()

	if not invokeOk then
		warn("⚠️ Bank transfer InvokeServer failed: " .. tostring(success))
		showFailure("Transfer Unsuccessful")
	elseif success then
		if amountInput then
			amountInput.Text = ""
		end
		successLabel = successLabel or findStateLabel("Success")
		showStateLabel(successLabel, "Transfer Successful")
	else
		showFailure(message)
	end

	releaseButtonSoon()
end)

if verifyLabel then
	verifyLabel.Visible = false
end
