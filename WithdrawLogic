-- Purpose: Handles UI verification, animations, and remote communication for bank transfers.
-- Runs on: Client
-- Location: PlayerGui -> BankGui -> TransferFrame -> WithdrawalFunction -> WithdrawButton
-- Dependencies: ReplicatedStorage, TweenService, Players
-- Public API: None
-- Networking: Invokes "WithdrawFunction" (RemoteFunction)
-- Security: Client-side validation prevents negative, unavailable, or over-limit requests before invoking the server.
-- Performance: Reuses label state so repeated messages stack instead of overlapping.
-- Notes: Click and hover sounds are routed through UIAudioConfig to match the rest of the bank UI.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local player = Players.LocalPlayer
local withdrawBtn = script.Parent
local mainWindow = withdrawBtn.Parent
local transferFrame = mainWindow and mainWindow.Parent
local stateLabels = transferFrame and transferFrame:WaitForChild("StateLabels", 5)

-- 🔄 REMOTE FUNCTION
local withdrawFunc = ReplicatedStorage:WaitForChild("WithdrawFunction")

-- 📂 UI REFERENCES
local amountInput = mainWindow:WaitForChild("AmountInput", 5)
local verifyLabel = mainWindow:FindFirstChild("VerifyLabel")
local successLabel = stateLabels and stateLabels:WaitForChild("Success", 5) or mainWindow:FindFirstChild("SuccessLabel")
local failedLabel = stateLabels and stateLabels:WaitForChild("Failed", 5) or mainWindow:FindFirstChild("ErrorLabel")

-- ⚙️ TRANSFER LIMIT CONFIG
local TRANSFER_USED_ATTR = "BankTransferLimitUsed"
local TRANSFER_RESET_AT_ATTR = "BankTransferLimitResetAt"
local DEFAULT_TRANSFER_LIMIT = 1000000000000

-- ⚙️ STATE VARIABLES
local currentVerifyTween = nil
local isCoolingDown = false
local messageState = {}

-- ============================================================================
-- 🛠️ HELPER FUNCTIONS
-- ============================================================================

-- ✅ Parses "10k", "5.5m", "1,000", "2t" into numbers
local function parseAmount(text)
	if not text then return 0 end
	text = text:lower():gsub(",", "")

	local multipliers = {
		k = 1000,
		m = 1000000,
		b = 1000000000,
		t = 1000000000000,
		qa = 1000000000000000,
	}

	local suffix = text:match("%a+")
	local multiplier = suffix and multipliers[suffix] or 1
	local cleanNum = tonumber(text:match("[%d%.]+"))
	if cleanNum then
		return math.floor(cleanNum * multiplier)
	end
	return 0
end

local function getTransferLimit()
	return tonumber(player:GetAttribute("MaxBankWithdrawal")) or DEFAULT_TRANSFER_LIMIT
end

local function getTransferUsed()
	local used = tonumber(player:GetAttribute(TRANSFER_USED_ATTR)) or 0
	local resetAt = tonumber(player:GetAttribute(TRANSFER_RESET_AT_ATTR)) or 0
	if resetAt > 0 and os.time() >= resetAt then
		return 0
	end
	return math.max(0, math.floor(used))
end

local function getRemainingTransferLimit()
	return math.max(0, getTransferLimit() - getTransferUsed())
end

local function setLabelInstant(label, visible, transparency)
	if not label then return end
	label.Visible = visible
	if label:IsA("TextLabel") then label.TextTransparency = transparency end
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then stroke.Transparency = transparency end
end

local function animateStackedResult(label, baseText)
	if not label then return end

	local state = messageState[label]
	if not state then
		state = { count = 0, token = 0, baseText = baseText }
		messageState[label] = state
	end

	if state.baseText == baseText and label.Visible then
		state.count += 1
	else
		state.count = 1
		state.baseText = baseText
	end
	state.token += 1
	local token = state.token

	label.Text = state.count > 1 and (baseText .. " x" .. state.count) or baseText
	label.Visible = true
	label.ZIndex = 20

	local stroke = label:FindFirstChildOfClass("UIStroke")
	if label:IsA("TextLabel") then label.TextTransparency = 1 end
	if stroke then stroke.Transparency = 1 end

	local fadeInGoals = {}
	if label:IsA("TextLabel") then fadeInGoals.TextTransparency = 0 end
	local fadeIn = TweenService:Create(label, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), fadeInGoals)
	fadeIn:Play()
	if stroke then TweenService:Create(stroke, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Transparency = 0 }):Play() end

	task.delay(2, function()
		if state.token ~= token then return end

		local fadeOutGoals = {}
		if label:IsA("TextLabel") then fadeOutGoals.TextTransparency = 1 end
		local fadeOut = TweenService:Create(label, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In), fadeOutGoals)
		fadeOut:Play()
		if stroke then TweenService:Create(stroke, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { Transparency = 1 }):Play() end
		fadeOut.Completed:Wait()

		if state.token == token then
			label.Visible = false
			state.count = 0
		end
	end)
end

local function startVerifying()
	if not verifyLabel then return end
	verifyLabel.Visible = true
	verifyLabel.ZIndex = 20

	local pulseInfo = TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local goals = {}

	if verifyLabel:IsA("ImageLabel") then
		verifyLabel.ImageTransparency = 1
		goals.ImageTransparency = 0
	end
	if verifyLabel:IsA("TextLabel") then
		verifyLabel.TextTransparency = 1
		goals.TextTransparency = 0
	end
	local vStroke = verifyLabel:FindFirstChildOfClass("UIStroke")
	if vStroke then vStroke.Transparency = 1 end

	currentVerifyTween = TweenService:Create(verifyLabel, pulseInfo, goals)
	currentVerifyTween:Play()
end

local function stopVerifying()
	if currentVerifyTween then
		currentVerifyTween:Cancel()
		currentVerifyTween = nil
	end
	if verifyLabel then verifyLabel.Visible = false end
end

local function showFailure(reason)
	if reason == "Transfer Limit Reached" then
		animateStackedResult(failedLabel, "Transfer Limit Reached")
	else
		animateStackedResult(failedLabel, "Transfer Unsuccessful")
	end
end

-- ============================================================================
-- 🟢 MAIN TRANSFER BUTTON LOGIC
-- ============================================================================
withdrawBtn.MouseButton1Click:Connect(function()
	if isCoolingDown then return end
	isCoolingDown = true

	UIAudioConfig.PlayClick()
	withdrawBtn.Active = false
	withdrawBtn.AutoButtonColor = false

	startVerifying()
	task.wait(1.5)

	local amount = parseAmount(amountInput.Text)
	local hiddenStats = player:WaitForChild("HiddenStats")
	local currentBank = hiddenStats:WaitForChild("Cash").Value
	local remainingLimit = getRemainingTransferLimit()

	if (amount <= 0) or (amount > currentBank) then
		stopVerifying()
		print("❌ Invalid Input or Insufficient Funds")
		showFailure("Transfer Unsuccessful")
	elseif amount > remainingLimit then
		stopVerifying()
		print("❌ Transfer limit reached")
		showFailure("Transfer Limit Reached")
	else
		local success, msg = withdrawFunc:InvokeServer(amount, "Transfer")
		stopVerifying()

		if success then
			print("✅ Transaction Approved")
			amountInput.Text = ""
			animateStackedResult(successLabel, "Transfer Successful")
		else
			print("❌ Transaction Denied: " .. tostring(msg))
			showFailure(msg)
		end
	end

	task.wait(1)
	isCoolingDown = false
	withdrawBtn.Active = true
	withdrawBtn.AutoButtonColor = true
end)

-- Initialize Visuals
if verifyLabel then verifyLabel.Visible = false end
setLabelInstant(successLabel, false, 1)
setLabelInstant(failedLabel, false, 1)
