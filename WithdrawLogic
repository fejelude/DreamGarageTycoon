-- Purpose: Handles UI verification, animations, and remote communication for bank transfers.
-- Runs on: Client
-- Location: PlayerGui -> BankGui -> TransferFrame -> WithdrawalFunction -> WithdrawButton
-- Dependencies: ReplicatedStorage, TweenService, Players
-- Public API: None
-- Networking: Invokes "WithdrawFunction" RemoteFunction.
-- Security: Client-side validation is only UX; server remains authoritative.
-- Performance: Reuses one Success label and one Failed label so repeated messages stack instead of overlapping.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local player = Players.LocalPlayer
local withdrawBtn = script.Parent
local mainWindow = withdrawBtn.Parent
local transferFrame = mainWindow and mainWindow.Parent
local stateLabels = transferFrame and transferFrame:FindFirstChild("StateLabels")

local withdrawFunc = ReplicatedStorage:WaitForChild("WithdrawFunction")

local amountInput = mainWindow:WaitForChild("AmountInput", 5)
local verifyLabel = mainWindow:FindFirstChild("VerifyLabel")

local function findStateLabel(labelName, legacyName)
	stateLabels = stateLabels or (transferFrame and transferFrame:FindFirstChild("StateLabels"))

	local label = stateLabels and stateLabels:FindFirstChild(labelName)
	if label then
		return label
	end

	return mainWindow:FindFirstChild(legacyName)
end

local successLabel = findStateLabel("Success", "SuccessLabel")
local failedLabel = findStateLabel("Failed", "ErrorLabel")

local TRANSFER_USED_ATTR = "BankTransferLimitUsed"
local TRANSFER_RESET_AT_ATTR = "BankTransferLimitResetAt"

-- Fallback only. The server remains authoritative.
local DEFAULT_TRANSFER_LIMIT = 1000000000000

local isCoolingDown = false
local currentVerifyTween = nil

local messageState = {}
local labelDefaults = {}

local MULTIPLIERS = {
	k = 1000,
	m = 1000000,
	b = 1000000000,
	t = 1000000000000,
	qa = 1000000000000000,
	qi = 1000000000000000000,
	sx = 1000000000000000000000,
	sp = 1000000000000000000000000,
	oc = 1000000000000000000000000000,
	no = 1000000000000000000000000000000,
	dc = 1000000000000000000000000000000000,
}

local function parseAmount(text)
	if not text then
		return 0
	end

	text = tostring(text):lower():gsub(",", "")
	local numberPart, suffix = text:match("^%s*([%d%.]+)%s*(%a*)%s*$")

	if not numberPart then
		return 0
	end

	local numberValue = tonumber(numberPart)
	if not numberValue then
		return 0
	end

	local multiplier = 1
	if suffix ~= "" then
		multiplier = MULTIPLIERS[suffix]
		if not multiplier then
			return 0
		end
	end

	return math.floor(numberValue * multiplier)
end

local function getTransferLimit()
	return tonumber(player:GetAttribute("MaxBankWithdrawal")) or DEFAULT_TRANSFER_LIMIT
end

local function getTransferUsed()
	local used = tonumber(player:GetAttribute(TRANSFER_USED_ATTR)) or 0
	local resetAt = tonumber(player:GetAttribute(TRANSFER_RESET_AT_ATTR)) or 0

	if resetAt > 0 and os.time() >= resetAt then
		return 0
	end

	return math.max(0, math.floor(used))
end

local function getRemainingTransferLimit()
	return math.max(0, getTransferLimit() - getTransferUsed())
end

local function captureLabelDefaults(label)
	if not label or labelDefaults[label] then
		return
	end

	local stroke = label:FindFirstChildOfClass("UIStroke")
	local textTransparency = label:IsA("TextLabel") and label.TextTransparency or 0
	local strokeTransparency = stroke and stroke.Transparency or 0

	-- Labels are stored hidden in Studio. If a hidden label was authored or left
	-- fully transparent, fade it back to visible text/stroke instead of tweening
	-- from 1 to 1 and appearing invisible.
	if textTransparency >= 1 then
		textTransparency = 0
	end
	if strokeTransparency >= 1 then
		strokeTransparency = 0
	end

	labelDefaults[label] = {
		textTransparency = textTransparency,
		strokeTransparency = strokeTransparency,
	}
end

local function setLabelHidden(label)
	if not label then
		return
	end

	captureLabelDefaults(label)

	label.Visible = false

	if label:IsA("TextLabel") then
		label.TextTransparency = 1
	end

	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 1
	end
end

local function cancelTween(tween)
	if tween then
		pcall(function()
			tween:Cancel()
		end)
	end
end

local function animateStackedResult(label, baseText)
	if not label then
		warn("⚠️ Bank transfer state label missing for message: " .. tostring(baseText))
		return
	end

	captureLabelDefaults(label)

	local defaults = labelDefaults[label] or {
		textTransparency = 0,
		strokeTransparency = 0,
	}

	local state = messageState[label]
	if not state then
		state = {
			count = 0,
			token = 0,
			baseText = baseText,
		}
		messageState[label] = state
	end

	cancelTween(state.fadeInTween)
	cancelTween(state.fadeOutTween)
	cancelTween(state.strokeFadeInTween)
	cancelTween(state.strokeFadeOutTween)

	if state.baseText == baseText and label.Visible then
		state.count += 1
	else
		state.count = 1
		state.baseText = baseText
	end

	state.token += 1
	local token = state.token

	label.Text = state.count > 1 and (baseText .. " x" .. state.count) or baseText
	label.Visible = true

	local stroke = label:FindFirstChildOfClass("UIStroke")

	if label:IsA("TextLabel") then
		label.TextTransparency = 1
	end

	if stroke then
		stroke.Transparency = 1
	end

	if label:IsA("TextLabel") then
		state.fadeInTween = TweenService:Create(
			label,
			TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ TextTransparency = defaults.textTransparency }
		)
		state.fadeInTween:Play()
	end

	if stroke then
		state.strokeFadeInTween = TweenService:Create(
			stroke,
			TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ Transparency = defaults.strokeTransparency }
		)
		state.strokeFadeInTween:Play()
	end

	task.delay(2, function()
		if state.token ~= token then
			return
		end

		if label:IsA("TextLabel") then
			state.fadeOutTween = TweenService:Create(
				label,
				TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
				{ TextTransparency = 1 }
			)
			state.fadeOutTween:Play()
		end

		if stroke then
			state.strokeFadeOutTween = TweenService:Create(
				stroke,
				TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
				{ Transparency = 1 }
			)
			state.strokeFadeOutTween:Play()
		end

		if state.fadeOutTween then
			state.fadeOutTween.Completed:Wait()
		else
			task.wait(0.5)
		end

		if state.token == token then
			label.Visible = false
			state.count = 0
		end
	end)
end

local function startVerifying()
	if not verifyLabel then
		return
	end

	verifyLabel.Visible = true

	local goals = {}
	local pulseInfo = TweenInfo.new(
		0.5,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.InOut,
		-1,
		true
	)

	if verifyLabel:IsA("ImageLabel") then
		verifyLabel.ImageTransparency = 1
		goals.ImageTransparency = 0
	elseif verifyLabel:IsA("TextLabel") then
		verifyLabel.TextTransparency = 1
		goals.TextTransparency = 0
	end

	if next(goals) then
		currentVerifyTween = TweenService:Create(verifyLabel, pulseInfo, goals)
		currentVerifyTween:Play()
	end
end

local function stopVerifying()
	if currentVerifyTween then
		currentVerifyTween:Cancel()
		currentVerifyTween = nil
	end

	if verifyLabel then
		verifyLabel.Visible = false
	end
end

local function showFailure(reason)
	failedLabel = failedLabel or findStateLabel("Failed", "ErrorLabel")

	if reason == "Transfer Limit Reached" then
		animateStackedResult(failedLabel, "Transfer Limit Reached")
	else
		animateStackedResult(failedLabel, "Transfer Unsuccessful")
	end
end

local function releaseButtonSoon()
	task.delay(0.15, function()
		if withdrawBtn and withdrawBtn.Parent then
			withdrawBtn.Active = true
		end
		isCoolingDown = false
	end)
end

withdrawBtn.MouseButton1Click:Connect(function()
	if isCoolingDown then
		return
	end

	isCoolingDown = true
	withdrawBtn.Active = false

	UIAudioConfig.PlayClick()
	startVerifying()

	local amount = parseAmount(amountInput and amountInput.Text or "")
	local hiddenStats = player:FindFirstChild("HiddenStats") or player:WaitForChild("HiddenStats", 5)
	local cashValue = hiddenStats and hiddenStats:FindFirstChild("Cash")
	local currentBank = cashValue and cashValue.Value or 0
	local remainingLimit = getRemainingTransferLimit()

	if amount <= 0 or amount > currentBank then
		stopVerifying()
		showFailure("Transfer Unsuccessful")
		releaseButtonSoon()
		return
	end

	if amount > remainingLimit then
		stopVerifying()
		showFailure("Transfer Limit Reached")
		releaseButtonSoon()
		return
	end

	-- Call the server immediately so a successful transfer starts the reset timer right away.
	local invokeOk, success, message = pcall(function()
		return withdrawFunc:InvokeServer(amount, "Transfer")
	end)

	stopVerifying()

	if not invokeOk then
		warn("⚠️ Bank transfer InvokeServer failed: " .. tostring(success))
		showFailure("Transfer Unsuccessful")
	elseif success then
		if amountInput then
			amountInput.Text = ""
		end
		successLabel = successLabel or findStateLabel("Success", "SuccessLabel")
		animateStackedResult(successLabel, "Transfer Successful")
	else
		showFailure(message)
	end

	releaseButtonSoon()
end)

captureLabelDefaults(successLabel)
captureLabelDefaults(failedLabel)

if verifyLabel then
	verifyLabel.Visible = false
end

setLabelHidden(successLabel)
setLabelHidden(failedLabel)
