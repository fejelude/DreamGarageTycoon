-- ============================================================
-- RestockNotificationHandler
-- Purpose : Displays Global Shop Restock notifications from Admins.
-- Runs on : Client (StarterPlayerScripts)
-- Deps    : ReplicatedStorage.CarStats, ReplicatedStorage.RestockNotificationEvent
-- UI      : StarterGui > Notifications > RestockNotificationFrame > RestockNotification
--           (RichText MUST be enabled on the RestockNotification TextLabel)
-- ============================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players           = game:GetService("Players")
local SoundService      = game:GetService("SoundService")

-- ============================================================
-- CONSTANTS
-- ============================================================

-- Rarity colour codes (hex, for RichText)
local COLORS = {
	Common    = "#A1A1AA",
	Uncommon  = "#00F5D4",
	Rare      = "#3A86FF",
	Epic      = "#9D4EDD",
	Legendary = "#FFBE0B",
	Mythic    = "#FF006E",
	All       = "#FFD700",
}

-- Rank access table
local RANK_VALUES = {
	["Player"] = 0, ["VIP"] = 1, ["VIP+"] = 2,
	["MVP"]    = 3, ["MVP+"] = 4, ["MVP++"] = 5,
}
local SHOP_REQUIREMENTS = {
	Common    = "Player",
	Uncommon  = "VIP",
	Rare      = "VIP+",
	Epic      = "MVP",
	Legendary = "MVP+",
	Mythic    = "MVP++",
}

local RESTOCK_AUDIO_ID = "rbxassetid://81822437427070"
local DISPLAY_TIME     = 6  -- seconds the notification stays visible

-- ============================================================
-- REFERENCES
-- ============================================================

local CarStats                 = require(ReplicatedStorage:WaitForChild("CarStats"))
local RestockNotificationEvent = ReplicatedStorage:WaitForChild("RestockNotificationEvent")

local player           = Players.LocalPlayer
local playerGui        = player:WaitForChild("PlayerGui")
local notificationsGui = playerGui:WaitForChild("Notifications")
local notifFrame       = notificationsGui:WaitForChild("RestockNotificationFrame")
local notifText        = notifFrame:WaitForChild("RestockNotification")

-- ============================================================
-- SETUP
--   Tag this frame so the loading screen knows NOT to touch it.
--   The loading-screen script checks this attribute before recording
--   or restoring any GuiObject's visibility.
-- ============================================================

notifFrame:SetAttribute("ExternallyManaged", true)
notifFrame.Visible = false

-- ============================================================
-- HELPERS
-- ============================================================

local function getRarityColor(rarity: string): string
	return COLORS[rarity] or COLORS.Common
end

local function hasAccessToShop(shopRarity: string): (boolean, string)
	local requiredRankName = SHOP_REQUIREMENTS[shopRarity] or "Player"
	local requiredValue    = RANK_VALUES[requiredRankName]  or 0
	local playerRankName   = player:GetAttribute("Rank")    or "Player"
	local playerValue      = RANK_VALUES[playerRankName]    or 0
	return (playerValue >= requiredValue), requiredRankName
end

local function playRestockSound()
	local sound        = Instance.new("Sound")
	sound.SoundId      = RESTOCK_AUDIO_ID
	sound.Volume       = 1
	sound.RollOffMaxDistance = 0 -- flat, non-spatial
	sound.Parent       = SoundService
	sound:Play()
	sound.Ended:Once(function() sound:Destroy() end)
end

-- ============================================================
-- NOTIFICATION STATE
--   Instead of task.cancel (unreliable on yielded threads), we
--   use an incrementing ID.  When a new notification fires it
--   bumps the ID; the old task.delay closure compares its
--   captured ID and does nothing if it no longer matches.
-- ============================================================

local notificationQueue = {}
local isDisplaying      = false

local function processQueue()
	if isDisplaying or #notificationQueue == 0 then return end
	isDisplaying = true

	local message = table.remove(notificationQueue, 1)

	notifText.Text     = message
	notifFrame.Visible = true
	playRestockSound()

	-- We use task.wait here because we want to block the queue processing
	-- for this specific notification. This ensures they show one-by-one.
	task.wait(DISPLAY_TIME)

	-- Check if there's another message before hiding, to avoid flickering
	-- if we're just going to show another one immediately.
	if #notificationQueue == 0 then
		notifFrame.Visible = false
		task.wait(0.2) -- small gap for visual clarity
	end

	isDisplaying = false
	processQueue()
end

local function showNotification(message: string)
	if not message or message == "" then return end
	table.insert(notificationQueue, message)
	task.spawn(processQueue)
end

-- ============================================================
-- MESSAGE BUILDER
-- ============================================================

local function buildMessage(arg1: string, arg2: any, arg3: any): string?
	if arg1 == "AutoRestock" then
		local rarity   = tostring(arg2 or "Common")
		local color    = getRarityColor(rarity)
		local hasAccess, requiredRank = hasAccessToShop(rarity)

		local carsList = ""
		if type(arg3) == "table" and #arg3 > 0 then
			carsList = "\n<font color=\"#FFFFFF\"><small>(" .. table.concat(arg3, ", ") .. ")</small></font>"
		end

		if hasAccess then
			return string.format(
				[[<font color="%s"><b>%s</b></font> Shop has restocked!!%s]],
				color, rarity, carsList
			)
		else
			return string.format(
				[[🔒 <font color="%s"><b>%s</b></font> Shop has restocked!!%s ]] ..
					[[(Unlock at <font color="#FF4444">%s</font>)]],
				color, rarity, carsList, requiredRank
			)
		end

	elseif arg1:lower() == "all" then
		return string.format(
			[[<font color="%s"><b>Everything has been restocked on all shops!!</b></font>]],
			COLORS.All
		)

	else
		-- Specific car restock
		local carName = arg1
		local carData = CarStats.Cars and CarStats.Cars[carName]

		if carData then
			local rarity   = carData.Rarity or "Common"
			local color    = getRarityColor(rarity)
			local nameStr  = carName

			-- Strip trailing " Car" to avoid "Galadriel Car Car"
			if nameStr:lower():sub(-4) == " car" then
				nameStr = nameStr:sub(1, -5)
			end

			return string.format(
				[[<font color="%s"><b>%s Car</b></font> has been restocked to the ]] ..
					[[<font color="%s"><b>%s</b></font> Shop!]],
				color, nameStr, color, rarity
			)
		else
			-- Fallback: car missing from CarStats
			return string.format(
				[[<font color="%s"><b>%s Car</b></font> has been restocked!]],
				COLORS.Common, carName
			)
		end
	end
end

-- ============================================================
-- PENDING QUEUE (loading-screen guard)
--   If a restock fires while the loading screen is still up we
--   hold the latest message and display it once the screen clears.
--   Only the most recent message is kept — stale restocks aren't
--   worth showing after a 30-second load.
--
--   FIX: watchLoadingEnd is now also called from the event handler
--   whenever a message is queued, so the watcher is guaranteed to
--   exist regardless of startup-timing races. A duplicate-connection
--   guard (loadingWatchConn check) prevents double-firing.
-- ============================================================

local pendingQueue = {}

local function isLoadingActive(): boolean
	return playerGui:GetAttribute("LoadingScreenActive") == true
end

local loadingWatchConn: RBXScriptConnection? = nil
local function watchLoadingEnd()
	if not isLoadingActive() then return end
	if loadingWatchConn then return end  -- already watching, don't stack connections

	loadingWatchConn = playerGui:GetAttributeChangedSignal("LoadingScreenActive"):Connect(function()
		if not isLoadingActive() then
			if loadingWatchConn then
				loadingWatchConn:Disconnect()
				loadingWatchConn = nil
			end
			
			if #pendingQueue > 0 then
				task.wait(0.5) -- brief grace period after screen fades
				for _, msg in ipairs(pendingQueue) do
					showNotification(msg)
				end
				table.clear(pendingQueue)
			end
		end
	end)
end

watchLoadingEnd() -- best-effort attempt at startup

-- ============================================================
-- EVENT HANDLER
-- ============================================================

RestockNotificationEvent.OnClientEvent:Connect(function(arg1, arg2, arg3)
	if type(arg1) ~= "string" then return end

	local ok, result = pcall(buildMessage, arg1, arg2, arg3)
	if not ok or not result then
		warn("[RestockNotification] buildMessage failed:", result)
		return
	end

	if isLoadingActive() then
		-- Loading screen is up — queue it for later
		table.insert(pendingQueue, result)
		watchLoadingEnd() -- ensure watcher is active regardless of startup timing
	else
		showNotification(result)
	end
end)
