-- ============================================================
-- RestockNotificationHandler
-- Purpose : Displays Global Shop Restock notifications from Admins.
-- Runs on : Client (StarterPlayerScripts)
-- Deps    : ReplicatedStorage.CarStats, ReplicatedStorage.RestockNotificationEvent
-- UI      : StarterGui > Notifications > RestockNotificationFrame > RestockNotification
--           (RichText MUST be enabled on the RestockNotification TextLabel)
-- ============================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players           = game:GetService("Players")
local SoundService      = game:GetService("SoundService")
local UIAudioConfig     = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

-- ============================================================
-- CONSTANTS
-- ============================================================

-- Rarity colour codes (hex, for RichText)
local COLORS = {
	Common    = "#A1A1AA",
	Uncommon  = "#00F5D4",
	Rare      = "#3A86FF",
	Epic      = "#9D4EDD",
	Legendary = "#FFBE0B",
	Mythic    = "#FF006E",
	All       = "#FFD700",
}

-- Rank access table
local RANK_VALUES = {
	["Player"] = 0, ["VIP"] = 1, ["VIP+"] = 2,
	["MVP"]    = 3, ["MVP+"] = 4, ["MVP++"] = 5,
}
local SHOP_REQUIREMENTS = {
	Common    = "Player",
	Uncommon  = "VIP",
	Rare      = "VIP+",
	Epic      = "MVP",
	Legendary = "MVP+",
	Mythic    = "MVP++",
}

local RESTOCK_AUDIO_ID = "rbxassetid://81822437427070"
local DISPLAY_TIME     = 6  -- seconds the notification stays visible

-- ============================================================
-- REFERENCES
-- ============================================================

local CarStats                 = require(ReplicatedStorage:WaitForChild("CarStats"))
local RestockNotificationEvent = ReplicatedStorage:WaitForChild("RestockNotificationEvent")

local player = Players.LocalPlayer

-- ============================================================
-- HELPERS
-- ============================================================

local function getUI()
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then return nil end

	local notificationsGui = playerGui:FindFirstChild("Notifications")
	if not notificationsGui then return nil end

	-- Ensure the notification GUI is always on top
	notificationsGui.DisplayOrder = 999999
	notificationsGui.Enabled      = true

	local notifFrame = notificationsGui:FindFirstChild("RestockNotificationFrame")
	local notifText  = notifFrame and notifFrame:FindFirstChild("RestockNotification")

	if notifFrame then
		notifFrame:SetAttribute("ExternallyManaged", true)
	end

	return notificationsGui, notifFrame, notifText
end

-- Force Z-Index management (from Master conflict)
local function bringNotificationToFront(frame, label)
	if not frame or not label then return end
	local topZIndex = 10000
	if frame:IsA("GuiObject") then
		frame.ZIndex = topZIndex
	end
	for _, inst in ipairs(frame:GetDescendants()) do
		if inst:IsA("GuiObject") then
			inst.ZIndex = topZIndex + 1
		end
	end
end

local function getRarityColor(rarity: string): string
	return COLORS[rarity] or COLORS.Common
end

local function hasAccessToShop(shopRarity: string): (boolean, string)
	local requiredRankName = SHOP_REQUIREMENTS[shopRarity] or "Player"
	local requiredValue    = RANK_VALUES[requiredRankName]  or 0
	local playerRankName   = player:GetAttribute("Rank")    or "Player"
	local playerValue      = RANK_VALUES[playerRankName]    or 0
	return (playerValue >= requiredValue), requiredRankName
end

local function playRestockSound()
	if UIAudioConfig.IsSFXMuted() then return end
	if not UIAudioConfig.ShouldPlayAction("RestockSfx", 1.0) then return end

	local sound              = Instance.new("Sound")
	sound.SoundId            = RESTOCK_AUDIO_ID
	sound.Volume             = 1
	sound.RollOffMaxDistance = 0 -- flat, non-spatial
	sound.Parent             = SoundService
	sound:Play()
	sound.Ended:Once(function() sound:Destroy() end)
end

-- ============================================================
-- NOTIFICATION STATE
-- ============================================================

local notificationQueue = {}
local isDisplaying      = false

local function processQueue()
	if isDisplaying or #notificationQueue == 0 then return end
	
	local gui, frame, label = getUI()
	if not (gui and frame and label) then
		-- UI not ready or missing, wait a bit and try again
		task.delay(1, processQueue)
		return
	end

	isDisplaying = true
	local message = table.remove(notificationQueue, 1)

	-- Resolve conflict: incorporate bringNotificationToFront
	bringNotificationToFront(frame, label)

	label.Text     = message
	label.Visible  = true
	frame.Visible  = true
	playRestockSound()

	task.wait(DISPLAY_TIME)

	if #notificationQueue == 0 then
		frame.Visible = false
		task.wait(0.2)
	end

	isDisplaying = false
	processQueue()
end

local function showNotification(message: string)
	if not message or message == "" then return end
	table.insert(notificationQueue, message)
	task.spawn(processQueue)
end

-- ============================================================
-- MESSAGE BUILDER
-- ============================================================

local function buildMessage(arg1: string, arg2: any, arg3: any, isAdmin: boolean?): string?
	-- 1. Admin Triggered Message (Highest Priority)
	if isAdmin then
		if arg1:lower() == "all" then
			return string.format(
				[[🛠️ <font color="%s"><b>EVERYTHING</b></font> has been restocked by an <font color="#FFFF00"><b>ADMIN</b></font>!! 🛠️]],
				COLORS.All
			)
		end

		local carName = arg1
		local carData = CarStats.Cars and CarStats.Cars[carName]
		local rarity = carData and carData.Rarity or "Common"
		local color = getRarityColor(rarity)

		return string.format(
			[[🛠️ <font color="%s"><b>%s</b></font> has been restocked by an <font color="#FFFF00"><b>ADMIN</b></font>!! 🛠️]],
			color, carName
		)
	end

	-- 2. Automatic / Natural Restock Logic
	local rarity = "Common"

	if arg1 == "AutoRestock" then
		rarity = tostring(arg2 or "Common")
	elseif arg1:lower() == "all" then
		return string.format(
			[[✨ <font color="%s"><b>Everything has been restocked on all shops!!</b></font> ✨]],
			COLORS.All
		)
	else
		-- Specific car restock (fallback)
		local carName = arg1
		local carData = CarStats.Cars and CarStats.Cars[carName]
		if carData then
			rarity = carData.Rarity or "Common"
		else
			-- Generic fallback
			return string.format(
				[[✨ <font color="%s"><b>A Shop</b></font> has restocked!! ✨]],
				COLORS.Common
			)
		end
	end

	local color = getRarityColor(rarity)
	local hasAccess, requiredRank = hasAccessToShop(rarity)

	if hasAccess then
		return string.format(
			[[✨ <font color="%s"><b>%s Shop</b></font> has restocked!! ✨]],
			color, rarity
		)
	else
		-- Show lock/requirement for UX
		return string.format(
			[[🔒 <font color="%s"><b>%s Shop</b></font> has restocked!! (Unlock at <font color="#FF4444">%s</font>)]],
			color, rarity, requiredRank
		)
	end
end

-- ============================================================
-- PENDING QUEUE (loading-screen guard)
-- ============================================================

local pendingQueue = {}

local function isLoadingActive(): boolean
	local playerGui = player:FindFirstChild("PlayerGui")
	return playerGui and playerGui:GetAttribute("LoadingScreenActive") == true
end

local loadingWatchConn: RBXScriptConnection? = nil
local function watchLoadingEnd()
	if not isLoadingActive() then return end
	if loadingWatchConn then return end

	local playerGui = player:WaitForChild("PlayerGui")
	loadingWatchConn = playerGui:GetAttributeChangedSignal("LoadingScreenActive"):Connect(function()
		if not isLoadingActive() then
			if loadingWatchConn then
				loadingWatchConn:Disconnect()
				loadingWatchConn = nil
			end
			
			if #pendingQueue > 0 then
				task.wait(1) -- Brief grace period after screen fades
				for _, msg in ipairs(pendingQueue) do
					showNotification(msg)
				end
				table.clear(pendingQueue)
			end
		end
	end)
end

-- ============================================================
-- EVENT HANDLER
-- ============================================================

RestockNotificationEvent.OnClientEvent:Connect(function(arg1, arg2, arg3, arg4)
	if type(arg1) ~= "string" then return end

	local isAdmin = (arg4 == true)
	local ok, result = pcall(buildMessage, arg1, arg2, arg3, isAdmin)
	if not ok or not result then
		warn("[RestockNotification] buildMessage failed:", result)
		return
	end

	if isLoadingActive() then
		table.insert(pendingQueue, result)
		watchLoadingEnd()
	else
		showNotification(result)
	end
end)
