-- Purpose: Shared helpers for car BillboardGui CPS display values.
-- Runs on: Shared ModuleScript (ReplicatedStorage)
-- Notes:
--   Displays base CPS multiplied by the owning player's current earnings multiplier.
--   Updated to survive messy car UI hierarchy:
--     - BillboardGui may be named BillboardGUI / BillbordGUI / BillBoard Tier
--     - Some cars have a Model named BillboardGui
--     - CPS label may be nested deeper than expected
--     - Some labels use Cash Per Second / Cash-Per-Second naming
--   Display format:
--     156,384/s

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))
local dedicatedFolder = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")

local CarCPSDisplayUtils = {}

local BASE_CPS_ATTR = "BaseCPS"
local MODEL_OWNER_ATTR = "CPSDisplayOwnerUserId"

local modelConnections = setmetatable({}, { __mode = "k" })
local toolStates = setmetatable({}, { __mode = "k" })

function CarCPSDisplayUtils.FormatCommas(value)
	value = math.floor(tonumber(value) or 0)
	local text = tostring(value)

	while true do
		local formatted, replacements = text:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
		text = formatted
		if replacements == 0 then break end
	end

	return text
end

function CarCPSDisplayUtils.FormatCPS(value)
	return CarCPSDisplayUtils.FormatCommas(value) .. "/s"
end

function CarCPSDisplayUtils.GetPlayerEarningsMultiplier(player)
	if not player then return 1 end

	return tonumber(player:GetAttribute("ActualEarningsMultiplier"))
		or tonumber(player:GetAttribute("RankResourceMultiplier"))
		or 1
end

local function normalizeName(name)
	name = tostring(name or "")
	name = string.lower(name)
	name = name:gsub("%s+", "")
	name = name:gsub("%-", "")
	name = name:gsub("_", "")
	return name
end

local function isLikelyCPSLabel(textLabel)
	if not textLabel or not textLabel:IsA("TextLabel") then
		return false
	end

	local normalizedName = normalizeName(textLabel.Name)

	if normalizedName == "cps" then
		return true
	end

	if normalizedName == "cashpersecond" then
		return true
	end

	local parent = textLabel.Parent
	local parentName = parent and normalizeName(parent.Name) or ""

	if parentName == "cashpersecond" then
		return true
	end

	return false
end

local function scoreCPSLabel(textLabel)
	local score = 0
	local normalizedName = normalizeName(textLabel.Name)

	if normalizedName == "cps" then
		score += 100
	end

	if normalizedName == "cashpersecond" then
		score += 80
	end

	local parent = textLabel.Parent
	if parent then
		local parentName = normalizeName(parent.Name)

		if parentName == "cashpersecond" then
			score += 60
		end

		if parentName == "body" then
			score += 20
		end
	end

	local current = textLabel.Parent
	while current do
		local currentName = normalizeName(current.Name)

		if currentName == "body" then
			score += 15
		elseif currentName == "billboardgui" then
			score += 15
		elseif currentName == "billboardtier" then
			score += 10
		elseif currentName == "billboard" then
			score += 8
		end

		current = current.Parent
	end

	return score
end

function CarCPSDisplayUtils.GetCPSLabel(carObject)
	if not carObject then
		return nil
	end

	-- 1. Try the original expected hierarchy first.
	local billboard = carObject:FindFirstChild("BillboardGui", true)
	if billboard and billboard:IsA("BillboardGui") then
		local body = billboard:FindFirstChild("Body")
		local cashPerSecond = body and body:FindFirstChild("Cash-Per-Second")
		local cpsLabel = cashPerSecond and cashPerSecond:FindFirstChild("CPS")

		if cpsLabel and cpsLabel:IsA("TextLabel") then
			return cpsLabel
		end
	end

	-- 2. Search for the best actual TextLabel named CPS / Cash-Per-Second anywhere.
	local bestLabel = nil
	local bestScore = -1

	for _, inst in ipairs(carObject:GetDescendants()) do
		if inst:IsA("TextLabel") and isLikelyCPSLabel(inst) then
			local score = scoreCPSLabel(inst)

			if score > bestScore then
				bestScore = score
				bestLabel = inst
			end
		end
	end

	if bestLabel then
		return bestLabel
	end

	-- 3. Final fallback:
	-- If there is no label named CPS, look for a TextLabel inside something named Cash-Per-Second.
	for _, inst in ipairs(carObject:GetDescendants()) do
		if inst:IsA("TextLabel") then
			local parent = inst.Parent
			while parent and parent ~= carObject do
				local parentName = normalizeName(parent.Name)
				if parentName == "cashpersecond" then
					return inst
				end
				parent = parent.Parent
			end
		end
	end

	return nil
end

local function cleanToolName(name)
	if not name or typeof(name) ~= "string" then return nil end
	return name:gsub(" Item", ""):gsub("Item", "")
end

local function parseCPSFromLabel(cpsLabel)
	local rawText = tostring(cpsLabel.Text or "")
	rawText = rawText:gsub(",", "")
	rawText = rawText:gsub("/s", "")
	rawText = rawText:gsub("per second", "")
	rawText = rawText:gsub("Per Second", "")

	local numberText = rawText:match("%-?%d+%.?%d*")
	return numberText and tonumber(numberText) or nil
end

function CarCPSDisplayUtils.GetModelBaseCPS(carModel, cpsLabel)
	local storedBase = tonumber(cpsLabel:GetAttribute(BASE_CPS_ATTR))
	if storedBase then return storedBase end

	local stats = carModel and (CarStats.GetCarStats and CarStats.GetCarStats(carModel.Name) or CarStats.Cars[carModel.Name])
	local baseCPS = stats and tonumber(stats.CPS)

	if not baseCPS then
		local cleanName = carModel and cleanToolName(carModel.Name)
		stats = cleanName and (CarStats.GetCarStats and CarStats.GetCarStats(cleanName) or CarStats.Cars[cleanName])
		baseCPS = stats and tonumber(stats.CPS)
	end

	if not baseCPS then
		baseCPS = parseCPSFromLabel(cpsLabel)
	end

	if baseCPS then
		cpsLabel:SetAttribute(BASE_CPS_ATTR, baseCPS)
	end

	return baseCPS
end

function CarCPSDisplayUtils.GetToolBaseCPS(tool, carModel, cpsLabel)
	local storedBase = tonumber(cpsLabel:GetAttribute(BASE_CPS_ATTR))
	if storedBase then return storedBase end

	local toolId = tool and tool:GetAttribute("ToolId")
	local cleanToolId = cleanToolName(toolId)
	local cleanName = tool and cleanToolName(tool.Name)
	local cleanModelName = carModel and cleanToolName(carModel.Name)

	local getStats = CarStats.GetCarStats or function(name) return CarStats.Cars[name] end
	local stats = (toolId and getStats(toolId))
		or (cleanToolId and getStats(cleanToolId))
		or (tool and getStats(tool.Name))
		or (cleanName and getStats(cleanName))
		or (carModel and getStats(carModel.Name))
		or (cleanModelName and getStats(cleanModelName))

	local baseCPS = stats and tonumber(stats.CPS)

	if not baseCPS then
		baseCPS = parseCPSFromLabel(cpsLabel)
	end

	if baseCPS then
		cpsLabel:SetAttribute(BASE_CPS_ATTR, baseCPS)
	end

	return baseCPS
end


local function getStatForObjectName(name)
	if not name then return nil end
	return (CarStats.GetCarStats and CarStats.GetCarStats(name)) or CarStats.Cars[name]
end

local function getMainPart(obj)
	if not obj then return nil end
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

local function getLinkedCarValue(pad)
	local direct = pad:FindFirstChild("LinkedCar")
	if direct then return direct.Value end

	local mainPart = getMainPart(pad)
	if mainPart then
		local linked = mainPart:FindFirstChild("LinkedCar")
		if linked then return linked.Value end
	end

	for _, child in ipairs(pad:GetChildren()) do
		local linked = child:FindFirstChild("LinkedCar")
		if linked then return linked.Value end
	end

	return nil
end

local function findPlotFromCarModel(carModel)
	local current = carModel
	while current do
		if current:FindFirstChild("Owner") or current.Name == "Tycoons" or current.Name == "TycoonLevelStorage" then
			return current.Name == "Tycoons" and nil or current
		end
		current = current.Parent
	end
	return nil
end

local function getActiveLevelFolder(plot, player)
	if not plot or not player then return nil end
	local playerBaseLevel = tonumber(player:GetAttribute("BaseLevel")) or 1
	local levelName = "Level" .. tostring(playerBaseLevel)
	local spacedLevelName = "Level " .. tostring(playerBaseLevel)
	local activeLevelFolder = plot:FindFirstChild(levelName) or plot:FindFirstChild(spacedLevelName)

	if not activeLevelFolder and dedicatedFolder and dedicatedFolder:FindFirstChild(plot.Name) then
		local storedPlot = dedicatedFolder[plot.Name]
		activeLevelFolder = storedPlot:FindFirstChild(levelName) or storedPlot:FindFirstChild(spacedLevelName)
	end

	return activeLevelFolder
end

function CarCPSDisplayUtils.GetBestPlacedBaseCPSForModel(carModel, player)
	local plot = findPlotFromCarModel(carModel)
	local activeLevelFolder = getActiveLevelFolder(plot, player)
	local padsFolder = activeLevelFolder and activeLevelFolder:FindFirstChild("Pads")
	if not padsFolder then return 0 end

	local bestBaseCPS = 0
	for _, pad in ipairs(padsFolder:GetChildren()) do
		local linkedCar = getLinkedCarValue(pad)
		if linkedCar and linkedCar.Parent then
			local stats = getStatForObjectName(linkedCar.Name)
			if stats and not CarStats.IsMythicalCar(stats) then
				bestBaseCPS = math.max(bestBaseCPS, tonumber(stats.CPS) or 0)
			end
		end
	end

	return bestBaseCPS
end

function CarCPSDisplayUtils.GetEffectiveModelBaseCPS(carModel, cpsLabel, player)
	local baseCPS = CarCPSDisplayUtils.GetModelBaseCPS(carModel, cpsLabel)
	if not baseCPS then return nil end

	local stats = carModel and getStatForObjectName(carModel.Name)
	if stats and CarStats.IsMythicalCar(stats) then
		return CarStats.CalculateEffectiveBaseCPS(stats, CarCPSDisplayUtils.GetBestPlacedBaseCPSForModel(carModel, player))
	end

	return baseCPS
end

function CarCPSDisplayUtils.UpdateModelCPSDisplay(carModel, player)
	local cpsLabel = CarCPSDisplayUtils.GetCPSLabel(carModel)
	if not cpsLabel then return end

	local baseCPS = CarCPSDisplayUtils.GetEffectiveModelBaseCPS(carModel, cpsLabel, player)
	if not baseCPS then return end

	local multiplier = CarCPSDisplayUtils.GetPlayerEarningsMultiplier(player)
	cpsLabel.Text = CarCPSDisplayUtils.FormatCPS(baseCPS * multiplier)
end

function CarCPSDisplayUtils.BindModelCPSDisplay(carModel, player)
	CarCPSDisplayUtils.UpdateModelCPSDisplay(carModel, player)
	if not carModel or not player then return end
	if carModel:GetAttribute(MODEL_OWNER_ATTR) == player.UserId and modelConnections[carModel] then return end

	if modelConnections[carModel] then
		for _, connection in ipairs(modelConnections[carModel]) do
			connection:Disconnect()
		end
		modelConnections[carModel] = nil
	end

	carModel:SetAttribute(MODEL_OWNER_ATTR, player.UserId)

	local connections = {}
	modelConnections[carModel] = connections

	local function safeUpdate()
		if carModel.Parent then
			CarCPSDisplayUtils.UpdateModelCPSDisplay(carModel, player)
		else
			if modelConnections[carModel] then
				for _, connection in ipairs(modelConnections[carModel]) do
					connection:Disconnect()
				end
				modelConnections[carModel] = nil
			end
		end
	end

	table.insert(connections, player:GetAttributeChangedSignal("ActualEarningsMultiplier"):Connect(safeUpdate))
	table.insert(connections, player:GetAttributeChangedSignal("RankResourceMultiplier"):Connect(safeUpdate))
end

local function getToolOwner(tool, playersService)
	local parent = tool and tool.Parent
	if not parent then return nil end

	if parent:IsA("Backpack") or parent:IsA("StarterGear") then
		return parent.Parent
	end

	return playersService:GetPlayerFromCharacter(parent)
end

function CarCPSDisplayUtils.UpdateToolCPSDisplay(tool, playersService)
	local carModel = tool and tool:FindFirstChildWhichIsA("Model")
	local cpsLabel = CarCPSDisplayUtils.GetCPSLabel(carModel or tool)
	if not cpsLabel then return end

	local baseCPS = CarCPSDisplayUtils.GetToolBaseCPS(tool, carModel, cpsLabel)
	if not baseCPS then return end

	local player = getToolOwner(tool, playersService)
	local multiplier = CarCPSDisplayUtils.GetPlayerEarningsMultiplier(player)

	cpsLabel.Text = CarCPSDisplayUtils.FormatCPS(baseCPS * multiplier)
end

function CarCPSDisplayUtils.BindToolCPSDisplay(tool, playersService)
	if not tool or toolStates[tool] then return end

	local state = {}
	toolStates[tool] = state

	local function disconnectPlayerConnections()
		if state.playerConnections then
			for _, connection in ipairs(state.playerConnections) do
				connection:Disconnect()
			end
		end

		state.playerConnections = nil
	end

	local function rebindPlayerMultiplier()
		disconnectPlayerConnections()

		local player = getToolOwner(tool, playersService)
		if player then
			state.playerConnections = {
				player:GetAttributeChangedSignal("ActualEarningsMultiplier"):Connect(function()
					CarCPSDisplayUtils.UpdateToolCPSDisplay(tool, playersService)
				end),

				player:GetAttributeChangedSignal("RankResourceMultiplier"):Connect(function()
					CarCPSDisplayUtils.UpdateToolCPSDisplay(tool, playersService)
				end),
			}
		end

		CarCPSDisplayUtils.UpdateToolCPSDisplay(tool, playersService)
	end

	state.ancestryConnection = tool.AncestryChanged:Connect(rebindPlayerMultiplier)

	state.toolIdConnection = tool:GetAttributeChangedSignal("ToolId"):Connect(function()
		local carModel = tool:FindFirstChildWhichIsA("Model")
		local cpsLabel = CarCPSDisplayUtils.GetCPSLabel(carModel or tool)

		if cpsLabel then
			cpsLabel:SetAttribute(BASE_CPS_ATTR, nil)
		end

		CarCPSDisplayUtils.UpdateToolCPSDisplay(tool, playersService)
	end)

	task.defer(rebindPlayerMultiplier)
end

function CarCPSDisplayUtils.RefreshPlotCPSDisplays(plot, player)
	if not plot or not player then return end
	local placedCarsFolder = plot:FindFirstChild("PlacedCars")
	if not placedCarsFolder then return end

	for _, carModel in ipairs(placedCarsFolder:GetChildren()) do
		CarCPSDisplayUtils.UpdateModelCPSDisplay(carModel, player)
	end
end

return CarCPSDisplayUtils
