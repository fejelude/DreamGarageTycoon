end)

-- ============================================================================
-- 🎬 INTERACTION FUNCTIONS
-- ============================================================================

local function setButtonsState(isActive)
	local myGui = playerGui:FindFirstChild(GUI_ID)
	if not myGui then return end
	for _, btnID in ipairs(ALL_BUTTON_IDS) do
		local btn = myGui:FindFirstChild(btnID, true)
		if btn then
			btn.Visible = isActive
			btn.Active  = isActive
		end
	end
end

local function clearConnections()
	for _, conn in pairs(buttonConnections) do
		if conn then conn:Disconnect() end
	end
	buttonConnections = {}
	for _, conn in pairs(buttonHoverConnections) do
		if conn then conn:Disconnect() end
	end
	buttonHoverConnections = {}
end

local function toggleNamedGuiObjects(shouldHide, objectName)
	if shouldHide then
		if #hiddenObjects > 0 then return end
		for _, obj in pairs(playerGui:GetDescendants()) do
			if obj:IsA("GuiObject") and obj.Name == objectName and obj.Visible then
				obj.Visible = false
				table.insert(hiddenObjects, obj)
			end
		end
	else
		for _, obj in pairs(hiddenObjects) do
			if obj and obj.Parent and obj:IsA("GuiObject") then
				obj.Visible = true
			end
		end
		hiddenObjects = {}
	end
end

local function toggleOtherGuis(shouldHide)
	if shouldHide then
		if #hiddenGuis > 0 then return end
		hiddenGuis = {}
		for _, otherGui in pairs(playerGui:GetChildren()) do
			if otherGui:IsA("ScreenGui")
				and otherGui.Name ~= GUI_ID
				and otherGui.Name ~= "LegendaryCarsAngeloUi"
				and otherGui.Name ~= "Confirmation"
				and otherGui.Enabled == true
				and otherGui.Name ~= "Balance Indicator" then

				otherGui.Enabled = false
				table.insert(hiddenGuis, otherGui)
			end
		end
	else
		for _, otherGui in pairs(hiddenGuis) do
			if otherGui and otherGui.Parent then
				otherGui.Enabled = true
			end
		end
		hiddenGuis = {}
	end
end

local function setFocusMode(active)
	toggleOtherGuis(active)
	toggleNamedGuiObjects(active, "FriendBoost")
end

local function playSound(id, vol)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol or 0.5
	s.Parent = SoundService
	s:Play()
	game.Debris:AddItem(s, 1)
end

local function getCleanTextLength(str)
	local cleanStr = string.gsub(str, "<[^>]+>", "")
	return utf8.len(cleanStr) or #cleanStr
end

-- ============================================================================
-- ✍️ TYPEWRITER
-- [FIX] Added isShopModeActive to the break guard so shop-mode dialogue
-- doesn't immediately cancel itself (isInteracting is false during shop).
-- ============================================================================
local function typewrite(label, text, onComplete)
	if not label then return end
	label.RichText = true

	if currentDialogueJob then
		pcall(task.cancel, currentDialogueJob)
		currentDialogueJob = nil
	end

	label.Text = text
	label.MaxVisibleGraphemes = 0

	local len = getCleanTextLength(text)

	currentDialogueJob = task.spawn(function()
		for i = 1, len do
			-- [FIX] Also allow typewriter to run when isShopModeActive
			if not isInteracting and not isLeaving and not isShopModeActive then break end
			label.MaxVisibleGraphemes = i
			if i % 3 == 0 then
				local s = Instance.new("Sound", SoundService)
				s.SoundId = TYPING_SOUND_ID
				s.Volume = 0.1
				s.PlayOnRemove = true
				s:Destroy()
			end
			task.wait(TYPEWRITER_SPEED)
		end
		label.MaxVisibleGraphemes = -1
		currentDialogueJob = nil

		-- [FIX] Allow callback during shop mode too (not just isInteracting)
		if onComplete and (isInteracting or isShopModeActive) then
			task.spawn(onComplete)
		end
	end)
end

-- ============================================================================
-- 🛑 STOP INTERACTION (Full reset - called on leave, character death, ForceClose)
-- [FIX] Clears isShopModeActive so the next session starts clean.
-- ============================================================================
local function stopInteraction()
	if not isInteracting and not isLeaving and not isShopModeActive then return end

	interactionGeneration += 1
	isInteracting    = false
	isLeaving        = false
	isOpeningShop    = false
	isShopModeActive = false  -- [FIX] Clear shop mode on full stop

	if currentDialogueJob then
		pcall(task.cancel, currentDialogueJob)
		currentDialogueJob = nil
	end
	if pendingShopOpenTask then
		pcall(task.cancel, pendingShopOpenTask)
		pendingShopOpenTask = nil
	end

	clearConnections()
	setFocusMode(false)

	camera.CameraType = Enum.CameraType.Custom
	if controls then controls:Enable() end

	if player.Character then
		local hrp      = player.Character:FindFirstChild("HumanoidRootPart")
		local humanoid = player.Character:FindFirstChild("Humanoid")
		if hrp      then hrp.Anchored      = false end
		if humanoid then humanoid.WalkSpeed = 16   end
	end

	local myGui = playerGui:FindFirstChild(GUI_ID)
	if myGui then
		myGui.Enabled = false
		local container = myGui:FindFirstChild(CONTAINER_ID, true)
		if container then container.Visible = false end
	end

	local craftGui = playerGui:FindFirstChild("LegendaryCarsAngeloUi")
	if craftGui and craftGui.Enabled then
		craftGui.Enabled = false
	end
end

-- ============================================================================
-- 🔓 RELEASE FOR SHOP (Partial reset - keeps player locked while shop is open)
-- [FIX] Sets isShopModeActive = true so the event handler knows to keep
-- displaying dialogue even though isInteracting is now false.
-- ============================================================================
local function releaseInteractionForShop()
	if not isInteracting then return end

	interactionGeneration += 1

	if currentDialogueJob then
		pcall(task.cancel, currentDialogueJob)
		currentDialogueJob = nil
	end
	if pendingShopOpenTask then
		pcall(task.cancel, pendingShopOpenTask)
		pendingShopOpenTask = nil
	end

	clearConnections()
	setButtonsState(false)
	setFocusMode(false)

	camera.CameraType = Enum.CameraType.Custom
	if controls then controls:Enable() end

	if player.Character then
		local hrp      = player.Character:FindFirstChild("HumanoidRootPart")
		local humanoid = player.Character:FindFirstChild("Humanoid")
		if hrp then hrp.Anchored = false end
		if humanoid then
			humanoid.WalkSpeed  = 16
			humanoid.JumpPower  = 50
		end
	end

	local myGui = playerGui:FindFirstChild(GUI_ID)
	if myGui then
		myGui.Enabled = false
		local container = myGui:FindFirstChild(CONTAINER_ID, true)
		if container then container.Visible = false end
	end

	isInteracting    = false
	isLeaving        = false
	isShopModeActive = true  -- [FIX] Shop is now driving dialogue; stay active
end

-- ============================================================================
-- 🎞️ BUTTON ANIMATIONS
-- ============================================================================
local function animateButton(btn)
	if not btn:GetAttribute("OriginalSizeX") then
		btn:SetAttribute("OriginalSizeX",  btn.Size.X.Scale)
		btn:SetAttribute("OriginalSizeXO", btn.Size.X.Offset)
		btn:SetAttribute("OriginalSizeY",  btn.Size.Y.Scale)
		btn:SetAttribute("OriginalSizeYO", btn.Size.Y.Offset)
	end

	local origX  = btn:GetAttribute("OriginalSizeX")
	local origXO = btn:GetAttribute("OriginalSizeXO")
	local origY  = btn:GetAttribute("OriginalSizeY")
	local origYO = btn:GetAttribute("OriginalSizeYO")

	local normalSize = UDim2.new(origX, origXO, origY, origYO)
	local hoverSize  = UDim2.new(origX * HOVER_SCALE, origXO * HOVER_SCALE, origY * HOVER_SCALE, origYO * HOVER_SCALE)
	local clickSize  = UDim2.new(origX * CLICK_SCALE, origXO * CLICK_SCALE, origY * CLICK_SCALE, origYO * CLICK_SCALE)

	if not UserInputService.TouchEnabled then
		local connEnter = btn.MouseEnter:Connect(function()
			playSound(HOVER_SOUND_ID, 0.5)
			TweenService:Create(btn, TweenInfo.new(ANIM_SPEED), {Size = hoverSize}):Play()
		end)
		local connLeave = btn.MouseLeave:Connect(function()
			TweenService:Create(btn, TweenInfo.new(ANIM_SPEED), {Size = normalSize}):Play()
		end)
		table.insert(buttonHoverConnections, connEnter)
		table.insert(buttonHoverConnections, connLeave)
	end

	local connDown = btn.MouseButton1Down:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.05), {Size = clickSize}):Play()
	end)
	local connUp = btn.MouseButton1Up:Connect(function()
		local target = (not UserInputService.TouchEnabled) and hoverSize or normalSize
		TweenService:Create(btn, TweenInfo.new(ANIM_SPEED, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = target}):Play()
	end)
	table.insert(buttonHoverConnections, connDown)
	table.insert(buttonHoverConnections, connUp)
end

-- ============================================================================
-- 💬 GREETING
-- ============================================================================
local GREETING_DIALOGUES = {
	"Welcome to the inner circle, ",
	"Looking to craft something extraordinary, ",
	"The legendary cars await, ",
	"I've been expecting you, "
}

-- ============================================================================
-- 🚀 START INTERACTION (Proximity Prompt triggered)
-- ============================================================================
local function startInteraction(npcModel)
	if isInteracting or isLeaving then return end

	interactionGeneration += 1
	isInteracting    = true
	isShopModeActive = false  -- Always start clean
	isOpeningShop    = false
	clearConnections()

	local camPart = npcModel:FindFirstChild(CAMERA_PART)
	if not camPart then
		warn("❌ [LegendaryAngeloDebug] Error: Missing '" .. CAMERA_PART .. "'")
		isInteracting = false
		return
	end

	if controls then controls:Disable() end
	setFocusMode(true)

	if player.Character then
		local hrp      = player.Character:FindFirstChild("HumanoidRootPart")
		local humanoid = player.Character:FindFirstChild("Humanoid")
		if humanoid then humanoid.WalkSpeed = 0 end
		if hrp then
			hrp.Velocity  = Vector3.zero
			hrp.Anchored  = true
		end
	end

	camera.CameraType = Enum.CameraType.Scriptable
	TweenService:Create(camera, TWEEN_INFO, {CFrame = camPart.CFrame}):Play()

	local myGui = playerGui:WaitForChild(GUI_ID, 5)
	if not myGui then
		warn("❌ [LegendaryAngeloDebug] Missing GUI")
		stopInteraction()
		return
	end

	myGui.Enabled = true
	local container = myGui:FindFirstChild(CONTAINER_ID, true)
	if not container then
		warn("❌ [LegendaryAngeloDebug] Missing Frame")
		stopInteraction()
		return
	end

	container.Visible = true
	setButtonsState(false)

	local dialogueLabel = container:FindFirstChild(TEXT_ID, true)
	if dialogueLabel then
		local coloredName    = "<font color='" .. USER_COLOR    .. "'>@" .. player.Name .. "</font>"
		local randomGreeting = GREETING_DIALOGUES[math.random(1, #GREETING_DIALOGUES)]
		local greeting       = randomGreeting .. coloredName .. "."

		typewrite(dialogueLabel, greeting, function()
			setButtonsState(true)
		end)

		local function connectBtn(btnName, func)
			local btn = myGui:FindFirstChild(btnName, true)
			if btn and btn:IsA("GuiButton") then
				animateButton(btn)
				local conn = btn.MouseButton1Click:Connect(function()
					playSound(CLICK_SOUND_ID, 0.5)
					func()
				end)
				table.insert(buttonConnections, conn)
			else
				warn("⚠️ [LegendaryAngeloDebug] Could not find button '" .. btnName .. "'")
			end
		end

		-- LEAVE
		connectBtn(BTN_LEAVE_ID, function()
			if isLeaving then return end
			isLeaving = true
			clearConnections()
			setButtonsState(false)
			if dialogueLabel then
				local coloredAngelo = "<font color='" .. ANGELO_COLOR .. "'>@" .. player.Name .. "</font>"
				local goodbyeMsg    = "<font color='" .. GREEN_COLOR  .. "'>Return when you are ready, </font>" .. coloredAngelo .. "!"
				typewrite(dialogueLabel, goodbyeMsg)
			end
			task.wait(LEAVE_DELAY)
			stopInteraction()
		end)

		-- INQUIRY
		connectBtn(BTN_INQUIRY_ID, function()
			setButtonsState(false)
			if dialogueLabel then
				local loreText = "To forge a Legendary vehicle, you must offer sacrifices. \nBring me specific cars and rare materials, and I will build you a masterpiece."
				typewrite(dialogueLabel, loreText, function()
					setButtonsState(true)
				end)
			end
		end)

		-- CRAFT (open shop)
		connectBtn(BTN_CRAFT_ID, function()
			if isOpeningShop then return end
			isOpeningShop = true
			setButtonsState(false)
			local openGeneration = interactionGeneration

			typewrite(dialogueLabel, CRAFT_OPEN_MESSAGE, function()
				if not isInteracting or not isOpeningShop or interactionGeneration ~= openGeneration then return end

				if pendingShopOpenTask then pcall(task.cancel, pendingShopOpenTask) end

				pendingShopOpenTask = task.spawn(function()
					task.wait(SHOP_OPEN_DELAY_SECONDS)
					if not isInteracting or not isOpeningShop or interactionGeneration ~= openGeneration then return end
					releaseInteractionForShop()
					RemoteOpen:FireServer()
				end)
			end)
		end)
	else
		warn("❌ [LegendaryAngeloDebug] Could not find TextLabel '" .. TEXT_ID .. "'")
		setButtonsState(true)
	end
end

-- ============================================================================
-- 📡 SHOP DIALOGUE EVENT HANDLER
--
-- [FIX SUMMARY]
-- Root cause: after releaseInteractionForShop(), isInteracting = false.
-- The old guard `if not isInteracting or isLeaving` caused EVERY shop event
-- (SacrificeSuccess, NotEnough, AlreadyCrafting, CraftComplete, etc.) to
-- immediately fire the callback without ever showing dialogue.
--
-- Fix:
--   1. Guard now only bails when BOTH isInteracting=false AND isShopModeActive=false.
--   2. In shop mode the NPC GUI is temporarily re-shown for the typewriter.
--   3. After typewriter completes in shop mode, NPC GUI is hidden again before
--      the callback fires (which restores mainFrame in the shop controller).
-- ============================================================================
UpdateDialogueEvent.Event:Connect(function(actionType, extraInfo, callbackEvent)

	-- ── ForceClose: hard stop regardless of mode ──────────────────────────
	if actionType == "ForceClose" then
		stopInteraction()
		if callbackEvent then callbackEvent:Fire() end
		return
	end

	-- ── [FIX] Guard: skip if neither interacting nor in shop mode ─────────
	if not isInteracting and not isShopModeActive then
		if callbackEvent then callbackEvent:Fire() end
		return
	end

	-- ── Skip if mid-leave animation ────────────────────────────────────────
	if isLeaving then
		if callbackEvent then callbackEvent:Fire() end
		return
	end

	-- ── Resolve NPC GUI ────────────────────────────────────────────────────
	local myGui = playerGui:FindFirstChild(GUI_ID)
	if not myGui then
		if callbackEvent then callbackEvent:Fire() end
		return
	end
	local container = myGui:FindFirstChild(CONTAINER_ID, true)
	if not container then
		if callbackEvent then callbackEvent:Fire() end
		return
	end
	local dialogueLabel = container:FindFirstChild(TEXT_ID, true)
	if not dialogueLabel then
		if callbackEvent then callbackEvent:Fire() end
		return
	end

	-- ── [FIX] Shop mode: temporarily re-show NPC speech bubble ────────────
	if isShopModeActive and not isInteracting then
		myGui.Enabled     = true
		container.Visible = true
		setButtonsState(false)
	end

	-- ── [FIX] After typewriter: hide NPC GUI before restoring shop frame ──
	-- This wrapper fires AFTER the typewriter animation finishes.
	local function onDialogueComplete()
		if isShopModeActive then
			myGui.Enabled     = false
			container.Visible = false
		end
		if callbackEvent then
			callbackEvent:Fire()
		end
	end

	-- ======================================================================
	-- 💬 MASTER DIALOGUE MATRIX
	-- ======================================================================
	local msg = "..."
	local coloredName = "<font color='" .. USER_COLOR .. "'>@" .. player.Name .. "</font>"

	-- ── Menu & Navigation ──────────────────────────────────────────────────
	if actionType == "MenuOpen" then
		local msgs = {
			CRAFT_OPEN_MESSAGE,
			"Take your pick. Both are engineering marvels.",
			"What do you have your eye on?"
		}
		msg = msgs[math.random(1, #msgs)]

	elseif actionType == "SelectCar" then
		local msgs = {
			"Ah, the <font color='#00E5FF'>" .. tostring(extraInfo) .. "</font>. A beautiful choice.",
			"The <font color='#00E5FF'>" .. tostring(extraInfo) .. "</font>? You have good taste.",
			"Excellent selection. Let's look at what is required."
		}
		msg = msgs[math.random(1, #msgs)]

	-- ── Sacrifice flow ─────────────────────────────────────────────────────
	elseif actionType == "ConfirmSacrifice" then
		local msgs = {
			"Are you certain? There is no going back once given.",
			"Ready to let go of this piece?",
			"Confirm the sacrifice. It is necessary."
		}
		msg = msgs[math.random(1, #msgs)]

	elseif actionType == "CancelSacrifice" then
		local msgs = {
			"Cold feet? I understand.",
			"Take your time. This isn't a decision to be rushed.",
			"Perhaps later, then."
		}
		msg = msgs[math.random(1, #msgs)]

	elseif actionType == "AlreadyDone" then
		local msgs = {
			"We already have enough of that.",
			"That requirement is already fulfilled.",
			"Save it. We don't need any more of those."
		}
		msg = msgs[math.random(1, #msgs)]

	-- 🔴 Missing item ────────────────────────────────────────────────────────
	elseif actionType == "NotEnough" then
		local itemName = extraInfo and extraInfo.itemName or "that"
		local msgs = {
			"Don't waste my time. You don't have the <font color='#00E5FF'>" .. itemName .. "</font> in your garage.",
			"Dude, you dont even have the <font color='#00E5FF'>" .. itemName .. "</font>. Come back when you actually have it.",
			"You are short on resources. I need the <font color='#00E5FF'>" .. itemName .. "</font> to proceed.",
			"I don't work for free. Bring me the <font color='#00E5FF'>" .. itemName .. "</font> first."
		}
		msg = msgs[math.random(1, #msgs)]

	-- 🟡 Sacrifice success (more still needed) ───────────────────────────────
	elseif actionType == "SacrificeSuccess" then
		local itemName  = extraInfo and extraInfo.itemName  or "that"
		local itemsLeft = extraInfo and extraInfo.itemsLeft or "?"
		local msgs = {
			"The <font color='#00E5FF'>" .. itemName .. "</font> has been stripped for parts. You still have <font color='#FFD700'>" .. itemsLeft .. "</font> more sacrifices to go.",
			"Sacrifice accepted. Bring me <font color='#FFD700'>" .. itemsLeft .. "</font> more requirements and we can begin.",
			"Alright " .. coloredName .. " thanks for the <font color='#00E5FF'>" .. itemName .. "</font>. We are getting closer, just <font color='#FFD700'>" .. itemsLeft .. "</font> more to go.",
			"Good. The chassis grows stronger. <font color='#FFD700'>" .. itemsLeft .. "</font> more pieces needed.",
			"Another piece of the puzzle. Just <font color='#FFD700'>" .. itemsLeft .. "</font> more to go before the forge is ready."
		}
		msg = msgs[math.random(1, #msgs)]

	-- 🟢 Final sacrifice (all requirements met) ──────────────────────────────
	elseif actionType == "AllComplete" then
		local carName = extraInfo and extraInfo.carName or "the car"
		local msgs = {
			"That was the last one! The <font color='#50C878'>sacrifices are complete</font>. Ready to go?",
			"Every piece is finally in place. Click confirm, and I will begin the build.",
			"We have everything we need. Nice.",
			"All requirements met. The <font color='#00E5FF'>" .. carName .. "</font> is ready to be born. Tell me when to start crafting... when you're ready."
		}
		msg = msgs[math.random(1, #msgs)]

	-- 🔥 Craft just started ───────────────────────────────────────────────────
	elseif actionType == "CraftStarted" then
		local carName = extraInfo and extraInfo.carName or "your car"
		local timeStr = extraInfo and extraInfo.timeStr or "some time"
		local msgs = {
			"Alright im working on making your <font color='#B652FF'>" .. carName .. "</font> be back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"Crafting underway homie. The <font color='#B652FF'>" .. carName .. "</font> will be ready soon, check back in <font color='#FF4C4C'>" .. timeStr .. "</font>."
		}
		msg = msgs[math.random(1, #msgs)]

	-- ⏳ Craft already in progress ────────────────────────────────────────────
