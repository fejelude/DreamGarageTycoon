local CONTAINER_ID = "Frame_Angelo_Container"
local TEXT_ID      = "Text_Angelo_Dialogue"

local BTN_CRAFT_ID   = "Btn_Angelo_Craft"
local BTN_INQUIRY_ID = "Btn_Angelo_Inquiry"
local BTN_LEAVE_ID   = "Btn_Angelo_Leave"
local ALL_BUTTON_IDS = {BTN_CRAFT_ID, BTN_INQUIRY_ID, BTN_LEAVE_ID}

-- 📍 NPC CONFIGURATION
local TARGET_NPC  = "Monk3yDAngelo-Cars"
local CAMERA_PART = "CameraAimPart"
local PROMPT_NAME = "TalkPrompt"

-- 🎥 SETTINGS
local TWEEN_INFO              = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TYPEWRITER_SPEED        = 0.02
local LEAVE_DELAY             = 1.5
local SHOP_OPEN_DELAY_SECONDS = 2.0

-- 🔊 SOUNDS
local TYPING_SOUND_ID = "rbxassetid://4676738150"
local HOVER_SOUND_ID  = "rbxassetid://6895079853"
local CLICK_SOUND_ID  = "rbxassetid://9083627113"
local CRAFT_OPEN_MESSAGE = "Select a chassis. We require great sacrifices to build these."

-- ✨ ANIMATION SETTINGS
local HOVER_SCALE = 1.1
local CLICK_SCALE = 0.9
local ANIM_SPEED  = 0.1

-- ============================================================================
-- 🛠️ STATE VARIABLES
-- ============================================================================
local isInteracting    = false
local isLeaving        = false
local isOpeningShop    = false

-- [FIX] isShopModeActive: stays true after releaseInteractionForShop() so that
-- shop-driven dialogue events (SacrificeSuccess, NotEnough, AlreadyCrafting, etc.)
-- can still display the NPC speech bubble even though isInteracting = false.
local isShopModeActive = false

local currentDialogueJob   = nil
local pendingShopOpenTask  = nil
local interactionGeneration = 0
local buttonConnections    = {}
local buttonHoverConnections = {}
local hiddenGuis   = {}
local hiddenObjects = {}
local controls = require(player.PlayerScripts:WaitForChild("PlayerModule")):GetControls()

-- Remotes
local LegendaryRemotes = ReplicatedStorage:WaitForChild("ShopRemotes"):WaitForChild("LegendaryShop")
local RemoteOpen = LegendaryRemotes:WaitForChild("RequestOpenShop")

-- Bindable Event for External Dialogue Updates
local UpdateDialogueEvent = script:FindFirstChild("UpdateLegendaryAngeloDialogue")
if not UpdateDialogueEvent then
	UpdateDialogueEvent = Instance.new("BindableEvent")
	UpdateDialogueEvent.Name = "UpdateLegendaryAngeloDialogue"
