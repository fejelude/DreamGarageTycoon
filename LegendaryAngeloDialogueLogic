		}
		msg = msgs[math.random(1, #msgs)]

	-- 🟣 Car already crafted (already in inventory) ───────────────────────────
	elseif actionType == "AlreadyCrafted" then
		local carName = extraInfo and extraInfo.carName or "your car"
		local msgs = {
			"It is finished. The <font color='#B652FF'>" .. carName .. "</font> is a true work of art. It should be in your inventory already.",
