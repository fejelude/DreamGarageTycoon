			"Construction of the <font color='#B652FF'>" .. carName .. "</font> is done. A flawless execution. It's already there in your inventory."
		}
		msg = msgs[math.random(1, #msgs)]

	-- 🟣 Craft just completed (server push notification) ──────────────────────
	elseif actionType == "CraftComplete" then
		local carName = (extraInfo and extraInfo.carName) or "your car"
		local msgs = {
			"It is finished. The <font color='#B652FF'>" .. carName .. "</font> is a true work of art. It should be in your inventory already.",
