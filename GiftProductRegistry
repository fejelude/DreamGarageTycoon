local BaseAppearanceConfig = requireOptionalConfig("BaseAppearanceConfig")
if BaseAppearanceConfig and type(BaseAppearanceConfig.GetSkinIds) == "function" and type(BaseAppearanceConfig.Get) == "function" then
	for _, skinId in ipairs(BaseAppearanceConfig.GetSkinIds()) do
		for level in pairs(BaseAppearanceConfig.Levels or {}) do
			local appearance = BaseAppearanceConfig.Get(level, skinId)
			if appearance and appearance.ProductId then
				register(appearance.ProductId, {
					Kind = "BaseAppearance",
					Giftable = true,
					DisplayName = ("%s Level %d Base Skin"):format(appearance.DisplayName or appearance.SkinId, appearance.Level),
					Level = appearance.Level,
					SkinId = appearance.SkinId,
					OwnershipKey = appearance.OwnershipKey,
				})
			end
		end
	end
end

local BaseSkinStats = requireOptionalConfig("BaseSkinStats")
if type(BaseSkinStats) == "table" then
	for skinName, data in pairs(BaseSkinStats) do
		if type(data) == "table" and data.ProductId then
			register(data.ProductId, {
				Kind = "BaseSkin",
				Giftable = true,
				DisplayName = tostring(data.Name or skinName),
				SkinName = tostring(skinName),
			})
		end
	end
end

local CashPackConfig = requireOptionalConfig("CashPackConfig")
if CashPackConfig and type(CashPackConfig.Packs) == "table" then
	for packName, packInfo in pairs(CashPackConfig.Packs) do
		register(packInfo.ProductId, {
			Kind = "CashPack",
			Giftable = packInfo.AllowGifting == true,
			DisplayName = packInfo.DisplayName or (("$%s Wallet Cash"):format(tostring(packInfo.WalletReward or 0))),
			PackName = packName,
			WalletReward = packInfo.WalletReward,
		})
	end
end

local LimitedCarsConfig = requireOptionalConfig("LimitedCarsConfig")
if LimitedCarsConfig and type(LimitedCarsConfig.Products) == "table" then
	for productKey, productInfo in pairs(LimitedCarsConfig.Products) do
		register(productInfo.ProductId, {
			Kind = "LimitedCar",
			Giftable = productInfo.AllowGifting == true,
			DisplayName = productInfo.DisplayName or productInfo.CarId or productKey,
			ProductKey = productKey,
			CarName = productInfo.CarId,
		})
	end
end

function Registry.GetByProductId(productId)
	productId = normalizeProductId(productId)
	return productId and productsById[productId] or nil
end

function Registry.IsGiftable(productId)
	local entry = Registry.GetByProductId(productId)
	return entry ~= nil and entry.Giftable == true
end

function Registry.GetDisplayName(productId)
	local entry = Registry.GetByProductId(productId)
	return entry and entry.DisplayName or "Selected Product"
end

function Registry.GetAllProducts()
	local copy = {}
	for productId, entry in pairs(productsById) do
		copy[productId] = table.clone(entry)
	end
	return copy
end

return Registry
