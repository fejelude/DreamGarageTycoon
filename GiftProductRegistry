-- Purpose: Shared, data-driven registry for Developer Products that may use UniversalGiftUI.
-- Location: ReplicatedStorage > GiftProductRegistry (ModuleScript)
-- Notes:
--   Add future giftable products here (or from config modules required below) so
--   GiftUIController, GiftIntentHandler, and ReceiptRouter share one source of truth.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Registry = {}
local productsById = {}

local function normalizeProductId(productId)
	productId = math.floor(tonumber(productId) or 0)
	if productId <= 0 then
		return nil
	end
	return productId
end

local function register(productId, info)
	productId = normalizeProductId(productId)
	if not productId or type(info) ~= "table" then
		return
	end

	local entry = table.clone(info)
	entry.ProductId = productId
	entry.DisplayName = tostring(entry.DisplayName or entry.Name or ("Product " .. tostring(productId)))
	entry.Kind = tostring(entry.Kind or "DeveloperProduct")
	entry.Giftable = entry.Giftable == true
	productsById[productId] = entry
end

local function requireOptionalConfig(moduleName)
	local moduleScript = ReplicatedStorage:FindFirstChild(moduleName)
	if not moduleScript or not moduleScript:IsA("ModuleScript") then
		return nil
	end

	local ok, result = pcall(function()
		return require(moduleScript)
	end)

	if ok then
		return result
	end

	warn("⚠️ [GiftProductRegistry] Failed to require " .. moduleName .. ": " .. tostring(result))
	return nil
end

local function registerCarProducts(productMap, rarity, feedbackRemoteName)
	for productId, carName in pairs(productMap) do
		register(productId, {
			Kind = "Car",
			Giftable = true,
			DisplayName = tostring(carName),
			CarName = tostring(carName),
			Rarity = rarity,
			FeedbackRemoteName = feedbackRemoteName,
		})
	end
end

