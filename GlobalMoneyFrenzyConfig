-- ModuleScript: ReplicatedStorage > GlobalMoneyFrenzyConfig
local GlobalMoneyFrenzyConfig = {}

GlobalMoneyFrenzyConfig.ProductId = 3610446789
GlobalMoneyFrenzyConfig.DurationSeconds = 2 * 60 * 60
GlobalMoneyFrenzyConfig.BaseMultiplier = 1
GlobalMoneyFrenzyConfig.ActiveMultiplier = 2
GlobalMoneyFrenzyConfig.TopicName = "GlobalMoneyFrenzyStateV1"
GlobalMoneyFrenzyConfig.StateStoreName = "GlobalMoneyFrenzyState_V1"
GlobalMoneyFrenzyConfig.ReceiptStoreName = "GlobalMoneyFrenzyReceiptHistory_V1"
GlobalMoneyFrenzyConfig.StateKey = "Current"

function GlobalMoneyFrenzyConfig.FormatMultiplier(multiplier)
	multiplier = tonumber(multiplier) or GlobalMoneyFrenzyConfig.BaseMultiplier
	if multiplier % 1 == 0 then
		return tostring(multiplier) .. "x"
	end
	return string.format("%.2fx", multiplier)
end

function GlobalMoneyFrenzyConfig.GetActiveMultiplier()
	return GlobalMoneyFrenzyConfig.ActiveMultiplier
end

return GlobalMoneyFrenzyConfig
