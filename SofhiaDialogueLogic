-- ============================================================================
local function getInventorySellTotal()
	local totalValue = 0
	local totalCount = 0
	local seen = {}

	local function scan(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Tool") and child:GetAttribute("IssuedByServer") == true and not seen[child] then
				local toolId = child:GetAttribute("ToolId") or child.Name
				local details = CarSellPrices.GetDetails(toolId)
				if details and details.SellPrice and details.SellPrice > 0 then
					seen[child] = true
					totalValue += details.SellPrice
					totalCount += 1
				end
			end
		end
	end

	scan(player:FindFirstChild("Backpack"))
	if player.Character then scan(player.Character) end

	return totalValue, totalCount
end

local function handleSellEverything(dialogueLabel)
	if isProcessingSell then return end

	local totalValue, carCount = getInventorySellTotal()
	if carCount <= 0 or totalValue <= 0 then
		typewrite(dialogueLabel, chooseDialogue("NoCars"), function()
			isProcessingSell = false
			task.wait(2)
			stopInteraction()
		end)
		return
	end

	isProcessingSell = true

	local carWord = carCount == 1 and "car" or "cars"
	local confirmText = string.format(
		"<font color='%s'>Are you sure you want to sell all </font><b><font color='%s'>%d inventory %s</font></b><font color='%s'> for </font><b><font color='%s'>$%s</font></b><font color='%s'>? This cannot be undone, sweetie.</font>",
		CONFIRMATION_COLORS.Accent, CONFIRMATION_COLORS.Target, carCount, carWord,
		CONFIRMATION_COLORS.Accent, CONFIRMATION_COLORS.Sacrifice, FormatCommas(totalValue),
		CONFIRMATION_COLORS.Accent
	)

	PromptConfirmation(confirmText, function(confirmed)
		if not isInteracting then return end

		if not confirmed then
			typewrite(dialogueLabel, "That's perfectly okay, darling~ Nothing has been sold. Take all the time you need. 💖", function()
				isProcessingSell = false
				task.wait(1.5)
				stopInteraction()
			end)
			return
		end

		task.spawn(function()
			-- A client timeout cannot cancel an already-running server mutation.
			-- Wait for the authoritative committed result so the UI never reports
			-- failure while a sale is still able to complete.
			local success, msg, serverSellAmount, serverCarCount = SellFunction:InvokeServer("SellAllCars")

			if not isInteracting then return end

			if success then
				UIAudioConfig.PlayClick()
				local soldCount = tonumber(serverCarCount) or carCount
				local soldAmount = tonumber(serverSellAmount) or totalValue
				local soldWord = soldCount == 1 and "car" or "cars"
				local successText = string.format(chooseDialogue("SellAllSuccess"), soldCount, soldWord, PRICE_COLOR, FormatCommas(soldAmount))
				typewrite(dialogueLabel, successText, function()
					isProcessingSell = false
					task.wait(1.5)
					stopInteraction()
				end)
			else
				typewrite(dialogueLabel, string.format(chooseDialogue("Failure"), msg or "Please try again later."), function()
					isProcessingSell = false
					task.wait(2)
					stopInteraction()
				end)
			end
		end)
	end)
end

local function handleSell(dialogueLabel)
	if isProcessingSell then return end

	local equippedCarId = getEquippedCar()
	if not equippedCarId then
		-- No car equipped
		typewrite(dialogueLabel, chooseDialogue("NoEquippedCar"), function()
			task.wait(2)
			stopInteraction()
		end)
		return
	end

	local details = CarSellPrices.GetDetails(equippedCarId)
	if not details then
		-- Unknown item
		typewrite(dialogueLabel, chooseDialogue("UnknownItem"), function()
			task.wait(2)
			stopInteraction()
		end)
		return
	end

	isProcessingSell = true

	local confirmText = string.format(
		"<font color='%s'>Are you absolutely sure, darling~? 💔 You wish to sell your </font><b><font color='%s'>%s</font></b><font color='%s'> for </font><b><font color='%s'>$%s</font></b><font color='%s'>? This cannot be undone~</font>",
		CONFIRMATION_COLORS.Accent, CONFIRMATION_COLORS.Target, escapeRichText(details.Name),
		CONFIRMATION_COLORS.Accent, CONFIRMATION_COLORS.Sacrifice, FormatCommas(details.SellPrice),
		CONFIRMATION_COLORS.Accent
	)

	PromptConfirmation(confirmText, function(confirmed)
		if not isInteracting then return end

		if not confirmed then
			typewrite(dialogueLabel, "Oh, changed your mind~? That's perfectly fine, darling 💅 Take all the time you need~", function()
				isProcessingSell = false
				task.wait(1.5)
				stopInteraction()
			end)
			return
		end

		-- Confirmed, execute sell via server with a timeout protection
		task.spawn(function()
			-- FIX (Stale Car ID): Re-read equipped car in case the player
			-- switched tools while the confirmation dialog was open.
			local freshCarId = getEquippedCar()
			if not freshCarId or CarSellPrices.CleanId(freshCarId) ~= CarSellPrices.CleanId(equippedCarId) then
				typewrite(dialogueLabel, "Oh my~ It seems you changed what you're holding, darling. Let's start over~ 🌸", function()
					isProcessingSell = false
					task.wait(2)
					stopInteraction()
				end)
				return
			end

			local success, msg = SellFunction:InvokeServer(equippedCarId)

			if not isInteracting then return end

			if success then
				UIAudioConfig.PlayClick()
				typewrite(dialogueLabel, chooseDialogue("SellOneSuccess"), function()
					isProcessingSell = false
					task.wait(1.5)
					stopInteraction()
				end)
			else
				typewrite(dialogueLabel, string.format(chooseDialogue("Failure"), msg or "Please try again later."), function()
					isProcessingSell = false
					task.wait(2)
					stopInteraction()
				end)
			end
		end)
	end)
end

-- ============================================================================
-- 🟢 MAIN INTERACTION START
-- ============================================================================
local function startInteraction(npcModel)
	if isInteracting or isLeaving then return end

	-- Safety clear in case a previous interaction didn't clean up properly
	stopInteraction()

	isInteracting = true
	isProcessingSell = false
	clearConnections()

	local camPart = npcModel:FindFirstChild(CAMERA_PART)
	if not camPart then
		warn("❌ [SofhiaDebug] Error: Missing '" .. CAMERA_PART .. "'")
		isInteracting = false
		return
	end

	if controls then controls:Disable() end
	setFocusMode(true)

	if player.Character then
		player:SetAttribute("MovementLock", true)
	end

	camera.CameraType = Enum.CameraType.Scriptable
	TweenService:Create(camera, TWEEN_INFO, {CFrame = camPart.CFrame}):Play()

	local myGui = playerGui:WaitForChild(GUI_ID, 5)
	if not myGui then warn("❌ [SofhiaDebug] Missing GUI") stopInteraction() return end

	myGui.Enabled = true
	local container = myGui:FindFirstChild(CONTAINER_ID, true)
	if not container then warn("❌ [SofhiaDebug] Missing Frame") stopInteraction() return end

	container.Visible = true
	setButtonsState(false)

	local dialogueLabel = container:FindFirstChild(TEXT_ID, true)
	if dialogueLabel then
		local greeting = chooseDialogue("Greeting")

		typewrite(dialogueLabel, greeting, function()
			setButtonsState(true)
		end)

		local function connectBtn(btnName, func)
			local buttons = container:FindFirstChild(BUTTONS_FOLDER)
			local btn = buttons and buttons:FindFirstChild(btnName, true)
			if btn and btn:IsA("GuiButton") then
				animateButton(btn)

				local conn
				if UserInputService.TouchEnabled then
					conn = btn.Activated:Connect(function()
						UIAudioConfig.PlayClick()
						func()
					end)
				else
					conn = btn.MouseButton1Click:Connect(function()
						UIAudioConfig.PlayClick()
						func()
					end)
				end

				table.insert(buttonConnections, conn)
			else
				warn("⚠️ [SofhiaDebug] Warning: Could not find button '" .. btnName .. "' in UI.")
			end
		end

		connectBtn(BTN_LEAVE_ID, function()
			if isLeaving then return end
			isLeaving = true
			clearConnections()
			setButtonsState(false)
			if dialogueLabel then
				local goodbyeMsg = "Toodles~! 🌸 Do come back anytime, darling. My doors are always open for a lovely customer like you~ 💖"
				typewrite(dialogueLabel, goodbyeMsg)
			end
			task.wait(LEAVE_DELAY)
			stopInteraction()
		end)

		connectBtn(BTN_SELL_EVERYTHING_ID, function()
			setButtonsState(false)
			handleSellEverything(dialogueLabel)
		end)

		connectBtn(BTN_SELL_ID, function()
			setButtonsState(false)
			handleSell(dialogueLabel)
		end)
	else
		warn("❌ [SofhiaDebug] ERROR: Could not find TextLabel named '" .. TEXT_ID .. "' inside Container!")
		setButtonsState(true)
	end
end

-- ============================================================================
-- 🔌 PROXIMITY PROMPT SETUP
-- ============================================================================
local ProximityPromptService = game:GetService("ProximityPromptService")

local function isTargetPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then return false end
	return string.lower(prompt.Name) == string.lower(PROMPT_NAME)
end

local function findTargetNPCFromPrompt(prompt)
	local current = prompt and prompt.Parent
	while current do
		if current:IsA("Model") and string.find(current.Name, TARGET_NPC) then return current end
		current = current.Parent
	end
	return nil
end

local function setupNPC()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, triggerPlayer)
		if triggerPlayer == player and isTargetPrompt(prompt) then
			local npc = findTargetNPCFromPrompt(prompt)
			if npc and string.find(npc.Name, TARGET_NPC) then
				startInteraction(npc)
			end
		end
	end)
end

setupNPC()

player.CharacterAdded:Connect(function()
	stopInteraction()
end)
