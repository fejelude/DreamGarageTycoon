local lastDialogueIndexes = {}
local function chooseDialogue(category)
	local choices = DIALOGUES[category]
	if not choices or #choices == 0 then return "" end
	local index = math.random(1, #choices)
	if #choices > 1 and index == lastDialogueIndexes[category] then
		index = (index % #choices) + 1
	end
	lastDialogueIndexes[category] = index
	return choices[index]
end

