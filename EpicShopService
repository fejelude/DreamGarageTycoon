-- =========================
-- STATE
-- =========================
local PlayerSessions   = {}
local PurchaseLocks    = {}
local LastPurchaseTime = {}

local function normalizePurchased(raw)
	if type(raw) ~= "table" then return {} end
	local normalized = {}
	for car, count in pairs(raw) do
		if type(count) == "number" and count > 0 then
			normalized[car] = math.floor(count)
		end
	end
	return normalized
end

-- =========================
-- TIMEOUT UTILITY
-- =========================
local function safeInvoke(bindable, timeout, ...)
	local args     = table.pack(...)
	local result = table.pack(pcall(function()
		return bindable:Invoke(table.unpack(args, 1, args.n))
	end))
	if not result[1] then return false, result[2] end
	return true, table.unpack(result, 2, result.n)
end

local function recordRankPurchase(player, carName, operationId)
	local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
	if not rankApi or not rankApi:IsA("BindableFunction") then return false end
	local ok, result = pcall(function()
		return rankApi:Invoke("CarObtained", player, carName, "Buy", "Epic", operationId)
	end)
	if not ok or result ~= true then
		warn("[EpicShopService] Rank progress failed for operation " .. tostring(operationId))
		return false
	end
	return true
end

local REQUIRED_RANK = RankConfig.GetRequiredRankForShop("Epic")

local function hasRequiredRank(player)
	return RankConfig.PlayerMeetsRank(player:GetAttribute("Rank") or RankConfig.DefaultRankName, REQUIRED_RANK)
end

-- =========================
-- SHOP LOGIC
-- =========================
local function getGlobalSeedID()
	return math.floor(os.time() / RESTOCK_INTERVAL)
end

local function generateStockConfiguration(seedValue)
	local rng           = Random.new(seedValue)
	local featuredFlags = {}
	local stockLimits   = {}
	local poolKeys      = {}
	local poolWeights   = {}
	local totalWeight   = 0

	local luckMultiplier = GlobalLuckService.GetMultiplier()
	local luckAdjustedWeights = GlobalLuckUtil.ApplyToWeights(CAR_WEIGHTS, luckMultiplier)
	local sortedCarNames = {}
	for name in pairs(luckAdjustedWeights) do table.insert(sortedCarNames, name) end
	table.sort(sortedCarNames)
	for _, name in ipairs(sortedCarNames) do
		local weight = luckAdjustedWeights[name]
		table.insert(poolKeys, name)
		poolWeights[name] = weight
		totalWeight += weight
	end

	if totalWeight <= 0 or #poolKeys == 0 then
		return { Featured = featuredFlags, Limits = stockLimits }
	end

	-- Dopamine-driven variable rewards & near-miss mechanics
	-- Pick 1 to 3 cars to be featured
	local numToPick = 1
	local multiRoll = rng:NextNumber()
	if multiRoll > 0.95 then
		numToPick = 3
	elseif multiRoll > 0.80 then
		numToPick = 2
	end

	local tempPoolKeys = {}
	for _, k in ipairs(poolKeys) do table.insert(tempPoolKeys, k) end

	for i = 1, numToPick do
		if #tempPoolKeys == 0 then break end

		local currentTotalWeight = 0
		for _, car in ipairs(tempPoolKeys) do
			currentTotalWeight += poolWeights[car]
		end

		local roll = rng:NextInteger(1, currentTotalWeight)
		local current = 0
		local pickedIdx = nil
		local picked = nil

		for idx, car in ipairs(tempPoolKeys) do
			current += poolWeights[car]
			if roll <= current then
				picked = car
				pickedIdx = idx
				break
			end
		end

		if picked then
			table.remove(tempPoolKeys, pickedIdx)
			featuredFlags[picked] = true

			-- Variable stock and near-miss
			local stockRoll = rng:NextNumber()
			if stockRoll > 0.98 then
				-- Near miss! Appears sold out immediately
				stockLimits[picked] = 0
			elseif stockRoll > 0.90 then
				-- Jackpot! More stock
				stockLimits[picked] = MAX_STOCK + rng:NextInteger(1, 2)
			else
				stockLimits[picked] = MAX_STOCK
			end
		end
	end

	return { Featured = featuredFlags, Limits = stockLimits }
end

local function calculateCurrentStock(limits, purchasedCounts)
	local current = {}
	for car, limit in pairs(limits) do
		local bought = purchasedCounts[car] or 0
		local left   = math.max(0, limit - bought)
		current[car] = left
	end
	return current
end

local function getSession(player)
	local uid             = player.UserId
	local currentGlobalID = getGlobalSeedID()

	if not PlayerSessions[uid] then
		PlayerSessions[uid] = {
			SeedVersion = currentGlobalID,
			LocalSeed   = nil,
			Purchased   = {},
			Cache       = nil,
			LuckGeneration = GlobalLuckService.GetGeneration(),
			RerollOperations = {},
		}
	end

	local session  = PlayerSessions[uid]
	local didReset = false
	local luckGeneration = GlobalLuckService.GetGeneration()

	if session.LuckGeneration ~= luckGeneration then
		session.LuckGeneration = luckGeneration
		session.Cache = nil
	end

	if session.SeedVersion ~= currentGlobalID then
		session.SeedVersion = currentGlobalID
		session.LocalSeed   = nil
		session.Purchased   = {}
		session.Cache       = generateStockConfiguration(session.SeedVersion)
		didReset            = true
	end

	if not session.Cache then
		local seed    = session.LocalSeed or session.SeedVersion
		session.Cache = generateStockConfiguration(seed)
	end

	return session, didReset
end

local function buildStatePayload(session)
	local config       = session.Cache
	local currentStock = calculateCurrentStock(config.Limits, session.Purchased)
	return {
		Featured    = config.Featured,
		StockLimit  = config.Limits,
		Stock       = currentStock,
		Purchased   = session.Purchased,
		NextRestock = (getGlobalSeedID() + 1) * RESTOCK_INTERVAL,
		IsGlobal    = (session.LocalSeed == nil),
	}
end

local function pushUpdate(player, session, reason)
	local payload  = buildStatePayload(session)
	payload.Reason = reason
	RemoteUpdate:FireClient(player, payload)
end

-- =========================
-- DATA HANDLER INTEGRATION
-- =========================
PersistenceBindable.OnInvoke = function(action, player, data)
	if not player then return end
	local uid = player.UserId

	if action == "Load" then
		local session, didReset = getSession(player)
		if type(data) == "table" then
			-- FIX: Removed the `data.SeedVersion and` short-circuit guard.
			-- nil SeedVersion (old save format) now correctly triggers a reset
			-- instead of falling through and restoring stale purchases.
			if data.SeedVersion ~= session.SeedVersion then
				session.Purchased = {}
				session.LocalSeed = nil
				session.Cache     = generateStockConfiguration(session.SeedVersion)
			else
				session.Purchased = type(data.Purchased) == "table"
					and normalizePurchased(data.Purchased)
					or  normalizePurchased(data)

				if type(data.LocalSeed) == "number" then
					session.LocalSeed = data.LocalSeed
					session.Cache     = generateStockConfiguration(session.LocalSeed)
				else
					session.LocalSeed = nil
					session.Cache     = generateStockConfiguration(session.SeedVersion)
				end
			end
			print("✅ [EpicShop] Loaded purchases for " .. player.Name)
		elseif didReset then
			session.Purchased = {}
			session.LocalSeed = nil
			session.Cache     = generateStockConfiguration(session.SeedVersion)
		end

	elseif action == "Get" then
		local session, _ = getSession(player)
		return {
			SeedVersion = session.SeedVersion,
			LocalSeed   = session.LocalSeed,
			Purchased   = session.Purchased,
		}

	elseif action == "Close" then
		PlayerSessions[uid]   = nil
		PurchaseLocks[uid]    = nil
		LastPurchaseTime[uid] = nil
	end
end

-- =========================
-- CLIENT REQUESTS
-- =========================
FuncGetState.OnServerInvoke = function(player)
	local session, didReset = getSession(player)
	return buildStatePayload(session)
end

RemoteOpen.OnServerEvent:Connect(function(player)
	local char = player.Character
	if not char or not char.PrimaryPart then return end

	local npcs     = workspace:FindFirstChild("NPCS")
	local rayw     = npcs and npcs:FindFirstChild("RayW")
	local raywRoot = rayw and rayw:FindFirstChild("HumanoidRootPart")
	if not raywRoot then return end

	local distance = (char.PrimaryPart.Position - raywRoot.Position).Magnitude
	if distance <= MAX_INTERACTION_DISTANCE then
		if not hasRequiredRank(player) then return end
		local session = getSession(player)
		pushUpdate(player, session, "Open")
		RemoteOpen:FireClient(player)
	else
		warn(string.format(
			"🛡️ [Security] %s attempted to open Epic Shop from %d studs away.",
			player.Name, math.floor(distance)
			))
	end
end)

FuncBuyCar.OnServerInvoke = function(player, carName)
	if typeof(carName) ~= "string"     then return false, "Invalid Car"      end
	if #carName > 80                   then return false, "Invalid Car"      end
	if not player or not player.Parent then return false, "Player missing"   end

	local char = player.Character
	if not char or not char.PrimaryPart then return false, "Character missing" end

	local npcs     = workspace:FindFirstChild("NPCS")
	local rayw     = npcs and npcs:FindFirstChild("RayW")
	local raywRoot = rayw and rayw:FindFirstChild("HumanoidRootPart")
	if not raywRoot then return false, "NPC missing" end

	local distance = (char.PrimaryPart.Position - raywRoot.Position).Magnitude
	if distance > MAX_INTERACTION_DISTANCE then
		warn(string.format(
			"🛡️ [Security] %s attempted to BUY from %d studs away.",
			player.Name, math.floor(distance)
			))
		return false, "Too far away!"
	end

	if not CAR_WEIGHTS[carName] and not ALWAYS_STOCK[carName] then
		return false, "Invalid Epic Car"
	end

	if not hasRequiredRank(player) then return false, "Rank requirement not met" end

	local uid = player.UserId
	if PurchaseLocks[uid] then return false, "Purchase in progress" end
	if (os.clock() - (LastPurchaseTime[uid] or 0)) < PURCHASE_COOLDOWN then
		return false, "Slow down"
	end

	PurchaseLocks[uid] = true

	local pOk, logicOk, msg = pcall(function()
		return PlayerTransactionCoordinator.Run(player, "EpicShopPurchase", function()
		local session, didReset = getSession(player)
		if didReset then pushUpdate(player, session, "Auto") end

		local config    = session.Cache
		local carsTable = CarStats and CarStats.Cars
		if not carsTable then return false, "CarStats Error" end

		local carData = carsTable[carName]
		if not carData or not config.Featured[carName] then return false, "Invalid Car" end

		local bought = session.Purchased[carName] or 0
		local limit  = config.Limits[carName] or 0
		if bought >= limit then return false, "Out of Stock" end

		local ls     = player:FindFirstChild("leaderstats")
		local wallet = ls and ls:FindFirstChild("Wallet")
		if not wallet                   then return false, "Wallet Not Found" end
		if wallet.Value < carData.Price then return false, "Insufficient Cash (Withdraw from ATM)" end

		local toolsFolder = ServerStorage:FindFirstChild("CarTools")
		local toolSource = nil
		if toolsFolder then
			local rarityFolder = toolsFolder:FindFirstChild(carData.Rarity)
			if rarityFolder then
				toolSource = rarityFolder:FindFirstChild(carName) or rarityFolder:FindFirstChild(carName .. " Item")
			end
		end
		if not toolSource then return false, "System Error: Tool Missing" end

		local TycoonAdminAPI = ServerStorage:FindFirstChild("TycoonAdminAPI")
		if not TycoonAdminAPI then return false, "System Error: Admin API Missing" end

		local invokeOk, giveResult = safeInvoke(TycoonAdminAPI, 3, "GiveTool", player, toolSource.Name)
		if not invokeOk or giveResult ~= true then
			warn("⚠️ [EpicShop] TycoonAdminAPI grant failed for", player.Name)
			return false, giveResult == "Car storage full" and "Car Storage Full" or "System Error: Inventory Grant Failed"
		end

		wallet.Value -= carData.Price
		session.Purchased[carName] = bought + 1
		local rankOperationId = string.format(
			"ShopPurchase:Epic:%d:%s:%s:%d",
			player.UserId, tostring(session.LocalSeed or session.SeedVersion), carName, bought + 1
		)
		recordRankPurchase(player, carName, rankOperationId)
		pushUpdate(player, session, "Purchase")

		RayWFeedback:FireClient(player, carName)

		task.spawn(function()
			safeInvoke(TycoonAdminAPI, 2, "MarkDirty", player)
		end)

		return true, "Success"
		end)
	end)

	PurchaseLocks[uid] = nil

	if not pOk then
		warn("Epic Shop Buy Error:", logicOk)
		return false, "Internal System Error"
	end

	if logicOk == true then LastPurchaseTime[uid] = os.clock() end
	return logicOk, msg
end

-- =========================
-- REROLL & ROTATION
-- =========================
function RerollBindable.OnInvoke(player, purchaseId)
	if not player or not player.Parent then return false end
	purchaseId = type(purchaseId) == "string" and purchaseId or ""
	if purchaseId == "" then return false, "Missing reroll receipt identity" end
	local session         = getSession(player)
	session.RerollOperations = session.RerollOperations or {}
	if session.RerollOperations[purchaseId] then return true, "Already rerolled" end
	session.LocalSeed     = math.random(1, 999999999)
	session.Purchased     = {}
	session.Cache         = generateStockConfiguration(session.LocalSeed)
	session.RerollOperations[purchaseId] = true
	pushUpdate(player, session, "Reroll")
	return true
end

-- =========================
-- ADMIN RESTOCK HANDLER
-- =========================
AdminRestockEvent.Event:Connect(function(carName)
	if type(carName) ~= "string" then return end

	local isAll = (carName == "all")
	local isMine = CAR_WEIGHTS[carName] ~= nil

	if not isAll and not isMine then return end

	print("🔄 [EpicShop] Processing Admin Restock for:", carName)

	for _, player in ipairs(Players:GetPlayers()) do
		local session = getSession(player)
		local config = session.Cache

		if isAll then
			for cName, _ in pairs(CAR_WEIGHTS) do
				config.Featured[cName] = true
				config.Limits[cName] = MAX_STOCK
				session.Purchased[cName] = 0
			end
		else
			config.Featured[carName] = true
			config.Limits[carName] = MAX_STOCK
			session.Purchased[carName] = 0
		end

		pushUpdate(player, session, "AdminRestock")
	end
end)

local RestockNotificationEvent = ReplicatedStorage:FindFirstChild("RestockNotificationEvent")

task.spawn(function()
	local lastGlobalID = getGlobalSeedID()
	while true do
		task.wait(1)
		local currentID = getGlobalSeedID()
		if currentID ~= lastGlobalID then
			lastGlobalID = currentID
			print("🔄 [EpicShop] GLOBAL ROTATION")
			for _, player in ipairs(Players:GetPlayers()) do
				-- FIX: Always push to all players on rotation, regardless of didReset.
				-- Autosave calling getSession() before this loop can silently consume
				-- didReset=true, causing this loop to skip pushUpdate and leave clients stale.
				local session = getSession(player)
				pushUpdate(player, session, "Auto")
			end
			if RestockNotificationEvent then
				local config = generateStockConfiguration(currentID)
				local featuredNames = {}
				for name, _ in pairs(config.Featured) do
					table.insert(featuredNames, name)
				end
				RestockNotificationEvent:FireAllClients("AutoRestock", "Epic", featuredNames)
			end
		end
	end
end)
