-- =========================
-- EPIC CONFIG
-- =========================
local CAR_WEIGHTS = {
	Razor = 70,
	Apollo = 50,
	Sovereign = 35,
	Sirene = 20,
	Classy = 10,
	Shaguar = 5,
	Vortex = 1
}
local ALWAYS_STOCK   = {}

local RESTOCK_INTERVAL        = 14400
local PURCHASE_COOLDOWN       = 1.0
local MAX_STOCK               = 1
local MAX_INTERACTION_DISTANCE = 20

