-- Purpose: Shared, authoritative identities for the Base and Robux Exclusive Index categories.
-- Location: ReplicatedStorage > IndexConfig

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))
local LimitedCarsConfig = require(ReplicatedStorage:WaitForChild("LimitedCarsConfig"))
local GiftProductRegistry = require(ReplicatedStorage:WaitForChild("GiftProductRegistry"))

local IndexConfig = {}

function IndexConfig.NormalizeBaseCarId(value)
	if type(value) ~= "string" then return nil end
	local unwrapped = value:match("^Exclusive %((.+)%)$") or value
	unwrapped = unwrapped:gsub(" Item$", "")
	return CarStats.GetCarId(unwrapped)
end

function IndexConfig.GetExclusiveId(baseCarId)
	local normalized = IndexConfig.NormalizeBaseCarId(baseCarId)
	return normalized and ("Exclusive (" .. normalized .. ")") or nil
end

function IndexConfig.GetExclusiveEntries()
	local entries, seen = {}, {}
	local limitedMetadataByCarId = {}
	for _, product in pairs(LimitedCarsConfig.Products or {}) do
		local baseCarId = IndexConfig.NormalizeBaseCarId(product.CarId)
		if baseCarId then limitedMetadataByCarId[baseCarId] = product end
	end

	-- GiftProductRegistry is also the receipt router's shared source of truth for
	-- every standard shop Developer Product car. LimitedCarsConfig contributes
	-- the globally-limited routes registered by that same registry.
	for _, product in pairs(GiftProductRegistry.GetAllProducts()) do
		local isCarProduct = product.Kind == "Car" or product.Kind == "LimitedCar"
		local baseCarId = isCarProduct and IndexConfig.NormalizeBaseCarId(product.CarName) or nil
		local stats = baseCarId and CarStats.Cars[baseCarId]
		if stats and not seen[baseCarId] then
			local limitedMetadata = limitedMetadataByCarId[baseCarId]
			seen[baseCarId] = true
			table.insert(entries, {
				Key = IndexConfig.GetExclusiveId(baseCarId),
				BaseCarId = baseCarId,
				Data = {
					-- Presentation-only label; the Key remains the persisted Exclusive identity.
					Name = "🌟 " .. baseCarId,
					-- CarStats drives the Normal Index styling, so using it here guarantees
					-- Exclusive variants receive the exact same rarity gradient/background.
					Rarity = stats.Rarity,
					Price = (limitedMetadata and limitedMetadata.RobuxPrice) or stats.Price,
					Image = (limitedMetadata and limitedMetadata.ExclusiveImage) or stats.Image,
				},
			})
		end
	end
	return entries
end

function IndexConfig.IsSupportedExclusive(baseCarId)
	local normalized = IndexConfig.NormalizeBaseCarId(baseCarId)
	if not normalized then return false end
	for _, entry in ipairs(IndexConfig.GetExclusiveEntries()) do
		if entry.BaseCarId == normalized then return true end
	end
	return false
end

return IndexConfig
