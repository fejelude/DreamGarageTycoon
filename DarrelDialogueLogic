-- 📣 POST-PURCHASE REACTION EVENT LOGIC

-- ============================================================================

purchaseFeedbackRemote.OnClientEvent:Connect(function(carId, isRobux, giftRecipientName, giftSenderName)

	-- FIX: 0.8s delay before NPC speaks after purchase

	task.wait(0.8)



	local carData = CarStats.Cars[carId]

	if not carData then return end



	-- 🛡️ [POLISH] Close Shop UI immediately so it doesn't overlap

	local shopUi = playerGui:FindFirstChild("UncommonShopUi")

	if shopUi then shopUi.Enabled = false end



	-- 🛡️ [POLISH] Refresh camera reference to prevent stale object bugs

	local camera = Workspace.CurrentCamera

	local npcFolder = Workspace:FindFirstChild(NPC_FOLDER)

	local npcModel = npcFolder and npcFolder:FindFirstChild(TARGET_NPC)

	local camPart = npcModel and npcModel:FindFirstChild("CameraAimPart")



	if camPart then

		camera.CameraType = Enum.CameraType.Scriptable

		TweenService:Create(camera, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {

			CFrame = camPart.CFrame

		}):Play()

	end



	print("💬 [DarrelLogic] Triggering Post-Purchase Reaction. Car: " .. carId .. " | Robux: " .. tostring(isRobux))



	isInteracting = true

	setFocusMode(true) -- Focus on the NPC dialogue



	local myGui, container, dialogueLabel = getUIElements()

	if myGui and container and dialogueLabel then

		myGui.Enabled = true

		container.Visible = true

		setButtonsState(false)



		local reactionText = ""

		if giftRecipientName then

			reactionText = "Gift sent! <font color='"..USER_COLOR.."'><b>" .. giftRecipientName .. "</b></font> received the <font color='"..UNCOMMON_COLOR.."'><b>" .. carId .. "</b></font>."

		else

			local poolToUse = isRobux and "RobuxReactions" or "Reactions"

			reactionText = getRandomDialogue(poolToUse, carId, carData.CPS)

		end



		typewrite(dialogueLabel, reactionText, function()

			task.wait(REACTION_PAUSE)

			stopInteraction() -- Fully close everything

		end)

	else

		-- Safety: couldn't find GUI, abort gracefully

		isInteracting = false

		setFocusMode(false)

	end

end)



