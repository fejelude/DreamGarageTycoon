-- Purpose: Authoritative server script managing rank visuals, progress, rewards, storage, and announcements.
-- Runs on: Server (ServerScriptService)
-- Location: ServerScriptService > RankService
-- Dependencies: Players, ReplicatedStorage.RankConfig, ReplicatedStorage.RankRemotes, ServerStorage.RankTags, ServerStorage rank bindables
-- Security: All rank claims, benefits, and requirement checks are validated server-side.
-- Maintainability: Required remotes/bindables are expected to be created in Studio; this script does not auto-create them.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local RankConfig = require(ReplicatedStorage:WaitForChild("RankConfig"))
local RankTags = ServerStorage:WaitForChild("RankTags", 10)

local function requireChild(parent, childName, className)
	local child = parent:WaitForChild(childName, 10)
	if not child then
		error("[RankService] Missing required " .. className .. ": " .. parent:GetFullName() .. "." .. childName)
	end
	if not child:IsA(className) then
		error("[RankService] " .. child:GetFullName() .. " must be a " .. className .. ", got " .. child.ClassName)
	end
	return child
end

local RankRemotes = requireChild(ReplicatedStorage, "RankRemotes", "Folder")
local GetRankState = requireChild(RankRemotes, "GetRankState", "RemoteFunction")
local ClaimRank = requireChild(RankRemotes, "ClaimRank", "RemoteFunction")
local RankUpdate = requireChild(RankRemotes, "RankUpdate", "RemoteEvent")
local RankAnnouncement = requireChild(RankRemotes, "RankAnnouncement", "RemoteEvent")

local Sessions = {}
local PlayerConnections = {}
local PendingSessionCleanup = {}
local RankClaimLocks = {}
local PLAYER_REMOVING_SESSION_GRACE_SECONDS = 120
local MAX_PROCESSED_RECEIPT_GRANTS = 300

local function newProgress()
	return {
		Purchases = {},
		Crafted = {},
		Obtained = {},
		GiftSentTotal = 0,
		GiftSentPlayers = {},
		GiftReceivedTotal = 0,
		GiftReceivedPlayers = {},
	}
end

local function sanitizeCount(value)
	local numeric = tonumber(value)
	if not numeric or numeric ~= numeric or numeric == math.huge or numeric == -math.huge then
		return 0
	end

	numeric = math.floor(numeric)
	if numeric < 0 then return 0 end
	return numeric
end

local function sanitizeTarget(value)
	local numeric = tonumber(value)
	if not numeric or numeric ~= numeric or numeric == math.huge or numeric == -math.huge then
		return math.huge
	end

	return math.max(1, math.floor(numeric))
end

local function sanitizeCountMap(raw)
	local map = {}
	if type(raw) ~= "table" then
		return map
	end

	for key, value in pairs(raw) do
		local count = sanitizeCount(value)
		if type(key) == "string" and key ~= "" and count > 0 then
			map[key] = count
		end
	end

	return map
end

local function sanitizePlayerSet(raw)
	local set = {}
	if type(raw) ~= "table" then
		return set
	end

	for key, value in pairs(raw) do
		local keep = value == true or sanitizeCount(value) > 0
		if keep and key ~= nil then
			set[tostring(key)] = true
		end
	end

	return set
end

local function sanitizeProcessedReceiptGrants(raw)
	local entries = {}
	for purchaseId, processedAt in pairs(type(raw) == "table" and raw or {}) do
		if type(purchaseId) == "string" and purchaseId ~= "" then
			table.insert(entries, {
				PurchaseId = purchaseId,
				ProcessedAt = math.max(0, math.floor(tonumber(processedAt) or 0)),
			})
		end
	end
	table.sort(entries, function(a, b) return a.ProcessedAt > b.ProcessedAt end)

	local result = {}
	for index, entry in ipairs(entries) do
		if index > MAX_PROCESSED_RECEIPT_GRANTS then break end
		result[entry.PurchaseId] = entry.ProcessedAt
	end
	return result
end

local function sanitizeProgress(raw)
	raw = type(raw) == "table" and raw or {}
	return {
		Purchases = sanitizeCountMap(raw.Purchases),
		Crafted = sanitizeCountMap(raw.Crafted),
		Obtained = sanitizeCountMap(raw.Obtained),
		GiftSentTotal = sanitizeCount(raw.GiftSentTotal),
		GiftSentPlayers = sanitizePlayerSet(raw.GiftSentPlayers),
		GiftReceivedTotal = sanitizeCount(raw.GiftReceivedTotal),
		GiftReceivedPlayers = sanitizePlayerSet(raw.GiftReceivedPlayers),
	}
end

local function isLegacyProgressShape(raw)
	return type(raw) == "table"
		and (
			raw.Purchases ~= nil
			or raw.Crafted ~= nil
			or raw.Obtained ~= nil
			or raw.GiftSentTotal ~= nil
			or raw.GiftSentPlayers ~= nil
			or raw.GiftReceivedTotal ~= nil
			or raw.GiftReceivedPlayers ~= nil
		)
end

local function newProgressByRank()
	local progressByRank = {}
	for _, rankName in ipairs(RankConfig.Order) do
		progressByRank[rankName] = newProgress()
	end
	return progressByRank
end

local function getFirstIncompleteRank(data)
	for _, rankName in ipairs(RankConfig.Order) do
		local rankData = RankConfig.Ranks[rankName]
		local previousRank = rankData and rankData.PreviousRank
		if data.CompletedRanks[rankName] ~= true and (not previousRank or data.CompletedRanks[previousRank] == true) then
			return rankName
		end
	end
	return nil
end

local function normalizeProgressByRank(raw, data)
	local progressByRank = newProgressByRank()

	if isLegacyProgressShape(raw) then
		local activeRank = getFirstIncompleteRank(data)
		if activeRank then
			progressByRank[activeRank] = sanitizeProgress(raw)
		end
		return progressByRank
	end

	raw = type(raw) == "table" and raw or {}
	for _, rankName in ipairs(RankConfig.Order) do
		progressByRank[rankName] = sanitizeProgress(raw[rankName])
	end

	return progressByRank
end

local function normalizeLoadedData(data)
	data = type(data) == "table" and data or {}
	local savedRank = data.CurrentRank or RankConfig.DefaultRankName
	local legacyRank = data.Rank or data.LegacyRank
	if RankConfig.GetRankValue(legacyRank) > RankConfig.GetRankValue(savedRank) then
		savedRank = legacyRank
	end
	if savedRank ~= RankConfig.DefaultRankName and not RankConfig.Ranks[savedRank] then
		savedRank = RankConfig.DefaultRankName
	end
	data.CurrentRank = savedRank
	data.CompletedRanks = type(data.CompletedRanks) == "table" and data.CompletedRanks or {}
	data.ClaimedRewards = type(data.ClaimedRewards) == "table" and data.ClaimedRewards or {}
	for _, rankName in ipairs(RankConfig.Order) do
		local unlocked = RankConfig.GetRankValue(rankName) <= RankConfig.GetRankValue(data.CurrentRank)
		data.CompletedRanks[rankName] = unlocked or nil
		data.ClaimedRewards[rankName] = unlocked or nil
	end

	data.Progress = normalizeProgressByRank(data.Progress, data)
	data.ProcessedReceiptGrants = sanitizeProcessedReceiptGrants(data.ProcessedReceiptGrants)

	return data
end

local function markDirty(player)
	local api = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if api then
		task.spawn(function()
			pcall(function() api:Invoke("MarkDirty", player) end)
		end)
	end
end

local function requestSave(player)
	local api = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if api then
		task.spawn(function()
			pcall(function() api:Invoke("SaveNow", player) end)
		end)
	end
end

local function forceSave(player)
	local api = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if not api then return false end
	local ok, saved = pcall(function() return api:Invoke("SaveNow", player) end)
	return ok and saved == true
end

local function trackConnection(player, connection)
	if not connection then return end
	PlayerConnections[player] = PlayerConnections[player] or {}
	table.insert(PlayerConnections[player], connection)
end

local function disconnectPlayerConnections(player)
	local connections = PlayerConnections[player]
	if connections then
		for _, connection in ipairs(connections) do
			if connection then
				connection:Disconnect()
			end
		end
	end
	PlayerConnections[player] = nil
end

local function disconnectPlayer(player)
	disconnectPlayerConnections(player)
	PendingSessionCleanup[player] = nil
	Sessions[player] = nil
end

local function schedulePlayerSessionCleanup(player)
	disconnectPlayerConnections(player)
	PendingSessionCleanup[player] = (PendingSessionCleanup[player] or 0) + 1
	local cleanupToken = PendingSessionCleanup[player]

	-- TycoonDataHandler asks RankPersistenceFunction for a final snapshot during
	-- PlayerRemoving. Keep the rank session briefly so connection ordering cannot
	-- replace in-progress quest data with a fresh empty session before saving.
	task.delay(PLAYER_REMOVING_SESSION_GRACE_SECONDS, function()
		if PendingSessionCleanup[player] == cleanupToken and not player.Parent then
			PendingSessionCleanup[player] = nil
			Sessions[player] = nil
		end
	end)
end

local function getSession(player)
	if not Sessions[player] then
		Sessions[player] = normalizeLoadedData({ CurrentRank = player:GetAttribute("Rank") or RankConfig.DefaultRankName })
	end
	return Sessions[player]
end

local function countDictionary(dictionary)
	local total = 0
	for _ in pairs(dictionary or {}) do total += 1 end
	return total
end

local function getRankProgress(session, rankName)
	session.Progress = type(session.Progress) == "table" and session.Progress or newProgressByRank()
	session.Progress[rankName] = sanitizeProgress(session.Progress[rankName])
	return session.Progress[rankName]
end

local function getActiveRankName(session)
	for _, rankName in ipairs(RankConfig.Order) do
		local rankData = RankConfig.Ranks[rankName]
		local previousRank = rankData and rankData.PreviousRank
		if session.CompletedRanks[rankName] ~= true and (not previousRank or session.CompletedRanks[previousRank] == true) then
			return rankName
		end
	end
	return nil
end

local function progressKey(shopName, carName)
	return tostring(shopName or "Any") .. ":" .. RankConfig.NormalizeCarName(carName)
end

local function incrementCapped(dictionary, key, amount, target)
	target = sanitizeTarget(target)
	local current = sanitizeCount(dictionary[key])
	local nextValue = math.min(current + (amount or 1), target)
	dictionary[key] = nextValue
	return nextValue > current
end

local function incrementFieldCapped(progress, fieldName, amount, target)
	target = sanitizeTarget(target)
	local current = sanitizeCount(progress[fieldName])
	local nextValue = math.min(current + (amount or 1), target)
	progress[fieldName] = nextValue
	return nextValue > current
end

local function addUniquePlayerCapped(set, userId, target)
	if userId == nil then return false end
	target = sanitizeTarget(target)
	if set[tostring(userId)] then return false end
	if countDictionary(set) >= target then return false end
	set[tostring(userId)] = true
	return true
end

local function getInventoryCarCount(player)
	local count = 0
	local seen = {}
	local function scan(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			if child:IsA("Tool") and not seen[child] and child:GetAttribute("ToolId") then
				seen[child] = true
				count += 1
			end
		end
	end

	scan(player:FindFirstChild("Backpack"))
	if player.Character then scan(player.Character) end

	return count
end

local function getStorageLimit(player)
	return tonumber(player:GetAttribute("RankStorageLimit"))
		or (RankConfig.GetBenefitsForRank(player:GetAttribute("Rank") or RankConfig.DefaultRankName).StorageSlots
			+ math.max(0, tonumber(player:GetAttribute("InventorySlotBonus")) or 0))
end

local function canAddCar(player, amount)
	amount = math.max(1, tonumber(amount) or 1)
	return getInventoryCarCount(player) + amount <= getStorageLimit(player)
end

local function Action_SetRankVisual(player, rankName)
	local character = player.Character
	if not character then return false, "No Character" end

	local head = character:FindFirstChild("Head")
	local humanoid = character:FindFirstChild("Humanoid")
	if not head or not humanoid then return false, "Character missing Head/Humanoid" end

	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff

	if not RankTags then return false, "ServerStorage.RankTags folder missing!" end
	local rankFolder = RankTags:FindFirstChild(rankName) or RankTags:FindFirstChild(RankConfig.DefaultRankName)
	if not rankFolder or not rankFolder:IsA("Folder") then
		return false, "Rank Folder not found in RankTags: " .. tostring(rankName)
	end

	for _, child in pairs(head:GetChildren()) do
		if child:IsA("BillboardGui") and child:GetAttribute("IsCustomTag") then
			child:Destroy()
		end
	end

	for _, guiTemplate in pairs(rankFolder:GetChildren()) do
		if guiTemplate:IsA("BillboardGui") then
			local newGui = guiTemplate:Clone()
			newGui:SetAttribute("IsCustomTag", true)

			if newGui.Name == "Displayname" then
				local nameLabel = newGui:FindFirstChild("Name")
				if nameLabel and nameLabel:IsA("TextLabel") then
					nameLabel.Text = player.DisplayName
				end
			elseif newGui.Name == "ExclusiveRank" then
				newGui.Enabled = player:GetAttribute("OwnsExclusiveGamePass") == true
			end

			newGui.Parent = head
		end
	end

	player:SetAttribute("Rank", rankName)
	return true, "Success"
end

local function applyBenefits(player)
	local session = getSession(player)
	local benefits = RankConfig.GetBenefitsForRank(session.CurrentRank)

	player:SetAttribute("Rank", session.CurrentRank)
	player:SetAttribute("RankStorageLimit", benefits.StorageSlots + math.max(0, tonumber(player:GetAttribute("InventorySlotBonus")) or 0))
	player:SetAttribute("RankResourceMultiplier", benefits.Multiplier)
	player:SetAttribute("RankChatTag", benefits.ChatTag)
	player:SetAttribute("HighestRankShopAccess", benefits.ShopAccess or "Common")

	if player.Character then task.spawn(Action_SetRankVisual, player, session.CurrentRank) end
end

local pushState
local announceRank

local function grantRank(player, rankName, shouldAnnounce)
	if type(rankName) ~= "string" then
		return false, "Invalid rank"
	end

	if rankName ~= RankConfig.DefaultRankName and not RankConfig.Ranks[rankName] then
		return false, "Invalid rank"
	end

	local session = getSession(player)
	local previousRank = session.CurrentRank
	session.CurrentRank = rankName

	for _, orderedRank in ipairs(RankConfig.Order) do
		local unlocked = RankConfig.GetRankValue(orderedRank) <= RankConfig.GetRankValue(rankName)
		session.CompletedRanks[orderedRank] = unlocked or nil
		session.ClaimedRewards[orderedRank] = unlocked or nil
	end

	applyBenefits(player)
	markDirty(player)
	pushState(player)

	if shouldAnnounce and previousRank ~= rankName and RankConfig.Ranks[rankName] then
		announceRank(player, rankName)
	end

	return true, "Rank granted"
end

local function getCurrencyValue(player, currency)
	if currency == "Wallet" then
		local ls = player:FindFirstChild("leaderstats")
		local wallet = ls and ls:FindFirstChild("Wallet")
		return wallet and wallet.Value or 0
	end
	return 0
end

local function evaluateRequirement(player, rankName, requirement)
	local session = getSession(player)
	local progress = getRankProgress(session, rankName)
	local current = 0
	local target = requirement.Amount or 1

	if requirement.Type == "Buy" then
		current = progress.Purchases[progressKey(requirement.Shop, requirement.Car)] or 0
	elseif requirement.Type == "Craft" then
		current = progress.Crafted[RankConfig.NormalizeCarName(requirement.Car)] or 0
	elseif requirement.Type == "Obtain" or requirement.Type == "CraftOrObtain" then
		local normalizedCar = RankConfig.NormalizeCarName(requirement.Car)
		current = math.max(progress.Obtained[normalizedCar] or 0, progress.Crafted[normalizedCar] or 0)
	elseif requirement.Type == "Hold" then
		current = getCurrencyValue(player, requirement.Currency)
	elseif requirement.Type == "GiftSent" then
		current = progress.GiftSentTotal or 0
	elseif requirement.Type == "GiftSentUnique" then
		current = countDictionary(progress.GiftSentPlayers)
		target = requirement.UniquePlayers or target
	elseif requirement.Type == "GiftReceivedUnique" then
		target = requirement.UniquePlayers or target
		current = countDictionary(progress.GiftReceivedPlayers)
		return {
			Id = requirement.Id,
			Current = math.min(current, target),
			Target = target,
			Complete = current >= target,
		}
	elseif requirement.Type == "GiftReceived" then
		current = progress.GiftReceivedTotal or 0
	elseif requirement.Type == "Pad" then
		current = (tonumber(player:GetAttribute("HighestUnlockedPad")) or 1) >= requirement.PadNumber and 1 or 0
	elseif requirement.Type == "BaseLevel" then
		current = (tonumber(player:GetAttribute("BaseLevel")) or 1) >= requirement.Level and 1 or 0
	end

	return {
		Id = requirement.Id,
		Current = math.min(current, target),
		Target = target,
		Complete = current >= target,
	}
end

local function buildState(player)
	local session = getSession(player)
	local ranks = {}

	for _, rankName in ipairs(RankConfig.Order) do
		local rankData = RankConfig.Ranks[rankName]
		local requirements = {}
		local allComplete = true
		for _, requirement in ipairs(rankData.Requirements) do
			local result = evaluateRequirement(player, rankName, requirement)
			requirements[requirement.Id] = result
			if not result.Complete then allComplete = false end
		end

		ranks[rankName] = {
			Completed = session.CompletedRanks[rankName] == true,
			Claimed = session.ClaimedRewards[rankName] == true,
			PreviousRank = rankData.PreviousRank,
			PreviousComplete = not rankData.PreviousRank or session.CompletedRanks[rankData.PreviousRank] == true,
			RequirementsComplete = allComplete,
			Requirements = requirements,
		}
	end

	return {
		CurrentRank = session.CurrentRank,
		CompletedRanks = session.CompletedRanks,
		Benefits = RankConfig.GetBenefitsForRank(session.CurrentRank),
		Ranks = ranks,
	}
end

pushState = function(player)
	RankUpdate:FireClient(player, buildState(player))
end

local function escapeRichText(text)
	text = tostring(text or "")
	text = text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&apos;")
	return text
end

announceRank = function(player, rankName)
	local rankData = RankConfig.Ranks[rankName]
	local template = rankData and rankData.Announcement and rankData.Announcement.Template
	if not template then
		template = "<b>{DisplayName}</b> has reached the " .. rankName .. " milestone!"
	end
	local message = template:gsub("{DisplayName}", escapeRichText(player.DisplayName))
	RankAnnouncement:FireAllClients(message, rankName)
end

local function claimRank(player, rankName)
	if type(rankName) ~= "string" or not RankConfig.Ranks[rankName] then
		return false, "Invalid rank", buildState(player)
	end

	local session = getSession(player)
	local rankData = RankConfig.Ranks[rankName]
	if session.CompletedRanks[rankName] then
		return false, "Rank already claimed", buildState(player)
	end
	if rankData.PreviousRank and not session.CompletedRanks[rankData.PreviousRank] then
		return false, "Finish " .. rankData.PreviousRank .. " first to accomplish " .. rankName, buildState(player)
	end

	for _, requirement in ipairs(rankData.Requirements) do
		if not evaluateRequirement(player, rankName, requirement).Complete then
			return false, "Finish all requirements before claiming " .. rankName .. ".", buildState(player)
		end
	end

	local previousRank = session.CurrentRank
	local previousCompleted = table.clone(session.CompletedRanks)
	local previousRewards = table.clone(session.ClaimedRewards)
	local granted, message = grantRank(player, rankName, false)
	if granted and not forceSave(player) then
		session.CurrentRank = previousRank
		session.CompletedRanks = previousCompleted
		session.ClaimedRewards = previousRewards
		applyBenefits(player)
		markDirty(player)
		pushState(player)
		forceSave(player)
		return false, "Rank could not be saved. Please try again.", buildState(player)
	end
	if granted and previousRank ~= rankName then announceRank(player, rankName) end
	return granted, message, buildState(player)
end

local function recordCarObtained(player, carName, source, shopName, suppressSave)
	local session = getSession(player)
	local activeRank = getActiveRankName(session)
	local rankData = activeRank and RankConfig.Ranks[activeRank]
	if not rankData then
		return false
	end

	local progress = getRankProgress(session, activeRank)
	local normalized = RankConfig.NormalizeCarName(carName)
	local changed = false

	for _, requirement in ipairs(rankData.Requirements or {}) do
		local target = requirement.Amount or 1
		local requirementCar = RankConfig.NormalizeCarName(requirement.Car)

		if (requirement.Type == "Obtain" or requirement.Type == "CraftOrObtain") and requirementCar == normalized then
			changed = incrementCapped(progress.Obtained, normalized, 1, target) or changed
		elseif source == "Buy" and requirement.Type == "Buy" and progressKey(requirement.Shop, requirement.Car) == progressKey(shopName, carName) then
			changed = incrementCapped(progress.Purchases, progressKey(shopName, carName), 1, target) or changed
		elseif source == "Craft" and requirement.Type == "Craft" and requirementCar == normalized then
			changed = incrementCapped(progress.Crafted, normalized, 1, target) or changed
		end
	end

	if not changed then
		return false
	end

	markDirty(player)
	pushState(player)
	if not suppressSave then requestSave(player) end
	return true
end

local function recordGiftProgress(player, otherPlayer, isSender, suppressSave)
	local session = getSession(player)
	local activeRank = getActiveRankName(session)
	local rankData = activeRank and RankConfig.Ranks[activeRank]
	if not rankData then
		return false
	end

	local progress = getRankProgress(session, activeRank)
	local changed = false

	for _, requirement in ipairs(rankData.Requirements or {}) do
		if isSender and requirement.Type == "GiftSent" then
			changed = incrementFieldCapped(progress, "GiftSentTotal", 1, requirement.Amount or 1) or changed
		elseif isSender and requirement.Type == "GiftSentUnique" and otherPlayer then
			changed = addUniquePlayerCapped(progress.GiftSentPlayers, otherPlayer.UserId, requirement.UniquePlayers or requirement.Amount or 1) or changed
		elseif not isSender and requirement.Type == "GiftReceived" then
			changed = incrementFieldCapped(progress, "GiftReceivedTotal", 1, requirement.Amount or 1) or changed
		elseif not isSender and requirement.Type == "GiftReceivedUnique" and otherPlayer then
			changed = addUniquePlayerCapped(progress.GiftReceivedPlayers, otherPlayer.UserId, requirement.UniquePlayers or requirement.Amount or 1) or changed
		end
	end

	if changed then
		markDirty(player)
		pushState(player)
		if not suppressSave then requestSave(player) end
	end

	return changed
end

local RankProgressAPI = requireChild(ServerStorage, "RankProgressAPI", "BindableFunction")

RankProgressAPI.OnInvoke = function(action, player, ...)
	if not player then return false end
	if action == "CanAddCar" then
		local amount = ...
		return canAddCar(player, amount), getStorageLimit(player), getInventoryCarCount(player)
	elseif action == "CarObtained" then
		local carName, source, shopName = ...
		recordCarObtained(player, carName, source, shopName)
		return true
	elseif action == "CarGiftSent" then
		local receiver, carName = ...
		recordGiftProgress(player, receiver, true)

		if receiver then
			recordGiftProgress(receiver, player, false)
			recordCarObtained(receiver, carName, "Gift", nil)
		end
		return true
	elseif action == "ReceiptCarGranted" then
		local purchaseId, receiver, carName, shopName, isGift = ...
		purchaseId = tostring(purchaseId or "")
		if purchaseId == "" or type(carName) ~= "string" or carName == "" then
			return false, "Invalid receipt rank grant"
		end

		local function applyOnce(target, callback)
			local session = getSession(target)
			session.ProcessedReceiptGrants = sanitizeProcessedReceiptGrants(session.ProcessedReceiptGrants)
			if session.ProcessedReceiptGrants[purchaseId] then return false end

			session.ProcessedReceiptGrants[purchaseId] = os.time()
			session.ProcessedReceiptGrants = sanitizeProcessedReceiptGrants(session.ProcessedReceiptGrants)
			callback()
			markDirty(target)
			return true
		end

		if isGift == true then
			if not receiver or receiver == player then return false, "Invalid gift receiver" end
			applyOnce(player, function()
				recordGiftProgress(player, receiver, true, true)
			end)
			applyOnce(receiver, function()
				recordGiftProgress(receiver, player, false, true)
				recordCarObtained(receiver, carName, "Gift", nil, true)
			end)

			-- Each marker and its quest mutation share that player's profile save.
			-- A partial two-profile failure is safe to retry because the marker only
			-- suppresses the side that already committed.
			local buyerSaved = forceSave(player)
			local receiverSaved = forceSave(receiver)
			if not buyerSaved or not receiverSaved then return false, "Rank receipt save failed" end
			return true
		end

		applyOnce(player, function()
			recordCarObtained(player, carName, "Buy", shopName, true)
		end)
		if not forceSave(player) then return false, "Rank receipt save failed" end
		return true
	elseif action == "Refresh" then
		applyBenefits(player)
		pushState(player)
		return true
	end
	return false
end

local RankPersistenceFunction = requireChild(ServerStorage, "RankPersistenceFunction", "BindableFunction")

RankPersistenceFunction.OnInvoke = function(action, player, data)
	if action == "Load" then
		Sessions[player] = normalizeLoadedData(data)
		applyBenefits(player)
		pushState(player)
		return true
	elseif action == "Get" then
		local session = getSession(player)
		return {
			CurrentRank = session.CurrentRank,
			CompletedRanks = session.CompletedRanks,
			ClaimedRewards = session.ClaimedRewards,
			Progress = session.Progress,
			ProcessedReceiptGrants = session.ProcessedReceiptGrants,
		}
	elseif action == "Close" then
		disconnectPlayer(player)
		return true
	end
	return false
end

local SetRankAPI = requireChild(ServerStorage, "SetRankAPI", "BindableFunction")

SetRankAPI.OnInvoke = function(player, rankName)
	return grantRank(player, rankName, false)
end

GetRankState.OnServerInvoke = function(player)
	return buildState(player)
end

ClaimRank.OnServerInvoke = function(player, rankName)
	if RankClaimLocks[player] then return false, "Rank claim already in progress", buildState(player) end
	RankClaimLocks[player] = true
	local ok, granted, message, state = pcall(claimRank, player, rankName)
	RankClaimLocks[player] = nil
	if not ok then
		warn("[RankService] Rank claim failed safely for " .. player.Name .. ": " .. tostring(granted))
		return false, "Rank claim failed. Please try again.", buildState(player)
	end
	return granted, message, state
end

local function hookPlayer(player)
	disconnectPlayer(player)
	PendingSessionCleanup[player] = nil
	getSession(player)
	applyBenefits(player)

	trackConnection(player, player.CharacterAdded:Connect(function()
		task.wait(0.25)
		if player.Parent then
			applyBenefits(player)
		end
	end))

	local function hookValue(value)
		if value then
			trackConnection(player, value.Changed:Connect(function()
				if player.Parent then
					pushState(player)
				end
			end))
		end
	end

	task.spawn(function()
		local leaderstats = player:WaitForChild("leaderstats", 30)
		if not player.Parent or not PlayerConnections[player] then
			return
		end
		hookValue(leaderstats and leaderstats:FindFirstChild("Wallet"))
		if PlayerConnections[player] then
			pushState(player)
		end
	end)

	trackConnection(player, player:GetAttributeChangedSignal("HighestUnlockedPad"):Connect(function()
		if player.Parent and PlayerConnections[player] then
			pushState(player)
		end
	end))
	trackConnection(player, player:GetAttributeChangedSignal("BaseLevel"):Connect(function()
		if player.Parent and PlayerConnections[player] then
			pushState(player)
		end
	end))
	trackConnection(player, player:GetAttributeChangedSignal("OwnsExclusiveGamePass"):Connect(function()
		if player.Parent and player.Character then
			task.spawn(Action_SetRankVisual, player, player:GetAttribute("Rank") or RankConfig.DefaultRankName)
		end
	end))
end

Players.PlayerAdded:Connect(hookPlayer)
Players.PlayerRemoving:Connect(function(player)
	RankClaimLocks[player] = nil
	schedulePlayerSessionCleanup(player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(hookPlayer, player)
end
