-- Purpose: Authoritative server script managing Rank logic and visuals (Displaynames & Custom Tags).
-- Runs on: Server (ServerScriptService)
-- Location: ServerScriptService > RankService
-- Dependencies: Players, ServerStorage, ServerStorage.RankTags
-- Public API: SetRankAPI (BindableFunction)
-- Security: Server-side UI injection ensures custom name tags cannot be faked on the client.
-- Performance: Lightweight tag cloning, cleans up previous rank tags on application.

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

-- ⚙️ CONFIGURATION & DEPENDENCIES
local RankTags = ServerStorage:WaitForChild("RankTags", 10) -- 🛡️ SECURE RANK UI LOCATION

-- ============================================================================
-- 👑 RANK LOGIC
-- ============================================================================

local function Action_SetRank(player, rankName)
	local character = player.Character
	if not character then return false, "No Character" end

	local head = character:FindFirstChild("Head")
	local humanoid = character:FindFirstChild("Humanoid")
	if not head or not humanoid then return false, "Character missing Head/Humanoid" end

	-- 1. Hide default Roblox Name
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff

	-- 2. Locate requested Rank Folder in ServerStorage
	if not RankTags then return false, "ServerStorage.RankTags folder missing!" end
	local rankFolder = RankTags:FindFirstChild(rankName)
	if not rankFolder or not rankFolder:IsA("Folder") then
		return false, "Rank Folder not found in RankTags: " .. tostring(rankName)
	end

	-- 3. Clean up existing custom tags
	for _, child in pairs(head:GetChildren()) do
		if child:IsA("BillboardGui") and child:GetAttribute("IsCustomTag") then
			child:Destroy()
		end
	end

	-- 4. Clone and apply new tags FROM the target Folder
	for _, guiTemplate in pairs(rankFolder:GetChildren()) do
		if guiTemplate:IsA("BillboardGui") then
			local newGui = guiTemplate:Clone()
			newGui:SetAttribute("IsCustomTag", true)

			-- Inject actual player name
			if newGui.Name == "Displayname" then
				local nameLabel = newGui:FindFirstChild("Name")
				if nameLabel and nameLabel:IsA("TextLabel") then
					nameLabel.Text = player.DisplayName
				end
			end

			newGui.Parent = head
		end
	end

	-- 5. Set persistent non-visual attribute for client-side shop checks
	player:SetAttribute("Rank", rankName)

	return true, "Success"
end

-- ============================================================================
-- 🔄 BINDABLE API SETUP
-- ============================================================================

-- Check for or create the SetRankAPI BindableFunction
local SetRankAPI = ServerStorage:FindFirstChild("SetRankAPI")
if not SetRankAPI then
	SetRankAPI = Instance.new("BindableFunction")
	SetRankAPI.Name = "SetRankAPI"
	SetRankAPI.Parent = ServerStorage
end

-- Listen for Rank Requests
SetRankAPI.OnInvoke = function(player, rankName)
	return Action_SetRank(player, rankName)
end
