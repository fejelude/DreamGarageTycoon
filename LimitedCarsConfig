LimitedCarsConfig.DefaultProductKey = "NeoPerformante"
LimitedCarsConfig.ReservationSeconds = 15 * 60
LimitedCarsConfig.MaxUpdateRetries = 5

LimitedCarsConfig.Products = {
	NeoPerformante = {
		ProductId = 3610688469,
		RobuxPrice = 3199,
		CarId = "Neo-Performante",
		DisplayName = "Neo Performante",
		MaxGlobalStock = 67,
		StateStoreName = "LimitedCars_NeoPerformanteState_V1",
		StateKey = "Current",
		TopicName = "LimitedCars_NeoPerformanteStock_V1",
		AnnouncementTemplates = {
			"@%s just bought the Neo Performante from the shop. Damn... bro is wealthy. 💸",
