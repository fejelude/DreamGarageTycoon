}

local productByProductId = {}
for productKey, productInfo in pairs(LimitedCarsConfig.Products) do
	productInfo.ProductKey = productKey
	productByProductId[productInfo.ProductId] = productInfo
end

function LimitedCarsConfig.GetDefaultProduct()
	return LimitedCarsConfig.Products[LimitedCarsConfig.DefaultProductKey]
end

function LimitedCarsConfig.GetProductByProductId(productId)
	return productByProductId[tonumber(productId)]
end

function LimitedCarsConfig.FormatStock(productInfo, remaining)
	productInfo = productInfo or LimitedCarsConfig.GetDefaultProduct()
	remaining = math.max(0, math.floor(tonumber(remaining) or 0))
	if remaining <= 0 then
		return "Out Of Stock!"
	end
	return string.format("Remaining: %d/%d", remaining, productInfo.MaxGlobalStock)
end

return LimitedCarsConfig
