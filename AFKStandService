-- Purpose: Handles 2x Money AFK Stand physical interactions, state, and AFK Mode reconnect teleporting.
-- Runs on: Server
-- Location: ServerScriptService
-- Dependencies: Players, Workspace, ReplicatedStorage, TeleportService
-- Networking: Uses AFKStandEvent for AFK stand UI and AFKModeEvent for Settings > AFK Mode idle reconnects.
-- Production notes:
--   - Cancels AFK Mode reconnect cleanly when the setting is turned off or player becomes active.
--   - Re-checks the AFK Mode setting immediately before teleporting so toggle-off cannot race the teleport.
--   - Tracks the exact AFK plot/session so plot IsAFK cannot get stuck after death, owner changes, or cleanup.
--   - Restores humanoid movement server-side instead of relying only on client/local scripts.
--   - Prevents clients from using AFKStandEvent "Exit" as a free teleport when they are not actually AFK.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

-- ============================================================================
-- SETTINGS AFK MODE / IDLE RECONNECT SETUP
-- ============================================================================
local AFKModeEvent = ReplicatedStorage:FindFirstChild("AFKModeEvent")
if not AFKModeEvent then
	AFKModeEvent = Instance.new("RemoteEvent")
	AFKModeEvent.Name = "AFKModeEvent"
	AFKModeEvent.Parent = ReplicatedStorage
end

local AFK_RECONNECT_DELAY_SECONDS = 14 * 60
local AFK_RECONNECT_COOLDOWN_SECONDS = 5 * 60
local DATA_READY_ATTRIBUTE = "TycoonDataLoaded"
local AFK_MODE_SETTING_ATTRIBUTE = "Setting_AFKModeEnabled"

local afkModeIdleSessions = {}
local afkModeLastTeleportRequest = {}
local afkModeSettingConnections = {}

local function getAFKModeEnabled(player)
	if not player then return false end
	return player:GetAttribute(AFK_MODE_SETTING_ATTRIBUTE) == true
end

local function isPlayerReadyForAFKMode(player)
	return player
		and player.Parent == Players
		and player:GetAttribute(DATA_READY_ATTRIBUTE) == true
		and getAFKModeEnabled(player)
end

local function fireAFKModeClient(player, action)
	if player and player.Parent == Players then
		AFKModeEvent:FireClient(player, action)
	end
end

local function cancelAFKModeIdleSession(player, shouldNotifyClient)
	local userId = player and player.UserId
	local session = userId and afkModeIdleSessions[userId]

	if session then
		session.Cancelled = true
		if session.Task then
			task.cancel(session.Task)
			session.Task = nil
		end
	end

	if userId then
		afkModeIdleSessions[userId] = nil
	end

	if shouldNotifyClient then
		fireAFKModeClient(player, "ReconnectCancelled")
	end
end

local function clearAFKModeSessionIfCurrent(player, session)
	if not player then return end
	local userId = player.UserId
	if afkModeIdleSessions[userId] == session then
		afkModeIdleSessions[userId] = nil
	end
	if session then
		session.Cancelled = true
		session.Task = nil
	end
end

local function teleportPlayerForAFKMode(player, session)
	if not player or player.Parent ~= Players then
		clearAFKModeSessionIfCurrent(player, session)
		return
	end

	local userId = player.UserId
	if afkModeIdleSessions[userId] ~= session or session.Cancelled then
		return
	end

	if not isPlayerReadyForAFKMode(player) then
		cancelAFKModeIdleSession(player, true)
		return
	end

	local now = os.clock()
	local lastRequest = afkModeLastTeleportRequest[userId] or 0
	if now - lastRequest < AFK_RECONNECT_COOLDOWN_SECONDS then
		-- Do not leave the client in a permanent "pending reconnect" state.
		cancelAFKModeIdleSession(player, true)
		return
	end

	session.State = "TeleportStarting"
	fireAFKModeClient(player, "ReconnectStarting")

	local teleportUIEvent = ReplicatedStorage:FindFirstChild("TeleportUIEvent")
	if teleportUIEvent and teleportUIEvent:IsA("RemoteEvent") then
		teleportUIEvent:FireClient(player, "FadeOut")
	end

	-- Let the client fade out, then re-check all cancellation conditions.
	-- This closes the race where the player turns AFK Mode off after the warning starts.
	task.wait(1)

	if afkModeIdleSessions[userId] ~= session or session.Cancelled then
		return
	end

	if not isPlayerReadyForAFKMode(player) then
		cancelAFKModeIdleSession(player, true)
		return
	end

	afkModeLastTeleportRequest[userId] = os.clock()

	local teleportOptions = Instance.new("TeleportOptions")
	teleportOptions:SetTeleportData({
		Reason = "AFKModeReconnect",
		RequestedAt = os.time(),
	})

	local reserveOk, reservedServerCode = pcall(function()
		return TeleportService:ReserveServer(game.PlaceId)
	end)

	if reserveOk and type(reservedServerCode) == "string" and reservedServerCode ~= "" then
		teleportOptions.ReservedServerAccessCode = reservedServerCode
	end

	local teleportOk, teleportErr = pcall(function()
		TeleportService:TeleportAsync(game.PlaceId, { player }, teleportOptions)
	end)

	if not teleportOk then
		warn("⚠️ AFKStandService: AFK Mode reconnect failed for " .. player.Name .. ": " .. tostring(teleportErr))
		cancelAFKModeIdleSession(player, true)
		return
	end

	clearAFKModeSessionIfCurrent(player, session)
end

local function startAFKModeIdleSession(player)
	if not player or player.Parent ~= Players then return end

	if not isPlayerReadyForAFKMode(player) then
		-- The client may have fired Idled before data/settings replicated. Reset it so it can try again later.
		cancelAFKModeIdleSession(player, true)
		return
	end

	cancelAFKModeIdleSession(player, false)

	local userId = player.UserId
	local session = {
		Cancelled = false,
		State = "IdleWaiting",
		Task = nil,
	}

	afkModeIdleSessions[userId] = session
	session.Task = task.delay(AFK_RECONNECT_DELAY_SECONDS, function()
		if afkModeIdleSessions[userId] ~= session or session.Cancelled then return end
		teleportPlayerForAFKMode(player, session)
	end)
end

AFKModeEvent.OnServerEvent:Connect(function(player, action)
	if typeof(action) ~= "string" then return end

	if action == "IdleStateStarted" then
		startAFKModeIdleSession(player)
	elseif action == "IdleStateEnded" then
		cancelAFKModeIdleSession(player, false)
	end
end)

local function watchAFKModeSetting(player)
	if afkModeSettingConnections[player.UserId] then
		afkModeSettingConnections[player.UserId]:Disconnect()
		afkModeSettingConnections[player.UserId] = nil
	end

	afkModeSettingConnections[player.UserId] = player:GetAttributeChangedSignal(AFK_MODE_SETTING_ATTRIBUTE):Connect(function()
		if player:GetAttribute(AFK_MODE_SETTING_ATTRIBUTE) ~= true then
			cancelAFKModeIdleSession(player, true)
		end
	end)
end

Players.PlayerAdded:Connect(watchAFKModeSetting)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(watchAFKModeSetting, player)
end

-- ============================================================================
-- PHYSICAL 2X MONEY AFK STAND SETUP
-- ============================================================================
local AFKEvent = ReplicatedStorage:WaitForChild("AFKStandEvent", 10)
if not AFKEvent then
	warn("⚠️ AFKStandService: 'AFKStandEvent' RemoteEvent not found in ReplicatedStorage! Please create it.")
	return
end

local moneyFolder = Workspace:WaitForChild("2X-Money", 10)
if not moneyFolder then
	warn("⚠️ AFKStandService: '2X-Money' folder not found in Workspace!")
	return
end

local cashGenerator = moneyFolder:WaitForChild("CashGenerator", 10)
if not cashGenerator then
	warn("⚠️ AFKStandService: 'CashGenerator' not found inside '2X-Money'!")
	return
end

local standPart = cashGenerator:WaitForChild("CashGeneratorPart", 10)
local teleportPad = cashGenerator:WaitForChild("Teleport", 10)

if not standPart then
	warn("⚠️ AFKStandService: 'CashGeneratorPart' not found! AFK Stand will not work.")
	return
end

if not teleportPad then
	warn("⚠️ AFKStandService: 'Teleport' pad not found! Players will be unlocked on exit but not teleported.")
end

local tycoonsFolder = Workspace:WaitForChild("Tycoons", 10)
if not tycoonsFolder then
	warn("⚠️ AFKStandService: 'Tycoons' folder not found in Workspace! AFK Stand ownership validation will fail.")
end

local ANCHOR_DELAY = 0.35
local DEFAULT_WALK_SPEED = 16
local DEFAULT_JUMP_POWER = 50
local DEFAULT_JUMP_HEIGHT = 7.2

local touchDebounce = {}
local activeAFKByUserId = {}

local function getPlayerPlot(player)
	if not tycoonsFolder then return nil end
	for _, plot in ipairs(tycoonsFolder:GetChildren()) do
		local ownerVal = plot:FindFirstChild("Owner")
		if ownerVal and ownerVal.Value == player.Name then
			return plot
		end
	end
	return nil
end

local function getHumanoidSnapshot(humanoid)
	if not humanoid then return nil end

	local snapshot = {
		WalkSpeed = humanoid.WalkSpeed,
		JumpPower = DEFAULT_JUMP_POWER,
		JumpHeight = DEFAULT_JUMP_HEIGHT,
		AutoRotate = humanoid.AutoRotate,
		UseJumpPower = true,
	}

	pcall(function()
		snapshot.UseJumpPower = humanoid.UseJumpPower
	end)

	pcall(function()
		snapshot.JumpPower = humanoid.JumpPower
	end)

	pcall(function()
		snapshot.JumpHeight = humanoid.JumpHeight
	end)

	return snapshot
end

local function lockHumanoidForAFK(humanoid)
	if not humanoid then return end

	humanoid.WalkSpeed = 0
	humanoid.AutoRotate = false

	local useJumpPower = true
	pcall(function()
		useJumpPower = humanoid.UseJumpPower
	end)

	if useJumpPower then
		pcall(function()
			humanoid.JumpPower = 0
		end)
	else
		pcall(function()
			humanoid.JumpHeight = 0
		end)
	end
end

local function restoreHumanoidFromAFK(humanoid, snapshot)
	if not humanoid then return end

	humanoid.WalkSpeed = (snapshot and tonumber(snapshot.WalkSpeed)) or DEFAULT_WALK_SPEED
	if snapshot and type(snapshot.AutoRotate) == "boolean" then
		humanoid.AutoRotate = snapshot.AutoRotate
	else
		humanoid.AutoRotate = true
	end

	local useJumpPower = true
	pcall(function()
		useJumpPower = humanoid.UseJumpPower
	end)

	if useJumpPower then
		local jumpPower = snapshot and tonumber(snapshot.JumpPower) or DEFAULT_JUMP_POWER
		pcall(function()
			humanoid.JumpPower = jumpPower
		end)
	else
		local jumpHeight = snapshot and tonumber(snapshot.JumpHeight) or DEFAULT_JUMP_HEIGHT
		pcall(function()
			humanoid.JumpHeight = jumpHeight
		end)
	end
end

local function unlockCurrentCharacter(player, session, shouldTeleport)
	local character = player and player.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")

	restoreHumanoidFromAFK(humanoid, session and session.HumanoidSnapshot)

	if hrp then
		hrp.Anchored = false
		if shouldTeleport and teleportPad then
			hrp.CFrame = teleportPad.CFrame * CFrame.new(0, 3, 0)
		end
	end
end

local function clearAFKState(player)
	if not player then return nil end

	local userId = player.UserId
	local session = activeAFKByUserId[userId]
	activeAFKByUserId[userId] = nil

	player:SetAttribute("IsAFK", false)
	player:SetAttribute("MovementLock", false)

	local plot = session and session.Plot
	if plot and plot.Parent then
		plot:SetAttribute("IsAFK", false)
	else
		local currentPlot = getPlayerPlot(player)
		if currentPlot then
			currentPlot:SetAttribute("IsAFK", false)
		end
	end

	if session and session.CharacterAddedConnection then
		session.CharacterAddedConnection:Disconnect()
		session.CharacterAddedConnection = nil
	end

	return session
end

local function finishAFK(player, shouldTeleport)
	local session = clearAFKState(player)
	unlockCurrentCharacter(player, session, shouldTeleport)
end

local function unlockStaleCharacterOnly(player)
	if not player then return end
	player:SetAttribute("MovementLock", false)

	local character = player.Character
	if not character then return end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.Anchored = false
	end
end

-- ============================================================================
-- TOUCHED EVENT — Enter physical AFK stand
-- ============================================================================
standPart.Touched:Connect(function(hit)
	local character = hit and hit.Parent
	if not character then return end

	local player = Players:GetPlayerFromCharacter(character)
	if not player then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not hrp or humanoid.Health <= 0 then return end

	local userId = player.UserId
	if touchDebounce[userId] then return end
	touchDebounce[userId] = true
	task.delay(1, function()
		touchDebounce[userId] = nil
	end)

	if activeAFKByUserId[userId] or player:GetAttribute("IsAFK") == true then
		return
	end

	local plot = getPlayerPlot(player)
	if not plot then return end
	if plot:GetAttribute("IsAFK") == true then return end

	local session = {
		Player = player,
		Character = character,
		Plot = plot,
		HumanoidSnapshot = getHumanoidSnapshot(humanoid),
		CharacterAddedConnection = nil,
	}

	activeAFKByUserId[userId] = session
	plot:SetAttribute("IsAFK", true)
	player:SetAttribute("IsAFK", true)
	player:SetAttribute("MovementLock", true)
	lockHumanoidForAFK(humanoid)

	session.CharacterAddedConnection = player.CharacterAdded:Connect(function()
		-- Death/respawn cleanup. Do not teleport; the new character should spawn normally.
		if activeAFKByUserId[userId] == session then
			clearAFKState(player)
		end
		task.defer(function()
			unlockStaleCharacterOnly(player)
		end)
	end)

	AFKEvent:FireClient(player, "Enter", plot.Name)

	task.delay(ANCHOR_DELAY, function()
		if activeAFKByUserId[userId] ~= session then return end
		if player.Parent ~= Players then return end
		if player:GetAttribute("IsAFK") ~= true then return end
		if player.Character ~= character then return end

		local currentHrp = character:FindFirstChild("HumanoidRootPart")
		local currentHumanoid = character:FindFirstChildOfClass("Humanoid")
		if currentHrp and currentHumanoid and currentHumanoid.Health > 0 then
			currentHrp.Anchored = true
		end
	end)
end)

-- ============================================================================
-- REMOTE EVENT — Exit physical AFK stand (fired by client ExitButton)
-- ============================================================================
AFKEvent.OnServerEvent:Connect(function(player, action)
	if action ~= "Exit" then return end

	local session = activeAFKByUserId[player.UserId]
	local wasAFK = player:GetAttribute("IsAFK") == true

	if not session and not wasAFK then
		-- Defensive unlock only. Do not teleport non-AFK players; otherwise exploiters
		-- can fire this RemoteEvent to jump to the AFK exit pad.
		unlockStaleCharacterOnly(player)
		return
	end

	finishAFK(player, true)
end)

-- ============================================================================
-- PLAYER LEAVING — Cleanup
-- ============================================================================
Players.PlayerRemoving:Connect(function(player)
	local userId = player.UserId
	touchDebounce[userId] = nil
	cancelAFKModeIdleSession(player, false)
	afkModeLastTeleportRequest[userId] = nil

	if afkModeSettingConnections[userId] then
		afkModeSettingConnections[userId]:Disconnect()
		afkModeSettingConnections[userId] = nil
	end

	clearAFKState(player)
end)


