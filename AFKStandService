-- Purpose: Handles 2x Money AFK Stand physical interactions, state, and teleporting.
-- Runs on: Server
-- Location: ServerScriptService
-- Dependencies: Players, Workspace, ReplicatedStorage
-- Public API: None
-- Networking: Uses AFKStandEvent to communicate state changes to the client.
-- Security: Server-side validation for part touching and teleportation.
-- Performance: Utilizes debounces to prevent spam.
-- Notes: Expects `AFKStandEvent` to be manually created in ReplicatedStorage.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local AFKEvent = ReplicatedStorage:WaitForChild("AFKStandEvent", 10)
if not AFKEvent then
	warn("⚠️ AFKStandService: 'AFKStandEvent' RemoteEvent not found in ReplicatedStorage! Please create it.")
	return
end

local moneyFolder = Workspace:WaitForChild("2X-Money", 10)
if not moneyFolder then
	warn("⚠️ AFKStandService: '2X-Money' folder not found in Workspace!")
	return
end

local cashGenerator = moneyFolder:WaitForChild("CashGenerator", 10)
if not cashGenerator then
	warn("⚠️ AFKStandService: 'CashGenerator' not found inside '2X-Money'!")
	return
end

local standPart = cashGenerator:WaitForChild("CashGeneratorPart", 10)
local teleportPad = cashGenerator:WaitForChild("Teleport", 10)

if not standPart then
	warn("⚠️ AFKStandService: 'CashGeneratorPart' not found! AFK Stand will not work.")
	return
end

if not teleportPad then
	warn("⚠️ AFKStandService: 'Teleport' pad not found! Players will not be teleported on exit.")
end

local tycoonsFolder = Workspace:WaitForChild("Tycoons", 10)

-- How long (seconds) after notifying the client we wait before hard-anchoring.
-- This window lets the client's animation fade-out (0.2s) finish so there is
-- no visible snap from "running" to "frozen". Keep this >= ANIM_STOP_FADE + 0.1
local ANCHOR_DELAY = 0.35

-- Default Humanoid stats to restore on exit so the Animate LocalScript
-- resumes naturally (it keys off WalkSpeed > 0 to play movement animations).
local DEFAULT_WALK_SPEED = 16
local DEFAULT_JUMP_POWER = 50

local debounce = {}
local activeConnections = {}

-- ============================================================================
-- 🔍 HELPER: Find which plot the player owns
-- ============================================================================
local function getPlayerPlot(player)
	if not tycoonsFolder then return nil end
	for _, plot in pairs(tycoonsFolder:GetChildren()) do
		local ownerVal = plot:FindFirstChild("Owner")
		if ownerVal and ownerVal.Value == player.Name then
			return plot
		end
	end
	return nil
end

-- ============================================================================
-- 🔒 HELPER: Unanchor, restore movement stats, and teleport
-- Called for both the normal exit and the stuck-prevention edge case.
-- Restoring WalkSpeed/JumpPower is what tells the client Animate LocalScript
-- to resume animations — no extra remote needed.
-- ============================================================================
local function restoreAndTeleport(player)
	local character = player.Character
	if not character then return end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")

	player:SetAttribute("MovementLock", false)

	if hrp then
		hrp.Anchored = false
		if teleportPad then
			hrp.CFrame = teleportPad.CFrame * CFrame.new(0, 3, 0)
		end
	end
end

-- ============================================================================
-- 🗑️ HELPER: Full server-side AFK state cleanup
-- Clears attributes and disconnects the death watcher. Does NOT teleport —
-- callers decide that based on whether the character is still alive.
-- ============================================================================
local function clearAFKState(player)
	player:SetAttribute("IsAFK", false)

	local plot = getPlayerPlot(player)
	if plot then
		plot:SetAttribute("IsAFK", false)
	end

	if activeConnections[player.UserId] then
		activeConnections[player.UserId]:Disconnect()
		activeConnections[player.UserId] = nil
	end
end

-- ============================================================================
-- 👟 TOUCHED EVENT — Enter AFK
-- ============================================================================
standPart.Touched:Connect(function(hit)
	local character = hit.Parent
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end

	local player = Players:GetPlayerFromCharacter(character)
	if not player then return end

	if debounce[player.UserId] then return end
	debounce[player.UserId] = true

	task.delay(1, function()
		debounce[player.UserId] = nil
	end)

	local plot = getPlayerPlot(player)
	if not plot then return end

	if plot:GetAttribute("IsAFK") == true then return end

	-- Set state
	plot:SetAttribute("IsAFK", true)
	player:SetAttribute("IsAFK", true)

	-- Zero out movement now so the character decelerates cleanly on the client
	-- before we hard-anchor. The client also fades out animation tracks at the
	-- same moment it receives the "Enter" event below, so both sides are in sync.
	player:SetAttribute("MovementLock", true)

	-- Disconnect any stale death watcher
	if activeConnections[player.UserId] then
		activeConnections[player.UserId]:Disconnect()
	end

	-- Handle death: clear state but do NOT teleport — the old character is being
	-- replaced and the new one spawns at the normal location automatically.
	-- The client's own CharacterAdded handler cleans up visuals without firing
	-- "Exit", so there is no double-clear race condition.
	activeConnections[player.UserId] = player.CharacterAdded:Connect(function()
		clearAFKState(player)
	end)

	-- Notify client FIRST so it can start its animation fade-out immediately.
	AFKEvent:FireClient(player, "Enter", plot.Name)

	-- Delay the hard anchor so it lands AFTER the client's 0.2s animation
	-- fade has finished. The player cannot meaningfully move in this window
	-- because WalkSpeed is already 0.
	task.delay(ANCHOR_DELAY, function()
		-- Guard: player may have died or left during the delay
		if player:GetAttribute("IsAFK") ~= true then return end
		local char = player.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.Anchored = true
		end
	end)
end)

-- ============================================================================
-- 📡 REMOTE EVENT — Exit AFK (fired by client ExitButton)
-- ============================================================================
AFKEvent.OnServerEvent:Connect(function(player, action)
	if action ~= "Exit" then return end

	local wasAFK = player:GetAttribute("IsAFK") == true

	if not wasAFK then
		-- State was already cleared (race with death handler). Still unanchor
		-- and restore stats defensively so the player can never get stuck.
		restoreAndTeleport(player)
		return
	end

	clearAFKState(player)
	restoreAndTeleport(player)
end)

-- ============================================================================
-- 🚪 PLAYER LEAVING — Cleanup
-- ============================================================================
Players.PlayerRemoving:Connect(function(player)
	debounce[player.UserId] = nil
	clearAFKState(player)
	-- No teleport — player is leaving the game entirely.
end)

