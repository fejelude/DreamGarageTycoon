-- ============================================================
-- GameMusicController.client.lua
-- Location: StarterPlayer/StarterPlayerScripts
--
-- Owns the local player's music environment. The server keeps the existing
-- disco playlist in sync; this controller only mixes that playlist against
-- the local day/night theme according to proximity and the saved music
-- setting exposed through SoundService.MusicMuted.
-- ============================================================

local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local GAME_THEME_NAME = "GameTheme"
local DISCO_MODEL_NAME = "Disco"
local DISCO_EMITTER_NAME = "DiscoMusicEmitter"
local DISCO_ATTACHMENT_NAME = "MusicAttachment"

local MUSIC_STATE = {
	NORMAL = "NormalGameMusic",
	DISCO = "DiscoMusic",
	DISABLED = "MusicDisabled",
}

local THEME_VOLUME = 0.5
local DEFAULT_DISCO_VOLUME = 0.5
local DEFAULT_DISCO_RADIUS = 500
local FADE_DURATION = 2
local MUTE_FADE_DURATION = 0.45
local DISTANCE_CHECK_INTERVAL = 0.25

local DAY_TRACK_ID = "rbxassetid://1846088038"
local NIGHT_TRACK_ID = "rbxassetid://9045766377"
local DAY_START_HOUR = 6
local NIGHT_START_HOUR = 18
local TIME_OF_DAY_CHECK_INTERVAL = 2

local musicObject = SoundService:FindFirstChild(GAME_THEME_NAME)
if not musicObject then
	musicObject = Instance.new("Sound")
	musicObject.Name = GAME_THEME_NAME
	musicObject.Parent = SoundService
end

musicObject.Looped = true
musicObject.Volume = 0

local discoEmitter = nil
local discoAttachment = nil
local discoSounds = {}
local soundTweens = {}
local currentState = nil
local currentTrackId = nil
local lastWasDaytime = nil
local trackTransitionToken = 0
local discoVolume = DEFAULT_DISCO_VOLUME
local discoRadius = DEFAULT_DISCO_RADIUS

local function isMuted()
	return SoundService:GetAttribute("MusicMuted") == true
end

local function shouldHoldForLoading()
	return SoundService:GetAttribute("LoadingMusicActive") ~= false
end

local function cancelSoundTween(sound)
	local tween = soundTweens[sound]
	if tween then
		tween:Cancel()
		soundTweens[sound] = nil
	end
end

local function fadeSound(sound, targetVolume, duration)
	if not sound or not sound.Parent then
		return
	end

	cancelSoundTween(sound)
	if math.abs(sound.Volume - targetVolume) < 0.001 then
		sound.Volume = targetVolume
		return
	end

	local tween = TweenService:Create(
		sound,
		TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{ Volume = targetVolume }
	)
	soundTweens[sound] = tween

	tween.Completed:Connect(function()
		if soundTweens[sound] == tween then
			soundTweens[sound] = nil
		end
	end)
	tween:Play()
end

local function registerDiscoSound(instance)
	if not instance:IsA("Sound") or discoSounds[instance] then
		return
	end

	discoSounds[instance] = true
	-- Suppress the server playlist locally until the central state is applied.
	instance.Volume = 0
	instance.Destroying:Connect(function()
		cancelSoundTween(instance)
		discoSounds[instance] = nil
	end)
end

local function synchronizeDiscoTrack()
	if not discoEmitter or not discoAttachment then
		return
	end

	local trackName = discoEmitter:GetAttribute("DiscoTrackName")
	local startedAt = discoEmitter:GetAttribute("DiscoTrackStartedAt")
	if type(trackName) ~= "string" or type(startedAt) ~= "number" then
		return
	end

	local activeSound = discoAttachment:FindFirstChild(trackName)
	if not activeSound or not activeSound:IsA("Sound") then
		return
	end

	-- Sound:Play normally replicates from the server. This is a recovery path
	-- for late joins or delayed playback replication, not a second playlist.
	local expectedPosition = math.max(0, Workspace:GetServerTimeNow() - startedAt)
	if activeSound.TimeLength > 0 then
		expectedPosition = math.min(expectedPosition, math.max(0, activeSound.TimeLength - 0.05))
	end

	if not activeSound.IsPlaying or math.abs(activeSound.TimePosition - expectedPosition) > 1 then
		for sound in pairs(discoSounds) do
			if sound ~= activeSound and sound.IsPlaying then
				sound:Stop()
			end
		end
		activeSound.TimePosition = expectedPosition
		activeSound:Play()
	end
end

local function cacheDiscoReferences()
	local disco = Workspace:WaitForChild(DISCO_MODEL_NAME)
	discoEmitter = disco:WaitForChild(DISCO_EMITTER_NAME)
	discoAttachment = discoEmitter:WaitForChild(DISCO_ATTACHMENT_NAME)
	discoRadius = discoEmitter:GetAttribute("DiscoRadius") or DEFAULT_DISCO_RADIUS
	discoVolume = discoEmitter:GetAttribute("DiscoVolume") or DEFAULT_DISCO_VOLUME

	for _, child in ipairs(discoAttachment:GetChildren()) do
		registerDiscoSound(child)
	end
	discoAttachment.ChildAdded:Connect(function(child)
		registerDiscoSound(child)
		-- Newly inserted playlist tracks must immediately inherit the current mix.
		if child:IsA("Sound") then
			fadeSound(child, currentState == MUSIC_STATE.DISCO and discoVolume or 0, MUTE_FADE_DURATION)
		end
	end)
	discoEmitter:GetAttributeChangedSignal("DiscoTrackSequence"):Connect(synchronizeDiscoTrack)
	synchronizeDiscoTrack()
end

local function isInsideDisco()
	if not discoEmitter or not discoEmitter.Parent then
		return false
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return false
	end

	return (rootPart.Position - discoEmitter.Position).Magnitude <= discoRadius
end

local function desiredState()
	if isMuted() or shouldHoldForLoading() then
		return MUSIC_STATE.DISABLED
	end
	return isInsideDisco() and MUSIC_STATE.DISCO or MUSIC_STATE.NORMAL
end

local function applyMusicState(force, fadeDuration)
	local nextState = desiredState()
	if not force and nextState == currentState then
		return
	end

	currentState = nextState
	local duration = fadeDuration or FADE_DURATION
	local themeTarget = nextState == MUSIC_STATE.NORMAL and THEME_VOLUME or 0
	local discoTarget = nextState == MUSIC_STATE.DISCO and discoVolume or 0

	if not shouldHoldForLoading() and not musicObject.IsPlaying then
		musicObject:Play()
	end
	fadeSound(musicObject, themeTarget, duration)

	for sound in pairs(discoSounds) do
		fadeSound(sound, discoTarget, duration)
	end
end

local function isDaytime()
	local hour = Lighting.ClockTime
	return hour >= DAY_START_HOUR and hour < NIGHT_START_HOUR
end

local function getTrackForTime()
	return isDaytime() and DAY_TRACK_ID or NIGHT_TRACK_ID
end

local function stopThemeForLoading()
	cancelSoundTween(musicObject)
	musicObject.Volume = 0
	if musicObject.IsPlaying then
		musicObject:Stop()
	end
end

local function switchThemeTrack(newTrackId)
	if currentTrackId == newTrackId then
		return
	end

	trackTransitionToken += 1
	local token = trackTransitionToken
	currentTrackId = newTrackId

	-- While disco (or mute) owns the mix, replace the silent theme without
	-- disturbing the disco playlist. Otherwise retain the original theme fade.
	local audibleTheme = currentState == MUSIC_STATE.NORMAL
	if audibleTheme then
		fadeSound(musicObject, 0, FADE_DURATION * 0.5)
	end

	task.delay(audibleTheme and FADE_DURATION * 0.5 or 0, function()
		if token ~= trackTransitionToken then
			return
		end

		musicObject.SoundId = newTrackId
		musicObject.TimePosition = 0
		if shouldHoldForLoading() then
			stopThemeForLoading()
			return
		end

		if not musicObject.IsPlaying then
			musicObject:Play()
		end
		applyMusicState(true, audibleTheme and FADE_DURATION * 0.5 or MUTE_FADE_DURATION)
	end)
end

local function bootstrap()
	currentTrackId = getTrackForTime()
	lastWasDaytime = isDaytime()
	musicObject.SoundId = currentTrackId
	musicObject.TimePosition = 0
	musicObject.Volume = 0

	task.spawn(function()
		cacheDiscoReferences()
		applyMusicState(true, MUTE_FADE_DURATION)

		while discoEmitter and discoEmitter.Parent do
			applyMusicState(false)
			task.wait(DISTANCE_CHECK_INTERVAL)
		end
	end)

	if shouldHoldForLoading() then
		stopThemeForLoading()
	else
		applyMusicState(true, MUTE_FADE_DURATION)
	end
end

bootstrap()

SoundService:GetAttributeChangedSignal("MusicMuted"):Connect(function()
	applyMusicState(true, MUTE_FADE_DURATION)
end)

SoundService:GetAttributeChangedSignal("LoadingMusicActive"):Connect(function()
	if shouldHoldForLoading() then
		stopThemeForLoading()
	end
	applyMusicState(true, MUTE_FADE_DURATION)
end)

task.spawn(function()
	while true do
		task.wait(TIME_OF_DAY_CHECK_INTERVAL)
		local nowDay = isDaytime()
		if lastWasDaytime ~= nowDay then
			lastWasDaytime = nowDay
			switchThemeTrack(getTrackForTime())
		end
	end
end)
