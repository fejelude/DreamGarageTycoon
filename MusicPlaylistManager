local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local GAME_THEME_NAME = "GameTheme"
local MASTER_VOLUME = 0.5
local FADE_DURATION = 2.0
local MUTE_FADE_DURATION = 0.45

local DAY_TRACK_ID = "rbxassetid://1846088038"
local NIGHT_TRACK_ID = "rbxassetid://9045766377"
local DAY_START_HOUR = 6
local NIGHT_START_HOUR = 18

local musicObject = SoundService:FindFirstChild(GAME_THEME_NAME)
if not musicObject then
	musicObject = Instance.new("Sound")
	musicObject.Name = GAME_THEME_NAME
	musicObject.Parent = SoundService
end
musicObject.Looped = true

local currentTrackId = nil
local lastWasDaytime = nil
local transitionToken = 0
local activeTween = nil

local function isMuted()
	return SoundService:GetAttribute("MusicMuted") == true
end

local function shouldHoldForLoading()
	return SoundService:GetAttribute("LoadingMusicActive") == true
end

local function targetVolume()
	if isMuted() or shouldHoldForLoading() then
		return 0
	end
	return MASTER_VOLUME
end

local function cancelTween()
	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end
end

local function fadeTo(volume, duration)
	cancelTween()
	activeTween = TweenService:Create(
		musicObject,
		TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{ Volume = volume }
	)
	activeTween:Play()
end

local function isDaytime()
	local t = Lighting.ClockTime
	return t >= DAY_START_HOUR and t < NIGHT_START_HOUR
end

local function getTrackForTime()
	return isDaytime() and DAY_TRACK_ID or NIGHT_TRACK_ID
end

local function switchTrack(newTrackId)
	if currentTrackId == newTrackId then
		return
	end

	transitionToken += 1
	local myToken = transitionToken
	currentTrackId = newTrackId

	fadeTo(0, FADE_DURATION * 0.5)
	task.delay(FADE_DURATION * 0.5, function()
		if myToken ~= transitionToken then
			return
		end

		musicObject.SoundId = newTrackId
		musicObject.TimePosition = 0
		musicObject:Play()

		fadeTo(targetVolume(), FADE_DURATION * 0.5)
	end)
end

local function applyGlobalMusicState()
	fadeTo(targetVolume(), MUTE_FADE_DURATION)
end

local function bootstrap()
	currentTrackId = getTrackForTime()
	lastWasDaytime = isDaytime()

	musicObject.SoundId = currentTrackId
	musicObject.TimePosition = 0
	musicObject.Volume = 0
	musicObject:Play()
	applyGlobalMusicState()
end

task.wait(1.5)
bootstrap()

SoundService:GetAttributeChangedSignal("MusicMuted"):Connect(applyGlobalMusicState)
SoundService:GetAttributeChangedSignal("LoadingMusicActive"):Connect(applyGlobalMusicState)

task.spawn(function()
	while true do
		task.wait(2)

		local nowDay = isDaytime()
		if lastWasDaytime ~= nowDay then
			lastWasDaytime = nowDay
			switchTrack(getTrackForTime())
		end
	end
end)
