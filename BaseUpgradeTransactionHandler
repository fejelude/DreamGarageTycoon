-- Purpose: Verification for Buying AND Equipping/Unequipping Skins safely. Includes VFX triggers.
-- Runs on: Server
-- Location: ServerScriptService
-- Dependencies: ReplicatedStorage, MarketplaceService, HttpService, Players, BaseSkinStats
-- Public API: ShopRemotes.BaseUpgradeTransaction
-- Networking: Client invokes BaseUpgradeTransaction -> Server processes -> Returns boolean, string. Server fires PadUnlockEvent on success.
-- Security: Transaction locks prevent spam-buying and wallet draining. Server-authoritative price checking.
-- Performance: Lightweight table hashing for locks. pcall wrapper prevents hanging locks.
-- Notes: Assumes BaseSkinStats module exists and is structured correctly.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local PlayerTransactionCoordinator = require(ServerScriptService:WaitForChild("PlayerTransactionCoordinator"))

local Remotes = ReplicatedStorage:WaitForChild("ShopRemotes")
local TransactionFunc = Remotes:WaitForChild("BaseUpgradeTransaction")
local StatsModule = require(ReplicatedStorage:WaitForChild("BaseSkinStats"))

-- 📡 NEW: VFX Event Connection
-- Grabbing the event created by PadProgressionHandler to reuse the Confetti system
local PadUnlockEvent = ReplicatedStorage:FindFirstChild("PadUnlockEvent")
if not PadUnlockEvent or not PadUnlockEvent:IsA("RemoteEvent") then error("[BaseUpgradeTransactionHandler] Missing ReplicatedStorage > PadUnlockEvent", 0) end

-- 🛡️ SECURITY: Transaction Locks
local activeTransactions = {}
local baseEquipCooldowns = {}
local BASE_SWITCH_COOLDOWN_SECONDS = 60
local TycoonFolder = Workspace:WaitForChild("Tycoons")
local MAX_FORCE_SAVE_ATTEMPTS = 3

local function forceSave(player)
	local api = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if not api or not api:IsA("BindableFunction") then
		return false, "Save system unavailable."
	end

	local lastMessage = nil
	for attempt = 1, MAX_FORCE_SAVE_ATTEMPTS do
		local ok, result, message = pcall(function()
			return PlayerTransactionCoordinator.InvokeBindable(player, api, "SaveNow", player)
		end)

		if ok and result == true then
			return true
		end

		lastMessage = ok and message or result
		task.wait(0.35 * attempt)
	end

	pcall(function()
		PlayerTransactionCoordinator.InvokeBindable(player, api, "QueueSaveSoon", player, 3)
	end)
	return false, lastMessage or "Save failed."
end

local function formatBaseSwitchCooldownMessage(remainingSeconds)
	remainingSeconds = math.max(1, math.ceil(tonumber(remainingSeconds) or 1))
	local unit = remainingSeconds == 1 and "second" or "seconds"
	return "Please wait " .. tostring(remainingSeconds) .. " more " .. unit .. " before switching bases."
end

local function getLevelModel(plot, levelName)
	local canonicalName = levelName == "Level1" and "NormalLevel1"
		or (levelName == "Level2" and "NormalLevel2" or levelName)
	local model = plot:FindFirstChild(canonicalName)
	if model then return model end

	local dedicatedFolder = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")
	if dedicatedFolder then
		local plotStorage = dedicatedFolder:FindFirstChild(plot.Name)
		if plotStorage then
			return plotStorage:FindFirstChild(canonicalName)
		end
	end
	return nil
end

local function getMainPart(padObject)
	if not padObject then return nil end
	if padObject:IsA("BasePart") then return padObject end
	if padObject:IsA("Model") then
		return padObject.PrimaryPart or padObject:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

local function getPlayerPlot(player)
	local plotName = player:GetAttribute("OccupiedPlot")
	local plot = plotName and TycoonFolder:FindFirstChild(plotName)
	if plot and plot:FindFirstChild("Owner") and plot.Owner.Value == player.Name then
		return plot
	end
	return nil
end

local function rollbackPadMigration(journal)
	for index = #(journal or {}), 1, -1 do
		local move = journal[index]
		if move.ToOcc and move.ToOcc.Parent then move.ToOcc.Value = move.ToOccupied end
		if move.ToLink and move.ToLink.Parent then move.ToLink.Value = move.ToLinkedCar end
		if move.FromOcc and move.FromOcc.Parent then move.FromOcc.Value = move.FromOccupied end
		if move.FromLink and move.FromLink.Parent then move.FromLink.Value = move.FromLinkedCar end
		if move.Car and move.Car.Parent and move.OriginalPivot then
			move.Car:PivotTo(move.OriginalPivot)
		end
	end
end

local function migratePadOccupancy(plot, fromLevel, toLevel)
	local fromModel = getLevelModel(plot, "Level" .. tostring(fromLevel))
	local toModel = getLevelModel(plot, "Level" .. tostring(toLevel))
	local fromPads = fromModel and fromModel.Parent:FindFirstChild("Pads")
	local toPads = toModel and toModel.Parent:FindFirstChild("Pads")
	if not fromPads or not toPads then
		return false, "Base pads are unavailable. Please try again."
	end

	local journal = {}
	for _, fromPadObj in ipairs(fromPads:GetChildren()) do
		local padNumber = fromPadObj.Name:match("Pad(%d+)")
		local toPadObj = padNumber and toPads:FindFirstChild("Pad" .. padNumber)
		local fromPart = getMainPart(fromPadObj)
		local fromOcc = fromPart and fromPart:FindFirstChild("IsOccupied")
		local fromLink = fromPart and fromPart:FindFirstChild("LinkedCar")
		local hasCar = (fromOcc and fromOcc.Value == true) or (fromLink and fromLink.Value ~= nil)
		if hasCar then
			if not toPadObj then
				return false, "Move cars off Level " .. tostring(fromLevel) .. "-only pads before switching bases."
			end
			local toPart = getMainPart(toPadObj)
			local toOcc = toPart and toPart:FindFirstChild("IsOccupied")
			local toLink = toPart and toPart:FindFirstChild("LinkedCar")
			if not fromPart or not fromOcc or not fromLink or not toPart or not toOcc or not toLink then
				return false, "A base pad is missing required occupancy state."
			end
			if not fromLink.Value then return false, "A placed car link is missing. Pick up the car and try again." end
			if toOcc.Value or toLink.Value then return false, "A destination pad is already occupied." end
			table.insert(journal, {
				FromOcc = fromOcc, FromLink = fromLink, ToOcc = toOcc, ToLink = toLink,
				FromOccupied = fromOcc.Value, FromLinkedCar = fromLink.Value,
				ToOccupied = toOcc.Value, ToLinkedCar = toLink.Value,
				Car = fromLink.Value, OriginalPivot = fromLink.Value:GetPivot(), ToPart = toPart,
			})
		end
	end

	local ok, err = xpcall(function()
		for _, move in ipairs(journal) do
			move.ToOcc.Value = true
			move.ToLink.Value = move.Car
			move.Car:PivotTo(move.ToPart.CFrame * CFrame.new(0, (move.ToPart.Size.Y / 2) + 5, 0))
			move.FromOcc.Value = false
			move.FromLink.Value = nil
		end
	end, debug.traceback)
	if not ok then
		rollbackPadMigration(journal)
		return false, "Base migration failed: " .. tostring(err)
	end
	return true, nil, journal
end

-- 💰 UNIFIED TRANSACTION & EQUIP FUNCTION
TransactionFunc.OnServerInvoke = function(player, skinName, actionType)
	-- Prevent remote spam & race conditions
	if activeTransactions[player.UserId] then
		return false, "Transaction in progress. Please wait."
	end
	activeTransactions[player.UserId] = true

	-- Use a wrapper to ensure the lock is ALWAYS released, even if the script errors
	local success, result, msg = pcall(function()
		return PlayerTransactionCoordinator.Run(player, "BaseUpgradeTransaction", function()
		local skinData = StatsModule[skinName]


		if actionType == "BaseEquip" or actionType == "BaseUnequip" then
			local requestedLevel = math.floor(tonumber(skinName) or 0)
			if requestedLevel ~= 1 and requestedLevel ~= 2 then
				return false, "Invalid base level."
			end

			local ownedBaseLevel = math.max(1, tonumber(player:GetAttribute("OwnedBaseLevel")) or tonumber(player:GetAttribute("BaseLevel")) or 1)
			local currentBaseLevel = math.max(1, tonumber(player:GetAttribute("BaseLevel")) or 1)
			local targetLevel = requestedLevel
			local successMessage = "Equipped Level " .. tostring(requestedLevel) .. " Base."

			if actionType == "BaseUnequip" then
				if requestedLevel ~= currentBaseLevel then
					return false, "Level " .. tostring(requestedLevel) .. " is not currently active."
				end

				if requestedLevel == 1 then
					return false, "Level 1 is currently active."
				end

				targetLevel = 1
				successMessage = "Switched back to Level 1 Base."
			elseif requestedLevel == currentBaseLevel then
				return false, "Level " .. tostring(requestedLevel) .. " is currently active."
			end

			if targetLevel > ownedBaseLevel then
				return false, "You haven't unlocked Level " .. tostring(targetLevel) .. " yet."
			end

			local now = os.time()
			local nextAllowed = baseEquipCooldowns[player.UserId] or 0
			if now < nextAllowed then
				return false, formatBaseSwitchCooldownMessage(nextAllowed - now)
			end

			local plot = getPlayerPlot(player)
			if not plot then
				return false, "Base unavailable. Please try again."
			end

			local migrated, migrateMessage, migrationJournal = migratePadOccupancy(plot, currentBaseLevel, targetLevel)
			if not migrated then
				return false, migrateMessage or "Base switch failed."
			end

			baseEquipCooldowns[player.UserId] = now + BASE_SWITCH_COOLDOWN_SECONDS
			player:SetAttribute("BaseLevel", targetLevel)
			local saveOk = forceSave(player)
			if not saveOk then
				rollbackPadMigration(migrationJournal)
				player:SetAttribute("BaseLevel", currentBaseLevel)
				forceSave(player)
				return false, "Base switch could not be saved. Please try again."
			end
			return true, successMessage

		end

		-- 1. READ OWNERSHIP
		local ownedRaw = player:GetAttribute("OwnedBaseSkins") or "[]"
		local ownedTable = {}
		pcall(function() ownedTable = HttpService:JSONDecode(ownedRaw) end)
		local ownsSkin = table.find(ownedTable, skinName) ~= nil

		-- ========================================================================
		-- 🛠️ EQUIP / UNEQUIP LOGIC
		-- ========================================================================
		if actionType == "Equip" then
			if ownsSkin then
				local originalEquipped = player:GetAttribute("EquippedSkin") or "Default"
				player:SetAttribute("EquippedSkin", skinName)
				local saveOk = forceSave(player)
				if not saveOk then
					player:SetAttribute("EquippedSkin", originalEquipped)
					forceSave(player)
					return false, "Equip could not be saved. Please try again."
				end
				print("✅ " .. player.Name .. " equipped " .. skinName)
				return true, "Equipped"
			else
				return false, "You do not own this!"
			end

		elseif actionType == "Unequip" then
			local originalEquipped = player:GetAttribute("EquippedSkin") or "Default"
			player:SetAttribute("EquippedSkin", "Default")
			local saveOk = forceSave(player)
			if not saveOk then
				player:SetAttribute("EquippedSkin", originalEquipped)
				forceSave(player)
				return false, "Unequip could not be saved. Please try again."
			end
			print("🚫 " .. player.Name .. " unequipped " .. skinName)
			return true, "Unequipped"

			-- ========================================================================
			-- 💰 BUYING LOGIC
			-- ========================================================================
		elseif actionType == "Cash" then
			if not skinData then return false, "Invalid Skin" end
			if ownsSkin then return false, "Already Owned" end

			local leaderstats = player:FindFirstChild("leaderstats")
			local wallet = leaderstats and leaderstats:FindFirstChild("Wallet") 

			if wallet and wallet.Value >= skinData.PriceCash then
				local originalWallet = wallet.Value
				local originalOwned = ownedRaw
				local originalEquipped = player:GetAttribute("EquippedSkin") or "Default"

				-- A. Deduct Money
				wallet.Value = wallet.Value - skinData.PriceCash

				-- B. Grant Ownership
				table.insert(ownedTable, skinName)

				-- C. Update Attributes (Client sees this instantly)
				player:SetAttribute("OwnedBaseSkins", HttpService:JSONEncode(ownedTable))
				player:SetAttribute("EquippedSkin", skinName) -- Auto-Equip on buy
				local saveOk = forceSave(player)
				if not saveOk then
					wallet.Value = originalWallet
					player:SetAttribute("OwnedBaseSkins", originalOwned)
					player:SetAttribute("EquippedSkin", originalEquipped)
					forceSave(player)
					return false, "Skin purchase could not be saved. Your Wallet was not charged; please try again."
				end

				print("✅ " .. player.Name .. " bought " .. skinName .. " with Wallet Cash")

				-- ✨ NEW: TRIGGER CLIENT SUCCESS (Confetti + Text)
				if PadUnlockEvent then
					-- We append " Base" so the notification reads naturally: "...own Pad Silver Base"
					PadUnlockEvent:FireClient(player, true, skinName .. " Base")
				end

				return true, "Success"
			else
				return false, "Insufficient Wallet Cash"
			end

		elseif actionType == "Robux" then
			if not skinData then return false, "Invalid Skin" end
			if ownsSkin then return false, "Already Owned" end

			if skinData.ProductId > 0 then
				MarketplaceService:PromptProductPurchase(player, skinData.ProductId)
				return true, "Prompted"
			else
				return false, "No Product ID Configured"
			end
		end

		return false, "Invalid Action"
		end)
	end)

	-- Release Lock
	activeTransactions[player.UserId] = nil

	if not success then
		warn("⚠️ Transaction Error for " .. player.Name .. ": " .. tostring(result))
		return false, "System Error"
	end

	return result, msg
end

-- Cleanup locks if a player leaves mid-transaction
Players.PlayerRemoving:Connect(function(player)
	activeTransactions[player.UserId] = nil
	baseEquipCooldowns[player.UserId] = nil
end)
