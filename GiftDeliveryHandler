-- Purpose: Reconciles durable Robux gift deliveries when a recipient profile is ready.
-- Runs on: Server
-- Location: ServerScriptService > GiftDeliveryHandler

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")
local GiftDeliveryService = require(ServerScriptService:WaitForChild("GiftDeliveryService"))

local function watch(player)
	local function reconcile()
		if player.Parent and player:GetAttribute("TycoonDataLoaded") == true then
			task.defer(function() GiftDeliveryService.DeliverForPlayer(player) end)
		end
	end
	player:GetAttributeChangedSignal("TycoonDataLoaded"):Connect(reconcile)
	reconcile()
end

Players.PlayerAdded:Connect(watch)
for _, player in ipairs(Players:GetPlayers()) do watch(player) end

task.spawn(function()
	while true do
		task.wait(60)
		for _, player in ipairs(Players:GetPlayers()) do
			if player:GetAttribute("TycoonDataLoaded") == true then
				task.defer(function() GiftDeliveryService.DeliverForPlayer(player) end)
			end
		end
	end
end)
