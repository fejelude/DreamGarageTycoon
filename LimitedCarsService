-- Server ModuleScript: ServerScriptService > LimitedCarsService
-- Purpose: Server-authoritative reservations, stock, receipt finalization, and purchase announcements for Neo Performante.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("LimitedCarsConfig"))
local MutationRateLimiter = require(ServerScriptService:WaitForChild("MutationRateLimiter"))
local PlayerTransactionCoordinator = require(ServerScriptService:WaitForChild("PlayerTransactionCoordinator"))
local Product = Config.GetDefaultProduct()

local remotes = ReplicatedStorage:WaitForChild("LimitedCarsRemotes")
local StateEvent = remotes:WaitForChild("State")
local GetStateFunction = remotes:WaitForChild("GetState")
local ReserveFunction = remotes:WaitForChild("Reserve")
local PromptClosedEvent = remotes:WaitForChild("PromptClosed")
local PurchaseResultEvent = remotes:WaitForChild("PurchaseResult")

local GiftRemotes = ReplicatedStorage:WaitForChild("GiftRemotes")
local GlobalChatBroadcast = GiftRemotes:WaitForChild("GlobalChatBroadcast")

local stateStore = DataStoreService:GetDataStore(Product.StateStoreName)
local currentState = nil
local lastStateReadAt = -math.huge
local STATE_CACHE_SECONDS = 5
local localReservations = {}
local seenAnnouncements = {}
local PUBLISH_RETRY_DELAYS = { 0, 1, 3, 7 }

local Service = {}

local function now() return os.time() end
local function receiptKey(receiptInfo) return tostring(receiptInfo.PlayerId) .. "_" .. tostring(receiptInfo.PurchaseId) end
local function reserveKey(player) return tostring(player.UserId) .. "_" .. tostring(Product.ProductId) end

local function sanitize(raw)
	local state = type(raw) == "table" and raw or {}
	state.Sold = math.clamp(math.floor(tonumber(state.Sold) or 0), 0, Product.MaxGlobalStock)
	state.Initialized = true
	state.Reservations = type(state.Reservations) == "table" and state.Reservations or {}
	state.Receipts = type(state.Receipts) == "table" and state.Receipts or {}
	state.AnnouncedReceipts = type(state.AnnouncedReceipts) == "table" and state.AnnouncedReceipts or {}
	state.UpdatedAt = tonumber(state.UpdatedAt) or now()
	state.Revision = math.max(0, math.floor(tonumber(state.Revision) or 0))
	for key, res in pairs(state.Reservations) do
		if type(res) ~= "table" or res.ProductId ~= Product.ProductId
			or (res.State ~= "Reserved" and res.State ~= "AwaitingReceipt")
			-- AwaitingReceipt is a paid allocation and must not age out on a
			-- browsing TTL. Only clearly unpurchased Reserved entries expire.
			or (res.State == "Reserved" and (tonumber(res.ExpiresAt) or 0) <= now())
		then
			state.Reservations[key] = nil
		end
	end
	return state
end

local function remainingFromState(state)
	state = sanitize(state)
	local reserved = 0
	for _ in pairs(state.Reservations) do reserved += 1 end
	return math.max(0, Product.MaxGlobalStock - state.Sold - reserved)
end

local function publicState(state)
	state = sanitize(state or currentState)
	return {
		Remaining = remainingFromState(state), MaxStock = Product.MaxGlobalStock,
		ProductId = Product.ProductId, CarId = Product.CarId, ServerTime = now(),
		Revision = state.Revision, UpdatedAt = state.UpdatedAt,
	}
end

local function publishState(payload)
	if payload and payload.Remaining ~= nil then StateEvent:FireAllClients(payload) end
	task.spawn(function()
		for _, delaySeconds in ipairs(PUBLISH_RETRY_DELAYS) do
			if delaySeconds > 0 then task.wait(delaySeconds) end
			local ok = pcall(function() MessagingService:PublishAsync(Product.TopicName, payload) end)
			if ok then return end
		end
	end)
end

local function publishAnnouncement(receiptKeyValue, messageText)
	if seenAnnouncements[receiptKeyValue] then return end
	seenAnnouncements[receiptKeyValue] = true
	GlobalChatBroadcast:FireAllClients({ Type = "System", Message = messageText, ReceiptKey = receiptKeyValue })
	publishState({ Announcement = { Type = "System", Message = messageText, ReceiptKey = receiptKeyValue } })
end

local function updateState(mutator)
	local out, ok = nil, false
	for attempt = 1, Config.MaxUpdateRetries do
		ok = pcall(function()
			out = stateStore:UpdateAsync(Product.StateKey, function(old)
				local state = sanitize(old)
				local nextState = mutator(state)
				if nextState == nil then return nil end
				nextState.Revision = math.max(0, math.floor(tonumber(state.Revision) or 0)) + 1
				nextState.UpdatedAt = now()
				return nextState
			end)
		end)
		if ok then
			currentState = sanitize(out)
			lastStateReadAt = os.clock()
			publishState(publicState(currentState))
			return true, currentState
		end
		task.wait(0.25 * attempt)
	end
	return false, out
end

function Service.GetState(forceRefresh)
	if currentState and forceRefresh ~= true and os.clock() - lastStateReadAt < STATE_CACHE_SECONDS then
		return publicState(currentState)
	end
	if not MutationRateLimiter.AllowGlobal("LimitedCarsStateRead", 2, 0.2) then
		return publicState(currentState or sanitize(nil))
	end
	local ok, data = pcall(function() return stateStore:GetAsync(Product.StateKey) end)
	if ok then
		currentState = sanitize(data)
		lastStateReadAt = os.clock()
	end
	currentState = currentState or sanitize(nil)
	return publicState(currentState)
end

function Service.Reserve(player)
	if not player or not player.Parent then return false, "Player unavailable", Service.GetState() end
	local key = reserveKey(player)
	local reservationId = HttpService:GenerateGUID(false)
	local reserved = false
	local reserveMessage = "Out Of Stock"
	local ok = updateState(function(state)
		-- The datastore transform can be retried; only expose the result of its
		-- final invocation to the caller.
		reserved = false
		reserveMessage = "Out Of Stock"
		local existing = state.Reservations[key]
		if existing then
			if existing.State == "AwaitingReceipt" then
				reserveMessage = "Previous purchase is awaiting its receipt"
				return state
			end
			if localReservations[player.UserId] == existing.ReservationId then
				reserved = true
				reserveMessage = "Reserved"
				reservationId = existing.ReservationId
				existing.ExpiresAt = math.max(existing.ExpiresAt or 0, now() + Config.ReservationSeconds)
				return state
			end
			-- A reconnect/new server rotates the version while retaining the same
			-- stock allocation. Delayed cleanup from the old server can now remove
			-- only its obsolete token.
			state.Reservations[key] = nil
		end
		if remainingFromState(state) <= 0 then reserved = false; reserveMessage = "Out Of Stock"; return state end
		state.Reservations[key] = { State = "Reserved", ReservationId = reservationId, UserId = player.UserId, Username = player.Name, ProductId = Product.ProductId, ReservedAt = now(), ExpiresAt = now() + Config.ReservationSeconds }
		reserved = true
		reserveMessage = "Reserved"
		return state
	end)
	if reserved then localReservations[player.UserId] = reservationId end
	return ok and reserved, reserveMessage, Service.GetState(), reserved and reservationId or nil
end

function Service.ReleaseReservation(userId, reservationId)
	local key = tostring(userId) .. "_" .. tostring(Product.ProductId)
	if reservationId and localReservations[userId] ~= reservationId then return false end
	localReservations[userId] = nil
	updateState(function(state)
		local res = state.Reservations[key]
		if res and res.State == "Reserved" and (not reservationId or res.ReservationId == reservationId) then state.Reservations[key] = nil end
		return state
	end)
	return true
end

function Service.MarkAwaitingReceipt(userId, reservationId)
	local key = tostring(userId) .. "_" .. tostring(Product.ProductId)
	return updateState(function(state)
		local res = state.Reservations[key]
		if res and res.ReservationId == reservationId and res.State == "Reserved" then
			res.State = "AwaitingReceipt"
			res.ExpiresAt = now() + 45 * 24 * 60 * 60
			res.PromptPurchasedAt = now()
		end
		return state
	end)
end

local function grantCar(player, receiptInfo, buyerPlayer)
	local api = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if not api then return false, "TycoonAdminAPI missing" end
	local isGift = buyerPlayer and buyerPlayer ~= player
	local attrs = { IssuedByServer = true, IssuedAt = now(), BypassStorageLimit = true, Source = isGift and "RobuxGift" or "LimitedCarsShop", ReceiptPurchaseId = receiptInfo.PurchaseId, ReceiptProductId = receiptInfo.ProductId }
	if isGift then
		attrs.GiftSenderUserId = buyerPlayer.UserId
		attrs.GiftReceiverUserId = player.UserId
	end
	local ok, giveOk, msg = pcall(function()
		return PlayerTransactionCoordinator.InvokeBindable(
			player,
			api,
			"GiveTool",
			player,
			Product.CarId,
			attrs
		)
	end)
	if not ok or giveOk ~= true then return false, msg or giveOk or "GiveTool failed" end
	local saveOk, saved = pcall(function()
		return PlayerTransactionCoordinator.InvokeBindable(player, api, "SaveNow", player)
	end)
	if not saveOk or saved ~= true then return false, "Save failed" end
	return true, msg
end

function Service.NotifyClient(player, success, message)
	if player then
		local serial = success == true and (tonumber(player:GetAttribute("LimitedCarReceiptSerial")) or 0) or 0
		PurchaseResultEvent:FireClient(player, success == true, message or "", serial)
	end
end

function Service.ProcessReceipt(receiptInfo, giftTarget)
	local key = receiptKey(receiptInfo)
	local buyer = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	local player = giftTarget or buyer
	if not buyer or not player then return false, "Player unavailable", false end
	local already = false
	local finalized = false
	local ok = updateState(function(state)
		already = false
		finalized = false
		if state.Receipts[key] and state.Receipts[key].State == "Granted" then already = true; finalized = true; return state end
		if state.Receipts[key] and (state.Receipts[key].State == "Processing" or state.Receipts[key].State == "Queued") then finalized = true; return state end
		local rKey = tostring(receiptInfo.PlayerId) .. "_" .. tostring(Product.ProductId)
		local res = state.Reservations[rKey]
		if not res or res.UserId ~= receiptInfo.PlayerId or res.ProductId ~= Product.ProductId
			or (res.State ~= "Reserved" and res.State ~= "AwaitingReceipt")
		then return state end
		state.Reservations[rKey] = nil
		state.Sold = state.Sold + 1
		state.Receipts[key] = { State = "Processing", ReservationId = res.ReservationId, UserId = receiptInfo.PlayerId, TargetUserId = player.UserId, Username = player.Name, ProductId = Product.ProductId, CarId = Product.CarId, FinalizedAt = now() }
		finalized = true
		return state
	end)
	if not ok or not finalized then return false, "Reservation unavailable", false end
	localReservations[receiptInfo.PlayerId] = nil
	if already then return true, "Already granted", true end
	local grantOk, grantMsg = grantCar(player, receiptInfo, buyer)
	if not grantOk then return false, grantMsg, false end
	local announceText = nil
	local markOk = updateState(function(state)
		announceText = nil
		local rec = state.Receipts[key]
		if rec and rec.State == "Processing" then
			rec.State = "Granted"
			rec.GrantedAt = now()
		end
		if rec and not state.AnnouncedReceipts[key] then
			local templates = Product.AnnouncementTemplates
			if player ~= buyer then
				announceText = ("🎁 <b><font color='#55CFFF'>%s</font></b> gifted <b><font color='#FF69B4'>%s</font></b> the <b><font color='#FFD700'>%s</font></b>! 🏎️"):format(buyer.Name, player.Name, Product.DisplayName)
			else
				announceText = string.format(templates[math.random(1, #templates)], player.Name)
			end
			state.AnnouncedReceipts[key] = true
		end
		return state
	end)
	if not markOk then return false, "Receipt mark failed", false end
	if announceText then publishAnnouncement(key, announceText) end
	return true, "Neo Performante Purchased", false
end

function Service.FinalizeQueuedGift(receiptInfo, targetUserId, targetName)
	local key = receiptKey(receiptInfo)
	local already, finalized = false, false
	local ok = updateState(function(state)
		already = false
		finalized = false
		local existing = state.Receipts[key]
		if existing then
			already = existing.State == "Queued" or existing.State == "Granted"
			finalized = existing.TargetUserId == targetUserId
			return state
		end
		local rKey = tostring(receiptInfo.PlayerId) .. "_" .. tostring(Product.ProductId)
		local res = state.Reservations[rKey]
		if not res or res.UserId ~= receiptInfo.PlayerId
			or (res.State ~= "Reserved" and res.State ~= "AwaitingReceipt")
		then return state end
		state.Reservations[rKey] = nil
		state.Sold += 1
		state.Receipts[key] = {
			State = "Queued", ReservationId = res.ReservationId, UserId = receiptInfo.PlayerId,
			TargetUserId = targetUserId, Username = targetName, ProductId = Product.ProductId,
			CarId = Product.CarId, FinalizedAt = now(),
		}
		finalized = true
		return state
	end)
	if finalized then localReservations[receiptInfo.PlayerId] = nil end
	return ok and finalized, finalized and (already and "Already queued" or "Reserved for delivery") or "Reservation unavailable", already
end

GetStateFunction.OnServerInvoke = function(player)
	if not MutationRateLimiter.Allow(player, "LimitedCars:GetState", 4, 0.5) then
		return publicState(currentState or sanitize(nil))
	end
	return Service.GetState()
end
ReserveFunction.OnServerInvoke = function(player)
	if not MutationRateLimiter.Allow(player, "LimitedCars:Reserve", 1, 0.2) then
		return false, "Please wait before trying again", publicState(currentState or sanitize(nil))
	end
	if not MutationRateLimiter.AllowGlobal("LimitedCars:ReserveWrites", 12, 3) then
		return false, "The limited shop is busy. Please try again.", publicState(currentState or sanitize(nil))
	end
	return Service.Reserve(player)
end
PromptClosedEvent.OnServerEvent:Connect(function(player, reservationId)
	if not MutationRateLimiter.Allow(player, "LimitedCars:ClosePrompt", 2, 0.5) then return end
	if not MutationRateLimiter.AllowGlobal("LimitedCars:ReservationCleanupWrites", 30, 10) then return end
	if type(reservationId) ~= "string" or #reservationId > 100 then return end
	Service.ReleaseReservation(player.UserId, reservationId)
end)
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
	if productId ~= Product.ProductId then return end
	local reservationId = localReservations[userId]
	if not reservationId then return end
	if wasPurchased then Service.MarkAwaitingReceipt(userId, reservationId)
	else Service.ReleaseReservation(userId, reservationId) end
end)
Players.PlayerAdded:Connect(function(player) StateEvent:FireClient(player, Service.GetState()) end)
Players.PlayerRemoving:Connect(function(player)
	-- A purchased prompt may receive its receipt after disconnect. The durable
	-- reservation expires by status; an old server never releases a newer id.
	localReservations[player.UserId] = nil
end)
task.spawn(function()
	local retryDelays = { 0, 2, 5, 10, 20 }
	local attempt = 0
	while true do
		attempt += 1
		local delaySeconds = retryDelays[math.min(attempt, #retryDelays)]
		if delaySeconds > 0 then task.wait(delaySeconds) end
		local ok = pcall(function()
			MessagingService:SubscribeAsync(Product.TopicName, function(message)
				if type(message.Data) ~= "table" then return end
				if type(message.Data.Announcement) == "table" then
					local announcement = message.Data.Announcement
					local id = tostring(announcement.ReceiptKey or "")
					if id ~= "" and not seenAnnouncements[id] then
						seenAnnouncements[id] = true
						GlobalChatBroadcast:FireAllClients(announcement)
					end
				elseif message.Data.Remaining ~= nil then
					lastStateReadAt = -math.huge
					StateEvent:FireAllClients(message.Data)
				end
			end)
		end)
		if ok then return end
	end
end)
Service.GetState(true)
task.spawn(function()
	while true do
		task.wait(30)
		Service.GetState(true)
	end
end)
return Service
