-- Purpose: Handles client-side UI and communication for car gifting

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))

local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

local ok, UIAudioConfig = pcall(require, ReplicatedStorage:WaitForChild("UIAudioConfig"))
if not ok then
	UIAudioConfig = {
		PlayHover = function() end,
		PlayClick = function() end
	}
end

-- ============ CONFIG ============
local PROMPT_SCAN_RANGE              = 15
local PROMPT_ACTIVATION_DIST         = 10
local PROMPT_HOLD_DURATION           = 0.5
local NOTIFICATION_DURATION          = 6
local HEARTBEAT_INTERVAL             = 0.1
local GIVER_CLIENT_TIMEOUT_SECONDS   = 70 -- Server timeout is 60, this is only a safety fallback.
-- ================================

local GiftRemotes = ReplicatedStorage:WaitForChild("PlayerCarGiftingRemotes", 10)
if not GiftRemotes then return end

local ActionRemote = GiftRemotes:WaitForChild("ActionRemote", 10)
if not ActionRemote then return end

-- ============================================================================
-- UI GETTERS
-- ============================================================================

local function getGiverUI()
	local folder = PlayerGui:FindFirstChild("Gifting")
	if not folder then return nil, nil end

	local gui = folder:FindFirstChild("Giver")
	if not gui then return nil, nil end

	return gui, gui:FindFirstChild("MainFrame")
end

local function getReceiverUI()
	local folder = PlayerGui:FindFirstChild("Gifting")
	if not folder then return nil, nil end

	local gui = folder:FindFirstChild("Receiver")
	if not gui then return nil, nil end

	return gui, gui:FindFirstChild("MainFrame")
end

local function getStateLabels()
	local statusGui = PlayerGui:FindFirstChild("GiftingStatus")
	if not statusGui then
		warn("⚠️ GiftingStatus ScreenGui missing in PlayerGui!")
		return nil, nil
	end

	local container = statusGui:FindFirstChild("NotificationContainer")
	if not container then
		warn("⚠️ NotificationContainer missing inside GiftingStatus!")
		return nil, nil
	end

	local stateLabels = container:FindFirstChild("StateLabels")
	if not stateLabels then
		warn("⚠️ StateLabels missing inside NotificationContainer!")
		return nil, nil
	end

	local failedLabel = stateLabels:FindFirstChild("Failed")
	local successLabel = stateLabels:FindFirstChild("Success")

	if not failedLabel then
		warn("⚠️ Failed TextLabel missing inside StateLabels!")
	end

	if not successLabel then
		warn("⚠️ Success TextLabel missing inside StateLabels!")
	end

	return failedLabel, successLabel
end

-- ============================================================================
-- STARTUP WIPE
-- ============================================================================

local bootGiver, bootGiverMain = getGiverUI()
local bootReceiver, bootReceiverMain = getReceiverUI()

if bootGiver then bootGiver.Enabled = false end
if bootGiverMain then bootGiverMain.Visible = false end

if bootReceiver then bootReceiver.Enabled = false end
if bootReceiverMain then bootReceiverMain.Visible = false end

do
	local failedLabel, successLabel = getStateLabels()
	if failedLabel then failedLabel.Text = "" end
	if successLabel then successLabel.Text = "" end
end

