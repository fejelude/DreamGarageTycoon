-- ============================================================================
-- STATE
-- ============================================================================

local isGiverProcessing = false
local isReceiverProcessing = false
local giverGiftPending = false
local currentGiverUserId = nil

local currentPromptCarId = nil
local currentPromptReceiverId = nil

local statusState = {
	Timer = nil,
	LastBaseText = nil,
	LastIsSuccess = nil,
	Count = 0
}

-- Prevent old fade tweens from closing a newly reopened UI.
local closeTokens = {}

local function cancelPendingClose(gui)
	if gui then
		closeTokens[gui] = nil
	end
end

-- ============================================================================
-- HELPERS
-- ============================================================================

local function getUserIdFromInfo(info)
	if typeof(info) == "Instance" and info:IsA("Player") then
		return info.UserId
	end

	if typeof(info) == "table" then
		return info.UserId
	end

	return nil
end

local function getNameFromInfo(info)
	if typeof(info) == "Instance" and info:IsA("Player") then
		return info.DisplayName or info.Name
	end

	if typeof(info) == "table" then
		return info.DisplayName or info.Name or tostring(info.UserId or "Unknown")
	end

	return "Unknown"
end

local function getStateIsFailed(data)
	local state = data and data.State
	local text = data and data.Text

	if state == "Failed" or state == "NotificationFalse" then
		return true
	end

	if state == "Success" or state == "Pending" or state == "NotificationTrue" then
		return false
	end

	if typeof(text) == "string" then
		local lower = text:lower()

		if lower:find("fail")
			or lower:find("error")
			or lower:find("full")
			or lower:find("declined")
			or lower:find("left")
			or lower:find("timed out")
			or lower:find("timeout")
			or lower:find("busy")
			or lower:find("missing")
			or lower:find("cancelled")
		then
			return true
		end
	end

	return false
end

local function getStateIsPending(data)
	local state = data and data.State
	return state == "Pending"
end

-- This ONLY updates Text.
-- It does not change TextColor3, Position, Size, Transparency, Visible, or any styling.
local function showStatusNotification(baseText, isSuccess)
	local failedLabel, successLabel = getStateLabels()
	if not failedLabel or not successLabel then return end

	baseText = tostring(baseText or "")

	if statusState.Timer then
		task.cancel(statusState.Timer)
		statusState.Timer = nil
	end

	if statusState.LastBaseText == baseText and statusState.LastIsSuccess == isSuccess then
		statusState.Count += 1
	else
		statusState.LastBaseText = baseText
		statusState.LastIsSuccess = isSuccess
		statusState.Count = 1
	end

	local displayText = baseText
	if statusState.Count > 1 then
		displayText = string.format("%s (x%d)", baseText, statusState.Count)
	end

	local targetLabel = isSuccess and successLabel or failedLabel
	local otherLabel = isSuccess and failedLabel or successLabel

	targetLabel.Text = displayText
	otherLabel.Text = ""

	statusState.Timer = task.delay(NOTIFICATION_DURATION, function()
		if targetLabel and targetLabel.Parent and targetLabel.Text == displayText then
			targetLabel.Text = ""
		end

		if statusState.LastBaseText == baseText and statusState.LastIsSuccess == isSuccess then
			statusState.LastBaseText = nil
			statusState.LastIsSuccess = nil
			statusState.Count = 0
		end
	end)
end

local function fadeOutAndClose(gui, main)
	if not gui or not main then return end

	local token = {}
	closeTokens[gui] = token

	local fadeInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	if main:IsA("CanvasGroup") then
		local tween = TweenService:Create(main, fadeInfo, { GroupTransparency = 1 })
		tween:Play()

		tween.Completed:Connect(function()
			if closeTokens[gui] ~= token then return end

			if main.GroupTransparency >= 0.99 then
				gui.Enabled = false
				main.Visible = false
				main.GroupTransparency = 0
			end
		end)
	else
		gui.Enabled = false
		main.Visible = false
	end
end

local function instantCloseGiver()
	local gGui, gMain = getGiverUI()
	fadeOutAndClose(gGui, gMain)
end

local function instantCloseReceiver()
	local rGui, rMain = getReceiverUI()
	fadeOutAndClose(rGui, rMain)
end

local function applyTierStyling(textLabel, rarity)
	if not textLabel then return end

	local grad = textLabel:FindFirstChild("TierGradient") or Instance.new("UIGradient", textLabel)
	grad.Name = "TierGradient"

	local stroke = textLabel:FindFirstChild("TierStroke") or Instance.new("UIStroke", textLabel)
	stroke.Name = "TierStroke"
	stroke.Thickness = 2

	textLabel.TextColor3 = Color3.new(1, 1, 1)

	if rarity == "Legendary" then
		grad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 100), Color3.fromRGB(255, 150, 0))
		stroke.Color = Color3.fromRGB(100, 50, 0)
	elseif rarity == "Mythic" then
		grad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 255))
		})
		stroke.Color = Color3.fromRGB(255, 255, 255)
	else
		grad.Color = ColorSequence.new(Color3.fromRGB(180, 180, 180), Color3.fromRGB(100, 100, 100))
		stroke.Color = Color3.fromRGB(50, 50, 50)
	end
end

local function getCarData(carId)
	carId = tostring(carId or "")
	local cleanId = carId:gsub(" Item", ""):gsub("Item", "")

	if CarStats.Cars and CarStats.Cars[cleanId] then
		local data = CarStats.Cars[cleanId]
		return {
			Name = cleanId,
			Rarity = data.Rarity,
			Image = data.Image
		}
	end

	return {
		Name = cleanId,
		Rarity = "Common",
		Image = ""
	}
end

local function addHover(btn)
	if not btn or btn:GetAttribute("HoverAdded") then return end
	btn:SetAttribute("HoverAdded", true)

	local uiScale = btn:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", btn)
	local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	btn.MouseEnter:Connect(function()
		UIAudioConfig.PlayHover()
		TweenService:Create(uiScale, tweenInfo, { Scale = 1.05 }):Play()
	end)

	btn.MouseLeave:Connect(function()
		TweenService:Create(uiScale, tweenInfo, { Scale = 1.0 }):Play()
	end)
end

local function setTextIfExists(parent, childName, text)
	local obj = parent and parent:FindFirstChild(childName)
	if obj and obj:IsA("TextLabel") then
		obj.Text = text
	end
end

local function setImageIfExists(parent, childName, image)
	local obj = parent and parent:FindFirstChild(childName)
	if obj and (obj:IsA("ImageLabel") or obj:IsA("ImageButton")) then
		obj.Image = image
	end
end

-- ============================================================================
-- UI BUTTON BINDING
-- ============================================================================

local function bindGiverEvents(giverGui, giverMain)
	if giverGui:GetAttribute("EventsBound") then return end
	giverGui:SetAttribute("EventsBound", true)

	local btnFrame = giverMain:WaitForChild("Buttons"):WaitForChild("ButtonFrame")
	local yesBtn = btnFrame:WaitForChild("Yes")
	local noBtn = btnFrame:WaitForChild("No")

	addHover(yesBtn)
	addHover(noBtn)

	yesBtn.MouseButton1Click:Connect(function()
		if isGiverProcessing or giverGiftPending then
			showStatusNotification("You already have a pending gift.", false)
			instantCloseGiver()
			return
		end

		isGiverProcessing = true
		giverGiftPending = true

		UIAudioConfig.PlayClick()
		ActionRemote:FireServer("GiverAccept")

		instantCloseGiver()

		task.delay(GIVER_CLIENT_TIMEOUT_SECONDS, function()
			if giverGiftPending then
				isGiverProcessing = false
				giverGiftPending = false
				showStatusNotification("Gift request timed out.", false)
			end
		end)
	end)

	noBtn.MouseButton1Click:Connect(function()
		if isGiverProcessing then return end

		isGiverProcessing = true
		UIAudioConfig.PlayClick()

		ActionRemote:FireServer("GiverDecline")

		isGiverProcessing = false
		giverGiftPending = false

		instantCloseGiver()
	end)
end

local function bindReceiverEvents(receiverGui, receiverMain)
	if receiverGui:GetAttribute("EventsBound") then return end
	receiverGui:SetAttribute("EventsBound", true)

	local btnFrame = receiverMain:WaitForChild("Buttons"):WaitForChild("ButtonFrame")
	local yesBtn = btnFrame:WaitForChild("Yes")
	local noBtn = btnFrame:WaitForChild("No")

	addHover(yesBtn)
	addHover(noBtn)

	yesBtn.MouseButton1Click:Connect(function()
		if isReceiverProcessing or not currentGiverUserId then return end

		isReceiverProcessing = true
		UIAudioConfig.PlayClick()

		ActionRemote:FireServer("ReceiverAccept", {
			GiverUserId = currentGiverUserId
		})

		instantCloseReceiver()
	end)

	noBtn.MouseButton1Click:Connect(function()
		if isReceiverProcessing or not currentGiverUserId then return end

		isReceiverProcessing = true
		UIAudioConfig.PlayClick()

		ActionRemote:FireServer("ReceiverDecline", {
			GiverUserId = currentGiverUserId
		})

		isReceiverProcessing = false
		currentGiverUserId = nil

		instantCloseReceiver()
	end)
end

-- ============================================================================
-- SERVER EVENTS
-- ============================================================================

ActionRemote.OnClientEvent:Connect(function(action, data)
	if action == "OpenGiverUI" then
		local giverGui, giverMain = getGiverUI()
		if not giverGui or not giverMain then return end

		cancelPendingClose(giverGui)
		bindGiverEvents(giverGui, giverMain)

		pcall(function()
			playSfx(SFX.Open)
		end)

		local receiverInfo = data and data.Receiver
		local receiverUserId = getUserIdFromInfo(receiverInfo)
		local receiverName = getNameFromInfo(receiverInfo)

		currentPromptCarId = data and data.CarId
		currentPromptReceiverId = receiverUserId

		local carData = getCarData(currentPromptCarId)

		if giverMain:IsA("CanvasGroup") then
			giverMain.GroupTransparency = 0
		end

		setTextIfExists(giverMain, "PlayerName", "to: " .. receiverName)
		setTextIfExists(giverMain, "CarName", carData.Name)

		local carNameLabel = giverMain:FindFirstChild("CarName")
		if carNameLabel then
			applyTierStyling(carNameLabel, carData.Rarity)
		end

		setImageIfExists(giverMain, "CarImage", carData.Image)

		local buttons = giverMain:FindFirstChild("Buttons")
		local buttonFrame = buttons and buttons:FindFirstChild("ButtonFrame")

		if buttonFrame then
			local yes = buttonFrame:FindFirstChild("Yes")
			local no = buttonFrame:FindFirstChild("No")

			if yes then yes.Visible = true end
			if no then no.Visible = true end
		end

		giverMain.Visible = true
		giverGui.Enabled = true

	elseif action == "OpenReceiverUI" then
		local receiverGui, receiverMain = getReceiverUI()
		if not receiverGui or not receiverMain then return end

		if isReceiverProcessing or currentGiverUserId ~= nil then
			local giverId = data and data.Giver and getUserIdFromInfo(data.Giver)
			if giverId then
				ActionRemote:FireServer("ReceiverBusy", {
					GiverUserId = giverId
				})
			end
			return
		end

		cancelPendingClose(receiverGui)
		bindReceiverEvents(receiverGui, receiverMain)

		pcall(function()
			playSfx(SFX.Open)
		end)

		if receiverMain:IsA("CanvasGroup") then
			receiverMain.GroupTransparency = 0
		end

		local giverInfo = data and data.Giver
		currentGiverUserId = getUserIdFromInfo(giverInfo)

		local giverName = getNameFromInfo(giverInfo)
		local carData = getCarData(data and data.CarId)

		setTextIfExists(receiverMain, "SenderName", "from: " .. giverName)
		setTextIfExists(receiverMain, "CarName", carData.Name)

		local carNameLabel = receiverMain:FindFirstChild("CarName")
		if carNameLabel then
			applyTierStyling(carNameLabel, carData.Rarity)
		end

		setImageIfExists(receiverMain, "CarImage", carData.Image)

		local accepted = receiverMain:FindFirstChild("Accepted")
		if accepted then
			accepted.Visible = false
		end

		local buttons = receiverMain:FindFirstChild("Buttons")
		local buttonFrame = buttons and buttons:FindFirstChild("ButtonFrame")

		if buttonFrame then
			local yes = buttonFrame:FindFirstChild("Yes")
			local no = buttonFrame:FindFirstChild("No")

			if yes then yes.Visible = true end
			if no then no.Visible = true end
		end

		receiverMain.Visible = true
		receiverGui.Enabled = true

	elseif action == "UpdateGiverUI" then
		local text = data and data.Text or "Gift status updated."
		local failed = getStateIsFailed(data)
		local pending = getStateIsPending(data)

		isGiverProcessing = false

		if pending then
			giverGiftPending = true
		else
			giverGiftPending = false
		end

		instantCloseGiver()

		if not pending then
			pcall(function()
				playSfx(failed and SFX.Error or SFX.Success)
			end)
		end

		showStatusNotification(text, not failed)

	elseif action == "UpdateReceiverUI" then
		local text = data and data.Text or "Gift status updated."
		local failed = getStateIsFailed(data)

		isReceiverProcessing = false
		currentGiverUserId = nil

		instantCloseReceiver()

		pcall(function()
			playSfx(failed and SFX.Error or SFX.Success)
		end)

		showStatusNotification(text, not failed)

	elseif action == "CloseUI" then
		isGiverProcessing = false
		isReceiverProcessing = false
		giverGiftPending = false
		currentGiverUserId = nil

		instantCloseGiver()
		instantCloseReceiver()
	end
end)

-- ============================================================================
-- DYNAMIC PROXIMITY PROMPT MANAGEMENT
-- ============================================================================

local activePrompts = {}

local function getEquippedCarTool()
	local char = player.Character
	if not char then return nil end

	local tool = char:FindFirstChildOfClass("Tool")

	if tool and (tool:GetAttribute("CarToolPrepared") or tool:FindFirstChild("Handle")) then
		return tool
	end

	return nil
end

local lastHeartbeat = 0

RunService.Heartbeat:Connect(function(dt)
	lastHeartbeat += dt
	if lastHeartbeat < HEARTBEAT_INTERVAL then return end
	lastHeartbeat -= HEARTBEAT_INTERVAL

	local equippedTool = getEquippedCarTool()

	local giverGui, giverMain = getGiverUI()
	local receiverGui, receiverMain = getReceiverUI()

	local giverOpen = (giverGui and giverGui.Enabled and giverMain and giverMain.Visible) or false
	local receiverOpen = (receiverGui and receiverGui.Enabled and receiverMain and receiverMain.Visible) or false
	local uiOpen = giverOpen or receiverOpen

	local localChar = player.Character
	local localRoot = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Torso"))

	local giftBusy =
		giverGiftPending
		or isGiverProcessing
		or isReceiverProcessing
		or currentGiverUserId ~= nil

	if equippedTool and not uiOpen and not giftBusy and localRoot then
		local nearbyPlayers = {}

		for _, otherPlayer in ipairs(Players:GetPlayers()) do
			if otherPlayer ~= player and otherPlayer.Character then
				local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart") or otherPlayer.Character:FindFirstChild("Torso")

				if otherRoot then
					local dist = (localRoot.Position - otherRoot.Position).Magnitude

					if dist <= PROMPT_SCAN_RANGE then
						nearbyPlayers[otherPlayer] = true

						if not activePrompts[otherPlayer] or not activePrompts[otherPlayer].Parent then
							if activePrompts[otherPlayer] then
								activePrompts[otherPlayer]:Destroy()
							end

							local prompt = Instance.new("ProximityPrompt")
							prompt.Name = "GiftCarPrompt_Local"
							prompt.ActionText = "Gift Car"
							prompt.ObjectText = equippedTool.Name
							prompt.RequiresLineOfSight = false
							prompt.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
							prompt.HoldDuration = PROMPT_HOLD_DURATION
							prompt.MaxActivationDistance = PROMPT_ACTIVATION_DIST
							prompt.Enabled = true
							prompt.Parent = otherRoot

							prompt.Triggered:Connect(function()
								local currentTool = getEquippedCarTool()
								if not currentTool then return end

								playSfx(SFX.Click)

								ActionRemote:FireServer("TriggerPrompt", {
									ReceiverUserId = otherPlayer.UserId,
									Tool = currentTool
								})
							end)

							activePrompts[otherPlayer] = prompt
						else
							local prompt = activePrompts[otherPlayer]

							if prompt.ObjectText ~= equippedTool.Name then
								prompt.ObjectText = equippedTool.Name
							end

							if not prompt.Enabled then
								prompt.Enabled = true
							end
						end
					end
				end
			end
		end

		for otherPlayer, prompt in pairs(activePrompts) do
			if not nearbyPlayers[otherPlayer] then
				prompt:Destroy()
				activePrompts[otherPlayer] = nil
			end
		end
	else
		for otherPlayer, prompt in pairs(activePrompts) do
			prompt:Destroy()
			activePrompts[otherPlayer] = nil
		end
	end
end)
