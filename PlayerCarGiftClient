ActionRemote.OnClientEvent:Connect(function(action, data)
	if action == "OpenGiverUI" then
		playSfx(SFX.Open)
		local receiver = data.Receiver
		local carId = data.CarId
		local carData = getCarData(carId)
		
		GiverMain.PlayerName.Text = receiver.Name
		GiverMain.CarName.Text = carData.Name
		applyTierStyling(GiverMain.CarName, carData.Rarity)
		GiverMain.ImageLabel.Image = carData.Image
		
		GiverMain.NotificationTrue.Visible = false
		GiverMain.NotificationFalse.Visible = false
		GiverMain.Yes.Visible = true
		GiverMain.No.Visible = true
		
		GiverGui.Enabled = true
		
	elseif action == "OpenReceiverUI" then
		if ReceiverGui.Enabled then return end -- Protect against concurrent offers
		playSfx(SFX.Open)
		local giver = data.Giver
		local carId = data.CarId
		local expiryTime = data.ExpiryTime
		currentGiverUserId = giver.UserId
		
		local carData = getCarData(carId)
		
		ReceiverMain.SenderName.Text = giver.Name .. " wants to gift you this car"
		ReceiverMain.CarName.Text = carData.Name
		applyTierStyling(ReceiverMain.CarName, carData.Rarity)
		ReceiverMain.ImageLabel.Image = carData.Image
		
		ReceiverMain.Expired.Visible = false
		ReceiverMain.Accepted.Visible = false
		ReceiverMain.Countdown.Visible = true
		ReceiverMain.Yes.Visible = true
		ReceiverMain.No.Visible = true
		
		if countdownConn then countdownConn:Disconnect() end
		countdownConn = RunService.RenderStepped:Connect(function()
			local remaining = math.max(0, math.ceil(expiryTime - workspace:GetServerTimeNow()))
			ReceiverMain.Countdown.Text = tostring(remaining) .. "s"
			if remaining <= 0 then
				countdownConn:Disconnect()
			end
		end)
		
		ReceiverGui.Enabled = true
		
	elseif action == "UpdateGiverUI" then
		if data.State == "NotificationTrue" then
			playSfx(SFX.Success)
			GiverMain.NotificationTrue.Text = data.Text
			GiverMain.NotificationTrue.Visible = true
			GiverMain.NotificationFalse.Visible = false
		elseif data.State == "NotificationFalse" then
			playSfx(SFX.Error)
			GiverMain.NotificationFalse.Text = data.Text
			GiverMain.NotificationFalse.Visible = true
			GiverMain.NotificationTrue.Visible = false
		end
		GiverMain.Yes.Visible = false
		GiverMain.No.Visible = false
		
	elseif action == "UpdateReceiverUI" then
		if data.State == "Expired" then
			playSfx(SFX.Error)
			ReceiverMain.Expired.Visible = true
			ReceiverMain.Countdown.Visible = false
			ReceiverMain.Yes.Visible = false
			ReceiverMain.No.Visible = false
			task.delay(1, function()
				ReceiverGui.Enabled = false
			end)
		elseif data.State == "Accepted" then
			playSfx(SFX.Success)
			ReceiverMain.Accepted.Text = data.Text
			ReceiverMain.Accepted.Visible = true
			ReceiverMain.Countdown.Visible = false
			ReceiverMain.Yes.Visible = false
			ReceiverMain.No.Visible = false
		end
		
	elseif action == "CloseUI" then
		GiverGui.Enabled = false
		ReceiverGui.Enabled = false
		if countdownConn then
			countdownConn:Disconnect()
			countdownConn = nil
		end
	end
end)
