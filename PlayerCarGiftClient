local function playSfx(soundId, volume, parent)
	local s = Instance.new("Sound")
	s.SoundId = soundId
	s.Volume = volume or 0.5
	s.Parent = parent or PlayerGui
	s:Play()
	Debris:AddItem(s, 3)
end

local currentGiverUserId = nil
local countdownConn = nil

local TierColors = {
	Common = Color3.fromRGB(180, 180, 180),
	Uncommon = Color3.fromRGB(0, 200, 200),
	Rare = Color3.fromRGB(0, 100, 255),
	Epic = Color3.fromRGB(150, 0, 255),
	Legendary = Color3.fromRGB(255, 200, 0),
	Mythic = Color3.fromRGB(255, 255, 255)
}

local function applyTierStyling(textLabel, rarity)
	-- Clean previous styling
	for _, child in ipairs(textLabel:GetChildren()) do
		if child.Name == "TierGradient" or child.Name == "TierStroke" then
			child:Destroy()
		end
	end
	
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	local grad = Instance.new("UIGradient")
	grad.Name = "TierGradient"
	grad.Parent = textLabel
	
	local stroke = Instance.new("UIStroke")
	stroke.Name = "TierStroke"
	stroke.Thickness = 2
	stroke.Parent = textLabel
	
	if rarity == "Common" then
		grad.Color = ColorSequence.new(Color3.fromRGB(180, 180, 180), Color3.fromRGB(100, 100, 100))
		stroke.Color = Color3.fromRGB(50, 50, 50)
	elseif rarity == "Uncommon" then
		grad.Color = ColorSequence.new(Color3.fromRGB(0, 255, 200), Color3.fromRGB(0, 100, 150))
		stroke.Color = Color3.fromRGB(0, 50, 80)
	elseif rarity == "Rare" then
		grad.Color = ColorSequence.new(Color3.fromRGB(100, 200, 255), Color3.fromRGB(0, 50, 255))
		stroke.Color = Color3.fromRGB(0, 0, 100)
	elseif rarity == "Epic" then
		grad.Color = ColorSequence.new(Color3.fromRGB(200, 100, 255), Color3.fromRGB(100, 0, 255))
		stroke.Color = Color3.fromRGB(50, 0, 100)
	elseif rarity == "Legendary" then
		grad.Color = ColorSequence.new(Color3.fromRGB(255, 255, 100), Color3.fromRGB(255, 150, 0))
		stroke.Color = Color3.fromRGB(100, 50, 0)
	elseif rarity == "Mythic" then
		grad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 255))
		})
		stroke.Color = Color3.fromRGB(255, 255, 255)
	else
		grad.Color = ColorSequence.new(Color3.fromRGB(180, 180, 180))
		stroke.Color = Color3.fromRGB(50, 50, 50)
	end
	
	-- Animated Shimmer
	if rarity ~= "Common" then
		grad.Offset = Vector2.new(-1, 0)
		local tween = TweenService:Create(grad, TweenInfo.new(2, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), {Offset = Vector2.new(1, 0)})
		tween:Play()
	end
end

local function getCarData(carId)
	local cleanId = carId:gsub(" Item", ""):gsub("Item", "")
	if CarStats.Cars and CarStats.Cars[cleanId] then
		local data = CarStats.Cars[cleanId]
		return { Name = cleanId, Rarity = data.Rarity, Image = data.Image }
	end
	return { Name = cleanId, Rarity = "Common", Image = "" }
end

local function addHover(btn)
	if not btn or btn:GetAttribute("HoverAdded") then return end
	btn:SetAttribute("HoverAdded", true)

	local uiScale = btn:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Scale = 1.0
		uiScale.Parent = btn
	end

	local isHovering = false
	local isPressed  = false
	local tweenInfo  = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	local function updateScale()
		local target = 1.0
		if isPressed     then target = 0.95
		elseif isHovering then target = 1.05
		end
		TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
	end

	btn.MouseEnter:Connect(function()
		isHovering = true
		UIAudioConfig.PlayHover()
		updateScale()
	end)
	btn.MouseLeave:Connect(function()
		isHovering = false
		isPressed  = false
		updateScale()
	end)
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = true
			updateScale()
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = false
			updateScale()
		end
	end)
end

