-- Purpose: Manages plot assignment in a strict ascending sequence, wiping, and safe releasing on leave.
-- Runs on: Server
-- Location: ServerScriptService
-- Dependencies: Workspace.Tycoons
-- Public API: N/A
-- Networking: N/A
-- Security: Server-authoritative plot assignment to prevent double-claiming.
-- Performance: Lightweight table sort on player join; event-based data saving locks.
-- Notes: Assumes tycoons are named sequentially (e.g., "Tycoon1", "Tycoon2").

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ServerStorage = game:GetService("ServerStorage")

local TycoonFolder = Workspace:WaitForChild("Tycoons")

-- 🔗 SYNC EVENT (Communication with TycoonDataHandler)
local SaveEvent = ServerStorage:FindFirstChild("TycoonSaveCompleted")
if not SaveEvent then
	SaveEvent = Instance.new("BindableEvent")
	SaveEvent.Name = "TycoonSaveCompleted"
	SaveEvent.Parent = ServerStorage
end

-- 🧹 HELPER: Completely reset a plot
local function getLevelModel(plot, levelName)
	local canonicalName = levelName == "Level1" and "NormalLevel1"
		or (levelName == "Level2" and "NormalLevel2" or levelName)
	local model = plot:FindFirstChild(canonicalName)
	if model then return model end

	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local dedicatedFolder = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")
	if dedicatedFolder then
		local plotStorage = dedicatedFolder:FindFirstChild(plot.Name)
		if plotStorage then
			return plotStorage:FindFirstChild(canonicalName)
		end
	end
	return nil
end

local function wipePlot(plot)
	print("🧹 Wiping Plot: " .. plot.Name)
	if plot:FindFirstChild("Owner") then plot.Owner.Value = "" end

	local pending = plot:FindFirstChild("PendingEarnings")
	if pending then pending.Value = 0 end

	-- Clear Saved CPS Attribute
	plot:SetAttribute("CurrentCPS", 0)

	-- Clean Entities
	if plot:FindFirstChild("PlacedCars") then plot.PlacedCars:ClearAllChildren() end

	-- Reset Pads
	local function resetPadsInFolder(padsFolder)
		if not padsFolder then return end
		for _, padObj in pairs(padsFolder:GetChildren()) do
			local padPart = padObj:IsA("Model") and (padObj.PrimaryPart or padObj:FindFirstChildWhichIsA("BasePart")) or padObj
			if padPart then
				local occupied = padPart:FindFirstChild("IsOccupied")
				if occupied then occupied.Value = false end
				local linkedCar = padPart:FindFirstChild("LinkedCar")
				if linkedCar then linkedCar.Value = nil end

				local place = padPart:FindFirstChild("PlacePrompt")
				local pickup = padPart:FindFirstChild("PickupPrompt")

				if place then place.Enabled = false end
				if pickup then pickup.Enabled = false end
			end
		end
	end

	local level1 = getLevelModel(plot, "Level1")
	local level2 = getLevelModel(plot, "Level2")
	if level1 then resetPadsInFolder(level1.Parent:FindFirstChild("Pads")) end
	if level2 then
		resetPadsInFolder(level2.Parent:FindFirstChild("Pads"))

		-- Also ensure level 2 gets moved back to storage safely if not there
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local storageFolder = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")
		if not storageFolder then
			storageFolder = Instance.new("Folder")
			storageFolder.Name = "TycoonLevelStorage"
			storageFolder.Parent = ReplicatedStorage
		end

		local plotStorage = storageFolder:FindFirstChild(plot.Name)
		if not plotStorage then
			plotStorage = Instance.new("Folder")
			plotStorage.Name = plot.Name
			plotStorage.Parent = storageFolder
		end

		-- Restore the default Level 1 pair to the live tycoon. Models and their
		-- sibling Pads folders are swapped together because both levels use the
		-- same direct-child folder name.
		if level1 and level1.Parent ~= plot then
			local level1Pads = level1.Parent:FindFirstChild("Pads")
			local level2Pads = level2.Parent:FindFirstChild("Pads")
			if level1Pads and level2Pads then
				level1Pads.Parent = nil
				level2Pads.Parent = plotStorage
				level1Pads.Parent = plot
			end
			level1.Parent = plot
		end

		if level2.Parent ~= plotStorage then
			level2.Parent = plotStorage
		end
	end
end

-- 🏠 ASSIGN PLOT (ASCENDING SEQUENCE FIX)
local function assignPlot(player)
	if player:GetAttribute("OccupiedPlot") then return end -- Already has one

	-- 1. Gather all plots
	local plots = TycoonFolder:GetChildren()

	-- 2. Sort plots numerically by parsing the number from the Name (e.g., "Tycoon1" -> 1)
	table.sort(plots, function(a, b)
		local numA = tonumber(a.Name:match("%d+")) or 999
		local numB = tonumber(b.Name:match("%d+")) or 999
		return numA < numB
	end)

	-- 3. Loop through the sorted array using ipairs to respect the sequence
	for _, plot in ipairs(plots) do
		local ownerVal = plot:FindFirstChild("Owner")

		-- ✅ CHECK: Only claim if owner string is empty
		if ownerVal and ownerVal.Value == "" then
			-- Fix 1: Race Condition in assignPlot
			-- Claim it atomically immediately before any yielding wipe logic
			ownerVal.Value = player.Name

			-- 🛑 WIPE NOW (Safe time to wipe: slot is "ours")
			wipePlot(plot)

			-- Fix 1.b: wipePlot unconditionally resets the Owner string back to "".
			-- We must re-assert our ownership after the wipe completes!
			ownerVal.Value = player.Name

			player:SetAttribute("OccupiedPlot", plot.Name)

			local function onCharacterAdded(character)
				local spawnPart = plot:WaitForChild("SpawnPoint", 10)
				local hrp = character:WaitForChild("HumanoidRootPart", 10)
				if spawnPart and hrp then
					hrp.Anchored = true 
					character:PivotTo(spawnPart.CFrame + Vector3.new(0, 10, 0))
					task.wait(1.5) 
					hrp.Anchored = false
				end
			end

			player.CharacterAdded:Connect(onCharacterAdded)
			if player.Character then task.spawn(onCharacterAdded, player.Character) end
			return
		end
	end
end

Players.PlayerAdded:Connect(assignPlot)

Players.PlayerRemoving:Connect(function(player)
	local plotName = player:GetAttribute("OccupiedPlot")
	if plotName then
		local plot = TycoonFolder:FindFirstChild(plotName)
		if plot and plot:FindFirstChild("Owner") then

			print("🔒 Locking " .. plotName .. " until data saves...")
			-- ⚠️ CRITICAL FIX: DO NOT clear Owner yet. 
			-- Clearing it now allows a new player to claim/wipe it while data is still saving!

			-- ⏳ EVENT LISTENER (The Senior Fix)
			local didSave = false
			local listener
			local waitStart = os.clock()

			-- Listen for the *final disconnect save*, not any stale successful autosave.
			-- DataSaved can be true from an earlier autosave, so using it here lets this
			-- cleanup wipe the plot while TycoonDataHandler is still taking its final
			-- layout/pending-earnings snapshot.
			listener = SaveEvent.Event:Connect(function(savedName)
				if savedName == player.Name and player:GetAttribute("TycoonFinalSaveCompleted") == true then
					didSave = true
				end
			end)

			if player:GetAttribute("TycoonFinalSaveCompleted") == true then
				didSave = true
			end

			-- WAIT LOOP: Wait until the final save completes OR timeout.
			repeat 
				task.wait(0.1)
				if player:GetAttribute("TycoonFinalSaveCompleted") == true then didSave = true end
			until didSave or (os.clock() - waitStart > 25)

			if listener then listener:Disconnect() end

			-- ✅ NOW we safely release + clean the plot
			wipePlot(plot)
			print("🔓 Released + wiped " .. plotName)

			if didSave then
				print("✅ Data Saved for " .. player.Name .. ". Plot released safely.")
			else
				warn("⚠️ Save Timeout for " .. player.Name .. ". Forcing release of " .. plotName .. " (Data might be risky).")
			end

			-- QUEUE CHECK: Give to someone waiting
			for _, waitingPlayer in pairs(Players:GetPlayers()) do
				if not waitingPlayer:GetAttribute("OccupiedPlot") then
					assignPlot(waitingPlayer)
					if waitingPlayer:GetAttribute("OccupiedPlot") then break end
				end
			end
		end
	end
end)

-- Initial Loop
for _, player in pairs(Players:GetPlayers()) do assignPlot(player) end
