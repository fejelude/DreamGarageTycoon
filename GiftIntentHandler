-- Purpose: Validates Robux gift requests and persists versioned gift intents.
-- Runs on: Server
-- Location: ServerScriptService > GiftIntentHandler

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local GiftProductRegistry = require(ReplicatedStorage:WaitForChild("GiftProductRegistry"))
local GiftIntentStore = require(ServerScriptService:WaitForChild("GiftIntentStore"))
local MutationRateLimiter = require(ServerScriptService:WaitForChild("MutationRateLimiter"))

local function requireInstance(parent, name, className, fullPath)
	local instance = parent:WaitForChild(name, 15)
	if not instance then error("[GiftIntentHandler] Missing required " .. className .. ": " .. fullPath, 0) end
	if not instance:IsA(className) then
		error(("[GiftIntentHandler] %s must be a %s, got %s"):format(fullPath, className, instance.ClassName), 0)
	end
	return instance
end

local Remotes = requireInstance(ReplicatedStorage, "GiftRemotes", "Folder", "ReplicatedStorage > GiftRemotes")
local SetIntentEvent = requireInstance(Remotes, "SetGiftIntent", "RemoteEvent", "ReplicatedStorage > GiftRemotes > SetGiftIntent")
local CreateIntentFunction = requireInstance(Remotes, "CreateGiftIntent", "RemoteFunction", "ReplicatedStorage > GiftRemotes > CreateGiftIntent")
local CancelIntentEvent = requireInstance(Remotes, "CancelGiftIntent", "RemoteEvent", "ReplicatedStorage > GiftRemotes > CancelGiftIntent")
requireInstance(Remotes, "NotifyGiftReceived", "RemoteEvent", "ReplicatedStorage > GiftRemotes > NotifyGiftReceived")
requireInstance(Remotes, "GlobalChatBroadcast", "RemoteEvent", "ReplicatedStorage > GiftRemotes > GlobalChatBroadcast")
requireInstance(Remotes, "GiftPurchaseResult", "RemoteEvent", "ReplicatedStorage > GiftRemotes > GiftPurchaseResult")

local activeClientIntents = {} -- [buyerUserId] = { [productId] = intentId }

local function setLocalIntent(buyerUserId, productId, intentId)
	activeClientIntents[buyerUserId] = activeClientIntents[buyerUserId] or {}
	activeClientIntents[buyerUserId][productId] = intentId
end

local function clearLocalIntent(buyerUserId, productId, intentId)
	local byProduct = activeClientIntents[buyerUserId]
	if not byProduct then return end
	if intentId == nil or byProduct[productId] == intentId then
		byProduct[productId] = nil
	end
	if next(byProduct) == nil then activeClientIntents[buyerUserId] = nil end
end

local function validateReceiver(buyer, receiverUserId)
	if typeof(receiverUserId) ~= "number" then return nil, "Invalid receiver" end
	receiverUserId = math.floor(receiverUserId)
	if receiverUserId == buyer.UserId then return nil, "You cannot gift yourself" end
	local receiver = Players:GetPlayerByUserId(receiverUserId)
	if not receiver then return nil, "Player left the server" end
	if receiver:GetAttribute("Setting_ReceiveGiftsEnabled") == false then
		return nil, receiver.DisplayName .. " has Receive Gifts disabled"
	end
	return receiver
end

local function createIntent(buyer, productId, receiverUserId)
	if not buyer or not buyer.Parent then return false, "Buyer left the server" end
	if not MutationRateLimiter.Allow(buyer, "CreateRobuxGiftIntent", 2, 0.5) then
		return false, "Please wait a moment"
	end
	if not MutationRateLimiter.AllowGlobal("RobuxGiftIntentWrites", 20, 5) then
		return false, "Gift service is busy. Please try again shortly."
	end
	productId = math.floor(tonumber(productId) or 0)
	local productInfo = GiftProductRegistry.GetByProductId(productId)
	if not productInfo or productInfo.Giftable ~= true then
		return false, "This product cannot be gifted"
	end
	local receiver, receiverError = validateReceiver(buyer, receiverUserId)
	if not receiver then return false, receiverError end
	if productInfo.OwnershipAttribute and receiver:GetAttribute(productInfo.OwnershipAttribute) == true then
		return false, receiver.DisplayName .. " already owns this perk"
	end

	local ok, message, intentId = GiftIntentStore.Create(buyer, productId, receiver, productInfo)
	if ok then setLocalIntent(buyer.UserId, productId, intentId) end
	return ok, message, intentId
end

CreateIntentFunction.OnServerInvoke = createIntent

-- Compatibility for older clients. It creates the same durable record, but
-- callers should use CreateGiftIntent so they can keep the returned intent id.
SetIntentEvent.OnServerEvent:Connect(function(buyer, receiverUserId, productId)
	createIntent(buyer, productId, receiverUserId)
end)

CancelIntentEvent.OnServerEvent:Connect(function(buyer, productId, intentId)
	if not MutationRateLimiter.Allow(buyer, "CancelRobuxGiftIntent", 3, 1) then return end
	if not MutationRateLimiter.AllowGlobal("RobuxGiftIntentCleanupWrites", 30, 10) then return end
	productId = math.floor(tonumber(productId) or 0)
	if productId <= 0 then return end
	intentId = type(intentId) == "string" and intentId
		or (activeClientIntents[buyer.UserId] and activeClientIntents[buyer.UserId][productId])
	if not intentId then return end
	GiftIntentStore.Cancel(buyer.UserId, productId, intentId)
	clearLocalIntent(buyer.UserId, productId, intentId)
end)

MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
	local byProduct = activeClientIntents[userId]
	local intentId = byProduct and byProduct[productId]
	if not intentId then return end
	local changed = GiftIntentStore.MarkPromptFinished(userId, productId, intentId, wasPurchased == true)
	if changed and wasPurchased ~= true then clearLocalIntent(userId, productId, intentId) end
end)

Players.PlayerRemoving:Connect(function(player)
	-- The durable intent remains authoritative after disconnect. Local state is
	-- only a convenience for correlating this server's prompt-finished callback.
	activeClientIntents[player.UserId] = nil
end)
