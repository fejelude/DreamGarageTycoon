-- [[ SERVER SCRIPT: GiftIntentHandler (HARDENED) ]]
-- Purpose: Remembers who a player wants to gift AND creates the necessary Remotes.
-- Runs on: Server
-- Location: ServerScriptService

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- 🛠️ Use existing Remotes
local Remotes = ReplicatedStorage:WaitForChild("GiftRemotes") 
local SetIntentEvent = Remotes:WaitForChild("SetGiftIntent")

-- 🗄️ STORAGE: { [BuyerUserId] = ReceiverUserId }
local pendingGifts = {}

-- FIX: Rate-limit intent sets per player to prevent spam/flooding
local lastIntentTime = {}
local INTENT_COOLDOWN = 1 -- seconds

-- 📡 LISTEN FOR INTENT
SetIntentEvent.OnServerEvent:Connect(function(buyer, receiverUserId)
	-- Security: Validate Input Type
	if typeof(receiverUserId) ~= "number" then
		return
	end

	-- FIX: Prevent self-gifting exploit
	if receiverUserId == buyer.UserId then
		return
	end

	-- FIX: Rate limit
	local now = os.clock()
	if lastIntentTime[buyer.UserId] and (now - lastIntentTime[buyer.UserId]) < INTENT_COOLDOWN then
		return
	end
	lastIntentTime[buyer.UserId] = now

	-- FIX: Validate that the receiver actually exists in this server
	local receiverPlayer = Players:GetPlayerByUserId(receiverUserId)
	if not receiverPlayer then
		return
	end

	pendingGifts[buyer.UserId] = receiverUserId
end)

-- 🧹 CLEANUP (If player leaves, clear memory)
Players.PlayerRemoving:Connect(function(player)
	pendingGifts[player.UserId] = nil
	lastIntentTime[player.UserId] = nil
end)

-- 🔒 EXPOSE DATA TO RECEIPT ROUTER
-- FIX: Changed to a Peek + Clear design. GetGiftReceiver now takes an
-- optional `consume` parameter. The ReceiptRouter should:
--   1. Peek first (consume = false) to determine the target
--   2. Only consume (consume = true) AFTER the item grant succeeds
-- This prevents the gift intent from being lost on a failed ProcessReceipt retry.
_G.GetGiftReceiver = function(buyerUserId, consume)
	local receiverId = pendingGifts[buyerUserId]

	if receiverId and consume then
		pendingGifts[buyerUserId] = nil
	end

	return receiverId
end

return {}
