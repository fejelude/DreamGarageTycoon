-- [[ SERVER SCRIPT: GiftIntentHandler (HARDENED) ]]
-- Purpose: Creates gift remotes and owns the server-authoritative Robux gift intent.
-- Runs on: Server
-- Location: ServerScriptService

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local StarterGui = game:GetService("StarterGui")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local GiftProductRegistry = require(ReplicatedStorage:WaitForChild("GiftProductRegistry"))
local GamePassConfig = require(ReplicatedStorage:WaitForChild("GamePassConfig"))

-- Studio may keep the two gift Developer Product ids as attributes on their
-- buttons. Register those server-side; clients never get to nominate an id.
local shopGui = StarterGui:FindFirstChild("ShopUI")
local giftButtons = shopGui and shopGui:FindFirstChild("GiftButtons", true)
if not giftButtons then
	warn("[GiftIntentHandler] StarterGui > ShopUI > ... > GiftButtons was not found; button-attribute Game Pass gift IDs cannot be registered")
end
for buttonName, passKey in pairs({ GiftExclusive = "Exclusive", Gift2xMoney = "DoubleMoney", Gift2xOfflineEarnings = "OfflineEarnings" }) do
	local button = giftButtons and giftButtons:FindFirstChild(buttonName)
	local passInfo = GamePassConfig.Passes[passKey]
	local productId = passInfo and tonumber(passInfo.GiftProductId)
	if (not productId or productId <= 0) and button then
		productId = tonumber(button:GetAttribute("DeveloperProductId") or button:GetAttribute("ProductId"))
	end
	if productId and productId > 0 then
		GiftProductRegistry.RegisterGamePassGift(productId, passKey, passInfo)
	end
end

local function requireInstance(parent, name, className, fullPath)
	local instance = parent:WaitForChild(name, 15)
	if not instance then error("[GiftIntentHandler] Missing required " .. className .. ": " .. fullPath, 0) end
	if not instance:IsA(className) then
		error(("[GiftIntentHandler] %s must be a %s, got %s"):format(fullPath, className, instance.ClassName), 0)
	end
	return instance
end

local Remotes = requireInstance(ReplicatedStorage, "GiftRemotes", "Folder", "ReplicatedStorage > GiftRemotes")
local SetIntentEvent = requireInstance(Remotes, "SetGiftIntent", "RemoteEvent", "ReplicatedStorage > GiftRemotes > SetGiftIntent")
local CreateIntentFunction = requireInstance(Remotes, "CreateGiftIntent", "RemoteFunction", "ReplicatedStorage > GiftRemotes > CreateGiftIntent")
local CancelIntentEvent = requireInstance(Remotes, "CancelGiftIntent", "RemoteEvent", "ReplicatedStorage > GiftRemotes > CancelGiftIntent")
requireInstance(Remotes, "NotifyGiftReceived", "RemoteEvent", "ReplicatedStorage > GiftRemotes > NotifyGiftReceived")
requireInstance(Remotes, "GlobalChatBroadcast", "RemoteEvent", "ReplicatedStorage > GiftRemotes > GlobalChatBroadcast")
requireInstance(Remotes, "GiftPurchaseResult", "RemoteEvent", "ReplicatedStorage > GiftRemotes > GiftPurchaseResult")

-- { [buyerUserId] = { ReceiverUserId, ProductId, CreatedAt, ExpiresAt } }
local pendingGifts = {}
local lastIntentTime = {}
local intentStore = DataStoreService:GetDataStore("PendingRobuxGiftIntents_V1")

local INTENT_COOLDOWN = 0.75
-- Pending contexts remain until a trusted unsuccessful prompt or the exact fulfilled receipt.
local INTENT_TTL = 7 * 24 * 60 * 60 -- metadata, never proof of an uncharged purchase
local function intentKey(userId) return "Buyer_" .. tostring(userId) end

local function isStoredIntent(value)
	return type(value) == "table"
		and value.State ~= "Cleared"
		and tonumber(value.ReceiverUserId) ~= nil
		and tonumber(value.ProductId) ~= nil
end

local function sameIntent(a, b)
	if not isStoredIntent(a) or not isStoredIntent(b) then return false end
	if a.Token and b.Token then return a.Token == b.Token end
	return tonumber(a.ReceiverUserId) == tonumber(b.ReceiverUserId)
		and tonumber(a.ProductId) == tonumber(b.ProductId)
		and tonumber(a.CreatedAt) == tonumber(b.CreatedAt)
end

local function loadIntent(buyerUserId)
	if pendingGifts[buyerUserId] then return pendingGifts[buyerUserId] end
	local ok, stored = pcall(function() return intentStore:GetAsync(intentKey(buyerUserId)) end)
	if not ok then return nil, "Unavailable" end
	if isStoredIntent(stored) then pendingGifts[buyerUserId] = stored end
	return pendingGifts[buyerUserId]
end

local function clearPersistedIntent(buyerUserId, expectedIntent, purchaseId, unsuccessfulPrompt)
	if not expectedIntent then return false end
	local cleared = false
	local ok, result = pcall(function()
		return intentStore:UpdateAsync(intentKey(buyerUserId), function(current)
			cleared = false
			if sameIntent(current, expectedIntent)
				and ((purchaseId and tostring(current.PurchaseId) == tostring(purchaseId))
					or (unsuccessfulPrompt and expectedIntent.State == "Pending"
						and current.State == "Pending" and not current.PurchaseId))
			then
				cleared = true
				return {
					State = "Cleared",
					Token = current.Token,
					ClearedAt = os.time(),
					ExpiresAt = 0,
				}
			end
			return current
		end)
	end)

	if ok then
		pendingGifts[buyerUserId] = isStoredIntent(result) and result or nil
	end
	return ok and cleared
end

local function pruneExpiredIntent(buyerUserId)
	-- Never expire accepted purchase context. Expiry does not prove no charge.
	return loadIntent(buyerUserId)
end

local function validateIntentRequest(buyer, productId, receiverUserId)
	if not buyer or not buyer.Parent then
		return false, "Buyer left the server"
	end
	if buyer:GetAttribute("TycoonDataLoaded") ~= true then
		return false, "Your data is still loading"
	end

	if typeof(productId) ~= "number" or productId <= 0 or productId >= math.huge or productId ~= math.floor(productId) then
		return false, "Invalid gift product"
	end

	if not GiftProductRegistry.IsGiftable(productId) then
		return false, "This product cannot be gifted"
	end

	-- Local multi-client Studio players have generated negative UserIds. They
	-- are safe only after resolving to an actual Player in this server below.
	if typeof(receiverUserId) ~= "number" or receiverUserId == 0 or math.abs(receiverUserId) >= math.huge or receiverUserId ~= math.floor(receiverUserId) then
		return false, "Invalid receiver"
	end

	if receiverUserId == buyer.UserId then
		return false, "You cannot gift yourself"
	end

	local now = os.clock()
	if lastIntentTime[buyer.UserId] and (now - lastIntentTime[buyer.UserId]) < INTENT_COOLDOWN then
		return false, "Please wait a moment"
	end
	lastIntentTime[buyer.UserId] = now

	local receiverPlayer = Players:GetPlayerByUserId(receiverUserId)
	if not receiverPlayer then
		return false, "Player left the server"
	end
	if receiverUserId < 0 and not RunService:IsStudio() then
		return false, "Invalid receiver"
	end
	if receiverPlayer:GetAttribute("TycoonDataLoaded") ~= true then
		return false, "This player's data is still loading"
	end
	local product = GiftProductRegistry.GetByProductId(productId)
	if product and product.OwnershipAttribute and receiverPlayer:GetAttribute("GamePassOwnershipReady") ~= true then
		return false, "This player's ownership is still loading"
	end
	if product and product.OwnershipAttribute and receiverPlayer:GetAttribute(product.OwnershipAttribute) == true then
		return false, receiverPlayer.Name .. " already owns this perk"
	end

	return true
end

local function setIntent(buyer, productId, receiverUserId)
	local valid, message = validateIntentRequest(buyer, productId, receiverUserId)
	if not valid then
		return false, message
	end

	-- Recover completion followed by a crash before intent cleanup.
	local previous, previousError = loadIntent(buyer.UserId)
	if previousError then return false, "Gift purchase context is temporarily unavailable" end
	if previous and previous.PurchaseId and type(_G.GiftReceiptWasFulfilled) == "function"
		and _G.GiftReceiptWasFulfilled(buyer.UserId, previous.PurchaseId) == true then
		clearPersistedIntent(buyer.UserId, previous, previous.PurchaseId, false)
	end

	local now = os.time()
	local receiverPlayer = Players:GetPlayerByUserId(receiverUserId)
	local candidate = {
		State = "Pending",
		Token = HttpService:GenerateGUID(false),
		ReceiverUserId = receiverUserId,
		ReceiverUsername = receiverPlayer and receiverPlayer.Name or nil,
		ReceiverDisplayName = receiverPlayer and receiverPlayer.DisplayName or nil,
		SenderUsername = buyer.Name,
		SenderDisplayName = buyer.DisplayName,
		ProductId = math.floor(productId),
		CreatedAt = now,
		ExpiresAt = now + INTENT_TTL,
	}
	local accepted = false
	local conflict = false
	local saved, result = pcall(function()
		return intentStore:UpdateAsync(intentKey(buyer.UserId), function(current)
			accepted = false
			conflict = false
			if isStoredIntent(current) then
				if current.State == "Pending" and not current.PurchaseId
					and tonumber(current.ProductId) == candidate.ProductId
					and tonumber(current.ReceiverUserId) == candidate.ReceiverUserId
				then
					accepted = true
					return current
				end
				conflict = true
				return current
			end
			accepted = true
			return candidate
		end)
	end)
	if not saved or not accepted or not isStoredIntent(result) then
		return false, conflict and "Another gift purchase is already pending"
			or ("Unable to securely save gift intent: " .. tostring(result))
	end

	pendingGifts[buyer.UserId] = result
	return true, "Gift ready"
end

CreateIntentFunction.OnServerInvoke = function(buyer, productId, receiverUserId)
	return setIntent(buyer, productId, receiverUserId)
end

-- Backwards-compatible event path. New clients use CreateGiftIntent so the
-- purchase prompt only opens after the server has committed the intent.
SetIntentEvent.OnServerEvent:Connect(function(buyer, receiverUserId, productId)
	if typeof(productId) ~= "number" then
		return
	end
	setIntent(buyer, productId, receiverUserId)
end)

-- A client cannot certify that Roblox did not charge a purchase.
CancelIntentEvent.OnServerEvent:Connect(function() end)

MarketplaceService.PromptProductPurchaseFinished:Connect(function(buyerUserId, productId, wasPurchased)
	local intent = loadIntent(buyerUserId)
	if not intent or tonumber(intent.ProductId) ~= tonumber(productId) then return end
	if not wasPurchased then
		clearPersistedIntent(buyerUserId, intent, nil, true)
		return
	end
	local purchasedIntent = table.clone(intent)
	if purchasedIntent.State == "Pending" then purchasedIntent.State = "Purchased" end
	pendingGifts[buyerUserId] = purchasedIntent
	local ok, result = pcall(function()
		return intentStore:UpdateAsync(intentKey(buyerUserId), function(current)
			if sameIntent(current, intent) and current.State == "Pending" then
				current.State = "Purchased"
				current.PurchasedAt = os.time()
			end
			return current
		end)
	end)
	if ok then pendingGifts[buyerUserId] = isStoredIntent(result) and result or nil end
end)

Players.PlayerRemoving:Connect(function(player)
	lastIntentTime[player.UserId] = nil
	pendingGifts[player.UserId] = nil -- durable context survives departure
end)

_G.GetGiftIntent = function(buyerUserId, productId, _consume)
	local intent, loadError = pruneExpiredIntent(buyerUserId)
	if loadError then return nil, loadError end
	if not intent then return nil, "NoIntent" end
	if typeof(productId) == "number" and tonumber(intent.ProductId) ~= productId then
		return nil, "ProductMismatch", intent
	end
	return intent, nil
end

_G.BindGiftIntent = function(buyerUserId, productId, purchaseId, expectedIntent)
	local bound = false
	local ok, result = pcall(function()
		return intentStore:UpdateAsync(intentKey(buyerUserId), function(current)
			bound = false
			if not sameIntent(current, expectedIntent) or tonumber(current.ProductId) ~= productId then return current end
			if current.PurchaseId and tostring(current.PurchaseId) ~= tostring(purchaseId) then return current end
			current.State = "Bound"
			current.PurchaseId = tostring(purchaseId)
			current.BoundAt = current.BoundAt or os.time()
			bound = true
			return current
		end)
	end)
	if ok then pendingGifts[buyerUserId] = isStoredIntent(result) and result or nil end
	return ok and bound, ok and bound and result or nil
end

_G.ClearGiftIntent = function(buyerUserId, productId, purchaseId)
	if not purchaseId then return false end
	local intent = loadIntent(buyerUserId)
	if not intent or tonumber(intent.ProductId) ~= tonumber(productId) then return false end
	return clearPersistedIntent(buyerUserId, intent, purchaseId, false)
end

-- Compatibility API is read-only.
_G.GetGiftReceiver = function(buyerUserId, _consume)
	local intent = pruneExpiredIntent(buyerUserId)
	return intent and intent.ReceiverUserId
end

return {}
