				if cf then mainCraftBtn = cf:FindFirstChild("Craft") or cf:FindFirstChild("CraftButton") end
			end
			if not mainCraftBtn then
				mainCraftBtn = carFrame:FindFirstChild("CraftButton", true) or carFrame:FindFirstChild("Craft", true)
			end
	local premiumCraftBtn
	if mainCraftBtn then
		premiumCraftBtn = mainCraftBtn.Parent:FindFirstChild("PremiumCraft")
	end

			if mainCraftBtn and not mainCraftBtn:GetAttribute("Connected") then
				mainCraftBtn:SetAttribute("Connected", true)
				Kit.Tween:SetupButton(mainCraftBtn, function()
					if mainCraftBtn.Visible and mainCraftBtn.Active
						and activeCarFocus == carName and isShopOpen then
						AttemptCraft(carName)
					end
				end)
			end

	if premiumCraftBtn and not premiumCraftBtn:GetAttribute("Connected") then
		premiumCraftBtn:SetAttribute("Connected", true)
		Kit.Tween:SetupButton(premiumCraftBtn, function()
			if premiumCraftBtn.Visible and premiumCraftBtn.Active
				and activeCarFocus == carName and isShopOpen then
				if currentState and currentState.ActiveCrafts and currentState.ActiveCrafts[carName] then
					MarketplaceService:PromptProductPurchase(player, MYTHICAL_SKIP_PRODUCT_ID)
				else
					ethourahSpeak(pickRandom({
						"You don't have an active build for the <font color='#00E5FF'>" .. getDisplayCarName(carName) .. "</font> yet.",
						"Start the build before trying to speed it up.",
					}))
				end
			end
		end)
	end

			if sacrificeItems then
				for ingredient, _ in pairs(RECIPES[carName]) do
					if ingredient == "TargetCar" or ingredient == "CraftTime" then continue end
					local reqFrame = sacrificeItems:FindFirstChild(ingredient)
					if reqFrame then
						local sacBtn = reqFrame:FindFirstChild("SacrificeButton")
						if sacBtn and not sacBtn:GetAttribute("Connected") then
							sacBtn:SetAttribute("Connected", true)
							Kit.Tween:SetupButton(sacBtn, function()
								if sacBtn.Visible and sacBtn.Active
									and activeCarFocus == carName and isShopOpen then
									AttemptSacrifice(carName, ingredient)
								end
							end)
						end
					end
				end
			end
		end
	end

	-- Ethourah speaks first; crafting menu only appears after he finishes
	local displayName = getDisplayCarName(carName)
	ethourahSpeak(pickRandom({
		"Ah, the <font color='#00E5FF'>" .. displayName .. "</font>. A beautiful choice.",
		"The <font color='#00E5FF'>" .. displayName .. "</font>? You have good taste.",
		"Excellent selection. Let's look at what is required.",
	}), function()
		if activeCarFocus == carName and isShopOpen and craftGui then
			craftGui.Visible  = true
			mainFrame.Visible = false
		else
			mainFrame.Visible = true
		end
	end)
end

