-- ============================================================================
local function AttemptCraft(carName)
	if isProcessingPurchase then return end
	if not isShopOpen or activeCarFocus ~= carName then return end
	if not currentState or not currentState.CompletedCrafts then return end

	local recipe      = RECIPES[carName]
	local displayName = getDisplayCarName(carName)
	local coloredName = "<font color='" .. USER_COLOR .. "'>@" .. player.Name .. "</font>"
	local craftGui    = gui:FindFirstChild(carName .. "Crafting")

	local function restoreToCraftingFrame()
		if activeCarFocus == carName and isShopOpen and craftGui then
			craftGui.Visible  = true
			mainFrame.Visible = false
		else
			mainFrame.Visible = true
		end
	end

	-- Already crafting
	if currentState.ActiveCrafts and currentState.ActiveCrafts[carName] then
		local delta   = math.max(0, currentState.ActiveCrafts[carName] - os.time())
		local timeStr = string.format("%02d:%02d:%02d",
			math.floor(delta / 3600), math.floor((delta % 3600) / 60), math.floor(delta % 60))
		ethourahSpeak(pickRandom({
			"Patience. you cant make another one dude. im already making the <font color='#B652FF'>" .. displayName .. "</font> right now. It will be ready in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"i am making a car for you at this moment " .. coloredName .. " i am making <font color='#B652FF'>" .. displayName .. "</font>. Check back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"You cant rush perfection " .. coloredName .. " The <font color='#B652FF'>" .. displayName .. "</font> needs <font color='#FF4C4C'>" .. timeStr .. "</font> more time, come back later alright?",
			"I am working as fast as I can. Come back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
			"The metal is still hot. You must wait exactly <font color='#FF4C4C'>" .. timeStr .. "</font> before the build is complete.",
		}), restoreToCraftingFrame)
		return
	end

	-- Already completed
	if currentState.CompletedCrafts[carName] then
		ethourahSpeak(pickRandom({
			"It is finished. The <font color='#B652FF'>" .. displayName .. "</font> is a true work of art. It should be in your inventory already.",
			"The <font color='#B652FF'>" .. displayName .. "</font> is already there in your inventory, " .. coloredName .. ".",
			"Construction of the <font color='#B652FF'>" .. displayName .. "</font> is done. A flawless execution. It's already there in your inventory.",
		}), restoreToCraftingFrame)
		return
	end

	-- ── Requirements check ────────────────────────────────────────────────────
	-- If the player clicks Confirm before all sacrifices are done, Ethourah
	-- tells them exactly what's still missing in rich coloured text.
	local missingItems  = {}
	local totalMissing  = 0
	local progress      = currentState.CraftProgress[carName] or {}

	for ingredient, requiredAmount in pairs(recipe) do
		if ingredient == "TargetCar" or ingredient == "CraftTime" then continue end
		local current = progress[ingredient] or 0
		local left    = requiredAmount - current
		if left > 0 then
			if ingredient == "Cash" then
				table.insert(missingItems,
					"<font color='#FFD700'>$" .. FormatCommas(left) .. "</font> Cash")
			else
				table.insert(missingItems,
					"<font color='#FF6B6B'>" .. left .. "x</font> <font color='#00E5FF'>"
						.. ingredient .. "</font>")
			end
			totalMissing += left
		end
	end

	if #missingItems > 0 then
		-- Build a compact inline list:  "3x Riva, 2x Kingston, $50,000,000 Cash"
		local listStr = table.concat(missingItems, "<font color='#AAAAAA'>, </font>")

		ethourahSpeak(pickRandom({
			-- Stern / blunt
			"<font color='#FF4C4C'>Not yet.</font> You are still missing: "
				.. listStr
				.. "<font color='#f4efe6'>. Come back when the tribute is complete.</font>",

			-- Disappointed mentor
			"<font color='#FFD700'>Seriously?</font> The forge cannot be lit. You still owe me "
				.. listStr
				.. "<font color='#f4efe6'>. Don't waste my time until you have it all.</font>",

			-- Cold and professional
			"<font color='#00E5FF'>Incomplete.</font> The ritual requires "
				.. listStr
				.. "<font color='#f4efe6'>. Every piece matters — bring them all before you dare press that button again.</font>",

			-- Slightly theatrical
			"The <font color='#B652FF'>" .. displayName .. "</font>"
				.. "<font color='#f4efe6'> is a myth. Myths demand sacrifice. You are short </font>"
				.. listStr
				.. "<font color='#f4efe6'>. Return when the debt is paid.</font>",

			-- Direct and dismissive
			coloredName
				.. "<font color='#f4efe6'> you are </font><font color='#FF4C4C'>"
				.. totalMissing .. " sacrifice" .. (totalMissing == 1 and "" or "s")
				.. "</font><font color='#f4efe6'> short. Still need: </font>"
				.. listStr
				.. "<font color='#f4efe6'>.</font>",
		}), restoreToCraftingFrame)
		return
	end

	-- Start craft
	local craftHours = tostring(math.floor((recipe.CraftTime or 0) / 3600))
	local confirmText = string.format(
		"<font color='%s'>Begin forging </font><b><font color='%s'>%s</font></b><font color='%s'>? Once the ritual starts, it will take </font><b><font color='%s'>%s hours</font></b><font color='%s'> to complete.</font>",
		CONFIRMATION_COLORS.Accent, CONFIRMATION_COLORS.Target,    escapeRichText(displayName),
		CONFIRMATION_COLORS.Accent, CONFIRMATION_COLORS.Sacrifice, escapeRichText(craftHours),
		CONFIRMATION_COLORS.Accent
	)

	local requestSessionId   = shopSessionId
	local requestViewVersion = shopViewVersion

	PromptConfirmation(requestSessionId, confirmText, function(confirmed)
		if not confirmed then return end
		if not isActiveShopSession(requestSessionId) or requestViewVersion ~= shopViewVersion then return end
		if isProcessingPurchase then return end
		isProcessingPurchase = true

		Kit.Sound:Play("Click")

		task.spawn(function()
			local success, msg = FuncCraftCar:InvokeServer(carName)
			if requestSessionId == shopSessionId then isProcessingPurchase = false end
			if not isActiveShopSession(requestSessionId) then mainFrame.Visible = true; return end

			currentState = FuncGetState:InvokeServer()
			UpdateDisplay()

			if success then
				Kit.Sound:Play("BuySuccess")
				showFeedback("Crafting Started!", FEEDBACK_COLORS.Success)
				if requestViewVersion == shopViewVersion and activeCarFocus == carName then
					local timeStr = "..."
					if currentState.ActiveCrafts and currentState.ActiveCrafts[carName] then
						local delta = math.max(0, currentState.ActiveCrafts[carName] - os.time())
						timeStr = string.format("%02d:%02d:%02d",
							math.floor(delta / 3600), math.floor((delta % 3600) / 60), math.floor(delta % 60))
					end
					ethourahSpeak(pickRandom({
						"Alright im working on making your <font color='#B652FF'>" .. displayName .. "</font>, be back in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
						"Crafting underway homie. The <font color='#B652FF'>" .. displayName .. "</font> will be ready in <font color='#FF4C4C'>" .. timeStr .. "</font>.",
					}), restoreToCraftingFrame)
				else
					mainFrame.Visible = true
				end
			else
				Kit.Sound:Play("BuyFail")
				showFeedback(msg, FEEDBACK_COLORS.FailCash)
				restoreToCraftingFrame()
			end
		end)
	end)
end

