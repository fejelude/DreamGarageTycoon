local function FormatCommas(num)
	return tostring(num):reverse():gsub("%d%d%d", "%1,"):reverse():gsub("^,", "")
end

local function FormatAbbreviated(num)
	if num >= 1e12 then
		return string.format("%.1fT", num / 1e12):gsub("%.0T", "T")
	elseif num >= 1e9 then
		return string.format("%.1fB", num / 1e9):gsub("%.0B", "B")
	elseif num >= 1e6 then
		return string.format("%.1fM", num / 1e6):gsub("%.0M", "M")
	elseif num >= 1e3 then
		return string.format("%.1fK", num / 1e3):gsub("%.0K", "K")
	else
		return tostring(num)
	end
end

local function escapeRichText(text)
	text = tostring(text)
	return text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;")
end

-- ============================================================================
-- 💬  ETHOURAH SPEAK  — v2 (stacking / stale-callback fix)
--
-- Design:
--   • hideAllShopFrames()    — called at the START of every speak; ensures no
--                              crafting frame or mainFrame is visible while the
--                              NPC speech bubble is on screen. This is the
--                              primary fix for the overlay/stacking bug.
--   • ethourahJobId counter   — every new speak increments the counter and
--                              captures a local copy. The typewriter coroutine
--                              checks its copy against the global after every
--                              character; if they differ the job was superseded
--                              and it exits without calling onDone. This
--                              prevents stale callbacks from restoring the
--                              wrong frame after cancellation.
--   • getNpcUI / hideNpcUI  — thin helpers; avoid repeated FindFirstChild
--                              chains scattered across functions.
-- ============================================================================
local NPC_GUI_ID       = "UI_NPC_ethourah"
local NPC_CONTAINER_ID = "Frame_Ethourah_Container"
local NPC_TEXT_ID      = "Text_Ethourah_Dialogue"
local TYPING_SOUND_ID  = "rbxassetid://4676738150"
local TYPEWRITER_SPEED = 0.02

local activeEthourahJob = nil
local ethourahJobId     = 0   -- incremented on every new speak or cancel
local typingSound = Instance.new("Sound")
typingSound.SoundId = TYPING_SOUND_ID
typingSound.Volume = 0.1
typingSound.Parent = SoundService

-- Returns (npcGui, container, label) — any may be nil if not found
local function getNpcUI()
	local npcGui    = PlayerGui:FindFirstChild(NPC_GUI_ID)
	local container = npcGui and npcGui:FindFirstChild(NPC_CONTAINER_ID, true)
	local label     = container and container:FindFirstChild(NPC_TEXT_ID, true)
	return npcGui, container, label
end

-- Unconditionally hide the speech bubble
local function hideNpcUI()
	local npcGui, container = getNpcUI()
	if npcGui    then npcGui.Enabled    = false end
	if container then container.Visible = false end
end

-- FIX: hides every shop-owned frame so the NPC bubble is the sole visible UI.
-- Previously only mainFrame was hidden, leaving crafting frames visible.
local function hideAllShopFrames()
	mainFrame.Visible = false
	for _, n in ipairs(SHOP_CARS) do
		local c = gui:FindFirstChild(n .. "Crafting")
		if c then c.Visible = false end
	end
end

local function cleanTextLength(str)
	local clean = str:gsub("<[^>]+>", "")
	return utf8.len(clean) or #clean
end

local function ethourahSpeak(msg, onDone)
	-- Invalidate any previous job before starting a new one
	ethourahJobId += 1
	local myJobId = ethourahJobId

	-- Cancel the running coroutine (best-effort; the ID guard is the true safety)
	if activeEthourahJob then
		pcall(task.cancel, activeEthourahJob)
		activeEthourahJob = nil
	end

	local npcGui, container, label = getNpcUI()

	if not label then
		-- NPC GUI is missing; restore immediately
		hideNpcUI()
		if onDone then task.spawn(onDone) else mainFrame.Visible = true end
		return
	end

	-- ── Step 1: Hide ALL shop frames before showing the speech bubble ─────
	hideAllShopFrames()

	-- ── Step 2: Prepare and show the speech bubble from a clean state ─────
	npcGui.Enabled            = true
	container.Visible         = true
	label.RichText            = true
	label.Text                = msg
	label.MaxVisibleGraphemes = 0

	local len = cleanTextLength(msg)

	-- ── Step 3: Typewriter coroutine with job-ID guard ────────────────────
	activeEthourahJob = task.spawn(function()
		for i = 1, len do
			-- Bail out if this job has been superseded
			if ethourahJobId ~= myJobId then return end

			label.MaxVisibleGraphemes = i

			if i % 3 == 0 then
				typingSound:Play()




			end

			task.wait(TYPEWRITER_SPEED)
		end

		-- Final check after loop completes
		if ethourahJobId ~= myJobId then return end

		label.MaxVisibleGraphemes = -1
		activeEthourahJob = nil

		-- ── Step 4: Hold the completed message so the player can read it ─
		if POST_SPEAK_DELAY > 0 then
			task.wait(POST_SPEAK_DELAY)
		end

		-- Guard again: a new speak or cancelEthourahSpeak may have fired
		-- during the delay — if so, let that job own the UI.
		if ethourahJobId ~= myJobId then return end

		-- ── Step 5: Hide the speech bubble ───────────────────────────────
		hideNpcUI()

		-- ── Step 6: Restore UI — caller supplies onDone, else mainFrame ──
		if onDone then
			task.spawn(onDone)
		else
			mainFrame.Visible = true
		end
	end)
end

-- Cancel any active speak and ensure the speech bubble is hidden.
-- Does NOT restore any shop frame — callers are responsible for that.
local function cancelEthourahSpeak()
	ethourahJobId += 1   -- invalidates the running job's callback
	if activeEthourahJob then
		pcall(task.cancel, activeEthourahJob)
		activeEthourahJob = nil
	end
	hideNpcUI()
end

-- ============================================================================
-- 🔎  CLIENT-SIDE ITEM CHECK
-- ============================================================================
local function playerHasIngredient(ingredient, requiredAmount, currentAmount)
	if ingredient == "Cash" then
		local ls     = player:FindFirstChild("leaderstats")
		local wallet = ls and ls:FindFirstChild("Wallet")
		return wallet and wallet.Value >= (requiredAmount - currentAmount)
	else
		local function scanContainer(c)
			if not c then return false end
			for _, tool in ipairs(c:GetChildren()) do
				if tool:IsA("Tool") then
					local id = tool:GetAttribute("ToolId") or tool.Name
					if id == ingredient or id == ingredient .. " Item"
						or tool.Name == ingredient or tool.Name == ingredient .. " Item" then
						return true
					end
				end
			end
			return false
		end
		return scanContainer(player:FindFirstChild("Backpack"))
			or scanContainer(player:FindFirstChild("StarterGear"))
	end
end

