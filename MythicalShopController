local function clearConfirmationConnections()
	for _, c in ipairs(confirmConnections) do if c then c:Disconnect() end end
	confirmConnections = {}
end

local function addConfirmationConnection(conn)
	if conn then table.insert(confirmConnections, conn) end
end

local function resolveGuiButton(target)
	if not target then return nil end
	if target:IsA("GuiButton") then return target end
	for _, d in ipairs(target:GetDescendants()) do
		if d:IsA("GuiButton") then return d end
	end
	return nil
end

local function resolveNamedConfirmationButton(root, exactName, aliases)
	if not root then return nil end
	local direct = resolveGuiButton(root:FindFirstChild(exactName, true))
	if direct then return direct end
	local lowered = { string.lower(exactName) }
	for _, a in ipairs(aliases or {}) do table.insert(lowered, string.lower(a)) end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiButton") then
			local bn = string.lower(d.Name)
			for _, k in ipairs(lowered) do
				if bn == k or string.find(bn, k, 1, true) then return d end
			end
		end
	end
	return nil
end

local _confirmationGui = nil
local function resolveConfirmationUi()
	if _confirmationGui and _confirmationGui.Parent then return _confirmationGui, _confirmationGui:FindFirstChild("MainFrame") end
	_confirmationGui = PlayerGui:FindFirstChild("Confirmation") or PlayerGui:WaitForChild("Confirmation", 5)
	if not _confirmationGui then return nil, nil end
	local cMain = _confirmationGui:FindFirstChild("MainFrame") or _confirmationGui:WaitForChild("MainFrame", 5)
	return _confirmationGui, cMain
end

local function prepareConfirmationButton(b)
	if not b then return nil end
	b.Visible = true; b.Active = true; b.Selectable = true; b.AutoButtonColor = true
	pcall(function() b.Interactable = true end)
	return b
end

local function applyConfirmationButtonFeedback(button)
	button = prepareConfirmationButton(button)
	if not button then return nil end
	local ti = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	if not button:GetAttribute("OrigBgColor") then
		button:SetAttribute("OrigBgColor", button.BackgroundColor3)
		if button:IsA("ImageButton") then button:SetAttribute("OrigImgColor", button.ImageColor3) end
	end
	local origBg  = button:GetAttribute("OrigBgColor")
	local origImg = button:IsA("ImageButton") and button:GetAttribute("OrigImgColor") or nil
	button.BackgroundColor3 = origBg
	if origImg then button.ImageColor3 = origImg end
	local function tv(dim)
		local g = {}
		if button.BackgroundTransparency < 1 then
			local h, s, v = origBg:ToHSV()
			g.BackgroundColor3 = dim and Color3.fromHSV(h, s, math.clamp(v * .75, 0, 1)) or origBg
		end
		if origImg then
			local h, s, v = origImg:ToHSV()
			g.ImageColor3 = dim and Color3.fromHSV(h, s, math.clamp(v * .75, 0, 1)) or origImg
		end
		if next(g) then TweenService:Create(button, ti, g):Play() end
	end
	addConfirmationConnection(button.MouseEnter:Connect(function() Kit.Sound:Play("Hover"); tv(true) end))
	addConfirmationConnection(button.MouseLeave:Connect(function() tv(false) end))
	addConfirmationConnection(button.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
			or i.UserInputType == Enum.UserInputType.Touch then tv(true) end
	end))
	addConfirmationConnection(button.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1
			or i.UserInputType == Enum.UserInputType.Touch then tv(false) end
	end))
	return button
end

local function playConfirmationOpenTween(cMain)
	if not cMain or not cMain:IsA("GuiObject") then return end
	if not cMain:GetAttribute("BasePosStored") then
		cMain:SetAttribute("BasePosStored",  true)
		cMain:SetAttribute("BasePosXScale",  cMain.Position.X.Scale)
		cMain:SetAttribute("BasePosXOffset", cMain.Position.X.Offset)
		cMain:SetAttribute("BasePosYScale",  cMain.Position.Y.Scale)
		cMain:SetAttribute("BasePosYOffset", cMain.Position.Y.Offset)
	end
	local bp = UDim2.new(
		cMain:GetAttribute("BasePosXScale"),  cMain:GetAttribute("BasePosXOffset"),
		cMain:GetAttribute("BasePosYScale"),  cMain:GetAttribute("BasePosYOffset")
	)
	cMain.Position = UDim2.new(bp.X.Scale, bp.X.Offset, bp.Y.Scale, bp.Y.Offset + 18)
	TweenService:Create(cMain, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = bp }):Play()
end

local function hideAllCraftingMenus()
	for _, n in ipairs(SHOP_CARS) do
		local c = gui:FindFirstChild(n .. "Crafting")
		if c then c.Visible = false end
	end
end

local function captureShopViewState()
	local s = { mainFrameVisible = mainFrame.Visible, craftingVisible = {} }
	for _, n in ipairs(SHOP_CARS) do
		local c = gui:FindFirstChild(n .. "Crafting")
		s.craftingVisible[n] = c and c.Visible or false
	end
	return s
end

local function restoreShopViewState(state)
	hideAllCraftingMenus()
	if not state then
		if activeCarFocus then
			mainFrame.Visible = false
			local c = gui:FindFirstChild(activeCarFocus .. "Crafting")
			if c then c.Visible = true else mainFrame.Visible = true end
		else
			mainFrame.Visible = true
		end
		return
	end
	mainFrame.Visible = state.mainFrameVisible == true
	for n, v in pairs(state.craftingVisible) do
		local c = gui:FindFirstChild(n .. "Crafting")
		if c then c.Visible = v == true end
	end
end

local function isActiveShopSession(sessionId)
	return sessionId ~= nil and sessionId == shopSessionId and isShopOpen and gui.Enabled
end

local function beginShopSession()
	shopSessionId       += 1
	shopViewVersion     += 1
	confirmationVersion += 1
	return shopSessionId
end

local dismissConfirmation

local function beginConfirmationView()
	if not confirmationRestoreState then
		confirmationRestoreState = captureShopViewState()
	end
	mainFrame.Visible = false
	hideAllCraftingMenus()
end

local function endConfirmationView()
	restoreShopViewState(confirmationRestoreState)
	confirmationRestoreState = nil
end

local function bindConfirmationButton(button, callback)
	button = applyConfirmationButtonFeedback(button)
	if not button then return end
	local fired = false
	local function hp() if fired then return end; fired = true; callback() end
	addConfirmationConnection(button.Activated:Connect(hp))
	addConfirmationConnection(button.MouseButton1Click:Connect(hp))
	addConfirmationConnection(button.TouchTap:Connect(hp))
end

dismissConfirmation = function()
	confirmationVersion += 1
	clearConfirmationConnections()
	local cGui, cMain = resolveConfirmationUi()
	if cMain and cMain:IsA("GuiObject") then cMain.Visible = false end
	if cGui then cGui.Enabled = false end
	endConfirmationView()
end

local function PromptConfirmation(sessionId, text, callback)
	local cGui, cMain = resolveConfirmationUi()
	if not cGui or not cMain then
		if isActiveShopSession(sessionId) then callback(true) end
		return
	end
	confirmationVersion += 1
	local myVersion = confirmationVersion
	clearConfirmationConnections()
	local infoLabel = cMain:FindFirstChild("Information", true)
	local btnYes    = resolveNamedConfirmationButton(cMain, "Yes",  { "Confirm", "Accept", "Okay", "Ok" })
	local btnNo     = resolveNamedConfirmationButton(cMain, "No",   { "Cancel", "Decline", "Back", "Close" })
	if infoLabel then
		pcall(function() infoLabel.RichText = true; infoLabel.TextWrapped = true; infoLabel.Text = text end)
	end
	beginConfirmationView()
	cGui.Enabled = true
	if cMain:IsA("GuiObject") then cMain.Visible = true; cMain.Active = true end
	pcall(function()
		if cGui:IsA("ScreenGui") then
			cGui.DisplayOrder = math.max(cGui.DisplayOrder, gui.DisplayOrder + 10)
		end
	end)
	playConfirmationOpenTween(cMain)
	local function finishChoice(confirmed)
		if myVersion ~= confirmationVersion then return end
		clearConfirmationConnections()
		if cMain:IsA("GuiObject") then cMain.Visible = false end
		cGui.Enabled = false
		endConfirmationView()
		if isActiveShopSession(sessionId) then callback(confirmed) end
	end
	bindConfirmationButton(btnYes, function() finishChoice(true)  end)
	bindConfirmationButton(btnNo,  function() finishChoice(false) end)
end

