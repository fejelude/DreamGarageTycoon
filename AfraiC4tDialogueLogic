-- AfraiC4t's retired ATM interaction is intentionally disabled.
-- This compatibility LocalScript hides legacy prompts/UI while Studio instances
-- are being removed. It never invokes a server remote.
local Players = game:GetService("Players")
local player = Players.LocalPlayer

local function disableLegacyATM(instance)
	if instance:IsA("ProximityPrompt") and instance:FindFirstAncestor("AfraiC4t") then
		instance.Enabled = false
	elseif instance:IsA("ScreenGui") and instance.Name == "UI_NPC_ATM_AfraiC4t" then
		instance.Enabled = false
	end
end

for _, instance in ipairs(workspace:GetDescendants()) do disableLegacyATM(instance) end
for _, instance in ipairs(player.PlayerGui:GetDescendants()) do disableLegacyATM(instance) end
workspace.DescendantAdded:Connect(disableLegacyATM)
player.PlayerGui.DescendantAdded:Connect(disableLegacyATM)
