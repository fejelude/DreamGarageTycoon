-- Server ModuleScript: ServerScriptService > GlobalMoneyFrenzyService
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GlobalMoneyFrenzyConfig"))

local REQUIRED_WAIT_SECONDS = 15
local PUBLISH_RETRY_DELAYS = { 0, 1, 3, 7 }
local SUBSCRIBE_RETRY_DELAYS = { 0, 2, 5, 10, 20 }

local function requireChild(parent, childName, className, fullPath)
	local child = parent:WaitForChild(childName, REQUIRED_WAIT_SECONDS)
	if not child then
		error("[GlobalMoneyFrenzyService] Missing required instance: " .. fullPath .. " (" .. className .. ")", 0)
	end
	if className and not child:IsA(className) then
		error("[GlobalMoneyFrenzyService] " .. fullPath .. " must be a " .. className .. ", got " .. child.ClassName, 0)
	end
	return child
end

local remotes = requireChild(ReplicatedStorage, "GlobalMoneyFrenzyRemotes", "Folder", "ReplicatedStorage > GlobalMoneyFrenzyRemotes")
local StateEvent = requireChild(remotes, "State", "RemoteEvent", "ReplicatedStorage > GlobalMoneyFrenzyRemotes > State")
local GetStateFunction = requireChild(remotes, "GetState", "RemoteFunction", "ReplicatedStorage > GlobalMoneyFrenzyRemotes > GetState")
local PurchaseResultEvent = requireChild(remotes, "PurchaseResult", "RemoteEvent", "ReplicatedStorage > GlobalMoneyFrenzyRemotes > PurchaseResult")

local stateStore = DataStoreService:GetDataStore(Config.StateStoreName)

local Service = {}
local currentState = nil
local generation = 0
local expireToken = 0

local function now()
	return os.time()
end

local function inactiveState()
	return {
		Active = false,
		Multiplier = Config.BaseMultiplier,
		ActivatedAt = 0,
		ExpiresAt = 0,
		PurchaserUserId = 0,
		PurchaserUsername = "",
		ReceiptKey = "",
		Revision = 0,
		ProcessedReceipts = {},
	}
end

local function sanitize(raw)
	local s = type(raw) == "table" and raw or inactiveState()
	local processed = type(s.ProcessedReceipts) == "table" and s.ProcessedReceipts or {}
	local compact, entries = {}, {}
	for key, timestamp in pairs(processed) do
		if type(key) == "string" then table.insert(entries, { Key = key, At = tonumber(timestamp) or 0 }) end
	end
	table.sort(entries, function(a, b) return a.At > b.At end)
	for index, entry in ipairs(entries) do if index <= 100 then compact[entry.Key] = entry.At end end
	if (tonumber(s.ExpiresAt) or 0) <= now() then
		local inactive = inactiveState(); inactive.Revision = math.max(0, math.floor(tonumber(s.Revision) or 0)); inactive.ProcessedReceipts = compact; return inactive
	end

	return {
		Active = true,
		Multiplier = Config.ActiveMultiplier,
		ActivatedAt = tonumber(s.ActivatedAt) or now(),
		ExpiresAt = tonumber(s.ExpiresAt) or now(),
		PurchaserUserId = tonumber(s.PurchaserUserId) or 0,
		PurchaserUsername = tostring(s.PurchaserUsername or ""),
		ReceiptKey = tostring(s.ReceiptKey or ""),
		Revision = math.max(0, math.floor(tonumber(s.Revision) or 0)),
		ProcessedReceipts = compact,
		BoostPurchaseNotification = type(s.BoostPurchaseNotification) == "table" and s.BoostPurchaseNotification or nil,
	}
end

local function buildPurchaseNotification(s)
	if not s.Active then return nil end
	return {
		Id = "GlobalMoneyFrenzy_" .. tostring(s.ReceiptKey),
		Username = s.PurchaserUsername,
		BoostName = "Global " .. Config.FormatMultiplier(Config.ActiveMultiplier) .. " Money Frenzy",
	}
end

local function publicState(notification)
	local s = sanitize(currentState)
	return {
		Active = s.Active,
		Multiplier = s.Multiplier,
		CurrentLuck = Config.FormatMultiplier(s.Multiplier),
		NextLuck = Config.FormatMultiplier(Config.ActiveMultiplier),
		ActivatedAt = s.ActivatedAt,
		ExpiresAt = s.ExpiresAt,
		PurchaserUserId = s.PurchaserUserId,
		PurchaserUsername = s.PurchaserUsername,
		Revision = s.Revision,
		ServerTime = now(),
		BoostPurchaseNotification = notification or s.BoostPurchaseNotification,
	}
end

local function publishStateWithRetries(payload)
	task.spawn(function()
		for attempt, delaySeconds in ipairs(PUBLISH_RETRY_DELAYS) do
			if delaySeconds > 0 then
				task.wait(delaySeconds)
			end

			local ok, err = pcall(function()
				MessagingService:PublishAsync(Config.TopicName, payload)
			end)

			if ok then
				return
			end

			warn(string.format("[%s] Failed to publish global boost state (attempt %d/%d): %s", script.Name, attempt, #PUBLISH_RETRY_DELAYS, tostring(err)))
		end
	end)
end

local function setLocalState(newState, shouldPublish, notification)
	local oldActive = currentState and currentState.Active
	local oldExpires = currentState and currentState.ExpiresAt
	local incoming = sanitize(newState)
	if currentState and incoming.Revision < (currentState.Revision or 0) then return end
	currentState = incoming

	if oldActive ~= currentState.Active or oldExpires ~= currentState.ExpiresAt then
		generation += 1
	end

	StateEvent:FireAllClients(publicState(notification))

	expireToken += 1
	local token = expireToken
	if currentState.Active then
		task.delay(math.max(1, currentState.ExpiresAt - now()), function()
			if token == expireToken then
				Service.RefreshFromStore(true)
			end
		end)
	end

	if shouldPublish then
		publishStateWithRetries(publicState(notification))
	end
end

function Service.RefreshFromStore(shouldPublish)
	local ok, data = pcall(function()
		return stateStore:GetAsync(Config.StateKey)
	end)
	if ok then
		setLocalState(data, shouldPublish)
	end
	return ok
end

function Service.GetState()
	if not currentState then
		Service.RefreshFromStore(false)
	end
	return publicState()
end

function Service.GetMultiplier()
	local state = Service.GetState()
	return state.Active and Config.ActiveMultiplier or Config.BaseMultiplier
end

function Service.GetGeneration()
	Service.GetState()
	return generation
end

function Service.CanPurchase()
	return not Service.GetState().Active
end

function Service.NotifyClient(player, success, message)
	if player then
		PurchaseResultEvent:FireClient(player, success == true, message or "")
	end
end

function Service.ProcessReceipt(receiptInfo)
	local receiptKey = tostring(receiptInfo.PlayerId) .. "_" .. tostring(receiptInfo.PurchaseId)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return false, "Player unavailable", false
	end

	local activated = false
	local already = false
	local activatedState = nil
	local ok = pcall(function()
		stateStore:UpdateAsync(Config.StateKey, function(old)
			-- UpdateAsync may invoke this transform more than once. Recompute all
			-- result flags from the state used by the final invocation.
			activated = false
			already = false
			activatedState = nil
			local s = sanitize(old)
			if s.ProcessedReceipts[receiptKey] then
				already = true; activatedState = s; return s
			end

			activated = true
			local wasActive = s.Active
			s.Active = true; s.Multiplier = Config.ActiveMultiplier
			s.ActivatedAt = wasActive and s.ActivatedAt or now()
			s.ExpiresAt = math.max(now(), tonumber(s.ExpiresAt) or 0) + Config.DurationSeconds
			s.PurchaserUserId = player.UserId; s.PurchaserUsername = player.Name; s.ReceiptKey = receiptKey
			s.Revision = (s.Revision or 0) + 1
			s.ProcessedReceipts[receiptKey] = now()
			activatedState = s
			activatedState.BoostPurchaseNotification = buildPurchaseNotification(activatedState)
			return activatedState
		end)
	end)
	if not ok then
		return false, "Money Frenzy save failed", false
	end

	setLocalState(activatedState, activated, activated and activatedState.BoostPurchaseNotification or nil)
	if already then return true, "Already granted", true end
	return true, "Money Frenzy activated or extended", false
end

GetStateFunction.OnServerInvoke = function()
	return Service.GetState()
end

Players.PlayerAdded:Connect(function(player)
	StateEvent:FireClient(player, Service.GetState())
end)

task.spawn(function()
	local attempt = 0
	while true do
		attempt += 1
		local delaySeconds = SUBSCRIBE_RETRY_DELAYS[math.min(attempt, #SUBSCRIBE_RETRY_DELAYS)]
		if delaySeconds > 0 then
			task.wait(delaySeconds)
		end

		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(Config.TopicName, function(message)
				if type(message.Data) == "table" then
					setLocalState(message.Data, false, message.Data.BoostPurchaseNotification)
				end
			end)
		end)

		if ok then
			return
		end

		warn(string.format("[%s] Failed to subscribe for global boost state (attempt %d; polling remains active): %s", script.Name, attempt, tostring(err)))
	end
end)

Service.RefreshFromStore(false)
task.spawn(function()
	while true do task.wait(30); Service.RefreshFromStore(false) end
end)
return Service
