-- Server ModuleScript: ServerScriptService > GlobalMoneyFrenzyService
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GlobalMoneyFrenzyConfig"))

local REQUIRED_WAIT_SECONDS = 15

local function requireChild(parent, childName, className, fullPath)
	local child = parent:WaitForChild(childName, REQUIRED_WAIT_SECONDS)
	if not child then
		error("[GlobalMoneyFrenzyService] Missing required instance: " .. fullPath .. " (" .. className .. ")", 0)
	end
	if className and not child:IsA(className) then
		error("[GlobalMoneyFrenzyService] " .. fullPath .. " must be a " .. className .. ", got " .. child.ClassName, 0)
	end
	return child
end

local remotes = requireChild(ReplicatedStorage, "GlobalMoneyFrenzyRemotes", "Folder", "ReplicatedStorage > GlobalMoneyFrenzyRemotes")
local StateEvent = requireChild(remotes, "State", "RemoteEvent", "ReplicatedStorage > GlobalMoneyFrenzyRemotes > State")
local GetStateFunction = requireChild(remotes, "GetState", "RemoteFunction", "ReplicatedStorage > GlobalMoneyFrenzyRemotes > GetState")
local PurchaseResultEvent = requireChild(remotes, "PurchaseResult", "RemoteEvent", "ReplicatedStorage > GlobalMoneyFrenzyRemotes > PurchaseResult")

local stateStore = DataStoreService:GetDataStore(Config.StateStoreName)
local receiptStore = DataStoreService:GetDataStore(Config.ReceiptStoreName)

local Service = {}
local currentState = nil
local generation = 0
local expireToken = 0

local function now()
	return os.time()
end

local function inactiveState()
	return {
		Active = false,
		Multiplier = Config.BaseMultiplier,
		ActivatedAt = 0,
		ExpiresAt = 0,
		PurchaserUserId = 0,
		PurchaserUsername = "",
		ReceiptKey = "",
	}
end

local function sanitize(raw)
	local s = type(raw) == "table" and raw or inactiveState()
	if (tonumber(s.ExpiresAt) or 0) <= now() then
		return inactiveState()
	end

	return {
		Active = true,
		Multiplier = Config.ActiveMultiplier,
		ActivatedAt = tonumber(s.ActivatedAt) or now(),
		ExpiresAt = tonumber(s.ExpiresAt) or now(),
		PurchaserUserId = tonumber(s.PurchaserUserId) or 0,
		PurchaserUsername = tostring(s.PurchaserUsername or ""),
		ReceiptKey = tostring(s.ReceiptKey or ""),
	}
end

local function buildPurchaseNotification(s)
	if not s.Active then return nil end
	return {
		Id = "GlobalMoneyFrenzy_" .. tostring(s.PurchaserUserId) .. "_" .. tostring(s.ActivatedAt),
		Username = s.PurchaserUsername,
		BoostName = "Global " .. Config.FormatMultiplier(Config.ActiveMultiplier) .. " Money Frenzy",
	}
end

local function publicState(notification)
	local s = sanitize(currentState)
	return {
		Active = s.Active,
		Multiplier = s.Multiplier,
		CurrentLuck = Config.FormatMultiplier(s.Multiplier),
		NextLuck = Config.FormatMultiplier(Config.ActiveMultiplier),
		ActivatedAt = s.ActivatedAt,
		ExpiresAt = s.ExpiresAt,
		PurchaserUserId = s.PurchaserUserId,
		PurchaserUsername = s.PurchaserUsername,
		ServerTime = now(),
		BoostPurchaseNotification = notification,
	}
end

local function setLocalState(newState, shouldPublish, notification)
	local oldActive = currentState and currentState.Active
	local oldExpires = currentState and currentState.ExpiresAt
	currentState = sanitize(newState)

	if oldActive ~= currentState.Active or oldExpires ~= currentState.ExpiresAt then
		generation += 1
	end

	StateEvent:FireAllClients(publicState(notification))

	expireToken += 1
	local token = expireToken
	if currentState.Active then
		task.delay(math.max(1, currentState.ExpiresAt - now()), function()
			if token == expireToken then
				Service.RefreshFromStore(true)
			end
		end)
	end

	if shouldPublish then
		pcall(function()
			MessagingService:PublishAsync(Config.TopicName, publicState(notification))
		end)
	end
end

function Service.RefreshFromStore(shouldPublish)
	local ok, data = pcall(function()
		return stateStore:GetAsync(Config.StateKey)
	end)
	if ok then
		setLocalState(data, shouldPublish)
	end
	return ok
end

function Service.GetState()
	if not currentState then
		Service.RefreshFromStore(false)
	end
	return publicState()
end

function Service.GetMultiplier()
	local state = Service.GetState()
	return state.Active and Config.ActiveMultiplier or Config.BaseMultiplier
end

function Service.GetGeneration()
	Service.GetState()
	return generation
end

function Service.CanPurchase()
	return not Service.GetState().Active
end

function Service.NotifyClient(player, success, message)
	if player then
		PurchaseResultEvent:FireClient(player, success == true, message or "")
	end
end

function Service.ProcessReceipt(receiptInfo)
	local receiptKey = tostring(receiptInfo.PlayerId) .. "_" .. tostring(receiptInfo.PurchaseId)
	local receiptOk, wasProcessed = pcall(function()
		return receiptStore:GetAsync(receiptKey)
	end)
	if not receiptOk then
		return false, "Money Frenzy receipt check failed", false
	end
	if wasProcessed then
		return true, "Already granted", true
	end

	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return false, "Player unavailable", false
	end

	local activated = false
	local activatedState = nil
	local ok = pcall(function()
		stateStore:UpdateAsync(Config.StateKey, function(old)
			local s = sanitize(old)
			if s.Active then
				activated = (s.ReceiptKey == receiptKey)
				activatedState = s
				return s
			end

			activated = true
			activatedState = {
				Active = true,
				Multiplier = Config.ActiveMultiplier,
				ActivatedAt = now(),
				ExpiresAt = now() + Config.DurationSeconds,
				PurchaserUserId = player.UserId,
				PurchaserUsername = player.Name,
				ReceiptKey = receiptKey,
			}
			return activatedState
		end)
	end)
	if not ok then
		return false, "Money Frenzy save failed", false
	end

	setLocalState(activatedState, true, activated and buildPurchaseNotification(activatedState) or nil)
	pcall(function()
		receiptStore:SetAsync(receiptKey, true)
	end)

	if not activated then
		return true, "Money Frenzy is already active", true
	end

	return true, "Money Frenzy activated", false
end

GetStateFunction.OnServerInvoke = function()
	return Service.GetState()
end

Players.PlayerAdded:Connect(function(player)
	StateEvent:FireClient(player, Service.GetState())
end)

pcall(function()
	MessagingService:SubscribeAsync(Config.TopicName, function(message)
		if type(message.Data) == "table" then
			setLocalState(message.Data, false, message.Data.BoostPurchaseNotification)
		end
	end)
end)

Service.RefreshFromStore(false)
return Service
