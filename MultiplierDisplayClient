-- Purpose: Client-side multiplier label updater for every tycoon display.
-- Runs on: LocalScript (StarterPlayerScripts)
-- Notes: Updates only Multiplier.Multiplier.MultiplierLabel.Text so existing label styling stays untouched.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local TYCOON_FOLDER_NAME = "Tycoons"
local OWNER_VALUE_NAME = "Owner"
local MULTIPLIER_PART_NAME = "Multiplier"
local MULTIPLIER_GUI_NAME = "Multiplier"
local MULTIPLIER_LABEL_NAME = "MultiplierLabel"
local EXPECTED_TYCOON_COUNT = 6

local RANK_MULTIPLIER_FALLBACKS = {
	Player = 1,
	VIP = 2,
	["VIP+"] = 3,
	MVP = 4,
	["MVP+"] = 5,
	["MVP++"] = 6,
}

local tycoonConnections = {}
local playerConnections = {}

local function disconnectTrackedConnections()
	for _, connection in ipairs(tycoonConnections) do
		connection:Disconnect()
	end
	table.clear(tycoonConnections)
end

local function formatMultiplier(multiplier)
	multiplier = tonumber(multiplier) or 1

	if math.abs(multiplier - math.floor(multiplier)) < 0.001 then
		return tostring(math.floor(multiplier)) .. "x"
	end

	return string.format("%.2fx", multiplier):gsub("0+x$", "x"):gsub("%.x$", "x")
end

local function getDisplayedMultiplierForPlayer(targetPlayer)
	if not targetPlayer then
		return 1
	end

	local actualMultiplier = tonumber(targetPlayer:GetAttribute("ActualEarningsMultiplier"))
	if actualMultiplier then
		return actualMultiplier
	end

	local rankMultiplier = tonumber(targetPlayer:GetAttribute("RankResourceMultiplier"))
	if rankMultiplier then
		return rankMultiplier
	end

	local rankName = targetPlayer:GetAttribute("Rank") or "Player"
	return RANK_MULTIPLIER_FALLBACKS[rankName] or 1
end

local function updateLabel(label, multiplierText)
	if label and label:IsA("TextLabel") then
		label.Text = multiplierText
	end
end

local function getMultiplierLabel(tycoon)
	local multiplierPart = tycoon:FindFirstChild(MULTIPLIER_PART_NAME)
	if not multiplierPart then return nil end

	local multiplierGui = multiplierPart:FindFirstChild(MULTIPLIER_GUI_NAME)
	if not multiplierGui then return nil end

	return multiplierGui:FindFirstChild(MULTIPLIER_LABEL_NAME)
end

local function getTycoonOwnerPlayer(tycoon)
	local ownerValue = tycoon:FindFirstChild(OWNER_VALUE_NAME)
	if not ownerValue then
		return nil
	end

	local ownerName = tostring(ownerValue.Value or "")
	if ownerName == "" then
		return nil
	end

	return Players:FindFirstChild(ownerName)
end

local function updateTycoonMultiplierDisplay(tycoon)
	local ownerPlayer = getTycoonOwnerPlayer(tycoon)
	local multiplierText = ownerPlayer and formatMultiplier(getDisplayedMultiplierForPlayer(ownerPlayer)) or "0x"
	updateLabel(getMultiplierLabel(tycoon), multiplierText)
end

local function updateAllTycoonMultiplierDisplays()
	local tycoons = Workspace:FindFirstChild(TYCOON_FOLDER_NAME)
	if not tycoons then return end

	for tycoonNumber = 1, EXPECTED_TYCOON_COUNT do
		local tycoon = tycoons:FindFirstChild("Tycoon" .. tycoonNumber)
		if tycoon then
			updateTycoonMultiplierDisplay(tycoon)
		end
	end
end

local function watchMultiplierLabels()
	disconnectTrackedConnections()

	local tycoons = Workspace:FindFirstChild(TYCOON_FOLDER_NAME)
	if not tycoons then return end

	for tycoonNumber = 1, EXPECTED_TYCOON_COUNT do
		local tycoon = tycoons:FindFirstChild("Tycoon" .. tycoonNumber)
		if tycoon then
			table.insert(tycoonConnections, tycoon.ChildAdded:Connect(function(child)
				if child.Name == MULTIPLIER_PART_NAME then
					task.defer(watchMultiplierLabels)
					task.defer(updateAllTycoonMultiplierDisplays)
				elseif child.Name == OWNER_VALUE_NAME then
					task.defer(watchMultiplierLabels)
					task.defer(updateAllTycoonMultiplierDisplays)
				end
			end))

			local ownerValue = tycoon:FindFirstChild(OWNER_VALUE_NAME)
			if ownerValue then
				table.insert(tycoonConnections, ownerValue:GetPropertyChangedSignal("Value"):Connect(updateAllTycoonMultiplierDisplays))
			end

			local multiplierPart = tycoon:FindFirstChild(MULTIPLIER_PART_NAME)
			if multiplierPart then
				table.insert(tycoonConnections, multiplierPart.ChildAdded:Connect(function(child)
					if child.Name == MULTIPLIER_GUI_NAME then
						task.defer(watchMultiplierLabels)
						task.defer(updateAllTycoonMultiplierDisplays)
					end
				end))

				local multiplierGui = multiplierPart:FindFirstChild(MULTIPLIER_GUI_NAME)
				if multiplierGui then
					table.insert(tycoonConnections, multiplierGui.ChildAdded:Connect(function(child)
						if child.Name == MULTIPLIER_LABEL_NAME then
							task.defer(updateAllTycoonMultiplierDisplays)
						end
					end))
				end
			end
		end
	end
end

local function trackPlayerMultiplierChanges(player)
	table.insert(playerConnections, player:GetAttributeChangedSignal("ActualEarningsMultiplier"):Connect(updateAllTycoonMultiplierDisplays))
	table.insert(playerConnections, player:GetAttributeChangedSignal("RankResourceMultiplier"):Connect(updateAllTycoonMultiplierDisplays))
	table.insert(playerConnections, player:GetAttributeChangedSignal("Rank"):Connect(updateAllTycoonMultiplierDisplays))
end

for _, player in ipairs(Players:GetPlayers()) do
	trackPlayerMultiplierChanges(player)
end

Players.PlayerAdded:Connect(function(player)
	trackPlayerMultiplierChanges(player)
	task.defer(updateAllTycoonMultiplierDisplays)
end)

Players.PlayerRemoving:Connect(function()
	task.defer(updateAllTycoonMultiplierDisplays)
end)

local tycoons = Workspace:FindFirstChild(TYCOON_FOLDER_NAME)
if tycoons then
	tycoons.ChildAdded:Connect(function(child)
		if child.Name:match("^Tycoon%d+$") then
			watchMultiplierLabels()
			task.defer(updateAllTycoonMultiplierDisplays)
		end
	end)
else
	Workspace.ChildAdded:Connect(function(child)
		if child.Name == TYCOON_FOLDER_NAME then
			watchMultiplierLabels()
			task.defer(updateAllTycoonMultiplierDisplays)
		end
	end)
end

watchMultiplierLabels()
updateAllTycoonMultiplierDisplays()
