-- ============================================================
-- LoadingScreen
-- Purpose  : Functional loading screen with swoop + blink exit.
-- Runs on  : Client (ReplicatedFirst)
-- Deps     : StarterGui.LoadingScreenGui, ReplicatedStorage.PreloadAssets
-- Security : Nil-safe, disconnects all events, destroys UI on finish.
-- ============================================================

local ReplicatedFirst      = game:GetService("ReplicatedFirst")
local RunService           = game:GetService("RunService")
local Workspace            = game:GetService("Workspace")
local Players              = game:GetService("Players")
local StarterGui           = game:GetService("StarterGui")
local TweenService         = game:GetService("TweenService")
local ContentProvider      = game:GetService("ContentProvider")
local ContextActionService = game:GetService("ContextActionService")
local Lighting             = game:GetService("Lighting")
local ReplicatedStorage    = game:GetService("ReplicatedStorage")
local SoundService         = game:GetService("SoundService")

ReplicatedFirst:RemoveDefaultLoadingScreen()

-- ============================================================
-- CONFIG
-- ============================================================

local VIEW_PART_NAME      = "LoadingViewPart"
local VIEW_PART_TIMEOUT   = 10
local PRELOAD_FOLDER_NAME = "PreloadAssets"
local LOADING_TEXT_START  = " Loading "
local LOADING_SOUND_ID     = "rbxassetid://72475519841402"
local LOADING_SOUND_FADE_IN = 1.8
local LOADING_SOUND_HOLD_SECONDS = 120
local THEME_FADE_IN_SECONDS = 2.0

local ANIMATION_DURATION     = 5.5
local BLUR_SIZE               = 20
local BLUR_IN_TIME            = 0.6
local BLUR_OUT_TIME           = 3.0
local SWOOP_DURATION          = 1.8
local FADE_OUT_TIME           = 0.4
local FADE_IN_TIME            = 0.8
local EXTRA_HOLD_SECONDS      = 2.0
local FAILSAFE_TOTAL_SECONDS  = 35

local LOCK_NAME    = "LoadingScreenCameraLock"
local FREEZE_ACTION = "LoadingScreenFreeze"

local PHASE_GAME_LOADED_TO   = 0.20
local PHASE_VIEWPART_READY_TO = 0.40
local PHASE_PRELOAD_TO        = 0.90
local PHASE_FINISH_TO         = 1.00

-- ============================================================
-- BASICS
-- ============================================================

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera    = Workspace.CurrentCamera or Workspace:WaitForChild("Camera")

playerGui:SetAttribute("LoadingScreenActive", true)

-- ============================================================
-- UI SETUP
-- ============================================================

local sourceGui = StarterGui:WaitForChild("LoadingScreenGui", 10)
if not sourceGui then
	warn("❌ LoadingScreenGui missing from StarterGui!")
	playerGui:SetAttribute("LoadingScreenActive", false)
	return
end

local loadingGui               = sourceGui:Clone()
loadingGui.Name                = "ActiveLoadingScreen"
loadingGui.ResetOnSpawn        = false
loadingGui.Enabled             = true
loadingGui.IgnoreGuiInset      = true
loadingGui.DisplayOrder        = 999
loadingGui.Parent              = playerGui

-- Full-screen black frame used for the blink transition
local transitionFrame                    = Instance.new("Frame")
transitionFrame.Name                     = "TransitionFrame"
transitionFrame.Size                     = UDim2.fromScale(1, 1)
transitionFrame.BackgroundColor3         = Color3.new(0, 0, 0)
transitionFrame.BackgroundTransparency   = 1   -- invisible until the blink
transitionFrame.ZIndex                   = 2000
transitionFrame.Parent                   = loadingGui

-- ============================================================
-- UTILITIES
-- ============================================================

local function safeTween(instance, info, goals)
	local t = TweenService:Create(instance, info, goals)
	t:Play()
	return t
end

local function waitForNamedChild(parent, childName, timeout)
	local deadline = os.clock() + timeout
	while os.clock() < deadline do
		local child = parent:FindFirstChild(childName)
		if child then return child end
		RunService.Heartbeat:Wait()
	end
	return nil
end

-- ============================================================
-- BLUR
-- ============================================================

local blur = Lighting:FindFirstChild("LoadingScreenBlur")
if not blur then
	blur          = Instance.new("BlurEffect")
	blur.Name     = "LoadingScreenBlur"
	blur.Size     = 0
	blur.Parent   = Lighting
end

local function blurTo(size, duration)
	return safeTween(blur, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Size = size })
end

-- ============================================================
-- INPUT LOCKS
-- ============================================================

local function lockControls()
	ContextActionService:BindAction(
		FREEZE_ACTION,
		function() return Enum.ContextActionResult.Sink end,
		false,
		unpack(Enum.PlayerActions:GetEnumItems())
	)
end

local function unlockControls()
	pcall(function() ContextActionService:UnbindAction(FREEZE_ACTION) end)
end

local movementLock = { active = false, conn = nil, original = {} }

local function enableMovementLock()
	player:SetAttribute("MovementLock", true)
end

local function disableMovementLock()
	player:SetAttribute("MovementLock", false)
end

-- ============================================================
-- CAMERA
-- ============================================================

local function lockCameraTo(part)
	camera.CameraType = Enum.CameraType.Scriptable
	
	if not (part and part:IsA("BasePart")) then return end
	
	camera.CFrame     = part.CFrame
	RunService:BindToRenderStep(LOCK_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		if part and part.Parent then camera.CFrame = part.CFrame end
		if camera.CameraType ~= Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Scriptable
		end
	end)
end

local function unlockCameraToPlayer()
	pcall(function() RunService:UnbindFromRenderStep(LOCK_NAME) end)

	local char = player.Character or player.CharacterAdded:Wait()
	local hum  = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
	local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 10)

	if root and hum then
		camera.CameraType = Enum.CameraType.Scriptable

		-- Swoop: glide camera to behind the player
		local offset      = CFrame.new(0, 5, 12)
		local targetCF    = root.CFrame:ToWorldSpace(offset)
		targetCF          = CFrame.lookAt(targetCF.Position, root.Position + Vector3.new(0, 2, 0))

		local swoopInfo = TweenInfo.new(SWOOP_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		local tween     = TweenService:Create(camera, swoopInfo, { CFrame = targetCF })
		tween:Play()
		tween.Completed:Wait()

		-- Blink out (fade to black)
		local fadeOut = TweenService:Create(
			transitionFrame,
			TweenInfo.new(FADE_OUT_TIME, Enum.EasingStyle.Sine),
			{ BackgroundTransparency = 0 }
		)
		fadeOut:Play()
		fadeOut.Completed:Wait()

		-- Switch camera mode safely under darkness
		camera.CameraSubject = hum
		camera.CameraType    = Enum.CameraType.Custom

		-- Blink in (fade back to clear)
		local fadeIn = TweenService:Create(
			transitionFrame,
			TweenInfo.new(FADE_IN_TIME, Enum.EasingStyle.Sine),
			{ BackgroundTransparency = 1 }
		)
		fadeIn:Play()
	else
		-- Fallback: no character found, just release the camera
		camera.CameraType = Enum.CameraType.Custom
	end
end

-- ============================================================
-- UI — CLICK SHIELD & PROGRESS BAR
-- ============================================================

local clickShield                    = Instance.new("Frame")
clickShield.Name                     = "ClickShield"
clickShield.Size                     = UDim2.new(1, 0, 1, 0)
clickShield.BackgroundTransparency   = 1
clickShield.Active                   = true
clickShield.ZIndex                   = -1
clickShield.Parent                   = loadingGui

local bgFrame = loadingGui:WaitForChild("Frame", 5)
if not bgFrame then
	loadingGui:Destroy()
	playerGui:SetAttribute("LoadingScreenActive", false)
	return
end
bgFrame.Visible = false

local barContainer = bgFrame:FindFirstChild("ProgressBarContainer")
local barFill      = barContainer and barContainer:FindFirstChild("ProgressBar")
local progressText = barContainer and barContainer:FindFirstChild("ProgressText")
local progressValue = Instance.new("NumberValue")
progressValue.Value = 0

local MAX_X_SCALE, MAX_X_OFFSET, Y_SCALE, Y_OFFSET

local function updateProgressBar(v)
	if not barFill then return end
	local clamped = math.clamp(v, 0, 1)
	barFill.Size  = UDim2.new(
		MAX_X_SCALE * clamped, MAX_X_OFFSET * clamped,
		Y_SCALE, Y_OFFSET
	)

	if progressText and progressText:IsA("TextLabel") then
		if clamped <= 0.05 then
			progressText.RichText   = false
			progressText.Text       = LOADING_TEXT_START
			progressText.TextColor3 = Color3.new(1, 1, 1)

		else
			progressText.RichText   = false
			progressText.TextColor3 = Color3.new(1, 1, 1)
			local num      = math.floor(clamped * 100 + 0.5)
			progressText.Text = string.format("%d%%", num)
		end
	end
end

if barFill then
	MAX_X_SCALE = barFill.Size.X.Scale
	MAX_X_OFFSET = barFill.Size.X.Offset
	Y_SCALE      = barFill.Size.Y.Scale
	Y_OFFSET     = barFill.Size.Y.Offset

	barFill.Size = UDim2.new(0, 0, Y_SCALE, Y_OFFSET)
	updateProgressBar(0)
	progressValue.Changed:Connect(updateProgressBar)
end

local function tweenProgress(toValue, duration)
	local goal = math.clamp(toValue, 0, 1)
	return safeTween(
		progressValue,
		TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Value = goal }
	)
end

-- ============================================================
-- VISIBILITY MANAGER
--
--   KEY FIX: Any GuiObject tagged with the attribute
--   "ExternallyManaged" = true is completely skipped.
--   This prevents the loading screen from stomping on
--   GuiObjects whose visibility is controlled by other scripts
--   (e.g. the restock notification frame).
-- ============================================================

local hiddenFrames: { [GuiObject]: true } = {}
local scanThread: thread? = nil

local function isExternallyManaged(obj: Instance): boolean
	-- Walk up the hierarchy; if any ancestor is managed, respect it.
	local cur: Instance? = obj
	while cur do
		if cur:GetAttribute("ExternallyManaged") == true then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local function scanAndHide(parent: Instance)
	if not parent then return end
	for _, child in ipairs(parent:GetChildren()) do
		if child == loadingGui then continue end

		if child:IsA("GuiObject") then
			-- Skip any frame managed by an external script
			if isExternallyManaged(child) then continue end

			if child.Visible then
				hiddenFrames[child] = true
				child.Visible       = false
				continue -- Don't recurse into a hidden frame's children
			end
		end

		if child:IsA("Folder") or child:IsA("ScreenGui") or child:IsA("GuiObject") then
			scanAndHide(child)
		end
	end
end

local function startHidingVisuals()
	scanAndHide(playerGui)
	scanThread = task.spawn(function()
		while playerGui:GetAttribute("LoadingScreenActive") do
			scanAndHide(playerGui)
			task.wait(0.2)
		end
	end)
end

local function restoreVisuals()
	if scanThread then
		task.cancel(scanThread)
		scanThread = nil
	end
	for item in pairs(hiddenFrames) do
		-- Only restore if the item is NOT externally managed.
		-- (Belt-and-suspenders: the item shouldn't be in hiddenFrames
		--  at all if we scanned correctly, but guard anyway.)
		if item and item.Parent and not isExternallyManaged(item) then
			item.Visible = true
		end
	end
	table.clear(hiddenFrames)
end

-- ============================================================
-- LOADING SCREEN TRANSPARENCY FADE
-- ============================================================

local studioProps: { [Instance]: { [string]: number } } = {}

local function recordProps(inst: Instance)
	local props: { [string]: number } = {}
	local changed = false

	if inst:IsA("GuiObject") and inst.BackgroundTransparency < 1 then
		props.BackgroundTransparency = inst.BackgroundTransparency
		changed = true
	end
	if (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox"))
		and inst.TextTransparency < 1 then
		props.TextTransparency = inst.TextTransparency
		changed = true
	end
	if (inst:IsA("ImageLabel") or inst:IsA("ImageButton"))
		and inst.ImageTransparency < 1 then
		props.ImageTransparency = inst.ImageTransparency
		changed = true
	end
	if inst:IsA("UIStroke") and inst.Transparency < 1 then
		props.Transparency = inst.Transparency
		changed = true
	end
	if changed then studioProps[inst] = props end
end

local function setInvisible(inst: Instance)
	local props = studioProps[inst]
	if not props then return end
	if inst:IsA("GuiObject") and props.BackgroundTransparency ~= nil then
		inst.BackgroundTransparency = 1
	end
	if (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox"))
		and props.TextTransparency ~= nil then
		inst.TextTransparency = 1
	end
	if (inst:IsA("ImageLabel") or inst:IsA("ImageButton"))
		and props.ImageTransparency ~= nil then
		inst.ImageTransparency = 1
	end
	if inst:IsA("UIStroke") and props.Transparency ~= nil then
		inst.Transparency = 1
	end
end

local function fadeToRecorded(duration: number)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	for inst, goals in pairs(studioProps) do
		if inst and inst.Parent then safeTween(inst, info, goals) end
	end
end

local function fadeToInvisible(duration: number)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
	for inst, props in pairs(studioProps) do
		if inst and inst.Parent then
			local goals: { [string]: number } = {}
			if inst:IsA("GuiObject") and props.BackgroundTransparency ~= nil then
				goals.BackgroundTransparency = 1
			end
			if (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox"))
				and props.TextTransparency ~= nil then
				goals.TextTransparency = 1
			end
			if (inst:IsA("ImageLabel") or inst:IsA("ImageButton"))
				and props.ImageTransparency ~= nil then
				goals.ImageTransparency = 1
			end
			if inst:IsA("UIStroke") and props.Transparency ~= nil then
				goals.Transparency = 1
			end
			if next(goals) then safeTween(inst, info, goals) end
		end
	end
end

local function getOrCreateMainTheme()
	local existing = SoundService:FindFirstChild("MainTheme")
	if existing and existing:IsA("Sound") then
		return existing
	end

	local fromWorkspace = Workspace:FindFirstChild("MainTheme")
	if fromWorkspace and fromWorkspace:IsA("Sound") then
		fromWorkspace.Parent = SoundService
		return fromWorkspace
	end

	return nil
end

-- Record initial transparency values, then make everything invisible
for _, inst in ipairs(loadingGui:GetDescendants()) do recordProps(inst) end
for inst in pairs(studioProps) do setInvisible(inst) end

-- ============================================================
-- MAIN EXECUTION
-- ============================================================

local finished = false
local loadingMusic: Sound? = nil
local transitionedToMainTheme = false

local function cleanup()
	if finished then return end
	finished = true

	-- 1. Swoop camera back to the player + blink transition (yields)
	unlockCameraToPlayer()

	-- 2. Release input locks
	unlockControls()
	disableMovementLock()

	-- 3. Signal other scripts that the loading screen is done
	pcall(function() playerGui:SetAttribute("LoadingScreenActive", false) end)

	-- 4. Restore any hidden GUIs (safe — externally-managed frames are skipped)
	restoreVisuals()

	-- 5. Remove blur
	pcall(function()
		if blur and blur.Parent then
			blur.Size = 0
			blur:Destroy()
		end
	end)

	-- 6. Destroy loading screen UI and temporary values
	pcall(function() loadingGui:Destroy() end)
	pcall(function() progressValue:Destroy() end)
end

local function transitionToMainTheme()
	if transitionedToMainTheme then return end
	transitionedToMainTheme = true

	local theme = getOrCreateMainTheme()
	if theme then
		if not theme.IsPlaying then
			theme.Volume = 0
			theme:Play()
		end
		safeTween(theme, TweenInfo.new(THEME_FADE_IN_SECONDS, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Volume = 1 })
	end
end

-- Failsafe: force cleanup after a maximum total time
task.spawn(function()
	local deadline = os.clock() + FAILSAFE_TOTAL_SECONDS
	while not finished and os.clock() < deadline do
		task.wait(1)
	end
	if not finished then
		warn("[LoadingScreen] Failsafe triggered — forcing cleanup.")
		cleanup()
	end
end)

-- Main sequence
task.spawn(function()
	local ok, err = xpcall(function()

		lockControls()
		enableMovementLock()
		startHidingVisuals()
		blurTo(BLUR_SIZE, BLUR_IN_TIME)
		
		loadingMusic = Instance.new("Sound")
		loadingMusic.Name = "LoadingMusic"
		loadingMusic.SoundId = LOADING_SOUND_ID
		loadingMusic.Looped = true
		loadingMusic.Volume = 0
		loadingMusic.Parent = SoundService
		loadingMusic:Play()
		safeTween(loadingMusic, TweenInfo.new(LOADING_SOUND_FADE_IN, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Volume = 1 })

		-- Slide the loading frame in from below
		bgFrame.Visible    = true
		local finalPos     = bgFrame.Position
		local startPos     = UDim2.new(
			finalPos.X.Scale, finalPos.X.Offset,
			finalPos.Y.Scale + 1.5, finalPos.Y.Offset
		)
		bgFrame.Position   = startPos

		safeTween(
			bgFrame,
			TweenInfo.new(ANIMATION_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{ Position = finalPos }
		)
		fadeToRecorded(ANIMATION_DURATION)

		-- ── PHASE 1: Find & lock the loading view part IMMEDIATELY ──────
		-- This ensures the camera is stable while we wait for the rest of the game
		local viewPart = waitForNamedChild(Workspace, VIEW_PART_NAME, 3) -- quick initial check
		if not viewPart then
			lockCameraTo(nil) -- at least lock the camera type to Scriptable
			task.spawn(function()
				viewPart = waitForNamedChild(Workspace, VIEW_PART_NAME, VIEW_PART_TIMEOUT)
				if viewPart then lockCameraTo(viewPart) end
			end)
		else
			lockCameraTo(viewPart)
		end
		
		task.wait(ANIMATION_DURATION * 0.3) -- let UI settle before incrementing progress

		-- ── PHASE 2: Wait for game to finish loading ─────────────────
		local t1 = tweenProgress(PHASE_GAME_LOADED_TO, 1.5)
		if not game:IsLoaded() then
			game.Loaded:Wait()
		else
			t1.Completed:Wait()
		end
		
		tweenProgress(PHASE_VIEWPART_READY_TO, 1.2).Completed:Wait()

		-- ── PHASE 3: Preload assets ───────────────────────────────────
		local folder      = ReplicatedStorage:FindFirstChild(PRELOAD_FOLDER_NAME)
		local preloadList = { loadingGui } -- ensure list is never empty
		if folder then
			for _, inst in ipairs(folder:GetDescendants()) do
				table.insert(preloadList, inst)
			end
		end
		if viewPart then table.insert(preloadList, viewPart) end

		local startVal = progressValue.Value
		local dist     = PHASE_PRELOAD_TO - startVal

		for i, asset in ipairs(preloadList) do
			pcall(function() ContentProvider:PreloadAsync({ asset }) end)

			local alpha  = i / #preloadList
			local target = startVal + (dist * alpha)
			tweenProgress(target, 0.1)

			-- Small forced wait so the bar moves visibly on short lists
			if #preloadList < 20 then
				task.wait(0.05)
			else
				RunService.Heartbeat:Wait()
			end
		end

		-- ── PHASE 4: Finish ───────────────────────────────────────────
		tweenProgress(PHASE_FINISH_TO, 1.0).Completed:Wait()
		
		local afterLoading = bgFrame:FindFirstChild("AfterLoading")
		local clickButton = afterLoading and afterLoading:FindFirstChild("ClickButton")
		local infoLabel = afterLoading and afterLoading:FindFirstChild("Information")
		local infoStroke = infoLabel and infoLabel:FindFirstChildOfClass("UIStroke")
		local infoInitialPos = infoLabel and infoLabel.Position
		local clickedToStart = false

		if clickButton and clickButton:IsA("GuiButton") then
			clickButton.Visible = true
			clickButton.Active = true
			clickButton.AutoButtonColor = false
		end
		if infoLabel and infoLabel:IsA("TextLabel") then
			infoLabel.Visible = true
			infoLabel.TextTransparency = 1
			if infoStroke then infoStroke.Transparency = 1 end
			safeTween(infoLabel, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { TextTransparency = 0 })
			if infoStroke then
				safeTween(infoStroke, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Transparency = 0 })
			end
		end

		local clickedEvent = Instance.new("BindableEvent")
		local clickConn
		if clickButton and clickButton:IsA("GuiButton") then
			clickConn = clickButton.Activated:Connect(function()
				if clickedToStart then return end
				clickedToStart = true
				clickedEvent:Fire()
			end)
		end

		if clickButton and clickButton:IsA("GuiButton") then
			clickedEvent.Event:Wait()
		else
			task.wait(0.25)
			task.wait(EXTRA_HOLD_SECONDS)
		end

		if clickConn then clickConn:Disconnect() end
		clickedEvent:Destroy()

		if infoLabel and infoLabel:IsA("TextLabel") then
			if infoInitialPos then
				local upPos = UDim2.new(infoInitialPos.X.Scale, infoInitialPos.X.Offset, infoInitialPos.Y.Scale - 0.1, infoInitialPos.Y.Offset)
				local downPos = UDim2.new(infoInitialPos.X.Scale, infoInitialPos.X.Offset, infoInitialPos.Y.Scale + 1, infoInitialPos.Y.Offset)
				safeTween(infoLabel, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Position = upPos }).Completed:Wait()
				safeTween(infoLabel, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Position = downPos, TextTransparency = 1 }).Completed:Wait()
			else
				safeTween(infoLabel, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { TextTransparency = 1 }).Completed:Wait()
			end
		end
		if infoStroke then
			safeTween(infoStroke, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { Transparency = 1 })
		end
		if clickButton and clickButton:IsA("GuiButton") then
			clickButton.Active = false
			clickButton.Visible = false
		end

		-- Slide loading frame out upwards
		local exitPos = UDim2.new(
			finalPos.X.Scale, finalPos.X.Offset,
			finalPos.Y.Scale - 1.5, finalPos.Y.Offset
		)
		safeTween(
			bgFrame,
			TweenInfo.new(ANIMATION_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
			{ Position = exitPos }
		)
		fadeToInvisible(ANIMATION_DURATION)

		-- Start fading the blur before the swoop begins
		blurTo(0, BLUR_OUT_TIME)

		-- Wait for the UI exit animation to finish, then hand off to cleanup
		task.wait(ANIMATION_DURATION)
		cleanup()
		
		task.delay(LOADING_SOUND_HOLD_SECONDS, function()
			if loadingMusic and loadingMusic.Parent then
				safeTween(loadingMusic, TweenInfo.new(THEME_FADE_IN_SECONDS, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Volume = 0 })
				task.wait(THEME_FADE_IN_SECONDS)
				if loadingMusic and loadingMusic.Parent then
					loadingMusic:Stop()
					loadingMusic:Destroy()
				end
			end
			transitionToMainTheme()
		end)

	end, debug.traceback)

	if not ok then
		warn("[LoadingScreen] Error in main sequence:\n", err)
		cleanup()
	end
end)
