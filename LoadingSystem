local function removeUnwantedCompletionLabels()
	if not loadingGui then
		return
	end

	for _, inst in ipairs(loadingGui:GetDescendants()) do
		if inst:IsA("TextLabel") or inst:IsA("TextButton") then
			local text = string.lower(string.gsub(inst.Text or "", "%s+", ""))

			if text == "flickr" or text == "done" or text == "finished" then
				inst.Text = ""
				inst.Visible = false
			end
		end
	end
end

local function disableProgressTextColorEffects()
	if not progressText then
		return
	end

	for _, inst in ipairs(progressText:GetDescendants()) do
		if inst:IsA("UIGradient") then
			pcall(function()
				inst.Enabled = false
			end)
		end
	end

	if progressText:IsA("TextLabel") then
		progressText.RichText = false
		progressText.TextColor3 = Color3.new(1, 1, 1)
	end
end

local function getStartPromptText()
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "Tap to start"
	end

	if UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		return "Press A to start"
	end

	return "Click to start"
end

-- ============================================================
-- PROGRESS BAR
-- ============================================================

local function updateProgressBar(value)
	local clamped = math.clamp(value, 0, 1)

	if barFill then
		barFill.Size = UDim2.new(
			maxXScale * clamped,
			maxXOffset * clamped,
			yScale,
			yOffset
		)
	end

	if progressText and progressText:IsA("TextLabel") then
		disableProgressTextColorEffects()

		if clamped <= 0.05 then
			progressText.Text = LOADING_TEXT_START
		else
			local number = math.floor(clamped * 100 + 0.5)
			progressText.Text = string.format("%d%%", number)
		end
	end
end

local function tweenProgress(toValue, duration)
	if not isAlive() or not progressValue then
		return nil
	end

	if activeProgressTween then
		pcall(function()
			activeProgressTween:Cancel()
		end)

		activeProgressTween = nil
	end

	local current = progressValue.Value
	local goal = math.max(current, math.clamp(toValue, 0, 1))

	activeProgressTween = safeTween(
		progressValue,
		TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Value = goal }
	)

	return activeProgressTween
end

local function tweenProgressAndWait(toValue, duration)
	local tween = tweenProgress(toValue, duration)

	if not tween then
		return false
	end

	return waitForTween(tween, duration + 1, true)
end

