-- ============================================================

local function recordProps(instance)
	local props = {}
	local changed = false

	if instance:IsA("GuiObject") and instance.BackgroundTransparency < 1 then
		props.BackgroundTransparency = instance.BackgroundTransparency
		changed = true
	end

	if (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
		and instance.TextTransparency < 1 then
		props.TextTransparency = instance.TextTransparency
		changed = true
	end

	if (instance:IsA("ImageLabel") or instance:IsA("ImageButton"))
		and instance.ImageTransparency < 1 then
		props.ImageTransparency = instance.ImageTransparency
		changed = true
	end

	if instance:IsA("UIStroke") and instance.Transparency < 1 then
		props.Transparency = instance.Transparency
		changed = true
	end

	if changed then
		recordedTransparency[instance] = props
	end
end

local function setInvisible(instance)
	local props = recordedTransparency[instance]

	if not props then
		return
	end

	if instance:IsA("GuiObject") and props.BackgroundTransparency ~= nil then
		instance.BackgroundTransparency = 1
	end

	if (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
		and props.TextTransparency ~= nil then
		instance.TextTransparency = 1
	end

	if (instance:IsA("ImageLabel") or instance:IsA("ImageButton"))
		and props.ImageTransparency ~= nil then
		instance.ImageTransparency = 1
	end

	if instance:IsA("UIStroke") and props.Transparency ~= nil then
		instance.Transparency = 1
	end
end

local function fadeToRecorded(duration)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	for instance, goals in pairs(recordedTransparency) do
		if instance and instance.Parent then
			safeTween(instance, info, goals)
		end
	end
end

local function fadeToInvisible(duration)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.In)

	for instance, props in pairs(recordedTransparency) do
		if instance and instance.Parent then
			local goals = {}

			if instance:IsA("GuiObject") and props.BackgroundTransparency ~= nil then
				goals.BackgroundTransparency = 1
			end

			if (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
				and props.TextTransparency ~= nil then
				goals.TextTransparency = 1
			end

			if (instance:IsA("ImageLabel") or instance:IsA("ImageButton"))
				and props.ImageTransparency ~= nil then
				goals.ImageTransparency = 1
			end

			if instance:IsA("UIStroke") and props.Transparency ~= nil then
				goals.Transparency = 1
			end

			if next(goals) then
				safeTween(instance, info, goals)
			end
		end
	end
end

-- ============================================================
-- AUDIO
-- ============================================================

local function stopSoundIfExists(sound)
	if sound and sound:IsA("Sound") then
		pcall(function()
			sound:Stop()
		end)

		sound.Volume = 0
	end
end

local function stopAllNonLoadingMusic()
	local gameTheme = SoundService:FindFirstChild(GAME_THEME_NAME)
	local legacyTheme = SoundService:FindFirstChild(LEGACY_MAIN_THEME_NAME)
	local workspaceLegacy = Workspace:FindFirstChild(LEGACY_MAIN_THEME_NAME)

	stopSoundIfExists(gameTheme)
	stopSoundIfExists(legacyTheme)
	stopSoundIfExists(workspaceLegacy)
end

local function prepareMainThemeForLater()
	stopAllNonLoadingMusic()
	SoundService:SetAttribute("LoadingMusicActive", true)
end

local function startLoadingMusic()
	if loadingMusic and loadingMusic.Parent then
		return
	end

	stopAllNonLoadingMusic()

	loadingMusic = Instance.new("Sound")
	loadingMusic.Name = "LoadingMusic"
	loadingMusic.SoundId = LOADING_SOUND_ID
	loadingMusic.Looped = true
	loadingMusic.Volume = 0
	loadingMusic.Parent = SoundService

	loadingMusicTargetVolume = 1

	SoundService:SetAttribute("LoadingMusicActive", true)

	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ loadingMusic })
		end)
	end)

	pcall(function()
		loadingMusic:Play()
	end)

	local initialVolume = (SoundService:GetAttribute("MusicMuted") == true) and 0 or loadingMusicTargetVolume

	activeMusicTween = safeTween(
		loadingMusic,
		TweenInfo.new(LOADING_SOUND_FADE_IN, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Volume = initialVolume }
	)
end

local function applyMusicMuteToLoading()
	if not loadingMusic or not loadingMusic.Parent then
		return
	end

	if activeMusicTween then
		pcall(function()
			activeMusicTween:Cancel()
		end)

		activeMusicTween = nil
	end

	local muted = SoundService:GetAttribute("MusicMuted") == true
	local target = muted and 0 or loadingMusicTargetVolume

	activeMusicTween = safeTween(
		loadingMusic,
		TweenInfo.new(MUSIC_TOGGLE_FADE_SECONDS, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{ Volume = target }
	)
end

local function transitionToMainTheme(forceImmediate)
	if musicHandoffDone then
		return
	end

	musicHandoffDone = true

	if activeMusicTween then
		pcall(function()
			activeMusicTween:Cancel()
		end)

		activeMusicTween = nil
	end

	if loadingMusicMuteConn then
		pcall(function()
			loadingMusicMuteConn:Disconnect()
		end)

		loadingMusicMuteConn = nil
	end

	if loadingMusic and loadingMusic.Parent then
		if forceImmediate then
			loadingMusic.Volume = 0
		else
			tweenWait(
				loadingMusic,
				TweenInfo.new(THEME_FADE_SECONDS, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ Volume = 0 },
				THEME_FADE_SECONDS + 0.35,
				false
			)
		end

		if loadingMusic and loadingMusic.Parent then
			pcall(function()
				loadingMusic:Stop()
			end)

			loadingMusic:Destroy()
			loadingMusic = nil
		end
	end

	-- This is the only release point for the main GameTheme.
	SoundService:SetAttribute("LoadingMusicActive", false)
end

local function scheduleMusicHandoff(delaySeconds)
	if musicHandoffScheduled then
		return
	end

	musicHandoffScheduled = true

	task.spawn(function()
		if delaySeconds and delaySeconds > 0 then
			task.wait(delaySeconds)
		end

		transitionToMainTheme(false)
	end)
end

-- ============================================================
-- CLEANUP
-- ============================================================

local function finalCleanup(fromError)
	if state.cleaned then
		return
	end

	if fromError then
		transitionToMainTheme(true)
	elseif not musicHandoffScheduled and not musicHandoffDone then
		transitionToMainTheme(true)
	end

	state.cleaned = true
	state.alive = false

	disconnectAll()

	pcall(function()
		RunService:UnbindFromRenderStep(LOCK_NAME)
	end)

	unlockControls()
	disableMovementLock()
	forceRestoreCamera()

	pcall(function()
		playerGui:SetAttribute("LoadingScreenActive", false)
	end)

	restoreVisuals()

	pcall(function()
		if blur and blur.Parent then
			blur.Size = originalBlurSize

			if blurWasCreated then
				blur:Destroy()
			end
		end
	end)

	pcall(function()
		if loadingGui and loadingGui.Parent then
			loadingGui:Destroy()
		end
	end)

	pcall(function()
		if progressValue then
			progressValue:Destroy()
		end
	end)
end

-- ============================================================
-- AFTER LOADING PROMPT
-- ============================================================

local function showAfterLoadingPromptAndWaitForClick()
	removeUnwantedCompletionLabels()
	updateProgressBar(1)

	if afterLoading and afterLoading:IsA("GuiObject") then
		afterLoading.Visible = true
	end

	local hasButton = clickButton and clickButton:IsA("GuiButton")

	if hasButton then
		clickButton.Visible = true
		clickButton.Active = true
		clickButton.AutoButtonColor = false
	end

	if infoLabel and infoLabel:IsA("TextLabel") then
		infoLabel.Visible = true
		infoLabel.Text = getStartPromptText()
		infoLabel.TextTransparency = 1

		if infoStroke then
			infoStroke.Transparency = 1
		end

		safeTween(
			infoLabel,
			TweenInfo.new(INFO_FADE_IN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ TextTransparency = 0 }
		)

		if infoStroke then
			safeTween(
				infoStroke,
				TweenInfo.new(INFO_FADE_IN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
				{ Transparency = 0 }
			)
		end
	end

	if not hasButton then
		waitSeconds(FALLBACK_AFTER_LOADING_HOLD)
		return
	end

	local clicked = false
	local clickConn
	local inputConn

	clickConn = clickButton.Activated:Connect(function()
		if clicked then
			return
		end

		clicked = true
	end)

	inputConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or clicked then
			return
		end

		if isStartInput(input) then
			clicked = true
		end
	end)

	local promptStarted = os.clock()

	while isAlive() and not clicked do
		if not clickButton or not clickButton.Parent then
			break
		end

		if AUTO_CONTINUE_AFTER_LOADING_SECONDS
			and os.clock() - promptStarted >= AUTO_CONTINUE_AFTER_LOADING_SECONDS then
			warn("[LoadingScreen] Start prompt was not clicked in time. Auto-continuing.")
			break
		end

		RunService.Heartbeat:Wait()
	end

	if inputConn then
		inputConn:Disconnect()
	end

	if clickConn then
		clickConn:Disconnect()
	end

	if clickButton and clickButton:IsA("GuiButton") then
		clickButton.Active = false
	end
end

local function hideAfterLoadingPrompt()
	if infoLabel and infoLabel:IsA("TextLabel") then
		local startPos = infoInitialPosition or infoLabel.Position

		local upPos = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset,
			startPos.Y.Scale - 0.1,
			startPos.Y.Offset
		)

		local downPos = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset,
			startPos.Y.Scale + 1,
			startPos.Y.Offset
		)

		tweenWait(
			infoLabel,
			TweenInfo.new(INFO_UP_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ Position = upPos },
			INFO_UP_TIME + 0.2,
			true
		)

		local labelTween = safeTween(
			infoLabel,
			TweenInfo.new(INFO_EXIT_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
			{
				Position = downPos,
				TextTransparency = 1,
			}
		)

		if infoStroke then
			safeTween(
				infoStroke,
				TweenInfo.new(INFO_EXIT_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
				{ Transparency = 1 }
			)
		end

		waitForTween(labelTween, INFO_EXIT_TIME + 0.3, true)
	end

	if clickButton and clickButton:IsA("GuiButton") then
		clickButton.Active = false
		clickButton.Visible = false
	end

	if afterLoading and afterLoading:IsA("GuiObject") then
		afterLoading.Visible = false
	end
end

-- ============================================================
-- PRELOADING
-- ============================================================

local PRELOAD_CLASSES = {
	ImageLabel = true,
	ImageButton = true,
	Sound = true,
	Decal = true,
	Texture = true,
	MeshPart = true,
	SpecialMesh = true,
	Animation = true,
	VideoFrame = true,
	SurfaceAppearance = true,
}

local function hasContentId(value)
	return type(value) == "string" and value ~= "" and value ~= "rbxassetid://"
end

local function shouldPreload(inst)
	if not PRELOAD_CLASSES[inst.ClassName] then
		return false
	end

	if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
		return hasContentId(inst.Image)
	elseif inst:IsA("Sound") then
		return hasContentId(inst.SoundId)
	elseif inst:IsA("Decal") or inst:IsA("Texture") then
		return hasContentId(inst.Texture)
	elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") then
		return hasContentId(inst.Texture)
	elseif inst:IsA("Animation") then
		return hasContentId(inst.AnimationId)
	elseif inst:IsA("VideoFrame") then
		return hasContentId(inst.Video)
	elseif inst:IsA("MeshPart") then
		return hasContentId(inst.MeshId) or hasContentId(inst.TextureID)
	elseif inst:IsA("SpecialMesh") then
		return hasContentId(inst.MeshId) or hasContentId(inst.TextureId)
	elseif inst:IsA("SurfaceAppearance") then
		return hasContentId(inst.ColorMap)
			or hasContentId(inst.MetalnessMap)
			or hasContentId(inst.NormalMap)
			or hasContentId(inst.RoughnessMap)
	end

	return true
end

local function buildPreloadList()
	local preloadList = {}

	if loadingGui then
		table.insert(preloadList, loadingGui)
	end

	local folder = ReplicatedStorage:FindFirstChild(PRELOAD_FOLDER_NAME)

	if folder then
		for _, inst in ipairs(folder:GetDescendants()) do
			if shouldPreload(inst) then
				table.insert(preloadList, inst)
			end
		end
	end

	return preloadList
end

local function preloadAssets()
	local preloadList = buildPreloadList()
	local startValue = progressValue and progressValue.Value or PHASE_CAMERA_READY_TO
	local distance = PHASE_PRELOAD_TO - startValue

	if #preloadList <= 0 then
		tweenProgressAndWait(PHASE_PRELOAD_TO, 0.3)
		return
	end

	local loadedCount = 0
	local preloadDone = false
	local preloadOk = true
	local preloadErr = nil
	local failedAssets = {}

	local started = os.clock()

	task.spawn(function()
		local ok, err = pcall(function()
			ContentProvider:PreloadAsync(preloadList, function(assetId, status)
				loadedCount += 1

				if status and status.Name and status.Name ~= "Success" then
					local assetLabel = tostring(assetId or "")
					if assetLabel == "" then
						assetLabel = "unknown asset"
					end
					table.insert(failedAssets, assetLabel .. " [" .. status.Name .. "]")
				end
			end)
		end)

		preloadOk = ok
		preloadErr = err
		preloadDone = true
	end)

	while isAlive() and not preloadDone do
		if loadingPhaseExpired() then
			markLoadingTimeout()
			break
		end

		local elapsed = os.clock() - started
		local countAlpha = math.clamp(loadedCount / math.max(#preloadList, 1), 0, 1)
		local timeAlpha = math.clamp(elapsed / math.max(PRELOAD_MIN_SECONDS, #preloadList * 0.04), 0, 0.95)
		local alpha = math.max(countAlpha, timeAlpha * 0.55)

		tweenProgress(startValue + (distance * alpha), 0.15)

		RunService.Heartbeat:Wait()
	end

	if not preloadOk and preloadErr then
		warn("[LoadingScreen] PreloadAsync failed:", preloadErr)
	end

	if #failedAssets > 0 then
		warn("[LoadingScreen] Some assets failed to preload:", table.concat(failedAssets, ", "))
	end

	tweenProgressAndWait(PHASE_PRELOAD_TO, 0.4)
end

-- ============================================================
-- SETUP
-- ============================================================

local function setupGui()
	loadingGui = resolveLoadingGui()
	loadingGui.Name = ACTIVE_GUI_NAME
	loadingGui.ResetOnSpawn = false
	loadingGui.Enabled = true
	loadingGui.IgnoreGuiInset = true
	loadingGui.DisplayOrder = 10000
	loadingGui.Parent = playerGui

	bgFrame = loadingGui:WaitForChild("Frame", 5)

	if not bgFrame then
		warn("[LoadingScreen] Frame missing inside loading UI. Replacing with fallback UI.")

		local fallbackGui = createFallbackLoadingGui()

		loadingGui:Destroy()
		loadingGui = fallbackGui
		loadingGui.Name = ACTIVE_GUI_NAME
		loadingGui.ResetOnSpawn = false
		loadingGui.Enabled = true
		loadingGui.IgnoreGuiInset = true
		loadingGui.DisplayOrder = 10000
		loadingGui.Parent = playerGui

		bgFrame = loadingGui:WaitForChild("Frame", 5)
	end

	if not bgFrame then
		error("[LoadingScreen] Could not create or resolve a valid loading UI Frame.")
	end

	transitionFrame = Instance.new("Frame")
	transitionFrame.Name = "TransitionFrame"
	transitionFrame.Size = UDim2.fromScale(1, 1)
	transitionFrame.Position = UDim2.fromScale(0, 0)
	transitionFrame.BackgroundColor3 = Color3.new(0, 0, 0)
	transitionFrame.BackgroundTransparency = 1
	transitionFrame.BorderSizePixel = 0
	transitionFrame.ZIndex = 2000
	transitionFrame.Parent = loadingGui

	bgFrame.Visible = false

	barContainer = bgFrame:FindFirstChild("ProgressBarContainer")
	barFill = barContainer and barContainer:FindFirstChild("ProgressBar")
	progressText = barContainer and barContainer:FindFirstChild("ProgressText")

	afterLoading = bgFrame:FindFirstChild("AfterLoading")
	clickButton = afterLoading and afterLoading:FindFirstChild("ClickButton")
	infoLabel = afterLoading and afterLoading:FindFirstChild("Information")
	infoStroke = infoLabel and infoLabel:FindFirstChildOfClass("UIStroke")
	infoInitialPosition = infoLabel and infoLabel.Position

	if afterLoading and afterLoading:IsA("GuiObject") then
		afterLoading.Visible = false
	end

	if clickButton and clickButton:IsA("GuiButton") then
		clickButton.Visible = false
		clickButton.Active = false
		clickButton.AutoButtonColor = false
	end

	if infoLabel and infoLabel:IsA("TextLabel") then
		infoLabel.Visible = false
		infoLabel.Text = getStartPromptText()
	end

	removeUnwantedCompletionLabels()
	disableProgressTextColorEffects()

	progressValue = Instance.new("NumberValue")
	progressValue.Name = "LoadingProgressValue"
	progressValue.Value = 0

	if barFill then
		maxXScale = barFill.Size.X.Scale
		maxXOffset = barFill.Size.X.Offset
		yScale = barFill.Size.Y.Scale
		yOffset = barFill.Size.Y.Offset

		barFill.Size = UDim2.new(0, 0, yScale, yOffset)
	end

	trackConnection(progressValue.Changed:Connect(updateProgressBar))
	updateProgressBar(0)

	table.clear(recordedTransparency)

	for _, instance in ipairs(loadingGui:GetDescendants()) do
		recordProps(instance)
	end

	for instance in pairs(recordedTransparency) do
		setInvisible(instance)
	end
end

-- ============================================================
-- MAIN SEQUENCE
-- ============================================================

local function runLoadingScreen()
	state.alive = true
	state.cleaned = false
	state.loadingPhaseStartedAt = os.clock()
	state.loadingPhaseTimedOut = false

	playerGui:SetAttribute("LoadingScreenActive", true)
	SoundService:SetAttribute("LoadingMusicActive", true)

	setupGui()
	setupBlur()

	lockControls()
	enableMovementLock()
	startHidingVisuals()

	prepareMainThemeForLater()
	startLoadingMusic()

	if loadingMusicMuteConn then
		loadingMusicMuteConn:Disconnect()
	end

	loadingMusicMuteConn = SoundService:GetAttributeChangedSignal("MusicMuted"):Connect(applyMusicMuteToLoading)

	blurTo(BLUR_SIZE, BLUR_IN_TIME)

	bgFrame.Visible = true

	local finalPos = bgFrame.Position

	local startPos = UDim2.new(
		finalPos.X.Scale,
		finalPos.X.Offset,
		finalPos.Y.Scale + 1.5,
		finalPos.Y.Offset
	)

	bgFrame.Position = startPos

	safeTween(
		bgFrame,
		TweenInfo.new(ANIMATION_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{ Position = finalPos }
	)

	fadeToRecorded(ANIMATION_DURATION)

	local loadingCameraSource, loadingCameraSourceLabel = resolveLoadingCameraSource(CAMERA_SOURCE_TIMEOUT)

	if not loadingCameraSource then
		warn("[LoadingScreen] LoadingCameraCFrame was not found. Camera will lock at its current position.")
	else
		debugLog("Loading camera source:", loadingCameraSourceLabel)
	end

	lockCameraToCFrameSource(loadingCameraSource)

	waitSeconds(ANIMATION_DURATION * 0.3)

	tweenProgress(PHASE_GAME_LOADED_TO, 1.5)

	while isAlive() and not game:IsLoaded() do
		if loadingPhaseExpired() then
			markLoadingTimeout()
			break
		end

		RunService.Heartbeat:Wait()
	end

	tweenProgressAndWait(PHASE_CAMERA_READY_TO, 1.2)

	if not loadingPhaseExpired() then
		preloadAssets()
	else
		markLoadingTimeout()
	end

	-- game:IsLoaded() only covers replicated instances; it does not mean the
	-- server has acquired and reconciled this player's DataStore profile. Keep
	-- gameplay hidden and controls locked until TycoonDataHandler publishes the
	-- authoritative ready flag. The server owns failure/lease-timeout handling
	-- and kicks rather than exposing fabricated defaults.
	while isAlive() and player.Parent and player:GetAttribute("TycoonDataLoaded") ~= true do
		RunService.Heartbeat:Wait()
	end
	if not isAlive() or not player.Parent then return end

	tweenProgressAndWait(PHASE_FINISH_TO, 1.0)
	updateProgressBar(1)

	showAfterLoadingPromptAndWaitForClick()

	if not isAlive() then
		return
	end

	-- Main theme is only released after the player starts.
	scheduleMusicHandoff(LOADING_SOUND_HOLD_SECONDS)

	hideAfterLoadingPrompt()

	local exitPos = UDim2.new(
		finalPos.X.Scale,
		finalPos.X.Offset,
		finalPos.Y.Scale - 1.5,
		finalPos.Y.Offset
	)

	safeTween(
		bgFrame,
		TweenInfo.new(ANIMATION_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
		{ Position = exitPos }
	)

	fadeToInvisible(ANIMATION_DURATION)
	blurTo(0, BLUR_OUT_TIME)

	waitSeconds(ANIMATION_DURATION)

	if not isAlive() then
		return
	end

	unlockCameraToPlayer()
	finalCleanup(false)
end

task.spawn(function()
	local ok, err = xpcall(runLoadingScreen, debug.traceback)

	if not ok then
		warn("[LoadingScreen] Error in main sequence:\n", err)
		finalCleanup(true)
	end
end)
