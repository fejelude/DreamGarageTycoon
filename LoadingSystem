local function resolveLoadingGui()
	local deadline = os.clock() + SOURCE_GUI_TIMEOUT

	repeat
		local source = findLoadingGuiSource()

		if source and source:IsA("ScreenGui") then
			if source.Parent == playerGui then
				return source
			end

			return source:Clone()
		end

		RunService.Heartbeat:Wait()
	until not isAlive() or os.clock() >= deadline

	warn("[LoadingScreen] LoadingScreenGui did not replicate in time; using fallback UI.")
	return createFallbackLoadingGui()
end

