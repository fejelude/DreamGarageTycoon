-- ============================================================
-- CAMERA
-- ============================================================

local camera = Workspace.CurrentCamera

local function getCamera()
	camera = Workspace.CurrentCamera or camera
	return camera
end

local function lockCameraTo(part)
	local cam = getCamera()

	if not cam then
		return
	end

	pcall(function()
		RunService:UnbindFromRenderStep(LOCK_NAME)
	end)

	cam.CameraType = Enum.CameraType.Scriptable

	if part and part:IsA("BasePart") then
		cam.CFrame = part.CFrame
	end

	RunService:BindToRenderStep(LOCK_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		if not isAlive() then
			pcall(function()
				RunService:UnbindFromRenderStep(LOCK_NAME)
			end)
			return
		end

		local currentCamera = getCamera()
		if not currentCamera then
			return
		end

		currentCamera.CameraType = Enum.CameraType.Scriptable

		if part and part.Parent and part:IsA("BasePart") then
			currentCamera.CFrame = part.CFrame
		end
	end)
end

local function waitForCharacter(timeout)
	local deadline = os.clock() + timeout

	while isAlive() and os.clock() < deadline do
		if player.Character then
			return player.Character
		end

		RunService.Heartbeat:Wait()
	end

	return player.Character
end

local function unlockCameraToPlayer()
	pcall(function()
		RunService:UnbindFromRenderStep(LOCK_NAME)
	end)

	local cam = getCamera()
	if not cam then
		return
	end

	local character = waitForCharacter(8)
	if not character then
		cam.CameraType = Enum.CameraType.Custom
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)

	if not isAlive() then
		return
	end

	if not humanoid or not root then
		cam.CameraType = Enum.CameraType.Custom
		return
	end

	cam.CameraType = Enum.CameraType.Scriptable

	local offset = CFrame.new(0, 5, 12)
	local targetCF = root.CFrame:ToWorldSpace(offset)
	targetCF = CFrame.lookAt(targetCF.Position, root.Position + Vector3.new(0, 2, 0))

	tweenWait(
		cam,
		TweenInfo.new(SWOOP_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{ CFrame = targetCF },
		SWOOP_DURATION + 0.5
	)

	if not isAlive() then
		return
	end

	tweenWait(
		transitionFrame,
		TweenInfo.new(BLACK_FADE_OUT_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 0 },
		BLACK_FADE_OUT_TIME + 0.3
	)

	if not isAlive() then
		return
	end

	cam.CameraSubject = humanoid
	cam.CameraType = Enum.CameraType.Custom

	tweenWait(
		transitionFrame,
		TweenInfo.new(BLACK_FADE_IN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 },
		BLACK_FADE_IN_TIME + 0.3
	)
end

-- ============================================================
-- VISIBILITY MANAGER
-- ============================================================

local hiddenGuiObjects = {}

local function isExternallyManaged(obj)
	local current = obj

	while current do
		if current:GetAttribute("ExternallyManaged") == true then
			return true
		end

		current = current.Parent
	end

	return false
end

local function scanAndHide(parent)
	if not parent or not loadingGui then
		return
	end

	for _, child in ipairs(parent:GetChildren()) do
		if child == loadingGui or child:IsDescendantOf(loadingGui) then
			continue
		end

		if child:IsA("GuiObject") then
			if isExternallyManaged(child) then
				continue
			end

			if child.Visible then
				hiddenGuiObjects[child] = true
				child:SetAttribute(HIDDEN_BY_LOADING_ATTRIBUTE, true)
				child.Visible = false
				continue
			end
		end

		if child:IsA("Folder") or child:IsA("ScreenGui") or child:IsA("GuiObject") then
			scanAndHide(child)
		end
	end
end

local function startHidingVisuals()
	scanAndHide(playerGui)

	scanThread = task.spawn(function()
		while isAlive() and playerGui:GetAttribute("LoadingScreenActive") do
			scanAndHide(playerGui)
			task.wait(0.2)
		end
	end)
end

local function restoreVisuals()
	if scanThread then
		pcall(function()
			task.cancel(scanThread)
		end)

		scanThread = nil
	end

	for item in pairs(hiddenGuiObjects) do
		if item and item.Parent and item:GetAttribute(HIDDEN_BY_LOADING_ATTRIBUTE) == true then
			item:SetAttribute(HIDDEN_BY_LOADING_ATTRIBUTE, nil)

			if not isExternallyManaged(item) then
				item.Visible = true
			end
		end
	end

	table.clear(hiddenGuiObjects)
end

-- ============================================================
-- LOADING SCREEN TRANSPARENCY FADE
-- ============================================================

local recordedTransparency = {}

local function recordProps(instance)
	local props = {}
	local changed = false

	if instance:IsA("GuiObject") and instance.BackgroundTransparency < 1 then
		props.BackgroundTransparency = instance.BackgroundTransparency
		changed = true
	end

	if (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
		and instance.TextTransparency < 1 then
		props.TextTransparency = instance.TextTransparency
		changed = true
	end

	if (instance:IsA("ImageLabel") or instance:IsA("ImageButton"))
		and instance.ImageTransparency < 1 then
		props.ImageTransparency = instance.ImageTransparency
		changed = true
	end

	if instance:IsA("UIStroke") and instance.Transparency < 1 then
		props.Transparency = instance.Transparency
		changed = true
	end

	if changed then
		recordedTransparency[instance] = props
	end
end

local function setInvisible(instance)
	local props = recordedTransparency[instance]

	if not props then
		return
	end

	if instance:IsA("GuiObject") and props.BackgroundTransparency ~= nil then
		instance.BackgroundTransparency = 1
	end

	if (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
		and props.TextTransparency ~= nil then
		instance.TextTransparency = 1
	end

	if (instance:IsA("ImageLabel") or instance:IsA("ImageButton"))
		and props.ImageTransparency ~= nil then
		instance.ImageTransparency = 1
	end

	if instance:IsA("UIStroke") and props.Transparency ~= nil then
		instance.Transparency = 1
	end
end

local function fadeToRecorded(duration)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	for instance, goals in pairs(recordedTransparency) do
		if instance and instance.Parent then
			safeTween(instance, info, goals)
		end
	end
end

local function fadeToInvisible(duration)
	local info = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.In)

	for instance, props in pairs(recordedTransparency) do
		if instance and instance.Parent then
			local goals = {}

			if instance:IsA("GuiObject") and props.BackgroundTransparency ~= nil then
				goals.BackgroundTransparency = 1
			end

			if (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
				and props.TextTransparency ~= nil then
				goals.TextTransparency = 1
			end

			if (instance:IsA("ImageLabel") or instance:IsA("ImageButton"))
				and props.ImageTransparency ~= nil then
				goals.ImageTransparency = 1
			end

			if instance:IsA("UIStroke") and props.Transparency ~= nil then
				goals.Transparency = 1
			end

			if next(goals) then
				safeTween(instance, info, goals)
			end
		end
	end
end

for _, instance in ipairs(loadingGui:GetDescendants()) do
	recordProps(instance)
end

for instance in pairs(recordedTransparency) do
	setInvisible(instance)
end

-- ============================================================
-- AUDIO
-- ============================================================

local function getOrCreateMainTheme()
	local existing = SoundService:FindFirstChild(MAIN_THEME_NAME)

	if existing and existing:IsA("Sound") then
		return existing
	end

	local fromWorkspace = Workspace:FindFirstChild(MAIN_THEME_NAME)

	if fromWorkspace and fromWorkspace:IsA("Sound") then
		fromWorkspace.Parent = SoundService
		return fromWorkspace
	end

	return nil
end

local function prepareMainThemeForLater()
	local theme = getOrCreateMainTheme()

	if not theme then
		return
	end

	if theme.Volume > 0 then
		mainThemeTargetVolume = theme.Volume
	end

	if theme.IsPlaying then
		pcall(function()
			theme:Stop()
		end)
	end

	theme.Volume = 0
end

local function startLoadingMusic()
	if loadingMusic and loadingMusic.Parent then
		return
	end

	loadingMusic = Instance.new("Sound")
	loadingMusic.Name = "LoadingMusic"
	loadingMusic.SoundId = LOADING_SOUND_ID
	loadingMusic.Looped = true
	loadingMusic.Volume = 0
	loadingMusic.Parent = SoundService
	loadingMusicTargetVolume = (SoundService:GetAttribute("MusicMuted") == true) and 0 or 1
	SoundService:SetAttribute("LoadingMusicActive", true)

	pcall(function()
		loadingMusic:Play()
	end)

	safeTween(
		loadingMusic,
		TweenInfo.new(LOADING_SOUND_FADE_IN, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Volume = loadingMusicTargetVolume }
	)
end

local function applyMusicMuteToLoading()
	if not loadingMusic or not loadingMusic.Parent then
		return
	end

	if activeMusicTween then
		activeMusicTween:Cancel()
		activeMusicTween = nil
	end

	local muted = SoundService:GetAttribute("MusicMuted") == true
	local target = muted and 0 or loadingMusicTargetVolume

	activeMusicTween = safeTween(
		loadingMusic,
		TweenInfo.new(MUSIC_TOGGLE_FADE_SECONDS, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{ Volume = target }
	)
end

local function transitionToMainTheme()
	if musicHandoffDone then
		return
	end

	musicHandoffDone = true

	local theme = getOrCreateMainTheme()

	if theme then
		local targetVolume = mainThemeTargetVolume

		if targetVolume <= 0 then
			targetVolume = 1
		end

		theme.Volume = 0

		if not theme.IsPlaying then
			pcall(function()
				theme:Play()
			end)
		end

		safeTween(
			theme,
			TweenInfo.new(THEME_FADE_SECONDS, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{ Volume = targetVolume }
		)
	end

	if loadingMusic and loadingMusic.Parent then
		safeTween(
			loadingMusic,
			TweenInfo.new(THEME_FADE_SECONDS, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{ Volume = 0 }
		)

		task.wait(THEME_FADE_SECONDS + 0.1)

		if loadingMusic and loadingMusic.Parent then
			pcall(function()
				loadingMusic:Stop()
			end)

			loadingMusic:Destroy()
			loadingMusic = nil
		end
	end

	SoundService:SetAttribute("LoadingMusicActive", false)
end

local function scheduleMusicHandoff(delaySeconds)
	if musicHandoffScheduled then
		return
	end

	musicHandoffScheduled = true

	task.delay(delaySeconds, function()
		if isAlive() or state.cleaned then
			transitionToMainTheme()
		end
	end)
end

-- ============================================================
-- CLEANUP
-- ============================================================

local function finalCleanup(fromError)
	if state.cleaned then
		return
	end

	if fromError and loadingMusic and loadingMusic.Parent and not musicHandoffScheduled then
		scheduleMusicHandoff(0)
	end

	state.cleaned = true
	state.alive = false

	disconnectAll()

	pcall(function()
		RunService:UnbindFromRenderStep(LOCK_NAME)
	end)

	unlockControls()
	disableMovementLock()

	pcall(function()
		playerGui:SetAttribute("LoadingScreenActive", false)
	end)

	restoreVisuals()

	pcall(function()
		if blur and blur.Parent then
			blur.Size = originalBlurSize

			if blurWasCreated then
				blur:Destroy()
			end
		end
	end)

	pcall(function()
		if loadingGui and loadingGui.Parent then
			loadingGui:Destroy()
		end
	end)

	pcall(function()
		if progressValue then
			progressValue:Destroy()
		end
	end)
end

-- ============================================================
-- AFTER LOADING PROMPT
-- ============================================================

local function showAfterLoadingPromptAndWaitForClick()
	removeUnwantedCompletionLabels()
	updateProgressBar(1)

	if afterLoading and afterLoading:IsA("GuiObject") then
		afterLoading.Visible = true
	end

	local hasButton = clickButton and clickButton:IsA("GuiButton")

	if hasButton then
		clickButton.Visible = true
		clickButton.Active = true
		clickButton.AutoButtonColor = false
	end

	if infoLabel and infoLabel:IsA("TextLabel") then
		infoLabel.Visible = true
		infoLabel.TextTransparency = 1

		if infoStroke then
			infoStroke.Transparency = 1
		end

		safeTween(
			infoLabel,
			TweenInfo.new(INFO_FADE_IN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ TextTransparency = 0 }
		)

		if infoStroke then
			safeTween(
				infoStroke,
				TweenInfo.new(INFO_FADE_IN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
				{ Transparency = 0 }
			)
		end
	end

	if not hasButton then
		waitSeconds(FALLBACK_AFTER_LOADING_HOLD)
		return
	end

	local clicked = false
	local clickConn

	clickConn = clickButton.Activated:Connect(function()
		if clicked then
			return
		end

		clicked = true
	end)

	while isAlive() and not clicked do
		if not clickButton or not clickButton.Parent then
			break
		end

		RunService.Heartbeat:Wait()
	end

	if clickConn then
		clickConn:Disconnect()
	end

	if clickButton and clickButton:IsA("GuiButton") then
		clickButton.Active = false
	end
end

local function hideAfterLoadingPrompt()
	if infoLabel and infoLabel:IsA("TextLabel") then
		local startPos = infoInitialPosition or infoLabel.Position
		local upPos = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset,
			startPos.Y.Scale - 0.1,
			startPos.Y.Offset
		)

		local downPos = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset,
			startPos.Y.Scale + 1,
			startPos.Y.Offset
		)

		tweenWait(
			infoLabel,
			TweenInfo.new(INFO_UP_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ Position = upPos },
			INFO_UP_TIME + 0.2
		)

		local labelTween = safeTween(
			infoLabel,
			TweenInfo.new(INFO_EXIT_TIME, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
			{
				Position = downPos,
				TextTransparency = 1,
			}
		)

		if infoStroke then
			safeTween(
				infoStroke,
				TweenInfo.new(INFO_EXIT_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
				{ Transparency = 1 }
			)
		end

		if labelTween then
			local done = false
			local conn

			conn = labelTween.Completed:Connect(function()
				done = true
			end)

			local started = os.clock()

			while isAlive() and not done and os.clock() - started < INFO_EXIT_TIME + 0.3 do
				RunService.Heartbeat:Wait()
			end

			if conn then
				conn:Disconnect()
			end
		end
	end

	if clickButton and clickButton:IsA("GuiButton") then
		clickButton.Active = false
		clickButton.Visible = false
	end

	if afterLoading and afterLoading:IsA("GuiObject") then
		afterLoading.Visible = false
	end
end

-- ============================================================
-- PRELOADING
-- ============================================================

local function preloadAssetWithTimeout(asset, timeout)
	if not asset or not isAlive() then
		return false
	end

	local done = false

	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ asset })
		end)

		done = true
	end)

	local started = os.clock()

	while isAlive() and not done do
		if os.clock() - started >= timeout then
			return false
		end

		if loadingPhaseExpired() then
			markLoadingTimeout()
			return false
		end

		RunService.Heartbeat:Wait()
	end

	return done
end

local function buildPreloadList(viewPart)
	local preloadList = { loadingGui }

	local folder = ReplicatedStorage:FindFirstChild(PRELOAD_FOLDER_NAME)

	if folder then
		for _, inst in ipairs(folder:GetDescendants()) do
			table.insert(preloadList, inst)
		end
	end

	if viewPart then
		table.insert(preloadList, viewPart)
	end

	return preloadList
end

local function preloadAssets(viewPart)
	local preloadList = buildPreloadList(viewPart)
	local startValue = progressValue.Value
	local distance = PHASE_PRELOAD_TO - startValue

	if #preloadList <= 0 then
		tweenProgress(PHASE_PRELOAD_TO, 0.3)
		return
	end

	for i, asset in ipairs(preloadList) do
		if not isAlive() then
			return
		end

		if loadingPhaseExpired() then
			markLoadingTimeout()
			break
		end

		preloadAssetWithTimeout(asset, PRELOAD_ASSET_TIMEOUT)

		local alpha = i / #preloadList
		local target = startValue + (distance * alpha)

		tweenProgress(target, 0.1)

		if #preloadList < 20 then
			waitSeconds(0.05)
		else
			RunService.Heartbeat:Wait()
		end
	end
end

-- ============================================================
-- MAIN
-- ============================================================

task.spawn(function()
	local ok, err = xpcall(function()
		lockControls()
		enableMovementLock()
		startHidingVisuals()

		prepareMainThemeForLater()
		startLoadingMusic()
		trackConnection(SoundService:GetAttributeChangedSignal("MusicMuted"):Connect(applyMusicMuteToLoading))

		blurTo(BLUR_SIZE, BLUR_IN_TIME)

		bgFrame.Visible = true

		local finalPos = bgFrame.Position
		local startPos = UDim2.new(
			finalPos.X.Scale,
			finalPos.X.Offset,
			finalPos.Y.Scale + 1.5,
			finalPos.Y.Offset
		)

		bgFrame.Position = startPos

		safeTween(
			bgFrame,
			TweenInfo.new(ANIMATION_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{ Position = finalPos }
		)

		fadeToRecorded(ANIMATION_DURATION)

		lockCameraTo(nil)

		local viewPart = waitForNamedChild(
			Workspace,
			VIEW_PART_NAME,
			math.min(VIEW_PART_TIMEOUT, remainingLoadingTime())
		)

		if viewPart and viewPart:IsA("BasePart") then
			lockCameraTo(viewPart)
		else
			warn("[LoadingScreen] LoadingViewPart was not found. Continuing with camera locked in place.")
		end

		waitSeconds(ANIMATION_DURATION * 0.3)

		tweenProgress(PHASE_GAME_LOADED_TO, 1.5)

		while isAlive() and not game:IsLoaded() do
			if loadingPhaseExpired() then
				markLoadingTimeout()
				break
			end

			RunService.Heartbeat:Wait()
		end

		tweenProgressAndWait(PHASE_VIEWPART_READY_TO, 1.2)

		if not loadingPhaseExpired() then
			preloadAssets(viewPart)
		else
			markLoadingTimeout()
		end

		tweenProgressAndWait(PHASE_FINISH_TO, 1.0)
		updateProgressBar(1)

		showAfterLoadingPromptAndWaitForClick()

		if not isAlive() then
			return
		end

		scheduleMusicHandoff(LOADING_SOUND_HOLD_SECONDS)

		hideAfterLoadingPrompt()

		local exitPos = UDim2.new(
			finalPos.X.Scale,
			finalPos.X.Offset,
			finalPos.Y.Scale - 1.5,
			finalPos.Y.Offset
		)

		safeTween(
			bgFrame,
			TweenInfo.new(ANIMATION_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
			{ Position = exitPos }
		)

		fadeToInvisible(ANIMATION_DURATION)
		blurTo(0, BLUR_OUT_TIME)

		waitSeconds(ANIMATION_DURATION)

		if not isAlive() then
			return
		end

		unlockCameraToPlayer()
		finalCleanup(false)
	end, debug.traceback)

	if not ok then
		warn("[LoadingScreen] Error in main sequence:\n", err)
		finalCleanup(true)
	end
end)
