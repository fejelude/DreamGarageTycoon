	blur.Name = "LoadingScreenBlur"
	blur.Size = 0
	blur.Parent = Lighting
	blurWasCreated = true
	originalBlurSize = 0
end

local function blurTo(size, duration)
	if not blur or not blur.Parent then
		return nil
	end

	return safeTween(
		blur,
		TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Size = size }
	)
end

