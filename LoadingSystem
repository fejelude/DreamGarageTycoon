-- ============================================================
-- LoadingScreen
-- Purpose  : Production-ready loading screen with:
--            - custom loading camera
--            - progress bar
--            - click-to-start after 100%
--            - loading music that continues after loading
--            - safe transition to main theme
--            - safe cleanup / no stuck camera / no stuck music
--
-- Runs on  : Client, ideally inside ReplicatedFirst
--
-- Expected UI:
-- StarterGui
--   LoadingScreenGui
--     Frame
--       ProgressBarContainer
--         ProgressBar
--         ProgressText
--       AfterLoading
--         ClickButton
--         Information
--           UIStroke
--
-- Optional:
-- ReplicatedStorage.PreloadAssets
-- Workspace.LoadingViewPart
-- SoundService.MainTheme or Workspace.MainTheme
-- ============================================================

local ReplicatedFirst = game:GetService("ReplicatedFirst")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local ContentProvider = game:GetService("ContentProvider")
local ContextActionService = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

ReplicatedFirst:RemoveDefaultLoadingScreen()

