-- ============================================================
-- PROGRESS BAR
-- ============================================================

progressValue = Instance.new("NumberValue")
progressValue.Name = "LoadingProgressValue"
progressValue.Value = 0

local maxXScale = 0
local maxXOffset = 0
local yScale = 0
local yOffset = 0

if barFill then
	maxXScale = barFill.Size.X.Scale
	maxXOffset = barFill.Size.X.Offset
	yScale = barFill.Size.Y.Scale
	yOffset = barFill.Size.Y.Offset

	barFill.Size = UDim2.new(0, 0, yScale, yOffset)
end

local function updateProgressBar(value)
	local clamped = math.clamp(value, 0, 1)

	if barFill then
		barFill.Size = UDim2.new(
			maxXScale * clamped,
			maxXOffset * clamped,
			yScale,
			yOffset
		)
	end

	if progressText and progressText:IsA("TextLabel") then
		disableProgressTextColorEffects()

		if clamped <= 0.05 then
			progressText.Text = LOADING_TEXT_START
		else
			local number = math.floor(clamped * 100 + 0.5)
			progressText.Text = string.format("%d%%", number)
		end
	end
end

trackConnection(progressValue.Changed:Connect(updateProgressBar))
updateProgressBar(0)

local function tweenProgress(toValue, duration)
	if not isAlive() then
		return nil
	end

	local goal = math.clamp(toValue, 0, 1)

	return safeTween(
		progressValue,
		TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Value = goal }
	)
end

local function tweenProgressAndWait(toValue, duration)
	local tween = tweenProgress(toValue, duration)
	if not tween then
		return false
	end

	local done = false
	local conn

	conn = tween.Completed:Connect(function()
		done = true
	end)

	local started = os.clock()

	while isAlive() and not done do
		if os.clock() - started >= duration + 1 then
			pcall(function()
				tween:Cancel()
			end)
			break
		end

		RunService.Heartbeat:Wait()
	end

	if conn then
		conn:Disconnect()
	end

	return done
end

