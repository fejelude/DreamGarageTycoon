-- ============================================================
-- BASIC STATE
-- ============================================================

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local state = {
	alive = true,
	cleaned = false,
	loadingPhaseStartedAt = os.clock(),
	loadingPhaseTimedOut = false,
}

local connections = {}
local scanThread = nil

local loadingGui = nil
local progressValue = nil
local blur = nil
local blurWasCreated = false
local originalBlurSize = 0

local loadingMusic = nil
local musicHandoffScheduled = false
local musicHandoffDone = false
local mainThemeTargetVolume = 1
local loadingMusicTargetVolume = 1
local activeMusicTween = nil

local function isAlive()
	return state.alive and not state.cleaned
end

local function trackConnection(conn)
	if conn then
		table.insert(connections, conn)
	end
	return conn
end

local function disconnectAll()
	for _, conn in ipairs(connections) do
		if conn and conn.Connected then
			pcall(function()
				conn:Disconnect()
			end)
		end
	end
	table.clear(connections)
end

local function waitSeconds(seconds)
	local started = os.clock()
	while isAlive() and os.clock() - started < seconds do
		RunService.Heartbeat:Wait()
	end
end

local function remainingLoadingTime()
	return math.max(0, MAX_LOADING_PHASE_SECONDS - (os.clock() - state.loadingPhaseStartedAt))
end

local function loadingPhaseExpired()
	return remainingLoadingTime() <= 0
end

local function markLoadingTimeout()
	if not state.loadingPhaseTimedOut then
		state.loadingPhaseTimedOut = true
		warn("[LoadingScreen] Loading phase timed out. Continuing to start prompt safely.")
	end
end

local function safeTween(instance, tweenInfo, goals)
	if not instance then
		return nil
	end

	local ok, tween = pcall(function()
		return TweenService:Create(instance, tweenInfo, goals)
	end)

	if not ok or not tween then
		return nil
	end

	pcall(function()
		tween:Play()
	end)

	return tween
end

local function tweenWait(instance, tweenInfo, goals, timeout)
	if not isAlive() then
		return false
	end

	local tween = safeTween(instance, tweenInfo, goals)
	if not tween then
		return false
	end

	local done = false
	local conn

	conn = tween.Completed:Connect(function()
		done = true
	end)

	local started = os.clock()

	while isAlive() and not done do
		if timeout and os.clock() - started >= timeout then
			pcall(function()
				tween:Cancel()
			end)
			break
		end

		RunService.Heartbeat:Wait()
	end

	if conn then
		conn:Disconnect()
	end

	return done
end

local function waitForNamedChild(parent, childName, timeout)
	if not parent then
		return nil
	end

	local deadline = os.clock() + timeout

	while isAlive() and os.clock() < deadline do
		local child = parent:FindFirstChild(childName)
		if child then
			return child
		end

		RunService.Heartbeat:Wait()
	end

	return parent:FindFirstChild(childName)
end

