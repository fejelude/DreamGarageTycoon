-- ============================================================
-- BASIC UTILITIES
-- ============================================================

local function debugLog(...)
	if DEBUG_LOGS then
		print("[LoadingScreen]", ...)
	end
end

local function isAlive()
	return state.alive and not state.cleaned
end

local function trackConnection(conn)
	if conn then
		table.insert(connections, conn)
	end

	return conn
end

local function disconnectAll()
	for _, conn in ipairs(connections) do
		if conn and conn.Connected then
			pcall(function()
				conn:Disconnect()
			end)
		end
	end

	table.clear(connections)
end

local function waitSeconds(seconds)
	local started = os.clock()

	while isAlive() and os.clock() - started < seconds do
		RunService.Heartbeat:Wait()
	end
end

local function remainingLoadingTime()
	return math.max(0, MAX_LOADING_PHASE_SECONDS - (os.clock() - state.loadingPhaseStartedAt))
end

local function loadingPhaseExpired()
	return remainingLoadingTime() <= 0
end

local function markLoadingTimeout()
	if not state.loadingPhaseTimedOut then
		state.loadingPhaseTimedOut = true
		warn("[LoadingScreen] Loading phase timed out once. Continuing safely.")
	end
end

local function safeTween(instance, tweenInfo, goals)
	if not instance then
		return nil
	end

	local ok, tween = pcall(function()
		return TweenService:Create(instance, tweenInfo, goals)
	end)

	if not ok or not tween then
		return nil
	end

	pcall(function()
		tween:Play()
	end)

	return tween
end

local function waitForTween(tween, timeout, respectAlive)
	if not tween then
		return false
	end

	local done = false
	local conn

	conn = tween.Completed:Connect(function()
		done = true
	end)

	local started = os.clock()

	while not done do
		if timeout and os.clock() - started >= timeout then
			pcall(function()
				tween:Cancel()
			end)

			break
		end

		if respectAlive ~= false and not isAlive() then
			break
		end

		RunService.Heartbeat:Wait()
	end

	if conn then
		conn:Disconnect()
	end

	return done
end

local function tweenWait(instance, tweenInfo, goals, timeout, respectAlive)
	local tween = safeTween(instance, tweenInfo, goals)
	return waitForTween(tween, timeout, respectAlive)
end

