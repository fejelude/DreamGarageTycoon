local function isStartInput(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		return true
	end

	if input.UserInputType == Enum.UserInputType.Touch then
		return true
	end

	if input.UserInputType == Enum.UserInputType.Keyboard then
		return input.KeyCode == Enum.KeyCode.Space
			or input.KeyCode == Enum.KeyCode.Return
			or input.KeyCode == Enum.KeyCode.KeypadEnter
	end

	if input.UserInputType == Enum.UserInputType.Gamepad1 then
		return input.KeyCode == Enum.KeyCode.ButtonA
	end

	return false
end

-- ============================================================
-- CAMERA
-- ============================================================

local function getCamera()
	camera = Workspace.CurrentCamera or camera
	return camera
end

local function waitForCurrentCamera(timeout)
	local deadline = os.clock() + timeout

	while isAlive() and os.clock() < deadline do
		local currentCamera = Workspace.CurrentCamera

		if currentCamera then
			camera = currentCamera
			return currentCamera
		end

		RunService.Heartbeat:Wait()
	end

	camera = Workspace.CurrentCamera or camera
	return camera
end

local function findLoadingCameraCFrameValue()
	local loadingSystem = getLoadingSystem()

	if loadingSystem then
		local value = loadingSystem:FindFirstChild(LOADING_CAMERA_CFRAME_NAME)

		if value and value:IsA("CFrameValue") then
			return value
		end
	end

	local directValue = ReplicatedFirst:FindFirstChild(LOADING_CAMERA_CFRAME_NAME)

	if directValue and directValue:IsA("CFrameValue") then
		return directValue
	end

	return nil
end

local function resolveLoadingCameraSource(timeout)
	local deadline = os.clock() + timeout

	while isAlive() and os.clock() < deadline do
		local cframeValue = findLoadingCameraCFrameValue()

		if cframeValue then
			return cframeValue, "ReplicatedFirst." .. LOADING_SYSTEM_NAME .. "." .. LOADING_CAMERA_CFRAME_NAME
		end

		local legacyPart = Workspace:FindFirstChild(LEGACY_VIEW_PART_NAME)

		if legacyPart and legacyPart:IsA("BasePart") then
			return legacyPart.CFrame, "Workspace." .. LEGACY_VIEW_PART_NAME .. " legacy fallback"
		end

		RunService.Heartbeat:Wait()
	end

	return nil, nil
end

local function readCameraCFrame(source)
	if typeof(source) == "CFrame" then
		return source
	end

	if source and source:IsA("CFrameValue") then
		return source.Value
	end

	return nil
end

local function lockCameraToCFrameSource(source)
	local cam = waitForCurrentCamera(CAMERA_WAIT_TIMEOUT)

	if not cam then
		warn("[LoadingScreen] CurrentCamera was unavailable; skipping loading camera lock.")
		return
	end

	pcall(function()
		RunService:UnbindFromRenderStep(LOCK_NAME)
	end)

	cam.CameraType = Enum.CameraType.Scriptable

	local initialCFrame = readCameraCFrame(source)

	if initialCFrame then
		cam.CFrame = initialCFrame
	end

	RunService:BindToRenderStep(LOCK_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		if not isAlive() then
			pcall(function()
				RunService:UnbindFromRenderStep(LOCK_NAME)
			end)

			return
		end

		local currentCamera = getCamera()

		if not currentCamera then
			return
		end

		currentCamera.CameraType = Enum.CameraType.Scriptable

		local currentCFrame = readCameraCFrame(source)

		if currentCFrame then
			currentCamera.CFrame = currentCFrame
		end
	end)
end

local function waitForCharacter(timeout)
	local deadline = os.clock() + timeout

	while isAlive() and os.clock() < deadline do
		if player.Character then
			return player.Character
		end

		RunService.Heartbeat:Wait()
	end

	return player.Character
end

local function forceRestoreCamera()
	pcall(function()
		RunService:UnbindFromRenderStep(LOCK_NAME)
	end)

	local cam = Workspace.CurrentCamera or camera

	if not cam then
		return
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid then
		cam.CameraSubject = humanoid
	end

	cam.CameraType = Enum.CameraType.Custom
end

local function unlockCameraToPlayer()
	pcall(function()
		RunService:UnbindFromRenderStep(LOCK_NAME)
	end)

	local cam = getCamera()

	if not cam then
		return
	end

	local character = waitForCharacter(8)

	if not character then
		cam.CameraType = Enum.CameraType.Custom
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)

	if not isAlive() then
		return
	end

	if not humanoid or not root then
		cam.CameraType = Enum.CameraType.Custom
		return
	end

	cam.CameraType = Enum.CameraType.Scriptable

	local offset = CFrame.new(0, 5, 12)
	local targetCF = root.CFrame:ToWorldSpace(offset)
	targetCF = CFrame.lookAt(targetCF.Position, root.Position + Vector3.new(0, 2, 0))

	tweenWait(
		cam,
		TweenInfo.new(SWOOP_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{ CFrame = targetCF },
		SWOOP_DURATION + 0.5,
		true
	)

	if not isAlive() then
		return
	end

	if transitionFrame and transitionFrame.Parent then
		tweenWait(
			transitionFrame,
			TweenInfo.new(BLACK_FADE_OUT_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 0 },
			BLACK_FADE_OUT_TIME + 0.3,
			true
		)
	end

	if not isAlive() then
		return
	end

	cam.CameraSubject = humanoid
	cam.CameraType = Enum.CameraType.Custom

	if transitionFrame and transitionFrame.Parent then
		tweenWait(
			transitionFrame,
			TweenInfo.new(BLACK_FADE_IN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 1 },
			BLACK_FADE_IN_TIME + 0.3,
			true
		)
	end
end

-- ============================================================
-- VISIBILITY MANAGER
-- ============================================================

local function isExternallyManaged(obj)
	local current = obj

	while current do
		if current:GetAttribute(EXTERNALLY_MANAGED_ATTRIBUTE) == true then
			return true
		end

		current = current.Parent
	end

	return false
end

local function containsExternallyManagedDescendant(obj)
	for _, descendant in ipairs(obj:GetDescendants()) do
		if descendant:GetAttribute(EXTERNALLY_MANAGED_ATTRIBUTE) == true then
			return true
		end
	end

	return false
end

local function hideGuiObject(obj)
	if hiddenGuiObjects[obj] == nil then
		hiddenGuiObjects[obj] = {
			Visible = obj.Visible,
		}
	end

	obj:SetAttribute(HIDDEN_BY_LOADING_ATTRIBUTE, hideToken)
	obj.Visible = false
end

local function scanAndHide(parent)
	if not parent or not loadingGui then
		return
	end

	for _, child in ipairs(parent:GetChildren()) do
		if child == loadingGui or child:IsDescendantOf(loadingGui) then
			continue
		end

		if child:IsA("GuiObject") then
			if isExternallyManaged(child) then
				continue
			end

			if containsExternallyManagedDescendant(child) then
				scanAndHide(child)
				continue
			end

			if child.Visible then
				hideGuiObject(child)
				continue
			end
		end

		if child:IsA("Folder") or child:IsA("ScreenGui") or child:IsA("GuiObject") then
			scanAndHide(child)
		end
	end
end

local function startHidingVisuals()
	scanAndHide(playerGui)

	trackConnection(playerGui.DescendantAdded:Connect(function(descendant)
		task.defer(function()
			if isAlive() and playerGui:GetAttribute("LoadingScreenActive") then
				local parent = descendant.Parent

				if parent then
					scanAndHide(parent)
				end
			end
		end)
	end))

	scanThread = task.spawn(function()
		while isAlive() and playerGui:GetAttribute("LoadingScreenActive") do
			scanAndHide(playerGui)
			task.wait(0.75)
		end
	end)
end

local function restoreVisuals()
	if scanThread then
		pcall(function()
			task.cancel(scanThread)
		end)

		scanThread = nil
	end

	for item, original in pairs(hiddenGuiObjects) do
		if item and item.Parent and item:GetAttribute(HIDDEN_BY_LOADING_ATTRIBUTE) == hideToken then
			item:SetAttribute(HIDDEN_BY_LOADING_ATTRIBUTE, nil)

			if not isExternallyManaged(item) then
				item.Visible = original.Visible
			end
		end
	end

	table.clear(hiddenGuiObjects)
end

-- ============================================================
