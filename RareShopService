-- RARE CONFIG
-- =========================
local CAR_WEIGHTS = {
	Maverick = 80,
	Javelin = 60,
	Stuttgart = 40,
	Velocity = 25,
	Sadie = 15,
	Vipera = 8,
	Camara = 4,
	Corvo = 1
}
local ALWAYS_STOCK   = {}

local RESTOCK_INTERVAL        = 7200
local PURCHASE_COOLDOWN       = 1.0
local MAX_STOCK               = 1
local MAX_INTERACTION_DISTANCE = 20

