function RankConfig.NormalizeCarName(name)
	return tostring(name or ""):lower():gsub("%s+", ""):gsub("%-", ""):gsub("_", ""):gsub("item$", "")
end

function RankConfig.GetRankValue(rankName)
	return RankConfig.Values[rankName] or 0
end

function RankConfig.PlayerMeetsRank(playerRank, requiredRank)
	return RankConfig.GetRankValue(playerRank) >= RankConfig.GetRankValue(requiredRank)
end

function RankConfig.GetTotalStorageForRank(rankName)
	local total = RankConfig.BaseStorageSlots
	for _, orderedRank in ipairs(RankConfig.Order) do
		local rank = RankConfig.Ranks[orderedRank]
		if rank and RankConfig.GetRankValue(orderedRank) <= RankConfig.GetRankValue(rankName) then
			total += rank.Benefits.ExtraStorage or 0
		end
	end
	return total
end

function RankConfig.GetBenefitsForRank(rankName)
	local benefits = {
		Multiplier = RankConfig.DefaultResourceMultiplier,
		WithdrawalLimit = RankConfig.DefaultWithdrawalLimit,
		StorageSlots = RankConfig.BaseStorageSlots,
		ShopAccess = nil,
		ChatTag = RankConfig.DefaultRankName,
	}

	for _, orderedRank in ipairs(RankConfig.Order) do
		local rank = RankConfig.Ranks[orderedRank]
		if rank and RankConfig.GetRankValue(orderedRank) <= RankConfig.GetRankValue(rankName) then
			benefits.Multiplier = rank.Benefits.Multiplier or benefits.Multiplier
			benefits.WithdrawalLimit = rank.Benefits.WithdrawalLimit or benefits.WithdrawalLimit
			benefits.ShopAccess = rank.Benefits.ShopAccess or benefits.ShopAccess
			benefits.ChatTag = rank.Benefits.ChatTag or benefits.ChatTag
		end
	end

	benefits.StorageSlots = RankConfig.GetTotalStorageForRank(rankName)
	return benefits
end

return RankConfig
