-- [[ SERVER SCRIPT: PlotHandler (Final Auto-Scale Edition) ]]
-- -- Indicating what the script is for: Updates Garage Owner text safely.
-- FEATURES: Auto-scales text for long names, infinite loading safety, preserves design.
-- UPDATE: Adds "( Vacant )" to the default sign text when no player owns it.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

-- ⚙️ CONFIGURATION
local TYCOONS_FOLDER = Workspace:WaitForChild("Tycoons")

-- Path Constants
local GARAGE_NAME = "NormalGarage"
local INFO_PART_NAME = "GarageInformation"
local GUI_NAME = "OwnerLabel"
local TEXT_LABEL_NAME = "Owner"

-- ---------------------------------------------------------
-- 📝 TEXT UPDATE LOGIC
-- ---------------------------------------------------------
local function applyText(textLabel, playerName)
	-- 1. LOCK DEFAULT TEXT (Safety)
	-- We save YOUR original text (e.g. "Garage 1", "For Sale") purely for memory.
	-- This ensures we always know what the sign said before anyone claimed it.
	if not textLabel:GetAttribute("DefaultText") then
		textLabel:SetAttribute("DefaultText", textLabel.Text)
	end

	-- 2. UPDATE CONTENT & FIX SCALING
	if playerName and playerName ~= "" then
		-- ✅ PLOT IS CLAIMED
		textLabel.Text = playerName .. "'s Garage"
		textLabel.TextScaled = true -- [FIX] Ensures long names shrink to fit instead of cutting off
	else
		-- ♻️ PLOT IS EMPTY (Restore Original Text + Add Vacant Status)
		local savedText = textLabel:GetAttribute("DefaultText") or "Garage"
		
		-- This adds the "( Vacant )" text you requested
		textLabel.Text = savedText .. " ( Vacant )"
		
		textLabel.TextScaled = true -- [FIX] Ensures default text fits too
	end
end

-- ---------------------------------------------------------
-- 🛡️ SETUP LOGIC (Threaded & Protected)
-- ---------------------------------------------------------
local function setupPlot(plot)
	-- Wrapped in spawn to prevent one plot lagging others
	task.spawn(function()
		
		-- 1. CRITICAL: Wait for the Owner Value (Optimized to 60s)
		-- If it takes longer than 60s, something is broken, so we stop waiting.
		local ownerValue = plot:WaitForChild("Owner", 60)
		if not ownerValue then 
			warn("⚠️ PlotHandler: Timed out waiting for 'Owner' value in " .. plot.Name)
			return 
		end

		-- 2. CRITICAL: Wait for the Visuals (Hierarchy)
		-- Uses timeouts to handle lag/streaming without breaking
		local function setupLabelsForLevel(levelFolder)
			if not levelFolder then return end

			-- Helper to find the GUI cleanly without spamming errors
			local function findGui()
				-- 1. Try if GarageInformation is a direct child of Level1/Level2
				local directInfo = levelFolder:FindFirstChild("GarageInformation")
				if directInfo then
					local gui = directInfo:FindFirstChild(GUI_NAME)
					if gui then return gui end
				end

				-- 2. Try the "GarageParts" nested path
				local garageParts = levelFolder:FindFirstChild("GarageParts")
				if garageParts then
					local parts = garageParts:FindFirstChild("Garage Parts")
					if parts then
						local gui = parts:FindFirstChild(GUI_NAME)
						if gui then return gui end
					end
				end

				-- 3. Fallback to classic NormalGarage
				local classicGarage = levelFolder:WaitForChild(GARAGE_NAME, 5)
				if classicGarage then
					local infoPart = classicGarage:WaitForChild(INFO_PART_NAME, 5)
					if infoPart then
						local gui = infoPart:WaitForChild(GUI_NAME, 5)
						if gui then return gui end
					end
				end

				return nil
			end

			local gui = findGui()
			if not gui then return end

			local textLabel = gui:WaitForChild(TEXT_LABEL_NAME, 5)
			if not textLabel then return end

			-- Connect logic
			applyText(textLabel, ownerValue.Value)

			ownerValue.Changed:Connect(function(newOwnerName)
				applyText(textLabel, newOwnerName)
			end)
		end

		local level1 = plot:WaitForChild("Level1", 60)
		if level1 then setupLabelsForLevel(level1) end

		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local dedicatedFolder = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")
		if dedicatedFolder then
			local plotStorage = dedicatedFolder:WaitForChild(plot.Name, 10)
			if plotStorage then
				local level2 = plotStorage:WaitForChild("Level2", 10)
				if level2 then setupLabelsForLevel(level2) end
			end
		end

		print("✅ Garage Monitor Active for: " .. plot.Name)
	end)
end

-- ---------------------------------------------------------
-- 🚀 INITIALIZATION
-- ---------------------------------------------------------
print("🛡️ PlotHandler V4: Auto-Scale Protection Enabled.")

-- 1. Apply to existing plots
for _, plot in ipairs(TYCOONS_FOLDER:GetChildren()) do
	setupPlot(plot)
end

-- 2. Apply to new plots dynamically
TYCOONS_FOLDER.ChildAdded:Connect(function(child)
	setupPlot(child)
end)
