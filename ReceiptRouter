local function getPurchaseHistoryStore()
	if ActivePurchaseHistory then return ActivePurchaseHistory end

	for _, name in ipairs(PURCHASE_HISTORY_NAMES) do
		local ok, store = pcall(function() return DataStoreService:GetDataStore(name) end)
		if ok and store then
			ActivePurchaseHistory = store
			return ActivePurchaseHistory
		end
	end
	return nil
end



local function isDeletedStoreError(err)
	err = string.lower(tostring(err or ""))
	return string.find(err, "data store is deleted", 1, true) ~= nil
end

local function wasPurchaseProcessed(purchaseKey)
	local store = getPurchaseHistoryStore()
	if not store then return nil end

	for attempt = 1, 3 do
		local success, result = pcall(function() return store:GetAsync(purchaseKey) end)
		if success then
			if result == true then
				return true, { State = "Granted" }
			end
			if type(result) == "table" then
				return result.State == "Granted", result
			end
			return false, nil
		end

		if isDeletedStoreError(result) then
			local fallbackOk, fallbackStore = pcall(function() return DataStoreService:GetDataStore("PurchaseHistory_V2") end)
			if fallbackOk and fallbackStore then
				ActivePurchaseHistory = fallbackStore
				store = ActivePurchaseHistory
			else
				return nil
			end
		else
			task.wait(0.25 * attempt)
		end
	end
	return nil
end

local function bindPurchaseTarget(purchaseKey, receiptInfo, targetUserId)
	local store = getPurchaseHistoryStore()
	if not store then return false end

	local boundRecord = nil
	local success = pcall(function()
		store:UpdateAsync(purchaseKey, function(current)
			boundRecord = nil
			if current == true then
				boundRecord = { State = "Granted", TargetUserId = targetUserId }
				return current
			end

			if type(current) == "table" then
				-- PurchaseId is globally unique. Once a receipt starts processing, keep
				-- its original recipient even if a client cancels/replaces a gift intent
				-- while a later DataStore or profile save is retrying.
				if current.TargetUserId == nil and current.State ~= "Granted" then
					current.TargetUserId = targetUserId
				end
				current.ProductId = current.ProductId or receiptInfo.ProductId
				current.PlayerId = current.PlayerId or receiptInfo.PlayerId
				boundRecord = current
				return current
			end

			boundRecord = {
				State = "Processing",
				PlayerId = receiptInfo.PlayerId,
				ProductId = receiptInfo.ProductId,
				TargetUserId = targetUserId,
				StartedAt = os.time(),
			}
			return boundRecord
		end)
	end)

	return success and type(boundRecord) == "table", boundRecord
end

local function markPurchaseProcessed(purchaseKey)
	local store = getPurchaseHistoryStore()
	if not store then return false end

	local success, err = pcall(function()
		store:UpdateAsync(purchaseKey, function(current)
			if current == true then return true end
			current = type(current) == "table" and current or {}
			current.State = "Granted"
			current.GrantedAt = os.time()
			return current
		end)
	end)

	if not success then return false end
	return true
end

