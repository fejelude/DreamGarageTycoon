local function grantCarPurchase(buyerPlayer, targetPlayer, isGift, productInfo, receiptInfo)
	local purchaseSuccess, grantMessage = giveCarTool(targetPlayer, productInfo.CarName, receiptInfo, isGift, buyerPlayer)
	if not purchaseSuccess then
		return false, grantMessage
	end

	return true, nil, {
		ProductId = receiptInfo.ProductId,
		CarName = productInfo.CarName,
		Rarity = productInfo.Rarity,
		FeedbackRemoteName = productInfo.FeedbackRemoteName,
		IsGift = isGift,
		BuyerPlayer = buyerPlayer,
		TargetPlayer = targetPlayer,
		AlreadyGranted = grantMessage == "Already granted",
	}
end

local function runCarPostCommit(postCommit)
	if not postCommit then return end

	local buyerPlayer = postCommit.BuyerPlayer
	local targetPlayer = postCommit.TargetPlayer
	local carName = postCommit.CarName
	local rarity = postCommit.Rarity
	local isGift = postCommit.IsGift == true

	recordRankRobuxGrant(buyerPlayer, targetPlayer, isGift, carName, rarity)

	local ShopRemotes = ReplicatedStorage:FindFirstChild("ShopRemotes")
	local feedbackRemote = ShopRemotes and postCommit.FeedbackRemoteName and ShopRemotes:FindFirstChild(postCommit.FeedbackRemoteName)

	if isGift then
		local buyerName = buyerPlayer.Name
		local targetName = targetPlayer.Name

		fireGiftPurchaseResult(buyerPlayer, {
			Success = true,
			ProductId = postCommit.ProductId,
			CarName = carName,
			Rarity = rarity,
			ReceiverName = targetName,
			ReceiverUserId = targetPlayer.UserId,
		})

		if feedbackRemote then
			task.delay(0.5, function()
				if buyerPlayer and buyerPlayer.Parent then
					feedbackRemote:FireClient(buyerPlayer, carName, true, targetName, buyerName)
				end
			end)
		end

		if GlobalChatBroadcast then
			GlobalChatBroadcast:FireAllClients({
				Type = "CarGift",
				SenderName = buyerName,
				ReceiverName = targetName,
				CarName = carName,
				Rarity = rarity
			})
		end
	else
		if feedbackRemote then
			feedbackRemote:FireClient(targetPlayer, carName, true)
		end
	end
end

