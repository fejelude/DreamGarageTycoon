	for _, productId in pairs(RebirthConfig.SkipProductIds) do
		if tonumber(productId) then REBIRTH_PRODUCT_IDS[tonumber(productId)] = true end
	end
end

-- Populate this version-controlled registry when Creator Dashboard products
-- are retired. Each entry should document its historical entitlement and be
-- paired with an explicit reconciliation branch before deployment.
local RETIRED_PRODUCTS = {}

local function validateProductRouteConfiguration()
	local owners = {}
	local function register(productId, owner)
		productId = math.floor(tonumber(productId) or 0)
		if productId <= 0 then return end
		if owners[productId] then
			error(string.format(
				"[ReceiptRouter] Developer Product %d is routed by both %s and %s",
				productId, owners[productId], owner
			), 0)
		end
		owners[productId] = owner
	end

	if GiftProductRegistry and type(GiftProductRegistry.GetAllProducts) == "function" then
		for productId, info in pairs(GiftProductRegistry.GetAllProducts()) do
			register(productId, "GiftProductRegistry:" .. tostring(info.Kind))
		end
	end
	register(TABLET_2X_ID, "Tablet2x")
	register(SHOP_REROLL_ID, "CommonShopReroll")
	register(UNCOMMON_SHOP_REROLL_ID, "UncommonShopReroll")
	register(RARE_SHOP_REROLL_ID, "RareShopReroll")
	register(EPIC_SHOP_REROLL_ID, "EpicShopReroll")
	register(LEGENDARY_SKIP_CRAFT_ID, "LegendaryCraftSkip")
	register(MYTHICAL_SKIP_CRAFT_ID, "MythicalCraftSkip")
	register(BANK_TRANSFER_SKIP_ID, "BankTransferReset")
	register(OFFLINE_10X_CLAIM_ID, "Offline10x")
	register(STARTER_PACK_PRODUCT_ID, "StarterPack")
	register(GlobalLuckConfig and GlobalLuckConfig.ProductId, "GlobalLuck")
	register(GlobalMoneyFrenzyConfig and GlobalMoneyFrenzyConfig.ProductId, "GlobalMoneyFrenzy")
	register(AdRewardsConfig and AdRewardsConfig.DEV_PRODUCT_ID, "RewardedAd")
	for productId in pairs(REBIRTH_PRODUCT_IDS) do register(productId, "RebirthSkip") end
	for productId, info in pairs(RETIRED_PRODUCTS) do
		register(productId, "Retired:" .. tostring(type(info) == "table" and info.Entitlement or info))
	end
end

validateProductRouteConfiguration()

-- Unknown and documented-retired receipts are durably quarantined below so
-- support has a recovery trail until an exact legacy handler is configured.
local quarantineStore = DataStoreService:GetDataStore("UnroutedDeveloperProductReceipts_V1")

local function adminInvoke(action, player, ...)
	local api = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if not api or not api:IsA("BindableFunction") then return false, nil, "TycoonAdminAPI unavailable" end
	local args = table.pack(...)
	local result = table.pack(pcall(function()
		return Coordinator.InvokeBindable(
			player,
			api,
			action,
			player,
			table.unpack(args, 1, args.n)
		)
	end))
	if not result[1] then return false, nil, result[2] end
	return true, table.unpack(result, 2, result.n)
end

local function profileReceiptState(player, purchaseId)
	local invokeOk, granted, message = adminInvoke("HasReceiptGrant", player, tostring(purchaseId))
	if not invokeOk or granted == nil then return nil, message end
	return granted == true
end

local function commitReceipt(player, receiptInfo, action, targetUserId, grantHash)
	local invokeOk, committed, message = adminInvoke(
		"CommitReceiptGrant", player, tostring(receiptInfo.PurchaseId), receiptInfo.ProductId,
		action, targetUserId or player.UserId, grantHash
	)
	return invokeOk and committed == true, message
end

local function invokeBindable(name, ...)
	local bindable = ServerStorage:FindFirstChild(name)
	if not bindable or not bindable:IsA("BindableFunction") then return false, "Handler unavailable" end
	local args = table.pack(...)
	local result = table.pack(pcall(function()
		return bindable:Invoke(table.unpack(args, 1, args.n))
	end))
	if not result[1] then return false, result[2] end
	return true, table.unpack(result, 2, result.n)
end

local function optionalRemote(folderName, remoteName)
	local folder = ReplicatedStorage:FindFirstChild(folderName)
	local remote = folder and folder:FindFirstChild(remoteName)
	return remote and remote:IsA("RemoteEvent") and remote or nil
end

local function fireGiftResult(buyer, payload)
	local remote = optionalRemote("GiftRemotes", "GiftPurchaseResult")
	if remote and buyer and buyer.Parent then remote:FireClient(buyer, payload) end
end

local function notifyGiftQueued(buyer, intent, productInfo)
	local serial = tonumber(buyer:GetAttribute("GiftPurchaseFeedbackSerial")) or 0
	fireGiftResult(buyer, {
		Success = true, ProductId = productInfo.ProductId,
		ReceiverName = intent.ReceiverName, ReceiverUserId = intent.ReceiverUserId,
		Message = "Gift delivery committed", FeedbackSerial = serial,
	})
end

local function quarantine(receiptInfo, reason)
	local key = tostring(receiptInfo.PlayerId) .. ":" .. tostring(receiptInfo.PurchaseId)
	local ok = pcall(function()
		quarantineStore:UpdateAsync(key, function(old)
			old = type(old) == "table" and old or {
				PlayerId = receiptInfo.PlayerId, ProductId = receiptInfo.ProductId,
				PurchaseId = tostring(receiptInfo.PurchaseId), FirstSeenAt = os.time(), Attempts = 0,
				FirstJobId = game.JobId, PlaceId = game.PlaceId,
			}
			old.Attempts = math.min(1000000, math.max(0, tonumber(old.Attempts) or 0) + 1)
			old.LastSeenAt = os.time(); old.Reason = tostring(reason or "Unrouted")
			old.LastJobId = game.JobId; old.PlaceId = game.PlaceId
			return old
		end)
	end)
	warn(string.format(
		"[ReceiptRouter] QUARANTINED buyer=%d product=%d purchase=%s reason=%s stored=%s",
		receiptInfo.PlayerId, receiptInfo.ProductId, tostring(receiptInfo.PurchaseId),
		tostring(reason), tostring(ok)
	))
	return PENDING
end

local function recordRankCar(player, carName, rarity, purchaseId)
	local api = ServerStorage:FindFirstChild("RankProgressAPI")
	if api and api:IsA("BindableFunction") then
		pcall(function() api:Invoke("CarObtained", player, carName, "Buy", rarity, tostring(purchaseId)) end)
	end
end

local function grantCar(player, receiptInfo, productInfo)
	local invokeOk, granted, message = adminInvoke("GiveTool", player, productInfo.CarName, {
		BypassStorageLimit = true,
		Source = "RobuxPurchase",
		ReceiptPurchaseId = tostring(receiptInfo.PurchaseId),
		ReceiptProductId = receiptInfo.ProductId,
	})
	if not invokeOk or granted ~= true then return false, message or granted end
	local already = message == "Already granted"
	if not already then recordRankCar(player, productInfo.CarName, productInfo.Rarity, receiptInfo.PurchaseId) end
	local saveInvokeOk, saved, saveMessage = adminInvoke("SaveNow", player)
	if not saveInvokeOk or saved ~= true then return false, saveMessage or "Car grant save failed" end
	if productInfo.FeedbackRemoteName then
		local remotes = ReplicatedStorage:FindFirstChild("ShopRemotes")
		local feedback = remotes and remotes:FindFirstChild(productInfo.FeedbackRemoteName)
		if feedback and feedback:IsA("RemoteEvent") then
			feedback:FireClient(player, productInfo.CarName)
		else
			warn("[ReceiptRouter] Missing optional car feedback remote " .. tostring(productInfo.FeedbackRemoteName))
		end
	end
	return true
end

local function routeGift(buyer, receiptInfo, productInfo)
	if not GiftIntentStore or not GiftDeliveryService then return nil, "Gift services unavailable" end
	local intentState, intent = GiftIntentStore.Get(buyer.UserId, receiptInfo.ProductId)
	if intentState == "TemporarilyUnavailable" then return nil, "Gift intent store unavailable" end
	if intentState ~= "Found" then
		-- Only an authoritative no-intent result permits a dual-use product to
		-- fall through to self-purchase. Invalid/expired state is ambiguous and
		-- must remain pending for reconciliation instead of changing recipient.
		if intentState ~= "ConfirmedNoIntent" then
			return nil, "Gift intent is " .. tostring(intentState)
		end
		if productInfo.Kind == "GamePassGift" then return nil, "Gift-only product has no intent" end
		return false -- ordinary self purchase
	end

	local bound, bindError = GiftIntentStore.BindReceipt(buyer.UserId, receiptInfo.ProductId, receiptInfo.PurchaseId)
	if not bound then return nil, bindError end
	if bound.ReceiverUserId == buyer.UserId then return nil, "Invalid self-targeted gift intent" end

	if productInfo.Kind == "LimitedCar" then
		local limitedService = getServerModule("LimitedCarsService")
		if not limitedService then return nil, "Limited car handler unavailable" end
		local finalized, finalMessage = limitedService.FinalizeQueuedGift(
			receiptInfo, bound.ReceiverUserId, bound.ReceiverName
		)
		if not finalized then return nil, finalMessage end
	end

	local queued, queueResult = GiftDeliveryService.Queue(bound, receiptInfo, productInfo)
	if not queued then return nil, queueResult end
	if productInfo.Kind == "Car" or productInfo.Kind == "LimitedCar" then
		local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
		if rankApi and rankApi:IsA("BindableFunction") then
			pcall(function()
				rankApi:Invoke(
					"CarGiftQueued", buyer, bound.ReceiverUserId, productInfo.CarName,
					tostring(receiptInfo.PurchaseId)
				)
			end)
		end
	end
	local committed, commitError = commitReceipt(
		buyer, receiptInfo, "GiftQueued", bound.ReceiverUserId,
		string.format(
			"Gift:%d:%s:%s", bound.ReceiverUserId,
			tostring(bound.ReceiverName), tostring(productInfo.Kind)
		)
	)
	if not committed then return nil, commitError end
	local archived = GiftIntentStore.Complete(
		buyer.UserId, receiptInfo.ProductId, receiptInfo.PurchaseId, "Queued"
	)
	if not archived then return nil, "Gift intent archival is unavailable" end

	local target = Players:GetPlayerByUserId(bound.ReceiverUserId)
	if target then task.defer(function() GiftDeliveryService.DeliverForPlayer(target) end) end
	notifyGiftQueued(buyer, bound, productInfo)
	return true
end

local function bindPaidAction(receiptInfo, expectedAction)
	if not PaidActionIntentStore then return nil, "Paid-action store unavailable" end
	return PaidActionIntentStore.BindReceipt(
		receiptInfo.PlayerId, receiptInfo.ProductId, receiptInfo.PurchaseId, expectedAction
	)
end

local function completePaidAction(receiptInfo)
	if not PaidActionIntentStore then return false end
	return PaidActionIntentStore.Complete(
		receiptInfo.PlayerId, receiptInfo.ProductId, receiptInfo.PurchaseId
	)
end

local function isPaidActionProduct(productId)
	return productId == OFFLINE_10X_CLAIM_ID
		or productId == TABLET_2X_ID
		or productId == LEGENDARY_SKIP_CRAFT_ID
		or productId == MYTHICAL_SKIP_CRAFT_ID
		or REBIRTH_PRODUCT_IDS[productId] == true
end

local function handleSelfPurchase(player, receiptInfo, productInfo)
	local productId = receiptInfo.ProductId

	local limitedInfo = LimitedCarsConfig and LimitedCarsConfig.GetProductByProductId(productId)
	if limitedInfo then
		local service = getServerModule("LimitedCarsService")
		if not service then return false, "Limited car handler unavailable" end
		local ok, message, already = service.ProcessReceipt(receiptInfo)
		service.NotifyClient(player, ok and not already, message)
		return ok, message
	end

	if GlobalLuckConfig and productId == GlobalLuckConfig.ProductId and productId > 0 then
		local service = getServerModule("GlobalLuckService")
		if not service then return false, "Global Luck handler unavailable" end
		local ok, message, already = service.ProcessReceipt(receiptInfo)
		if not ok then return false, message end
		local committed, commitError = commitReceipt(player, receiptInfo, "GlobalLuck", player.UserId, tostring(productId))
		if not committed then return false, commitError end
		service.NotifyClient(player, not already, message)
		return true
	end

	if GlobalMoneyFrenzyConfig and productId == GlobalMoneyFrenzyConfig.ProductId and productId > 0 then
		local service = getServerModule("GlobalMoneyFrenzyService")
		if not service then return false, "Money Frenzy handler unavailable" end
		local ok, message, already = service.ProcessReceipt(receiptInfo)
		if not ok then return false, message end
		local committed, commitError = commitReceipt(player, receiptInfo, "GlobalMoneyFrenzy", player.UserId, tostring(productId))
		if not committed then return false, commitError end
		service.NotifyClient(player, not already, message)
		return true
	end

	local cashPack = CashPackConfig and CashPackConfig.GetPackByProductId(productId)
	if cashPack then
		local invokeOk, granted, message = adminInvoke(
			"GrantWalletCashProduct", player, tostring(receiptInfo.PurchaseId), productId, cashPack.WalletReward
		)
		return invokeOk and granted == true, message
	end

	if AdRewardsConfig and AdRewardsConfig.IsConfigured() and productId == AdRewardsConfig.DEV_PRODUCT_ID then
		local invokeOk, granted, message = adminInvoke(
			"GrantWalletCashProduct", player, tostring(receiptInfo.PurchaseId), productId,
			AdRewardsConfig.WALLET_CASH_AMOUNT, "AdReward", false
		)
		if invokeOk and granted == true then
			-- TycoonDataHandler publishes a replicated receipt serial only after the
			-- matching value and receipt are durable, so early UI startup cannot lose it.
			return true
		end
		return false, message
	end

	if productId == BANK_TRANSFER_SKIP_ID then
		local oldUsed = player:GetAttribute("BankTransferLimitUsed")
		local oldReset = player:GetAttribute("BankTransferLimitResetAt")
		local oldCredits = player:GetAttribute("BankTransferSkipCredits")
		local used = math.max(0, math.floor(tonumber(oldUsed) or 0))
		local resetAt = math.max(0, math.floor(tonumber(oldReset) or 0))
		local grantHash
		if used > 0 and resetAt > os.time() then
			player:SetAttribute("BankTransferLimitUsed", 0)
			player:SetAttribute("BankTransferLimitResetAt", 0)
			grantHash = "reset"
		else
			local credits = math.max(0, math.floor(tonumber(oldCredits) or 0))
			player:SetAttribute("BankTransferSkipCredits", math.min(100, credits + 1))
			grantHash = "credit"
		end
		local committed, message = commitReceipt(player, receiptInfo, "BankTransferReset", player.UserId, grantHash)
		if not committed then
			player:SetAttribute("BankTransferLimitUsed", oldUsed)
			player:SetAttribute("BankTransferLimitResetAt", oldReset)
			player:SetAttribute("BankTransferSkipCredits", oldCredits)
			return false, message
		end
		local feedbackSerial = tonumber(player:GetAttribute("BankResetFeedbackSerial")) or 0
		local feedbackMessage = player:GetAttribute("BankResetFeedbackMessage") or "Timer Reset Successful"
		local feedback = ReplicatedStorage:FindFirstChild("BankTimerResetFeedback")
		if feedback and feedback:IsA("RemoteEvent") then
			feedback:FireClient(player, true, feedbackMessage, feedbackSerial)
		end
		return true
	end

	if productId == OFFLINE_10X_CLAIM_ID then
		local intent, intentError = bindPaidAction(receiptInfo, "Offline10x")
		if not intent or not PaidActionFulfillmentService then return false, intentError or "Offline action unavailable" end
		local ok, amountOrError = PaidActionFulfillmentService.GrantOffline10x(player, receiptInfo, intent)
		if not ok then return false, amountOrError end
		if not completePaidAction(receiptInfo) then return false, "Paid-action completion is unavailable" end
		local resultEvent = optionalRemote("OfflineEarningsRemotes", "OfflinePremiumClaimResult")
		if resultEvent then resultEvent:FireClient(player, true, "Claimed", amountOrError) end
		return true
	end

	if productId == TABLET_2X_ID then
		local intent, intentError = bindPaidAction(receiptInfo, "Tablet2x")
		if not intent or not PaidActionFulfillmentService then return false, intentError or "Tablet action unavailable" end
		local ok, amountOrError = PaidActionFulfillmentService.GrantTablet2x(player, receiptInfo, intent)
		if not ok then return false, amountOrError end
		if not completePaidAction(receiptInfo) then return false, "Paid-action completion is unavailable" end
		local tabletEvent = ReplicatedStorage:FindFirstChild("TabletEvent")
		if tabletEvent and tabletEvent:IsA("RemoteEvent") then
			tabletEvent:FireClient(
				player, "PaidClaimResult", intent.Payload.PlotName, true, amountOrError,
				tonumber(player:GetAttribute("TabletPaidReceiptSerial")) or 0
			)
		end
		return true
	end

	if REBIRTH_PRODUCT_IDS[productId] then
		local intent, intentError = bindPaidAction(receiptInfo, "RebirthSkip")
		if not intent or not PaidActionFulfillmentService then return false, intentError or "Rebirth action unavailable" end
		local ok, result = PaidActionFulfillmentService.GrantRebirthSkip(player, receiptInfo, intent)
		if not ok then return false, result end
		if not completePaidAction(receiptInfo) then return false, "Paid-action completion is unavailable" end
		local refresh = optionalRemote("RebirthRemotes", "RefreshRebirthUI")
		if refresh then refresh:FireClient(player, "Success", result) end
		return true
	end

	if productId == STARTER_PACK_PRODUCT_ID then
		local invokeOk, granted, message = adminInvoke(
			"GrantStarterPack", player, tostring(receiptInfo.PurchaseId),
			STARTER_PACK_CAR_NAME, STARTER_PACK_WALLET_CASH
		)
		return invokeOk and granted == true, message
	end

	local rerollBindable = REROLL_BINDABLES[productId]
	if rerollBindable then
		local invokeOk, rerolled, message = invokeBindable(
			rerollBindable, player, tostring(receiptInfo.PurchaseId)
		)
		if not invokeOk or rerolled ~= true then return false, message or rerolled end
		return commitReceipt(player, receiptInfo, "ShopReroll", player.UserId, rerollBindable)
	end

	if productId == LEGENDARY_SKIP_CRAFT_ID or productId == MYTHICAL_SKIP_CRAFT_ID then
		local expectedAction = productId == LEGENDARY_SKIP_CRAFT_ID and "LegendaryCraftSkip" or "MythicalCraftSkip"
		local intent, intentError = bindPaidAction(receiptInfo, expectedAction)
		if not intent then return false, intentError end
		local folder = ReplicatedStorage:FindFirstChild("BindableFunctions")
		local functionName = productId == LEGENDARY_SKIP_CRAFT_ID and "SkipLegendaryCraftFunction" or "SkipMythicalCraftFunction"
		local handler = folder and folder:FindFirstChild(functionName)
		if not handler or not handler:IsA("BindableFunction") then return false, "Craft skip handler unavailable" end
		local ok, granted, message = pcall(function()
			return Coordinator.InvokeBindable(
				player,
				handler,
				player,
				tostring(receiptInfo.PurchaseId),
				intent
			)
		end)
		if not ok or granted ~= true then return false, message or granted end
		if not completePaidAction(receiptInfo) then return false, "Paid-action completion is unavailable" end
		return true
	end

	if productInfo and productInfo.Kind == "Car" then
		return grantCar(player, receiptInfo, productInfo)
	end

	if productInfo and productInfo.Kind == "BaseAppearance" then
		local invokeOk, granted, message = adminInvoke(
			"GrantBaseAppearanceProduct", player, tostring(receiptInfo.PurchaseId),
			productId, productInfo.Level, productInfo.SkinId, "RobuxBaseAppearance"
		)
		return invokeOk and granted == true, message
	end

	if productInfo and productInfo.Kind == "BaseSkin" then
		local invokeOk, granted, message = adminInvoke(
			"GrantLegacyBaseSkinProduct", player, tostring(receiptInfo.PurchaseId),
			productId, productInfo.SkinName, "RobuxBaseSkin"
		)
		return invokeOk and granted == true, message
	end

	if productInfo and productInfo.Kind == "GamePassGift" then
		return false, "Gift-only product requires a bound recipient"
	end

	return nil, RETIRED_PRODUCTS[productId] and "Retired product" or "Unknown product"
end

local function routeUnderTransaction(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player or player:GetAttribute("TycoonDataLoaded") ~= true
		or player:GetAttribute("TycoonDataPhase") ~= "Ready"
	then return PENDING end

	local productInfo = GiftProductRegistry and GiftProductRegistry.GetByProductId(receiptInfo.ProductId) or nil
	local receiptState = profileReceiptState(player, receiptInfo.PurchaseId)
	if receiptState == nil then return PENDING end
	if receiptState == true then
		-- The car/profile save can succeed just before the limited-stock receipt
		-- is marked Granted. Repair that second ledger before acknowledging the
		-- retry so Processing records and their announcement are not stranded.
		local limitedInfo = LimitedCarsConfig
			and LimitedCarsConfig.GetProductByProductId(receiptInfo.ProductId)
		if limitedInfo then
			local service = getServerModule("LimitedCarsService")
			if not service then return PENDING end
			local reconciled, message, already = service.ProcessReceipt(receiptInfo)
			if not reconciled then return PENDING end
			if not already then service.NotifyClient(player, true, message) end
		end
		-- The value and profile receipt may have committed just before an intent
		-- archival outage. Reconcile that metadata before acknowledging the retry,
		-- otherwise a stale Bound intent could block every future purchase.
		if isPaidActionProduct(receiptInfo.ProductId) then
			if not completePaidAction(receiptInfo) then return PENDING end
		end
		if productInfo and productInfo.Giftable == true and GiftIntentStore then
			local archived = GiftIntentStore.Complete(
				player.UserId, receiptInfo.ProductId, receiptInfo.PurchaseId, "Queued"
			)
			if not archived then return PENDING end
		end
		return GRANTED
	end

	if productInfo and productInfo.Giftable == true then
		local gifted, giftError = routeGift(player, receiptInfo, productInfo)
		if gifted == true then return GRANTED end
		if gifted == nil then
			warn("[ReceiptRouter] Gift receipt pending: " .. tostring(giftError))
			return PENDING
		end
	end

	local handled, handleError = handleSelfPurchase(player, receiptInfo, productInfo)
	if handled == true then return GRANTED end
	if handled == nil then return quarantine(receiptInfo, handleError) end
	if handleError then
		warn(string.format(
			"[ReceiptRouter] Receipt pending buyer=%d product=%d purchase=%s: %s",
			receiptInfo.PlayerId, receiptInfo.ProductId, tostring(receiptInfo.PurchaseId), tostring(handleError)
		))
	end
	return PENDING
end

routeReceipt = function(receiptInfo)
	if type(receiptInfo) ~= "table" or tonumber(receiptInfo.PlayerId) == nil
		or tonumber(receiptInfo.ProductId) == nil or receiptInfo.PurchaseId == nil
	then return PENDING end
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player or not Coordinator then return PENDING end
	local decision = Coordinator.Run(player, "ProcessReceipt", function()
		return routeUnderTransaction(receiptInfo)
	end, 20)
	return decision == GRANTED and GRANTED or PENDING
end

-- Starter Pack UI ownership remains a projection of the main profile flag.
local starterFolder = ReplicatedStorage:FindFirstChild("StarterPackRemotes")
local checkOwned = starterFolder and starterFolder:FindFirstChild("CheckOwned")
if checkOwned and checkOwned:IsA("RemoteFunction") then
	checkOwned.OnServerInvoke = function(player)
		local invokeOk, granted = adminInvoke("HasStarterPackGrant", player)
		return invokeOk and granted or nil
	end
end
