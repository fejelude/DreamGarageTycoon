-- Purpose: Single, replay-safe MarketplaceService.ProcessReceipt dispatcher.
-- Profile entitlements and their PurchaseId are saved together; gifts first
-- commit an immutable offline delivery; paid actions bind an exact intent.
-- Runs on: Server
-- Location: ServerScriptService > ReceiptRouter

local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local GRANTED = Enum.ProductPurchaseDecision.PurchaseGranted
local PENDING = Enum.ProductPurchaseDecision.NotProcessedYet

-- Register immediately. Module/config initialization below cannot leave Roblox
-- without a receipt callback; unavailable product handlers simply retry later.
local routeReceipt = nil
local activeReceiptLocks = {}
MarketplaceService.ProcessReceipt = function(receiptInfo)
	local lockKey = tostring(receiptInfo.PlayerId) .. ":" .. tostring(receiptInfo.PurchaseId)
	if activeReceiptLocks[lockKey] then return PENDING end
	activeReceiptLocks[lockKey] = true
	local result = table.pack(xpcall(function()
		if not routeReceipt then return PENDING end
		return routeReceipt(receiptInfo)
	end, debug.traceback))
	activeReceiptLocks[lockKey] = nil
	if not result[1] then
		warn(string.format(
			"[ReceiptRouter] Handler exception buyer=%s product=%s purchase=%s: %s",
			tostring(receiptInfo.PlayerId), tostring(receiptInfo.ProductId),
			tostring(receiptInfo.PurchaseId), tostring(result[2])
		))
		return PENDING
	end
	return result[2] == GRANTED and GRANTED or PENDING
end

local function requireReplicated(name)
	local module = ReplicatedStorage:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		warn("[ReceiptRouter] Missing ReplicatedStorage > " .. name .. " ModuleScript")
		return nil
	end
	local ok, value = pcall(require, module)
	if not ok then warn("[ReceiptRouter] Failed to require " .. name .. ": " .. tostring(value)); return nil end
	return value
end

local serverModuleCache = {}
local function getServerModule(name)
	if serverModuleCache[name] ~= nil then return serverModuleCache[name] or nil end
	local module = ServerScriptService:FindFirstChild(name)
	if not module or not module:IsA("ModuleScript") then
		serverModuleCache[name] = false
		return nil
	end
	local ok, value = pcall(require, module)
	if not ok then
		warn("[ReceiptRouter] Failed to load handler " .. name .. ": " .. tostring(value))
		return nil
	end
	serverModuleCache[name] = value
	return value
end

