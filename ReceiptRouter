-- 🚗 HELPER: Give a car tool immediately upon purchase
-- ============================================================================
local function giveCarTool(targetPlayer, carName, receiptInfo, isGift, buyerPlayer)
	local CarTools = ServerStorage:FindFirstChild("CarTools")
	local tool = CarTools and (CarTools:FindFirstChild(carName, true) or CarTools:FindFirstChild(carName .. " Item", true))
	if not tool then
		warn("⚠️ Car Tool missing from ServerStorage: " .. carName)
		return false
	end

	local TycoonAdminAPI = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if not TycoonAdminAPI then
		warn("⚠️ TycoonAdminAPI missing!")
		return false
	end

	local attributes = {
		IssuedByServer = true,
		IssuedAt = os.time(),
		ToolId = tool.Name,
		BypassStorageLimit = true,
		Source = isGift and "RobuxGift" or "RobuxPurchase",
		ReceiptPurchaseId = receiptInfo.PurchaseId,
		ReceiptProductId = receiptInfo.ProductId,
	}

	if isGift and buyerPlayer then
		attributes.GiftSenderUserId = buyerPlayer.UserId
		attributes.GiftReceiverUserId = targetPlayer.UserId
	end

	local invokeOk, giveResult, giveMessage = safeInvoke(TycoonAdminAPI, 5, "GiveTool", targetPlayer, tool.Name, attributes)
	if not invokeOk or giveResult ~= true then
		return false, giveMessage or giveResult or "GiveTool failed"
	end

	local saveOk, saveMessage = savePlayerNow(targetPlayer, 12)
	if not saveOk then
		warn("Robux car save failed for " .. targetPlayer.Name .. ": " .. tostring(saveMessage))
		return false, "Save failed"
	end

	return true, giveMessage == "Already granted" and "Already granted" or nil
end

local function grantStarterPackRewards(player, purchaseId)
	local TycoonAdminAPI = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if not TycoonAdminAPI then
		warn("⚠️ Starter Pack grant failed: TycoonAdminAPI missing!")
		return false
	end

	local invokeOk, grantOk, grantMsg = safeInvoke(
		TycoonAdminAPI,
		20,
		"GrantStarterPack",
		player,
		purchaseId,
		STARTER_PACK_CAR_NAME,
		STARTER_PACK_WALLET_CASH
	)

	if not invokeOk or grantOk ~= true then
		warn("⚠️ Starter Pack grant failed for " .. player.Name .. ": " .. tostring(grantMsg or grantOk))
		return false
	end

	return true
end

local function hasStarterPackDataGrant(player)
	local TycoonAdminAPI = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if not TycoonAdminAPI then
		return nil
	end

	local invokeOk, isGranted = safeInvoke(TycoonAdminAPI, 3, "HasStarterPackGrant", player)
	if not invokeOk then
		return nil
	end

	if isGranted == nil then
		return nil
	end

	return isGranted == true
end

local function recordRankRobuxGrant(buyerPlayer, targetPlayer, isGift, carName, rarity)
	local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
	if not rankApi then return end

	if isGift then
		pcall(function()
			rankApi:Invoke("CarGiftSent", buyerPlayer, targetPlayer, carName)
		end)
	else
		pcall(function()
			rankApi:Invoke("CarObtained", targetPlayer, carName, "Buy", rarity)
		end)
	end
end

