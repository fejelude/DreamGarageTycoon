-- ============================================================================
-- 🧾 MAIN RECEIPT PROCESSOR
-- ============================================================================
local function processReceipt(receiptInfo)
	local buyerId = receiptInfo.PlayerId
	local buyerPlayer = Players:GetPlayerByUserId(buyerId)

	if not buyerPlayer then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local pid = receiptInfo.ProductId
	local carProductInfo = CAR_PRODUCT_INFO[pid]
	local appearanceFound = BaseAppearanceConfig.GetByProductId(pid)
	local skinFound = nil
	if BaseSkinStats then
		for name, data in pairs(BaseSkinStats) do
			if data.ProductId == pid then
				skinFound = name
				break
			end
		end
	end

	local registeredGiftProduct = GiftProductRegistry.GetByProductId(pid)
	local isGiftableProduct = registeredGiftProduct ~= nil and registeredGiftProduct.Giftable == true
	local targetPlayer = buyerPlayer
	local isGift = false
	local giftReceiverId = nil
	local consumeStaleGiftIntentAfterGrant = false
	local giftFallbackMessage = nil
	local giftIntentStatus = nil

	local purchaseKey = buyerId .. "_" .. receiptInfo.PurchaseId
	if activeReceiptLocks[purchaseKey] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local receiptLock = {}
	activeReceiptLocks[purchaseKey] = receiptLock
	local function finish(decision)
		if activeReceiptLocks[purchaseKey] == receiptLock then activeReceiptLocks[purchaseKey] = nil end
		return decision
	end

	local alreadyProcessed, purchaseRecord = wasPurchaseProcessed(purchaseKey)

	if alreadyProcessed == nil then
		return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
	end

	if alreadyProcessed then
		return finish(Enum.ProductPurchaseDecision.PurchaseGranted)
	end

	local function useBoundTarget(targetUserId)
		targetUserId = math.floor(tonumber(targetUserId) or 0)
		if targetUserId <= 0 then return false end
		if targetUserId ~= buyerId and not isGiftableProduct then
			warn("[ReceiptRouter] Refusing non-gift receipt with a different bound target: " .. purchaseKey)
			return false
		end

		local boundPlayer = Players:GetPlayerByUserId(targetUserId)
		if not boundPlayer then return false end
		targetPlayer = boundPlayer
		isGift = targetUserId ~= buyerId
		giftReceiverId = isGift and targetUserId or nil
		return true
	end

	local boundTargetUserId = type(purchaseRecord) == "table" and tonumber(purchaseRecord.TargetUserId) or nil
	if boundTargetUserId then
		if purchaseRecord.ProductId and tonumber(purchaseRecord.ProductId) ~= tonumber(pid) then
			warn("[ReceiptRouter] PurchaseId/ProductId mismatch for " .. purchaseKey)
			return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
		end
		if not useBoundTarget(boundTargetUserId) then
			-- The original recipient may simply be in another server/offline. Never
			-- redirect an already-started paid grant to whoever a later client names.
			return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
		end
	else
		if isGiftableProduct and _G.GetGiftIntent then
			local giftIntent = nil
			giftIntent, giftIntentStatus = _G.GetGiftIntent(buyerId, pid, false)
			if giftIntent then
				giftReceiverId = giftIntent.ReceiverUserId
				local receiver = Players:GetPlayerByUserId(giftReceiverId)
				if receiver and receiver ~= buyerPlayer then
					targetPlayer = receiver
					isGift = true
				else
					-- Never redirect a paid gift to the purchaser. Holding the receipt lets
					-- Roblox retry safely when the original recipient rejoins.
					return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
				end
			elseif giftIntentStatus == "ProductMismatch" then
				consumeStaleGiftIntentAfterGrant = true
			end
		elseif not isGiftableProduct and _G.GetGiftReceiver then
			giftReceiverId = _G.GetGiftReceiver(buyerId, false)
			consumeStaleGiftIntentAfterGrant = giftReceiverId ~= nil
		end

		-- Gift-only products must retain their original server intent. A missing
		-- intent is not permission to bind the paid receipt back to its purchaser.
		if registeredGiftProduct and registeredGiftProduct.Kind == "GamePassGift" and not isGift then
			return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
		end

		local boundOk, newRecord = bindPurchaseTarget(purchaseKey, receiptInfo, targetPlayer.UserId)
		if not boundOk or type(newRecord) ~= "table" then
			return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
		end
		if newRecord.State == "Granted" then
			return finish(Enum.ProductPurchaseDecision.PurchaseGranted)
		end
		if newRecord.ProductId and tonumber(newRecord.ProductId) ~= tonumber(pid) then
			warn("[ReceiptRouter] Purchase target bind found a product mismatch for " .. purchaseKey)
			return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
		end
		if tonumber(newRecord.TargetUserId) ~= targetPlayer.UserId
			and not useBoundTarget(newRecord.TargetUserId)
		then
			return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
		end
	end

	local limitedCarProductInfo = LimitedCarsConfig.GetProductByProductId(pid)
	if limitedCarProductInfo and limitedCarProductInfo.ProductId > 0 then
		local ok, message, alreadyGranted = LimitedCarsService.ProcessReceipt(receiptInfo, isGift and targetPlayer or nil)
		if not alreadyGranted then LimitedCarsService.NotifyClient(buyerPlayer, ok, message) end
		if ok then
			if not saveRankReceiptGrant(buyerPlayer, targetPlayer, isGift, limitedCarProductInfo.CarId, limitedCarProductInfo.Rarity or "Legendary", receiptInfo.PurchaseId) then
				return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
			end
			if not markPurchaseProcessed(purchaseKey) then
				return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
			end
			if isGift then
				NotifyGiftReceived:FireClient(targetPlayer, buyerPlayer.Name, limitedCarProductInfo.DisplayName)
				if _G.ClearGiftIntent then _G.ClearGiftIntent(buyerId, pid) end
			end
			fireConfirmedPurchaseResult(buyerPlayer, receiptInfo, isGift, targetPlayer, limitedCarProductInfo.DisplayName)
			return finish(Enum.ProductPurchaseDecision.PurchaseGranted)
		end
		return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
	end

	local inventorySlotProduct = InventorySlotsConfig.GetByProductId(pid)
	if inventorySlotProduct then
		local admin = ServerStorage:FindFirstChild("TycoonAdminAPI")
		if not admin then return finish(Enum.ProductPurchaseDecision.NotProcessedYet) end
		local invokeOk, grantOk = safeInvoke(admin, 20, "AddInventorySlots", targetPlayer,
			inventorySlotProduct.Slots, receiptInfo.PurchaseId, pid)
		if not invokeOk or grantOk ~= true then return finish(Enum.ProductPurchaseDecision.NotProcessedYet) end
		if not markPurchaseProcessed(purchaseKey) then return finish(Enum.ProductPurchaseDecision.NotProcessedYet) end
		if isGift then
			NotifyGiftReceived:FireClient(targetPlayer, buyerPlayer.Name, inventorySlotProduct.DisplayName)
			if _G.ClearGiftIntent then _G.ClearGiftIntent(buyerId, pid) end
		end
		fireConfirmedPurchaseResult(buyerPlayer, receiptInfo, isGift, targetPlayer, inventorySlotProduct.DisplayName)
		return finish(Enum.ProductPurchaseDecision.PurchaseGranted)
	end

	local fhiaTokenAmount = LuckySpinConfig.ProductTokens[pid]
	if fhiaTokenAmount then
		-- Token products are self-only. The profile API records the receipt id and
		-- token delta in one forced profile save before Roblox is acknowledged.
		targetPlayer = buyerPlayer
		isGift = false
		local admin = ServerStorage:FindFirstChild("TycoonAdminAPI")
		if not admin then return finish(Enum.ProductPurchaseDecision.NotProcessedYet) end
		local invokeOk, grantOk = safeInvoke(admin, 20, "GrantFhiaTokensProduct", buyerPlayer,
			receiptInfo.PurchaseId, pid, fhiaTokenAmount)
		if not invokeOk or grantOk ~= true then return finish(Enum.ProductPurchaseDecision.NotProcessedYet) end
		if not markPurchaseProcessed(purchaseKey) then return finish(Enum.ProductPurchaseDecision.NotProcessedYet) end
		fireGiftPurchaseResult(buyerPlayer, {
			Success = true,
			ProductId = pid,
			Message = ("Successfully purchased %d Fhia Token%s!"):format(fhiaTokenAmount, fhiaTokenAmount == 1 and "" or "s"),
		})
		return finish(Enum.ProductPurchaseDecision.PurchaseGranted)
	end

	if pid == GlobalLuckConfig.ProductId and GlobalLuckConfig.ProductId > 0 then
		local ok, message, alreadyGranted = GlobalLuckService.ProcessReceipt(receiptInfo)
		if not alreadyGranted then GlobalLuckService.NotifyClient(buyerPlayer, ok, message) end
		if ok then
			if not markPurchaseProcessed(purchaseKey) then
				return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
			end
			fireConfirmedPurchaseResult(buyerPlayer, receiptInfo, false, buyerPlayer)
			return finish(Enum.ProductPurchaseDecision.PurchaseGranted)
		end
		return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
	end

	if pid == GlobalMoneyFrenzyConfig.ProductId and GlobalMoneyFrenzyConfig.ProductId > 0 then
		local ok, message, alreadyGranted = GlobalMoneyFrenzyService.ProcessReceipt(receiptInfo)
		if not alreadyGranted then GlobalMoneyFrenzyService.NotifyClient(buyerPlayer, ok, message) end
		if ok then
			if not markPurchaseProcessed(purchaseKey) then
				return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
			end
			fireConfirmedPurchaseResult(buyerPlayer, receiptInfo, false, buyerPlayer)
			return finish(Enum.ProductPurchaseDecision.PurchaseGranted)
		end
		return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
	end

	local purchaseSuccess = false
	local suppressConfirmedSuccess = false
	local profileReceiptAction = getProfileReceiptAction(pid, appearanceFound, skinFound)
	local profileGrantHash = tostring(pid)
	if profileReceiptAction then
		local profileGranted, receiptData = hasProfileReceiptGrant(targetPlayer, receiptInfo.PurchaseId)
		if profileGranted == nil then
			return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
		elseif profileGranted == true then
			if not markPurchaseProcessed(purchaseKey) then
				return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
			end
			if profileReceiptAction == "OfflineEarnings10x" then
				local folder = ReplicatedStorage:FindFirstChild("OfflineEarningsRemotes")
				local resultEvent = folder and folder:FindFirstChild("OfflinePremiumClaimResult")
				if resultEvent then resultEvent:FireClient(buyerPlayer, true, "Claimed", tonumber(receiptData and receiptData.GrantHash) or 0) end
			elseif profileReceiptAction == "BankTransferReset" and BankTimerResetFeedback then
				BankTimerResetFeedback:FireClient(buyerPlayer, true, "Timer Reset Successful")
			elseif profileReceiptAction == "RewardedAdCash" then
				local receiptGranted = ServerStorage:FindFirstChild("AdRewardReceiptGranted")
				if receiptGranted then receiptGranted:Fire(buyerPlayer, AdRewardsConfig.SUCCESS_REWARD_NAME, AdRewardsConfig.SUCCESS_REWARD_COLOR) end
			end
			fireConfirmedPurchaseResult(buyerPlayer, receiptInfo, isGift, targetPlayer)
			return finish(Enum.ProductPurchaseDecision.PurchaseGranted)
		end
	end
	local cashPackInfo = CashPackConfig.GetPackByProductId(pid)
	local bankResetFeedback = nil
	local offlinePremiumClientResult = nil
	local adRewardClientResult = nil
	local carPostCommit = nil

	-- ─── REWARDED VIDEO AD ────────────────────────────────────────────────────
	if cashPackInfo then
		-- Cash Packs are repeatable developer products that grant Wallet cash only.
		-- They use the universal gift target only when explicitly registered as giftable.
		if not isGift then
			targetPlayer = buyerPlayer
			consumeStaleGiftIntentAfterGrant = giftReceiverId ~= nil
		end

		purchaseSuccess = grantCashPackWalletReward(targetPlayer, receiptInfo, cashPackInfo)
		if purchaseSuccess and isGift then
			NotifyGiftReceived:FireClient(targetPlayer, buyerPlayer.Name, registeredGiftProduct.DisplayName or "Wallet Cash")
			if GlobalChatBroadcast then
				GlobalChatBroadcast:FireAllClients({ Type = "System", Message = ("🎁 <b><font color='#55CFFF'>%s</font></b> gifted <b><font color='#FF69B4'>%s</font></b> <b><font color='#FFD700'>%s</font></b>! 💸"):format(buyerPlayer.Name, targetPlayer.Name, registeredGiftProduct.DisplayName) })
			end
		end

	elseif registeredGiftProduct and registeredGiftProduct.Kind == "GamePassGift" then
		if not isGift then
			-- Gift-only developer products are never awarded to their purchaser.
			return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
		end
		local grantOk, grantMessage, wasNew = GiftEntitlementService.Grant(targetPlayer, registeredGiftProduct.PassKey, receiptInfo)
		purchaseSuccess = grantOk
		if grantOk then
			local displayName = registeredGiftProduct.DisplayName
			NotifyGiftReceived:FireClient(targetPlayer, buyerPlayer.Name, displayName)
			if not wasNew then
				suppressConfirmedSuccess = true
				fireGiftPurchaseResult(buyerPlayer, { Success = false, ProductId = pid, Message = targetPlayer.Name .. " already owns this perk." })
			end
			if wasNew and GlobalChatBroadcast then
				GlobalChatBroadcast:FireAllClients({ Type = "System", Message = ("🎁 <b><font color='#55CFFF'>%s</font></b> gifted <b><font color='#FF69B4'>%s</font></b> the <b><font color='#FFD700'>%s</font></b>! ✨"):format(buyerPlayer.Name, targetPlayer.Name, displayName) })
			end
		else
			warn("[ReceiptRouter] Perk gift grant failed:", grantMessage)
		end

	elseif AdRewardsConfig.IsConfigured() and pid == AdRewardsConfig.DEV_PRODUCT_ID then
		-- Rewarded ads are never giftable. Roblox requires the disclosed ad reward
		-- to be a non-random developer product, so this grants fixed Wallet Cash.
		isGift = false
		targetPlayer = buyerPlayer
		consumeStaleGiftIntentAfterGrant = giftReceiverId ~= nil

		local leaderstats = buyerPlayer:FindFirstChild("leaderstats")
		local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")
		if wallet then
			wallet.Value += AdRewardsConfig.WALLET_CASH_AMOUNT
			profileGrantHash = tostring(AdRewardsConfig.WALLET_CASH_AMOUNT)
			purchaseSuccess = true
			adRewardClientResult = {
				rewardName = AdRewardsConfig.SUCCESS_REWARD_NAME,
				rewardColor = AdRewardsConfig.SUCCESS_REWARD_COLOR,
			}
		end

	-- ─── BANK TRANSFER LIMIT SKIP ─────────────────────────────────────────────
	elseif pid == BANK_TRANSFER_SKIP_ID then
		-- This product should never be gifted. If a gift target was pending,
		-- consume it only after the receipt is successfully granted/persisted.
		isGift = false
		targetPlayer = buyerPlayer
		consumeStaleGiftIntentAfterGrant = giftReceiverId ~= nil

		-- The product is no longer offered, but historical/pending receipts must be
		-- acknowledged so Roblox does not retry them forever. No currency or limit
		-- state is changed.
		purchaseSuccess = true
		bankResetFeedback = {
			success = true,
			message = "Banking is retired; no transfer timer is required.",
		}

	elseif pid == OFFLINE_10X_CLAIM_ID then
		isGift = false
		targetPlayer = buyerPlayer
		consumeStaleGiftIntentAfterGrant = giftReceiverId ~= nil

		if _G.OfflineEarningsService and _G.OfflineEarningsService.TryGrantPremium then
			local ok, payout, msg = _G.OfflineEarningsService.TryGrantPremium(buyerPlayer, receiptInfo.PurchaseId)
			purchaseSuccess = ok
			if ok then profileGrantHash = tostring(payout) end
			offlinePremiumClientResult = {
				success = ok,
				message = ok and "Claimed" or (msg or "You have already claimed your offline earnings."),
				amount = ok and payout or 0,
			}
		end

	elseif pid == STARTER_PACK_PRODUCT_ID then
		isGift = false
		targetPlayer = buyerPlayer
		consumeStaleGiftIntentAfterGrant = giftReceiverId ~= nil

		-- Single source of truth: ownership is stored by TycoonDataHandler in the
		-- player's main data record. Always route the receipt through GrantStarterPack
		-- so retries force-save the receipt id without granting duplicate rewards.
		purchaseSuccess = grantStarterPackRewards(buyerPlayer, receiptInfo.PurchaseId)

		-- ─── REBIRTH SKIP PRODUCTS ────────────────────────────────────────────────
	elseif REBIRTH_SKIP_TARGET_BY_PRODUCT[pid] then
		local currentRebirth = math.floor(tonumber(targetPlayer:GetAttribute("Rebirth")) or 0)
		local targetRebirth = math.min(RebirthConfig.MAX_REBIRTH, REBIRTH_SKIP_TARGET_BY_PRODUCT[pid])
		if currentRebirth < targetRebirth then
			local grantedRebirth = math.max(currentRebirth, targetRebirth)
			targetPlayer:SetAttribute("Rebirth", grantedRebirth)
			targetPlayer:SetAttribute("RebirthMultiplier", RebirthConfig.GetMultiplier(grantedRebirth))
		end
		profileGrantHash = tostring(targetRebirth)
		purchaseSuccess = true

		-- ─── 2X TABLET ───────────────────────────────────────────────────────────
	elseif pid == TABLET_2X_ID then
		local amount = math.max(0, math.floor(tonumber(targetPlayer:GetAttribute("TabletDoublePendingAmount")) or 0))
		local leaderstats = targetPlayer:FindFirstChild("leaderstats")
		local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")
		if amount > 0 and wallet then
			wallet.Value += amount * 2
			targetPlayer:SetAttribute("TabletDoublePendingAmount", 0)
			profileGrantHash = tostring(amount * 2)
			purchaseSuccess = true
		end

		-- ─── SHOP REROLLS ────────────────────────────────────────────────────────
	elseif pid == SHOP_REROLL_ID then
		if ShopRerollFunc then
			local ok, result = safeInvoke(ShopRerollFunc, 5, targetPlayer)
			purchaseSuccess = ok and result ~= false
			if not purchaseSuccess then
				warn("⚠️ ShopRerollFunction failed: " .. tostring(result))
			end
		end

	elseif pid == UNCOMMON_SHOP_REROLL_ID then
		if UncommonShopRerollFunc then
			local ok, result = safeInvoke(UncommonShopRerollFunc, 5, targetPlayer)
			purchaseSuccess = ok and result ~= false
			if not purchaseSuccess then
				warn("⚠️ UncommonShopRerollFunction failed: " .. tostring(result))
			end
		else
			warn("⚠️ UncommonShopRerollFunction missing!")
		end

	elseif pid == RARE_SHOP_REROLL_ID then
		if RareShopRerollFunc then
			local ok, result = safeInvoke(RareShopRerollFunc, 5, targetPlayer)
			purchaseSuccess = ok and result ~= false
			if not purchaseSuccess then
				warn("⚠️ RareShopRerollFunction failed: " .. tostring(result))
			end
		else
			warn("⚠️ RareShopRerollFunction missing!")
		end

	elseif pid == EPIC_SHOP_REROLL_ID then
		if EpicShopRerollFunc then
			local ok, result = safeInvoke(EpicShopRerollFunc, 5, targetPlayer)
			purchaseSuccess = ok and result ~= false
			if not purchaseSuccess then
				warn("⚠️ EpicShopRerollFunction failed: " .. tostring(result))
			end
		else
			warn("⚠️ EpicShopRerollFunction missing!")
		end

		-- ─── 🟢 COMMON CAR ───────────────────────────────────────────────────────
	elseif carProductInfo then
		local grantMessage = nil
		purchaseSuccess, grantMessage, carPostCommit = grantCarPurchase(buyerPlayer, targetPlayer, isGift, carProductInfo, receiptInfo)
		if not purchaseSuccess then
			warn("Robux car receipt grant failed:", tostring(grantMessage), "ProductId:", pid, "PurchaseId:", receiptInfo.PurchaseId)
		end

		-- ─── 🔵 UNCOMMON CAR ─────────────────────────────────────────────────────
	elseif UNCOMMON_CAR_PRODUCT_IDS[pid] then
		local carName = UNCOMMON_CAR_PRODUCT_IDS[pid]
		purchaseSuccess = false

		-- ─── 🟣 RARE CAR ─────────────────────────────────────────────────────────
	elseif RARE_CAR_PRODUCT_IDS[pid] then
		local carName = RARE_CAR_PRODUCT_IDS[pid]
		purchaseSuccess = false

		-- ─── 🟡 EPIC CAR ─────────────────────────────────────────────────────────
	elseif EPIC_CAR_PRODUCT_IDS[pid] then
		local carName = EPIC_CAR_PRODUCT_IDS[pid]
		purchaseSuccess = false

		-- ─── ⏩ SKIP CRAFT TIMES ─────────────────────────────────────────────────
	elseif pid == LEGENDARY_SKIP_CRAFT_ID then
		-- Craft skip products are account-specific and must never consume a
		-- stale gift receiver. A delayed receipt should always complete the
		-- buyer's own saved pending/active craft after they rejoin.
		isGift = false
		targetPlayer = buyerPlayer
		consumeStaleGiftIntentAfterGrant = giftReceiverId ~= nil

		local ok, success, msg = safeInvoke(SkipLegendaryCraftFunc, 20, targetPlayer)
		if ok and success then
			purchaseSuccess = true
		else
			warn("⚠️ Legendary Craft Skip failed or no active craft: " .. tostring(msg))
		end

	elseif pid == MYTHICAL_SKIP_CRAFT_ID then
		-- Craft skip products are account-specific and must never consume a
		-- stale gift receiver. A delayed receipt should always complete the
		-- buyer's own saved pending/active craft after they rejoin.
		isGift = false
		targetPlayer = buyerPlayer
		consumeStaleGiftIntentAfterGrant = giftReceiverId ~= nil

		local ok, success, msg = safeInvoke(SkipMythicalCraftFunc, 20, targetPlayer)
		if ok and success then
			purchaseSuccess = true
		else
			warn("⚠️ Mythical Craft Skip failed or no active craft: " .. tostring(msg))
		end

		-- ─── 🏠 COSMETIC BASE APPEARANCE ─────────────────────────────────────────
	elseif appearanceFound then
		local baseSkinsAPI = ServerStorage:FindFirstChild("BaseSkinsAPI")
		if baseSkinsAPI then
			local ok, granted, wasNew = pcall(function()
				return baseSkinsAPI:Invoke("Grant", targetPlayer, appearanceFound.Level, appearanceFound.SkinId)
			end)
			purchaseSuccess = ok and granted == true
			if purchaseSuccess and isGift then
				if wasNew then
					local giftName = registeredGiftProduct and registeredGiftProduct.DisplayName or ("Level %d %s Base Skin"):format(appearanceFound.Level, appearanceFound.DisplayName)
					NotifyGiftReceived:FireClient(targetPlayer, buyerPlayer.Name, giftName)
					if GlobalChatBroadcast then GlobalChatBroadcast:FireAllClients({ Type = "System", Message = ("🎁 <b><font color='#55CFFF'>%s</font></b> gifted <b><font color='#FF69B4'>%s</font></b> the <b><font color='#FFD700'>%s</font></b>! 💎 Generous friends build dream garages together!"):format(buyerPlayer.Name, targetPlayer.Name, giftName) }) end
				else
					suppressConfirmedSuccess = true
					fireGiftPurchaseResult(buyerPlayer, { Success = false, ProductId = pid, Message = targetPlayer.Name .. " already owns this Base Skin." })
				end
			end
		end

		-- ─── 🎨 BASE SKIN ────────────────────────────────────────────────────────
	elseif skinFound then
		local ownedRaw = targetPlayer:GetAttribute("OwnedBaseSkins") or "[]"
		local ownedTable = {}

		local decodeSuccess = pcall(function()
			ownedTable = HttpService:JSONDecode(ownedRaw)
		end)

		if not decodeSuccess then
			ownedTable = {}
		end

		if table.find(ownedTable, skinFound) then
			warn("🛡️ Security: Blocked purchase! " .. targetPlayer.Name .. " already owns the " .. skinFound .. " pad.")
			purchaseSuccess = true
			if isGift then
				suppressConfirmedSuccess = true
				fireGiftPurchaseResult(buyerPlayer, {
					Success = false,
					ProductId = pid,
					Message = targetPlayer.Name .. " already owns this item.",
				})
			end
		else
			table.insert(ownedTable, skinFound)
			targetPlayer:SetAttribute("OwnedBaseSkins", HttpService:JSONEncode(ownedTable))
			targetPlayer:SetAttribute("EquippedSkin", skinFound)

			purchaseSuccess = true

			if PadUnlockEvent and not isGift then
				PadUnlockEvent:FireClient(targetPlayer, true, skinFound .. " Base")
			end

			if isGift then
				local giftName = registeredGiftProduct and registeredGiftProduct.DisplayName or skinFound
				NotifyGiftReceived:FireClient(targetPlayer, buyerPlayer.Name, giftName)
			end
		end
	end

	-- ─── FINALIZE ─────────────────────────────────────────────────────────────
	if purchaseSuccess then
		if profileReceiptAction and not commitProfileReceipt(targetPlayer, receiptInfo, profileReceiptAction, profileGrantHash) then
			return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
		end
		if carPostCommit and not saveRankReceiptGrant(
			carPostCommit.BuyerPlayer,
			carPostCommit.TargetPlayer,
			carPostCommit.IsGift,
			carPostCommit.CarName,
			carPostCommit.Rarity,
			receiptInfo.PurchaseId
		) then
			return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
		end
		if not markPurchaseProcessed(purchaseKey) then
			return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
		end
		if not suppressConfirmedSuccess then
			local fallbackName = carPostCommit and carPostCommit.CarName
				or (appearanceFound and appearanceFound.DisplayName)
				or skinFound
			fireConfirmedPurchaseResult(buyerPlayer, receiptInfo, isGift, targetPlayer, fallbackName)
		end

		runCarPostCommit(carPostCommit)
		if carPostCommit and giftFallbackMessage then
			fireGiftPurchaseResult(buyerPlayer, {
				Success = false,
				ProductId = pid,
				CarName = carPostCommit.CarName,
				Rarity = carPostCommit.Rarity,
				Message = giftFallbackMessage,
				GrantedToBuyer = true,
			})
		end

		local adRewardReceiptGranted = ServerStorage:FindFirstChild("AdRewardReceiptGranted")
		if adRewardClientResult and adRewardReceiptGranted then
			adRewardReceiptGranted:Fire(
				buyerPlayer,
				adRewardClientResult.rewardName,
				adRewardClientResult.rewardColor
			)
		end

		if offlinePremiumClientResult then
			local folder = ReplicatedStorage:FindFirstChild("OfflineEarningsRemotes")
			local resultEvent = folder and folder:FindFirstChild("OfflinePremiumClaimResult")
			if resultEvent then
				resultEvent:FireClient(
					buyerPlayer,
					offlinePremiumClientResult.success,
					offlinePremiumClientResult.message,
					offlinePremiumClientResult.amount
				)
			end
		end

		if _G.ClearGiftIntent then
			if isGift and giftReceiverId then
				_G.ClearGiftIntent(buyerId, pid)
			elseif consumeStaleGiftIntentAfterGrant then
				_G.ClearGiftIntent(buyerId)
			end
		elseif _G.GetGiftReceiver then
			if (isGift and giftReceiverId) or consumeStaleGiftIntentAfterGrant then
				_G.GetGiftReceiver(buyerId, true)
			end
		end

		local TycoonAdminAPI = ServerStorage:FindFirstChild("TycoonAdminAPI")
		if TycoonAdminAPI then
			task.spawn(function()
				safeInvoke(TycoonAdminAPI, 2, "MarkDirty", targetPlayer)
			end)
		end

		if bankResetFeedback and BankTimerResetFeedback then
			BankTimerResetFeedback:FireClient(
				buyerPlayer,
				bankResetFeedback.success,
				bankResetFeedback.message
			)
		end

		return finish(Enum.ProductPurchaseDecision.PurchaseGranted)
	end

	return finish(Enum.ProductPurchaseDecision.NotProcessedYet)
end

MarketplaceService.ProcessReceipt = function(receiptInfo)
	-- Catch unexpected handler errors so a receipt is retried instead of leaving
	-- its in-memory lock stuck forever. Deliberately do not time out a running
	-- grant: abandoning it would let a late side effect race a second grant.
	local ok, decision = pcall(processReceipt, receiptInfo)
	if ok then return decision end

	local purchaseKey = tostring(receiptInfo.PlayerId) .. "_" .. tostring(receiptInfo.PurchaseId)
	activeReceiptLocks[purchaseKey] = nil
	warn("[ReceiptRouter] Unexpected receipt error for " .. purchaseKey .. ": " .. tostring(decision))
	return Enum.ProductPurchaseDecision.NotProcessedYet
end
