-- ============================================================================
-- ⏱️ TIMEOUT UTILITY
-- ============================================================================
local function safeInvoke(bindable, timeout, ...)
	local args = table.pack(...)
	local result = nil
	local finished = false

	task.spawn(function()
		result = table.pack(pcall(function()
			return bindable:Invoke(table.unpack(args, 1, args.n))
		end))
		finished = true
	end)

	local start = os.clock()
	while not finished and (os.clock() - start) < timeout do
		task.wait()
	end

	if not finished then return false, "Timeout" end
	if not result[1] then return false, result[2] end

	return true, table.unpack(result, 2, result.n)
end

local function getPurchaseHistoryStore()
	if ActivePurchaseHistory then return ActivePurchaseHistory end

	for _, name in ipairs(PURCHASE_HISTORY_NAMES) do
		local ok, store = pcall(function() return DataStoreService:GetDataStore(name) end)
		if ok and store then
			ActivePurchaseHistory = store
			return ActivePurchaseHistory
		end
	end
	return nil
end


local StarterPackOwnedStore = DataStoreService:GetDataStore("OneTimeProductOwnership_V1")

local function getStarterPackOwnershipKey(userId)
	return STARTER_PACK_OWNED_KEY_PREFIX .. tostring(userId)
end

local function hasStarterPackOwnership(userId)
	local ok, value = pcall(function()
		return StarterPackOwnedStore:GetAsync(getStarterPackOwnershipKey(userId))
	end)
	if not ok then return nil end
	return value == true
end

local function setStarterPackOwnership(userId)
	local ok = pcall(function()
		StarterPackOwnedStore:SetAsync(getStarterPackOwnershipKey(userId), true)
	end)
	return ok
end

local function isDeletedStoreError(err)
	err = string.lower(tostring(err or ""))
	return string.find(err, "data store is deleted", 1, true) ~= nil
end

local function wasPurchaseProcessed(purchaseKey)
	local store = getPurchaseHistoryStore()
	if not store then return nil end

	for attempt = 1, 3 do
		local success, result = pcall(function() return store:GetAsync(purchaseKey) end)
		if success then return result == true end

		if isDeletedStoreError(result) then
			local fallbackOk, fallbackStore = pcall(function() return DataStoreService:GetDataStore("PurchaseHistory_V2") end)
			if fallbackOk and fallbackStore then
				ActivePurchaseHistory = fallbackStore
				store = ActivePurchaseHistory
			else
				return nil
			end
		else
			task.wait(0.25 * attempt)
		end
	end
	return nil
end

local function markPurchaseProcessed(purchaseKey)
	local store = getPurchaseHistoryStore()
	if not store then return false end

	local success, err = pcall(function()
		store:UpdateAsync(purchaseKey, function(current) return true end)
	end)

	if not success then return false end
	return true
end

-- ============================================================================
-- 🚗 HELPER: Give a car tool immediately upon purchase
-- ============================================================================
local function giveCarTool(targetPlayer, carName)
	local CarTools = ServerStorage:FindFirstChild("CarTools")
	local tool = CarTools and (CarTools:FindFirstChild(carName, true) or CarTools:FindFirstChild(carName .. " Item", true))
	if not tool then
		warn("⚠️ Car Tool missing from ServerStorage: " .. carName)
		return false
	end

	local TycoonAdminAPI = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if not TycoonAdminAPI then
		warn("⚠️ TycoonAdminAPI missing!")
		return false
	end

	local invokeOk, giveResult = safeInvoke(TycoonAdminAPI, 3, "GiveTool", targetPlayer, tool.Name, {
		IssuedByServer = true,
		IssuedAt = os.time(),
		ToolId = tool.Name,
	})

	return invokeOk and giveResult == true
end

local function recordRankRobuxGrant(buyerPlayer, targetPlayer, isGift, carName, rarity)
	local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
	if not rankApi then return end

	task.spawn(function()
		if isGift then
			pcall(function()
				rankApi:Invoke("CarGiftSent", buyerPlayer, targetPlayer, carName)
			end)
		else
			pcall(function()
				rankApi:Invoke("CarObtained", targetPlayer, carName, "Buy", rarity)
			end)
		end
	end)
end

-- ============================================================================
-- 🎁 HELPER: Handle Car Purchase & Broadcasts
-- ============================================================================
local function handleCarPurchaseSuccess(buyerPlayer, targetPlayer, isGift, carName, rarity, npcFeedbackName)
	local purchaseSuccess = giveCarTool(targetPlayer, carName)
	if not purchaseSuccess then return false end

	recordRankRobuxGrant(buyerPlayer, targetPlayer, isGift, carName, rarity)

	local ShopRemotes = ReplicatedStorage:FindFirstChild("ShopRemotes")
	local feedbackRemote = ShopRemotes and npcFeedbackName and ShopRemotes:FindFirstChild(npcFeedbackName)

	if isGift then
		-- Keep Sender confirmation untouched
		if feedbackRemote then
			feedbackRemote:FireClient(buyerPlayer, carName, true, targetPlayer.Name)
		end

		-- Replace Receiver private notification with server-wide broadcast
		if GlobalChatBroadcast then
			GlobalChatBroadcast:FireAllClients({
				Type = "CarGift",
				SenderName = buyerPlayer.Name,
				ReceiverName = targetPlayer.Name,
				CarName = carName,
				Rarity = rarity
			})
		end
	else
		-- Normal non-gift purchase
		if feedbackRemote then
			feedbackRemote:FireClient(targetPlayer, carName, true)
		end
	end

	return true
end

