local function requireServerModule(moduleName)
	local module = script.Parent:WaitForChild(moduleName, 15)
	if not module then
		error("[ReceiptRouter] Missing ServerScriptService > " .. moduleName .. " ModuleScript", 0)
	end
	if not module:IsA("ModuleScript") then
		error("[ReceiptRouter] ServerScriptService > " .. moduleName .. " must be a ModuleScript, got " .. module.ClassName, 0)
	end
	return require(module)
end

