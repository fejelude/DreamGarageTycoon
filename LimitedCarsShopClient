-- LocalScript: StarterGui > ShopUI > LimitedCarsShopClient
-- Purpose: Native ShopUI client binding for all globally limited featured-car Developer Products.
-- Security: Reserves stock through the server before prompting. Only ProcessReceipt grants the car.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Config = require(ReplicatedStorage:WaitForChild("LimitedCarsConfig"))
local Kit = require(ReplicatedStorage:WaitForChild("ShopFrontendKit"))
local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local remotes = ReplicatedStorage:WaitForChild("LimitedCarsRemotes")
local StateEvent = remotes:WaitForChild("State")
local GetState = remotes:WaitForChild("GetState")
local Reserve = remotes:WaitForChild("Reserve")
local PromptClosed = remotes:WaitForChild("PromptClosed")
local PurchaseResult = remotes:WaitForChild("PurchaseResult")

local shopGui = playerGui:WaitForChild("ShopUI")
local mainFrame = shopGui:WaitForChild("MainFrame")
local shopFeedback = UIAudioConfig.CreateStateFeedback(mainFrame)

local function findPath(root, names)
	local obj = root
	for _, name in ipairs(names) do
		obj = obj and obj:FindFirstChild(name)
		if not obj then return nil end
	end
	return obj
end

local bindings = {}
for index, productKey in ipairs({ "NeoPerformante", "Yamura", "Centurion" }) do
	local product = Config.Products[productKey]
	bindings[product.ProductId] = {
		Product = product,
		Button = findPath(mainFrame, {"ShopUIScrolling", "ButtonsForBuying", "Buttons", "Cars", "BuyButtonV" .. index}),
		Label = findPath(mainFrame, {"ShopUIScrolling", "ButtonsForBuying", "Buttons", "Important", "StockIndicatorV" .. index}),
		Busy = false, Pending = false, AttemptId = 0,
	}
end

local function setButtonInputLocked(button, locked)
	if not button then return end
	button.Active = not locked
	button.Selectable = not locked
	pcall(function() button.Interactable = not locked end)
end

local function render(binding)
	local remaining = binding.State and tonumber(binding.State.Remaining) or binding.Product.MaxGlobalStock
	if binding.Label then binding.Label.Text = Config.FormatStock(binding.Product, remaining) end
	setButtonInputLocked(binding.Button, binding.Busy or remaining <= 0)
end

local function finishPrompt(binding)
	binding.AttemptId += 1
	UIAudioConfig.HidePurchaseLoading()
	binding.Busy = false
	binding.Pending = false
	render(binding)
end

local function beginPurchase(binding)
	if binding.Busy then return end
	local remaining = binding.State and tonumber(binding.State.Remaining) or binding.Product.MaxGlobalStock
	if remaining <= 0 then
		shopFeedback:Failed("Out Of Stock")
		Kit.Sound:Play("BuyFail")
		return
	end

	binding.Busy = true
	binding.AttemptId += 1
	local thisAttempt = binding.AttemptId
	render(binding)
	UIAudioConfig.PlayRobux()
	UIAudioConfig.ShowPurchaseLoading()

	local ok, reserved, message, state = pcall(function() return Reserve:InvokeServer(binding.Product.ProductId) end)
	if ok and type(state) == "table" then binding.State = state; render(binding) end
	if not ok or reserved ~= true then
		finishPrompt(binding)
		shopFeedback:Failed((type(message) == "string" and message ~= "") and message or "Out Of Stock")
		Kit.Sound:Play("BuyFail")
		return
	end

	binding.Pending = true
	local promptOk, promptErr = pcall(function()
		MarketplaceService:PromptProductPurchase(player, binding.Product.ProductId)
	end)
	if not promptOk then
		pcall(function() PromptClosed:FireServer(binding.Product.ProductId) end)
		finishPrompt(binding)
		shopFeedback:Failed("Purchase Failed")
		Kit.Sound:Play("BuyFail")
		warn("[LimitedCarsShopClient] PromptProductPurchase failed:", promptErr)
		return
	end

	task.delay(30, function()
		if binding.AttemptId == thisAttempt and binding.Busy then
			UIAudioConfig.HidePurchaseLoading()
			binding.Busy = false
			render(binding)
		end
	end)
end

for _, binding in pairs(bindings) do
	if binding.Button then Kit.Tween:SetupButton(binding.Button, function() beginPurchase(binding) end) end
end

StateEvent.OnClientEvent:Connect(function(state)
	local binding = type(state) == "table" and bindings[tonumber(state.ProductId)]
	if binding then binding.State = state; render(binding) end
end)

PurchaseResult.OnClientEvent:Connect(function(success, message)
	local binding
	for _, candidate in pairs(bindings) do if candidate.Busy then binding = candidate; break end end
	if binding then finishPrompt(binding) end
	if success then
		shopFeedback:Success(message ~= "" and message or "Featured Car Purchased")
		Kit.Sound:Play("BuySuccess")
	else
		shopFeedback:Failed(message ~= "" and message or "Purchase Failed")
		Kit.Sound:Play("BuyFail")
	end
end)

MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
	local binding = bindings[productId]
	if userId ~= player.UserId or not binding then return end
	UIAudioConfig.HidePurchaseLoading()
	if not wasPurchased and binding.Pending then
		pcall(function() PromptClosed:FireServer(productId) end)
		finishPrompt(binding)
	elseif not wasPurchased then
		finishPrompt(binding)
	end
	-- Do not show Failed for cancellation and do not show Success until PurchaseResult.
end)

task.spawn(function()
	for productId, binding in pairs(bindings) do
		local ok, state = pcall(function() return GetState:InvokeServer(productId) end)
		if ok and type(state) == "table" then binding.State = state end
		render(binding)
	end
	while true do
		task.wait(30)
		for productId, binding in pairs(bindings) do
			local refreshOk, fresh = pcall(function() return GetState:InvokeServer(productId) end)
			if refreshOk and type(fresh) == "table" then binding.State = fresh; render(binding) end
		end
	end
end)
