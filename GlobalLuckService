-- Server ModuleScript: ServerScriptService > GlobalLuckService
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GlobalLuckConfig"))

local REQUIRED_WAIT_SECONDS = 15

local function requireChild(parent, childName, className, fullPath)
	local child = parent:WaitForChild(childName, REQUIRED_WAIT_SECONDS)
	if not child then
		error("[GlobalLuckService] Missing required instance: " .. fullPath .. " (" .. className .. ")", 0)
	end
	if className and not child:IsA(className) then
		error("[GlobalLuckService] " .. fullPath .. " must be a " .. className .. ", got " .. child.ClassName, 0)
	end
	return child
end

local remotes = requireChild(ReplicatedStorage, "GlobalLuckRemotes", "Folder", "ReplicatedStorage > GlobalLuckRemotes")
local StateEvent = requireChild(remotes, "State", "RemoteEvent", "ReplicatedStorage > GlobalLuckRemotes > State")
local GetStateFunction = requireChild(remotes, "GetState", "RemoteFunction", "ReplicatedStorage > GlobalLuckRemotes > GetState")
local PurchaseResultEvent = requireChild(remotes, "PurchaseResult", "RemoteEvent", "ReplicatedStorage > GlobalLuckRemotes > PurchaseResult")

local stateStore = DataStoreService:GetDataStore(Config.StateStoreName)
local receiptStore = DataStoreService:GetDataStore(Config.ReceiptStoreName)

local Service = {}
local currentState = nil
local generation = 0
local expireToken = 0

local function now() return os.time() end
local function inactiveState()
	return { Active = false, Multiplier = Config.BaseMultiplier, ActivatedAt = 0, ExpiresAt = 0, PurchaserUserId = 0, PurchaserUsername = "", ReceiptKey = "" }
end
local function sanitize(raw)
	local s = type(raw) == "table" and raw or inactiveState()
	if (tonumber(s.ExpiresAt) or 0) <= now() then return inactiveState() end
	return { Active = true, Multiplier = math.max(Config.BaseMultiplier, tonumber(s.Multiplier) or 2), ActivatedAt = tonumber(s.ActivatedAt) or now(), ExpiresAt = tonumber(s.ExpiresAt), PurchaserUserId = tonumber(s.PurchaserUserId) or 0, PurchaserUsername = tostring(s.PurchaserUsername or ""), ReceiptKey = tostring(s.ReceiptKey or "") }
end
local function publicState()
	local s = sanitize(currentState)
	return { Active = s.Active, Multiplier = s.Multiplier, CurrentLuck = Config.FormatMultiplier(s.Multiplier), NextLuck = Config.FormatMultiplier(Config.GetNextMultiplier(s.Multiplier)), ActivatedAt = s.ActivatedAt, ExpiresAt = s.ExpiresAt, PurchaserUserId = s.PurchaserUserId, PurchaserUsername = s.PurchaserUsername, ServerTime = now() }
end
local function setLocalState(newState, shouldPublish)
	local oldActive = currentState and currentState.Active
	local oldExpires = currentState and currentState.ExpiresAt
	currentState = sanitize(newState)
	if oldActive ~= currentState.Active or oldExpires ~= currentState.ExpiresAt then generation += 1 end
	StateEvent:FireAllClients(publicState())
	expireToken += 1
	local token = expireToken
	if currentState.Active then
		task.delay(math.max(1, currentState.ExpiresAt - now()), function()
			if token == expireToken then Service.RefreshFromStore(true) end
		end)
	end
	if shouldPublish then pcall(function() MessagingService:PublishAsync(Config.TopicName, publicState()) end) end
end
function Service.RefreshFromStore(shouldPublish)
	local ok, data = pcall(function() return stateStore:GetAsync(Config.StateKey) end)
	if ok then setLocalState(data, shouldPublish) end
	return ok
end
function Service.GetState() if not currentState then Service.RefreshFromStore(false) end return publicState() end
function Service.GetMultiplier() return Service.GetState().Multiplier end
function Service.GetGeneration() Service.GetState() return generation end
function Service.CanPurchase() return not Service.GetState().Active end
function Service.NotifyClient(player, success, message) if player then PurchaseResultEvent:FireClient(player, success == true, message or "") end end
function Service.ProcessReceipt(receiptInfo)
	local receiptKey = tostring(receiptInfo.PlayerId) .. "_" .. tostring(receiptInfo.PurchaseId)
	local receiptOk, wasProcessed = pcall(function() return receiptStore:GetAsync(receiptKey) end)
	if not receiptOk then return false, "Receipt check failed", false end
	if wasProcessed then return true, "Already granted", true end
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then return false, "Player unavailable", false end
	local activated = false
	local activatedState = nil
	local ok, err = pcall(function()
		stateStore:UpdateAsync(Config.StateKey, function(old)
			local s = sanitize(old)
			if s.Active then
				activated = (s.ReceiptKey == receiptKey)
				activatedState = s
				return s
			end
			activated = true
			activatedState = { Active = true, Multiplier = Config.GetNextMultiplier(Config.BaseMultiplier), ActivatedAt = now(), ExpiresAt = now() + Config.DurationSeconds, PurchaserUserId = player.UserId, PurchaserUsername = player.Name, ReceiptKey = receiptKey }
			return activatedState
		end)
	end)
	if not ok then return false, "Global Luck save failed", false end
	setLocalState(activatedState, true)
	if not activated then return false, "Global Luck is already active", false end
	pcall(function() receiptStore:SetAsync(receiptKey, true) end)
	return true, "Global Luck activated", false
end

GetStateFunction.OnServerInvoke = function() return Service.GetState() end
Players.PlayerAdded:Connect(function(player) StateEvent:FireClient(player, Service.GetState()) end)
pcall(function() MessagingService:SubscribeAsync(Config.TopicName, function(message) if type(message.Data) == "table" then setLocalState(message.Data, false) end end) end)
Service.RefreshFromStore(false)
return Service
