-- Server ModuleScript: ServerScriptService > GlobalLuckService
local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("GlobalLuckConfig"))
local StackConfig = Config.StackConfig

local PUBLISH_RETRY_DELAYS = { 0, 1, 3, 7 }
local SUBSCRIBE_RETRY_DELAYS = { 0, 2, 5, 10, 20 }
local MAX_PROCESSED_RECEIPTS = 100
local RECONCILE_INTERVAL = 30

local remotes = ReplicatedStorage:WaitForChild("GlobalLuckRemotes")
local StateEvent = remotes:WaitForChild("State")
local GetStateFunction = remotes:WaitForChild("GetState")
local PurchaseResultEvent = remotes:WaitForChild("PurchaseResult")
local GlobalChatBroadcast = ReplicatedStorage:WaitForChild("GiftRemotes"):WaitForChild("GlobalChatBroadcast")
local stateStore = DataStoreService:GetDataStore(Config.StateStoreName)
local receiptStore = DataStoreService:GetDataStore(Config.ReceiptStoreName)

local Service = {}
local currentState
local stateHealthy = false
local refreshInFlight = false
local nextRefreshAt = 0
local refreshFailures = 0
local generation = 0
local expireToken = 0
local function now() return os.time() end

local function sanitizeProcessedReceipts(raw)
	local entries = {}
	for receiptKey, processedAt in pairs(type(raw) == "table" and raw or {}) do
		if type(receiptKey) == "string" and receiptKey ~= "" then
			table.insert(entries, { Key = receiptKey, At = math.max(0, math.floor(tonumber(processedAt) or 0)) })
		end
	end
	table.sort(entries, function(a, b) return a.At > b.At end)
	local result = {}
	for index, entry in ipairs(entries) do
		if index > MAX_PROCESSED_RECEIPTS then break end
		result[entry.Key] = entry.At
	end
	return result
end

local function inactiveState(processedReceipts, revision)
	return {
		Revision = math.max(0, math.floor(tonumber(revision) or 0)),
		Active = false, StackCount = 0, Multiplier = Config.BaseMultiplier,
		ActivatedAt = 0, ExpiresAt = 0, PurchaserUserId = 0,
		PurchaserUsername = "", PurchaserDisplayName = "", ReceiptKey = "",
		ProcessedReceipts = sanitizeProcessedReceipts(processedReceipts),
	}
end

local function sanitize(raw)
	local s = type(raw) == "table" and raw or inactiveState()
	local receipts = sanitizeProcessedReceipts(s.ProcessedReceipts)
	if s.Active ~= true or (tonumber(s.ExpiresAt) or 0) <= now() then return inactiveState(receipts, s.Revision) end
	-- StackCount was added in V2. Deriving it migrates an already-active legacy 2x session.
	local stackCount = tonumber(s.StackCount) and math.floor(s.StackCount) or StackConfig.GetStackCount(s.Multiplier)
	stackCount = math.clamp(stackCount, 1, StackConfig.MaxStackCount)
	return {
		Revision = math.max(0, math.floor(tonumber(s.Revision) or 0)),
		Active = true, StackCount = stackCount, Multiplier = StackConfig.GetMultiplier(stackCount),
		ActivatedAt = tonumber(s.ActivatedAt) or now(), ExpiresAt = tonumber(s.ExpiresAt) or now(),
		PurchaserUserId = tonumber(s.PurchaserUserId) or 0,
		PurchaserUsername = tostring(s.PurchaserUsername or ""),
		PurchaserDisplayName = tostring(s.PurchaserDisplayName or s.PurchaserUsername or ""),
		ReceiptKey = tostring(s.ReceiptKey or ""), ProcessedReceipts = receipts,
		BoostPurchaseNotification = type(s.BoostPurchaseNotification) == "table" and s.BoostPurchaseNotification or nil,
		LastMutation = type(s.LastMutation) == "table" and s.LastMutation or nil,
	}
end

-- Gameplay getters always use this safe cache, even during a DataStore outage.
currentState = inactiveState()

local function publicState(notification)
	local s = sanitize(currentState)
	local nextMultiplier = StackConfig.GetNextMultiplier(s.StackCount)
	return {
		Revision = s.Revision, Healthy = stateHealthy,
		Active = s.Active, StackCount = s.StackCount, Multiplier = s.Multiplier,
		CurrentLuck = Config.FormatMultiplier(s.Multiplier),
		NextLuck = nextMultiplier and Config.FormatMultiplier(nextMultiplier) or "MAX",
		Maxed = StackConfig.IsMaxed(s.StackCount), ActivatedAt = s.ActivatedAt, ExpiresAt = s.ExpiresAt,
		PurchaserUserId = s.PurchaserUserId, PurchaserUsername = s.PurchaserUsername,
		PurchaserDisplayName = s.PurchaserDisplayName, ServerTime = now(),
		BoostPurchaseNotification = notification or s.BoostPurchaseNotification,
	}
end

local function fireStackAnnouncement(announcement)
	if type(announcement) == "table" then GlobalChatBroadcast:FireAllClients(announcement) end
end

local function publish(payload)
	task.spawn(function()
		for attempt, delaySeconds in ipairs(PUBLISH_RETRY_DELAYS) do
			if delaySeconds > 0 then task.wait(delaySeconds) end
			local ok, err = pcall(function() MessagingService:PublishAsync(Config.TopicName, payload) end)
			if ok then return end
			warn(string.format("[GlobalLuckService] publish attempt %d failed: %s", attempt, tostring(err)))
		end
	end)
end

local function setLocalState(newState, shouldPublish, notification, announcement)
	local previous = currentState and sanitize(currentState)
	local incoming = sanitize(newState)
	if previous and incoming.Revision < previous.Revision then return false end
	currentState = incoming
	if not previous or previous.Active ~= currentState.Active or previous.ExpiresAt ~= currentState.ExpiresAt or previous.StackCount ~= currentState.StackCount then
		generation += 1
	end
	StateEvent:FireAllClients(publicState(notification))
	expireToken += 1
	local token = expireToken
	if currentState.Active then
		task.delay(math.max(1, currentState.ExpiresAt - now()), function()
			if token == expireToken then Service.RefreshFromStore(true) end
		end)
	end
	if shouldPublish then publish({ StateChanged = true, Revision = currentState.Revision, Announcement = announcement }) end
	return true
end

function Service.RefreshFromStore(shouldPublish)
	if refreshInFlight or os.clock() < nextRefreshAt then return false end
	refreshInFlight = true
	task.spawn(function()
		local ok, data = pcall(function() return stateStore:GetAsync(Config.StateKey) end)
		if ok then
			stateHealthy = true
			refreshFailures = 0
			nextRefreshAt = os.clock() + 1
			setLocalState(data, shouldPublish)
		else
			stateHealthy = false
			refreshFailures += 1
			nextRefreshAt = os.clock() + math.min(30, 2 ^ math.min(refreshFailures, 5))
			warn("[GlobalLuckService] State refresh failed: " .. tostring(data))
		end
		refreshInFlight = false
	end)
	return true
end

-- Uses the same inactive-state normalization and client broadcast path as a
-- natural expiration, while also replacing the authoritative persisted state.
function Service.Clear()
	local committed
	local ok, err = pcall(function()
		committed = stateStore:UpdateAsync(Config.StateKey, function(old)
			local s = type(old) == "table" and old or {}
			return inactiveState(s.ProcessedReceipts, (tonumber(s.Revision) or 0) + 1)
		end)
	end)
	if not ok or type(committed) ~= "table" then
		return false, tostring(err or "Global boost clear returned no state")
	end
	-- Do not make other servers immediately GetAsync here. Roblox can serve a
	-- cached pre-clear GetAsync result, which would make a running boost appear
	-- again until reconciliation. The clear message tells subscribers to apply
	-- the same inactive state immediately; the DataStore write above remains the
	-- authoritative durable reset.
	stateHealthy = true
	setLocalState(committed, false)
	publish({ StateChanged = true, Cleared = true, Revision = committed.Revision })
	return true
end

function Service.GetState() return publicState() end
function Service.GetMultiplier() return Service.GetState().Multiplier end
function Service.GetGeneration() return generation end
function Service.CanPurchase() local s = Service.GetState(); return not (s.Active and s.Maxed) end
function Service.NotifyClient(player, success, message) if player then PurchaseResultEvent:FireClient(player, success == true, message or "") end end

function Service.ProcessReceipt(receiptInfo)
	local receiptKey = tostring(receiptInfo.PlayerId) .. "_" .. tostring(receiptInfo.PurchaseId)
	local receiptOk, wasProcessed = pcall(function() return receiptStore:GetAsync(receiptKey) end)
	if not receiptOk then return false, "Receipt check failed", false end
	if wasProcessed then return true, "Already granted", true end
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then return false, "Player unavailable", false end

	local committed
	local ok = pcall(function()
		committed = stateStore:UpdateAsync(Config.StateKey, function(old)
			local s = sanitize(old) -- expiration is decided atomically inside this transform
			if s.ProcessedReceipts[receiptKey] then return s end
			s.ProcessedReceipts[receiptKey] = now()
			s.ProcessedReceipts = sanitizeProcessedReceipts(s.ProcessedReceipts)
			local isActivation = not s.Active
			local priorCount = isActivation and 0 or s.StackCount
			local extended = priorCount >= StackConfig.MaxStackCount
			local applied = true
			local newCount = extended and priorCount or (priorCount + 1)
			s.Revision += 1
			if extended then s.ExpiresAt = math.max(now(), s.ExpiresAt) + Config.DurationSeconds end
			if isActivation then
				local activatedAt = now()
				s.Active, s.ActivatedAt, s.ExpiresAt = true, activatedAt, activatedAt + Config.DurationSeconds
				s.PurchaserUserId, s.PurchaserUsername = player.UserId, player.Name
				s.PurchaserDisplayName = player.DisplayName
			end
			s.StackCount, s.Multiplier = newCount, StackConfig.GetMultiplier(newCount)
			s.ReceiptKey = isActivation and receiptKey or s.ReceiptKey -- original host receipt remains stable
			local notification
			if isActivation then
				notification = { Id = "GlobalLuck_" .. receiptKey, Username = player.Name, DisplayName = player.DisplayName, BoostName = "Global " .. Config.FormatMultiplier(s.Multiplier) .. " Luck" }
				s.BoostPurchaseNotification = notification
			end
			local announcement
			if not extended and not isActivation then
				local multiplierText = Config.FormatMultiplier(s.Multiplier):gsub("x", "×")
				announcement = { Type = "BoostStack", Id = "GlobalLuck_Stack_" .. receiptKey, DisplayName = player.DisplayName, Username = player.Name, BoostName = "Global Luck", Multiplier = multiplierText }
			end
			s.LastMutation = { ReceiptKey = receiptKey, Applied = applied, Extended = extended, IsActivation = isActivation, Announcement = announcement }
			return s
		end)
	end)
	if not ok or type(committed) ~= "table" then return false, "Global boost save failed", false end
	stateHealthy = true
	committed = sanitize(committed)
	local mutation = committed.LastMutation
	local ownsMutation = type(mutation) == "table" and mutation.ReceiptKey == receiptKey
	if not ownsMutation then
		-- A duplicate found in the bounded atomic history. The durable receipt marker is backfilled below.
		local markerOk = pcall(function() receiptStore:SetAsync(receiptKey, true) end)
		setLocalState(committed, false)
		if not markerOk then return false, "Receipt finalization failed", true end
		return true, "Already granted", true
	end
	setLocalState(committed, true, mutation.IsActivation and committed.BoostPurchaseNotification or nil, mutation.Announcement)
	if mutation.Announcement then fireStackAnnouncement(mutation.Announcement) end
	local markerOk = pcall(function() receiptStore:SetAsync(receiptKey, true) end)
	if not markerOk then return false, "Receipt finalization failed", false end
	if mutation.Extended then return true, "Global Luck duration extended", false end
	return true, mutation.IsActivation and "Global Luck activated" or ("Boosted to " .. Config.FormatMultiplier(committed.Multiplier)), false
end

GetStateFunction.OnServerInvoke = function() return Service.GetState() end
Players.PlayerAdded:Connect(function(player) StateEvent:FireClient(player, Service.GetState()) end)
task.spawn(function()
	for attempt, delaySeconds in ipairs(SUBSCRIBE_RETRY_DELAYS) do
		if delaySeconds > 0 then task.wait(delaySeconds) end
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(Config.TopicName, function(message)
				if type(message.Data) ~= "table" then return end
				local revision = math.max(0, math.floor(tonumber(message.Data.Revision) or 0))
				if revision < currentState.Revision then return end
				if message.Data.Cleared == true and revision > currentState.Revision then
					setLocalState(inactiveState(currentState.ProcessedReceipts, revision), false)
				end
				-- The DataStore, never the broadcast payload, remains authoritative.
				Service.RefreshFromStore(false)
				fireStackAnnouncement(message.Data.Announcement)
			end)
		end)
		if ok then return end
		warn(string.format("[GlobalLuckService] subscribe attempt %d failed: %s", attempt, tostring(err)))
	end
end)
task.spawn(function() while true do task.wait(RECONCILE_INTERVAL); Service.RefreshFromStore(false) end end)
Service.RefreshFromStore(false)
return Service
