-- Purpose: Handles Camera, Dialogue Logic, and UI for Harley NPC with strict ProximityPrompt placement.
-- Runs on: Client
-- Location: StarterPlayerScripts
-- Dependencies: TweenService, Players, Workspace, SoundService, UserInputService
-- Public API: None
-- Networking: None (Client-side dialogue only)
-- Security: Validates local character state before locking movement.
-- Performance: Safely manages nested task threads to prevent self-cancellation memory locks.
-- Notes: Contains [HarleyDebug] trace logs. Targets Harley in Workspace.NPCS.

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local playerGui = player:WaitForChild("PlayerGui")

print("🐛 [HarleyDebug] Script Initializing...")

-- ============================================================================
-- 🎨 COLOR CONFIGURATION
-- ============================================================================
local USER_COLOR = "#55AAFF"      -- Blue (Player Name Default)
local HARLEY_COLOR = "#FF4444"    -- Red (Harley)
local GREEN_COLOR = "#55FF7F"     -- Green (Exit Message)
local JACOB_COLOR = "#FF8800"     -- Orange (Jacob Emphasis)
local MYSTERY_COLOR = "#AA55FF"   -- Purple (Daytime-readable night/lore hints)
local CAR_COLOR = "#00CC66"       -- Emerald Green (Rare cars emphasis)

-- ============================================================================
-- 🆔 UNIQUE IDENTIFIERS
-- ============================================================================
local GUI_ID = "UI_NPC_Harley"
local CONTAINER_ID = "Frame_Harley_Container"
local TEXT_ID = "Text_Harley_Dialogue"

-- BUTTON NAMES
local BTN_INQUIRY_ID = "Btn_Harley_Inquiry"
local BTN_INQUIRY2_ID = "Btn_Harley_Inquiry2"
local BTN_LEAVE_ID = "Btn_Harley_Leave"
local ALL_BUTTON_IDS = {BTN_INQUIRY_ID, BTN_INQUIRY2_ID, BTN_LEAVE_ID}

-- 📍 NPC CONFIGURATION
local NPC_FOLDER = "NPCS"
local TARGET_NPC = "Harley"
local CAMERA_PART = "CameraAimPart"
local PROMPT_NAME = "TalkPrompt"

-- 🎥 SETTINGS
local TWEEN_INFO = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TYPEWRITER_SPEED = 0.02
local LEAVE_DELAY = 1.5

-- 🔊 SOUNDS
local TYPING_SOUND_ID = "rbxassetid://4676738150"

-- ✨ ANIMATION SETTINGS
local HOVER_SCALE = 1.1
local CLICK_SCALE = 0.9
local ANIM_SPEED = 0.1

-- ============================================================================
-- 🛠️ STATE VARIABLES
-- ============================================================================
local isInteracting = false
local isLeaving = false
local currentDialogueJob = nil
local buttonConnections = {}
local buttonHoverConnections = {}
local hiddenGuis = {}
local hiddenObjects = {}
local interactionCycle = 1
local promptDebounce = false  -- 🔒 Prevents duplicate ProximityPrompt triggers
local controls = require(player.PlayerScripts:WaitForChild("PlayerModule")):GetControls()

-- ============================================================================
-- 🔒 FORCE HIDE UI ON LOAD
-- ============================================================================
task.spawn(function()
	local myGui = playerGui:WaitForChild(GUI_ID, 10)
	if myGui then
		myGui.Enabled = false
		local container = myGui:FindFirstChild(CONTAINER_ID, true)
		if container then container.Visible = false end
	end
end)

-- ============================================================================
-- 🎬 INTERACTION FUNCTIONS
-- ============================================================================

local function setButtonsState(isActive)
	local myGui = playerGui:FindFirstChild(GUI_ID)
	if not myGui then return end

	for _, btnID in ipairs(ALL_BUTTON_IDS) do
		local btn = myGui:FindFirstChild(btnID, true)
		if btn then
			btn.Visible = isActive
			btn.Active = isActive
		end
	end
end

local function clearConnections()
	for _, conn in pairs(buttonConnections) do
		if conn then conn:Disconnect() end
	end
	buttonConnections = {}

	for _, conn in pairs(buttonHoverConnections) do
		if conn then conn:Disconnect() end
	end
	buttonHoverConnections = {}

	-- Reset HoverBound attribute so effects re-bind on next interaction
	local myGui = playerGui:FindFirstChild(GUI_ID)
	if myGui then
		for _, btnID in ipairs(ALL_BUTTON_IDS) do
			local btn = myGui:FindFirstChild(btnID, true)
			if btn then btn:SetAttribute("HoverBound", nil) end
		end
	end
end

local function toggleNamedGuiObjects(shouldHide, objectName)
	if shouldHide then
		for _, obj in pairs(playerGui:GetDescendants()) do
			if obj:IsA("GuiObject") and obj.Name == objectName and obj.Visible then
				obj.Visible = false
				table.insert(hiddenObjects, obj)
			end
		end
	else
		for _, obj in pairs(hiddenObjects) do
			if obj and obj.Parent and obj:IsA("GuiObject") then
				obj.Visible = true
			end
		end
		hiddenObjects = {}
	end
end

local function toggleOtherGuis(shouldHide)
	if shouldHide then
		if #hiddenGuis > 0 then return end
		hiddenGuis = {}
		for _, otherGui in pairs(playerGui:GetDescendants()) do
			if otherGui:IsA("ScreenGui")
				and otherGui.Name ~= GUI_ID
				and otherGui.Enabled == true
				and otherGui.Name ~= "Balance Indicator" then

				otherGui.Enabled = false
				table.insert(hiddenGuis, otherGui)
			end
		end
	else
		for _, otherGui in pairs(hiddenGuis) do
			if otherGui and otherGui.Parent then
				otherGui.Enabled = true
			end
		end
		hiddenGuis = {}
	end
end

local function setFocusMode(active)
	toggleOtherGuis(active)
	toggleNamedGuiObjects(active, "FriendBoost")
end

local function playSound(id, vol)
	if id == TYPING_SOUND_ID then
		local s = Instance.new("Sound")
		s.SoundId = id; s.Volume = vol or 0.1; s.Parent = SoundService; s:Play()
		game.Debris:AddItem(s, 1)
	end
end

local function getCleanTextLength(str)
	local cleanStr = string.gsub(str, "<[^>]+>", "")
	return utf8.len(cleanStr) or #cleanStr
end

local function typewrite(label, text, onComplete)
	if not label then return end
	label.RichText = true

	if currentDialogueJob then
		pcall(task.cancel, currentDialogueJob)
		currentDialogueJob = nil
	end

	label.Text = text
	label.MaxVisibleGraphemes = 0

	local len = getCleanTextLength(text)

	currentDialogueJob = task.spawn(function()
		for i = 1, len do
			if not isInteracting and not isLeaving then break end
			label.MaxVisibleGraphemes = i
			if i % 3 == 0 then
				local s = Instance.new("Sound", SoundService)
				s.SoundId = TYPING_SOUND_ID
				s.Volume = 0.1
				s.PlayOnRemove = true
				s:Destroy()
			end
			task.wait(TYPEWRITER_SPEED)
		end
		label.MaxVisibleGraphemes = -1

		currentDialogueJob = nil

		if onComplete and isInteracting then
			task.spawn(onComplete)
		end
	end)
end

local function stopInteraction()
	if not isInteracting and not isLeaving then return end

	isInteracting = false
	isLeaving = false
	promptDebounce = false  -- 🔒 Release prompt lock

	if currentDialogueJob then pcall(task.cancel, currentDialogueJob) end
	clearConnections()
	setFocusMode(false)

	camera.CameraType = Enum.CameraType.Custom
	if controls then controls:Enable() end

	if player.Character then
		local humanoid = player.Character:FindFirstChild("Humanoid")
		player:SetAttribute("MovementLock", false)
	end

	local myGui = playerGui:FindFirstChild(GUI_ID)
	if myGui then
		myGui.Enabled = false
		local container = myGui:FindFirstChild(CONTAINER_ID, true)
		if container then container.Visible = false end
	end
end

local function animateButton(btn)
	if btn:GetAttribute("HoverBound") then return end
	btn:SetAttribute("HoverBound", true)

	local uiScale = btn:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Scale = 1.0
		uiScale.Parent = btn
	end

	local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local isHovering = false
	local isPressed  = false
	local function updateScale()
		local target = 1.0
		if isPressed      then target = 0.95
		elseif isHovering then target = 1.05
		end
		TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
	end

	table.insert(buttonHoverConnections, btn.MouseEnter:Connect(function()
		isHovering = true
		UIAudioConfig.PlayHover()
		updateScale()
	end))
	table.insert(buttonHoverConnections, btn.MouseLeave:Connect(function()
		isHovering = false
		isPressed  = false
		updateScale()
	end))
	table.insert(buttonHoverConnections, btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = true
			updateScale()
		end
	end))
	table.insert(buttonHoverConnections, btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = false
			updateScale()
		end
	end))
end

local function startInteraction(npcModel)
	if isInteracting or isLeaving then return end

	isInteracting = true
	clearConnections()

	local camPart = npcModel:FindFirstChild(CAMERA_PART)
	if not camPart then
		warn("❌ [HarleyDebug] Error: Missing '"..CAMERA_PART.."'")
		isInteracting = false
		return
	end

	if controls then controls:Disable() end
	setFocusMode(true)

	if player.Character then
		local humanoid = player.Character:FindFirstChild("Humanoid")
		if humanoid then
			player:SetAttribute("MovementLock", true)
		end
	end

	camera.CameraType = Enum.CameraType.Scriptable
	TweenService:Create(camera, TWEEN_INFO, {CFrame = camPart.CFrame}):Play()

	local myGui = playerGui:WaitForChild(GUI_ID, 5)
	if not myGui then warn("❌ [HarleyDebug] Missing GUI") stopInteraction() return end

	myGui.Enabled = true
	local container = myGui:FindFirstChild(CONTAINER_ID, true)
	if not container then warn("❌ [HarleyDebug] Missing Frame") stopInteraction() return end

	container.Visible = true
	setButtonsState(false)

	local dialogueLabel = container:FindFirstChild(TEXT_ID, true)
	if dialogueLabel then

		-- COMMON STRINGS
		local coloredName = "<font color='" .. USER_COLOR .. "'>" .. player.DisplayName .. "</font>"
		local coloredJacob = "<font color='" .. JACOB_COLOR .. "'>Jacob</font>"

		-- REFINED LORE HIGHLIGHTS
		local timeHint1 = "<font color='" .. MYSTERY_COLOR .. "'>sun goes down</font>"
		local timeHint2 = "<font color='" .. MYSTERY_COLOR .. "'>once it gets dark</font>"
		local changeHint = "<font color='" .. MYSTERY_COLOR .. "'>tend to change</font>"
		local carHint = "<font color='" .. CAR_COLOR .. "'>rare cars</font>"

		-- INITIAL GREETING
		local greeting = "Welcome to the lot, " .. coloredName .. "."

		typewrite(dialogueLabel, greeting, function()
			setButtonsState(true)
		end)

		local function connectBtn(btnName, func)
			local btn = myGui:FindFirstChild(btnName, true)
			if btn and btn:IsA("GuiButton") then
				animateButton(btn)

				local conn = btn.MouseButton1Click:Connect(function()
					UIAudioConfig.PlayClick()
					func()
				end)
				table.insert(buttonConnections, conn)
			else
				warn("⚠️ [HarleyDebug] Warning: Could not find button '" .. btnName .. "' in UI.")
			end
		end

		-- 🔘 BUTTON: LEAVE
		connectBtn(BTN_LEAVE_ID, function()
			if isLeaving then return end
			isLeaving = true
			clearConnections()
			setButtonsState(false)

			if dialogueLabel then
				local goodbyeMsg = "<font color='" .. GREEN_COLOR .. "'>Alright then. Thanks for stopping by.</font>"
				typewrite(dialogueLabel, goodbyeMsg)
			end
			task.wait(LEAVE_DELAY)
			stopInteraction()
		end)

		-- 🔘 BUTTON: INQUIRY 1 (Identity)
		connectBtn(BTN_INQUIRY_ID, function()
			setButtonsState(false)

			if dialogueLabel then
				local coloredHarley = "<font color='" .. HARLEY_COLOR .. "'>Harley</font>"
				local response = "I'm " .. coloredHarley .. ". " .. coloredJacob .. "'s brother. Someone's gotta keep an eye on the place while he's… away."

				typewrite(dialogueLabel, response, function()
					setButtonsState(true)
				end)
			end
		end)

		-- 🔘 BUTTON: INQUIRY 2 (Refined Jacob Lore Cycle)
		connectBtn(BTN_INQUIRY2_ID, function()
			setButtonsState(false)

			if dialogueLabel then
				local cycleResponse = ""

				if interactionCycle == 1 then
					cycleResponse = coloredJacob .. "? Haven't seen him around today. Funny thing… whenever the " .. timeHint1 .. ", " .. carHint .. " start showing up in the lot and so does he. Strange coincidence, huh?"
				elseif interactionCycle == 2 then
					cycleResponse = "I already told you. I haven't seen him today. But for some reason… he always shows up " .. timeHint2 .. "."
				elseif interactionCycle == 3 then
					cycleResponse = "You're still asking about " .. coloredJacob .. "? …Look, I already told you. He's never around during the day. But " .. timeHint2 .. "… things around here " .. changeHint .. "."
				end

				-- Advance cycle (1 -> 2 -> 3 -> 1)
				interactionCycle = (interactionCycle % 3) + 1

				typewrite(dialogueLabel, cycleResponse, function()
					setButtonsState(true)
				end)
			end
		end)

	else
		warn("❌ [HarleyDebug] ERROR: Could not find TextLabel named '"..TEXT_ID.."' inside Container!")
		setButtonsState(true)
	end
end

local ProximityPromptService = game:GetService("ProximityPromptService")

local function setupNPC()
	ProximityPromptService.PromptTriggered:Connect(function(prompt, triggerPlayer)
		if triggerPlayer == player and prompt.Name == PROMPT_NAME then
			local npc = prompt.Parent and prompt.Parent.Parent
			if npc and npc.Name == TARGET_NPC then
				-- 🔒 Guard: prevent duplicate trigger events from double-firing
				if promptDebounce then return end
				promptDebounce = true
				startInteraction(npc)
			end
		end
	end)
end

setupNPC()

player.CharacterAdded:Connect(function()
	stopInteraction()
end)


