-- Purpose: Displays bank transfer limit progress/reset timer and prompts the skip developer product.
-- Runs on: Client
-- Location: StarterGui -> BankGui -> TransferFrame -> WithdrawalFunction -> BankTransferLimitClient
-- Dependencies: Players, MarketplaceService, ReplicatedStorage
-- Public API: None
-- Networking: Developer product prompt only; server receipt resets replicated transfer attributes.
-- Security: Display only. Server owns real transfer-limit enforcement and skip grants.
-- Performance: One lightweight timer update while the UI exists.

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local player = Players.LocalPlayer
local withdrawalFunction = script.Parent

local withdrawalLimitLabel = withdrawalFunction:WaitForChild("WithdrawalLimit", 5)
local skipButton = withdrawalFunction:WaitForChild("SkipButton", 5)

local SKIP_PRODUCT_ID = 3591736957
local RESET_SECONDS = 60 * 60
local DEFAULT_TRANSFER_LIMIT = 1000000000000
local TRANSFER_USED_ATTR = "BankTransferLimitUsed"
local TRANSFER_RESET_AT_ATTR = "BankTransferLimitResetAt"

local SUFFIXES = {"K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}

local function formatNumber(n)
	n = tonumber(n)
	if not n then return "0" end
	if n < 1000 then return tostring(math.floor(n)) end
	local i = math.floor(math.log(n, 1000))
	local v = 1000 ^ i
	local suffix = SUFFIXES[i] or "?"
	return string.format("%.2f%s", n / v, suffix)
end

local function formatTimer(seconds)
	seconds = math.clamp(math.ceil(seconds), 0, RESET_SECONDS)
	local minutes = math.max(1, math.ceil(seconds / 60))
	return string.format("%d:00", minutes)
end

local function getTransferLimit()
	return tonumber(player:GetAttribute("MaxBankWithdrawal")) or DEFAULT_TRANSFER_LIMIT
end

local function getTransferState()
	local used = math.max(0, tonumber(player:GetAttribute(TRANSFER_USED_ATTR)) or 0)
	local resetAt = tonumber(player:GetAttribute(TRANSFER_RESET_AT_ATTR)) or 0

	if resetAt > 0 and os.time() >= resetAt then
		used = 0
		resetAt = 0
	end

	return used, resetAt
end

local function updateLimitLabel()
	if not withdrawalLimitLabel then return end

	local used, resetAt = getTransferState()
	local limit = getTransferLimit()
	local text = formatNumber(used) .. " / " .. formatNumber(limit)

	if resetAt > 0 and used > 0 then
		text = text .. "  |  " .. formatTimer(resetAt - os.time())
	end

	withdrawalLimitLabel.Text = text
end

if skipButton then
	skipButton.MouseButton1Click:Connect(function()
		UIAudioConfig.PlayClick()
		MarketplaceService:PromptProductPurchase(player, SKIP_PRODUCT_ID)
	end)
end

player:GetAttributeChangedSignal("MaxBankWithdrawal"):Connect(updateLimitLabel)
player:GetAttributeChangedSignal(TRANSFER_USED_ATTR):Connect(updateLimitLabel)
player:GetAttributeChangedSignal(TRANSFER_RESET_AT_ATTR):Connect(updateLimitLabel)

updateLimitLabel()
while withdrawalFunction.Parent do
	updateLimitLabel()
	task.wait(1)
end
