-- One authoritative mapping for the permanent Robux-exclusive base-income boost.
CarStats.RobuxExclusiveBonusByRarity = {
	Common = 0.05,
	Uncommon = 0.075,
	Rare = 0.10,
	Epic = 0.125,
	Legendary = 0.15,
	Mythic = 0.20,
	Mythical = 0.20,
}

function CarStats.GetRobuxExclusiveBonus(carNameOrStats)
	local stats = typeof(carNameOrStats) == "table" and carNameOrStats or CarStats.GetCarStats(carNameOrStats)
	return stats and (CarStats.RobuxExclusiveBonusByRarity[stats.Rarity] or 0) or 0
end

function CarStats.ApplyRobuxExclusiveBonus(baseCPS, carNameOrStats, isExclusive)
	baseCPS = tonumber(baseCPS) or 0
	if isExclusive ~= true then return baseCPS end
	return baseCPS * (1 + CarStats.GetRobuxExclusiveBonus(carNameOrStats))
end

local normalizedCarLookup = {}

local function normalizeCarName(name)
	name = tostring(name or "")
	name = string.lower(name)
	name = name:gsub("%s+", "")
	name = name:gsub("%-", "")
	name = name:gsub("_", "")
	return name
end

for carId, stats in pairs(CarStats.Cars) do
	normalizedCarLookup[normalizeCarName(carId)] = carId
	if stats.Name then
		normalizedCarLookup[normalizeCarName(stats.Name)] = carId
	end
end

function CarStats.GetCarId(carName)
	if not carName then return nil end
	if CarStats.Cars[carName] then return carName end
	return normalizedCarLookup[normalizeCarName(carName)]
end

function CarStats.GetCarStats(carName)
	local carId = CarStats.GetCarId(carName)
	return carId and CarStats.Cars[carId] or nil, carId
end

function CarStats.IsMythicalCar(carNameOrStats)
	local stats = typeof(carNameOrStats) == "table" and carNameOrStats or CarStats.GetCarStats(carNameOrStats)
	return stats and stats.Rarity == "Mythic" and tonumber(stats.MythicalBestCarMultiplier) ~= nil
end

function CarStats.GetMythicalStrengthPercent(carNameOrStats)
	local stats = typeof(carNameOrStats) == "table" and carNameOrStats or CarStats.GetCarStats(carNameOrStats)
	local multiplier = stats and tonumber(stats.MythicalBestCarMultiplier)
	return multiplier and math.floor((multiplier * 100) + 0.5) or nil
end

function CarStats.CalculateEffectiveBaseCPS(carNameOrStats, bestPlacedBaseCPS)
	local stats = typeof(carNameOrStats) == "table" and carNameOrStats or CarStats.GetCarStats(carNameOrStats)
	if not stats then return nil end

	local baseCPS = tonumber(stats.CPS) or 0
	local mythicalMultiplier = tonumber(stats.MythicalBestCarMultiplier)
	if stats.Rarity ~= "Mythic" or not mythicalMultiplier then
		return baseCPS
	end

	local scaledCPS = (tonumber(bestPlacedBaseCPS) or 0) * mythicalMultiplier
	return math.max(baseCPS, scaledCPS)
end


function CarStats.CalculateOwnedCarBaseCPS(carNameOrStats, bestPlacedBaseCPS, isExclusive)
	local stats = typeof(carNameOrStats) == "table" and carNameOrStats or CarStats.GetCarStats(carNameOrStats)
	if not stats then return nil end
	local effectiveBase = CarStats.CalculateEffectiveBaseCPS(stats, bestPlacedBaseCPS)
	return CarStats.ApplyRobuxExclusiveBonus(effectiveBase, stats, isExclusive)
end

return CarStats
