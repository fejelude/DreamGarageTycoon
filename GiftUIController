-- ============================================================================
-- 🎥 DYNAMIC FOV TWEEN
-- ============================================================================
local function tweenFov(toFov)
	if not USE_CAMERA_FOV or not toFov then return end
	local currentCamera = Workspace.CurrentCamera 
	if not currentCamera then return end

	TweenService:Create(currentCamera, CAM_TWEEN_INFO, {FieldOfView = toFov}):Play()
end

-- ============================================================================
-- ✨ HOVER EFFECT
-- ============================================================================
local function addHover(btn)
	if not btn or btn:GetAttribute("HoverAdded") then return end
	btn:SetAttribute("HoverAdded", true)

	local uiScale = btn:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Scale = 1.0
		uiScale.Parent = btn
	end

	local isHovering = false
	local isPressed  = false
	local tweenInfo  = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	local function updateScale()
		local target = 1.0
		if isPressed     then target = 0.95
		elseif isHovering then target = 1.05
		end
		TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
	end

	btn.MouseEnter:Connect(function()
		isHovering = true
		UIAudioConfig.PlayHover()
		updateScale()
	end)
	btn.MouseLeave:Connect(function()
		isHovering = false
		isPressed  = false
		updateScale()
	end)
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = true
			updateScale()
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = false
			updateScale()
		end
	end)
end

