-- ============================================================================
local function closeAfterCommittedGift()
	task.delay(0.35, function()
		if mainFrame then
			mainFrame.Visible = false
		end
		if screenGui then
			screenGui.Enabled = false
		end
		if detector then
			detector.Visible = false
		end

		isMenuOpen = false
		clearGiftProductLabel()
		currentProductId = nil
		clearFocusConnections()
		toggleOtherGuis(false)
		toggleGiftFocusGuiObjects(false)
		setMovementLocked(false)
		tweenFov(normalFov)
	end)
end

MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, isPurchased)
	if userId ~= player.UserId or productId ~= pendingGiftProductId then return end

	if isPurchased then
		giftPromptInFlight = false
		waitingForGiftResult = true
		SetIndicator("Delivering gift...", Color3.fromRGB(255, 255, 100))

		local token = giftResultToken + 1
		giftResultToken = token
		task.delay(20, function()
			if waitingForGiftResult and pendingGiftProductId == productId and giftResultToken == token then
				SetIndicator("Still processing. Delivery will retry automatically.", Color3.fromRGB(255, 255, 100))
			end
		end)
	else
		cancelPendingGiftIntent(productId)
		resetGiftPurchaseState()
		SetIndicator("Purchase Cancelled", Color3.fromRGB(255, 85, 85))
		playSfx(SFX.Error, 0.6, screenGui)
	end
end)

GiftPurchaseResult.OnClientEvent:Connect(function(result)
	if type(result) ~= "table" then return end
	if result.ProductId ~= pendingGiftProductId then return end

	local receiverName = result.ReceiverName or currentTargetName
	resetGiftPurchaseState()

	if result.Success then
		SetIndicator("Gift sent to " .. receiverName .. "!", Color3.fromRGB(85, 255, 127))
		playSfx(SFX.Success, 0.6, screenGui)
		closeAfterCommittedGift()
	else
		SetIndicator(tostring(result.Message or "Gift could not be completed"), Color3.fromRGB(255, 85, 85))
		playSfx(SFX.Error, 0.6, screenGui)
	end
end)

