-- ============================================================================
-- 🔍 OWNERSHIP CHECK LOGIC
-- ============================================================================
local function GetSkinNameFromProductId(productId)
	local appearance = BaseAppearanceConfig.GetByProductId(productId)
	if appearance then return appearance.OwnershipKey end
	if not BaseSkinStats or not productId then return nil end
	for skinName, data in pairs(BaseSkinStats) do
		if data.ProductId == productId then
			return skinName
		end
	end
	return nil
end

local function DoesPlayerOwnSkin(targetPlayer, skinName)
	if not skinName then return false end
	local level, appearanceId = skinName:match("^Level(%d+):(.+)$")
	if level then
		local ok, owned = pcall(HttpService.JSONDecode, HttpService, targetPlayer:GetAttribute("OwnedAppearanceSkins") or "{}")
		local list = ok and owned[tostring(tonumber(level))]
		return type(list) == "table" and table.find(list, appearanceId) ~= nil
	end
	local ownedRaw = targetPlayer:GetAttribute("OwnedBaseSkins")
	if not ownedRaw then return false end

	local success, ownedTable = pcall(function()
		return HttpService:JSONDecode(ownedRaw)
	end)

	if success and type(ownedTable) == "table" then
		return table.find(ownedTable, skinName) ~= nil
	end
	return false
end

-- ============================================================================
-- 👁️ GUI HIDING
-- ============================================================================
local function rememberAndHideGiftFocusInstance(instance)
	if not instance or not instance.Parent or instance == screenGui then
		return
	end

	if screenGui and instance:IsDescendantOf(screenGui) then
		return
	end

	if hiddenBonusWidgets[instance] then
		return
	end

	if instance:IsA("ScreenGui") then
		if not instance.Enabled then return end
		hiddenBonusWidgets[instance] = { Enabled = instance.Enabled }
		instance.Enabled = false
	elseif instance:IsA("GuiObject") then
		if not instance.Visible then return end
		hiddenBonusWidgets[instance] = { Visible = instance.Visible }
		instance.Visible = false
	end
end

local function restoreGiftFocusInstances()
	for instance, state in pairs(hiddenBonusWidgets) do
		if instance and instance.Parent then
			if instance:IsA("ScreenGui") and state.Enabled ~= nil then
				instance.Enabled = state.Enabled
			elseif instance:IsA("GuiObject") and state.Visible ~= nil then
				instance.Visible = state.Visible
			end
		end
	end
	table.clear(hiddenBonusWidgets)
	table.clear(hiddenObjects)
end

local function getBonusScriptContainer(scriptInstance)
	if not scriptInstance then return nil end

	local current = scriptInstance.Parent
	local firstGuiObject = nil
	local firstScreenGui = nil

	while current and current ~= PlayerGui do
		if current:IsA("GuiObject") then
			firstGuiObject = current
		elseif current:IsA("ScreenGui") then
			firstScreenGui = current
			break
		end

		current = current.Parent
	end

	return firstScreenGui or firstGuiObject
end
local function toggleNamedGuiObjects(shouldHide, objectName)
	if shouldHide then
		for _, obj in pairs(PlayerGui:GetDescendants()) do
			if obj:IsA("GuiObject") and obj.Name == objectName then
				rememberAndHideGiftFocusInstance(obj)
			end
		end
	else
		restoreGiftFocusInstances()
	end
end


local function isGiftFocusBonusWidget(obj)
	if not obj:IsA("GuiObject") or not obj.Visible or obj:IsDescendantOf(screenGui) then
		return false
	end

	local lowerName = string.lower(obj.Name)
	if string.find(lowerName, "premium", 1, true) then
		return true
	end

	if string.find(lowerName, "friend", 1, true)
		and (string.find(lowerName, "boost", 1, true) or string.find(lowerName, "bonus", 1, true)) then
		return true
	end

	return obj:FindFirstChild("PremiumBonusClient", true) ~= nil
		or obj:FindFirstChild("FriendBonusClient", true) ~= nil
end

local function toggleDetectedGiftFocusBonusWidgets(shouldHide)
	if not shouldHide then return end

	for _, obj in pairs(PlayerGui:GetDescendants()) do
		if isGiftFocusBonusWidget(obj) then
			rememberAndHideGiftFocusInstance(obj)
		end
	end

	for scriptName in pairs(GIFT_FOCUS_SCRIPT_NAMES_TO_HIDE) do
		local scriptInstance = PlayerGui:FindFirstChild(scriptName, true)
		rememberAndHideGiftFocusInstance(getBonusScriptContainer(scriptInstance))
	end
end

local function toggleGiftFocusGuiObjects(shouldHide)
	if shouldHide then
		for _, objectName in ipairs(GIFT_FOCUS_GUI_OBJECTS_TO_HIDE) do
			toggleNamedGuiObjects(true, objectName)
		end

		toggleDetectedGiftFocusBonusWidgets(true)
	else
		restoreGiftFocusInstances()
	end
end

local function clearFocusConnections()
	for _, connection in ipairs(focusConnections) do
		if connection then connection:Disconnect() end
	end
	table.clear(focusConnections)
	table.clear(watchedFocusGuis)
end

local function shouldIgnoreGiftFocusGui(gui)
	return not gui:IsA("ScreenGui")
		or gui == screenGui
		or gui.Name == "Confirmation"
		or gui.Name == "PurchasingState"
end

local function hideGuiForGiftFocus(gui)
	if shouldIgnoreGiftFocusGui(gui) then return end
	if gui.Enabled then
		hiddenGuis[gui] = true
		gui.Enabled = false
	end
end

local function watchGiftFocusGui(gui)
	if shouldIgnoreGiftFocusGui(gui) or watchedFocusGuis[gui] then return end
	watchedFocusGuis[gui] = true
	table.insert(focusConnections, gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if gui.Enabled then
			hideGuiForGiftFocus(gui)
		end
	end))
end

local function toggleOtherGuis(shouldHide)
	if shouldHide then
		clearFocusConnections()
		table.clear(hiddenGuis)
		for _, gui in pairs(PlayerGui:GetDescendants()) do
			watchGiftFocusGui(gui)
			hideGuiForGiftFocus(gui)
		end

		table.insert(focusConnections, PlayerGui.DescendantAdded:Connect(function(descendant)
			task.defer(function()
				if descendant and descendant.Parent then
					watchGiftFocusGui(descendant)
					hideGuiForGiftFocus(descendant)
				end
			end)
		end))
	else
		clearFocusConnections()
		for gui in pairs(hiddenGuis) do
			if gui and gui.Parent then
				gui.Enabled = true
			end
		end
		table.clear(hiddenGuis)
	end
end

