-- ============================================================================
-- 🔍 OWNERSHIP CHECK LOGIC
-- ============================================================================
local function GetSkinNameFromProductId(productId)
	if not BaseSkinStats or not productId then return nil end
	for skinName, data in pairs(BaseSkinStats) do
		if data.ProductId == productId then
			return skinName
		end
	end
	return nil
end

local function DoesPlayerOwnSkin(targetPlayer, skinName)
	if not skinName then return false end
	local ownedRaw = targetPlayer:GetAttribute("OwnedBaseSkins")
	if not ownedRaw then return false end

	local success, ownedTable = pcall(function()
		return HttpService:JSONDecode(ownedRaw)
	end)

	if success and type(ownedTable) == "table" then
		return table.find(ownedTable, skinName) ~= nil
	end
	return false
end

-- ============================================================================
-- 👁️ GUI HIDING
-- ============================================================================
local function toggleNamedGuiObjects(shouldHide, objectName)
	if shouldHide then
		for _, obj in pairs(PlayerGui:GetDescendants()) do
			if obj:IsA("GuiObject")
				and obj.Name == objectName
				and obj.Visible
				and not obj:IsDescendantOf(screenGui) then

				obj.Visible = false
				table.insert(hiddenObjects, obj)
			end
		end
	else
		for _, obj in ipairs(hiddenObjects) do
			if obj and obj.Parent and obj:IsA("GuiObject") then
				obj.Visible = true
			end
		end
		table.clear(hiddenObjects)
	end
end


local function isGiftFocusBonusWidget(obj)
	if not obj:IsA("GuiObject") or not obj.Visible or obj:IsDescendantOf(screenGui) then
		return false
	end

	local lowerName = string.lower(obj.Name)
	if string.find(lowerName, "premium", 1, true) then
		return true
	end

	if string.find(lowerName, "friend", 1, true)
		and (string.find(lowerName, "boost", 1, true) or string.find(lowerName, "bonus", 1, true)) then
		return true
	end

	return obj:FindFirstChild("PremiumBonusClient", true) ~= nil
		or obj:FindFirstChild("FriendBonusClient", true) ~= nil
end

local function toggleDetectedGiftFocusBonusWidgets(shouldHide)
	if not shouldHide then return end

	for _, obj in pairs(PlayerGui:GetDescendants()) do
		if isGiftFocusBonusWidget(obj) then
			obj.Visible = false
			table.insert(hiddenObjects, obj)
		end
	end

	for scriptName in pairs(GIFT_FOCUS_SCRIPT_NAMES_TO_HIDE) do
		local scriptInstance = PlayerGui:FindFirstChild(scriptName, true)
		local parent = scriptInstance and scriptInstance.Parent
		if parent and parent:IsA("GuiObject") and parent.Visible and not parent:IsDescendantOf(screenGui) then
			parent.Visible = false
			table.insert(hiddenObjects, parent)
		end
	end
end

local function toggleGiftFocusGuiObjects(shouldHide)
	for _, objectName in ipairs(GIFT_FOCUS_GUI_OBJECTS_TO_HIDE) do
		toggleNamedGuiObjects(shouldHide, objectName)
	end

	toggleDetectedGiftFocusBonusWidgets(shouldHide)
end

local function toggleOtherGuis(shouldHide)
	if shouldHide then
		if next(hiddenGuis) ~= nil then return end
		table.clear(hiddenGuis)
		for _, gui in pairs(PlayerGui:GetChildren()) do
			if gui:IsA("ScreenGui")
				and gui ~= screenGui
				and gui.Name ~= "Confirmation"
				and gui.Enabled then

				gui.Enabled = false
				hiddenGuis[gui] = true
			end
		end
	else
		for gui in pairs(hiddenGuis) do
			if gui and gui.Parent then
				gui.Enabled = true
			end
		end
		table.clear(hiddenGuis)
	end
end

