local function setFocusMode(isFocused)
	if not screenGui or not mainFrame then return end
	if isMenuOpen == isFocused then return end 

	isMenuOpen = isFocused
	detector.Visible = isFocused

	if isFocused then
		screenGui.Enabled = true
		mainFrame.Visible = true
		toggleOtherGuis(true)
		toggleGiftFocusGuiObjects(true)
		setMovementLocked(true)
		tweenFov(openFov)
	else
		clearGiftProductLabel()
		currentProductId = nil
		mainFrame.Visible = false
		screenGui.Enabled = false
		toggleOtherGuis(false)
		toggleGiftFocusGuiObjects(false)
		setMovementLocked(false)
		tweenFov(normalFov)
	end
end

-- ============================================================================
-- 🔄 UI REFRESH
-- ============================================================================
local function UpdateSlots()
	if not mainFrame then return end

	local validPlayers = {}
	for _, p in pairs(Players:GetPlayers()) do
		if p ~= player then
			table.insert(validPlayers, p)
		end
	end

	local standardIndicator = mainFrame:FindFirstChild("Indicator")

	if #validPlayers == 0 then
		if emptyIndicator then
			ensureEmptyFX(emptyIndicator)
			emptyIndicator.Text = "No One To Gift In THIS SERVER :("
			emptyIndicator.Visible = true
		end
		if standardIndicator then standardIndicator.Visible = false end
	else
		if emptyIndicator then emptyIndicator.Visible = false end
		if standardIndicator then standardIndicator.Visible = true end
	end

	local targetSkinName = GetSkinNameFromProductId(currentProductId)

	for i = 1, 5 do
		local slotFrame = mainFrame:FindFirstChild("Player" .. i)
		if slotFrame then
			local target = validPlayers[i]
			if target then
				slotFrame.Visible = true

				local nameLbl = slotFrame:FindFirstChild("PlayerName")
				local avatarImg = slotFrame:FindFirstChild("PlayerAvatar")
				local giftBtn = slotFrame:FindFirstChild("GiftThePlayer")
				local alreadyOwnedBtn = slotFrame:FindFirstChild("AlreadyOwned")

				if nameLbl then nameLbl.Text = target.Name end
				if avatarImg then
					avatarImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. target.UserId .. "&w=150&h=150"
				end

				local alreadyOwnsIt = DoesPlayerOwnSkin(target, targetSkinName)

				if alreadyOwnedBtn then alreadyOwnedBtn.Visible = alreadyOwnsIt end
				if giftBtn then giftBtn.Visible = not alreadyOwnsIt end

				if giftBtn and not alreadyOwnsIt then
					addHover(giftBtn)

					if btnConnections[i] then
						btnConnections[i]:Disconnect()
						btnConnections[i] = nil
					end

					-- FIX: Capture target in a local to prevent stale closure references
					local capturedTarget = target
					btnConnections[i] = giftBtn.MouseButton1Click:Connect(function()
						if not currentProductId or giftBtn:GetAttribute("Cooldown") or giftPromptInFlight or waitingForGiftResult then return end

						-- FIX: Verify the target player is still in the server
						if not capturedTarget or not capturedTarget.Parent then
							SetIndicator("Player has left the server", Color3.fromRGB(255, 85, 85))
							return
						end

						giftBtn:SetAttribute("Cooldown", true)
						task.delay(1, function() giftBtn:SetAttribute("Cooldown", false) end)

						local productId = currentProductId
						giftPromptInFlight = true
						currentTargetName = capturedTarget.Name
						pendingGiftProductId = productId
						pendingGiftReceiverId = capturedTarget.UserId
						SetIndicator("Preparing gift...", Color3.fromRGB(255, 255, 100))
						UIAudioConfig.PlayRobux()
						UIAudioConfig.ShowPurchaseLoading()

						local intentOk, accepted, message = pcall(function()
							return CreateIntentFunction:InvokeServer(productId, capturedTarget.UserId)
						end)

						if not intentOk or accepted ~= true then
							resetGiftPurchaseState()
							UIAudioConfig.HidePurchaseLoading()
							SetIndicator(tostring(message or accepted or "Gift unavailable"), Color3.fromRGB(255, 85, 85))
							playSfx(SFX.Error, 0.6, screenGui)
							return
						end

						SetIndicator("Opening purchase...", Color3.fromRGB(255, 255, 100))

						local promptOk, promptErr = pcall(function()
							MarketplaceService:PromptProductPurchase(player, productId)
						end)

						if not promptOk then
							cancelPendingGiftIntent(productId)
							resetGiftPurchaseState()
							UIAudioConfig.HidePurchaseLoading()
							SetIndicator("Purchase prompt failed", Color3.fromRGB(255, 85, 85))
							warn("Gift purchase prompt failed:", promptErr)
						end
					end)
				elseif btnConnections[i] then
					btnConnections[i]:Disconnect()
					btnConnections[i] = nil
				end
			else
				slotFrame.Visible = false
			end
		end
	end
end

