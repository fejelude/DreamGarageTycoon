-- [[ SERVER SCRIPT: TycoonEconomy (Friend Bonus + Accumulator Fix + SKINS) ]]
-- [[ UPDATED: Added Friend Multiplier (10% per friend, max 50%) ]]
-- [[ UPDATED: Added Skin Multiplier (e.g. 25% for Gold) ]]
-- [[ FIXES: "Zero Income" Bug, Name Mismatch Lookup, API Lag Prevention ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))
local BaseSkinStats = require(ReplicatedStorage:WaitForChild("BaseSkinStats")) -- ✅ Added Module
local TycoonFolder = Workspace:WaitForChild("Tycoons")

local dedicatedFolder = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")

local PAY_INTERVAL = 1
local profitAccumulator = {} 
local FriendCache = {} -- [UserId] = { [FriendId] = true }

-- ============================================================================
-- 🏎️ CAR STATS LOOKUP CACHE (O(1) Access)
-- ============================================================================
local CarLookup = {}
for id, stats in pairs(CarStats.Cars) do
	-- Since multiple cars can have the same real "Name" (e.g. "Toyota Hilux"),
	-- we strictly use their unique dictionary ID keys (e.g. "Rustix", "Ricky", "Ironclad") to avoid collisions!
	CarLookup[id] = stats
end

-- ============================================================================
-- 👥 FRIEND BONUS SYSTEM (OPTIMIZED O(N))
-- ============================================================================

local function updateMultiplier(player)
	if not player or not FriendCache[player.UserId] then return end

	local count = 0
	for _ in pairs(FriendCache[player.UserId]) do count += 1 end

	local clamped = math.min(count, 5)

	-- 1 friend = 10%, 2 = 25%, 3 = 50%, 4 = 75%, 5 = 100%
	local friendBoostPercentages = {
		[1] = 0.10,
		[2] = 0.25,
		[3] = 0.50,
		[4] = 0.75,
		[5] = 1.00
	}

	local boost = 0
	if clamped > 0 then
		boost = friendBoostPercentages[clamped] or 0
	end

	local mult = 1 + boost

	player:SetAttribute("ActiveFriends", count)
	player:SetAttribute("FriendMultiplier", mult)
end

local function onPlayerAdded(player)
	local uid = player.UserId
	FriendCache[uid] = {}

	task.spawn(function()
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player then
				local oid = other.UserId
				local success, isFriend = pcall(function() return player:IsFriendsWith(oid) end)

				if success and isFriend then
					-- Add to BOTH caches
					if FriendCache[uid] then FriendCache[uid][oid] = true end
					if FriendCache[oid] then FriendCache[oid][uid] = true end

					updateMultiplier(player)
					updateMultiplier(other)
				end
			end
		end
		updateMultiplier(player) -- Ensure init even with 0 friends
	end)
end

local function onPlayerRemoving(player)
	local uid = player.UserId
	if FriendCache[uid] then
		for friendId, _ in pairs(FriendCache[uid]) do
			local friend = Players:GetPlayerByUserId(friendId)
			if friend and FriendCache[friendId] then
				FriendCache[friendId][uid] = nil
				updateMultiplier(friend)
			end
		end
		FriendCache[uid] = nil
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Init existing
for _, p in ipairs(Players:GetPlayers()) do onPlayerAdded(p) end

-- ============================================================================
-- 🏆 SKIN MULTIPLIER HELPER
-- ============================================================================
local function GetSkinMultiplier(player)
	if not player then return 1 end

	-- Read the attribute set by TransactionHandler/DataHandler
	local skinName = player:GetAttribute("EquippedSkin")

	if skinName and BaseSkinStats[skinName] then
		return BaseSkinStats[skinName].Multiplier or 1
	end
	return 1 -- Default (No Boost)
end

-- ============================================================================
-- 💰 MAIN ECONOMY LOOP
-- ============================================================================

TycoonFolder.ChildRemoved:Connect(function(plot)
	if profitAccumulator[plot] then
		profitAccumulator[plot] = nil
	end
end)

local function getLinkedCarValue(pad)
	local direct = pad:FindFirstChild("LinkedCar")
	if direct then return direct.Value end

	if pad:IsA("Model") and pad.PrimaryPart then
		local prim = pad.PrimaryPart:FindFirstChild("LinkedCar")
		if prim then return prim.Value end
	end

	for _, child in pairs(pad:GetChildren()) do
		local val = child:FindFirstChild("LinkedCar")
		if val then return val.Value end
	end
	return nil
end

-- Helper to gather all pads from a Level Folder
local function processPadsInFolder(padsFolder)
	local folderCPS = 0
	if not padsFolder then return folderCPS end

	for _, pad in pairs(padsFolder:GetChildren()) do
		local linkedCar = getLinkedCarValue(pad)

		if linkedCar and linkedCar.Parent then
			-- [[ AUDIT FIX: O(1) LOOKUP ]]
			local stats = CarLookup[linkedCar.Name]

			if stats then
				folderCPS = folderCPS + stats.CPS
			else
				if not pad:GetAttribute("WarnedMissing") then
					warn("⚠️ Economy Warning: No stats found for '" .. linkedCar.Name .. "'")
					pad:SetAttribute("WarnedMissing", true)
				end
			end
		end
	end
	return folderCPS
end

task.spawn(function()
	print("💰 TycoonEconomy: System Active & Monitoring...")

	while true do
		task.wait(PAY_INTERVAL)

		for _, plot in pairs(TycoonFolder:GetChildren()) do
			local pendingValue = plot:FindFirstChild("PendingEarnings")
			local ownerValue = plot:FindFirstChild("Owner") -- Needed to find the player

			if pendingValue then
				local plotTotalCPS = 0

				-- 1. Calculate Base Income from ACTIVE Level Only
				local playerBaseLevel = 1
				if ownerValue and ownerValue.Value ~= "" then
					local player = Players:FindFirstChild(ownerValue.Value)
					if player then
						playerBaseLevel = tonumber(player:GetAttribute("BaseLevel")) or 1
					end
				end

				local activeLevelFolder = nil

				if playerBaseLevel == 1 then
					activeLevelFolder = plot:FindFirstChild("Level1") or plot:FindFirstChild("Level 1")
					if not activeLevelFolder and dedicatedFolder and dedicatedFolder:FindFirstChild(plot.Name) then
						activeLevelFolder = dedicatedFolder[plot.Name]:FindFirstChild("Level1") or dedicatedFolder[plot.Name]:FindFirstChild("Level 1")
					end
				elseif playerBaseLevel == 2 then
					activeLevelFolder = plot:FindFirstChild("Level2") or plot:FindFirstChild("Level 2")
					if not activeLevelFolder and dedicatedFolder and dedicatedFolder:FindFirstChild(plot.Name) then
						activeLevelFolder = dedicatedFolder[plot.Name]:FindFirstChild("Level2") or dedicatedFolder[plot.Name]:FindFirstChild("Level 2")
					end
				else
					warn("⚠️ TycoonEconomy: Unhandled BaseLevel " .. tostring(playerBaseLevel) .. " for plot " .. plot.Name)
				end

				if activeLevelFolder then 
					plotTotalCPS = plotTotalCPS + processPadsInFolder(activeLevelFolder:FindFirstChild("Pads")) 
				end

				-- 2. Apply Multipliers (Friends + Premium + Skins)
				local friendMultiplier = 1
				local premiumMultiplier = 1
				local skinMultiplier = 1
				local rankMultiplier = 1

				if ownerValue and ownerValue.Value ~= "" then
					local player = Players:FindFirstChild(ownerValue.Value)
					if player then
						-- A. Friend Bonus
						local bonus = player:GetAttribute("FriendMultiplier")
						if bonus then friendMultiplier = bonus end

						-- B. Premium Bonus
						if player.MembershipType == Enum.MembershipType.Premium then
							premiumMultiplier = 1.5 -- +50% bonus
						end

						-- C. Skin Bonus (Gold Upgrade) ✅ NEW
						skinMultiplier = GetSkinMultiplier(player)

						-- D. Rank milestone bonus (VIP through MVP++)
						rankMultiplier = tonumber(player:GetAttribute("RankResourceMultiplier")) or 1
					end
				end

				-- Apply the bonuses: ((((Base * Friend) * Premium) * Skin) * Rank)
				-- Example: ((((100 CPS * 1.5 Friend) * 1.5 Premium) * 1.25 Gold) * 2 VIP)
				plotTotalCPS = (((plotTotalCPS * friendMultiplier) * premiumMultiplier) * skinMultiplier) * rankMultiplier

				-- Update attribute so TabletHandler sees the Boosted CPS (before AFK)
				plot:SetAttribute("CurrentCPS", plotTotalCPS)

				-- 3. AFK Bonus & Accumulate
				-- If AFK, multiply their earnings payout by 2.
				local payoutCPS = plotTotalCPS
				if plot:GetAttribute("IsAFK") == true then
					payoutCPS = payoutCPS * 2
				end

				if not profitAccumulator[plot] then profitAccumulator[plot] = 0 end
				profitAccumulator[plot] = profitAccumulator[plot] + payoutCPS

				local payout = math.floor(profitAccumulator[plot])

				if payout > 0 then
					pendingValue.Value = pendingValue.Value + payout
					profitAccumulator[plot] = profitAccumulator[plot] - payout
				end
			else
				if profitAccumulator[plot] then profitAccumulator[plot] = nil end
			end
		end
	end
end)
