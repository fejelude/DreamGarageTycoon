-- ============================================================================

TycoonFolder.ChildRemoved:Connect(function(plot)
	if profitAccumulator[plot] then
		profitAccumulator[plot] = nil
	end
end)

local function getLinkedCarValue(pad)
	local direct = pad:FindFirstChild("LinkedCar")
	if direct then return direct.Value end

	if pad:IsA("Model") and pad.PrimaryPart then
		local prim = pad.PrimaryPart:FindFirstChild("LinkedCar")
		if prim then return prim.Value end
	end

	for _, child in pairs(pad:GetChildren()) do
		local val = child:FindFirstChild("LinkedCar")
		if val then return val.Value end
	end
	return nil
end

local function getPlacedCarsInFolder(padsFolder)
	local placedCars = {}
	if not padsFolder then return placedCars end

	for _, pad in pairs(padsFolder:GetChildren()) do
		local linkedCar = getLinkedCarValue(pad)
		if linkedCar and linkedCar.Parent then
			table.insert(placedCars, { Pad = pad, Car = linkedCar })
		end
	end

	return placedCars
end

local function getBestPlacedBaseCPS(placedCars)
	local bestBaseCPS = 0

	for _, placed in ipairs(placedCars) do
		local stats = getCarStats(placed.Car)
		if stats and not CarStats.IsMythicalCar(stats) then
			bestBaseCPS = math.max(bestBaseCPS, tonumber(stats.CPS) or 0)
		end
	end

	return bestBaseCPS
end

-- Helper to gather all pads from a Level Folder. Mythical cars use the best
-- non-Mythical car currently placed in this same active base level, not inventory.
local function processPadsInFolder(padsFolder)
	local folderCPS = 0
	local placedCars = getPlacedCarsInFolder(padsFolder)
	local bestPlacedBaseCPS = getBestPlacedBaseCPS(placedCars)

	for _, placed in ipairs(placedCars) do
		local linkedCar = placed.Car
		local stats = getCarStats(linkedCar)

		if stats then
			folderCPS = folderCPS + CarStats.CalculateEffectiveBaseCPS(stats, bestPlacedBaseCPS)
		else
			local pad = placed.Pad
			if not pad:GetAttribute("WarnedMissing") then
				warn("⚠️ Economy Warning: No stats found for '" .. linkedCar.Name .. "'")
				pad:SetAttribute("WarnedMissing", true)
			end
		end
	end

	return folderCPS
end

local function processPlot(plot, elapsedSeconds)
	local pendingValue = plot:FindFirstChild("PendingEarnings")
	local ownerValue = plot:FindFirstChild("Owner")
	if not pendingValue or not ownerValue or ownerValue.Value == "" then
		profitAccumulator[plot] = nil
		plot:SetAttribute("CurrentCPS", 0)
		plot:SetAttribute("PermanentCPS", 0)
		return
	end

	local player = Players:FindFirstChild(ownerValue.Value)
	if not player then
		profitAccumulator[plot] = nil
		return
	end

	local playerBaseLevel = math.floor(tonumber(player:GetAttribute("BaseLevel")) or 1)
	local activeLevelFolder
	if playerBaseLevel == 1 then
		activeLevelFolder = plot:FindFirstChild("NormalLevel1")
		if not activeLevelFolder and dedicatedFolder and dedicatedFolder:FindFirstChild(plot.Name) then
			activeLevelFolder = dedicatedFolder[plot.Name]:FindFirstChild("NormalLevel1")
		end
	elseif playerBaseLevel == 2 then
		activeLevelFolder = plot:FindFirstChild("NormalLevel2")
		if not activeLevelFolder and dedicatedFolder and dedicatedFolder:FindFirstChild(plot.Name) then
			activeLevelFolder = dedicatedFolder[plot.Name]:FindFirstChild("NormalLevel2")
		end
	else
		warn("⚠️ TycoonEconomy: Unhandled BaseLevel " .. tostring(playerBaseLevel) .. " for plot " .. plot.Name)
	end

	local baseCPS = 0
	if activeLevelFolder then
		baseCPS = processPadsInFolder(activeLevelFolder.Parent:FindFirstChild("Pads"))
	end

	local permanentCPS = baseCPS * GetPermanentEarningsMultiplier(player)
	local plotTotalCPS = permanentCPS * GlobalMoneyFrenzyService.GetMultiplier()
	player:SetAttribute("ActualEarningsMultiplier", GetActualEarningsMultiplier(player))
	plot:SetAttribute("PermanentCPS", permanentCPS)
	plot:SetAttribute("CurrentCPS", plotTotalCPS)

	local payoutCPS = plotTotalCPS
	if plot:GetAttribute("IsAFK") == true then
		payoutCPS *= GetAFKPayoutMultiplier()
	end

	local accumulator = profitAccumulator[plot]
	if not accumulator or accumulator.OwnerUserId ~= player.UserId then
		accumulator = { OwnerUserId = player.UserId, Amount = 0 }
		profitAccumulator[plot] = accumulator
	end
	accumulator.Amount += payoutCPS * elapsedSeconds

	local payout = math.floor(accumulator.Amount)
	if payout > 0 and not profitPayoutInFlight[plot] then
		profitPayoutInFlight[plot] = true
		task.spawn(function()
			local applied = PlayerTransactionCoordinator.Run(player, "AccrueTycoonEarnings", function()
				if player.Parent ~= Players or ownerValue.Value ~= player.Name then return false end
				pendingValue.Value = math.max(0, tonumber(pendingValue.Value) or 0) + payout
				local now = os.clock()
				if now - (lastDirtyAtByUserId[player.UserId] or 0) >= 15 then
					lastDirtyAtByUserId[player.UserId] = now
					pcall(function() TycoonAdminAPI:Invoke("MarkDirty", player) end)
				end
				return true
			end, 2)
			if applied and profitAccumulator[plot] == accumulator
				and accumulator.OwnerUserId == player.UserId
			then
				accumulator.Amount = math.max(0, accumulator.Amount - payout)
			end
			profitPayoutInFlight[plot] = nil
		end)
	end
end

task.spawn(function()
	print("💰 TycoonEconomy: System Active & Monitoring...")
	local lastTick = os.clock()
	while true do
		task.wait(PAY_INTERVAL)
		local now = os.clock()
		local elapsedSeconds = math.clamp(now - lastTick, 0, 5)
		lastTick = now

		for _, plot in ipairs(TycoonFolder:GetChildren()) do
			local ok, err = xpcall(function()
				processPlot(plot, elapsedSeconds)
			end, debug.traceback)
			if not ok then
				warn("[TycoonEconomy] Plot calculation failed for " .. plot:GetFullName() .. ": " .. tostring(err))
			end
		end
	end
end)
