-- [[ SERVER SCRIPT: TycoonEconomy (Friend Bonus + Accumulator Fix + SKINS) ]]
-- [[ UPDATED: Added Friend Multiplier (10% per friend, max 50%) ]]
-- [[ UPDATED: Added Skin Multiplier (e.g. 25% for Gold) ]]
-- [[ UPDATED: Multiplier sources now stack additively instead of exponentially. ]]
-- [[ FIXES: "Zero Income" Bug, Name Mismatch Lookup, API Lag Prevention ]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))
local BaseSkinStats = require(ReplicatedStorage:WaitForChild("BaseSkinStats")) -- ✅ Added Module
local ServerScriptService = game:GetService("ServerScriptService")
local GlobalMoneyFrenzyService = require(ServerScriptService:WaitForChild("GlobalMoneyFrenzyService"))
local GamePassOwnershipService = require(ServerScriptService:WaitForChild("GamePassOwnershipService"))
local TycoonFolder = Workspace:WaitForChild("Tycoons")

local dedicatedFolder = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")

local PAY_INTERVAL = 1
local profitAccumulator = {} 
local FriendCache = {} -- [UserId] = { [FriendId] = true }

-- ============================================================================
-- 🏎️ CAR STATS LOOKUP CACHE (O(1) Access)
-- ============================================================================
local CarLookup = {}
for id, stats in pairs(CarStats.Cars) do
	-- Since multiple cars can have the same real "Name" (e.g. "Toyota Hilux"),
	-- keep direct ID lookups fast while falling back through CarStats.GetCarStats for model-name lookups.
	CarLookup[id] = stats
end

local function getCarStats(carName)
	return CarLookup[carName] or (CarStats.GetCarStats and CarStats.GetCarStats(carName))
end

-- ============================================================================
-- 👥 FRIEND BONUS SYSTEM (OPTIMIZED O(N))
-- ============================================================================

local function updateMultiplier(player)
	if not player or not FriendCache[player.UserId] then return end

	local count = 0
	for _ in pairs(FriendCache[player.UserId]) do count += 1 end

	local clamped = math.min(count, 5)

	-- 1 friend = 10%, 2 = 25%, 3 = 50%, 4 = 75%, 5 = 100%
	local friendBoostPercentages = {
		[1] = 0.10,
		[2] = 0.25,
		[3] = 0.50,
		[4] = 0.75,
		[5] = 1.00
	}

	local boost = 0
	if clamped > 0 then
		boost = friendBoostPercentages[clamped] or 0
	end

	local mult = 1 + boost

	player:SetAttribute("ActiveFriends", count)
	player:SetAttribute("FriendMultiplier", mult)
end

local function onPlayerAdded(player)
	local uid = player.UserId
	FriendCache[uid] = {}

	task.spawn(function()
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player then
				local oid = other.UserId
				local success, isFriend = pcall(function() return player:IsFriendsWith(oid) end)

				if success and isFriend then
					-- Add to BOTH caches
					if FriendCache[uid] then FriendCache[uid][oid] = true end
					if FriendCache[oid] then FriendCache[oid][uid] = true end

					updateMultiplier(player)
					updateMultiplier(other)
				end
			end
		end
		updateMultiplier(player) -- Ensure init even with 0 friends
	end)
end

local function onPlayerRemoving(player)
	local uid = player.UserId
	if FriendCache[uid] then
		for friendId, _ in pairs(FriendCache[uid]) do
			local friend = Players:GetPlayerByUserId(friendId)
			if friend and FriendCache[friendId] then
				FriendCache[friendId][uid] = nil
				updateMultiplier(friend)
			end
		end
		FriendCache[uid] = nil
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Init existing
for _, p in ipairs(Players:GetPlayers()) do onPlayerAdded(p) end

-- ============================================================================
-- 🏆 SKIN MULTIPLIER HELPER
-- ============================================================================
local function GetSkinMultiplier(player)
	if not player then return 1 end

	-- Read the attribute set by TransactionHandler/DataHandler
	local skinName = player:GetAttribute("EquippedSkin")

	if skinName and BaseSkinStats[skinName] then
		return BaseSkinStats[skinName].Multiplier or 1
	end
	return 1 -- Default (No Boost)
end

local function getPositiveMultiplierContribution(multiplier, noBoostMultiplier)
	multiplier = tonumber(multiplier) or noBoostMultiplier
	noBoostMultiplier = tonumber(noBoostMultiplier) or 1

	if multiplier <= noBoostMultiplier then
		return 0
	end

	return multiplier
end

local function getRebirthMultiplierContribution(player, rebirthMultiplier)
	local rebirth = math.floor(tonumber(player:GetAttribute("Rebirth")) or 0)
	if rebirth <= 0 then
		return 0
	end

	-- Rebirth 18 should add +18x, not multiply another source by 18.
	return tonumber(rebirthMultiplier) or rebirth
end

local function GetPermanentEarningsMultiplier(player)
	if not player then return 1 end

	local friendMultiplier = tonumber(player:GetAttribute("FriendMultiplier")) or 1
	local premiumMultiplier = player.MembershipType == Enum.MembershipType.Premium and 1.5 or 1
	local skinMultiplier = GetSkinMultiplier(player)
	local rankMultiplier = tonumber(player:GetAttribute("RankResourceMultiplier")) or 1
	local rebirthMultiplier = tonumber(player:GetAttribute("RebirthMultiplier")) or 1

	local totalMultiplier = 0
	totalMultiplier += getPositiveMultiplierContribution(friendMultiplier, 1)
	totalMultiplier += getPositiveMultiplierContribution(premiumMultiplier, 1)
	totalMultiplier += getPositiveMultiplierContribution(skinMultiplier, 1)
	totalMultiplier += getPositiveMultiplierContribution(rankMultiplier, 1)
	totalMultiplier += getRebirthMultiplierContribution(player, rebirthMultiplier)

	local normalMultiplier = math.max(1, totalMultiplier)
	local gamePassMultiplier = GamePassOwnershipService.GetGarageIncomeMultiplier(player)
	return normalMultiplier * gamePassMultiplier
end

local function GetActualEarningsMultiplier(player, globalMoneyFrenzyMultiplier)
	local permanentMultiplier = GetPermanentEarningsMultiplier(player)
	globalMoneyFrenzyMultiplier = tonumber(globalMoneyFrenzyMultiplier) or GlobalMoneyFrenzyService.GetMultiplier()
	return permanentMultiplier * math.max(1, globalMoneyFrenzyMultiplier)
end

local function RefreshActualEarningsMultiplier(player)
	if not player then return end
	local permanentMultiplier = GetPermanentEarningsMultiplier(player)
	player:SetAttribute("PermanentEarningsMultiplier", permanentMultiplier)
	player:SetAttribute("ActualEarningsMultiplier", permanentMultiplier * GlobalMoneyFrenzyService.GetMultiplier())
end

local function watchEarningsMultiplierAttributes(player)
	RefreshActualEarningsMultiplier(player)

	player:GetAttributeChangedSignal("FriendMultiplier"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("EquippedSkin"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("RankResourceMultiplier"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("RebirthMultiplier"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("Rebirth"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetPropertyChangedSignal("MembershipType"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("OwnsExclusiveGamePass"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("Owns2xMoneyGamePass"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
end

local function refreshAllActualEarningsMultipliers()
	for _, player in ipairs(Players:GetPlayers()) do
		RefreshActualEarningsMultiplier(player)
	end
end

local function GetAFKPayoutMultiplier()
	local globalMoneyFrenzyMultiplier = GlobalMoneyFrenzyService.GetMultiplier()
	if globalMoneyFrenzyMultiplier > 1 then
		return (globalMoneyFrenzyMultiplier + 0.5) / globalMoneyFrenzyMultiplier
	end
	return 2
end

Players.PlayerAdded:Connect(watchEarningsMultiplierAttributes)
for _, player in ipairs(Players:GetPlayers()) do
	watchEarningsMultiplierAttributes(player)
end

task.spawn(function()
	local lastGeneration = GlobalMoneyFrenzyService.GetGeneration()
	while true do
		task.wait(1)
		local generation = GlobalMoneyFrenzyService.GetGeneration()
		if generation ~= lastGeneration then
			lastGeneration = generation
			refreshAllActualEarningsMultipliers()
		end
	end
end)

-- ============================================================================
-- 💰 MAIN ECONOMY LOOP
-- ============================================================================

TycoonFolder.ChildRemoved:Connect(function(plot)
	if profitAccumulator[plot] then
		profitAccumulator[plot] = nil
	end
end)

local function getLinkedCarValue(pad)
	local direct = pad:FindFirstChild("LinkedCar")
	if direct then return direct.Value end

	if pad:IsA("Model") and pad.PrimaryPart then
		local prim = pad.PrimaryPart:FindFirstChild("LinkedCar")
		if prim then return prim.Value end
	end

	for _, child in pairs(pad:GetChildren()) do
		local val = child:FindFirstChild("LinkedCar")
		if val then return val.Value end
	end
	return nil
end

local function getPlacedCarsInFolder(padsFolder)
	local placedCars = {}
	if not padsFolder then return placedCars end

	for _, pad in pairs(padsFolder:GetChildren()) do
		local linkedCar = getLinkedCarValue(pad)
		if linkedCar and linkedCar.Parent then
			table.insert(placedCars, { Pad = pad, Car = linkedCar })
		end
	end

	return placedCars
end

local function getBestPlacedBaseCPS(placedCars)
	local bestBaseCPS = 0

	for _, placed in ipairs(placedCars) do
		local stats = getCarStats(placed.Car.Name)
		if stats and not CarStats.IsMythicalCar(stats) then
			bestBaseCPS = math.max(bestBaseCPS, tonumber(stats.CPS) or 0)
		end
	end

	return bestBaseCPS
end

-- Helper to gather all pads from a Level Folder. Mythical cars use the best
-- non-Mythical car currently placed in this same active base level, not inventory.
local function processPadsInFolder(padsFolder)
	local folderCPS = 0
	local placedCars = getPlacedCarsInFolder(padsFolder)
	local bestPlacedBaseCPS = getBestPlacedBaseCPS(placedCars)

	for _, placed in ipairs(placedCars) do
		local linkedCar = placed.Car
		local stats = getCarStats(linkedCar.Name)

		if stats then
			folderCPS = folderCPS + CarStats.CalculateOwnedCarBaseCPS(stats, bestPlacedBaseCPS, linkedCar:GetAttribute("IsRobuxExclusive") == true)
		else
			local pad = placed.Pad
			if not pad:GetAttribute("WarnedMissing") then
				warn("⚠️ Economy Warning: No stats found for '" .. linkedCar.Name .. "'")
				pad:SetAttribute("WarnedMissing", true)
			end
		end
	end

	return folderCPS
end

task.spawn(function()
	print("💰 TycoonEconomy: System Active & Monitoring...")

	while true do
		task.wait(PAY_INTERVAL)

		for _, plot in pairs(TycoonFolder:GetChildren()) do
			local pendingValue = plot:FindFirstChild("PendingEarnings")
			local ownerValue = plot:FindFirstChild("Owner") -- Needed to find the player

			if pendingValue then
				local plotTotalCPS = 0

				-- 1. Calculate Base Income from ACTIVE Level Only
				local playerBaseLevel = 1
				if ownerValue and ownerValue.Value ~= "" then
					local player = Players:FindFirstChild(ownerValue.Value)
					if player then
						playerBaseLevel = tonumber(player:GetAttribute("BaseLevel")) or 1
					end
				end

				local activeLevelFolder = nil

				if playerBaseLevel == 1 then
					activeLevelFolder = plot:FindFirstChild("NormalLevel1")
					if not activeLevelFolder and dedicatedFolder and dedicatedFolder:FindFirstChild(plot.Name) then
						activeLevelFolder = dedicatedFolder[plot.Name]:FindFirstChild("NormalLevel1")
					end
				elseif playerBaseLevel == 2 then
					activeLevelFolder = plot:FindFirstChild("NormalLevel2")
					if not activeLevelFolder and dedicatedFolder and dedicatedFolder:FindFirstChild(plot.Name) then
						activeLevelFolder = dedicatedFolder[plot.Name]:FindFirstChild("NormalLevel2")
					end
				else
					warn("⚠️ TycoonEconomy: Unhandled BaseLevel " .. tostring(playerBaseLevel) .. " for plot " .. plot.Name)
				end

				if activeLevelFolder then
					local activePadsFolder = activeLevelFolder.Parent:FindFirstChild("Pads")
					plotTotalCPS = plotTotalCPS + processPadsInFolder(activePadsFolder)
				end

				-- 2. Apply the player's actual earnings multiplier.
				-- Multiplier order is centralized in GetActualEarningsMultiplier so map displays and payouts stay in sync.
				local permanentEarningsMultiplier = 1
				local frenzyState = GlobalMoneyFrenzyService.GetState()
				local frenzyMultiplier = math.max(1, tonumber(frenzyState.Multiplier) or 1)

				if ownerValue and ownerValue.Value ~= "" then
					local player = Players:FindFirstChild(ownerValue.Value)
					if player then
						permanentEarningsMultiplier = GetPermanentEarningsMultiplier(player)
						local actualEarningsMultiplier = GetActualEarningsMultiplier(player, frenzyMultiplier)
						player:SetAttribute("PermanentEarningsMultiplier", permanentEarningsMultiplier)
						player:SetAttribute("ActualEarningsMultiplier", actualEarningsMultiplier)
					end
				end

				-- Preserve a leave-time rate without temporary global boosts. Offline
				-- earnings apply Frenzy only to the portion before its real expiration.
				plot:SetAttribute("OfflineEarningsCPS", plotTotalCPS * permanentEarningsMultiplier)
				plot:SetAttribute("OfflineFrenzyMultiplier", frenzyMultiplier)
				plot:SetAttribute("OfflineFrenzyExpiresAt", frenzyState.Active and math.max(0, tonumber(frenzyState.ExpiresAt) or 0) or 0)

				plotTotalCPS = plotTotalCPS * permanentEarningsMultiplier * frenzyMultiplier

				-- Update attribute so TabletHandler sees the Boosted CPS (before AFK)
				plot:SetAttribute("CurrentCPS", plotTotalCPS)

				-- 3. AFK Bonus & Accumulate
				-- Normal AFK remains 2x. During Global Money Frenzy, AFK adds only +0.5x total
				-- on top of the global 2x instead of doubling again to 4x.
				local payoutCPS = plotTotalCPS
				if plot:GetAttribute("IsAFK") == true then
					payoutCPS = payoutCPS * GetAFKPayoutMultiplier()
				end

				if not profitAccumulator[plot] then profitAccumulator[plot] = 0 end
				profitAccumulator[plot] = profitAccumulator[plot] + payoutCPS

				local payout = math.floor(profitAccumulator[plot])

				if payout > 0 then
					pendingValue.Value = pendingValue.Value + payout
					profitAccumulator[plot] = profitAccumulator[plot] - payout
				end
			else
				if profitAccumulator[plot] then profitAccumulator[plot] = nil end
			end
		end
	end
end)
