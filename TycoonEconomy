-- ============================================================================
-- 🏎️ CAR STATS LOOKUP CACHE (O(1) Access)
-- ============================================================================
local CarLookup = {}
for id, stats in pairs(CarStats.Cars) do
	-- Since multiple cars can have the same real "Name" (e.g. "Toyota Hilux"),
	-- keep direct ID lookups fast while falling back through CarStats.GetCarStats for model-name lookups.
	CarLookup[id] = stats
end

local function resolveCarStats(carName)
	if type(carName) ~= "string" or carName == "" then
		return nil, nil
	end

	local direct = CarLookup[carName]
	if direct then
		return direct, carName
	end

	if CarStats.GetCarStats then
		local stats, canonicalId = CarStats.GetCarStats(carName)
		return stats, canonicalId
	end

	return nil, nil
end

local function getCarStats(carOrName)
	if typeof(carOrName) ~= "Instance" then
		return resolveCarStats(carOrName)
	end

	local persistedToolId = carOrName:GetAttribute("ToolId")
	local stats = nil
	local canonicalId = nil

	if type(persistedToolId) == "string" and persistedToolId ~= "" then
		stats, canonicalId = resolveCarStats(persistedToolId)
	end

	if stats then
		return stats, canonicalId
	end

	-- Older or manually placed models can carry a stale/empty ToolId. The model
	-- name is still server-owned, so use it as a migration fallback and repair
	-- the attribute for later saving/economy passes.
	stats, canonicalId = resolveCarStats(carOrName.Name)
	if stats and canonicalId then
		carOrName:SetAttribute("ToolId", canonicalId)
		warn(string.format(
			"⚠️ [TycoonEconomy] Repaired invalid ToolId '%s' on %s to '%s'.",
			tostring(persistedToolId),
			carOrName:GetFullName(),
			canonicalId
		))
	end

	return stats, canonicalId
end

-- ============================================================================
-- 👥 FRIEND BONUS SYSTEM (OPTIMIZED O(N))
-- ============================================================================

local function updateMultiplier(player)
	if not player or not FriendCache[player.UserId] then return end

	local count = 0
	for _ in pairs(FriendCache[player.UserId]) do count += 1 end

	local clamped = math.min(count, 5)

	-- 1 friend = 10%, 2 = 25%, 3 = 50%, 4 = 75%, 5 = 100%
	local friendBoostPercentages = {
		[1] = 0.10,
		[2] = 0.25,
		[3] = 0.50,
		[4] = 0.75,
		[5] = 1.00
	}

	local boost = 0
	if clamped > 0 then
		boost = friendBoostPercentages[clamped] or 0
	end

	local mult = 1 + boost

	player:SetAttribute("ActiveFriends", count)
	player:SetAttribute("FriendMultiplier", mult)
end

local function onPlayerAdded(player)
	local uid = player.UserId
	FriendCache[uid] = {}

	task.spawn(function()
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player then
				local oid = other.UserId
				local success, isFriend
				for attempt = 1, 3 do
					success, isFriend = pcall(function() return player:IsFriendsWith(oid) end)
					if success then break end
					task.wait(0.25 * attempt)
				end

				if success and isFriend then
					-- Add to BOTH caches
					if FriendCache[uid] then FriendCache[uid][oid] = true end
					if FriendCache[oid] then FriendCache[oid][uid] = true end

					updateMultiplier(player)
					updateMultiplier(other)
				end
			end
		end
		updateMultiplier(player) -- Ensure init even with 0 friends
	end)
end

local function onPlayerRemoving(player)
	local uid = player.UserId
	if FriendCache[uid] then
		for friendId, _ in pairs(FriendCache[uid]) do
			local friend = Players:GetPlayerByUserId(friendId)
			if friend and FriendCache[friendId] then
				FriendCache[friendId][uid] = nil
				updateMultiplier(friend)
			end
		end
		FriendCache[uid] = nil
	end
	lastDirtyAtByUserId[uid] = nil
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Init existing
for _, p in ipairs(Players:GetPlayers()) do onPlayerAdded(p) end

-- ============================================================================
-- 🏆 SKIN MULTIPLIER HELPER
-- ============================================================================
local function GetSkinMultiplier(player)
	if not player then return 1 end

	-- Read the attribute set by TransactionHandler/DataHandler
	local skinName = player:GetAttribute("EquippedSkin")

	if skinName and BaseSkinStats[skinName] then
		return BaseSkinStats[skinName].Multiplier or 1
	end
	return 1 -- Default (No Boost)
end

local function getPositiveMultiplierContribution(multiplier, noBoostMultiplier)
	multiplier = tonumber(multiplier) or noBoostMultiplier
	noBoostMultiplier = tonumber(noBoostMultiplier) or 1

	if multiplier <= noBoostMultiplier then
		return 0
	end

	return multiplier - noBoostMultiplier
end

local function getRebirthMultiplierContribution(player, rebirthMultiplier)
	local rebirth = math.floor(tonumber(player:GetAttribute("Rebirth")) or 0)
	if rebirth <= 0 then
		return 0
	end

	-- Rebirth 18 should add +18x, not multiply another source by 18.
	return math.max(0, (tonumber(rebirthMultiplier) or (1 + rebirth)) - 1)
end

local function GetPermanentEarningsMultiplier(player)
	if not player then return 1 end

	local friendMultiplier = tonumber(player:GetAttribute("FriendMultiplier")) or 1
	local premiumMultiplier = player.MembershipType == Enum.MembershipType.Premium and 1.5 or 1
	local skinMultiplier = GetSkinMultiplier(player)
	local rankMultiplier = tonumber(player:GetAttribute("RankResourceMultiplier")) or 1
	local rebirthMultiplier = tonumber(player:GetAttribute("RebirthMultiplier")) or 1

	local totalMultiplier = 1
	totalMultiplier += getPositiveMultiplierContribution(friendMultiplier, 1)
	totalMultiplier += getPositiveMultiplierContribution(premiumMultiplier, 1)
	totalMultiplier += getPositiveMultiplierContribution(skinMultiplier, 1)
	totalMultiplier += getPositiveMultiplierContribution(rankMultiplier, 1)
	totalMultiplier += getRebirthMultiplierContribution(player, rebirthMultiplier)

	local normalMultiplier = math.max(1, totalMultiplier)
	local gamePassMultiplier = GamePassOwnershipService.GetGarageIncomeMultiplier(player)
	return normalMultiplier * gamePassMultiplier
end

local function GetActualEarningsMultiplier(player)
	return GetPermanentEarningsMultiplier(player) * GlobalMoneyFrenzyService.GetMultiplier()
end

local function RefreshActualEarningsMultiplier(player)
	if not player then return end
	player:SetAttribute("ActualEarningsMultiplier", GetActualEarningsMultiplier(player))
end

local function watchEarningsMultiplierAttributes(player)
	RefreshActualEarningsMultiplier(player)

	player:GetAttributeChangedSignal("FriendMultiplier"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("EquippedSkin"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("RankResourceMultiplier"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("RebirthMultiplier"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("Rebirth"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetPropertyChangedSignal("MembershipType"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("OwnsExclusiveGamePass"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
	player:GetAttributeChangedSignal("Owns2xMoneyGamePass"):Connect(function()
		RefreshActualEarningsMultiplier(player)
	end)
end

local function refreshAllActualEarningsMultipliers()
	for _, player in ipairs(Players:GetPlayers()) do
		RefreshActualEarningsMultiplier(player)
	end
end

local function GetAFKPayoutMultiplier()
	local globalMoneyFrenzyMultiplier = GlobalMoneyFrenzyService.GetMultiplier()
	if globalMoneyFrenzyMultiplier > 1 then
		return (globalMoneyFrenzyMultiplier + 0.5) / globalMoneyFrenzyMultiplier
	end
	return 2
end

Players.PlayerAdded:Connect(watchEarningsMultiplierAttributes)
for _, player in ipairs(Players:GetPlayers()) do
	watchEarningsMultiplierAttributes(player)
end

task.spawn(function()
	local lastGeneration = GlobalMoneyFrenzyService.GetGeneration()
	while true do
		task.wait(1)
		local generation = GlobalMoneyFrenzyService.GetGeneration()
		if generation ~= lastGeneration then
			lastGeneration = generation
			refreshAllActualEarningsMultipliers()
		end
	end
end)

