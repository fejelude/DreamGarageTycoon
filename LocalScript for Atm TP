-- Handles ATM teleport button interaction.
-- Hover/click behavior uses the shared standard button helper so the
-- ATM Information tooltip matches the Friend Bonus / Premium Bonus buttons.

local Players           = game:GetService("Players")
local Workspace         = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIButtonUtils     = require(ReplicatedStorage:WaitForChild("UIButtonUtils"))

local player = Players.LocalPlayer
local button = script.Parent
local information = button:WaitForChild("Information")

-- ⚙️ CONFIG
local SHOP_PART_NAME = "ATM-teleport-pad"

local function teleportToATM()
	local shopPart = Workspace:FindFirstChild(SHOP_PART_NAME)
	if shopPart then
		local char = player.Character
		if char then
			char:PivotTo(shopPart.CFrame + Vector3.new(0, 3, 0))
		end
	else
		warn("❌ Teleport Target '" .. SHOP_PART_NAME .. "' not found in Workspace!")
	end
end

UIButtonUtils.SetupStandardButton(button, information, teleportToATM)
