-- Purpose: Handles Tablet Owner Info, Secure Claiming, Cooldowns, SFX, and Product Prompts.
-- Runs on: Server
-- Location: ServerScriptService
-- Dependencies: Players, Workspace, ReplicatedStorage, MarketplaceService, Debris
-- Networking: TabletEvent (RemoteEvent) - Client requests Claim/Prompt2X, Server replies with ClaimResult.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Debris = game:GetService("Debris")
local ServerStorage = game:GetService("ServerStorage")
local GlobalMoneyFrenzyService = require(game:GetService("ServerScriptService"):WaitForChild("GlobalMoneyFrenzyService"))

-- ⚙️ CONFIGURATION
local DEV_PRODUCT_ID = 3509697462
local TYCOON_FOLDER_NAME = "Tycoons"
local CLAIM_COOLDOWN = 1.5
local PROMPT_COOLDOWN_TIME = 2.5 
local MAX_CLAIM_DISTANCE = 20    

-- 📂 REFERENCES
local TycoonFolder = Workspace:WaitForChild(TYCOON_FOLDER_NAME)
local TabletEvent  = ReplicatedStorage:FindFirstChild("TabletEvent")

if not TabletEvent then
	TabletEvent = Instance.new("RemoteEvent")
	TabletEvent.Name = "TabletEvent"
	TabletEvent.Parent = ReplicatedStorage
end

-- 🛡️ STATE MANAGEMENT
local playerCooldowns          = {}
local promptCooldowns          = {}
local purchaseSubmitted        = {}
local nameToUserIdCache        = {}
local thumbnailCache           = {}
local pendingUserIdRequests    = {}
local pendingThumbnailRequests = {}
local USER_ID_LOOKUP_MAX_RETRIES = 4
local USER_ID_LOOKUP_BASE_DELAY = 0.35

local function forceSave(player)
	local admin = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if not admin or not admin:IsA("BindableFunction") then return false end
	local ok, saved = pcall(function() return admin:Invoke("SaveNow", player) end)
	return ok and saved == true
end

local function restoreReservedDouble(player)
	local reserved = math.max(0, math.floor(tonumber(player:GetAttribute("TabletDoublePendingAmount")) or 0))
	if reserved <= 0 then return true end

	local plotName = player:GetAttribute("OccupiedPlot")
	local plot = plotName and TycoonFolder:FindFirstChild(plotName)
	local pending = plot and plot:FindFirstChild("PendingEarnings")
	if pending and plot:FindFirstChild("Owner") and plot.Owner.Value == player.Name then
		pending.Value += reserved
	else
		local carry = math.max(0, math.floor(tonumber(player:GetAttribute("OfflineTabletCarry")) or 0))
		player:SetAttribute("OfflineTabletCarry", carry + reserved)
	end
	player:SetAttribute("TabletDoublePendingAmount", 0)
	return forceSave(player)
end

local function getUserIdCached(playerName)
	if not playerName or playerName == "" then return nil end
	local cached = nameToUserIdCache[playerName]
	if cached then return cached end

	if pendingUserIdRequests[playerName] ~= nil then
		repeat task.wait() until pendingUserIdRequests[playerName] == nil
		return nameToUserIdCache[playerName]
	end

	pendingUserIdRequests[playerName] = true
	local success, userId = false, nil
	for attempt = 1, USER_ID_LOOKUP_MAX_RETRIES do
		success, userId = pcall(function()
			return Players:GetUserIdFromNameAsync(playerName)
		end)

		if success and userId then
			break
		end

		local errLower = string.lower(tostring(userId or ""))
		local isRateLimit = string.find(errLower, "429", 1, true) ~= nil
		if attempt < USER_ID_LOOKUP_MAX_RETRIES and isRateLimit then
			task.wait(USER_ID_LOOKUP_BASE_DELAY * attempt)
		else
			break
		end
	end
	pendingUserIdRequests[playerName] = nil

	if success and userId then
		nameToUserIdCache[playerName] = userId
		return userId
	end

	return nil
end

local function getHeadshotCached(userId)
	if not userId then return "" end
	local cached = thumbnailCache[userId]
	if cached then return cached end

	if pendingThumbnailRequests[userId] ~= nil then
		repeat task.wait() until pendingThumbnailRequests[userId] == nil
		return thumbnailCache[userId] or ""
	end

	pendingThumbnailRequests[userId] = true
	local content, isReady = Players:GetUserThumbnailAsync(
		userId,
		Enum.ThumbnailType.HeadShot,
		Enum.ThumbnailSize.Size420x420
	)
	pendingThumbnailRequests[userId] = nil

	if isReady and content and content ~= "" then
		thumbnailCache[userId] = content
		return content
	end

	return ""
end

-- 📊 ABBREVIATION HELPER
local SUFFIXES = {"K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}
local function formatNumber(n)
	n = tonumber(n) or 0
	if n < 1000 then return tostring(math.floor(n)) end
	local i = math.floor(math.log(n, 1000))
	local v = 1000 ^ i
	local suffix = SUFFIXES[i] or "?"
	return string.format("%.2f%s", n / v, suffix)
end

local function getAFKDisplayMultiplier()
	local globalMoneyFrenzyMultiplier = GlobalMoneyFrenzyService.GetMultiplier()
	if globalMoneyFrenzyMultiplier > 1 then
		return (globalMoneyFrenzyMultiplier + 0.5) / globalMoneyFrenzyMultiplier, globalMoneyFrenzyMultiplier + 0.5
	end
	return 2, 2
end

local function getTabletMultiplierSuffix(plot)
	local globalMoneyFrenzyMultiplier = GlobalMoneyFrenzyService.GetMultiplier()
	if plot:GetAttribute("IsAFK") == true then
		local payoutMultiplier, totalMultiplier = getAFKDisplayMultiplier()
		return " (" .. string.format("%.1f", totalMultiplier):gsub("%.0$", "") .. "x)", payoutMultiplier
	end
	if globalMoneyFrenzyMultiplier > 1 then
		return " (" .. string.format("%.1f", globalMoneyFrenzyMultiplier):gsub("%.0$", "") .. "x)", 1
	end
	return "", 1
end

-- 🧹 HELPER: REMOVE CONSTRAINT
local function nukeConstraints(obj)
	if not obj then return end
	for _, child in pairs(obj:GetChildren()) do
		if child:IsA("UITextSizeConstraint") then
			child:Destroy()
		end
	end
end

-- ============================================================================
-- 🛠️ TABLET SETUP FUNCTION
-- ============================================================================
local function setupTablet(plot)
	task.spawn(function()
		local model = plot:WaitForChild("ClaimEarnings", 30)
		if not model then return end

		local cpsPart = model:WaitForChild("TotalEarningsPerSecond", 5)
		if cpsPart then
			local cpsGui = cpsPart:WaitForChild("EarningsAmountGUI", 5)
			if cpsGui then
				local cpsLabel = cpsGui:WaitForChild("Value", 5)
				if cpsLabel then
					nukeConstraints(cpsLabel)
					local function updateCPS()
						local currentCPS = plot:GetAttribute("CurrentCPS") or 0
						local suffix, payoutMultiplier = getTabletMultiplierSuffix(plot)
						cpsLabel.Text = "$ " .. formatNumber(currentCPS * payoutMultiplier) .. "/s" .. suffix
					end
					plot:GetAttributeChangedSignal("CurrentCPS"):Connect(updateCPS)
					plot:GetAttributeChangedSignal("IsAFK"):Connect(updateCPS)
					updateCPS()
				end
			end
		end

		local mainPart  = model:WaitForChild("Earnings", 10)
		local claimPart = model:WaitForChild("ClaimPart", 10)
		if not mainPart or not claimPart then return end

		mainPart.Anchored  = true; mainPart.CanCollide  = true; mainPart.Velocity  = Vector3.zero
		claimPart.Anchored = true; claimPart.CanCollide = true; claimPart.Velocity = Vector3.zero

		local avatarGui   = mainPart:WaitForChild("AvatarGUI", 10)
		local usernameGui = mainPart:WaitForChild("UsernameGUI", 10)

		local revenueGui = mainPart:FindFirstChild("RevenueGUI")
		if not revenueGui and model:FindFirstChild("Revenue-indicator") then
			revenueGui = model["Revenue-indicator"]:FindFirstChild("RevenueGUI")
		end

		if not (avatarGui and usernameGui and revenueGui) then return end

		local avatarLabel   = avatarGui:WaitForChild("Avatar-Label")
		local usernameLabel = usernameGui:WaitForChild("Username")
		local revenueLabel  = revenueGui:WaitForChild("Total-Revenue")

		local ownerVal   = plot:WaitForChild("Owner", 10)
		local pendingVal = plot:WaitForChild("PendingEarnings", 10)

		nukeConstraints(revenueLabel)
		nukeConstraints(avatarLabel)
		nukeConstraints(usernameLabel)

		if revenueLabel:IsA("TextLabel") then
			local dollarLabel = revenueGui:FindFirstChild("Dollar-Static")
			if not dollarLabel then
				dollarLabel = revenueLabel:Clone()
				dollarLabel.Name = "Dollar-Static"
				dollarLabel.Parent = revenueGui
				nukeConstraints(dollarLabel)
				dollarLabel.Text = "$"
				dollarLabel.Size = UDim2.new(0.25, 0, 1, 0)
				dollarLabel.Position = UDim2.new(0, 0, 0, 0)
				dollarLabel.TextXAlignment = Enum.TextXAlignment.Center

				revenueLabel.Size = UDim2.new(0.75, 0, 1, 0)
				revenueLabel.Position = UDim2.new(0.25, 0, 0, 0)
				revenueLabel.TextXAlignment = Enum.TextXAlignment.Left
			else
				nukeConstraints(dollarLabel)
			end
		end

		local lastOwnerName = nil
		local function updateOwnerInfo()
			local playerName = ownerVal.Value
			if playerName == lastOwnerName then return end
			lastOwnerName = playerName

			if playerName and playerName ~= "" then
				usernameLabel.Text = playerName
				local onlinePlayer = Players:FindFirstChild(playerName)
				local userId = onlinePlayer and onlinePlayer.UserId or getUserIdCached(playerName)
				avatarLabel.Image = getHeadshotCached(userId)
			else
				usernameLabel.Text = "Vacant"
				avatarLabel.Image  = ""
			end
		end

		local function updateRevenue()
			revenueLabel.Text = formatNumber(pendingVal.Value)
		end

		ownerVal.Changed:Connect(updateOwnerInfo)
		pendingVal.Changed:Connect(updateRevenue)
		plot:GetAttributeChangedSignal("IsAFK"):Connect(updateRevenue)

		updateOwnerInfo()
		updateRevenue()
	end)
end

for _, plot in pairs(TycoonFolder:GetChildren()) do
	setupTablet(plot)
end
TycoonFolder.ChildAdded:Connect(setupTablet)

-- ============================================================================
-- 📡 REMOTE HANDLING
-- ============================================================================
TabletEvent.OnServerEvent:Connect(function(player, action, plotName, requestId)
	if type(action) ~= "string" or type(plotName) ~= "string" then return end
	if player:GetAttribute("TycoonDataLoaded") ~= true then return end

	local function respondClaim(success, payload)
		TabletEvent:FireClient(player, "ClaimResult", plotName, success, payload, requestId)
	end

	local plot = TycoonFolder:FindFirstChild(plotName)
	if not plot then
		if action == "Claim" then respondClaim(false, "InvalidPlot") end
		return
	end

	if plot.Owner.Value ~= player.Name then
		if action == "Claim" then respondClaim(false, "NotOwner") end
		return
	end

	local pendingVal = plot:FindFirstChild("PendingEarnings")
	local model      = plot:FindFirstChild("ClaimEarnings")
	local claimPart  = nil
	if model then claimPart = model:FindFirstChild("ClaimPart") end

	if not pendingVal or not claimPart then
		if action == "Claim" then respondClaim(false, "MissingState") end
		return
	end

	if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
		if action == "Claim" then respondClaim(false, "NoCharacter") end
		return
	end

	local distance = (player.Character.HumanoidRootPart.Position - claimPart.Position).Magnitude
	if distance > MAX_CLAIM_DISTANCE then
		if action == "Claim" then respondClaim(false, "TooFar") end
		return
	end

	if action == "Claim" then
		local lastClaim = playerCooldowns[player] or 0
		if (os.clock() - lastClaim) < CLAIM_COOLDOWN then
			respondClaim(false, "Cooldown")
			return
		end

		local amount = pendingVal.Value

		if amount > 0 then
			local hs = player:FindFirstChild("HiddenStats")
			local bank = hs and hs:FindFirstChild("Cash")
			if not bank then respondClaim(false, "MissingState"); return end
			pendingVal.Value = 0
			local finalAmount = amount
			bank.Value += finalAmount

			playerCooldowns[player] = os.clock()
			respondClaim(true, finalAmount)
			local tutorialAPI = game:GetService("ServerStorage"):FindFirstChild("TutorialProgressAPI")
			if tutorialAPI and tutorialAPI:IsA("BindableFunction") then
				task.spawn(function() tutorialAPI:Invoke("RecordObjective", player, "EarningsClaimed") end)
			end
		else
			playerCooldowns[player] = os.clock()
			respondClaim(false, "NoEarnings")
		end

	elseif action == "Prompt2X" then
		local reservedAmount = math.max(0, math.floor(tonumber(player:GetAttribute("TabletDoublePendingAmount")) or 0))
		if reservedAmount <= 0 then
			purchaseSubmitted[player] = nil
		elseif purchaseSubmitted[player] then
			return
		end

		local lastPrompt = promptCooldowns[player] or 0
		if (os.clock() - lastPrompt) < PROMPT_COOLDOWN_TIME then return end
		promptCooldowns[player] = os.clock()

		local amount = reservedAmount > 0 and reservedAmount or pendingVal.Value
		if amount <= 0 then return end

		-- Take the server-side prompt lock before the reservation save yields. This
		-- prevents a second remote call from opening another product prompt while
		-- the first reservation is still being persisted.
		purchaseSubmitted[player] = true
		if reservedAmount <= 0 then
			pendingVal.Value = 0
			player:SetAttribute("TabletDoublePendingAmount", amount)
			if not forceSave(player) then
				purchaseSubmitted[player] = nil
				player:SetAttribute("TabletDoublePendingAmount", 0)
				pendingVal.Value += amount
				return
			end
		end

		local prompted = pcall(function()
			MarketplaceService:PromptProductPurchase(player, DEV_PRODUCT_ID)
		end)
		if not prompted then
			purchaseSubmitted[player] = nil
			restoreReservedDouble(player)
		end
	end
end)

MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
	if productId ~= DEV_PRODUCT_ID then return end
	local player = Players:GetPlayerByUserId(userId)
	if not player then return end
	if wasPurchased then
		purchaseSubmitted[player] = true
		return
	end
	purchaseSubmitted[player] = nil
	restoreReservedDouble(player)
end)

Players.PlayerRemoving:Connect(function(player)
	playerCooldowns[player] = nil
	promptCooldowns[player] = nil
	purchaseSubmitted[player] = nil
end)
