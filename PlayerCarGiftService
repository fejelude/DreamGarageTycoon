-- Purpose: Handles server-side validation and state for car gifting

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

-- Create Remote if it doesn't exist
local RemotesFolder = ReplicatedStorage:FindFirstChild("PlayerCarGiftingRemotes")
if not RemotesFolder then
	RemotesFolder = Instance.new("Folder")
	RemotesFolder.Name = "PlayerCarGiftingRemotes"
	RemotesFolder.Parent = ReplicatedStorage
end

local ActionRemote = RemotesFolder:FindFirstChild("ActionRemote")
if not ActionRemote then
	ActionRemote = Instance.new("RemoteEvent")
	ActionRemote.Name = "ActionRemote"
	ActionRemote.Parent = RemotesFolder
end


local function canReceiveGift(player)
	local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
	if not rankApi then return true end
	local ok, allowed = pcall(function() return rankApi:Invoke("CanAddCar", player, 1) end)
	return ok and allowed == true
end

local function recordGift(giver, receiver, carId)
	local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
	if rankApi then
		task.spawn(function()
			pcall(function() rankApi:Invoke("CarGiftSent", giver, receiver, carId) end)
		end)
	end
end

local function removeRespawnMirror(giver, toolId)
	local starterGear = giver and giver:FindFirstChild("StarterGear")
	if not starterGear then return end
	for _, child in ipairs(starterGear:GetChildren()) do
		if child:IsA("Tool") and (child.Name == toolId or child:GetAttribute("ToolId") == toolId) then
			child:Destroy()
			return
		end
	end
end

-- Track active trade sessions
local activeGifts = {}
local lastTriggerTime = {}

ActionRemote.OnServerEvent:Connect(function(player, action, data)
	if action == "TriggerPrompt" then
		local receiver = data and data.Receiver
		local tool = data and data.Tool

		if not receiver or not tool then return end
		if tool.Parent ~= player.Character and tool.Parent ~= player.Backpack then return end -- Tool ownership fix

		local now = os.clock()
		if lastTriggerTime[player.UserId] and (now - lastTriggerTime[player.UserId]) < 1 then
			return -- Ignore if triggered within 1 second
		end
		lastTriggerTime[player.UserId] = now

		local existing = activeGifts[player.UserId]
		if existing then
			if existing.Timer then task.cancel(existing.Timer) end
			if existing.State == "PendingReceiver" and existing.Receiver then
				ActionRemote:FireClient(existing.Receiver, "CloseUI")
			end
		end

		-- Setup trade session
		local session = {
			Giver = player,
			Receiver = receiver,
			CarId = tool.Name,
			Tool = tool,
			State = "PendingGiver",
			Timer = nil
		}
		activeGifts[player.UserId] = session

		session.Timer = task.delay(60, function()
			if activeGifts[player.UserId] == session then
				ActionRemote:FireClient(session.Giver, "UpdateGiverUI", {
					State = "NotificationFalse",
					Text = "Gift request timed out."
				})
				activeGifts[player.UserId] = nil
			end
		end)

		-- Open UI for the Giver first to confirm
		ActionRemote:FireClient(player, "OpenGiverUI", {
			Receiver = receiver,
			CarId = tool.Name
		})

	elseif action == "GiverAccept" then
		local session = activeGifts[player.UserId]
		if not session or session.State ~= "PendingGiver" then return end

		if not session.Receiver or not session.Receiver.Parent then
			ActionRemote:FireClient(player, "UpdateGiverUI", {
				State = "NotificationFalse",
				Text = "Player has left the game."
			})
			activeGifts[player.UserId] = nil
			return
		end

		session.State = "PendingReceiver"

		-- Reset timeout
		if session.Timer then task.cancel(session.Timer) end
		session.Timer = task.delay(60, function()
			if activeGifts[player.UserId] == session then
				ActionRemote:FireClient(session.Giver, "UpdateGiverUI", {
					State = "NotificationFalse",
					Text = "Gift request timed out."
				})
				ActionRemote:FireClient(session.Receiver, "CloseUI")
				activeGifts[player.UserId] = nil
			end
		end)

		-- Inform Giver they are waiting
		ActionRemote:FireClient(player, "UpdateGiverUI", {
			State = "NotificationTrue",
			Text = "Waiting for " .. session.Receiver.Name .. " to accept..."
		})

		-- Open UI for the Receiver
		ActionRemote:FireClient(session.Receiver, "OpenReceiverUI", {
			Giver = player,
			CarId = session.CarId
		})

	elseif action == "GiverDecline" then
		local session = activeGifts[player.UserId]
		if not session then return end
		if session.State == "PendingReceiver" then
			ActionRemote:FireClient(session.Receiver, "CloseUI")
		end
		if session.Timer then task.cancel(session.Timer) end
		activeGifts[player.UserId] = nil

	elseif action == "ReceiverAccept" then
		local giverId = data and data.GiverUserId
		if not giverId then return end
		local session = activeGifts[giverId]

		if not session or session.State ~= "PendingReceiver" or session.Receiver ~= player then return end

		if not session.Giver or not session.Giver.Parent then
			ActionRemote:FireClient(player, "UpdateReceiverUI", { Text = "Giver has left the game." })
			if session.Timer then task.cancel(session.Timer) end
			activeGifts[giverId] = nil
			return
		end

		if not canReceiveGift(player) then
			ActionRemote:FireClient(session.Giver, "UpdateGiverUI", {
				State = "NotificationFalse",
				Text = session.Receiver.DisplayName .. " has full car storage."
			})
			ActionRemote:FireClient(player, "UpdateReceiverUI", {
				Text = "Your car storage is full."
			})
			if session.Timer then task.cancel(session.Timer) end
			activeGifts[giverId] = nil
			return
		end

		-- PROCESS THE GIFT HERE (server-authoritative transfer + respawn mirror update)
		if session.Tool and session.Tool.Parent then
			local starterClone = session.Tool:Clone()
			removeRespawnMirror(session.Giver, session.CarId)
			session.Tool.Parent = player.Backpack
			if player:FindFirstChild("StarterGear") then
				starterClone.Parent = player.StarterGear
			else
				starterClone:Destroy()
			end
			recordGift(session.Giver, player, session.CarId)
		else
			ActionRemote:FireClient(session.Giver, "UpdateGiverUI", {
				State = "NotificationFalse",
				Text = "Gift failed: Car tool missing."
			})
			ActionRemote:FireClient(player, "UpdateReceiverUI", {
				Text = "Gift failed: Car tool missing."
			})
			if session.Timer then task.cancel(session.Timer) end
			activeGifts[giverId] = nil
			return
		end

		-- Notify Both
		ActionRemote:FireClient(session.Giver, "UpdateGiverUI", {
			State = "NotificationTrue",
			Text = "Successfully sent a gift to " .. session.Receiver.DisplayName .. "!"
		})

		ActionRemote:FireClient(player, "UpdateReceiverUI", {
			Text = "Car Added to Inventory!"
		})

		if session.Timer then task.cancel(session.Timer) end
		activeGifts[giverId] = nil

	elseif action == "ReceiverDecline" then
		local giverId = data and data.GiverUserId
		if not giverId then return end
		local session = activeGifts[giverId]

		if not session or session.State ~= "PendingReceiver" or session.Receiver ~= player then return end

		-- Notify Giver that it was declined
		ActionRemote:FireClient(session.Giver, "UpdateGiverUI", {
			State = "NotificationFalse",
			Text = session.Receiver.Name .. " declined the gift."
		})

		ActionRemote:FireClient(player, "CloseUI")
		if session.Timer then task.cancel(session.Timer) end
		activeGifts[giverId] = nil

	elseif action == "ReceiverBusy" then
		local giverId = data and data.GiverUserId
		if not giverId then return end
		local session = activeGifts[giverId]

		if not session or session.State ~= "PendingReceiver" or session.Receiver ~= player then return end

		ActionRemote:FireClient(session.Giver, "UpdateGiverUI", {
			State = "NotificationFalse",
			Text = session.Receiver.Name .. " is currently busy."
		})
		
		if session.Timer then task.cancel(session.Timer) end
		activeGifts[giverId] = nil
	end
end)

-- Cleanup when a player leaves mid-trade
Players.PlayerRemoving:Connect(function(leavingPlayer)
	-- Cleanup rate limit tracking
	lastTriggerTime[leavingPlayer.UserId] = nil

	-- If they were giving a car
	if activeGifts[leavingPlayer.UserId] then
		local session = activeGifts[leavingPlayer.UserId]
		if session.State == "PendingReceiver" and session.Receiver then
			ActionRemote:FireClient(session.Receiver, "CloseUI")
		end
		if session.Timer then task.cancel(session.Timer) end
		activeGifts[leavingPlayer.UserId] = nil
	end

	local toRemove = {}
	-- If they were receiving a car
	for giverId, session in pairs(activeGifts) do
		if session.Receiver == leavingPlayer then
			toRemove[#toRemove + 1] = giverId
			if session.Giver then
				ActionRemote:FireClient(session.Giver, "UpdateGiverUI", {
					State = "NotificationFalse",
					Text = leavingPlayer.Name .. " left the game."
				})
			end
			if session.Timer then task.cancel(session.Timer) end
		end
	end
	for _, id in ipairs(toRemove) do activeGifts[id] = nil end
end)