-- Purpose: Handles server-side validation and state for car gifting
-- Production fixes: cancels active sessions when Receive Gifts changes, prevents timeout/decline races during transfer, and hardens cleanup.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

local TycoonAdminAPI = ServerStorage:WaitForChild("TycoonAdminAPI", 10)

-- ============ CONFIG ============
local SESSION_TIMEOUT_SECONDS = 60
local TRIGGER_COOLDOWN_SECONDS = 1
local DATA_READY_ATTRIBUTE = "TycoonDataLoaded"
local RECEIVE_GIFTS_ATTRIBUTE = "Setting_ReceiveGiftsEnabled"
-- ================================

local RemotesFolder = ReplicatedStorage:WaitForChild("PlayerCarGiftingRemotes", 15)
if not RemotesFolder or not RemotesFolder:IsA("Folder") then
	error("[PlayerCarGiftService] ReplicatedStorage > PlayerCarGiftingRemotes must be a pre-created Folder", 0)
end
local ActionRemote = RemotesFolder:WaitForChild("ActionRemote", 15)
if not ActionRemote or not ActionRemote:IsA("RemoteEvent") then
	error("[PlayerCarGiftService] ReplicatedStorage > PlayerCarGiftingRemotes > ActionRemote must be a pre-created RemoteEvent", 0)
end

-- ============================================================================
-- HELPERS
-- ============================================================================

local RECEIVE_GIFTS_DISABLED_SELF_TEXT = "You need to enable Receive Gifts in Settings before you can send a player a car gift."
local RECEIVE_GIFTS_DISABLED_TARGET_TEXT = "This player has Receive Gifts disabled."
local RECEIVE_GIFTS_CANCELLED_SELF_TEXT = "Gift cancelled because you disabled Receive Gifts."
local RECEIVE_GIFTS_CANCELLED_TARGET_TEXT = "Gift cancelled because this player disabled Receive Gifts."
local RECEIVE_GIFTS_CANCELLED_RECEIVER_TEXT = "Gift cancelled because Receive Gifts is now disabled."

local function hasReceiveGiftsEnabled(player)
	if not player then return false end
	local value = player:GetAttribute(RECEIVE_GIFTS_ATTRIBUTE)
	return value ~= false
end

local function canReceiveGift(player)
	local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
	if not rankApi then
		return true
	end

	local ok, allowed = pcall(function()
		return rankApi:Invoke("CanAddCar", player, 1)
	end)

	return ok and allowed == true
end

local function recordGift(giver, receiver, carId)
	local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
	if rankApi then
		pcall(function()
			rankApi:Invoke("CarGiftSent", giver, receiver, carId)
		end)
	end
end

local function isDataLoaded(player)
	return player and player:GetAttribute(DATA_READY_ATTRIBUTE) == true
end

local function getToolUniqueId(tool)
	if not tool then return nil end

	return tool:GetAttribute("ToolId")
end

local function isValidCarTool(tool)
	if typeof(tool) ~= "Instance" then return false end
	if not tool:IsA("Tool") then return false end

	if tool:GetAttribute("IssuedByServer") ~= true then return false end

	local toolId = getToolUniqueId(tool)
	return type(toolId) == "string" and toolId ~= ""
end

local function isToolOwnedByPlayer(tool, player)
	if not tool or not player then return false end

	return tool.Parent == player.Character or tool.Parent == player:FindFirstChild("Backpack")
end

local function getReceiverFromData(data)
	if typeof(data) ~= "table" then
		return nil
	end

	if typeof(data.ReceiverUserId) == "number" then
		return Players:GetPlayerByUserId(data.ReceiverUserId)
	end

	if typeof(data.Receiver) == "Instance" and data.Receiver:IsA("Player") then
		return data.Receiver
	end

	return nil
end

local function getGiverIdFromData(data)
	if typeof(data) ~= "table" then
		return nil
	end

	if typeof(data.GiverUserId) == "number" then
		return data.GiverUserId
	end

	return tonumber(data.GiverUserId)
end

local function makePlayerInfo(player)
	return {
		UserId = player.UserId,
		Name = player.Name,
		DisplayName = player.DisplayName
	}
end

local function sendGiverUpdate(giver, state, text)
	if giver and giver.Parent == Players then
		ActionRemote:FireClient(giver, "UpdateGiverUI", {
			State = state,
			Text = text
		})
	end
end

local function sendReceiverUpdate(receiver, state, text)
	if receiver and receiver.Parent == Players then
		ActionRemote:FireClient(receiver, "UpdateReceiverUI", {
			State = state,
			Text = text
		})
	end
end

local function closePlayerUI(player)
	if player and player.Parent == Players then
		ActionRemote:FireClient(player, "CloseUI")
	end
end

-- ============================================================================
-- SESSION STATE
-- ============================================================================

local activeGiftsByGiver = {}
local activeGiftsByReceiver = {}
local lastTriggerTime = {}
local receiveGiftsSettingConnections = {}

local function cancelSessionTimer(session)
	if session and session.Timer then
		task.cancel(session.Timer)
		session.Timer = nil
	end
end

local function clearSession(session)
	if not session then return end

	cancelSessionTimer(session)
	session.State = "Closed"

	local giver = session.Giver
	local receiver = session.Receiver

	if giver and activeGiftsByGiver[giver.UserId] == session then
		activeGiftsByGiver[giver.UserId] = nil
	end

	if receiver and activeGiftsByReceiver[receiver.UserId] == session then
		activeGiftsByReceiver[receiver.UserId] = nil
	end
end

local function setSessionTimer(session)
	if session.Timer then
		task.cancel(session.Timer)
		session.Timer = nil
	end

	session.Timer = task.delay(SESSION_TIMEOUT_SECONDS, function()
		if not session.Giver or activeGiftsByGiver[session.Giver.UserId] ~= session then
			return
		end

		-- Do not let a timeout fire while the final transfer is already processing.
		if session.State == "Processing" or session.State == "Closed" then
			return
		end

		sendGiverUpdate(session.Giver, "Failed", "Gift request timed out.")

		if session.State == "PendingReceiver" then
			sendReceiverUpdate(session.Receiver, "Failed", "Gift request timed out.")
			closePlayerUI(session.Receiver)
		end

		clearSession(session)
	end)
end

local function failSession(session, giverText, receiverText)
	if giverText then
		sendGiverUpdate(session.Giver, "Failed", giverText)
	end

	if receiverText then
		sendReceiverUpdate(session.Receiver, "Failed", receiverText)
	end

	clearSession(session)
end

local function isPlayerBusy(player)
	if not player then return false end

	return activeGiftsByGiver[player.UserId] ~= nil
		or activeGiftsByReceiver[player.UserId] ~= nil
end

local function cancelSessionForReceiveGiftsChange(session, changedPlayer)
	if not session or session.State == "Closed" or session.State == "Processing" then
		return
	end

	local giver = session.Giver
	local receiver = session.Receiver

	if changedPlayer == giver then
		sendGiverUpdate(giver, "Failed", RECEIVE_GIFTS_CANCELLED_SELF_TEXT)
		if receiver and receiver ~= giver then
			sendReceiverUpdate(receiver, "Failed", giver.DisplayName .. " cancelled the gift.")
		end
	elseif changedPlayer == receiver then
		sendGiverUpdate(giver, "Failed", receiver.DisplayName .. " disabled Receive Gifts.")
		sendReceiverUpdate(receiver, "Failed", RECEIVE_GIFTS_CANCELLED_RECEIVER_TEXT)
	else
		sendGiverUpdate(giver, "Failed", "Gift request cancelled.")
		sendReceiverUpdate(receiver, "Failed", "Gift request cancelled.")
	end

	if session.State == "PendingReceiver" and receiver then
		closePlayerUI(receiver)
	end

	clearSession(session)
end

local function cancelActiveGiftSessionsForPlayer(player)
	if not player then return end

	local processed = {}
	local sessionAsGiver = activeGiftsByGiver[player.UserId]
	if sessionAsGiver and not processed[sessionAsGiver] then
		processed[sessionAsGiver] = true
		cancelSessionForReceiveGiftsChange(sessionAsGiver, player)
	end

	local sessionAsReceiver = activeGiftsByReceiver[player.UserId]
	if sessionAsReceiver and not processed[sessionAsReceiver] then
		processed[sessionAsReceiver] = true
		cancelSessionForReceiveGiftsChange(sessionAsReceiver, player)
	end
end

local function watchReceiveGiftsSetting(player)
	if receiveGiftsSettingConnections[player.UserId] then
		receiveGiftsSettingConnections[player.UserId]:Disconnect()
		receiveGiftsSettingConnections[player.UserId] = nil
	end

	receiveGiftsSettingConnections[player.UserId] = player:GetAttributeChangedSignal(RECEIVE_GIFTS_ATTRIBUTE):Connect(function()
		if hasReceiveGiftsEnabled(player) then
			return
		end

		cancelActiveGiftSessionsForPlayer(player)
	end)
end

local function validatePromptRequest(giver, data)
	local receiver = getReceiverFromData(data)
	local tool = data and data.Tool

	if not receiver then
		return false, nil, nil, "Invalid receiver."
	end

	if receiver == giver then
		return false, nil, nil, "You cannot gift yourself."
	end

	if receiver.Parent ~= Players then
		return false, nil, nil, "Player has left the game."
	end

	if not isDataLoaded(giver) then
		return false, nil, nil, "Your data is still loading."
	end

	if not isDataLoaded(receiver) then
		return false, nil, nil, "This player's data is still loading."
	end

	if not hasReceiveGiftsEnabled(giver) then
		return false, nil, nil, RECEIVE_GIFTS_DISABLED_SELF_TEXT
	end

	if not hasReceiveGiftsEnabled(receiver) then
		return false, nil, nil, RECEIVE_GIFTS_DISABLED_TARGET_TEXT
	end

	if typeof(tool) ~= "Instance" or not tool:IsA("Tool") then
		return false, nil, nil, "Invalid car tool."
	end

	if not isValidCarTool(tool) then
		return false, nil, nil, "Invalid car tool."
	end

	-- Require the tool to be equipped when the prompt is triggered.
	if tool.Parent ~= giver.Character then
		return false, nil, nil, "You must equip the car before gifting it."
	end

	if isPlayerBusy(giver) then
		return false, nil, nil, "You already have a pending gift."
	end

	if isPlayerBusy(receiver) then
		return false, nil, nil, receiver.Name .. " is currently busy."
	end

	return true, receiver, tool, nil
end

-- ============================================================================
-- REMOTE HANDLER
-- ============================================================================

ActionRemote.OnServerEvent:Connect(function(player, action, data)
	if action == "TriggerPrompt" then
		local now = os.clock()

		if lastTriggerTime[player.UserId] and (now - lastTriggerTime[player.UserId]) < TRIGGER_COOLDOWN_SECONDS then
			return
		end

		lastTriggerTime[player.UserId] = now

		local valid, receiver, tool, reason = validatePromptRequest(player, data)
		if not valid then
			sendGiverUpdate(player, "Failed", reason or "Unable to start gift.")
			return
		end

		local session = {
			Giver = player,
			Receiver = receiver,
			CarId = tool.Name,
			ToolId = getToolUniqueId(tool),
			Tool = tool,
			State = "PendingGiver",
			Timer = nil
		}

		activeGiftsByGiver[player.UserId] = session
		activeGiftsByReceiver[receiver.UserId] = session

		setSessionTimer(session)

		ActionRemote:FireClient(player, "OpenGiverUI", {
			Receiver = makePlayerInfo(receiver),
			CarId = tool.Name
		})

	elseif action == "GiverAccept" then
		local session = activeGiftsByGiver[player.UserId]
		if not session or session.State ~= "PendingGiver" then
			return
		end

		if not session.Receiver or session.Receiver.Parent ~= Players then
			failSession(session, "Player has left the game.", nil)
			return
		end

		if not isDataLoaded(session.Giver) then
			failSession(session, "Your data is still loading.", nil)
			return
		end

		if not isDataLoaded(session.Receiver) then
			failSession(session, "This player's data is still loading.", nil)
			return
		end

		if not hasReceiveGiftsEnabled(session.Giver) then
			failSession(session, RECEIVE_GIFTS_DISABLED_SELF_TEXT, nil)
			return
		end

		if not hasReceiveGiftsEnabled(session.Receiver) then
			failSession(session, RECEIVE_GIFTS_DISABLED_TARGET_TEXT, nil)
			return
		end

		if activeGiftsByReceiver[session.Receiver.UserId] ~= session then
			failSession(session, session.Receiver.Name .. " is currently busy.", nil)
			return
		end

		if not isToolOwnedByPlayer(session.Tool, session.Giver) then
			failSession(session, "Gift failed: Car tool missing.", nil)
			return
		end

		if not isValidCarTool(session.Tool) then
			failSession(session, "Gift failed: Invalid car tool.", nil)
			return
		end

		session.State = "PendingReceiver"
		setSessionTimer(session)

		sendGiverUpdate(session.Giver, "Pending", "Waiting for " .. session.Receiver.DisplayName .. " to accept...")

		ActionRemote:FireClient(session.Receiver, "OpenReceiverUI", {
			Giver = makePlayerInfo(session.Giver),
			CarId = session.CarId
		})

	elseif action == "GiverDecline" then
		local session = activeGiftsByGiver[player.UserId]
		if not session or session.State == "Processing" then
			return
		end

		if session.State == "PendingReceiver" then
			closePlayerUI(session.Receiver)
		end

		clearSession(session)

	elseif action == "ReceiverAccept" then
		local giverId = getGiverIdFromData(data)
		if not giverId then
			return
		end

		local session = activeGiftsByGiver[giverId]
		if not session or session.State ~= "PendingReceiver" or session.Receiver ~= player then
			return
		end

		-- Prevent double-accept/race conditions before anything can yield.
		session.State = "Processing"
		cancelSessionTimer(session)

		if not session.Giver or session.Giver.Parent ~= Players then
			sendReceiverUpdate(player, "Failed", "Giver has left the game.")
			clearSession(session)
			return
		end

		if not isDataLoaded(session.Giver) then
			failSession(session, "Your data is still loading.", nil)
			return
		end

		if not isDataLoaded(player) then
			failSession(session, "This player's data is still loading.", "Your data is still loading.")
			return
		end

		if not hasReceiveGiftsEnabled(session.Giver) then
			failSession(session, RECEIVE_GIFTS_DISABLED_SELF_TEXT, nil)
			return
		end

		if not hasReceiveGiftsEnabled(player) then
			failSession(session, RECEIVE_GIFTS_DISABLED_TARGET_TEXT, RECEIVE_GIFTS_DISABLED_TARGET_TEXT)
			return
		end

		if not isToolOwnedByPlayer(session.Tool, session.Giver) then
			failSession(session, "Gift failed: Car tool missing.", "Gift failed: Car tool missing.")
			return
		end

		if not isValidCarTool(session.Tool) then
			failSession(session, "Gift failed: Invalid car tool.", "Gift failed: Invalid car tool.")
			return
		end

		if not canReceiveGift(player) then
			failSession(
				session,
				session.Receiver.DisplayName .. " has full car storage.",
				"Your car storage is full."
			)
			return
		end

		if not TycoonAdminAPI then
			failSession(session, "Gift failed: Transfer service unavailable.", "Gift failed: Transfer service unavailable.")
			return
		end

		local success, transferOk, giverMessage, receiverMessage = pcall(function()
			return TycoonAdminAPI:Invoke("TransferTool", session.Giver, player, session.Tool)
		end)

		if not success or not transferOk then
			warn("Gift transfer failed:", success and giverMessage or transferOk)

			failSession(
				session,
				giverMessage or "Gift failed: Could not transfer car.",
				receiverMessage or "Gift failed: Could not receive car."
			)

			return
		end

		recordGift(session.Giver, player, session.CarId)

		sendGiverUpdate(
			session.Giver,
			"Success",
			"Successfully sent a gift to " .. session.Receiver.DisplayName .. "!"
		)

		sendReceiverUpdate(
			player,
			"Success",
			"Car Added to Inventory!"
		)

		clearSession(session)

	elseif action == "ReceiverDecline" then
		local giverId = getGiverIdFromData(data)
		if not giverId then
			return
		end

		local session = activeGiftsByGiver[giverId]
		if not session or session.State ~= "PendingReceiver" or session.Receiver ~= player then
			return
		end

		sendGiverUpdate(
			session.Giver,
			"Failed",
			session.Receiver.Name .. " declined the gift."
		)

		closePlayerUI(player)
		clearSession(session)

	elseif action == "ReceiverBusy" then
		local giverId = getGiverIdFromData(data)
		if not giverId then
			return
		end

		local session = activeGiftsByGiver[giverId]
		if not session or session.State ~= "PendingReceiver" or session.Receiver ~= player then
			return
		end

		sendGiverUpdate(
			session.Giver,
			"Failed",
			session.Receiver.Name .. " is currently busy."
		)

		clearSession(session)
	end
end)

-- ============================================================================
-- CLEANUP
-- ============================================================================

Players.PlayerAdded:Connect(watchReceiveGiftsSetting)
for _, existingPlayer in ipairs(Players:GetPlayers()) do
	task.spawn(watchReceiveGiftsSetting, existingPlayer)
end

Players.PlayerRemoving:Connect(function(leavingPlayer)
	lastTriggerTime[leavingPlayer.UserId] = nil

	if receiveGiftsSettingConnections[leavingPlayer.UserId] then
		receiveGiftsSettingConnections[leavingPlayer.UserId]:Disconnect()
		receiveGiftsSettingConnections[leavingPlayer.UserId] = nil
	end

	local sessionAsGiver = activeGiftsByGiver[leavingPlayer.UserId]
	if sessionAsGiver then
		if sessionAsGiver.State == "PendingReceiver" then
			closePlayerUI(sessionAsGiver.Receiver)
		end

		clearSession(sessionAsGiver)
	end

	local sessionAsReceiver = activeGiftsByReceiver[leavingPlayer.UserId]
	if sessionAsReceiver then
		sendGiverUpdate(
			sessionAsReceiver.Giver,
			"Failed",
			leavingPlayer.Name .. " left the game."
		)

		clearSession(sessionAsReceiver)
	end
end)
