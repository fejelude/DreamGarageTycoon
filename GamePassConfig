-- Purpose: Shared configuration for permanent garage-income Game Passes.
-- Location: ReplicatedStorage > GamePassConfig

local GamePassConfig = {}

GamePassConfig.Passes = {
	Exclusive = {
		Id = 1919259004,
		-- Set to the corresponding Developer Product id from Creator Dashboard.
		-- This is intentionally distinct from Id (which is a game-pass asset id).
		GiftProductId = 3628333262,
		GiftDisplayName = "Exclusive Perk",
		PurchaseDisplayName = "Exclusive",
		Attribute = "OwnsExclusiveGamePass",
		Multiplier = 1.8,
		ButtonName = "ExclusiveGamepass",
		OwnedLabelName = "OwnedLabelExclusive",
		SuccessMessage = "Exclusive Game Pass Owned",
		FailureMessage = "Exclusive Purchase Failed",
	},
	DoubleMoney = {
		Id = 1918448975,
		GiftProductId = 3628339938,
		GiftDisplayName = "2x Money Perk",
		PurchaseDisplayName = "2x Money",
		Attribute = "Owns2xMoneyGamePass",
		Multiplier = 2,
		ButtonName = "2xMoney",
		OwnedLabelName = "OwnedLabel2x",
		SuccessMessage = "2x Money Game Pass Owned",
		FailureMessage = "2x Money Purchase Failed",
	},
	OfflineEarnings = {
		Id = 3710404414,
		GiftProductId = 3710406142,
		GiftDisplayName = "2x Offline Earnings",
		PurchaseDisplayName = "2x Offline Earnings",
		Attribute = "Owns2xOfflineEarningsGamePass",
		OfflineMultiplier = 2,
		ButtonName = "2xOfflineEarnings",
		OwnedLabelName = "OwnedLabel2xOfflineEarnings",
		SuccessMessage = "2x Offline Earnings Game Pass Owned",
		FailureMessage = "2x Offline Earnings Purchase Failed",
	},
}

function GamePassConfig.GetPassById(gamePassId)
	gamePassId = tonumber(gamePassId)
	for passKey, passInfo in pairs(GamePassConfig.Passes) do
		if passInfo.Id == gamePassId then
			return passKey, passInfo
		end
	end
	return nil, nil
end

function GamePassConfig.GetGarageIncomeMultiplier(player)
	local multiplier = 1
	for _, passInfo in pairs(GamePassConfig.Passes) do
		if passInfo.Multiplier and player and player:GetAttribute(passInfo.Attribute) == true then
			multiplier *= passInfo.Multiplier
		end
	end
	return multiplier
end

function GamePassConfig.GetOfflineEarningsMultiplier(player)
	local passInfo = GamePassConfig.Passes.OfflineEarnings
	return player and player:GetAttribute(passInfo.Attribute) == true and passInfo.OfflineMultiplier or 1
end

function GamePassConfig.FormatMultiplier(multiplier)
	multiplier = tonumber(multiplier) or 1
	if math.abs(multiplier - math.floor(multiplier)) < 0.001 then
		return tostring(math.floor(multiplier)) .. "x"
	end
	return string.format("%.2fx", multiplier):gsub("0+x$", "x"):gsub("%.x$", "x")
end

return GamePassConfig
