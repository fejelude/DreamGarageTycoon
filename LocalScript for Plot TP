-- Handles Plot return teleport button interaction.
-- Hover/click uses UIScale (always scales from center, no AnchorPoint adjustment needed).

local Players          = game:GetService("Players")
local Workspace        = game:GetService("Workspace")
local TweenService     = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIAudioConfig    = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local player = Players.LocalPlayer
local button = script.Parent

-- ⚙️ CONFIG
local TYCOON_FOLDER_NAME = "Tycoons"
local SPAWN_PART_NAME    = "SpawnPoint"
local OWNER_VALUE_NAME   = "Owner"

-- ============================================================================
-- 🎨 HOVER ANIMATION (UIScale — always scales from center)
-- ============================================================================
local uiScale = button:FindFirstChildOfClass("UIScale")
if not uiScale then
	uiScale       = Instance.new("UIScale")
	uiScale.Scale = 1.0
	uiScale.Parent = button
end

local tweenInfo  = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
local isHovering = false
local isPressed  = false

local function updateScale()
	local target = 1.0
	if isPressed      then target = 0.95
	elseif isHovering then target = 1.05
	end
	TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
end

button.MouseEnter:Connect(function()
	isHovering = true
	UIAudioConfig.PlayHover()
	updateScale()
end)

button.MouseLeave:Connect(function()
	isHovering = false
	isPressed  = false
	updateScale()
end)

button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		isPressed = true
		updateScale()
	end
end)

button.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		isPressed = false
		updateScale()
	end
end)

-- ============================================================================
-- 🏠 TELEPORT LOGIC
-- ============================================================================
button.MouseButton1Click:Connect(function()
	UIAudioConfig.PlayClick()

	local tycoonFolder = Workspace:FindFirstChild(TYCOON_FOLDER_NAME)
	if not tycoonFolder then
		warn("❌ CRITICAL: Could not find folder named '" .. TYCOON_FOLDER_NAME .. "' in Workspace!")
		return
	end

	local foundPlot = nil
	for _, plot in pairs(tycoonFolder:GetChildren()) do
		local ownerObj = plot:FindFirstChild(OWNER_VALUE_NAME)
		if ownerObj and tostring(ownerObj.Value) == player.Name then
			foundPlot = plot
			break
		end
	end

	if foundPlot then
		local spawnPart = foundPlot:FindFirstChild(SPAWN_PART_NAME)
		if spawnPart then
			local char = player.Character
			if char then
				char:PivotTo(spawnPart.CFrame + Vector3.new(0, 5, 0))
			end
		else
			warn("❌ Found your plot (" .. foundPlot.Name .. ") but missing part named '" .. SPAWN_PART_NAME .. "'!")
		end
	else
		warn("❌ SEARCH FAILED: No plot found with Owner = " .. player.Name)
	end
end)
