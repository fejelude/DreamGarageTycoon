-- Handles Plot return teleport button interaction.
-- Hover/click uses UIScale (always scales from center, no AnchorPoint adjustment needed).

local Players          = game:GetService("Players")
local TweenService     = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIAudioConfig    = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))
local teleportFunction = ReplicatedStorage:WaitForChild("TeleportToPlaceFunction")

local player = Players.LocalPlayer
local button = script.Parent

-- ⚙️ CONFIG
local DESTINATION_NAME = "GarageTP"

-- ============================================================================
-- 🎨 HOVER ANIMATION (UIScale — always scales from center)
-- ============================================================================
local uiScale = button:FindFirstChildOfClass("UIScale")
if not uiScale then
	uiScale       = Instance.new("UIScale")
	uiScale.Scale = 1.0
	uiScale.Parent = button
end

local tweenInfo  = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
local isHovering = false
local isPressed  = false

local function updateScale()
	local target = 1.0
	if isPressed      then target = 0.95
	elseif isHovering then target = 1.05
	end
	TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
end

button.MouseEnter:Connect(function()
	isHovering = true
	UIAudioConfig.PlayHover()
	updateScale()
end)

button.MouseLeave:Connect(function()
	isHovering = false
	isPressed  = false
	updateScale()
end)

button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		isPressed = true
		updateScale()
	end
end)

button.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		isPressed = false
		updateScale()
	end
end)

-- ============================================================================
-- 🏠 TELEPORT LOGIC
-- ============================================================================
button.MouseButton1Click:Connect(function()
	UIAudioConfig.PlayClick()

	local ok, response = pcall(function()
		return teleportFunction:InvokeServer("Teleport", DESTINATION_NAME)
	end)

	if not ok or not (response and response.ok) then
		warn("❌ Garage teleport failed: " .. tostring(ok and response.message or response))
	end
end)
