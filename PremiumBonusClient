-- Purpose: Handles UI logic for the new PremiumBonus feature.
-- Runs on: Client
-- Location: StarterGui > PremiumBonus
-- Dependencies: TweenService, MarketplaceService
-- Public API: None
-- Networking: None
-- Security: Client side visuals only. Actual premium multiplier is calculated securely on the server.
-- Performance: Lightweight event listeners.
-- Notes: Follows standardized UI button patterns.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")

local player = Players.LocalPlayer
local gui = script.Parent -- PremiumBonus Frame/ScreenGui
local button = gui:WaitForChild("Button")
local information = button:WaitForChild("Information")
local addedBonusLabel = gui:WaitForChild("AddedBonus")

-- Sounds
local HOVER_SOUND_ID = "rbxassetid://6895079853"
local CLICK_SOUND_ID = "rbxassetid://9083627113"

local hoverSound = Instance.new("Sound")
hoverSound.SoundId = HOVER_SOUND_ID
hoverSound.Parent = button

local clickSound = Instance.new("Sound")
clickSound.SoundId = CLICK_SOUND_ID
clickSound.Parent = button

-- Initial UI State
information.Visible = false

local originalColor = button.ImageColor3
local hoverColor = Color3.new(0.7, 0.7, 0.7)
local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local hoverEnterTween = TweenService:Create(button, tweenInfo, {ImageColor3 = hoverColor})
local hoverLeaveTween = TweenService:Create(button, tweenInfo, {ImageColor3 = originalColor})

button.MouseEnter:Connect(function()
	hoverSound:Play()
	information.Visible = true
	hoverEnterTween:Play()
end)

button.MouseLeave:Connect(function()
	information.Visible = false
	hoverLeaveTween:Play()
end)

button.Activated:Connect(function()
	clickSound:Play()
	local success, err = pcall(function()
		MarketplaceService:PromptPremiumPurchase(player)
	end)
	if not success then
		warn("Failed to prompt premium purchase: " .. tostring(err))
	end
end)

-- The text is static as requested (+50%). We only show it.
addedBonusLabel.Text = "+50%"
