		Cash      = 90000000,
		Riva      = 5,
		Kingston  = 3,
		Velocity  = 2,
		Vortex    = 1,
		CraftTime = 43200, -- 12 hours
	},
}

local MAX_INTERACTION_DISTANCE     = 20
local OPEN_REQUEST_COOLDOWN_SECONDS = 1

