PersistenceBindable.OnInvoke = function(action, player, data)
	if not player then return end
	local uid = player.UserId

	if action == "Load" then
		local session = getSession(player)

		if type(data) == "table" then
			local sanitized = sanitizeCraftState(data)
			session.CraftProgress = sanitized.CraftProgress
			session.ActiveCrafts = sanitized.ActiveCrafts
			session.CompletedCrafts = sanitized.CompletedCrafts
			session.AwardedCrafts = sanitized.AwardedCrafts
			session.PendingPremiumCraft = sanitized.PendingPremiumCraft

			print("✅ [LegendaryShop] Loaded progress for " .. player.Name)
		end

	elseif action == "HasActiveCraft" then
		local session = getSession(player)
		return next(session.ActiveCrafts) ~= nil or session.PendingPremiumCraft ~= nil

	elseif action == "Get" then
		local session = getSession(player)
		return {
			CraftProgress   = session.CraftProgress,
			ActiveCrafts    = session.ActiveCrafts,
			CompletedCrafts = session.CompletedCrafts,
			AwardedCrafts   = session.AwardedCrafts,
			PendingPremiumCraft = session.PendingPremiumCraft,
		}

	elseif action == "Close" then
		PlayerSessions[uid]    = nil
		InteractionLocks[uid]  = nil
		LastOpenRequestAt[uid] = nil
		PendingSacrificeConfirmations[uid] = nil
	end
end

local function recordRankCraft(player, carName, operationId)
	local rankApi = ServerStorage:FindFirstChild("RankProgressAPI")
	if not rankApi or not rankApi:IsA("BindableFunction") then return false end
	local ok, result = pcall(function()
		return rankApi:Invoke("CarObtained", player, carName, "Craft", nil, operationId)
	end)
	return ok and result == true
end

local function clearExpiredSacrificeConfirmations(uid)
	local confirmations = PendingSacrificeConfirmations[uid]
	if not confirmations then return end

	local now = os.clock()
	for token, confirmation in pairs(confirmations) do
		if type(confirmation) ~= "table" or (confirmation.ExpiresAt or 0) <= now then
			confirmations[token] = nil
		end
	end
end

local function issueSacrificeConfirmation(player, carName, ingredient)
	local uid = player.UserId
	clearExpiredSacrificeConfirmations(uid)

	local token = HttpService:GenerateGUID(false)
	PendingSacrificeConfirmations[uid] = PendingSacrificeConfirmations[uid] or {}
	PendingSacrificeConfirmations[uid][token] = {
		CarName = carName,
		Ingredient = ingredient,
		ExpiresAt = os.clock() + CONFIRMATION_TOKEN_TTL_SECONDS,
	}

	return token
end

local function consumeSacrificeConfirmation(player, carName, ingredient, token)
	if type(token) ~= "string" or token == "" then
		return false
	end

	local uid = player.UserId
	clearExpiredSacrificeConfirmations(uid)

	local confirmations = PendingSacrificeConfirmations[uid]
	local confirmation = confirmations and confirmations[token]
	if type(confirmation) ~= "table" then
		return false
	end

	confirmations[token] = nil
	return confirmation.CarName == carName and confirmation.Ingredient == ingredient
end

local function validateMutationContext(player, action)
	if not player or not player.Parent then return false, "Player missing" end
	if player:GetAttribute("TycoonDataLoaded") ~= true then return false, "Player data is still loading" end
	if not hasRequiredRank(player) then return false, "Rank requirement not met" end
	if not isNearShop(player) then return false, "Move closer to the Legendary shop" end
	if not MutationRateLimiter.Allow(player, "LegendaryShop:" .. action, 5, 2) then
		return false, "Please wait a moment"
	end
	return true
end

local function hasCrossTierCraft(player)
	if not MythicalPersistenceBindable or not MythicalPersistenceBindable:IsA("BindableFunction") then return false end
	local ok, active = safeInvoke(MythicalPersistenceBindable, 3, "HasActiveCraft", player)
	return ok and active == true
end

local function preparePremiumIntent(player, carName, session)
	local recipe = RECIPES[carName]
	if not recipe then return false, "Invalid Legendary Car" end
	local existing, lookupError = PaidActionIntentStore.GetPending(player.UserId, 3573930334, "LegendaryCraftSkip")
	if existing == nil then return false, lookupError or "Paid-action intent unavailable" end
	if existing then
		if existing.Payload and existing.Payload.CarName == carName then
			session.PendingPremiumIntentId = existing.IntentId
			return true, existing.IntentId
		end
		return false, "Another premium craft purchase is unresolved"
	end
	local ok, intentId = PaidActionIntentStore.Create(player, 3573930334, "LegendaryCraftSkip", {
		CarName = carName,
		TargetCar = recipe.TargetCar,
		OriginalEndTime = tonumber(session.ActiveCrafts[carName]) or 0,
		Mode = session.ActiveCrafts[carName] and "ActiveCraft" or "PreparedCraft",
	})
	if not ok then return false, intentId or "Unable to prepare premium craft" end
	session.PendingPremiumIntentId = intentId
	return true, intentId
end

