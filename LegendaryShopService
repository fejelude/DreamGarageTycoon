-- =========================
-- TIMEOUT UTILITY
-- =========================
local function safeInvoke(bindable, timeout, ...)
	local args = table.pack(...)
	local result = table.pack(pcall(function()
		return bindable:Invoke(table.unpack(args, 1, args.n))
	end))
	if not result[1] then return false, result[2] end
	return true, table.unpack(result, 2, result.n)
end

local function invokeInventory(action, ...)
	local args = table.pack(...)
	local ok, result1, result2, result3 = pcall(function()
		return LegendaryInventoryBindable:Invoke(action, table.unpack(args, 1, args.n))
	end)
	if not ok then
		return false, result1
	end
	return true, result1, result2, result3
end

local function savePlayerNow(player)
	local invokeOk, saveOk, saveMessage = invokeInventory("SaveNow", player)
	if not invokeOk then
		return false, tostring(saveOk or "Save system error")
	end
	if saveOk ~= true then
		return false, tostring(saveMessage or saveOk or "Save failed")
	end
	return true
end

local function queuePlayerSaveSoon(player)
	local invokeOk, saveOk, saveMessage = invokeInventory("QueueSaveSoon", player, 8)
	if not invokeOk then
		return false, tostring(saveOk or "Save system error")
	end
	if saveOk ~= true then
		return false, tostring(saveMessage or saveOk or "Save queue failed")
	end
	return true
end

local function grantCraftReward(player, recipeCarName, realToolName, source, receiptInfo)
	local attributes = {
		BypassStorageLimit = true,
		Source = source,
		CraftRecipe = recipeCarName,
	}
	if type(receiptInfo) == "table" then
		attributes.ReceiptPurchaseId = tostring(receiptInfo.PurchaseId)
		attributes.ReceiptProductId = receiptInfo.ProductId
	end
	return invokeInventory("GiveTool", player, realToolName, attributes)
end

