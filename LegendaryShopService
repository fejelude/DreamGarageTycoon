local function getSession(player)
	local uid = player.UserId
	if not PlayerSessions[uid] then
		PlayerSessions[uid] = {
			CraftProgress  = { 
				["LaRossa"] = {}, ["Yamura"] = {},
				["Neo-Periscopio"] = {}, ["Neo-Performante"] = {},
				["Neo-Zentorno"] = {}, ["Neo-Revuelto"] = {}
			},
			ActiveCrafts   = {},
			CompletedCrafts = {},
			AwardedCrafts = {},
			PendingPremiumCraft = nil,
			PendingPremiumIntentId = nil,
		}
	end
	return PlayerSessions[uid]
end

local function sanitizeCraftState(raw)
	raw = type(raw) == "table" and raw or {}
	local clean = {
		CraftProgress = {}, ActiveCrafts = {}, CompletedCrafts = {}, AwardedCrafts = {},
		PendingPremiumCraft = nil,
	}
	for carName, recipe in pairs(RECIPES) do
		local rawProgress = type(raw.CraftProgress) == "table" and raw.CraftProgress[carName] or nil
		local progress = {}
		for ingredient, required in pairs(recipe) do
			if ingredient ~= "TargetCar" and ingredient ~= "CraftTime" then
				progress[ingredient] = math.clamp(math.floor(tonumber(rawProgress and rawProgress[ingredient]) or 0), 0, required)
			end
		end
		clean.CraftProgress[carName] = progress
		local activeEnd = type(raw.ActiveCrafts) == "table" and tonumber(raw.ActiveCrafts[carName]) or nil
		if activeEnd and activeEnd > 0 then clean.ActiveCrafts[carName] = math.floor(activeEnd) end
		local completedAt = type(raw.CompletedCrafts) == "table" and tonumber(raw.CompletedCrafts[carName]) or nil
		if completedAt and completedAt > 0 then clean.CompletedCrafts[carName] = math.floor(completedAt) end
		local awardedAt = type(raw.AwardedCrafts) == "table" and tonumber(raw.AwardedCrafts[carName]) or nil
		if awardedAt and awardedAt > 0 then clean.AwardedCrafts[carName] = math.floor(awardedAt) end
	end
	if type(raw.PendingPremiumCraft) == "string" and RECIPES[raw.PendingPremiumCraft] then
		clean.PendingPremiumCraft = raw.PendingPremiumCraft
	end
	return clean
end

local function buildStatePayload(session)
	return {
		CraftProgress   = session.CraftProgress,
		ActiveCrafts    = session.ActiveCrafts,
		CompletedCrafts = session.CompletedCrafts,
		AwardedCrafts   = session.AwardedCrafts,
		PendingPremiumCraft = session.PendingPremiumCraft,
	}
end

local function pushUpdate(player, session, reason)
	local payload = buildStatePayload(session)
	payload.Reason = reason
	RemoteUpdate:FireClient(player, payload)
end

