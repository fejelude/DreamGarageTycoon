FuncAcknowledge.OnServerInvoke = function(player, carName)
	if typeof(carName) ~= "string" then return false end
	local contextOk = validateMutationContext(player, "Acknowledge")
	if not contextOk then return false end
	return PlayerTransactionCoordinator.Run(player, "AcknowledgeLegendaryCraft", function()
		local session = getSession(player)
		if session.CompletedCrafts[carName] then
			session.CompletedCrafts[carName] = nil
			pushUpdate(player, session, "Acknowledge")
			return savePlayerNow(player)
		end
		return false
	end)
end

-- =========================
-- SKIP CRAFTING BINDABLE (FROM RECEIPT ROUTER)
-- =========================
SkipCraftFunc.OnInvoke = function(player, purchaseId, intent)
	if not player then return false, "No player provided" end
	if not player.Parent then return false, "Player left before craft skip could be granted" end
	if type(purchaseId) ~= "string" or purchaseId == ""
		or type(intent) ~= "table" or intent.Action ~= "LegendaryCraftSkip"
		or type(intent.Payload) ~= "table" or not RECIPES[intent.Payload.CarName]
	then
		return false, "Invalid Legendary craft intent"
	end
	local intendedCar = intent.Payload.CarName
	local receiptInfo = { PurchaseId = purchaseId, ProductId = 3573930334 }

	local uid = player.UserId
	if InteractionLocks[uid] then
		-- ProcessReceipt will return NotProcessedYet, letting Roblox retry after the
		-- in-flight craft/sacrifice/save operation finishes instead of racing it.
		return false, "Craft transaction in progress"
	end

	InteractionLocks[uid] = true

	local pOk, logicOk, msg = pcall(function()
		return PlayerTransactionCoordinator.Run(player, "GrantLegendaryCraftSkip", function()
		local session = getSession(player)

		local receiptOk, alreadyGranted = invokeInventory("HasReceiptGrant", player, purchaseId)
		if receiptOk and alreadyGranted == true then return true, "Already granted" end

		local function grantCapturedRewardFallback(reason)
			local recipe = RECIPES[intendedCar]
			local invokeOk, giveResult, giveMessage = grantCraftReward(
				player, intendedCar, recipe.TargetCar, "LegendaryCraftSkipFallback", receiptInfo
			)
			if not invokeOk or giveResult == false then
				return false, giveMessage or giveResult or "System error granting paid craft fallback"
			end
			if session.PendingPremiumCraft == intendedCar then session.PendingPremiumCraft = nil end
			recordRankCraft(player, recipe.TargetCar, tostring(purchaseId))
			local saveOk, saveMessage = savePlayerNow(player)
			if not saveOk then
				-- Keep the receipt-tagged projection. A receipt retry saves the same
				-- grant instead of producing another car.
				return false, saveMessage or "System error saving paid craft fallback"
			end
			pushUpdate(player, session, "Skipped")
			return true, reason
		end

		if session.PendingPremiumCraft == intendedCar
			and session.CompletedCrafts[intendedCar]
			and not session.ActiveCrafts[intendedCar]
		then
			return grantCapturedRewardFallback("Craft completed independently; equivalent car granted")
		end

		local activeCars = {}
		if session.PendingPremiumCraft == intendedCar then
			table.insert(activeCars, {
				CarName = intendedCar,
				WasPendingPremium = true,
				OriginalEndTime = nil,
			})
			session.PendingPremiumCraft = nil
		elseif session.ActiveCrafts[intendedCar] then
			table.insert(activeCars, {
				CarName = intendedCar,
				WasPendingPremium = false,
				OriginalEndTime = session.ActiveCrafts[intendedCar],
			})
		else
			-- The immutable intent was validated before the prompt. If the original
			-- job completed or its live projection disappeared before the delayed
			-- receipt, the exact target car is the documented paid fallback.
			return grantCapturedRewardFallback("Original craft unavailable; equivalent car granted")
		end

		local foundActive = false
		local grantFailureMessage = nil
		for _, craftInfo in ipairs(activeCars) do
			local carName = craftInfo.CarName
			local recipe = RECIPES[carName]
			if not recipe then
				grantFailureMessage = "Invalid craft recipe"
				continue
			end

			session.ActiveCrafts[carName] = nil
			session.CompletedCrafts[carName] = os.time()
			session.CraftProgress[carName] = {}
			local realToolName = recipe.TargetCar
			local alreadyAwarded = session.AwardedCrafts[carName] ~= nil
			session.AwardedCrafts[carName] = session.AwardedCrafts[carName] or os.time()
			local invokeOk, giveResult, giveMessage = grantCraftReward(
				player, carName, realToolName, "LegendaryCraftSkip", receiptInfo
			)

			if invokeOk and giveResult ~= false then
				recordRankCraft(player, realToolName, tostring(purchaseId))
				local saveOk, saveMessage = savePlayerNow(player)
				if not saveOk then
					warn("[LegendaryShop] Failed to save skipped " .. realToolName .. " for " .. player.Name .. ": " .. tostring(saveMessage))
					-- Keep the in-memory state and receipt-tagged tool intact. A retry
					-- force-saves the same state instead of granting a second car.
					return false, saveMessage or "System error saving item"
				end
				pushUpdate(player, session, "Skipped")
				foundActive = true
			else
				warn("⚠️ [LegendaryShop] Failed to grant skipped " .. realToolName .. " to " .. player.Name)
				grantFailureMessage = giveMessage or giveResult or "System error granting item"
				if craftInfo.WasPendingPremium then
					session.PendingPremiumCraft = carName
				else
					session.ActiveCrafts[carName] = craftInfo.OriginalEndTime
				end
				session.CompletedCrafts[carName] = nil
				if not alreadyAwarded then
					session.AwardedCrafts[carName] = nil
				end
			end
		end

		if not foundActive then
			return false, grantFailureMessage or "No matching craft to skip"
		end

		return true, "Success"
		end)
	end)

	InteractionLocks[uid] = nil

	if not pOk then
		warn("Legendary Shop Skip Error:", logicOk)
		return false, "Internal System Error"
	end

	return logicOk, msg
end

MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
	if productId ~= 3573930334 or wasPurchased == true then return end
	local player = Players:GetPlayerByUserId(userId)
	local session = player and PlayerSessions[userId]
	if not player or not session or not session.PendingPremiumIntentId then return end
	PaidActionIntentStore.Cancel(player, productId, session.PendingPremiumIntentId)
	session.PendingPremiumIntentId = nil
	session.PendingPremiumCraft = nil
	pushUpdate(player, session, "PremiumCancelled")
	savePlayerNow(player)
end)

-- =========================
-- OFFLINE COMPLETION / TIMER LOOP
-- =========================
task.spawn(function()
	while true do
		task.wait(5)
		local now = os.time()

		for uid, session in pairs(PlayerSessions) do
			local player = Players:GetPlayerByUserId(uid)
			if not player then continue end
			if InteractionLocks[uid] then continue end

			InteractionLocks[uid] = true
			local pOk, err = pcall(function()
				return PlayerTransactionCoordinator.Run(player, "CompleteLegendaryCraft", function()
				local dirty = false

				for carName, endTime in pairs(session.ActiveCrafts) do
				if now >= endTime then
					session.ActiveCrafts[carName]   = nil
					if session.PendingPremiumCraft == carName then
						session.PendingPremiumCraft = nil
					end
					session.CompletedCrafts[carName] = now
					session.CraftProgress[carName] = {}

					local realToolName           = RECIPES[carName].TargetCar
					local alreadyAwarded = session.AwardedCrafts[carName] ~= nil
					session.AwardedCrafts[carName] = session.AwardedCrafts[carName] or now
					local invokeOk, giveResult, giveMessage =
						grantCraftReward(player, carName, realToolName, "LegendaryCraftComplete")

					if invokeOk and giveResult ~= false then
						if not alreadyAwarded then
							recordRankCraft(player, realToolName, string.format(
								"LegendaryCraft:%d:%s:%d", player.UserId, carName, endTime
							))
						end
						savePlayerNow(player)
						print("✅ [LegendaryShop] Granted " .. realToolName .. " to " .. player.Name)
						dirty = true
					else
						warn("⚠️ [LegendaryShop] Failed to grant " .. realToolName .. " to " .. player.Name)
						-- Revert so the loop retries on the next tick
						session.ActiveCrafts[carName]   = endTime
						session.CompletedCrafts[carName] = nil
						if not alreadyAwarded then
							session.AwardedCrafts[carName] = nil
						end
					end
				end
			end

				if dirty then
					pushUpdate(player, session, "Complete")
					savePlayerNow(player)
				end
				end)
			end)

			InteractionLocks[uid] = nil
			if not pOk then
				warn("Legendary Shop Completion Error:", err)
			end
		end
	end
end)
