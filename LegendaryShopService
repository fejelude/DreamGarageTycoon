local RANK_VALUES = { Player = 0, VIP = 1, ["VIP+"] = 2, MVP = 3, ["MVP+"] = 4, ["MVP++"] = 5 }
local function hasRequiredRank(player)
	return (RANK_VALUES[player:GetAttribute("Rank") or "Player"] or 0) >= (RANK_VALUES["MVP+"] or 0)
end

local function isNearShop(player)
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local npcs = workspace:FindFirstChild("NPCS")
	local npc = npcs and npcs:FindFirstChild("Monk3yDAngelo-Cars")
	local npcRoot = npc and npc:FindFirstChild("HumanoidRootPart")
	return root ~= nil and npcRoot ~= nil and (root.Position - npcRoot.Position).Magnitude <= MAX_INTERACTION_DISTANCE
end

