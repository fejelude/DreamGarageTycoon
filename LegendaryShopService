	["LaRossa"] = {
		TargetCar = "La Rossa",
		Cash      = 150000000,
		Riva      = 7,
		Kingston  = 3,
		Velocity  = 4,
		Vortex    = 2,
		CraftTime = 172800, -- 48 hours
	},
	["Yamura"] = {
