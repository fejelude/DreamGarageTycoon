-- Purpose: Handles server-side validation and execution for selling cars to Lorraine.
-- Runs on: Server
-- Location: ServerScriptService > LorraineSellService
-- Dependencies: ReplicatedStorage, ServerStorage, Players
-- Public API: None
-- Networking: Listens to LorraineSellFunction (RemoteFunction)
-- Security: Server-authoritative inventory checks, debounces, distance checks, and economy limits.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")

local CarSellPrices = require(ReplicatedStorage:WaitForChild("CarSellPrices"))
local SellFunction = ReplicatedStorage:WaitForChild("LorraineSellFunction")
local TycoonAdminAPI = ServerStorage:WaitForChild("TycoonAdminAPI")

local MAX_DISTANCE = 30 -- Max interaction distance

local activeTransactions = {}

local function getMainPart(obj)
	if not obj then return nil end
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
	end
	return nil
end

local function isPlayerNearLorraine(player)
	local character = player.Character
	if not character then return false, "Character not found." end

	local pRoot = character:FindFirstChild("HumanoidRootPart")
	local npcFolder = workspace:FindFirstChild("NPCS")
	local lorraineNpc = npcFolder and npcFolder:FindFirstChild("Lorraine")
	if not pRoot or not lorraineNpc then
		return false, "Security check failed: distance could not be verified."
	end

	local npcRoot = lorraineNpc:FindFirstChild("HumanoidRootPart") or lorraineNpc.PrimaryPart
	if not npcRoot then
		return false, "NPC not found."
	end

	if (pRoot.Position - npcRoot.Position).Magnitude > MAX_DISTANCE then
		return false, "You are too far away."
	end

	return true
end

local function getToolSellDetails(tool)
	if not tool or not tool:IsA("Tool") then return nil end
	if tool:GetAttribute("IssuedByServer") ~= true then return nil end

	local toolId = tool:GetAttribute("ToolId") or tool.Name
	local cleanId = CarSellPrices.CleanId(toolId)
	local details = CarSellPrices.GetDetails(cleanId)
	if not details or not details.SellPrice or details.SellPrice <= 0 then return nil end

	return cleanId, details
end

local function collectSellableInventoryTools(player)
	local sellableTools = {}
	local seen = {}

	local function scan(container)
		if not container then return end
		for _, child in ipairs(container:GetChildren()) do
			local cleanId, details = getToolSellDetails(child)
			if cleanId and not seen[child] then
				seen[child] = true
				table.insert(sellableTools, {
					Tool = child,
					CleanId = cleanId,
					SellPrice = details.SellPrice,
				})
			end
		end
	end

	scan(player:FindFirstChild("Backpack"))
	if player.Character then scan(player.Character) end

	return sellableTools
end

local function collectSellablePlacedCars(player)
	local sellableCars = {}
	local plotName = player:GetAttribute("OccupiedPlot")
	local tycoons = workspace:FindFirstChild("Tycoons")
	local plot = plotName and tycoons and tycoons:FindFirstChild(plotName)
	if not plot then return sellableCars end

	for _, descendant in ipairs(plot:GetDescendants()) do
		if descendant.Name == "LinkedCar" and descendant:IsA("ObjectValue") and descendant.Value then
			local car = descendant.Value
			if car.Parent and car:GetAttribute("OwnerUserId") == player.UserId then
				local details = CarSellPrices.GetDetails(car.Name)
				if details and details.SellPrice and details.SellPrice > 0 then
					table.insert(sellableCars, {
						Car = car,
						LinkedCar = descendant,
						PadPart = getMainPart(descendant.Parent),
						SellPrice = details.SellPrice,
					})
				end
			end
		end
	end

	return sellableCars
end

local function clearStarterGearMirrors(player)
	local starterGear = player:FindFirstChild("StarterGear")
	if not starterGear then return end
	for _, child in ipairs(starterGear:GetChildren()) do
		if getToolSellDetails(child) then
			child:Destroy()
		end
	end
end

local function resetPlacedCarPad(entry)
	local padPart = entry.PadPart
	if not padPart then return end

	local occupied = padPart:FindFirstChild("IsOccupied")
	if occupied and occupied:IsA("BoolValue") then
		occupied.Value = false
	end

	if entry.LinkedCar and entry.LinkedCar.Parent then
		entry.LinkedCar.Value = nil
	end

	local placePrompt = padPart:FindFirstChild("PlacePrompt")
	if placePrompt and placePrompt:IsA("ProximityPrompt") then
		placePrompt.Enabled = true
	end

	local pickupPrompt = padPart:FindFirstChild("PickupPrompt")
	if pickupPrompt and pickupPrompt:IsA("ProximityPrompt") then
		pickupPrompt.Enabled = false
	end
end

SellFunction.OnServerInvoke = function(player, action)
	if action ~= "SellAllCars" then
		return false, "Invalid request format."
	end

	if activeTransactions[player.UserId] then
		return false, "Transaction in progress. Please wait."
	end
	activeTransactions[player.UserId] = true

	local success, result, msg = pcall(function()
		local nearLorraine, distanceMessage = isPlayerNearLorraine(player)
		if not nearLorraine then
			return false, distanceMessage
		end

		local toolsToSell = collectSellableInventoryTools(player)
		local placedCarsToSell = collectSellablePlacedCars(player)
		if #toolsToSell == 0 and #placedCarsToSell == 0 then
			return false, "You do not have any cars to sell."
		end

		local sellAmount = 0
		for _, entry in ipairs(toolsToSell) do
			sellAmount += entry.SellPrice
		end
		for _, entry in ipairs(placedCarsToSell) do
			sellAmount += entry.SellPrice
		end

		if sellAmount <= 0 then
			return false, "Invalid sell amount."
		end

		local leaderstats = player:FindFirstChild("leaderstats")
		local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")
		if not wallet then
			return false, "Could not locate wallet."
		end

		for _, entry in ipairs(toolsToSell) do
			if entry.Tool and entry.Tool.Parent then
				entry.Tool:Destroy()
			end
		end
		clearStarterGearMirrors(player)

		for _, entry in ipairs(placedCarsToSell) do
			resetPlacedCarPad(entry)
			if entry.Car and entry.Car.Parent then
				entry.Car:Destroy()
			end
		end

		wallet.Value += sellAmount
		TycoonAdminAPI:Invoke("MarkInventoryCleared", player)

		print("💰 Lorraine Sell All: " .. player.Name .. " sold " .. tostring(#toolsToSell + #placedCarsToSell) .. " cars for $" .. tostring(sellAmount))
		return true, "Success", sellAmount, #toolsToSell + #placedCarsToSell
	end)

	if not success then
		warn("⚠️ Lorraine Transaction Error for " .. player.Name .. ": " .. tostring(result))
		activeTransactions[player.UserId] = nil
		return false, "System Error"
	end

	task.delay(1, function()
		activeTransactions[player.UserId] = nil
	end)

	return result, msg
end

Players.PlayerRemoving:Connect(function(player)
	activeTransactions[player.UserId] = nil
end)
