-- Purpose: Server authority for rebirth progression + cash-deduct rebirth flow.
-- Location: ServerScriptService > RebirthService

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local RebirthConfig = require(ReplicatedStorage:WaitForChild("RebirthConfig"))
local PlayerTransactionCoordinator = require(ServerScriptService:WaitForChild("PlayerTransactionCoordinator"))
local PaidActionIntentStore = require(ServerScriptService:WaitForChild("PaidActionIntentStore"))
local MutationRateLimiter = require(ServerScriptService:WaitForChild("MutationRateLimiter"))

local remotes = ReplicatedStorage:WaitForChild("RebirthRemotes")
local requestRebirth = remotes:WaitForChild("RequestRebirth")
local refreshEvent = remotes:WaitForChild("RefreshRebirthUI")

local rebirthLocks = {}

local function getWalletValue(player)
	local leaderstats = player:FindFirstChild("leaderstats")
	return leaderstats and leaderstats:FindFirstChild("Wallet")
end

local function getRebirth(player)
	return math.clamp(
		math.floor(tonumber(player:GetAttribute("Rebirth")) or 0),
		0,
		RebirthConfig.MAX_REBIRTH
	)
end

local function buildSuccessMessage(rebirth)
	return "Success: You rebirthed to Rebirth " .. tostring(rebirth) .. "."
end

local function setRebirth(player, newRebirth)
	local clamped = math.clamp(
		math.floor(tonumber(newRebirth) or 0),
		0,
		RebirthConfig.MAX_REBIRTH
	)

	player:SetAttribute("Rebirth", clamped)
	player:SetAttribute("RebirthMultiplier", RebirthConfig.GetMultiplier(clamped))

	return clamped
end

local function getSnapshot(player)
	local walletValue = getWalletValue(player)
	local rebirth = getRebirth(player)
	local nextRebirth = math.min(rebirth + 1, RebirthConfig.MAX_REBIRTH)

	return {
		CurrentRebirth = rebirth,
		NextRebirth = nextRebirth,
		CurrentMultiplier = RebirthConfig.GetMultiplier(rebirth),
		NextMultiplier = RebirthConfig.GetMultiplier(nextRebirth),
		RequiredCash = rebirth >= RebirthConfig.MAX_REBIRTH and 0 or RebirthConfig.GetCost(rebirth + 1),
		CurrentCash = walletValue and walletValue.Value or 0,
		Maxed = rebirth >= RebirthConfig.MAX_REBIRTH,
	}
end

local function withRebirthLock(player, callback)
	if rebirthLocks[player] then
		return false, "Rebirth is already processing."
	end

	rebirthLocks[player] = true

	local ok, success, message, snapshot = pcall(callback)

	rebirthLocks[player] = nil

	if not ok then
		warn("[RebirthService] Rebirth failed for", player, success)
		return false, "Rebirth failed. Please try again."
	end

	return success, message, snapshot
end

requestRebirth.OnServerInvoke = function(player, action, ...)
	if action == "Snapshot" then
		return true, getSnapshot(player)
	end

	if action == "PrepareRobuxRebirth" then
		if not MutationRateLimiter.Allow(player, "PrepareRobuxRebirth", 2, 0.25) then
			return false, "Please wait a moment."
		end
		local rebirth = getRebirth(player)
		if rebirth >= RebirthConfig.MAX_REBIRTH then return false, "Max rebirth reached." end
		local productId = RebirthConfig.SkipProductIds[rebirth]
		if not productId then return false, "Robux rebirth is unavailable for this level." end
		local ok, intentId = PaidActionIntentStore.Create(player, productId, "RebirthSkip", {
			FromRebirth = rebirth,
			ToRebirth = rebirth + 1,
			CompensationWallet = RebirthConfig.GetCost(rebirth + 1),
		})
		if not ok then return false, intentId or "Unable to prepare the purchase." end
		return true, productId, intentId, rebirth
	end

	if action == "CancelRobuxRebirth" then
		local productId, intentId = ...
		if type(intentId) ~= "string" then return false end
		return PaidActionIntentStore.Cancel(player, productId, intentId)
	end

	if action ~= "CashRebirth" then
		return false, "Invalid action."
	end

	return withRebirthLock(player, function()
		return PlayerTransactionCoordinator.Run(player, "CashRebirth", function()
		local rebirth = getRebirth(player)

		if rebirth >= RebirthConfig.MAX_REBIRTH then
			return false, "Max rebirth reached."
		end

		local walletValue = getWalletValue(player)

		if not walletValue then
			return false, "Wallet data unavailable."
		end

		local required = RebirthConfig.GetCost(rebirth + 1)

		if walletValue.Value < required then
			return false, "Failed: Not enough cash to rebirth."
		end

		walletValue.Value -= required

		local newRebirth = setRebirth(player, rebirth + 1)
		local snapshot = getSnapshot(player)

		return true, buildSuccessMessage(newRebirth), snapshot
		end)
	end)
end

Players.PlayerAdded:Connect(function(player)
	if player:GetAttribute("Rebirth") == nil then
		player:SetAttribute("Rebirth", 0)
	end

	player:SetAttribute("RebirthMultiplier", RebirthConfig.GetMultiplier(getRebirth(player)))
end)

Players.PlayerRemoving:Connect(function(player)
	rebirthLocks[player] = nil
end)
