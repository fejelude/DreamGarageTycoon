-- Purpose: Handles Camera movement and UI changes when entering 2x Money AFK Mode.
-- Runs on: Client
-- Location: StarterPlayerScripts
-- Dependencies: Players, Workspace, ReplicatedStorage, TweenService, UserInputService
-- Public API: None
-- Networking: Uses AFKStandEvent to communicate state changes to the server.
-- Performance: Utilizes TweenService for smooth transitions and avoids continuous looping.
-- Notes: Safely hides active screen GUIs while keeping standard chat available. Expects AFKStandEvent in ReplicatedStorage.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local playerGui = player:WaitForChild("PlayerGui")

local AFKEvent = ReplicatedStorage:WaitForChild("AFKStandEvent", 10)
if not AFKEvent then
	warn("⚠️ AFKStandController: 'AFKStandEvent' RemoteEvent not found in ReplicatedStorage! Please create it.")
end

local moneyFolder = Workspace:WaitForChild("2X-Money", 10)
local cameraFolder = nil
if moneyFolder then
	cameraFolder = moneyFolder:WaitForChild("Cameras", 10)
end

-- UI Setup
local generatingGui = playerGui:WaitForChild("2XMoney", 10)
local generatingFrame = nil
local exitButton = nil

if generatingGui then
	generatingFrame = generatingGui:WaitForChild("GeneratingMoneyFrame", 10)
	if generatingFrame then
		exitButton = generatingFrame:WaitForChild("ExitButton", 10)
	end
end

if not generatingFrame or not exitButton then
	warn("⚠️ AFKStandController: 'GeneratingMoneyFrame' or 'ExitButton' not found in PlayerGui.2XMoney!")
end

local hiddenGuis = {}
local inAFKMode = false
local originalCameraType = Enum.CameraType.Custom

-- Sound logic replaced by UIAudioConfig

-- ============================================================================
-- 🎨 UI ANIMATION HELPER
-- ============================================================================
local function setupHoverScale(btn)
	if not btn then return end

	local uiScale = btn:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Scale = 1.0
		uiScale.Parent = btn
	end

	local isHovering = false
	local isPressed  = false
	local tweenInfo  = TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	local function updateScale()
		local target = 1.0
		if isPressed     then target = 0.95
		elseif isHovering then target = 1.05
		end
		TweenService:Create(uiScale, tweenInfo, {Scale = target}):Play()
	end

	btn.MouseEnter:Connect(function()
		isHovering = true
		UIAudioConfig.PlayHover()
		updateScale()
	end)
	btn.MouseLeave:Connect(function()
		isHovering = false
		isPressed  = false
		updateScale()
	end)
	btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = true
			updateScale()
		end
	end)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			isPressed = false
			updateScale()
		end
	end)
end

-- ============================================================================
-- 👁️ UI VISIBILITY HELPER
-- Defined before CharacterAdded so it is never a forward reference.
-- ============================================================================
local function toggleOtherGuis(shouldHide)
	local pg = player:WaitForChild("PlayerGui")
	if shouldHide then
		if #hiddenGuis > 0 then return end
		hiddenGuis = {}
		for _, gui in ipairs(pg:GetDescendants()) do
			if gui:IsA("ScreenGui") and gui.Name ~= "2XMoney" and gui.Enabled == true then
				gui.Enabled = false
				table.insert(hiddenGuis, gui)
			end
		end
	else
		for _, gui in ipairs(hiddenGuis) do
			if gui and gui.Parent then
				gui.Enabled = true
			end
		end
		hiddenGuis = {}
	end
end

-- ============================================================================
-- 🎞️ ANIMATION HELPERS
-- stopCharacterAnimations fades out all playing tracks immediately so the
-- character visually comes to a full stop before the server hard-anchors the
-- HRP (~0.3s later). The Animate LocalScript resumes on its own once the
-- server restores WalkSpeed/JumpPower on exit — no manual restart needed.
-- ============================================================================
local ANIM_STOP_FADE = 0.2

local function stopCharacterAnimations(character)
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then return end

	for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
		track:Stop(ANIM_STOP_FADE)
	end
end

-- ============================================================================
-- 🎥 AFK MODE LOGIC
-- ============================================================================

local function enterAFKMode(plotName)
	if inAFKMode then return end
	inAFKMode = true

	-- Save camera type unconditionally BEFORE any conditional blocks so
	-- exitAFKMode always restores the correct mode regardless of what follows.
	originalCameraType = camera.CameraType

	-- Stop all animations immediately. The server fires this event first and
	-- only anchors the HRP after a short delay (~0.3s), so by the time the
	-- freeze happens the character is already visually stopped — no jarring snap.
	stopCharacterAnimations(player.Character)

	-- Find Camera Part
	local plotCamFolder = cameraFolder and cameraFolder:FindFirstChild(plotName)
	local camPart = plotCamFolder and plotCamFolder:FindFirstChild("CameraAimPart")

	if camPart then
		camera.CameraType = Enum.CameraType.Scriptable
		local tweenInfo = TweenInfo.new(1.5, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut)
		TweenService:Create(camera, tweenInfo, { CFrame = camPart.CFrame }):Play()
	else
		warn("⚠️ AFKStandController: No CameraAimPart found for plot '" .. tostring(plotName) .. "'. Camera will not move.")
	end

	toggleOtherGuis(true)

	if generatingFrame then
		generatingFrame.Visible = true
	end
end

local function exitAFKMode()
	if not inAFKMode then return end
	inAFKMode = false

	if generatingFrame then
		generatingFrame.Visible = false
	end

	camera.CameraType = originalCameraType
	if player.Character then
		local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end

	toggleOtherGuis(false)

	-- Notify server. Server will unanchor, teleport, and restore WalkSpeed +
	-- JumpPower. Restoring WalkSpeed > 0 is what signals the Animate LocalScript
	-- to resume running/idle animations — no manual animation restart needed here.
	if AFKEvent then
		AFKEvent:FireServer("Exit")
	end
end

-- ============================================================================
-- 💀 DEATH / RESPAWN HANDLER
-- Placed after all helpers. Does NOT fire "Exit" to the server — the server's
-- own CharacterAdded watcher clears state on death, avoiding a race condition.
-- ============================================================================
player.CharacterAdded:Connect(function(character)
	if not inAFKMode then return end
	inAFKMode = false

	if generatingFrame then
		generatingFrame.Visible = false
	end

	local humanoid = character:WaitForChild("Humanoid", 5)
	camera.CameraType = originalCameraType
	if humanoid then
		camera.CameraSubject = humanoid
	end

	toggleOtherGuis(false)
end)

-- ============================================================================
-- 🔗 CONNECTIONS
-- ============================================================================
if exitButton then
	setupHoverScale(exitButton)

	exitButton.Activated:Connect(function()
		if not inAFKMode then return end
		local UIAudioConfig = require(game:GetService("ReplicatedStorage"):WaitForChild("UIAudioConfig"))
		UIAudioConfig.PlayClick()
		exitAFKMode()
	end)
end

if AFKEvent then
	AFKEvent.OnClientEvent:Connect(function(action, plotName)
		if action == "Enter" and plotName then
			enterAFKMode(plotName)
		end
	end)
end
