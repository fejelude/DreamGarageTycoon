-- 📡 REMOTE EVENT SETUP (Communication to Client)
-- ============================================================================
local PadUnlockEvent = ReplicatedStorage:FindFirstChild("PadUnlockEvent")
if not PadUnlockEvent or not PadUnlockEvent:IsA("RemoteEvent") then error("[PadProgressionHandler] Missing ReplicatedStorage > PadUnlockEvent", 0) end

-- ============================================================================
-- 🔊 SOUND CONFIGURATION & 🛡️ DEBOUNCE STATE
-- ============================================================================
local PURCHASE_SOUND_ID = "rbxassetid://14810387808" 
local PURCHASE_VOLUME = 0.5
local ERROR_SOUND_ID = "rbxassetid://4612375233" 

-- 🛡️ Track active transactions/cooldowns per player
local playerPurchaseDebounce = {}

-- Clean up memory when a player leaves
Players.PlayerRemoving:Connect(function(player)
	playerPurchaseDebounce[player.UserId] = nil
end)

print("🟢 PadProgressionHandler: Loaded & Ready")

-- ============================================================================
-- 1. VISUAL HANDLER
-- ============================================================================
local function toggleVisual(obj, isVisible, canTouch)
	local transparency = isVisible and 0 or 1
	local collide = isVisible 

	local function applyToPart(part)
		if part:IsA("BasePart") then
			part.Transparency = transparency
			part.CanCollide = collide
			part.CanTouch = canTouch
			part.CanQuery = canTouch
			part.Anchored = true 
		elseif part:IsA("BillboardGui") or part:IsA("SurfaceGui") then
			part.Enabled = isVisible
		end
	end

	applyToPart(obj)

	for _, child in pairs(obj:GetDescendants()) do 
		applyToPart(child) 
	end
end

local function getLevelModel(plot, levelName)
	local canonicalName = levelName == "Level1" and "NormalLevel1"
		or (levelName == "Level2" and "NormalLevel2" or levelName)
	local model = plot:FindFirstChild(canonicalName)
	if model then return model end

	local dedicatedFolder = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")
	if dedicatedFolder then
		local plotStorage = dedicatedFolder:FindFirstChild(plot.Name)
		if plotStorage then
			return plotStorage:FindFirstChild(canonicalName)
		end
	end
	return nil
end

local function setLevelVisibility(plot, level1Model, level2Model, baseLevel)
	local storageFolder = ReplicatedStorage:FindFirstChild("TycoonLevelStorage")
	if not storageFolder then
		storageFolder = Instance.new("Folder")
		storageFolder.Name = "TycoonLevelStorage"
		storageFolder.Parent = ReplicatedStorage
	end

	local plotStorage = storageFolder:FindFirstChild(plot.Name)
	if not plotStorage then
		plotStorage = Instance.new("Folder")
		plotStorage.Name = plot.Name
		plotStorage.Parent = storageFolder
	end

	local activeModel = baseLevel == 1 and level1Model or level2Model
	local inactiveModel = baseLevel == 1 and level2Model or level1Model
	if not activeModel or not inactiveModel or activeModel.Parent == plot then return end

	-- Pads are siblings of their level model. Detach the incoming folder briefly so
	-- both containers can exchange their identically named Pads children safely.
	local activePads = activeModel.Parent:FindFirstChild("Pads")
	local inactivePads = inactiveModel.Parent:FindFirstChild("Pads")
	if not activePads or not inactivePads then return end

	activePads.Parent = nil
	inactivePads.Parent = plotStorage
	activePads.Parent = plot
	inactiveModel.Parent = plotStorage
	activeModel.Parent = plot
end

local function updatePadVisuals(plot, unlockedLevel, baseLevel)
	unlockedLevel = tonumber(unlockedLevel) or 1
	baseLevel = tonumber(baseLevel) or 1

	local level1Model = getLevelModel(plot, "Level1")
	local level2Model = getLevelModel(plot, "Level2")

	setLevelVisibility(plot, level1Model, level2Model, baseLevel)

	for i = 1, 22 do
		local padName = "Pad" .. i

		-- Gather all copies of this pad (the Level 1 pads are direct children of the tycoon).
		local padModels = {}
		local level1Pads = level1Model and level1Model.Parent:FindFirstChild("Pads")
		if level1Pads and level1Pads:FindFirstChild(padName) then
			table.insert(padModels, level1Pads:FindFirstChild(padName))
		end
		local level2Pads = level2Model and level2Model.Parent:FindFirstChild("Pads")
		if level2Pads and level2Pads:FindFirstChild(padName) then
			table.insert(padModels, level2Pads:FindFirstChild(padName))
		end

		for _, padModel in ipairs(padModels) do
			local geometry = padModel:FindFirstChild("Geometry")
			local buyButton = padModel:FindFirstChild("BuyButton")

			local canBeUnlocked = true
			if i > 14 and baseLevel < 2 then
				canBeUnlocked = false
			end

			if i <= unlockedLevel and canBeUnlocked then
				-- STATE: OWNED
				if geometry then toggleVisual(geometry, true, true) end
				if buyButton then toggleVisual(buyButton, false, false) end
			elseif i == unlockedLevel + 1 and canBeUnlocked then
				-- STATE: NEXT TO BUY
				if geometry then toggleVisual(geometry, false, false) end
				if buyButton then toggleVisual(buyButton, true, true) end
			else
				-- STATE: LOCKED
				if geometry then toggleVisual(geometry, false, false) end
				if buyButton then toggleVisual(buyButton, false, false) end
			end
		end
	end
end

-- ============================================================================
-- 2. BUY FUNCTION
-- ============================================================================
local function setupBuyButton(plot, padModel, padNumber)
	local buyButton = padModel:FindFirstChild("BuyButton")
	if not buyButton then return end 

	if buyButton:GetAttribute("Connected") then return end
	buyButton:SetAttribute("Connected", true)

	local function attemptBuy(player)
		-- 🛡️ Anti-Spam Check: Abort if player is on cooldown
		if playerPurchaseDebounce[player.UserId] then return end

		if plot.Owner.Value ~= player.Name then return end

		local currentLevel = tonumber(player:GetAttribute("HighestUnlockedPad")) or 1
		if padNumber ~= (currentLevel + 1) then return end

		-- Fix 2: PadProgressionHandler Pads 15-22 lack BaseLevel server check
		local baseLevel = tonumber(player:GetAttribute("BaseLevel")) or 1
		if padNumber > 14 and baseLevel < 2 then return end

		local cost = tonumber(padModel:GetAttribute("Cost"))
		if not cost or cost <= 0 then
			warn("[PadProgressionHandler] Missing/invalid Cost on " .. padModel:GetFullName())
			return
		end
		local leaderstats = player:FindFirstChild("leaderstats")
		local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")

		if wallet then
			-- 🔒 Lock the transaction state
			playerPurchaseDebounce[player.UserId] = true
			task.delay(0.5, function()
				if playerPurchaseDebounce[player.UserId] then
					playerPurchaseDebounce[player.UserId] = nil
				end
			end)

			if wallet.Value >= cost then
				-- ✅ SUCCESS: Rich enough!
				local originalWallet = wallet.Value
				local originalLevel = currentLevel
				wallet.Value -= cost
				player:SetAttribute("HighestUnlockedPad", padNumber)
				if not forceSave(player) then
					wallet.Value = originalWallet
					player:SetAttribute("HighestUnlockedPad", originalLevel)
					PadUnlockEvent:FireClient(player, false, "Purchase could not be saved. Please try again.")
					return
				end
				updatePadVisuals(plot, padNumber, tonumber(player:GetAttribute("BaseLevel")) or 1)
				print("✅ " .. player.Name .. " Purchased Pad " .. padNumber)

				-- 🔊 Play Ca-ching!
				local s = Instance.new("Sound")
				s.SoundId = PURCHASE_SOUND_ID 
				s.Volume = PURCHASE_VOLUME
				s.Parent = buyButton:IsA("BasePart") and buyButton or buyButton.PrimaryPart
				s:Play()
				Debris:AddItem(s, 2)

				-- ✨ TRIGGER CLIENT: SUCCESS (Green Text + FX)
				PadUnlockEvent:FireClient(player, true, padNumber)
			else
				-- ❌ FAIL: Broke!
				local missing = cost - wallet.Value

				-- 🔊 Play Error Noise (Optional)
				local s = Instance.new("Sound")
				s.SoundId = ERROR_SOUND_ID 
				s.Volume = 0.5
				s.Parent = buyButton:IsA("BasePart") and buyButton or buyButton.PrimaryPart
				s:Play()
				Debris:AddItem(s, 1)

				-- ✨ TRIGGER CLIENT: FAIL (Red Text + Missing Amount)
				PadUnlockEvent:FireClient(player, false, missing)
			end

		end
	end

	local function onTouch(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player then
			PlayerTransactionCoordinator.Run(player, "PadUnlockPurchase", function()
				attemptBuy(player)
				return true
			end)
		end
	end

	-- Fix 8: PadProgressionHandler Redundant Touched connections
	-- We only need to connect ONE primary part to prevent lag/spam.
	if buyButton:IsA("BasePart") then
		buyButton.Touched:Connect(onTouch)
	elseif buyButton:IsA("Model") then
		local primary = buyButton.PrimaryPart or buyButton:FindFirstChildWhichIsA("BasePart")
		if primary then
			primary.Touched:Connect(onTouch)
		end
	end
end

local function rollbackLevelMigration(journal)
	for index = #(journal or {}), 1, -1 do
		local move = journal[index]
		if move.L2Occ and move.L2Occ.Parent then move.L2Occ.Value = move.L2WasOccupied end
		if move.L2Link and move.L2Link.Parent then move.L2Link.Value = move.L2PreviousCar end
		if move.L1Occ and move.L1Occ.Parent then move.L1Occ.Value = move.L1WasOccupied end
		if move.L1Link and move.L1Link.Parent then move.L1Link.Value = move.Car end
		if move.Car and move.Car.Parent and move.OriginalPivot then move.Car:PivotTo(move.OriginalPivot) end
	end
end

local function migrateLevelOneCarsToLevelTwo(plot)
	local level1 = getLevelModel(plot, "Level1")
	local level2 = getLevelModel(plot, "Level2")
	local l1Pads = level1 and level1.Parent:FindFirstChild("Pads")
	local l2Pads = level2 and level2.Parent:FindFirstChild("Pads")
	if not l1Pads or not l2Pads then return false, "Base pads are unavailable." end

	local journal = {}
	for _, l1PadObj in ipairs(l1Pads:GetChildren()) do
		local padNum = l1PadObj.Name:match("Pad(%d+)")
		local l1Primary = l1PadObj:IsA("Model") and (l1PadObj.PrimaryPart or l1PadObj:FindFirstChildWhichIsA("BasePart")) or l1PadObj
		local l1Occ = l1Primary and l1Primary:FindFirstChild("IsOccupied")
		local l1Link = l1Primary and l1Primary:FindFirstChild("LinkedCar")
		if l1Link and l1Link.Value then
			local l2PadObj = padNum and l2Pads:FindFirstChild("Pad" .. padNum)
			local l2Primary = l2PadObj and (l2PadObj:IsA("Model") and (l2PadObj.PrimaryPart or l2PadObj:FindFirstChildWhichIsA("BasePart")) or l2PadObj)
			local l2Occ = l2Primary and l2Primary:FindFirstChild("IsOccupied")
			local l2Link = l2Primary and l2Primary:FindFirstChild("LinkedCar")
			if not l1Occ or not l2Primary or not l2Occ or not l2Link then
				return false, "A destination pad is missing required state."
			end
			if l2Occ.Value or l2Link.Value then return false, "A Level 2 destination pad is occupied." end
			table.insert(journal, {
				L1Occ = l1Occ, L1Link = l1Link, L2Occ = l2Occ, L2Link = l2Link,
				L1WasOccupied = l1Occ.Value, L2WasOccupied = l2Occ.Value,
				L2PreviousCar = l2Link.Value, Car = l1Link.Value,
				OriginalPivot = l1Link.Value:GetPivot(), L2Primary = l2Primary,
			})
		end
	end

	local ok, err = xpcall(function()
		for _, move in ipairs(journal) do
			move.L2Occ.Value = true
			move.L2Link.Value = move.Car
			move.Car:PivotTo(move.L2Primary.CFrame * CFrame.new(0, (move.L2Primary.Size.Y / 2) + 5, 0))
			move.L1Occ.Value = false
			move.L1Link.Value = nil
		end
	end, debug.traceback)
	if not ok then
		rollbackLevelMigration(journal)
		return false, tostring(err)
	end
	return true, nil, journal
end

local function setupLevel2BuyButton(plot, buyButtonModel)
	if not buyButtonModel then return end

	local buyButton = buyButtonModel:FindFirstChild("BuyButton") or buyButtonModel
	if not buyButton then return end

	if buyButton:GetAttribute("Connected") then return end
	buyButton:SetAttribute("Connected", true)

	local function attemptBuy(player)
		if playerPurchaseDebounce[player.UserId] then return end
		if plot.Owner.Value ~= player.Name then return end

		local currentLevel = tonumber(player:GetAttribute("HighestUnlockedPad")) or 1
		local baseLevel = tonumber(player:GetAttribute("BaseLevel")) or 1

		if baseLevel >= 2 then return end

		playerPurchaseDebounce[player.UserId] = true
		-- Schedule cleanup immediately so every validation/save/rollback return
		-- path releases the touch debounce.
		task.delay(1, function()
			if playerPurchaseDebounce[player.UserId] then
				playerPurchaseDebounce[player.UserId] = nil
			end
		end)

		if currentLevel < 14 then
			local s = Instance.new("Sound")
			s.SoundId = ERROR_SOUND_ID
			s.Volume = 0.5
			s.Parent = buyButton:IsA("BasePart") and buyButton or buyButton.PrimaryPart
			s:Play()
			Debris:AddItem(s, 2)
			PadUnlockEvent:FireClient(player, false, "Unlock all pads first to upgrade your base!")

			return
		end

		local cost = tonumber(buyButtonModel:GetAttribute("Cost"))
		if not cost or cost <= 0 then
			warn("[PadProgressionHandler] Missing/invalid Cost on " .. buyButtonModel:GetFullName())
			playerPurchaseDebounce[player.UserId] = nil
			return
		end
		local leaderstats = player:FindFirstChild("leaderstats")
		local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")

		if wallet then
			if wallet.Value >= cost then
				local originalWallet = wallet.Value
				wallet.Value -= cost

				local migrated, migrateMessage, migrationJournal = migrateLevelOneCarsToLevelTwo(plot)
				if not migrated then
					wallet.Value = originalWallet
					warn("[PadProgressionHandler] Base migration rejected: " .. tostring(migrateMessage))
					return
				end

				local originalOwnedBaseLevel = tonumber(player:GetAttribute("OwnedBaseLevel")) or baseLevel or 1
				local originalBaseLevel = tonumber(player:GetAttribute("BaseLevel")) or baseLevel or 1
				player:SetAttribute("OwnedBaseLevel", math.max(2, originalOwnedBaseLevel))
				player:SetAttribute("BaseLevel", 2)
				local saveOk = forceSave(player)
				if not saveOk then
					wallet.Value = originalWallet
					rollbackLevelMigration(migrationJournal)
					player:SetAttribute("OwnedBaseLevel", originalOwnedBaseLevel)
					player:SetAttribute("BaseLevel", originalBaseLevel)
					forceSave(player)
					warn("⚠️ [PadProgressionHandler] Level 2 base purchase save failed for " .. player.Name .. "; restored previous base attributes.")
					return
				end
				updatePadVisuals(plot, currentLevel, 2)

				if buyButtonModel then
					toggleVisual(buyButtonModel, false, false)
				end

				print("✅ " .. player.Name .. " Purchased Level 2 Base")

				local s = Instance.new("Sound")
				s.SoundId = PURCHASE_SOUND_ID
				s.Volume = PURCHASE_VOLUME
				s.Parent = buyButton:IsA("BasePart") and buyButton or buyButton.PrimaryPart
				s:Play()
				Debris:AddItem(s, 2)

				PadUnlockEvent:FireClient(player, true, "Level 2")
			else
				local s = Instance.new("Sound")
				s.SoundId = ERROR_SOUND_ID
				s.Volume = 0.5
				s.Parent = buyButton:IsA("BasePart") and buyButton or buyButton.PrimaryPart
				s:Play()
				Debris:AddItem(s, 2)

				PadUnlockEvent:FireClient(player, false, "Not enough money to upgrade your base!")
			end

		else
			playerPurchaseDebounce[player.UserId] = nil
		end
	end

	local function onTouch(otherPart)
		local character = otherPart.Parent
		local player = Players:GetPlayerFromCharacter(character)
		if player then
			PlayerTransactionCoordinator.Run(player, "BaseLevelPurchase", function()
				attemptBuy(player)
				return true
			end)
		end
	end

	-- Fix 8: PadProgressionHandler Redundant Touched connections
	-- We only need to connect ONE primary part to prevent lag/spam.
	if buyButton:IsA("BasePart") then
		buyButton.Touched:Connect(onTouch)
	elseif buyButton:IsA("Model") then
		local primary = buyButton.PrimaryPart or buyButton:FindFirstChildWhichIsA("BasePart")
		if primary then
			primary.Touched:Connect(onTouch)
		end
	end
end

-- ============================================================================
-- 3. PLOT SETUP
-- ============================================================================
local function setupPlot(plot)
	task.spawn(function()
		local ownerVal = plot:WaitForChild("Owner", 10)
		if not ownerVal then return end

		local currentConnection = nil

		local function onOwnerChange(newOwner)
			if currentConnection then
				for _, conn in ipairs(currentConnection) do conn:Disconnect() end
				currentConnection = nil
			end

			if newOwner == "" then 
				updatePadVisuals(plot, 1, 1)

				local level2BuyButton = plot:FindFirstChild("Level2BuyButton") or plot:FindFirstChild("Level 2 Buy Button")
				if level2BuyButton then
					toggleVisual(level2BuyButton, false, false)
				end
			else
				local player = Players:FindFirstChild(newOwner)
				local retries = 0
				while not player and retries < 20 do
					if ownerVal.Value ~= newOwner then return end
					task.wait(0.25)
					player = Players:FindFirstChild(newOwner)
					retries += 1
				end

				if ownerVal.Value ~= newOwner then return end

				if player then
					local savedLevel = tonumber(player:GetAttribute("HighestUnlockedPad")) or 1
					local savedBaseLevel = tonumber(player:GetAttribute("BaseLevel")) or 1
					local savedOwnedBaseLevel = tonumber(player:GetAttribute("OwnedBaseLevel")) or savedBaseLevel
					updatePadVisuals(plot, savedLevel, savedBaseLevel)

					local level2BuyButton = plot:FindFirstChild("Level2BuyButton") or plot:FindFirstChild("Level 2 Buy Button")
					if level2BuyButton then
						toggleVisual(level2BuyButton, savedOwnedBaseLevel < 2, savedOwnedBaseLevel < 2)
					end

					currentConnection = {
						player:GetAttributeChangedSignal("HighestUnlockedPad"):Connect(function()
							local newLevel = tonumber(player:GetAttribute("HighestUnlockedPad")) or 1
							local currentBase = tonumber(player:GetAttribute("BaseLevel")) or 1
							updatePadVisuals(plot, newLevel, currentBase)
						end),
						player:GetAttributeChangedSignal("BaseLevel"):Connect(function()
							local currentLevel = tonumber(player:GetAttribute("HighestUnlockedPad")) or 1
							local newBase = tonumber(player:GetAttribute("BaseLevel")) or 1
							local ownedBase = tonumber(player:GetAttribute("OwnedBaseLevel")) or newBase
							updatePadVisuals(plot, currentLevel, newBase)
							if level2BuyButton then
								toggleVisual(level2BuyButton, ownedBase < 2, ownedBase < 2)
							end
						end),
						player:GetAttributeChangedSignal("OwnedBaseLevel"):Connect(function()
							local ownedBase = tonumber(player:GetAttribute("OwnedBaseLevel")) or tonumber(player:GetAttribute("BaseLevel")) or 1
							if level2BuyButton then
								toggleVisual(level2BuyButton, ownedBase < 2, ownedBase < 2)
							end
						end)
					}
				end
			end
		end

		ownerVal.Changed:Connect(onOwnerChange)

		local function setupPadsInFolder(folder)
			if not folder then return end
			local pads = folder:WaitForChild("Pads", 10)
			if pads then
				for i = 2, 22 do
					local p = pads:FindFirstChild("Pad"..i)
					if p then setupBuyButton(plot, p, i) end
				end
			end
		end

		local level1 = getLevelModel(plot, "Level1")
		local level1Pads = level1 and level1.Parent:WaitForChild("Pads", 10)
		if level1Pads then
			for i = 2, 22 do
				local pad = level1Pads:FindFirstChild("Pad" .. i)
				if pad then setupBuyButton(plot, pad, i) end
			end
		end

		local level2 = getLevelModel(plot, "Level2")
		setupPadsInFolder(level2 and level2.Parent)

		local level2BuyButton = plot:WaitForChild("Level2BuyButton", 5)
		if not level2BuyButton then
			level2BuyButton = plot:FindFirstChild("Level 2 Buy Button")
		end
		
		-- FIX: If the button is inside NormalLevel1 (map builder error), find it
		if not level2BuyButton then
			local l1 = getLevelModel(plot, "Level1")
			if l1 then
				level2BuyButton = l1:FindFirstChild("Level2BuyButton") or l1:FindFirstChild("Level 2 Buy Button")
			end
		end
		if level2BuyButton then
			if ownerVal.Value == "" then
				toggleVisual(level2BuyButton, false, false)
			else
				local player = Players:FindFirstChild(ownerVal.Value)
				local baseLvl = player and (tonumber(player:GetAttribute("OwnedBaseLevel")) or tonumber(player:GetAttribute("BaseLevel"))) or 1
				toggleVisual(level2BuyButton, baseLvl < 2, baseLvl < 2)
			end
			setupLevel2BuyButton(plot, level2BuyButton)
		end

		if ownerVal.Value ~= "" then onOwnerChange(ownerVal.Value) else updatePadVisuals(plot, 1, 1) end
	end)
end

for _, p in pairs(TycoonFolder:GetChildren()) do setupPlot(p) end
TycoonFolder.ChildAdded:Connect(setupPlot)
