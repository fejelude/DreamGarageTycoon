-- Purpose: Handles Pad Unlocking, Visibility, Purchasing, and triggers Client Effects. Includes anti-spam debounce.
-- Runs on: Server
-- Location: ServerScriptService
-- Dependencies: Players, Workspace, ReplicatedStorage, Debris
-- Public API: None
-- Networking: PadUnlockEvent (Server -> Client)
-- Security: Wallet validation, strict sequential progression check, and per-player transaction locks.
-- Performance: Lightweight O(1) table lookup for debounces; cleans up memory on player leave.
-- Notes: Fixes the Touched chain-reaction bug that allowed purchasing multiple pads in a single frame.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local PlayerTransactionCoordinator = require(ServerScriptService:WaitForChild("PlayerTransactionCoordinator"))

local TycoonFolder = Workspace:WaitForChild("Tycoons")

local function forceSave(player)
	local api = ServerStorage:FindFirstChild("TycoonAdminAPI")
	if not api or not api:IsA("BindableFunction") then
		return false
	end

	local ok, result = pcall(function()
		return api:Invoke("SaveNow", player)
	end)

	if ok and result == true then
		return true
	end

	pcall(function() api:Invoke("QueueSaveSoon", player, 3) end)
	return false
end
