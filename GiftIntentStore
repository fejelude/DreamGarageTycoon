-- Purpose: Durable, versioned routing for Robux gifts. A receipt is bound to
-- the exact recipient selected before the purchase prompt; temporary DataStore
-- failures are reported explicitly and never interpreted as "buy for self".
-- Runs on: Server (ModuleScript)
-- Location: ServerScriptService > GiftIntentStore

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

local STORE = DataStoreService:GetDataStore("RobuxGiftIntents_V2")
local Store = {}

local PENDING_TTL_SECONDS = 2 * 60 * 60
local PURCHASED_TTL_SECONDS = 45 * 24 * 60 * 60
local ARCHIVE_TTL_SECONDS = 30 * 24 * 60 * 60

local function keyFor(buyerUserId, productId)
	return string.format("%d:%d", buyerUserId, productId)
end

local function normalizeIds(buyerUserId, productId)
	buyerUserId = math.floor(tonumber(buyerUserId) or 0)
	productId = math.floor(tonumber(productId) or 0)
	if buyerUserId <= 0 or productId <= 0 then
		return nil, nil
	end
	return buyerUserId, productId
end

local function isUnresolved(intent)
	return type(intent) == "table"
		and (intent.Status == "PendingPrompt"
			or intent.Status == "AwaitingReceipt"
			or intent.Status == "Bound")
end

function Store.Create(buyer, productId, receiver, productInfo)
	if not buyer or not receiver or not buyer.Parent or not receiver.Parent then
		return false, "Buyer or receiver is unavailable"
	end
	productId = math.floor(tonumber(productId) or 0)
	if productId <= 0 or type(productInfo) ~= "table" or productInfo.Giftable ~= true then
		return false, "This product cannot be gifted"
	end
	if buyer.UserId == receiver.UserId then
		return false, "You cannot gift yourself"
	end

	local now = os.time()
	local intent = {
		IntentId = HttpService:GenerateGUID(false),
		Version = HttpService:GenerateGUID(false),
		BuyerUserId = buyer.UserId,
		BuyerName = buyer.Name,
		ReceiverUserId = receiver.UserId,
		ReceiverName = receiver.Name,
		ProductId = productId,
		ProductKind = tostring(productInfo.Kind or "DeveloperProduct"),
		DisplayName = tostring(productInfo.DisplayName or "Gift"),
		ReceiveGiftsSnapshot = receiver:GetAttribute("Setting_ReceiveGiftsEnabled") ~= false,
		CreatedAt = now,
		UpdatedAt = now,
		ExpiresAt = now + PENDING_TTL_SECONDS,
		Status = "PendingPrompt",
	}

	local success, result = pcall(function()
		return STORE:UpdateAsync(keyFor(buyer.UserId, productId), function(current)
			-- A missing prompt-finished callback cannot prove that payment did not
			-- occur. Never replace an unresolved route by age; only exact-version
			-- cancellation or receipt completion may make this key reusable.
			if isUnresolved(current) then
				return nil
			end
			return intent
		end)
	end)

	if not success then
		return false, "Unable to securely save the gift intent"
	end
	if type(result) ~= "table" or result.IntentId ~= intent.IntentId then
		return false, "Another purchase for this gift is already unresolved"
	end
	return true, "Gift ready", intent.IntentId
end

function Store.Get(buyerUserId, productId)
	buyerUserId, productId = normalizeIds(buyerUserId, productId)
	if not buyerUserId then return "Invalid", nil end

	local success, intent = pcall(function()
		return STORE:GetAsync(keyFor(buyerUserId, productId))
	end)
	if not success then return "TemporarilyUnavailable", nil end
	if type(intent) ~= "table" then return "ConfirmedNoIntent", nil end
	if intent.BuyerUserId ~= buyerUserId or intent.ProductId ~= productId then
		return "Invalid", intent
	end
	if isUnresolved(intent) then return "Found", intent end
	return "ConfirmedNoIntent", intent
end

function Store.MarkPromptFinished(buyerUserId, productId, intentId, wasPurchased)
	buyerUserId, productId = normalizeIds(buyerUserId, productId)
	intentId = tostring(intentId or "")
	if not buyerUserId or intentId == "" then return false, "Invalid intent" end

	local changed = false
	local success = pcall(function()
		STORE:UpdateAsync(keyFor(buyerUserId, productId), function(current)
			changed = false
			if type(current) ~= "table" or current.IntentId ~= intentId or current.Status ~= "PendingPrompt" then
				return current
			end
			changed = true
			if wasPurchased == true then
				current.Status = "AwaitingReceipt"
				current.PromptPurchasedAt = os.time()
				current.ExpiresAt = os.time() + PURCHASED_TTL_SECONDS
				current.UpdatedAt = os.time()
				return current
			end
			return nil
		end)
	end)
	return success and changed, success and nil or "Gift intent store unavailable"
end

function Store.Cancel(buyerUserId, productId, intentId)
	return Store.MarkPromptFinished(buyerUserId, productId, intentId, false)
end

function Store.BindReceipt(buyerUserId, productId, purchaseId)
	buyerUserId, productId = normalizeIds(buyerUserId, productId)
	purchaseId = tostring(purchaseId or "")
	if not buyerUserId or purchaseId == "" then return nil, "Invalid receipt intent" end

	local bound
	local success, result = pcall(function()
		return STORE:UpdateAsync(keyFor(buyerUserId, productId), function(current)
			bound = nil
			if type(current) ~= "table" or current.BuyerUserId ~= buyerUserId or current.ProductId ~= productId then
				return nil
			end
			if current.Status == "Bound" then
				if current.PurchaseId == purchaseId then bound = current end
				return current
			end
			if current.Status ~= "AwaitingReceipt" and current.Status ~= "PendingPrompt" then
				return current
			end
			current.Status = "Bound"
			current.PurchaseId = purchaseId
			current.BoundAt = os.time()
			current.UpdatedAt = os.time()
			current.ExpiresAt = os.time() + PURCHASED_TTL_SECONDS
			bound = current
			return current
		end)
	end)
	if not success then return nil, "Gift intent store unavailable" end
	if type(result) ~= "table" or result.PurchaseId ~= purchaseId then
		return nil, "No compatible unresolved gift intent"
	end
	return bound or result
end

function Store.Complete(buyerUserId, productId, purchaseId, deliveryStatus)
	buyerUserId, productId = normalizeIds(buyerUserId, productId)
	purchaseId = tostring(purchaseId or "")
	if not buyerUserId or purchaseId == "" then return false end

	local completed = false
	local success, result = pcall(function()
		return STORE:UpdateAsync(keyFor(buyerUserId, productId), function(current)
			completed = false
			if type(current) ~= "table" or current.PurchaseId ~= purchaseId then
				return current
			end
			current.Status = "Fulfilled"
			current.DeliveryStatus = tostring(deliveryStatus or "Queued")
			current.CompletedAt = os.time()
			current.UpdatedAt = os.time()
			current.ExpiresAt = os.time() + ARCHIVE_TTL_SECONDS
			completed = true
			return current
		end)
	end)
	-- A missing/non-matching record means there is no gift metadata to clean up
	-- (for example, a normal self-purchase of a dual-use product). Only an
	-- actual DataStore failure should hold an already-durable receipt pending.
	return success, completed, result
end

return Store
