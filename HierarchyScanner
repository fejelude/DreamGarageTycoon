local function resolve(root, parts)
	local current = root
	for index, partName in ipairs(parts) do
		if not current then return nil, index, partName end
		local child = current:FindFirstChild(partName)
		if not child then
			return nil, index, partName
		end
		current = child
	end
	return current, nil, nil
end

local function classMatches(instance, expectedClassName)
	if not expectedClassName or expectedClassName == "" then return true end
	if expectedClassName == "GuiObject" then return instance:IsA("GuiObject") end
	return instance:IsA(expectedClassName)
end

local function scanRequired()
	local missing = {}
	local wrongClass = {}
	local okCount = 0

	print(PREFIX .. " Starting required hierarchy scan...")

	for _, spec in ipairs(REQUIRED) do
		local found, missingIndex, missingName = resolve(spec.Root, spec.Parts)
		if not found then
			table.insert(missing, string.format("MISSING: %s | missing child '%s' at depth %d | Purpose: %s", spec.Path, tostring(missingName), tonumber(missingIndex) or -1, spec.Purpose or ""))
		elseif not classMatches(found, spec.ClassName) then
			table.insert(wrongClass, string.format("WRONG TYPE: %s | expected %s, got %s | Purpose: %s", spec.Path, spec.ClassName, found.ClassName, spec.Purpose or ""))
		else
			okCount += 1
		end
	end

	print(string.format("%s Scan complete. OK=%d Missing=%d WrongType=%d", PREFIX, okCount, #missing, #wrongClass))

	if #missing > 0 then
		warn(PREFIX .. " Missing required instances:")
		for _, message in ipairs(missing) do warn(PREFIX .. " " .. message) end
	end

	if #wrongClass > 0 then
		warn(PREFIX .. " Instances with wrong class/type:")
		for _, message in ipairs(wrongClass) do warn(PREFIX .. " " .. message) end
	end

	if #missing == 0 and #wrongClass == 0 then
		print(PREFIX .. " ✅ All configured required instances were found with the expected classes.")
	else
		warn(PREFIX .. " ❌ Hierarchy issues found. Fix the missing/wrong instances above before testing Global Luck purchases/restocks.")
	end
end

local function summarizeGuiTree()
	local guiCount = 0
	local scriptCount = 0
	for _, descendant in ipairs(StarterGui:GetDescendants()) do
		if descendant:IsA("GuiObject") or descendant:IsA("ScreenGui") then
			guiCount += 1
		elseif descendant:IsA("LocalScript") or descendant:IsA("ModuleScript") then
			scriptCount += 1
		end
	end
	print(string.format("%s StarterGui summary: %d Gui/ScreenGui descendants, %d LocalScript/ModuleScript descendants.", PREFIX, guiCount, scriptCount))
end

scanRequired()
summarizeGuiTree()
