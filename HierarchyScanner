local function checkTycoonPlot(plot)
	local plotPath = fullName(plot)
	local plotReqs = {
		{ name = "Owner", className = "StringValue", requiredBy = "TycoonHandler, TycoonDataHandler, PlotHandler, TeleportFunctionService", notes = "Tracks plot ownership." },
		{ name = "OwnerId", className = {"IntValue", "NumberValue"}, requiredBy = "GlobalLeaderboardService", notes = "Preferred owner user id value; OwnerUserId alternative is accepted below." },
		{ name = "PendingEarnings", className = {"NumberValue", "IntValue"}, requiredBy = "TabletServerHandler, TycoonDataHandler", notes = "Unclaimed offline/tablet earnings." },
		{ name = "PlacedCars", className = "Folder", requiredBy = "TycoonDataHandler, PlacedCarAnimator, OfflineEarningsService", notes = "Saved/restored vehicle placement container." },
		{ name = "SpawnPoint", className = "BasePart", requiredBy = "TycoonHandler, TeleportFunctionService", notes = "Player spawn/garage teleport destination." },
		{ name = "ClaimEarnings", className = {"Model", "Folder"}, requiredBy = "TabletServerHandler", notes = "Tablet claim model." },
		{ name = "Level1", className = {"Model", "Folder"}, requiredBy = "PadProgressionHandler, TycoonDataHandler", notes = "Level 1 tycoon geometry and pads. 'Level 1' alternative is also checked." },
		{ name = "Level2BuyButton", className = {"Model", "BasePart", "Folder"}, requiredBy = "PadProgressionHandler", notes = "Unlock control. 'Level 2 Buy Button' alternative is also checked." },
	}

	for _, childReq in ipairs(plotReqs) do
		local child = plot:FindFirstChild(childReq.name)
		if not child and childReq.name == "OwnerId" then child = plot:FindFirstChild("OwnerUserId") end
		if not child and childReq.name == "Level1" then child = plot:FindFirstChild("Level 1") end
		if not child and childReq.name == "Level2BuyButton" then child = plot:FindFirstChild("Level 2 Buy Button") end
		local scanReq = {
			name = childReq.name,
			label = plotPath .. "." .. childReq.name,
			className = childReq.className,
			requiredBy = childReq.requiredBy,
			notes = childReq.notes,
		}
		if not child then
			logMissing(scanReq, plotPath .. "." .. childReq.name)
		elseif not classMatches(child, childReq.className) then
			logWrongClass(scanReq, child, fullName(child))
		else
			logValid(scanReq, child)
		end
	end

	local claim = plot:FindFirstChild("ClaimEarnings")
	if claim then
		for _, claimReq in ipairs({
			{ "Earnings", "BasePart", "TabletServerHandler" },
			{ "ClaimPart", "BasePart", "TabletServerHandler" },
			{ "TotalEarningsPerSecond", "BasePart", "TabletServerHandler" },
		}) do
			local child = claim:FindFirstChild(claimReq[1])
			local scanReq = { label = fullName(claim) .. "." .. claimReq[1], className = claimReq[2], requiredBy = claimReq[3] }
			if not child then logMissing(scanReq, fullName(claim) .. "." .. claimReq[1])
			elseif not classMatches(child, claimReq[2]) then logWrongClass(scanReq, child, fullName(child))
			else logValid(scanReq, child) end
		end
	end

	local level1 = plot:FindFirstChild("Level1") or plot:FindFirstChild("Level 1")
	if level1 then
		local pads = level1:FindFirstChild("Pads")
		local scanReq = { label = fullName(level1) .. ".Pads", className = "Folder", requiredBy = "PadProgressionHandler, TycoonDataHandler", notes = "Contains Pad1..PadN placement pads." }
		if not pads then logMissing(scanReq, fullName(level1) .. ".Pads")
		elseif not classMatches(pads, "Folder") then logWrongClass(scanReq, pads, fullName(pads))
		else logValid(scanReq, pads) end
	end
end

local function checkTycoons()
	local tycoons = Services.Workspace:FindFirstChild("Tycoons")
	if not tycoons then return end
	for _, plot in ipairs(tycoons:GetChildren()) do
		if plot:IsA("Model") or plot:IsA("Folder") then
			checkTycoonPlot(plot)
		else
			logWrongClass({ label = fullName(plot), className = {"Model", "Folder"}, requiredBy = "Tycoon systems", notes = "Every child of Workspace.Tycoons should be a plot container." }, plot, fullName(plot))
		end
	end
end

local function checkCarTools()
	local carTools = Services.ServerStorage:FindFirstChild("CarTools")
	if not carTools then return end
	local expectedRarities = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Mythical" }
	for _, rarity in ipairs(expectedRarities) do
		local folder = carTools:FindFirstChild(rarity)
		local scanReq = { label = fullName(carTools) .. "." .. rarity, className = "Folder", requiredBy = "TycoonDataHandler and shop services", notes = "Vehicle tool rarity folder." }
		if not folder then
			logMissing(scanReq, fullName(carTools) .. "." .. rarity)
		elseif not folder:IsA("Folder") then
			logWrongClass(scanReq, folder, fullName(folder))
		else
			logValid(scanReq, folder)
		end
	end
end

local function printHierarchySnapshot()
	local count = 0
	print("========== [HierarchyScanner] ROOT HIERARCHY SNAPSHOT ==========")
	for serviceName, service in pairs(Services) do
		print("📁 " .. serviceName .. " (" .. service.ClassName .. ")")
		for _, child in ipairs(service:GetChildren()) do
			count += 1
			if count <= MAX_DESCENDANT_PRINT then
				print(("   └─ %s [%s]"):format(child.Name, child.ClassName))
			end
		end
	end
	if count > MAX_DESCENDANT_PRINT then
		warn("[HierarchyScanner] Snapshot truncated after " .. tostring(MAX_DESCENDANT_PRINT) .. " entries.")
	end
end

local function printSummary(startedAt)
	print("========== [HierarchyScanner] FINAL SUMMARY ==========")
	print("✅ Valid instances: " .. tostring(results.valid))
	warn("❌ Missing instances: " .. tostring(results.missing))
	warn("⚠️ Incorrect class instances: " .. tostring(results.wrongClass))
	print("🧾 Total issues: " .. tostring(results.missing + results.wrongClass))
	print(("⏱️ Scan duration: %.2fs"):format(os.clock() - startedAt))

	if #issues > 0 then
		warn("========== [HierarchyScanner] ISSUE LIST ==========")
		for index, issue in ipairs(issues) do
			warn(("%03d) %s"):format(index, issue))
		end
	else
		print("🎉 [HierarchyScanner] No missing or incorrectly configured required instances were found by this scanner.")
	end
end

local function run()
	local startedAt = os.clock()
	print("========== [HierarchyScanner] STARTING REQUIRED HIERARCHY AUDIT ==========")
	print("This scanner only reports. It will not create or repair missing instances.")
	print("Waiting " .. tostring(REQUIREMENT_WAIT_SECONDS) .. " seconds before scanning so startup-created instances can appear...")
	task.wait(REQUIREMENT_WAIT_SECONDS)
	printHierarchySnapshot()
	checkRequirements()
	checkTycoons()
	checkCarTools()
	printSummary(startedAt)
end

task.spawn(run)
