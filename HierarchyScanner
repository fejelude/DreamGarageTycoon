local function joinPath(parts)
	return table.concat(parts, ".")
end

local function fullName(instance)
	if not instance then return "<nil>" end
	local ok, name = pcall(function() return instance:GetFullName() end)
	return ok and name or instance.Name
end

local function formatExpected(expected)
	if type(expected) == "table" then
		return table.concat(expected, " or ")
	end
	return tostring(expected)
end

local function classMatches(instance, expected)
	if not expected or expected == "Instance" then return true end
	if type(expected) == "table" then
		for _, className in ipairs(expected) do
			if instance:IsA(className) then return true end
		end
		return false
	end
	return instance:IsA(expected)
end

local function logValid(req, instance)
	results.valid += 1
	if LOG_VALID_INSTANCES then
		print(("✅ [HierarchyScanner] VALID | %s | expected=%s | requiredBy=%s | path=%s"):format(
			req.label or req.name,
			formatExpected(req.className),
			req.requiredBy,
			fullName(instance)
		))
	end
end

local function logMissing(req, path)
	results.missing += 1
	local message = ("❌ MISSING | %s | expected=%s | requiredBy=%s | path=%s | notes=%s"):format(
		req.label or req.name,
		formatExpected(req.className),
		req.requiredBy,
		path,
		req.notes or ""
	)
	table.insert(issues, message)
	warn("[HierarchyScanner] " .. message)
end

local function logWrongClass(req, instance, path)
	results.wrongClass += 1
	local message = ("⚠️ WRONG CLASS | %s | expected=%s | actual=%s | requiredBy=%s | path=%s | notes=%s"):format(
		req.label or req.name,
		formatExpected(req.className),
		instance.ClassName,
		req.requiredBy,
		path,
		req.notes or ""
	)
	table.insert(issues, message)
	warn("[HierarchyScanner] " .. message)
end

local function resolvePath(pathParts)
	local rootName = pathParts[1]
	local current = Services[rootName]
	if not current then return nil, rootName end
	for index = 2, #pathParts do
		local childName = pathParts[index]
		local child = current:FindFirstChild(childName)
		if not child then
			return nil, joinPath(pathParts)
		end
		current = child
	end
	return current, joinPath(pathParts)
end

local function check(req)
	local instance, path = resolvePath(req.path)
	if not instance then
		logMissing(req, path)
		return nil
	end
	if not classMatches(instance, req.className) then
		logWrongClass(req, instance, path)
		return instance
	end
	logValid(req, instance)
	return instance
end

local function req(path, className, requiredBy, notes, label)
	return { path = path, className = className, requiredBy = requiredBy, notes = notes, label = label or table.concat(path, ".") }
end

