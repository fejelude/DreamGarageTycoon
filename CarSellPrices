-- Purpose: Defines the sell prices for all cars, used by Sofhia NPC system.
-- Runs on: Shared
-- Location: ReplicatedStorage > CarSellPrices
-- Dependencies: CarStats
-- Public API: CarSellPrices.GetDetails(carId), CarSellPrices.CleanId(carId)
-- Security: Server relies on this to calculate transaction amounts.
-- Performance: Prices are cached at load time.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))

local CarSellPrices = {}
local SELL_MULTIPLIER = 0.50 -- 50% of base price

CarSellPrices.Prices = {}

-- Initialize the sell prices based on CarStats
-- Authoritative lookups are keyed only by immutable CarId/ToolId. Display names
-- are presentation and are not unique (Ricky and Ironclad intentionally share
-- "Toyota Hilux"), so accepting them here could select a random sell price.
for carId, stats in pairs(CarStats.Cars) do
	local priceStr = tostring(stats.Price or 0):gsub(",", "")
	local priceVal = tonumber(priceStr)

	if priceVal and priceVal > 0 and stats.Name then
		local details = {
			Name = carId,
			SellPrice = math.floor(priceVal * SELL_MULTIPLIER)
		}
		CarSellPrices.Prices[carId] = details
	end
end

-- Centralized ID cleaning
function CarSellPrices.CleanId(carId)
	if type(carId) ~= "string" then return nil end
	return carId:gsub(" Item$", "")
end

-- Safely lookup car sell price and display name
function CarSellPrices.GetDetails(carId)
	local cleanId = CarSellPrices.CleanId(carId)
	if not cleanId then return nil end

	return CarSellPrices.Prices[cleanId]
end

return CarSellPrices
