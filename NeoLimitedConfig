function NeoLimitedConfig.FormatStock(remaining)
	remaining = math.max(0, math.floor(tonumber(remaining) or 0))
	if remaining <= 0 then
		return "Out Of Stock!"
	end
	return string.format("Remaining: %d/%d", remaining, NeoLimitedConfig.MaxGlobalStock)
end

