-- [[ SERVER SCRIPT: SoundCleaner V3 (Optimized) ]]
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local BAD_IDS = {
	["rbxassetid://0"] = true,        
	["http://www.roblox.com/asset/?id=0"] = true,
	["rbxassetid://188608071"] = true, 
	["rbxassetid://201887209"] = true, 
}

local BLANK_SOUND_GRACE_SECONDS = 3
local REMOVE_BLANK_ATTRIBUTE = "SoundCleanerRemoveIfBlank"

local function shouldRemove(sound)
	if BAD_IDS[sound.SoundId] or sound.SoundId == "0" then return true end
	return sound.SoundId == "" and sound:GetAttribute(REMOVE_BLANK_ATTRIBUTE) == true
end

local function checkObject(obj)
	if not obj:IsA("Sound") then return end
	if BAD_IDS[obj.SoundId] or obj.SoundId == "0" then
		obj:Destroy()
		return
	end

	-- Sounds are commonly parented before SoundId is configured. Blank sounds
	-- are removed only when explicitly marked, and only after a grace period.
	if obj.SoundId == "" and obj:GetAttribute(REMOVE_BLANK_ATTRIBUTE) == true then
		task.delay(BLANK_SOUND_GRACE_SECONDS, function()
			if obj.Parent and shouldRemove(obj) then obj:Destroy() end
		end)
	end
end

local function cleanContainer(container)
	for _, desc in pairs(container:GetDescendants()) do checkObject(desc) end
end

cleanContainer(Workspace)
cleanContainer(ServerStorage)
cleanContainer(ReplicatedStorage)
cleanContainer(SoundService)

-- Optimized Monitoring
Workspace.DescendantAdded:Connect(checkObject)
SoundService.DescendantAdded:Connect(checkObject)
ReplicatedStorage.DescendantAdded:Connect(checkObject) 

print("✨ SoundCleaner V3: Active & Optimized.")
