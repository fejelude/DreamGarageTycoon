-- Purpose: Handles secure Bank <-> ATM <-> Wallet transfers with transaction locking and transfer limits.
-- Runs on: Server
-- Location: ServerScriptService
-- Dependencies: ReplicatedStorage, Workspace, Players
-- Public API: WithdrawFunction (RemoteFunction)
-- Networking: Client invokes WithdrawFunction -> Server processes -> Returns boolean, string
-- Security: Transaction locks prevent race conditions and strict type validation.
-- Performance: Early exit checks prevent expensive Workspace lookups for malformed requests.
-- Notes: Failsafe distance check included. Requires ATM Manager NPC to be loaded.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local withdrawFunc = ReplicatedStorage:WaitForChild("WithdrawFunction")

local NPC_FOLDER_NAME = "NPCS"
local MANAGER_NAME = "AfraiC4t"
local MAX_DISTANCE = 20 -- Studs (For Physical Withdraw only)
local MAX_TRANSFER_AMOUNT_LIMIT = 100000000000000 -- 100 Trillion absolute safety cap for Bank -> ATM transfers only
local TRANSFER_RESET_SECONDS = 60 * 60

local TRANSFER_USED_ATTR = "BankTransferLimitUsed"
local TRANSFER_RESET_AT_ATTR = "BankTransferLimitResetAt"

-- 🛡️ SECURITY: Transaction Locks
local activeTransactions = {}

local function initializeTransferAttributes(player)
	if player:GetAttribute(TRANSFER_USED_ATTR) == nil then
		player:SetAttribute(TRANSFER_USED_ATTR, 0)
	end
	if player:GetAttribute(TRANSFER_RESET_AT_ATTR) == nil then
		player:SetAttribute(TRANSFER_RESET_AT_ATTR, 0)
	end
end

local function getPlayerTransferLimit(player)
	return tonumber(player:GetAttribute("MaxBankWithdrawal")) or 1000000000000
end

local function getTransferState(player)
	local now = os.time()
	local used = math.max(0, tonumber(player:GetAttribute(TRANSFER_USED_ATTR)) or 0)
	local resetAt = tonumber(player:GetAttribute(TRANSFER_RESET_AT_ATTR)) or 0

	if resetAt > 0 and now >= resetAt then
		used = 0
		resetAt = 0
		player:SetAttribute(TRANSFER_USED_ATTR, used)
		player:SetAttribute(TRANSFER_RESET_AT_ATTR, resetAt)
	end

	return used, resetAt
end

local function validateTransferLimit(player, amount)
	local limit = getPlayerTransferLimit(player)
	local used = getTransferState(player)
	local remaining = math.max(0, limit - used)

	if remaining <= 0 or amount > remaining then
		return false, "Transfer Limit Reached"
	end

	return true
end

local function recordTransferProgress(player, amount)
	local used, resetAt = getTransferState(player)
	local now = os.time()

	player:SetAttribute(TRANSFER_USED_ATTR, used + amount)
	if resetAt <= now then
		player:SetAttribute(TRANSFER_RESET_AT_ATTR, now + TRANSFER_RESET_SECONDS)
	end
end

-- [[ 1. TRANSFER: BANK -> ATM (Remote / App) ]]
local function TransferToATM(player, amount)
	local leaderstats = player:FindFirstChild("leaderstats")
	local hiddenStats = player:FindFirstChild("HiddenStats")
	if not leaderstats or not hiddenStats then return false, "Data Error" end

	local bank = hiddenStats:FindFirstChild("Cash")
	local atm = leaderstats:FindFirstChild("ATMBalance")

	if not bank or not atm then return false, "Missing Values" end

	local withinLimit, limitMessage = validateTransferLimit(player, amount)
	if not withinLimit then return false, limitMessage end

	if bank.Value >= amount then
		bank.Value -= amount
		atm.Value += amount
		recordTransferProgress(player, amount)
		print("📱 Mobile Transfer: " .. player.Name .. " moved $"..amount.." to ATM.")
		return true, "Transfer Successful! Visit ATM to collect."
	else
		return false, "Insufficient Bank Funds"
	end
end

-- [[ 2. WITHDRAW: ATM -> WALLET (Physical / NPC) ]]
local function WithdrawFromATM(player, amount)
	-- 🛑 DISTANCE CHECK (Security)
	local npcFolder = Workspace:FindFirstChild(NPC_FOLDER_NAME)
	local managerNPC = npcFolder and npcFolder:FindFirstChild(MANAGER_NAME)

	-- 🛡️ SECURITY FIX: Fail Safe Logic
	if managerNPC then
		local npcRoot = managerNPC:FindFirstChild("HumanoidRootPart") or managerNPC.PrimaryPart
		local pRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

		if npcRoot and pRoot then
			if (pRoot.Position - npcRoot.Position).Magnitude > MAX_DISTANCE then
				return false, "You are too far from the ATM!"
			end
		else
			return false, "Security Check Failed: Physics not loaded."
		end
	else
		warn("⚠️ ATM Manager NPC missing. Transaction Denied for Security.")
		return false, "ATM Unavailable: Security Verification Failed"
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	local hiddenStats = player:FindFirstChild("HiddenStats")
	local atm = leaderstats and leaderstats:FindFirstChild("ATMBalance")
	local wallet = leaderstats and leaderstats:FindFirstChild("Wallet")

	if not atm or not wallet or not hiddenStats then return false, "Data Error" end

	if atm.Value >= amount then
		atm.Value -= amount
		wallet.Value += amount
		print("🏧 Physical Withdraw: " .. player.Name .. " took $"..amount.." from ATM.")
		return true, "Cash Withdrawn to Wallet!"
	else
		return false, "Insufficient Funds in ATM. Transfer from Bank first."
	end
end

-- [[ MAIN HANDLER ]]
withdrawFunc.OnServerInvoke = function(player, amount, actionType)
	if player:GetAttribute("TycoonDataLoaded") ~= true then
		return false, "Your data is still loading. Please try again."
	end
	-- 1. Strict Type & Bound Validation
	if type(actionType) ~= "string" then return false, "Invalid Action Type" end
	if type(amount) ~= "number" or amount <= 0 or amount ~= amount or amount == math.huge then
		return false, "Invalid Amount"
	end
	amount = math.floor(amount)

	-- Keep the existing transfer cap untouched, but do not apply it to physical ATM withdrawals.
	if actionType == "Transfer" and amount > MAX_TRANSFER_AMOUNT_LIMIT then
		return false, "Invalid Amount"
	end

	-- 2. Transaction Lock (Prevents Race Conditions & Spam)
	if activeTransactions[player.UserId] then
		return false, "Transaction in progress. Please wait."
	end
	activeTransactions[player.UserId] = player

	-- 3. Route Request Safely via pcall
	local success, result, msg = pcall(function()
		if actionType == "Transfer" then
			return TransferToATM(player, amount)
		elseif actionType == "Withdraw" then
			return WithdrawFromATM(player, amount)
		else
			warn("⚠️ Unknown Transaction Type from " .. player.Name .. ": " .. tostring(actionType))
			return false, "System Error: Unknown Action"
		end
	end)

	-- 4. Release Lock reliably
	if activeTransactions[player.UserId] == player then activeTransactions[player.UserId] = nil end

	if not success then
		warn("⚠️ Transaction Error for " .. player.Name .. ": " .. tostring(result))
		return false, "System Error"
	end

	-- Only successful, server-validated monetary movement can advance tutorial objectives.
	if result == true then
		local tutorialAPI = game:GetService("ServerStorage"):FindFirstChild("TutorialProgressAPI")
		if tutorialAPI and tutorialAPI:IsA("BindableFunction") then
			-- A Banking App transfer is complete when this authoritative handler accepts
			-- and commits a positive transfer. Requiring the entire bank balance to reach
			-- zero incorrectly rejected successful transfers whenever other bank funds
			-- remained, leaving Part5 permanently locked without a runtime error.
			local objective = actionType == "Transfer" and "BankTransferred" or "ATMWithdrawn"
			task.spawn(function() tutorialAPI:Invoke("RecordObjective", player, objective) end)
		end
	end

	return result, msg
end

-- Cleanup locks if a player leaves mid-transaction
Players.PlayerAdded:Connect(initializeTransferAttributes)
for _, player in ipairs(Players:GetPlayers()) do
	initializeTransferAttributes(player)
end

Players.PlayerRemoving:Connect(function(player)
	if activeTransactions[player.UserId] == player then activeTransactions[player.UserId] = nil end
end)
