-- Purpose: Compatibility guard for the retired Bank/ATM remote.
-- Runs on: ServerScriptService
-- Keep this guard deployed until the WithdrawFunction RemoteFunction is removed
-- from ReplicatedStorage. It deliberately performs no balance mutation.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local withdrawFunction = ReplicatedStorage:FindFirstChild("WithdrawFunction")

if withdrawFunction and withdrawFunction:IsA("RemoteFunction") then
	withdrawFunction.OnServerInvoke = function()
		return false, "Banking has been retired. Earnings are paid directly to your Wallet."
	end
end
