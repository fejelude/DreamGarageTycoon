-- Purpose: Server-authoritative Index progression tracker + replication bridge for client UI.
-- Location: ServerScriptService > IndexService

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local CarStats = require(ReplicatedStorage:WaitForChild("CarStats"))

local EXPECTED_INDEX_TOTAL = 47

local remotesFolder = ReplicatedStorage:WaitForChild("IndexRemotes")
local refreshEvent = remotesFolder:WaitForChild("RefreshIndexUI")

local validCarsByKey = {}
local keyByDisplayName = {}
for key, stats in pairs(CarStats.Cars or {}) do
	if type(key) == "string" and type(stats) == "table" then
		validCarsByKey[key] = true
		if type(stats.Name) == "string" and stats.Name ~= "" then
			keyByDisplayName[stats.Name:lower()] = key
		end
	end
end

local totalCars = 0
for _ in pairs(validCarsByKey) do
	totalCars += 1
end
if totalCars ~= EXPECTED_INDEX_TOTAL then
	warn(string.format("⚠️ [INDEX] Expected %d cars but CarStats.Cars has %d entries.", EXPECTED_INDEX_TOTAL, totalCars))
end

local function normalizeToolId(toolId)
	if type(toolId) ~= "string" then return nil end
	local normalized = toolId:gsub(" Item$", "")
	if validCarsByKey[normalized] then return normalized end
	local byDisplayName = keyByDisplayName[normalized:lower()]
	if byDisplayName then return byDisplayName end
	return nil
end

local function decode(raw)
	if type(raw) ~= "string" or raw == "" then return {} end
	local ok, result = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok or type(result) ~= "table" then
		return {}
	end
	return result
end

local function encode(tbl)
	local ok, result = pcall(function() return HttpService:JSONEncode(tbl) end)
	return ok and result or "[]"
end

local function markDiscovered(player, toolId)
	if not player or not player:IsA("Player") then return false end
	local normalized = normalizeToolId(toolId)
	if not normalized then return false end

	local discovered = decode(player:GetAttribute("IndexDiscoveredJson") or "[]")
	for _, existing in ipairs(discovered) do
		if existing == normalized then
			return false
		end
	end

	table.insert(discovered, normalized)
	player:SetAttribute("IndexDiscoveredJson", encode(discovered))
	refreshEvent:FireClient(player)
	return true
end

local indexBindable = ReplicatedStorage:WaitForChild("IndexProgressionAPI")

indexBindable.OnInvoke = function(action, player, payload)
	if action == "MarkDiscovered" then
		return markDiscovered(player, payload)
	elseif action == "RefreshClient" and player then
		refreshEvent:FireClient(player)
		return true
	end
	return false
end

Players.PlayerAdded:Connect(function(player)
	if player:GetAttribute("IndexDiscoveredJson") == nil then
		player:SetAttribute("IndexDiscoveredJson", "[]")
	end
end)
