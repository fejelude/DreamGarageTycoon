-- Purpose: Handles Starter Pack UI purchase flow
-- Runs on: Client
-- Location: StarterGui > StarterPackUi > StarterPackClient
--
-- Notes:
--   - This script is UI-only.
--   - Rewards must be granted server-side through MarketplaceService.ProcessReceipt.
--   - CheckOwned should return true only after the server has saved/confirmed ownership.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local UIAudioConfig = require(ReplicatedStorage:WaitForChild("UIAudioConfig"))
local UIButtonUtils = require(ReplicatedStorage:WaitForChild("UIButtonUtils"))

local remotes = ReplicatedStorage:WaitForChild("StarterPackRemotes")
local checkOwnedFn = remotes:WaitForChild("CheckOwned")

local starterPackUi = playerGui:WaitForChild("StarterPackUi")
local button = starterPackUi:WaitForChild("StarterPackButton")
local stateLabels = starterPackUi:WaitForChild("StateLabels")
local failedLabel = stateLabels:WaitForChild("Failed")
local successLabel = stateLabels:WaitForChild("Success")

--// CONFIG
local STARTER_PACK_PRODUCT_ID = 3599481243

local MESSAGE_VISIBLE_DURATION = 3
local FADE_DURATION = 0.3

local OWNERSHIP_CHECK_ATTEMPTS = 30
local OWNERSHIP_CHECK_DELAY = 0.5

local VERIFY_ERROR_MESSAGE = "Could not verify ownership. Please try again."
local OWNED_BASE_MESSAGE = "You've already purchased this product."
local PROCESSING_MESSAGE = "Purchase received. Finalizing your rewards..."
local PROCESSING_FAILED_MESSAGE = "Purchase is still processing. Please wait a moment or rejoin."
local SUCCESS_MESSAGE = "Successfully bought the developer product! You have been granted Senator Car and $800,000 in your wallet."

successLabel.Text = SUCCESS_MESSAGE

local productId = tonumber(button:GetAttribute("ProductId"))

if not productId or productId <= 0 then
	warn("[StarterPackClient] Missing or invalid ProductId attribute. Using fallback product ID.")
	productId = STARTER_PACK_PRODUCT_ID
end

--// STATE
local purchaseInProgress = false
local ownedSpamCount = 0

local failedHideToken = 0
local successHideToken = 0

local fadeInfo = TweenInfo.new(
	FADE_DURATION,
	Enum.EasingStyle.Quad,
	Enum.EasingDirection.Out
)

local activeTweens = {
	[failedLabel] = {
		labelTween = nil,
		strokeTween = nil,
	},
	[successLabel] = {
		labelTween = nil,
		strokeTween = nil,
	},
}

--// HELPERS
local function safeHidePurchaseLoading()
	if type(UIAudioConfig.HidePurchaseLoading) == "function" then
		local ok, err = pcall(function()
			UIAudioConfig.HidePurchaseLoading()
		end)

		if not ok then
			warn("[StarterPackClient] HidePurchaseLoading failed:", err)
		end
	else
		-- If your loading UI gets stuck, add UIAudioConfig.HidePurchaseLoading().
		warn("[StarterPackClient] UIAudioConfig.HidePurchaseLoading is missing.")
	end
end

local function safeShowPurchaseLoading()
	if type(UIAudioConfig.ShowPurchaseLoading) == "function" then
		local ok, err = pcall(function()
			UIAudioConfig.ShowPurchaseLoading()
		end)

		if not ok then
			warn("[StarterPackClient] ShowPurchaseLoading failed:", err)
		end
	end
end

local function safePlayRobuxSound()
	if type(UIAudioConfig.PlayRobux) == "function" then
		local ok, err = pcall(function()
			UIAudioConfig.PlayRobux()
		end)

		if not ok then
			warn("[StarterPackClient] PlayRobux failed:", err)
		end
	end
end

local function getStroke(label)
	return label:FindFirstChildOfClass("UIStroke")
end

local function cancelLabelTweens(label)
	local tweens = activeTweens[label]

	if not tweens then
		return
	end

	if tweens.labelTween then
		tweens.labelTween:Cancel()
		tweens.labelTween = nil
	end

	if tweens.strokeTween then
		tweens.strokeTween:Cancel()
		tweens.strokeTween = nil
	end
end

local function resetLabelVisual(label)
	label.TextTransparency = 0
	label.TextStrokeTransparency = 0

	local stroke = getStroke(label)
	if stroke then
		stroke.Transparency = 0
	end
end

local function hideFailedImmediate()
	failedHideToken += 1
	cancelLabelTweens(failedLabel)

	failedLabel.Visible = false
	failedLabel.TextTransparency = 1
	failedLabel.TextStrokeTransparency = 1

	local stroke = getStroke(failedLabel)
	if stroke then
		stroke.Transparency = 1
	end

	ownedSpamCount = 0
end

local function hideSuccessImmediate()
	successHideToken += 1
	cancelLabelTweens(successLabel)

	successLabel.Visible = false
	successLabel.TextTransparency = 1
	successLabel.TextStrokeTransparency = 1

	local stroke = getStroke(successLabel)
	if stroke then
		stroke.Transparency = 1
	end
end

local function fadeLabelOut(label, token, tokenGetter, onComplete)
	local tweens = activeTweens[label]
	if not tweens then
		return
	end

	if token ~= tokenGetter() then
		return
	end

	local stroke = getStroke(label)

	tweens.labelTween = TweenService:Create(label, fadeInfo, {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})

	tweens.labelTween:Play()

	if stroke then
		tweens.strokeTween = TweenService:Create(stroke, fadeInfo, {
			Transparency = 1,
		})

		tweens.strokeTween:Play()
	end

	tweens.labelTween.Completed:Connect(function(playbackState)
		if token ~= tokenGetter() then
			return
		end

		if playbackState ~= Enum.PlaybackState.Completed then
			return
		end

		label.Visible = false

		tweens.labelTween = nil
		tweens.strokeTween = nil

		if onComplete then
			onComplete()
		end
	end)
end

local function showFailureMessage(message, keepOwnedCounter)
	if not keepOwnedCounter then
		ownedSpamCount = 0
	end

	failedHideToken += 1
	local token = failedHideToken

	cancelLabelTweens(failedLabel)

	failedLabel.Text = message
	failedLabel.Visible = true
	resetLabelVisual(failedLabel)

	task.delay(MESSAGE_VISIBLE_DURATION, function()
		fadeLabelOut(failedLabel, token, function()
			return failedHideToken
		end, function()
			ownedSpamCount = 0
		end)
	end)
end

local function showOwnedFailureStacked()
	if failedLabel.Visible and ownedSpamCount > 0 then
		ownedSpamCount += 1
	else
		ownedSpamCount = 1
	end

	if ownedSpamCount <= 1 then
		showFailureMessage(OWNED_BASE_MESSAGE, true)
	else
		showFailureMessage(string.format("%s (x%d)", OWNED_BASE_MESSAGE, ownedSpamCount), true)
	end
end

local function setButtonEnabled(enabled)
	if button:IsA("GuiButton") then
		button.Active = enabled
		button.AutoButtonColor = enabled
	end
end

local function showSuccess()
	hideFailedImmediate()

	successHideToken += 1
	local token = successHideToken

	cancelLabelTweens(successLabel)

	successLabel.Text = SUCCESS_MESSAGE
	successLabel.Visible = true
	resetLabelVisual(successLabel)

	setButtonEnabled(false)

	task.delay(MESSAGE_VISIBLE_DURATION, function()
		fadeLabelOut(successLabel, token, function()
			return successHideToken
		end)
	end)
end

local function showProcessing()
	hideFailedImmediate()
	hideSuccessImmediate()

	failedLabel.Text = PROCESSING_MESSAGE
	failedLabel.Visible = true
	resetLabelVisual(failedLabel)
end

local function checkOwned()
	local ok, result = pcall(function()
		return checkOwnedFn:InvokeServer()
	end)

	if not ok then
		warn("[StarterPackClient] CheckOwned failed:", result)
		return nil
	end

	if result == nil then
		return nil
	end

	return result == true
end

local function waitForOwnership()
	for _ = 1, OWNERSHIP_CHECK_ATTEMPTS do
		local isOwned = checkOwned()

		if isOwned == true then
			return true
		end

		task.wait(OWNERSHIP_CHECK_DELAY)
	end

	return false
end

local function beginPurchase()
	if purchaseInProgress then
		return
	end

	if not productId or productId <= 0 then
		showFailureMessage("Starter Pack is unavailable right now.")
		return
	end

	purchaseInProgress = true

	local isOwned = checkOwned()

	if isOwned == nil then
		showFailureMessage(VERIFY_ERROR_MESSAGE)
		purchaseInProgress = false
		return
	end

	if isOwned then
		showOwnedFailureStacked()
		purchaseInProgress = false
		return
	end

	safePlayRobuxSound()
	safeShowPurchaseLoading()

	local promptOk, promptErr = pcall(function()
		MarketplaceService:PromptProductPurchase(player, productId)
	end)

	if not promptOk then
		warn("[StarterPackClient] PromptProductPurchase failed:", promptErr)

		safeHidePurchaseLoading()
		showFailureMessage("Could not open purchase prompt. Please try again.")
		purchaseInProgress = false
	end
end

--// BUTTON SETUP
UIButtonUtils.SetupButton(button, beginPurchase)

--// PURCHASE FINISHED
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, finishedProductId, wasPurchased)
	if userId ~= player.UserId then
		return
	end

	if finishedProductId ~= productId then
		return
	end

	safeHidePurchaseLoading()

	if not wasPurchased then
		purchaseInProgress = false
		return
	end

	showProcessing()

	task.spawn(function()
		local becameOwned = waitForOwnership()

		if becameOwned then
			showSuccess()
		else
			showFailureMessage(PROCESSING_FAILED_MESSAGE)
			setButtonEnabled(true)
		end

		purchaseInProgress = false
	end)
end)
