-- Purpose: Persists the exact immutable action that a Developer Product prompt
-- is intended to fund. Receipts bind to the saved intent instead of mutable
-- current gameplay state.
-- Runs on: Server (ModuleScript)
-- Location: ServerScriptService > PaidActionIntentStore

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

local IntentStore = DataStoreService:GetDataStore("PaidActionIntents_V1")

local PaidActionIntentStore = {}
local INTENT_TTL_SECONDS = 48 * 60 * 60

local function keyFor(userId, productId)
	return string.format("%d:%d", userId, productId)
end

local function sanitizePayload(payload)
	if type(payload) ~= "table" then
		return {}
	end

	local clean = {}
	for key, value in pairs(payload) do
		if type(key) == "string" then
			local valueType = type(value)
			if valueType == "string" or valueType == "boolean" then
				clean[key] = value
			elseif valueType == "number" and value == value and value ~= math.huge and value ~= -math.huge then
				clean[key] = value
			end
		end
	end
	return clean
end

function PaidActionIntentStore.Create(player, productId, action, payload)
	productId = math.floor(tonumber(productId) or 0)
	if not player or productId <= 0 or type(action) ~= "string" or action == "" then
		return false, "Invalid paid-action intent"
	end

	local intent = {
		IntentId = HttpService:GenerateGUID(false),
		UserId = player.UserId,
		ProductId = productId,
		Action = action,
		Payload = sanitizePayload(payload),
		CreatedAt = os.time(),
		ExpiresAt = os.time() + INTENT_TTL_SECONDS,
		Status = "Pending",
	}

	local success, result = pcall(function()
		return IntentStore:UpdateAsync(keyFor(player.UserId, productId), function(current)
			if type(current) == "table"
				and (current.Status == "Pending" or current.Status == "Bound")
			then
				-- Age alone cannot prove that a Developer Product was not bought;
				-- receipt delivery may be delayed beyond this server/session.
				return nil
			end
			return intent
		end)
	end)

	if not success or type(result) ~= "table" or result.IntentId ~= intent.IntentId then
		return false, "Another paid action is already pending"
	end

	return true, intent.IntentId
end

function PaidActionIntentStore.BindReceipt(userId, productId, purchaseId, expectedAction)
	userId = math.floor(tonumber(userId) or 0)
	productId = math.floor(tonumber(productId) or 0)
	purchaseId = tostring(purchaseId or "")
	if userId <= 0 or productId <= 0 or purchaseId == "" then
		return nil, "Invalid receipt intent lookup"
	end

	local boundIntent
	local success, result = pcall(function()
		return IntentStore:UpdateAsync(keyFor(userId, productId), function(current)
			boundIntent = nil
			if type(current) ~= "table" then
				return nil
			end
			if expectedAction and current.Action ~= expectedAction then
				return nil
			end
			if current.Status ~= "Pending" and current.Status ~= "Bound" then
				return nil
			end
			if current.Status == "Bound" and current.PurchaseId ~= purchaseId then
				return nil
			end
			current.Status = "Bound"
			current.PurchaseId = purchaseId
			current.BoundAt = current.BoundAt or os.time()
			boundIntent = current
			return current
		end)
	end)

	if not success then
		return nil, "Paid-action intent store unavailable"
	end
	if type(result) ~= "table" or result.PurchaseId ~= purchaseId then
		return nil, "No matching paid-action intent"
	end
	return boundIntent or result
end

function PaidActionIntentStore.GetPending(userId, productId, expectedAction)
	local success, current = pcall(function()
		return IntentStore:GetAsync(keyFor(userId, productId))
	end)
	if not success then return nil, "Paid-action intent store unavailable" end
	if type(current) ~= "table" then return false end
	if expectedAction and current.Action ~= expectedAction then return false end
	if current.Status == "Pending" or current.Status == "Bound" then return current end
	return false
end

function PaidActionIntentStore.Complete(userId, productId, purchaseId)
	local completed = false
	local success, result = pcall(function()
		return IntentStore:UpdateAsync(keyFor(userId, productId), function(current)
			completed = false
			if type(current) ~= "table" or current.PurchaseId ~= tostring(purchaseId) then
				return current
			end
			current.Status = "Completed"
			current.CompletedAt = os.time()
			current.ExpiresAt = math.max(tonumber(current.ExpiresAt) or 0, os.time() + 24 * 60 * 60)
			completed = true
			return current
		end)
	end)
	return success, completed, result
end

function PaidActionIntentStore.Cancel(player, productId, intentId)
	local success = pcall(function()
		IntentStore:UpdateAsync(keyFor(player.UserId, productId), function(current)
			if type(current) == "table" and current.IntentId == intentId and current.Status == "Pending" then
				return nil
			end
			return current
		end)
	end)
	return success
end

return PaidActionIntentStore
