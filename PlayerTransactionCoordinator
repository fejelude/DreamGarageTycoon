-- Purpose: Provides one server-wide transaction boundary for every mutation of
-- a player's economy, inventory, layout, progression, rewards, and receipts.
-- Runs on: Server (ModuleScript)
-- Location: ServerScriptService > PlayerTransactionCoordinator

local Players = game:GetService("Players")

local Coordinator = {}

local DEFAULT_TIMEOUT_SECONDS = 15
local locksByUserId = {}
local NON_READY_OPERATIONS = {
	ProfileSave = true,
	FinalProfileSave = true,
}

local function currentOwner()
	return coroutine.running()
end

local function acquireUserId(userId, timeoutSeconds)
	timeoutSeconds = math.max(0.1, tonumber(timeoutSeconds) or DEFAULT_TIMEOUT_SECONDS)
	local owner = currentOwner()
	local startedAt = os.clock()

	while true do
		local lock = locksByUserId[userId]
		if not lock then
			locksByUserId[userId] = {
				Owner = owner,
				Depth = 1,
				AcquiredAt = os.clock(),
			}
			return true
		end

		if lock.Owner == owner then
			lock.Depth += 1
			return true
		end

		if os.clock() - startedAt >= timeoutSeconds then
			return false, "Player transaction is busy"
		end

		task.wait(0.03)
	end
end

local function releaseUserId(userId)
	local lock = locksByUserId[userId]
	if not lock or lock.Owner ~= currentOwner() then
		warn("[PlayerTransactionCoordinator] Ignored an invalid lock release for user " .. tostring(userId))
		return
	end

	lock.Depth -= 1
	if lock.Depth <= 0 then
		locksByUserId[userId] = nil
	end
end

local function normalizePlayers(players)
	local uniqueByUserId = {}
	for _, player in ipairs(players) do
		if typeof(player) ~= "Instance" or not player:IsA("Player") then
			return nil, "Invalid player transaction target"
		end
		if player.Parent ~= Players then
			return nil, "Player left the server"
		end
		uniqueByUserId[player.UserId] = player
	end

	local ordered = {}
	for _, player in pairs(uniqueByUserId) do
		table.insert(ordered, player)
	end
	table.sort(ordered, function(a, b)
		return a.UserId < b.UserId
	end)
	return ordered
end

function Coordinator.RunMany(players, operationName, callback, timeoutSeconds)
	if type(players) ~= "table" or type(callback) ~= "function" then
		return false, "Invalid transaction request"
	end

	local ordered, normalizeError = normalizePlayers(players)
	if not ordered then
		return false, normalizeError
	end
	if not NON_READY_OPERATIONS[operationName] then
		for _, player in ipairs(ordered) do
			if player:GetAttribute("TycoonDataLoaded") ~= true
				or player:GetAttribute("TycoonDataPhase") ~= "Ready"
			then
				return false, "Player data is not ready"
			end
		end
	end

	local acquired = {}
	for _, player in ipairs(ordered) do
		local ok, acquireError = acquireUserId(player.UserId, timeoutSeconds)
		if not ok then
			for index = #acquired, 1, -1 do
				releaseUserId(acquired[index])
			end
			return false, acquireError
		end
		table.insert(acquired, player.UserId)
	end

	local result = table.pack(xpcall(callback, debug.traceback))
	for index = #acquired, 1, -1 do
		releaseUserId(acquired[index])
	end

	if not result[1] then
		warn(string.format(
			"[PlayerTransactionCoordinator] %s failed: %s",
			tostring(operationName or "UnnamedOperation"),
			tostring(result[2])
		))
		return false, "Internal transaction error"
	end

	return table.unpack(result, 2, result.n)
end

function Coordinator.Run(player, operationName, callback, timeoutSeconds)
	return Coordinator.RunMany({ player }, operationName, callback, timeoutSeconds)
end

function Coordinator.IsLocked(player)
	return player ~= nil and locksByUserId[player.UserId] ~= nil
end

function Coordinator.AssertOwned(player)
	local lock = player and locksByUserId[player.UserId]
	return lock ~= nil and lock.Owner == currentOwner()
end

Players.PlayerRemoving:Connect(function(player)
	local lock = locksByUserId[player.UserId]
	if lock and lock.Owner == nil then
		locksByUserId[player.UserId] = nil
	end
end)

return Coordinator
