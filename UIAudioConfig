	{ Id = SHOP_OPEN_SFX_ID, Volume = 0.64, Pitch = 0.99, Variance = 0.01, Dedupe = 0.18 },
	{ Id = SHOP_OPEN_SFX_ID, Volume = 0.66, Pitch = 1.02, Variance = 0.01, Dedupe = 0.18 },
	{ Id = SHOP_OPEN_SFX_ID, Volume = 0.63, Pitch = 1.05, Variance = 0.01, Dedupe = 0.18 },
	{ Id = SHOP_OPEN_SFX_ID, Volume = 0.65, Pitch = 1.08, Variance = 0.01, Dedupe = 0.18 },
}
local lastShopOpenVariantIndex = nil

local NAMED_SFX = {
	Open = { Id = SHOP_OPEN_SFX_ID, Volume = 0.64, Pitch = 1.0, Variance = 0.03, Dedupe = 0.18 },
	BuySuccess = { Id = "rbxassetid://140072726814802", Volume = 0.5, Pitch = 1.0, Variance = 0.03, Dedupe = 0.12 },
	BuyFail = { Id = "rbxassetid://83517496538471", Volume = 0.5, Pitch = 1.0, Variance = 0.03, Dedupe = 0.12 },
	PaidReroll = { Id = "rbxassetid://140072726814802", Volume = 1.0, Pitch = 4.0, Variance = 0, Dedupe = 0.3 },
	AutoRestock = { Id = "rbxassetid://134952684776633", Volume = 0.5, Pitch = 1.0, Variance = 0.03, Dedupe = 2.0, Key = "Restock" },
	Restock = { Id = "rbxassetid://134952684776633", Volume = 0.5, Pitch = 1.0, Variance = 0.03, Dedupe = 2.0, Key = "Restock" },
	GlobalRestock = { Id = "rbxassetid://81822437427070", Volume = 1.0, Pitch = 1.0, Variance = 0, Dedupe = 2.0, Key = "Restock" },
	RankQuestComplete = { Id = RANK_QUEST_COMPLETE_SFX_ID, Volume = UIAudioConfig.RANK_QUEST_COMPLETE_VOLUME, Pitch = 1.0, Variance = 0.03, Dedupe = 0.1 },
}


local function playOneShot(id, volume, pitch, variance)
	if isSFXMuted() then return end

	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = (pitch or 1) + (math.random() * 2 - 1) * (variance or 0)
	sound.Name = "GlobalUISFX"
	sound.RollOffMaxDistance = 0
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 3)
end

function UIAudioConfig.PlayShopOpen()
	if not canPlayDedupe("Open", 0.18) then return end

	local variantIndex = math.random(1, #SHOP_OPEN_VARIANTS)
	if #SHOP_OPEN_VARIANTS > 1 and variantIndex == lastShopOpenVariantIndex then
		variantIndex = (variantIndex % #SHOP_OPEN_VARIANTS) + 1
	end
	lastShopOpenVariantIndex = variantIndex

	local data = SHOP_OPEN_VARIANTS[variantIndex]
	playOneShot(data.Id, data.Volume, data.Pitch, data.Variance)
end

function UIAudioConfig.PlayNamed(name)
	if name == "Open" then
		UIAudioConfig.PlayShopOpen()
		return
	end

	local data = NAMED_SFX[name]
	if not data then return end

	local key = data.Key or name
	if not canPlayDedupe(key, data.Dedupe or 0.05) then
		return
	end

	playOneShot(data.Id, data.Volume, data.Pitch, data.Variance)
end

function UIAudioConfig.PlayRestock()
	UIAudioConfig.PlayNamed("GlobalRestock")
end

function UIAudioConfig.PlayRankQuestComplete()
	UIAudioConfig.PlayNamed("RankQuestComplete")
end

-- ============================================================================
-- 🏷️ REUSABLE STATE LABEL FEEDBACK (Bank Transfer style)
-- ============================================================================
function UIAudioConfig.CreateStateFeedback(container)
	local stateLabels = nil
	local successLabel = nil
	local failedLabel = nil
	local legacyIndicator = nil

	local feedback = {}
	local messageState = {}
	local labelHideToken = {}
	local labelTweens = {}
	local labelDefaults = {}
	local LABEL_SHOW_SECONDS = 3
	local LABEL_FADE_OUT_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	local function getStroke(label)
		return label and label:FindFirstChildOfClass("UIStroke")
	end

	local function rememberDefaults(label)
		if not label or labelDefaults[label] then return end
		local stroke = getStroke(label)
		labelDefaults[label] = {
			TextTransparency = label.TextTransparency,
			TextStrokeTransparency = label.TextStrokeTransparency,
			TextColor3 = label.TextColor3,
			UIStrokeTransparency = stroke and stroke.Transparency or nil,
		}
	end

	local function resolveLabels()
		if container then
			stateLabels = stateLabels or container:FindFirstChild("StateLabels") or container:FindFirstChild("StateLabels", true)
			successLabel = successLabel or (stateLabels and (stateLabels:FindFirstChild("Success") or stateLabels:FindFirstChild("Sucess")))
			failedLabel = failedLabel or (stateLabels and stateLabels:FindFirstChild("Failed"))

			if not (successLabel and failedLabel) then
				legacyIndicator = legacyIndicator or container:FindFirstChild("Indicator-purchase", true)
			end
		end

		rememberDefaults(successLabel)
		rememberDefaults(failedLabel)
		rememberDefaults(legacyIndicator)
	end

	resolveLabels()

	local function resetMessageState(label)
		local state = messageState[label]
		if state then
			state.count = 0
			state.baseText = nil
		end
	end

	local function cancelLabelTween(label)
		local tweens = labelTweens[label]
		if not tweens then return end
		for _, tween in pairs(tweens) do
			if tween then tween:Cancel() end
		end
		labelTweens[label] = nil
	end

	local function resetLabelTransparency(label)
		if not label then return end
		local defaults = labelDefaults[label]
		if defaults then
			label.TextTransparency = defaults.TextTransparency
			label.TextStrokeTransparency = defaults.TextStrokeTransparency
			if defaults.TextColor3 then label.TextColor3 = defaults.TextColor3 end
			local stroke = getStroke(label)
			if stroke and defaults.UIStrokeTransparency ~= nil then
				stroke.Transparency = defaults.UIStrokeTransparency
			end
		else
			label.TextTransparency = 0
			label.TextStrokeTransparency = 0
			local stroke = getStroke(label)
			if stroke then stroke.Transparency = 0 end
		end
	end

	local function hideLabel(label)
		if not label then return end
		cancelLabelTween(label)
		labelHideToken[label] = (labelHideToken[label] or 0) + 1
		label.Visible = false
		resetLabelTransparency(label)
		resetMessageState(label)
	end

	local function fadeOutLabel(label)
		if not label or not label.Visible then return end
		cancelLabelTween(label)
		local stroke = getStroke(label)
		local textTween = TweenService:Create(label, LABEL_FADE_OUT_INFO, {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		})
		local strokeTween = nil
		if stroke then
			strokeTween = TweenService:Create(stroke, LABEL_FADE_OUT_INFO, { Transparency = 1 })
		end
		local activeTweens = { Text = textTween, UIStroke = strokeTween }
		labelTweens[label] = activeTweens
		local connection
		connection = textTween.Completed:Connect(function()
			if connection then connection:Disconnect() end
			if labelTweens[label] ~= activeTweens then return end
			labelTweens[label] = nil
			label.Visible = false
			resetLabelTransparency(label)
			resetMessageState(label)
		end)
		textTween:Play()
		if strokeTween then strokeTween:Play() end
	end

	local function getOpposite(label)
		if label == successLabel then return failedLabel end
		if label == failedLabel then return successLabel end
		return nil
	end

	local function shouldSuppressRepeatCounter(baseText)
		return type(baseText) == "string" and string.find(baseText, "Booster Maxed & Active", 1, true) ~= nil
	end

	function feedback:Show(label, baseText, color)
		if not label then
			resolveLabels()
		end

		if not label then
			if legacyIndicator then
				label = legacyIndicator
			else
				return
			end
		end

		local other = getOpposite(label)
		hideLabel(other)
		cancelLabelTween(label)
		resetLabelTransparency(label)

		if color then
			label.TextColor3 = color
		end

		local state = messageState[label]
		if not state then
			state = { count = 0, baseText = baseText }
			messageState[label] = state
		end

		if state.baseText == baseText and label.Visible then
			state.count += 1
		else
			state.count = 1
			state.baseText = baseText
		end

		if state.count >= 2 and not shouldSuppressRepeatCounter(baseText) then
			label.Text = baseText .. " (x" .. tostring(state.count) .. ")"
		else
			label.Text = baseText
		end
		label.Visible = true

		labelHideToken[label] = (labelHideToken[label] or 0) + 1
		local thisToken = labelHideToken[label]
		task.delay(LABEL_SHOW_SECONDS, function()
			if labelHideToken[label] == thisToken and label.Visible then
				fadeOutLabel(label)
			end
		end)
	end

	function feedback:Success(text, color)
		resolveLabels()
		self:Show(successLabel, text, color)
	end

	function feedback:Failed(text, color)
		resolveLabels()
		self:Show(failedLabel, text, color)
	end

	function feedback:Clear()
		resolveLabels()
		hideLabel(successLabel)
		hideLabel(failedLabel)
		hideLabel(legacyIndicator)
	end

	feedback:Clear()
	return feedback
end

-- ============================================================================
-- 💎 ROBUX PURCHASE LOADING UI
-- Location: StarterGui > PurchasingState (ScreenGui)
--           └── Loading (Frame) — centered overlay
--                └── LoadingIcon (ImageLabel) — spins while active
--
-- CRITICAL DESIGN NOTES:
--   • ShowPurchaseLoading() force-enables PurchasingState and sets DisplayOrder
--     to 9999 so it ALWAYS renders on top, even when shops run toggleOtherGuis()
--     which would otherwise hide it.
--   • HidePurchaseLoading() re-disables the ScreenGui to return to neutral state.
--   • This makes the loader truly universal — no shop needs to whitelist it.
-- ============================================================================

local _loadingScreen  = nil  -- cached PurchasingState ScreenGui
local _loadingFrame   = nil  -- cached Loading Frame
local _origFrameTrans = 0    -- captured from editor design
local _origIconTrans  = 0    -- captured from editor design

local function resolveLoadingUI()
	-- Return cached refs if still valid
	if _loadingScreen and _loadingScreen.Parent
		and _loadingFrame  and _loadingFrame.Parent then
		return _loadingScreen, _loadingFrame
	end

	local player    = Players.LocalPlayer
	local playerGui = player and player:FindFirstChild("PlayerGui")
	if not playerGui then return nil, nil end

	_loadingScreen = playerGui:FindFirstChild("PurchasingState")
	if not _loadingScreen then
		warn("[UIAudioConfig] 'PurchasingState' ScreenGui not found in PlayerGui.")
		return nil, nil
	end

	_loadingFrame = _loadingScreen:FindFirstChild("Loading")
	if not _loadingFrame then
		warn("[UIAudioConfig] 'Loading' Frame not found inside PurchasingState.")
		return _loadingScreen, nil
	end

	-- ✅ One-time setup: ensure the ScreenGui renders above all other UIs
	_loadingScreen.DisplayOrder       = 9999
	_loadingScreen.ZIndexBehavior     = Enum.ZIndexBehavior.Global
	_loadingScreen.IgnoreGuiInset     = true
	_loadingScreen.ResetOnSpawn       = false

	_loadingFrame.AnchorPoint         = Vector2.new(0.5, 0.5)
	_loadingFrame.Position            = UDim2.new(0.5, 0, 0.5, 0)
	_loadingFrame.Visible             = false

	_origFrameTrans = _loadingFrame.BackgroundTransparency

	-- ✅ One-time setup: center the LoadingIcon inside the frame
	local icon = _loadingFrame:FindFirstChild("LoadingIcon")
	if icon then
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position    = UDim2.new(0.5, 0, 0.5, 0)
		_origIconTrans = icon.ImageTransparency
	end

	return _loadingScreen, _loadingFrame
end

-- Show the loading overlay immediately when a Robux purchase is initiated.
-- Safe to call from any script — always renders above shop UIs.
function UIAudioConfig.ShowPurchaseLoading()
	local screen, frame = resolveLoadingUI()
	if not frame then return end

	-- Force the ScreenGui ON at the highest layer
	screen.Enabled  = true
	frame.Visible   = true

	-- Reset to the original editor-defined design
	frame.BackgroundTransparency = _origFrameTrans
	local icon = frame:FindFirstChild("LoadingIcon")
	if icon then
		icon.ImageTransparency = _origIconTrans
		icon.Rotation = 0

		-- Cancel any previous spin before starting a new one
		if not _G.__RobuxSpinTweens then _G.__RobuxSpinTweens = {} end
		if _G.__RobuxSpinTweens[icon] then
			_G.__RobuxSpinTweens[icon]:Cancel()
		end

		local spinTween = TweenService:Create(
			icon,
			TweenInfo.new(1.0, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
			{ Rotation = 360 }
		)
		spinTween:Play()
		_G.__RobuxSpinTweens[icon] = spinTween
	end
end

-- Hide the loading overlay when a purchase finishes (success, cancel, or fail).
function UIAudioConfig.HidePurchaseLoading()
	local screen, frame = resolveLoadingUI()
	if not frame then return end

	-- Use a generation counter to ensure late-running fades don't hide a NEW loading session
	if not _G.__LoadingUIGeneration then _G.__LoadingUIGeneration = 0 end
	_G.__LoadingUIGeneration += 1
	local currentGen = _G.__LoadingUIGeneration

	task.delay(0.5, function()
		if currentGen ~= _G.__LoadingUIGeneration then return end

		local icon = frame:FindFirstChild("LoadingIcon")
		local fadeInfo = TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

		local frameTween = TweenService:Create(frame, fadeInfo, {BackgroundTransparency = 1})
		frameTween:Play()

		if icon then
			local iconTween = TweenService:Create(icon, fadeInfo, {ImageTransparency = 1})
			iconTween:Play()
		end

		frameTween.Completed:Connect(function()
			if currentGen ~= _G.__LoadingUIGeneration then return end
			frame.Visible = false
			screen.Enabled = false

			-- Restore original editor values so it's ready for the next Show call
			frame.BackgroundTransparency = _origFrameTrans
			if icon then
				icon.ImageTransparency = _origIconTrans

				if _G.__RobuxSpinTweens and _G.__RobuxSpinTweens[icon] then
					_G.__RobuxSpinTweens[icon]:Cancel()
					_G.__RobuxSpinTweens[icon] = nil
				end
				icon.Rotation = 0
			end
		end)
	end)
end

return UIAudioConfig
