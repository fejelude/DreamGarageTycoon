-- ============================================================================
-- UIAudioConfig (ModuleScript)
-- Location: ReplicatedStorage
-- Purpose:  Centralized UI sound system. Single source of truth for all
--           hover/click/robux audio across the entire game UI.
--           To change volume, edit the volume constants below.
-- ============================================================================

local SoundService   = game:GetService("SoundService")
local TweenService   = game:GetService("TweenService")
local Players        = game:GetService("Players")
local ContentProvider = game:GetService("ContentProvider")

local UIAudioConfig = {}

-- ⚙️ EASY VOLUME CONFIGURATION — edit these values to adjust UI sounds
UIAudioConfig.HOVER_VOLUME  = 1.5
UIAudioConfig.CLICK_VOLUME  = 1.8
UIAudioConfig.ROBUX_VOLUME  = 1.5

-- Short duplicate guards prevent two scripts from layering the same action SFX
-- during one user action (for example Button.Activated + shop open event).
UIAudioConfig.CLICK_DEDUPE_SECONDS = 0.35
UIAudioConfig.ACTION_DEDUPE_SECONDS = 0.35

-- Sound asset IDs
local HOVER_SFX_ID = "rbxassetid://73899820361873"
local CLICK_SFX_ID = "rbxassetid://126294184545314"
local ROBUX_SFX_ID = "rbxassetid://117986449113759"   -- 💎 Robux purchase initiation sound

-- Hover sounds need to overlap during fast mouse movement across many buttons.
-- A single shared Sound restarts itself when :Play() is called repeatedly, which
-- makes hover feedback feel delayed/choked. Keep a small pool of preloaded
-- channels so each MouseEnter can fire immediately without waiting on the
-- previous hover chirp to finish.
local HOVER_POOL_SIZE = 10

local function isSFXMuted()
	return SoundService:GetAttribute("SFXMuted") == true
end

function UIAudioConfig.IsSFXMuted()
	return isSFXMuted()
end

local function configureSound(sound, id, volume)
	sound.SoundId = id
	sound.Volume = volume
	sound.Looped = false
	return sound
end

-- Internal: create or reuse a persistent Sound in SoundService
local function getOrCreateSound(name, id, volume)
	local sound = SoundService:FindFirstChild(name)
	if not sound or not sound:IsA("Sound") then
		sound = Instance.new("Sound")
		sound.Name = name
		sound.Parent = SoundService
	end
	return configureSound(sound, id, volume)
end

local function createHoverPool()
	local pool = {}
	for i = 1, HOVER_POOL_SIZE do
		local name = (i == 1) and "GlobalUIHover" or ("GlobalUIHover_%02d"):format(i)
		table.insert(pool, getOrCreateSound(name, HOVER_SFX_ID, UIAudioConfig.HOVER_VOLUME))
	end
	return pool
end

-- Create global sounds once at require-time
local hoverSounds = createHoverPool()
local clickSound = getOrCreateSound("GlobalUIClick", CLICK_SFX_ID, UIAudioConfig.CLICK_VOLUME)
local robuxSound = getOrCreateSound("GlobalUIRobux", ROBUX_SFX_ID, UIAudioConfig.ROBUX_VOLUME)
local hoverSoundIndex = 0
local lastClickPlayedAt = 0
local lastActionPlayedAt = {}

local function stopUISounds()
	clickSound:Stop()
	robuxSound:Stop()
	for _, sound in ipairs(hoverSounds) do
		sound:Stop()
	end
end

SoundService:GetAttributeChangedSignal("SFXMuted"):Connect(function()
	if isSFXMuted() then
		stopUISounds()
	end
end)

task.spawn(function()
	local soundsToPreload = { clickSound, robuxSound }
	for _, sound in ipairs(hoverSounds) do
		table.insert(soundsToPreload, sound)
	end

	local success, err = pcall(function()
		ContentProvider:PreloadAsync(soundsToPreload)
	end)
	if not success then
		warn("[UIAudioConfig] Failed to preload UI sounds: " .. tostring(err))
	end
end)

-- Play hover immediately on its own channel so rapid button sweeps create the
-- polished layered UI feel instead of cutting off or blocking prior hovers.
function UIAudioConfig.PlayHover()
	if isSFXMuted() then return end

	hoverSoundIndex = (hoverSoundIndex % #hoverSounds) + 1
	local sound = hoverSounds[hoverSoundIndex]
	sound.Volume = UIAudioConfig.HOVER_VOLUME
	if sound.IsPlaying then
		sound:Stop()
	end
	sound.TimePosition = 0
	sound:Play()
end

local function nowClock()
	return os.clock()
end

local function shouldPlayDeduped(key, cooldown)
	local now = nowClock()
	local last = lastActionPlayedAt[key] or 0
	if now - last < cooldown then
		return false
	end

	lastActionPlayedAt[key] = now
	return true
end

-- Play click through the central UI sound system. A tiny duplicate guard keeps
-- nested UI scripts from producing double-click audio for the same action.
function UIAudioConfig.PlayClick()
	if isSFXMuted() then return end

	local now = nowClock()
	if now - lastClickPlayedAt < UIAudioConfig.CLICK_DEDUPE_SECONDS then
		return
	end

	lastClickPlayedAt = now
	clickSound.Volume = UIAudioConfig.CLICK_VOLUME
	clickSound:Play()
end

function UIAudioConfig.ShouldPlayAction(actionKey, cooldown)
	return shouldPlayDeduped(actionKey, cooldown or UIAudioConfig.ACTION_DEDUPE_SECONDS)
end

-- Play Robux — distinct sound for any MarketplaceService purchase initiation.
function UIAudioConfig.PlayRobux()
	if isSFXMuted() then return end

	robuxSound.Volume = UIAudioConfig.ROBUX_VOLUME
	robuxSound:Play()
end

-- ============================================================================
-- ✅ STATE LABEL FEEDBACK
-- Reusable Bank-style feedback controller for UIs that provide:
--   MainFrame > StateLabels > Success
--   MainFrame > StateLabels > Failed
-- Repeated identical messages are rendered as "Message x1", "Message x2", etc.
-- ============================================================================

local STATE_LABEL_SHOW_SECONDS = 3.5
local STATE_LABEL_FADE_OUT_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local stateLabelControllers = setmetatable({}, { __mode = "k" })

local function getLabelUIStroke(label)
	return label and label:FindFirstChildOfClass("UIStroke") or nil
end

local function resolveStateLabels(container)
	if not container then return nil, nil, nil end

	local stateLabels = nil
	if container.Name == "StateLabels" then
		stateLabels = container
	elseif container.FindFirstChild then
		stateLabels = container:FindFirstChild("StateLabels")
	end

	if not stateLabels then return nil, nil, nil end

	local successLabel = stateLabels:FindFirstChild("Success")
	local failedLabel = stateLabels:FindFirstChild("Failed")
	return stateLabels, successLabel, failedLabel
end

local function getStateLabelController(stateLabels, successLabel, failedLabel)
	local controller = stateLabelControllers[stateLabels]
	if controller then return controller end

	controller = {
		Labels = { Success = successLabel, Failed = failedLabel },
		MessageState = {},
		HideToken = {},
		DisplayToken = {},
		Tweens = {},
		Defaults = {},
	}

	for _, label in pairs(controller.Labels) do
		if label then
			local uiStroke = getLabelUIStroke(label)
			controller.Defaults[label] = {
				TextTransparency = label.TextTransparency,
				TextStrokeTransparency = label.TextStrokeTransparency,
				UIStrokeTransparency = uiStroke and uiStroke.Transparency or nil,
			}
		end
	end

	stateLabelControllers[stateLabels] = controller
	return controller
end

local function cancelStateLabelTween(controller, label)
	local tweens = controller.Tweens[label]
	if tweens then
		-- Clear before cancelling so Tween.Completed callbacks from cancelled fades
		-- cannot hide a freshly-updated message or reset its x-count.
		controller.Tweens[label] = nil
		for _, tween in pairs(tweens) do
			if tween then tween:Cancel() end
		end
	end
end

local function resetStateLabelTransparency(controller, label)
	local defaults = controller.Defaults[label]
	if defaults then
		label.TextTransparency = defaults.TextTransparency
		label.TextStrokeTransparency = defaults.TextStrokeTransparency
		local uiStroke = getLabelUIStroke(label)
		if uiStroke and defaults.UIStrokeTransparency ~= nil then
			uiStroke.Transparency = defaults.UIStrokeTransparency
		end
	else
		label.TextTransparency = 0
		label.TextStrokeTransparency = 0
		local uiStroke = getLabelUIStroke(label)
		if uiStroke then uiStroke.Transparency = 0 end
	end
end

local function resetStateMessage(controller, label)
	local state = controller.MessageState[label]
	if state then
		state.count = 0
		state.baseText = nil
		state.isActive = false
	end
end

local function hideStateLabel(controller, label)
	if not label then return end
	cancelStateLabelTween(controller, label)
	controller.HideToken[label] = (controller.HideToken[label] or 0) + 1
	controller.DisplayToken[label] = (controller.DisplayToken[label] or 0) + 1
	label.Visible = false
	resetStateLabelTransparency(controller, label)
	resetStateMessage(controller, label)
end

local function fadeOutStateLabel(controller, label, expectedDisplayToken)
	if not label or not label.Visible then return end
	if expectedDisplayToken and controller.DisplayToken[label] ~= expectedDisplayToken then return end
	cancelStateLabelTween(controller, label)

	local uiStroke = getLabelUIStroke(label)
	local textTween = TweenService:Create(label, STATE_LABEL_FADE_OUT_INFO, {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	})
	local strokeTween = uiStroke and TweenService:Create(uiStroke, STATE_LABEL_FADE_OUT_INFO, { Transparency = 1 }) or nil
	local activeTweens = { Text = textTween, UIStroke = strokeTween }
	controller.Tweens[label] = activeTweens

	local connection
	local fadeDisplayToken = controller.DisplayToken[label]
	connection = textTween.Completed:Connect(function(playbackState)
		if connection then connection:Disconnect() end
		if playbackState ~= Enum.PlaybackState.Completed then return end
		if controller.Tweens[label] ~= activeTweens then return end
		if controller.DisplayToken[label] ~= fadeDisplayToken then return end

		controller.Tweens[label] = nil
		label.Visible = false
		resetStateLabelTransparency(controller, label)
		resetStateMessage(controller, label)
	end)

	textTween:Play()
	if strokeTween then strokeTween:Play() end
end

function UIAudioConfig.ShowStateLabel(container, isSuccess, baseText)
	local stateLabels, successLabel, failedLabel = resolveStateLabels(container)
	if not stateLabels then return false end

	local label = isSuccess and successLabel or failedLabel
	if not label then
		warn("[UIAudioConfig] Missing " .. (isSuccess and "Success" or "Failed") .. " StateLabels label for: " .. tostring(baseText))
		return false
	end

	local controller = getStateLabelController(stateLabels, successLabel, failedLabel)
	local otherLabel = isSuccess and failedLabel or successLabel
	hideStateLabel(controller, otherLabel)
	cancelStateLabelTween(controller, label)
	resetStateLabelTransparency(controller, label)

	local state = controller.MessageState[label]
	if not state then
		state = { count = 0, baseText = baseText }
		controller.MessageState[label] = state
	end

	if state.baseText == baseText and state.isActive then
		state.count += 1
	else
		state.count = 1
		state.baseText = baseText
	end
	state.isActive = true

	controller.DisplayToken[label] = (controller.DisplayToken[label] or 0) + 1
	local displayToken = controller.DisplayToken[label]

	label.Text = tostring(baseText) .. " x" .. state.count
	label.Visible = true

	controller.HideToken[label] = (controller.HideToken[label] or 0) + 1
	local thisToken = controller.HideToken[label]
	task.delay(STATE_LABEL_SHOW_SECONDS, function()
		if controller.HideToken[label] == thisToken
			and controller.DisplayToken[label] == displayToken
			and label.Visible
		then
			fadeOutStateLabel(controller, label, displayToken)
		end
	end)

	return true
end

function UIAudioConfig.ClearStateLabels(container)
	local stateLabels, successLabel, failedLabel = resolveStateLabels(container)
	if not stateLabels then return false end
	local controller = getStateLabelController(stateLabels, successLabel, failedLabel)
	hideStateLabel(controller, successLabel)
	hideStateLabel(controller, failedLabel)
	return true
end

-- ============================================================================
-- 💎 ROBUX PURCHASE LOADING UI
-- Location: StarterGui > PurchasingState (ScreenGui)
--           └── Loading (Frame) — centered overlay
--                └── LoadingIcon (ImageLabel) — spins while active
--
-- CRITICAL DESIGN NOTES:
--   • ShowPurchaseLoading() force-enables PurchasingState and sets DisplayOrder
--     to 9999 so it ALWAYS renders on top, even when shops run toggleOtherGuis()
--     which would otherwise hide it.
--   • HidePurchaseLoading() re-disables the ScreenGui to return to neutral state.
--   • This makes the loader truly universal — no shop needs to whitelist it.
-- ============================================================================

local _loadingScreen  = nil  -- cached PurchasingState ScreenGui
local _loadingFrame   = nil  -- cached Loading Frame
local _origFrameTrans = 0    -- captured from editor design
local _origIconTrans  = 0    -- captured from editor design

local function resolveLoadingUI()
	-- Return cached refs if still valid
	if _loadingScreen and _loadingScreen.Parent
		and _loadingFrame  and _loadingFrame.Parent then
		return _loadingScreen, _loadingFrame
	end

	local player    = Players.LocalPlayer
	local playerGui = player and player:FindFirstChild("PlayerGui")
	if not playerGui then return nil, nil end

	_loadingScreen = playerGui:FindFirstChild("PurchasingState")
	if not _loadingScreen then
		warn("[UIAudioConfig] 'PurchasingState' ScreenGui not found in PlayerGui.")
		return nil, nil
	end

	_loadingFrame = _loadingScreen:FindFirstChild("Loading")
	if not _loadingFrame then
		warn("[UIAudioConfig] 'Loading' Frame not found inside PurchasingState.")
		return _loadingScreen, nil
	end

	-- ✅ One-time setup: ensure the ScreenGui renders above all other UIs
	_loadingScreen.DisplayOrder       = 9999
	_loadingScreen.ZIndexBehavior     = Enum.ZIndexBehavior.Global
	_loadingScreen.IgnoreGuiInset     = true
	_loadingScreen.ResetOnSpawn       = false

	_loadingFrame.AnchorPoint         = Vector2.new(0.5, 0.5)
	_loadingFrame.Position            = UDim2.new(0.5, 0, 0.5, 0)
	_loadingFrame.Visible             = false

	_origFrameTrans = _loadingFrame.BackgroundTransparency

	-- ✅ One-time setup: center the LoadingIcon inside the frame
	local icon = _loadingFrame:FindFirstChild("LoadingIcon")
	if icon then
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position    = UDim2.new(0.5, 0, 0.5, 0)
		_origIconTrans = icon.ImageTransparency
	end

	return _loadingScreen, _loadingFrame
end

-- Show the loading overlay immediately when a Robux purchase is initiated.
-- Safe to call from any script — always renders above shop UIs.
function UIAudioConfig.ShowPurchaseLoading()
	local screen, frame = resolveLoadingUI()
	if not frame then return end

	-- Force the ScreenGui ON at the highest layer
	screen.Enabled  = true
	frame.Visible   = true

	-- Reset to the original editor-defined design
	frame.BackgroundTransparency = _origFrameTrans
	local icon = frame:FindFirstChild("LoadingIcon")
	if icon then
		icon.ImageTransparency = _origIconTrans
		icon.Rotation = 0

		-- Cancel any previous spin before starting a new one
		if not _G.__RobuxSpinTweens then _G.__RobuxSpinTweens = {} end
		if _G.__RobuxSpinTweens[icon] then
			_G.__RobuxSpinTweens[icon]:Cancel()
		end

		local spinTween = TweenService:Create(
			icon,
			TweenInfo.new(1.0, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1),
			{ Rotation = 360 }
		)
		spinTween:Play()
		_G.__RobuxSpinTweens[icon] = spinTween
	end
end

-- Hide the loading overlay when a purchase finishes (success, cancel, or fail).
function UIAudioConfig.HidePurchaseLoading()
	local screen, frame = resolveLoadingUI()
	if not frame then return end

	-- Use a generation counter to ensure late-running fades don't hide a NEW loading session
	if not _G.__LoadingUIGeneration then _G.__LoadingUIGeneration = 0 end
	_G.__LoadingUIGeneration += 1
	local currentGen = _G.__LoadingUIGeneration

	task.delay(0.5, function()
		if currentGen ~= _G.__LoadingUIGeneration then return end

		local icon = frame:FindFirstChild("LoadingIcon")
		local fadeInfo = TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

		local frameTween = TweenService:Create(frame, fadeInfo, {BackgroundTransparency = 1})
		frameTween:Play()

		if icon then
			local iconTween = TweenService:Create(icon, fadeInfo, {ImageTransparency = 1})
			iconTween:Play()
		end

		frameTween.Completed:Connect(function()
			if currentGen ~= _G.__LoadingUIGeneration then return end
			frame.Visible = false
			screen.Enabled = false

			-- Restore original editor values so it's ready for the next Show call
			frame.BackgroundTransparency = _origFrameTrans
			if icon then
				icon.ImageTransparency = _origIconTrans

				if _G.__RobuxSpinTweens and _G.__RobuxSpinTweens[icon] then
					_G.__RobuxSpinTweens[icon]:Cancel()
					_G.__RobuxSpinTweens[icon] = nil
				end
				icon.Rotation = 0
			end
		end)
	end)
end

return UIAudioConfig
